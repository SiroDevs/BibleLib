{
  "id": "2CO.6",
  "number": "6",
  "bookId": "2CO",
  "reference": "2 Wakorintho 6",
  "copyright": "Biblica® Toleo Wazi la Neno: Biblia Takatifu™ Hakimiliki © 1984, 1989, 2009, 2015 na Biblica, Inc. Biblica® Open Kiswahili Contemporary Version™ Copyright © 1984, 1989, 2009, 2015 by Biblica, Inc. \"Biblica\" ni alama ya biashara iliyosajiliwa katika Ofisi ya Hataza na Alama za Biashara Marekani (United States Patent and Trademark Office) na shirika la Biblica, Inc. Imetumiwa na ruhusa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama watendakazi pamoja na Mungu, tunawasihi msipokee neema ya Mungu bure.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana asema:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "\"Wakati wangu uliokubalika nilikusikia,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "siku ya wokovu nilikusaidia.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2CO 6:2"
      },
      "items": [
        {
          "text": "Tazama, wakati uliokubalika ndio huu, siku ya wokovu ndiyo sasa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Taabu Za Paulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuweki kitu cha kukwaza katika njia ya mtu yeyote, ili huduma yetu isionekane kuwa na lawama.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.3",
            "verseOrgIds": [
              "2CO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali kama watumishi wa Mungu tuonyeshe kwa kila njia: katika saburi nyingi; katika dhiki, katika misiba, na katika shida;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.4",
            "verseOrgIds": [
              "2CO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika kupigwa, katika kufungwa gerezani na katika ghasia; katika kazi ngumu, katika kukesha na katika kufunga;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika utakatifu, katika ufahamu, katika uvumilivu, na katika utu wema; katika Roho Mtakatifu na upendo wa kweli;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika maneno ya kweli na katika nguvu za Mungu, kwa silaha za haki za mkono wa kuume na za mkono wa kushoto;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika utukufu na katika kudharauliwa; katika sifa mbaya na katika sifa nzuri; tukiwa kama wadanganyaji, lakini tukiwa wakweli;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tukiwa maarufu, lakini tukihesabiwa kama tusiojulikana; tukiwa kama wanaokufa, lakini tunaishi; tukipigwa, lakini hatuuawi;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tukiwa kama wenye huzuni, lakini siku zote tukifurahi; tukionekana maskini, lakini tukitajirisha wengi; tukiwa kama wasio na kitu, lakini tuna vitu vyote.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumesema nanyi wazi, enyi Wakorintho na kuwafungulieni mioyo yetu wazi kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisi hatujizuii kuwapenda, bali ninyi mmeuzuia upendo wenu kwetu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa nasema, kama na watoto wangu: Ninyi pia ifungueni mioyo yenu kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Msifungiwe Nira Pamoja Na Wasioamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifungiwe nira pamoja na watu wasioamini, kwa jinsi isivyo sawasawa, kwa maana pana uhusiano gani kati ya haki na uovu? Au kuna ushirika gani kati ya nuru na giza?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna mapatano gani kati ya Kristo na Beliari?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "text": "Yeye aaminiye ana sehemu gani na yeye asiyeamini?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna mapatano gani kati ya Hekalu la Mungu na sanamu? Kwa kuwa sisi tu Hekalu la Mungu aliye hai. Kama Mungu alivyosema: \"Nitakaa pamoja nao na kutembea katikati yao, nami nitakuwa Mungu wao, nao watakuwa watu wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa hiyo tokeni miongoni mwao,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "mkatengwe nao,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "asema Bwana.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "Msiguse kitu chochote kilicho najisi,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:17"
      },
      "items": [
        {
          "text": "nami nitawakaribisha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mimi nitakuwa Baba kwenu,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "nanyi mtakuwa wanangu na binti zangu,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.18",
            "verseOrgIds": [
              "2CO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "2CO 6:18"
      },
      "items": [
        {
          "text": "asema Bwana Mwenyezi.\"",
          "type": "text"
        }
      ]
    }
  ],
  "next": {
    "id": "2CO.7",
    "number": "7",
