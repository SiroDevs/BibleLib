      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wa Kiriath-Yearimu wakaja na kulichukua Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.1",
                "verseOrgIds": [
                  "1SA.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wakalipeleka katika nyumba ya Abinadabu juu kilimani na kumweka Eleazari mwanawe wakfu kulichunga Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.1",
                "verseOrgIds": [
                  "1SA.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samweli Awatiisha Wafilisti Huko Mispa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.2",
                "verseOrgIds": [
                  "1SA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "lilibakia huko Kiriath-Yearimu kwa muda mrefu, yaani jumla ya miaka ishirini, nao watu wa Israeli wakaomboleza na kumtafuta",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.2",
                "verseOrgIds": [
                  "1SA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli akawaambia nyumba yote ya Israeli, \"Ikiwa mtamrudia",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.3",
                "verseOrgIds": [
                  "1SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa mioyo yenu yote, basi iacheni miungu migeni na Maashtorethi na kujitoa wenyewe kwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.3",
                "verseOrgIds": [
                  "1SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na kumtumikia yeye peke yake, naye atawaokoa ninyi na mkono wa Wafilisti.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Waisraeli wakaweka mbali Mabaali yao na Maashtorethi, nao wakamtumikia",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.4",
                "verseOrgIds": [
                  "1SA.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "peke yake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Samweli akasema, \"Wakusanyeni Israeli wote huko Mispa, nami nitawaombea ninyi kwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.5",
                "verseOrgIds": [
                  "1SA.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokwisha kukutanika huko Mispa, walichota maji na kuyamimina mbele za",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.6",
                "verseOrgIds": [
                  "1SA.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Siku hiyo walifunga na wakaungama, wakisema, \"Tumetenda dhambi dhidi ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.6",
                "verseOrgIds": [
                  "1SA.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Naye Samweli alikuwa kiongozi",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "text": "wa Israeli huko Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafilisti waliposikia kwamba Israeli wamekusanyika huko Mispa, watawala wa Wafilisti wakapanda ili kuwashambulia. Waisraeli waliposikia habari hiyo, waliogopa kwa sababu ya Wafilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia Samweli, \"Usiache kumlilia",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.8",
                "verseOrgIds": [
                  "1SA.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wetu, kwa ajili yetu, ili apate kutuokoa na mikono ya Wafilisti.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Samweli akamchukua mwana-kondoo anyonyaye na kumtoa mzima kama sadaka ya kuteketezwa kwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.9",
                "verseOrgIds": [
                  "1SA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": ". Akamlilia",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.9",
                "verseOrgIds": [
                  "1SA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa niaba ya Israeli, naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.9",
                "verseOrgIds": [
                  "1SA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akamjibu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli alipokuwa anatoa hiyo dhabihu ya kuteketezwa, Wafilisti wakasogea karibu ili kupigana vita na Israeli. Lakini siku ile",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.10",
                "verseOrgIds": [
                  "1SA.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "alinguruma kwa ngurumo kubwa dhidi ya Wafilisti na kuwafanya wafadhaike na kutetemeka hivi kwamba walikimbizwa mbele ya Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Israeli wakatoka mbio huko Mispa na kuwafuatia Wafilisti, wakiwachinja njiani hadi mahali chini ya Beth-Kari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Samweli akachukua jiwe na kulisimamisha kati ya Mispa na Sheni. Akaliita Ebenezeri,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "text": "akisema, \"Hata sasa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.12",
                "verseOrgIds": [
                  "1SA.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ametusaidia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Wafilisti wakashindwa na hawakuvamia nchi ya Israeli tena.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 7:13"
      },
      "items": [
        {
          "text": "Katika maisha yote ya Samweli, mkono wa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.13",
                "verseOrgIds": [
                  "1SA.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ulikuwa dhidi ya Wafilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji kuanzia Ekroni hadi Gathi, ile ambayo Wafilisti walikuwa wameiteka kutoka Israeli, ilirudishwa kwake, naye Israeli akazikomboa nchi jirani mikononi mwa Wafilisti. Kukawepo amani kati ya Israeli na Waamori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli akaendelea kama mwamuzi juu ya Israeli siku zote za maisha yake.",
          "type": "text",
