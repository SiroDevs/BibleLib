          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Sauli akamwambia Daudi, \"Mwanangu Daudi na ubarikiwe; utafanya mambo makubwa na hakika utashinda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:25"
      },
      "items": [
        {
          "text": "Basi Daudi akaenda zake, naye Sauli akarudi nyumbani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
