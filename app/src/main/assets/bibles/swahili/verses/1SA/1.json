                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Naye akamwabudu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
