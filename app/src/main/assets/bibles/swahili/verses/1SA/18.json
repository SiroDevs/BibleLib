                "verseId": "1SA.18.28",
                "verseOrgIds": [
                  "1SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa pamoja na Daudi na kwamba Mikali binti yake anampenda Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
