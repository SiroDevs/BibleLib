          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akazidi kumwogopa Daudi, naye Sauli akabaki kuwa adui yake siku zote za maisha yake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
