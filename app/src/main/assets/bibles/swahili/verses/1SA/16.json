          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samweli Anamtia Daudi Mafuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.1",
                "verseOrgIds": [
                  "1SA.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Samweli, \"Utamlilia Sauli mpaka lini, maadamu nimemkataa asiendelee kuwa mfalme juu ya Israeli? Jaza pembe yako mafuta, ushike njia uende; ninakutuma kwa Yese huko Bethlehemu. Nimemchagua mmoja wa wanawe kuwa mfalme.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.1",
            "verseOrgIds": [
              "1SA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Samweli akasema, \"Nitakwendaje? Sauli atasikia juu ya jambo hili na ataniua.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.2",
                "verseOrgIds": [
                  "1SA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia, \"Chukua mtamba wa ngʼombe na useme, 'Nimekuja kumtolea",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.2",
                "verseOrgIds": [
                  "1SA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dhabihu.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalike Yese aje kwenye dhabihu, nami nitakuonyesha utakalofanya. Utamtia mafuta kwa ajili yangu yule nitakayekuonyesha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli akafanya kile",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.4",
                "verseOrgIds": [
                  "1SA.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "alichosema. Alipofika Bethlehemu, wazee wa mji wakatetemeka walipomlaki. Wakauliza, \"Je, umekuja kwa amani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli akajibu, \"Ndiyo, kwa amani; nimekuja kumtolea",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.5",
                "verseOrgIds": [
                  "1SA.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dhabihu. Jiwekeni wakfu na mje kwenye dhabihu pamoja nami.\" Ndipo akamweka Yese wakfu pamoja na wanawe na kuwaalika kwenye dhabihu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipofika, Samweli akamwona Eliabu, naye akafikiri, \"Hakika mpakwa mafuta wa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.6",
                "verseOrgIds": [
                  "1SA.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "anasimama hapa mbele za",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.6",
                "verseOrgIds": [
                  "1SA.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.7",
                "verseOrgIds": [
                  "1SA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Samweli, \"Usitazame sura yake wala kimo chake, kwa kuwa nimemkataa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.7",
                "verseOrgIds": [
                  "1SA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "hatazami katika vile vitu mwanadamu avitazamavyo. Mwanadamu hutazama katika sura ya nje, lakini",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.7",
                "verseOrgIds": [
                  "1SA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "hutazama moyoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yese akamwita Abinadabu na kumpitisha mbele ya Samweli. Lakini Samweli akasema, \"Hata huyu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.8",
                "verseOrgIds": [
                  "1SA.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "hakumchagua.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yese akampitisha Shama, lakini Samweli akasema, \"Wala huyu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.9",
                "verseOrgIds": [
                  "1SA.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "hakumchagua.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yese alikuwa na wana saba aliowapitisha mbele ya Samweli, lakini Samweli akamwambia, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.10",
                "verseOrgIds": [
                  "1SA.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "hajawachagua hawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo akamuuliza Yese, \"Je, hawa ndio wana pekee ulio nao?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:11"
      },
      "items": [
        {
          "text": "Yese akajibu, \"Bado yuko mdogo kuliko wote, lakini anachunga kondoo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:11"
      },
      "items": [
        {
          "text": "Samweli akasema, \"Tuma aitwe; hatutaketi mpaka afike.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akatuma aitwe naye akaletwa. Alikuwa mwekundu, mwenye sura nzuri na umbo la kupendeza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:12"
      },
      "items": [
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.12",
                "verseOrgIds": [
                  "1SA.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema, \"Inuka na umtie mafuta, huyu ndiye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Samweli akachukua ile pembe ya mafuta na kumtia mafuta mbele ya ndugu zake, kuanzia siku ile na kuendelea Roho wa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.13",
                "verseOrgIds": [
                  "1SA.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akaja juu ya Daudi kwa nguvu. Kisha Samweli akaenda zake Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Katika Utumishi Kwa Sauli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Roho wa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.14",
                "verseOrgIds": [
                  "1SA.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa ameondoka kwa Sauli, nayo roho mbaya ikaachiwa nafasi na",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.14",
                "verseOrgIds": [
                  "1SA.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ili imtese.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watumishi wa Sauli wakamwambia, \"Angalia, roho mbaya imeachiwa nafasi na",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.15",
                "verseOrgIds": [
                  "1SA.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nayo inakutesa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi bwana wetu na aamuru watumishi wake walioko hapa kutafuta mtu ambaye anaweza kupiga kinubi. Atakipiga kinubi wakati roho mbaya iliyoachiwa nafasi na Mungu ikujiapo, nawe utajisikia vizuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Sauli akawaambia watumishi wake, \"Mtafuteni mtu apigaye kinubi vizuri mkamlete kwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa watumishi wake akajibu, \"Nimemwona mwana wa Yese Mbethlehemu ambaye anajua kupiga kinubi. Yeye ni mtu hodari na shujaa wa vita. Ni mwenye busara katika kunena, mtu mzuri wa umbo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.18",
                "verseOrgIds": [
                  "1SA.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "yu pamoja naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Sauli akatuma wajumbe kwa Yese na kumwambia, \"Nitumie mwanao Daudi, ambaye anachunga kondoo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Yese akamchukua punda aliyepakizwa mikate, kiriba cha divai na mwana-mbuzi, na kuvipeleka vitu hivyo kwa Sauli pamoja na Daudi mwanawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akafika kwa Sauli na kuingia kwenye kazi yake. Sauli akampenda sana, naye Daudi akawa mmoja wa wabeba silaha wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Sauli akatuma ujumbe kwa Yese, akisema, \"Mruhusu Daudi abaki katika utumishi wangu, kwa kuwa ninapendezwa naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mara roho mbaya iliyoachiwa nafasi na Mungu ilipomjia Sauli, Daudi alichukua kinubi chake na kupiga. Ndipo Sauli angetulizwa na kujisikia vizuri, nayo ile roho mbaya ingemwacha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
        }
      ]
    }
