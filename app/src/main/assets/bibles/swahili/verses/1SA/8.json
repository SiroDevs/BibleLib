        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Waomba Mfalme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli alipokuwa mzee, akaweka wanawe kuwa waamuzi wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.1",
            "verseOrgIds": [
              "1SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzaliwa wa kwanza alikuwa Yoeli, na la wa pili lilikuwa Abiya, nao wakatumika huko Beer-Sheba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.2",
            "verseOrgIds": [
              "1SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wanawe hawakuenenda katika njia zake. Waliziacha wakageukia faida za udanganyifu nao wakapokea rushwa na kupotosha haki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wazee wote wa Israeli wakakusanyika pamoja na kumjia Samweli huko Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.4",
            "verseOrgIds": [
              "1SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia, \"Wewe umekuwa mzee, nao wanao hawaenendi katika njia zako, sasa tuteulie mfalme wa kutuongoza, kama ilivyo kwa mataifa mengine yote.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.5",
            "verseOrgIds": [
              "1SA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wao waliposema, \"Tupe mfalme wa kutuongoza,\" hili lilimchukiza Samweli, hivyo akamwomba",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.6",
                "verseOrgIds": [
                  "1SA.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.7",
                "verseOrgIds": [
                  "1SA.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia: \"Sikiliza yale yote watu wanakuambia. Si wewe ambaye wamekukataa, bali wamenikataa mimi kuwa mfalme wao.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile walivyofanya tangu siku nilipowapandisha kutoka Misri mpaka siku hii ya leo; wakiniacha mimi na kutumikia miungu mingine, ndivyo wanavyokufanyia wewe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa wasikilize, lakini waonye kwa makini na uwafahamishe yale watakayotendewa na mfalme atakayewatawala.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli akawaambia wale watu waliokuwa wakiomba wapewe mfalme maneno yote ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.10",
                "verseOrgIds": [
                  "1SA.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, \"Hivi ndivyo atakavyowatendea mfalme atakayewatawala. Atawachukua wana wenu na kuwafanya watumike kwa magari yake ya vita na farasi, nao watakimbia mbele ya magari yake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baadhi yao atawaweka kuwa majemadari wa jeshi wa maelfu na majemadari wa jeshi wa hamsini, wengine kulima mashamba yake na kuvuna mavuno yake, pia na wengine kutengeneza silaha za vita na vifaa kwa ajili ya magari yake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atawachukua binti zenu kuwa watengeneza manukato, wapishi na waokaji.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atayachukua mashamba yenu yaliyo mazuri, mashamba ya mizabibu na mashamba yenu ya mizeituni na kuwapa watumishi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataichukua sehemu ya kumi ya nafaka yenu na ya zabibu zenu na kuwapa maafisa wake na watumishi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atawachukua watumishi wenu wa kiume na wa kike, na ngʼombe wenu walio wazuri sana na punda kwa matumizi yake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atachukua sehemu ya kumi ya makundi yenu ya kondoo na mbuzi, na ninyi wenyewe mtakuwa watumwa wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile itakapowadia, mtalia kwa kutaka msaada kutokana na mfalme mliyemchagua, naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.18",
                "verseOrgIds": [
                  "1SA.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "hatawajibu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu wakakataa kumsikiliza Samweli wakasema, \"Hapana! Tunataka mfalme wa kututawala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.19",
            "verseOrgIds": [
              "1SA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha tutakuwa kama mataifa mengine yote, tukiwa na mfalme wa kutuongoza na kwenda mbele yetu na kutupigania vita vyetu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
            "verseOrgIds": [
              "1SA.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli aliposikia yote watu waliyosema, akarudia kuyasema mbele za",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.21",
                "verseOrgIds": [
                  "1SA.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.22",
                "verseOrgIds": [
                  "1SA.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akamjibu, \"Wasikilize na uwape mfalme.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 8:22"
      },
      "items": [
        {
          "text": "Kisha Samweli akawaambia watu wa Israeli, \"Kila mmoja arudi mjini kwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    }
  ],
