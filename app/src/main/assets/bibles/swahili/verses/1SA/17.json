          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli alipomwona Daudi anakwenda kukabiliana na huyo Mfilisti, alimwambia Abneri, jemadari wa jeshi, \"Abneri, yule kijana ni mwana wa nani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:55"
      },
      "items": [
        {
          "text": "Abneri akajibu, \"Hakika kama uishivyo, ee mfalme, mimi sifahamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akasema, \"Uliza huyu kijana ni mwana wa nani.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara Daudi aliporudi kutoka kumuua huyo Mfilisti, Abneri akamchukua na kumleta mbele ya Sauli. Daudi alikuwa bado anakishikilia kichwa cha yule Mfilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akamuuliza, \"Kijana, wewe ni mwana wa nani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:58"
      },
      "items": [
        {
          "text": "Daudi akasema, \"Mimi ni mwana wa mtumishi wako Yese wa Bethlehemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
