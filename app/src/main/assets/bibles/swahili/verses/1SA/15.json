              "attrs": {
                "verseId": "1SA.15.20",
                "verseOrgIds": [
                  "1SA.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "alinituma. Niliwaangamiza Waamaleki kabisa na kumleta Agagi mfalme wao.",
          "type": "text",
          "attrs": {
