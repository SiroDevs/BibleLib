    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Sauli akamwambia Samweli, \"Nimetenda dhambi. Nimevunja amri ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.24",
                "verseOrgIds": [
                  "1SA.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "na maagizo yako. Niliwaogopa watu na kwa hiyo nikafanya walivyotaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa ninakusihi usamehe dhambi yangu, nawe urudi pamoja nami, ili nipate kumwabudu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.25",
                "verseOrgIds": [
                  "1SA.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Samweli akamwambia, \"Sitarudi pamoja nawe. Umelikataa neno la",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.26",
                "verseOrgIds": [
                  "1SA.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.26",
                "verseOrgIds": [
                  "1SA.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "amekukataa wewe, usiendelee kuwa mfalme juu ya Israeli!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli alipogeuka ili aondoke, Sauli akangʼangʼania pindo la joho lake, nalo likararuka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli akamwambia, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.28",
                "verseOrgIds": [
                  "1SA.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ameurarua ufalme wa Israeli kutoka kwako leo, naye ameutia kwa mmoja wa majirani zako, aliye bora kuliko wewe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye aliye Utukufu wa Israeli hasemi uongo wala hana kigeugeu; kwa kuwa yeye si mwanadamu, hata abadili nia yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akajibu, \"Nimetenda dhambi. Lakini tafadhali niheshimu mbele ya wazee wa watu wangu na mbele ya Israeli; rudi pamoja nami, ili nipate kumwabudu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.30",
                "verseOrgIds": [
                  "1SA.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Samweli akarudi pamoja na Sauli, naye Sauli akamwabudu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.31",
                "verseOrgIds": [
                  "1SA.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Samweli akasema, \"Niletee Agagi mfalme wa Waamaleki.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 15:32"
      },
      "items": [
        {
          "text": "Agagi akaja kwake kwa ujasiri, akifikiri, \"Hakika uchungu wa mauti umepita.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Samweli akasema,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 15:33"
      },
      "items": [
        {
          "text": "\"Kama upanga wako ulivyofanya wanawake",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
