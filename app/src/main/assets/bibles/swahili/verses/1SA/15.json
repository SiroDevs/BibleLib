                "verseOrgIds": [
                  "1SA.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nilikamilisha ile kazi ambayo",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.20",
            "verseOrgIds": [
              "1SA.15.20"
            ]
          }
        },
        {
          "name": "char",
