          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Askari walichukua kondoo na ngʼombe kutoka kwenye nyara, zile ambazo ni nzuri sana zimewekwa wakfu kwa Mungu, ili zitolewe dhabihu kwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
