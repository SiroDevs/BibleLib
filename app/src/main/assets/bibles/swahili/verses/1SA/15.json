          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.21",
                "verseOrgIds": [
                  "1SA.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako huko Gilgali.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
          }
        }
      ]
    },
