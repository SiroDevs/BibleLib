  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Aokoa Keila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alipoambiwa kuwa, \"Tazama, Wafilisti wanapigana dhidi ya Keila nao wanapokonya nafaka katika sakafu za kupuria,\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akauliza kwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.2",
                "verseOrgIds": [
                  "1SA.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", akisema, \"Je, niende na kuwashambulia hawa Wafilisti?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 23:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.2",
                "verseOrgIds": [
                  "1SA.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akamjibu, \"Nenda, washambulie Wafilisti na uuokoe Keila.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu wa Daudi wakamwambia, \"Hapa Yuda kwenyewe tunaogopa. Si zaidi sana, kama tukienda Keila dhidi ya majeshi ya Wafilisti!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akauliza kwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.4",
                "verseOrgIds": [
                  "1SA.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tena, naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.4",
                "verseOrgIds": [
                  "1SA.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akamjibu akamwambia, \"Shuka uende Keila, kwa kuwa nitawatia Wafilisti mkononi mwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi na watu wake wakaenda Keila, wakapigana na Wafilisti na kutwaa wanyama wao wa kutosha. Daudi akawatia hasara kubwa Wafilisti na kuwaokoa watu wa Keila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Basi Abiathari mwana wa Ahimeleki alikuwa ameleta kisibau alipokimbilia kwa Daudi huko Keila.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauli Anamfuata Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akaambiwa kwamba Daudi alikuwa amekwenda Keila, naye akasema, \"Mungu amemtia mkononi mwangu, kwa kuwa Daudi amejifunga mwenyewe kwa kuingia kwenye mji wenye malango na makomeo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Sauli akayaita majeshi yake yote yaende vitani, kuishukia Keila ili kumzingira Daudi na watu wake kwa jeshi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alipojua kuwa Sauli alikuwa ana hila dhidi yake, akamwambia Abiathari kuhani, \"Leta kile kisibau.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akasema, \"Ee",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.10",
                "verseOrgIds": [
                  "1SA.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, mtumishi wako amesikia kwa hakika kwamba Sauli anapanga kuja Keila na kuangamiza mji kwa ajili yangu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, watu wa Keila watanisalimisha kwake? Je, Sauli atateremka, kama mtumishi wako alivyosikia? Ee",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.11",
                "verseOrgIds": [
                  "1SA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, mwambie mtumishi wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 23:11"
      },
      "items": [
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.11",
                "verseOrgIds": [
                  "1SA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema, \"Ndiyo, atashuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akauliza tena, \"Je watu wa Keila watanisalimisha mimi pamoja na watu wangu kwa Sauli?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 23:12"
      },
      "items": [
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.12",
                "verseOrgIds": [
                  "1SA.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema, \"Ndiyo, watafanya hivyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi na watu wake, wapatao 600, wakaondoka Keila wakawa wanakwenda sehemu moja hadi nyingine. Sauli alipoambiwa Daudi ametoroka kutoka Keila, hakwenda huko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akakaa katika ngome za jangwani na katika vilima vya Jangwa la Zifu. Siku baada ya siku Sauli aliendelea kumsaka, lakini Mungu hakumtia Daudi mikononi mwake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alipokuwa huko Horeshi katika Jangwa la Zifu, akajua kuwa Sauli alikuwa amekuja ili amuue.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yonathani mwana wa Sauli akamwendea Daudi huko Horeshi na kumtia moyo kusimama imara katika imani yake kwa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia, \"Usiogope, Daudi; baba yangu Sauli hatakutia mkononi mwake. Utakuwa mfalme juu ya Israeli, nami nitakuwa wa pili wako. Hata baba yangu Sauli anajua hili.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wote wawili wakaweka agano mbele za",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.18",
                "verseOrgIds": [
                  "1SA.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". Kisha Yonathani akaenda zake nyumbani, lakini Daudi akabaki Horeshi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Wazifu wakakwea kwa Sauli huko Gibea na kusema, \"Je, Daudi hajifichi miongoni mwetu katika ngome huko Horeshi, katika kilima cha Hakila, kusini mwa Yeshimoni?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa, ee mfalme, uteremke wakati wowote unapoona vyema kufanya hivyo, sisi tutawajibika kumkabidhi kwa mfalme.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli akajibu, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1SA.23.21",
                "verseOrgIds": [
                  "1SA.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "awabariki kwa kunifikiria.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nendeni mkafanye maandalizi zaidi. Mkajue mahali ambapo Daudi huenda mara kwa mara na nani amepata kumwona huko. Wananiambia yeye ni mwerevu sana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jueni kila mahali anapojificha mrudi na kunipa taarifa kamili. Kisha nitakwenda pamoja nanyi; kama atakuwa katika eneo hilo, nitamsaka miongoni mwa koo zote za Yuda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakaondoka na kwenda mpaka Zifu wakimtangulia Sauli. Naye Daudi na watu wake walikuwa katika Jangwa la Maoni, katika Araba kusini mwa Yeshimoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli na watu wake wakaanza msako, naye Daudi alipoelezwa hili, akateremka mpaka mwambani na kukaa katika Jangwa la Maoni. Sauli aliposikia hili, akaenda katika Jangwa la Maoni akimfuata Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli alikuwa akienda upande mmoja wa mlima, naye Daudi na watu wake walikuwa upande mwingine wa mlima, wakiharakisha kumkimbia Sauli. Wakati Sauli na majeshi yake walipokaribia kumkamata Daudi na watu wake,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mjumbe alikuja kwa Sauli, akisema, \"Njoo haraka! Wafilisti wanaishambulia nchi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Sauli akarudi akaacha kumfuata Daudi na kwenda kukabiliana na Wafilisti. Ndiyo sababu wanaiita sehemu hii Sela-Hamalekothi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi akakwea kutoka huko na kuishi katika ngome za En-Gedi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.29",
            "verseOrgIds": [
              "1SA.24.1"
            ]
          }
        }
      ]
    }
