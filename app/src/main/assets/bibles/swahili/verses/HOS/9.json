    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adhabu Kwa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usifurahie, ee Israeli;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "usishangilie kama mataifa mengine.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "Kwa kuwa hukuwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "mwaminifu kwa Mungu wako;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "umependa ujira wa kahaba kwenye kila sakafu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "ya kupuria nafaka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakafu za kupuria nafaka na mashinikizo ya kukamulia divai",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:2"
      },
      "items": [
        {
          "text": "havitalisha watu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:2"
      },
      "items": [
        {
          "text": "divai mpya itawapungukia.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawataishi katika nchi ya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.3",
                "verseOrgIds": [
                  "HOS.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "Efraimu atarudi Misri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "na atakula chakula",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "kilicho najisi huko Ashuru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawatammiminia",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.4",
                "verseOrgIds": [
                  "HOS.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sadaka ya divai",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "wala dhabihu zao hazitampendeza.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Dhabihu kama hizo zitakuwa kwao",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "kama mkate wa waombolezaji;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "nao wote wazilao watakuwa najisi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Chakula hiki kitakuwa kwa ajili yao wenyewe;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "kisije katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.4",
                "verseOrgIds": [
                  "HOS.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtafanya nini katika siku ya sikukuu zenu zilizoamriwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:5"
      },
      "items": [
        {
          "text": "katika siku za sikukuu za",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.5",
                "verseOrgIds": [
                  "HOS.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ikiwa wataokoka maangamizi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Misri atawakusanya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "nayo Memfisi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        },
        {
          "text": "itawazika.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Hazina zao za fedha zitasongwa na michongoma,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "nayo miiba itafunika mahema yao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku za adhabu zinakuja,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "siku za malipo zimewadia.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Israeli na afahamu hili.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Kwa sababu dhambi zenu ni nyingi sana",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "na uadui wenu ni mkubwa sana,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "nabii anadhaniwa ni mpumbavu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "mtu aliyeongozwa na Mungu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "anaonekana mwendawazimu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabii, pamoja na Mungu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "ndiye mlinzi juu ya Efraimu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "hata hivyo mitego inamngojea",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
