            "sid": "HOS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.1",
                "verseOrgIds": [
                  "HOS.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "lililomjia Hosea mwana wa Beeri wakati wa utawala wa Uzia, Yothamu, Ahazi na Hezekia, wafalme wa Yuda, na wakati wa utawala wa Yeroboamu mwana wa Yehoashi, mfalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mke Wa Hosea Na Watoto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "alipoanza kuzungumza kupitia Hosea,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "alimwambia, \"Nenda ukajitwalie mwanamke wa uzinzi na watoto wa uzinzi, kwa sababu nchi ina hatia ya uzinzi wa kupindukia kwa kumwacha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo alimwoa Gomeri binti Diblaimu, naye akachukua mimba na kumzalia Hosea mwana.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.4",
                "verseOrgIds": [
                  "HOS.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Hosea, \"Mwite Yezreeli,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "text": "kwa kuwa kitambo kidogo nitaiadhibu nyumba ya Yehu kwa ajili ya mauaji ya kule Yezreeli, nami nitaukomesha ufalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile nitavunja upinde wa Israeli katika Bonde la Yezreeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gomeri akachukua tena mimba akamzaa binti. Kisha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.6",
                "verseOrgIds": [
                  "HOS.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Hosea, \"Mwite Lo-Ruhama,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "text": "kwa maana sitaonyesha tena upendo kwa nyumba ya Israeli, kwamba nisije kabisa nikawasamehe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo nitaonyesha upendo kwa nyumba ya Yuda, nami nitawaokoa si kwa upinde, upanga au vita, wala kwa farasi na wapanda farasi, bali kwa njia ya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.7",
                "verseOrgIds": [
                  "HOS.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wao.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Gomeri kumwachisha Lo-Ruhama kunyonya, Gomeri alipata mwana mwingine.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.9",
                "verseOrgIds": [
                  "HOS.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema, \"Mwite Lo-Ami",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "text": "kwa maana ninyi si watu wangu, nami si Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hata hivyo Waisraeli watakuwa kama mchanga kando ya bahari, ambao hauwezi kupimika wala kuhesabiwa. Mahali pale walipoambiwa, 'Ninyi si watu wangu,' wao wataitwa 'wana wa Mungu aliye hai.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Yuda na watu wa Israeli wataunganishwa tena, nao watamchagua kiongozi mmoja nao watakwea watoke katika nchi, kwa kuwa siku ya Yezreeli itakuwa kuu sana.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.2.2"
            ]
          }
        }
      ]
    }
  ],
