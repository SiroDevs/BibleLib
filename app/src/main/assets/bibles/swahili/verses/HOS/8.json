  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "HOS 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Kuvuna Kisulisuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wekeni tarumbeta midomoni mwenu!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "Tai yuko juu ya nyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.8.1",
                "verseOrgIds": [
                  "HOS.8.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "kwa sababu watu wamevunja Agano langu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "wameasi dhidi ya sheria yangu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli ananililia,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:2"
      },
      "items": [
        {
          "text": "'Ee Mungu wetu, tunakukubali!'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Israeli amekataa lile lililo jema,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:3"
      },
      "items": [
        {
          "text": "adui atamfuatia.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanaweka wafalme bila idhini yangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "wamechagua wakuu bila kibali changu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "Kwa fedha zao na dhahabu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "wamejitengenezea sanamu kwa ajili",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "ya maangamizi yao wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Samaria, tupilieni mbali sanamu yenu ya ndama!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Hasira yangu inawaka dhidi yao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Watakuwa najisi mpaka lini?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimetoka katika Israeli!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Ndama huyu: ametengenezwa na fundi, si Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Atavunjwa vipande vipande,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "yule ndama wa Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wanapanda upepo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "na kuvuna upepo wa kisulisuli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Bua halina suke,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "halitatoa unga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Kama lingetoa nafaka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "wageni wangeila yote.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli amemezwa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "sasa yupo miongoni mwa mataifa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "kama kitu kisicho na thamani.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa wamepanda kwenda Ashuru",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "kama punda-mwitu anayetangatanga peke yake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "Efraimu amejiuza mwenyewe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "kwa wapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa wamejiuza wenyewe miongoni mwa mataifa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "sasa nitawakusanya pamoja.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "Wataanza kudhoofika chini ya uonevu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "wa mfalme mwenye nguvu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ingawa Efraimu alijenga madhabahu nyingi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "kwa ajili ya sadaka za dhambi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "hizi zimekuwa madhabahu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "za kufanyia dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
