  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli alikuwa mzabibu uliostawi sana,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "alijizalia matunda mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "Kadiri matunda yake yalivyoongezeka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "alijenga madhabahu zaidi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "kadiri nchi yake ilivyostawi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "alipamba mawe yake ya ibada.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wao ni mdanganyifu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "nao sasa lazima wachukue hatia yao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.2",
                "verseOrgIds": [
                  "HOS.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "atabomoa madhabahu zao",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "na kuharibu mawe yao ya ibada.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watasema, \"Hatuna mfalme",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "kwa sababu hatukumheshimu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.3",
                "verseOrgIds": [
                  "HOS.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "Lakini hata kama tungelikuwa na mfalme,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "angeweza kutufanyia nini?\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanaweka ahadi nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "huapa viapo vya uongo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "wanapofanya mapatano;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "kwa hiyo mashtaka huchipuka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "kama magugu ya sumu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "katika shamba lililolimwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wanaoishi Samaria huogopa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "kwa ajili ya sanamu ya ndama ya Beth-Aveni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "Watu wake wataiombolezea,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "vivyo hivyo kuhani wake wa kuabudu sanamu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "wale waliokuwa wamefurahia fahari yake,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "kwa sababu itaondolewa kutoka kwao",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "kwenda uhamishoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itachukuliwa kwenda Ashuru",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "kama ushuru kwa mfalme mkuu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Efraimu atafedheheshwa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Israeli ataaibika kwa ajili ya sanamu zake za mti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samaria na mfalme wake wataelea",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:7"
      },
      "items": [
        {
          "text": "kama kijiti juu ya uso wa maji.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahali pa kuabudia sanamu pa uovu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        },
        {
          "text": "pataharibiwa:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "ndiyo dhambi ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Miiba na mibaruti itaota",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "na kufunika madhabahu zao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Kisha wataiambia milima, \"Tufunikeni!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "na vilima, \"Tuangukieni!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tangu siku za Gibea, mmetenda dhambi, ee Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "huko ndiko mlikobaki.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
