      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "atatufunga majeraha yetu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
