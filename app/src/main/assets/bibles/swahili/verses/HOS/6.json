      "attrs": {
        "style": "q1",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "Ameturarua vipande vipande",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
