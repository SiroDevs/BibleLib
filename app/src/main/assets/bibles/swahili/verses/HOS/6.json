          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nifanye nini nawe, Efraimu?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
