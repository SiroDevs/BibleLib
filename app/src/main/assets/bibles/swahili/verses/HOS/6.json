      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:5"
      },
      "items": [
        {
          "text": "kama umeme juu yenu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
