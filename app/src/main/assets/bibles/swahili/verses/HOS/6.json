          "text": "wakifanya uhalifu wa aibu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
