  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "HOS 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hasira Ya",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhidi Ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Efraimu alipozungumza, watu walitetemeka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "alikuwa ametukuzwa katika Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "Lakini alikuwa na hatia ya kumwabudu Baali",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "naye akafa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa wanatenda dhambi zaidi na zaidi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "wanajitengenezea sanamu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "kutokana na fedha yao,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "vinyago vilivyotengenezwa kwa uhodari,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "vyote kazi ya fundi stadi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "Inasemekana kuhusu hawa watu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "\"Hutoa dhabihu za binadamu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "na kubusu sanamu za ndama.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo watakuwa kama ukungu wa asubuhi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "kama umande wa alfajiri utowekao,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "kama makapi yapeperushwayo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "kutoka sakafu ya kupuria nafaka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "kama moshi utorokao kupitia dirishani.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bali mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.13.4",
                "verseOrgIds": [
                  "HOS.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "niliyewaleta ninyi toka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "Msimkubali Mungu mwingine ila mimi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "hakuna Mwokozi isipokuwa mimi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliwatunza huko jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:5"
      },
      "items": [
        {
          "text": "katika nchi yenye joto liunguzalo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilipowalisha, walishiba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "waliposhiba, wakajivuna,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "kisha wakanisahau mimi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo nitakuja juu yao kama simba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:7"
      },
      "items": [
        {
          "text": "kama chui nitawavizia kando ya njia.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama dubu aliyenyangʼanywa watoto wake,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "nitawashambulia na kurarua vifua vyenu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "Kama simba nitawala;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "mnyama pori atawararua vipande vipande.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee Israeli, umeangamizwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:9"
      },
      "items": [
        {
          "text": "kwa sababu wewe u kinyume nami,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:9"
      },
      "items": [
        {
          "text": "kinyume na msaidizi wako.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuko wapi mfalme wako,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "ili apate kukuokoa?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "Wako wapi watawala wako katika miji yako yote",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "ambao ulisema kuwahusu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "'Nipe mfalme na wakuu'?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
