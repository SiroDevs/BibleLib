          "text": "Wote ni moto kama tanuru;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "wanawaangamiza watawala wao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
