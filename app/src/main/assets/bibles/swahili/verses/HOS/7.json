          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "Hasira yao inafoka moshi usiku kucha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
