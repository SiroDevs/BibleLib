      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "dhambi za Efraimu zinafichuliwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "na maovu ya Samaria yanafunuliwa.",
