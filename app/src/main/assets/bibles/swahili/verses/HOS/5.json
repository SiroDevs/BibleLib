                "verseId": "HOS.5.7",
                "verseOrgIds": [
                  "HOS.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "wamezaa watoto haramu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "Sasa sikukuu zao za Mwandamo wa Mwezi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "zitawaangamiza wao",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "pamoja na mashamba yao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pigeni tarumbeta huko Gibea,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "baragumu huko Rama.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "Paza kilio cha vita huko Beth-Aveni,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "ongoza, ee Benyamini.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu ataachwa ukiwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "katika siku ya kuadhibiwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "Miongoni mwa makabila ya Israeli",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "ninatangaza lile ambalo halina budi kutukia.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viongozi wa Yuda ni kama wale",
          "type": "text",
