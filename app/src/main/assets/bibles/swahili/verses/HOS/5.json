    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hukumu Dhidi Ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sikieni hili, enyi makuhani!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Kuweni wasikivu, enyi Waisraeli!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Sikieni, ee nyumba ya mfalme!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Hukumu hii ni dhidi yenu:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Mmekuwa mtego huko Mispa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "wavu uliotandwa juu ya Tabori.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waasi wamezidisha sana mauaji.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:2"
      },
      "items": [
        {
          "text": "Mimi nitawatiisha wote.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninajua yote kuhusu Efraimu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israeli hukufichika kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Efraimu, sasa umegeukia ukahaba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israeli amenajisika.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Matendo yao hayawaachii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "kurudi kwa Mungu wao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "Roho ya ukahaba imo ndani ya mioyo yao,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "hawamkubali",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.5.4",
                "verseOrgIds": [
                  "HOS.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiburi cha Israeli kinashuhudia dhidi yao;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "Waisraeli, hata Efraimu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "wanajikwaa katika dhambi zao;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "pia Yuda atajikwaa pamoja nao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wanapokwenda na makundi yao",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "ya kondoo na ngʼombe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "kumtafuta",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HOS.5.6",
                "verseOrgIds": [
                  "HOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "hawatampata;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "yeye amejiondoa kutoka kwao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
