          ]
        },
        {
          "text": "Wao si waaminifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
