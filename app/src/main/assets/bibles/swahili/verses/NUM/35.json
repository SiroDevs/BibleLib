          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usikubali fidia yoyote ya kuokoa uhai wa muuaji ambaye anastahili kufa. Mtu huyo hakika lazima auawe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
