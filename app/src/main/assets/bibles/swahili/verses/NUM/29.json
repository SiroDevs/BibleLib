      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sikukuu Ya Vibanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
