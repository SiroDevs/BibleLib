    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nadhiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akawaambia viongozi wa makabila ya Israeli: \"Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.1",
                "verseOrgIds": [
                  "NUM.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": "analoagiza:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanaume awekapo nadhiri kwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.2",
                "verseOrgIds": [
                  "NUM.30.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", au anapoapa kujifunga kwa ahadi, kamwe asitangue neno lake, bali ni lazima afanye kila kitu alichosema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wakati mwanamwali anayeishi bado nyumbani kwa baba yake atakapoweka nadhiri kwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.3",
                "verseOrgIds": [
                  "NUM.30.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ama amejifunga mwenyewe kwa ahadi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na baba yake akasikia kuhusu nadhiri au ahadi yake lakini asimwambie lolote, ndipo nadhiri zake zote na kila ahadi aliyoiweka na kujifunga kwayo itathibitika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.4",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama baba yake akimkataza wakati anapoisikia, hakuna nadhiri wala ahadi yake yoyote aliyojifunga kwayo itakayosimama;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.5",
                "verseOrgIds": [
                  "NUM.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "atamweka huru huyo mwanamwali kwa sababu baba yake amemkataza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ikiwa ataolewa baada ya kuweka nadhiri au baada ya midomo yake kutamka ahadi fulani bila kufikiri akawa amejifunga hivyo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mume wake akasikia habari hiyo asimwambie neno lolote, ndipo nadhiri zake ama ahadi zake ambazo alikuwa amejifunga nazo zitathibitika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ikiwa mume wake atamkataza atakaposikia kuhusu hilo, atakuwa ametangua nadhiri ambazo zilikuwa zimemfunga mkewe, ama ahadi aliyotamka pasipo kufikiri ambayo amejifunga kwayo, naye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.8",
                "verseOrgIds": [
                  "NUM.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "atamweka huru yule mwanamke.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nadhiri yoyote ama patano ambalo limefanywa na mjane ama mwanamke aliyeachwa vitakuwa vimemfunga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ikiwa mwanamke anayeishi na mumewe ataweka nadhiri ama kujifunga mwenyewe kwa ahadi chini ya kiapo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mumewe akasikia kuhusu jambo hili lakini asimwambie lolote wala hakumkataza, ndipo viapo vyake vyote au ahadi zinazomfunga zitakapothibitika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ikiwa mumewe atabatilisha nadhiri hizo baada ya kuzisikia, basi hakuna nadhiri au ahadi zozote alizoziweka kwa midomo yake zitakazothibitika. Mumewe atakuwa amezibatilisha, na",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.12",
                "verseOrgIds": [
                  "NUM.30.13"
                ]
              }
            }
          ]
        },
        {
          "text": "atamweka huru yule mwanamke.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumewe anaweza kuthibitisha au kutangua nadhiri yoyote anayoweka, au ahadi yoyote aliyoweka kwa kuapa ili kujikana mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ikiwa mumewe hasemi lolote kwake kuhusu jambo hilo siku baada ya siku, basi mumewe atakuwa amethibitisha nadhiri zote, na ahadi zote zinazomfunga mkewe. Anavithibitisha kwa kutokusema lolote kwa mkewe anapoyasikia hayo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, ikiwa mumewe atavibatilisha baada ya kusikia hayo, basi atawajibika kwa hatia ya mkewe.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo masharti ambayo",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.16",
                "verseOrgIds": [
                  "NUM.30.17"
                ]
              }
            }
          ]
        },
        {
          "text": "alimpa Mose kuhusu mahusiano kati ya mtu na mkewe, na kati ya baba na binti yake ambaye bado anaishi nyumbani kwa baba yake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.17"
            ]
          }
        }
      ]
    }
  ],
