              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu akasema, \"Nijengee hapa madhabahu saba, uandae mafahali saba na kondoo dume saba kwa ajili yangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
