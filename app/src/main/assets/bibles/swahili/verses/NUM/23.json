              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Balaki akamwambia Balaamu, \"Njoo, nikupeleke mahali pengine. Huenda itampendeza Mungu kukuruhusu unilaanie hao watu kutoka mahali hapo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
