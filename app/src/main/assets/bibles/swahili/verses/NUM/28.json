          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na sehemu ya kumi ya efa ya unga laini kwa kila mmoja wa wana-kondoo saba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
