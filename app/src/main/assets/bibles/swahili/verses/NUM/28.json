              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongeza beberu mmoja kwa kufanya upatanisho kwa ajili yenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
