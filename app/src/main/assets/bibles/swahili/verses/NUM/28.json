        "style": "s1"
      },
      "items": [
        {
          "text": "Sadaka Za Kila Siku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
