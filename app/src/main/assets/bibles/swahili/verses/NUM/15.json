    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sadaka Za Nyongeza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.1",
                "verseOrgIds": [
                  "NUM.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.1",
            "verseOrgIds": [
              "NUM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sema na Waisraeli uwaambie: 'Baada ya ninyi kuingia katika nchi ninayowapa kama nyumbani,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanyi mkitoa sadaka za kuteketezwa kwa moto, kutoka makundi ya ngʼombe au kondoo, kama harufu nzuri inayompendeza",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.3",
                "verseOrgIds": [
                  "NUM.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ikiwa ni sadaka za kuteketezwa au dhabihu, kwa ajili ya nadhiri maalum ama sadaka ya hiari au sadaka ya sikukuu zenu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo yeye aletaye sadaka yake ataiweka mbele za",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.4",
                "verseOrgIds": [
                  "NUM.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sadaka ya nafaka, sehemu ya kumi ya efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "text": "ya unga laini uliochanganywa na robo ya hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "text": "ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamoja na kila mwana-kondoo kwa ajili ya sadaka ya kuteketezwa au dhabihu, andaa robo ya hini ya divai kwa sadaka ya kinywaji.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pamoja na kondoo dume andaa sadaka ya nafaka ya sehemu mbili za kumi za efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "text": "za unga laini uliochanganywa na theluthi moja",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "text": "ya hini ya mafuta,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na theluthi moja ya hini ya divai kama sadaka ya kinywaji. Vitoe kama harufu nzuri inayompendeza",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.7",
                "verseOrgIds": [
                  "NUM.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unapoandaa fahali mchanga kama sadaka ya kuteketezwa au dhabihu, kwa ajili ya nadhiri maalum au sadaka ya amani kwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.8",
                "verseOrgIds": [
                  "NUM.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "leta pamoja na huyo fahali sadaka ya nafaka ya unga laini sehemu tatu za kumi za efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "text": "uliochanganywa na nusu ya hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "text": "ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia utaleta nusu ya hini ya divai kama sadaka ya kinywaji. Itakuwa sadaka iliyoteketezwa kwa moto, harufu nzuri inayompendeza",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.10",
                "verseOrgIds": [
                  "NUM.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila fahali au kondoo dume, kila mwana-kondoo au mbuzi mchanga, atatayarishwa kwa njia hii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.11",
            "verseOrgIds": [
              "NUM.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fanyeni hivi kwa ajili ya kila mmoja, kwa kadiri ya wingi wa mtakavyoandaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.12",
            "verseOrgIds": [
              "NUM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kila mmoja ambaye ni mzawa ni lazima afanye vitu hivi kwa njia hii hapo aletapo sadaka ya kuteketezwa kwa moto kama harufu nzuri inayompendeza",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.13",
                "verseOrgIds": [
                  "NUM.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa vizazi vijavyo, wakati wowote mgeni au mtu mwingine yeyote anayeishi miongoni mwenu aletapo sadaka ya kuteketezwa kuwa harufu nzuri ya kumpendeza",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.14",
                "verseOrgIds": [
                  "NUM.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ni lazima afanye sawasawa kabisa na jinsi mnavyofanya ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumuiya itakuwa na sheria hizo hizo kwenu na kwa mgeni aishiye miongoni mwenu; hii ni amri ya kudumu kwa vizazi vijavyo. Ninyi na mgeni mtakuwa sawa mbele za",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.15",
                "verseOrgIds": [
                  "NUM.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheria hizo hizo na masharti hayo hayo hayo, yatawahusu ninyi na mgeni aishiye miongoni mwenu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.17",
                "verseOrgIds": [
                  "NUM.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.17",
            "verseOrgIds": [
              "NUM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sema na Waisraeli na uwaambie: 'Mtakapoingia katika nchi ninayowapeleka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.18",
            "verseOrgIds": [
              "NUM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanyi mkala chakula cha nchi hiyo, toeni sehemu ya chakula hicho kama sadaka kwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.19",
            "verseOrgIds": [
              "NUM.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.19",
                "verseOrgIds": [
                  "NUM.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.19",
            "verseOrgIds": [
              "NUM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toeni andazi kutoka kwa malimbuko ya chakula chenu kitokacho katika ardhi, na mkitoe kama sadaka kutoka sakafu ya kupuria nafaka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.20",
            "verseOrgIds": [
              "NUM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa vizazi vyote vijavyo hamna budi kutoa sadaka hii kwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.21",
                "verseOrgIds": [
                  "NUM.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "kutoka kwa malimbuko ya unga wenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sadaka Kwa Ajili Ya Dhambi Isiyo Ya Makusudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Basi kama pasipo kukusudia umeshindwa kushika mojawapo katika amri hizi ambazo",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.22",
                "verseOrgIds": [
                  "NUM.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "alimpa Mose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "amri yoyote ya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.23",
                "verseOrgIds": [
                  "NUM.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "kwenu kupitia Mose, tangu siku ile",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.23",
                "verseOrgIds": [
                  "NUM.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "alipowapa na inaendelea hadi vizazi vyote vijavyo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiwa hili limefanyika pasipo kukusudia bila jumuiya kuwa na habari nalo, basi jumuiya yote itatoa fahali mchanga kuwa sadaka ya kuteketezwa ikiwa harufu nzuri inayompendeza",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.24",
                "verseOrgIds": [
                  "NUM.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", pamoja na sadaka ya nafaka na ya kinywaji zilizoamriwa kwayo, na mbuzi dume kwa ajili ya sadaka ya dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani atafanya upatanisho kwa ajili ya jumuiya yote ya Kiisraeli, nao watasamehewa, kwa kuwa haikuwa makusudi nao wamemletea",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.25",
                "verseOrgIds": [
                  "NUM.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "sadaka iliyoteketezwa kwa moto na sadaka ya dhambi kwa ajili ya kosa lao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumuiya yote ya Kiisraeli pamoja na wageni waishio miongoni mwao watasamehewa, kwa sababu watu wote walihusika katika kosa lile lisilokusudiwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lakini kama mtu mmoja peke yake akitenda dhambi pasipo kukusudia, ni lazima alete mbuzi mke wa mwaka mmoja kwa ajili ya sadaka ya dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani atafanya upatanisho mbele za",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.28",
                "verseOrgIds": [
                  "NUM.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa ajili ya yule aliyekosa kwa kufanya dhambi pasipo kukusudia, upatanisho utakapofanywa kwa ajili yake, atasamehewa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheria hiyo moja itamhusu kila mmoja ambaye ametenda dhambi pasipo kukusudia, awe Mwisraeli mzawa ama mgeni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
            "verseOrgIds": [
              "NUM.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lakini yeyote ambaye amefanya dhambi kwa dharau awe mzawa au mgeni, anamkufuru",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.30",
                "verseOrgIds": [
                  "NUM.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye mtu huyo ni lazima akatiliwe mbali na watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu amelidharau neno la",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.31",
                "verseOrgIds": [
                  "NUM.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": "na kuvunja amri zake, mtu huyo ni lazima akatiliwe mbali; hatia yake inabaki juu yake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mvunja Sabato Auawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli walipokuwa jangwani, mtu mmoja alikutwa akikusanya kuni siku ya Sabato.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.32",
            "verseOrgIds": [
              "NUM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale waliomkuta akikusanya kuni wakamleta kwa Mose, Aroni na kusanyiko lote,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.33",
            "verseOrgIds": [
              "NUM.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao wakamweka kifungoni, kwa sababu haikufahamika kwa wazi kwamba afanyiwe nini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.34",
            "verseOrgIds": [
              "NUM.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.35",
                "verseOrgIds": [
                  "NUM.15.35"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Huyo mtu ni lazima afe. Kusanyiko lote lazima limpige mawe nje ya kambi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo kusanyiko likamtoa nje ya kambi na kumpiga mawe hadi akafa, kama",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.36",
                "verseOrgIds": [
                  "NUM.15.36"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyomwamuru Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vifundo Kwenye Mavazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.37",
                "verseOrgIds": [
                  "NUM.15.37"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.37",
            "verseOrgIds": [
              "NUM.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sema na Waisraeli uwaambie: 'Kwa vizazi vyote vijavyo jifanyieni vifundo katika pindo za mavazi yenu vikiwa na uzi wa buluu kwenye kila kifundo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtakuwa mkivitazama vifundo hivyo ili mpate kukumbuka amri zote za",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.39",
                "verseOrgIds": [
                  "NUM.15.39"
                ]
              }
            }
          ]
        },
        {
          "text": ", ili mpate kuzitii msije mkajitia uzinzi wenyewe kwa kuzifuata tamaa za mioyo yenu na za macho yenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mtakumbuka kuzitii amri zangu zote nanyi mtawekwa wakfu kwa Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.40",
            "verseOrgIds": [
              "NUM.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi Ndimi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.41",
                "verseOrgIds": [
                  "NUM.15.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, niliyewatoa Misri niwe Mungu wenu. Mimi Ndimi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.41",
                "verseOrgIds": [
                  "NUM.15.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        }
      ]
    }
  ],
