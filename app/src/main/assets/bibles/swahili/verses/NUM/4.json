          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huu ndio wajibu wao wanapofanya huduma katika Hema la Kukutania: kubeba miimo ya Maskani, mataruma yake, nguzo na vitako,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
