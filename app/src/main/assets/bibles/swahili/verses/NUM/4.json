              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahesabu wanaume wote kuanzia umri wa miaka thelathini hadi hamsini ambao watakuja kutumika katika Hema la Kukutania.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
