          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Kibroth-Hataava watu wakasafiri mpaka Haserothi na kukaa huko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
      ]
