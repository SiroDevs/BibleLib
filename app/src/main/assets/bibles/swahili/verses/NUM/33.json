              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaondoka Makelothi na kupiga kambi huko Tahathi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
