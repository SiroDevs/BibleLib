          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka wazao wa Simeoni:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:22"
      },
      "items": [
        {
          "text": "Wanaume wote waliokuwa na miaka ishirini au zaidi ambao waliweza kutumika katika jeshi walihesabiwa na kuorodheshwa kwa majina, mmoja mmoja, kufuatana na kumbukumbu za koo zao na jamaa zao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idadi kutoka kabila la Simeoni walikuwa watu 59,300.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
