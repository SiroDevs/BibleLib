          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoka Naftali, ni Ahira mwana wa Enani.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
