              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoka Yuda, ni Nashoni mwana wa Aminadabu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.7",
            "verseOrgIds": [
              "NUM.1.7"
            ]
