    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa walikuwa wanaume walioteuliwa kutoka jumuiya, viongozi wa makabila ya baba zao. Walikuwa wakuu wa koo za Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni wakawachukua wanaume hao waliokuwa wamepewa majina yao,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakaita jumuiya yote pamoja katika siku ya kwanza ya mwezi wa pili. Watu wakaonyesha nasaba zao kwa koo zao na jamaa zao, nao wanaume waliokuwa na miaka ishirini au zaidi waliorodheshwa kwa majina, mmoja mmoja,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.1.19",
                "verseOrgIds": [
                  "NUM.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyomwagiza Mose. Hivyo aliwahesabu katika Jangwa la Sinai:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka wazao wa Reubeni, mzaliwa wa kwanza wa kiume wa Israeli:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:20"
      },
      "items": [
        {
          "text": "Wanaume wote waliokuwa na miaka ishirini au zaidi ambao waliweza kutumika katika jeshi waliorodheshwa kwa majina, mmoja mmoja, kufuatana na kumbukumbu za koo zao na jamaa zao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idadi kutoka kabila la Reubeni ilikuwa watu 46,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
    {
