        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mipaka Ya Kanaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.34.1",
                "verseOrgIds": [
                  "NUM.34.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.1",
            "verseOrgIds": [
              "NUM.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waamuru Waisraeli na uwaambie: 'Mtakapoingia nchi ya Kanaani, nchi ambayo itagawanywa kwenu kama urithi itakuwa na mipaka ifuatayo:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.2",
            "verseOrgIds": [
              "NUM.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Upande wenu wa kusini utajumuisha sehemu ya Jangwa la Sini kufuata mpaka wa Edomu. Upande wa mashariki mpaka wenu wa kusini utaanzia mwisho wa Bahari ya Chumvi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "katiza kusini mwa Pito la Akrabimu, endelea mpaka Sini na kwenda kusini ya Kadesh-Barnea. Kisha mpaka huo utaenda hadi Hasar-Adari hadi Azmoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mahali ambapo utapinda, na kuunganika na Kijito cha Misri na kumalizikia kwenye Bahari ya Kati.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mpaka wenu wa magharibi utakuwa Bahari ya Kati. Huu utakuwa mpaka wenu upande wa magharibi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kwa mpaka wenu wa kaskazini, wekeni alama kuanzia Bahari ya Kati hadi mlima Hori,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.7",
            "verseOrgIds": [
              "NUM.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kutoka mlima Hori hadi Pito la Hamathi. Kisha mpaka utaenda hadi Sedadi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.8",
            "verseOrgIds": [
              "NUM.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuendelea hadi Zifroni, na kuishia Hasar-Enani. Huu utakuwa mpaka wenu upande wa kaskazini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
            "verseOrgIds": [
              "NUM.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kwa mpaka wenu wa mashariki, wekeni alama kuanzia Hasar-Enani hadi Shefamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.10",
            "verseOrgIds": [
              "NUM.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka utaelekea kusini kuanzia Shefamu hadi Ribla upande wa mashariki wa Aini, na kuendelea kwenye miteremko mashariki mwa Bahari ya Kinerethi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mpaka utashuka kuelekea Mto Yordani na kuishia katika Bahari ya Chumvi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 34:12"
      },
      "items": [
        {
          "text": "\" 'Hii itakuwa nchi yenu, ikiwa na mipaka yake kila upande.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akawaamuru Waisraeli: \"Gawanyeni nchi hii kwa kura kama urithi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.34.13",
                "verseOrgIds": [
                  "NUM.34.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ameagiza kwamba itolewe kwa yale makabila tisa na nusu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu jamaa ya kabila la Reubeni, kabila la Gadi, na nusu ya kabila la Manase wamekwishapokea urithi wao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya makabila mawili na nusu wamekwishapokea urithi wao upande wa mashariki wa Yordani ngʼambo ya Yeriko, kuelekea mawio ya jua.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.34.16",
                "verseOrgIds": [
                  "NUM.34.16"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haya ndiyo majina ya watu ambao watakusaidia kugawanya nchi kama urithi: Eleazari kuhani na Yoshua mwana wa Nuni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena uteue kiongozi mmoja kutoka kila kabila kusaidia kuigawanya nchi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo majina yao:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 34:19"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 34:19"
      },
      "items": [
        {
          "text": "\"Kalebu mwana wa Yefune,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 34:19"
      },
      "items": [
        {
          "text": "kutoka kabila la Yuda;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemueli mwana wa Amihudi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 34:20"
      },
      "items": [
        {
          "text": "kutoka kabila la Simeoni;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elidadi mwana wa Kisloni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 34:21"
      },
      "items": [
        {
          "text": "kutoka kabila la Benyamini;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buki mwana wa Yogli,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 34:22"
      },
      "items": [
        {
          "text": "kiongozi kutoka kabila la Dani;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanieli mwana wa Efodi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 34:23"
      },
      "items": [
        {
          "text": "kiongozi kutoka kabila la Manase mwana wa Yosefu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemueli mwana wa Shiftani,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 34:24"
      },
      "items": [
        {
          "text": "kiongozi kutoka kabila la Efraimu mwana wa Yosefu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
