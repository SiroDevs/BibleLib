  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "NUM 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nchi Ya Aradi Yaangamizwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Kikanaani wa Aradi aliyeishi huko Negebu aliposikia kwamba Waisraeli walikuwa wanakuja kwa njia ya Atharimu, aliwashambulia Waisraeli na kuwateka baadhi yao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Israeli akaweka nadhiri hii kwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.2",
                "verseOrgIds": [
                  "NUM.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": ": \"Ikiwa utawatia watu hawa mikononi mwetu, tutaiangamiza kabisa miji yao.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.3",
                "verseOrgIds": [
                  "NUM.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akasikiliza ombi la Waisraeli, naye akawapa ushindi juu ya Wakanaani. Wakawaangamiza kabisa na miji yao; hivyo mahali pale pakaitwa Horma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyoka Wa Shaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli wakasafiri kutoka mlima Hori kupitia njia inayoelekea Bahari ya Shamu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
          "text": "kuizunguka Edomu. Lakini watu wakakosa uvumilivu njiani,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamnungʼunikia Mungu na Mose, wakisema, \"Kwa nini umetupandisha kutoka Misri ili tufe jangwani? Hakuna mkate! Hakuna maji! Nasi tunachukia sana chakula hiki duni!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.6",
                "verseOrgIds": [
                  "NUM.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akapeleka nyoka wenye sumu katikati yao; wakawauma watu, nao Waisraeli wengi wakafa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wakamjia Mose na kusema, \"Tumetenda dhambi wakati tuliponena dhidi ya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.7",
                "verseOrgIds": [
                  "NUM.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "na dhidi yako. Mwombe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.7",
                "verseOrgIds": [
                  "NUM.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ili atuondolee hawa nyoka.\" Hivyo Mose akawaombea hao watu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.8",
                "verseOrgIds": [
                  "NUM.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Tengeneza nyoka wa shaba na umweke juu ya mti; yeyote aliyeumwa na nyoka anaweza kumtazama na akaishi tena.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.8",
            "verseOrgIds": [
              "NUM.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Mose akatengeneza nyoka wa shaba na kumweka juu ya mti. Kisha wakati mtu yeyote aliumwa na nyoka, naye akamtazama yule nyoka wa shaba, aliishi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Safari Kwenda Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli waliendelea na safari yao na wakapiga kambi huko Obothi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakaondoka Obothi na kupiga kambi huko Iye-Abarimu, katika jangwa linalotazamana na Moabu kuelekea mawio ya jua.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka hapo waliendelea mbele wakapiga kambi kwenye Bonde la Zeredi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasafiri kutoka hapo na kupiga kambi kando ya Mto Arnoni, ambao uko katika jangwa lililoenea hadi nchi ya Waamori. Arnoni ni mpaka wa Moabu, kati ya Moabu na Waamori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyo sababu Kitabu cha Vita vya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.14",
                "verseOrgIds": [
                  "NUM.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kinasema:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:14"
      },
      "items": [
        {
          "text": "\"…Mji wa Wahebu nchini Seifa na mabonde",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:14"
      },
      "items": [
        {
          "text": "ya Arnoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na miteremko ya mabonde",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:15"
      },
      "items": [
        {
          "text": "inayofika hadi mji wa Ari",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:15"
      },
      "items": [
        {
          "text": "na huelekea mpakani mwa Moabu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka hapo waliendelea mbele hadi kisima cha Beeri; kwenye kisima ambacho",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.16",
                "verseOrgIds": [
                  "NUM.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "alimwambia Mose, \"Wakusanye watu pamoja, nami nitawapa maji.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Israeli akaimba wimbo huu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:17"
      },
      "items": [
        {
          "text": "\"Bubujika, ee kisima!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:17"
      },
      "items": [
        {
          "text": "Imba kuhusu maji,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhusu kisima ambacho kilichimbwa na wakuu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "ambacho watu mashuhuri walikifukua,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "watu mashuhuri wakiwa na fimbo za utawala na bakora.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "Kisha wakatoka jangwani kwenda Matana,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoka Matana wakafika Nahalieli, kutoka Nahalieli wakafika Bamothi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.19",
            "verseOrgIds": [
              "NUM.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kutoka Bamothi wakafika kwenye bonde lililoko Moabu, mahali ambapo kilele cha Pisga kinatazamana na nyika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.20",
            "verseOrgIds": [
              "NUM.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kushindwa Kwa Sihoni Na Ogu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "DEU.2.26-DEU.3.11"
          },
          "items": [
            {
              "text": "Kumbukumbu 2:26–3:11",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli akawatuma wajumbe kumwambia Sihoni mfalme wa Waamori:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.21",
            "verseOrgIds": [
              "NUM.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uturuhusu tupite katika nchi yako. Hatutageuka kando kwenda katika mashamba au mashamba ya mizabibu, ama kunywa maji kutoka kisima chochote. Tutasafiri kwenye njia kuu ya mfalme hata tutakapokuwa tumekwisha kupita katika nchi yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Sihoni hakumruhusu Israeli apite katika nchi yake. Alilikutanisha jeshi lake lote, wakaondoka kwenda jangwani ili kupigana na Israeli. Alipofika huko Yahazi, akapigana na Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, Israeli alimshinda kwa upanga na kuiteka ardhi yake kutoka Arnoni mpaka Yaboki, lakini ni hadi kufikia nchi ya Waamoni tu, kwa sababu mipaka yake ilikuwa imezungushwa ukuta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli akaiteka miji yote ya Waamori na kuikalia, pamoja na Heshboni na makazi yote yanayoizunguka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshboni ulikuwa mji wa Sihoni mfalme wa Waamori, ambaye alikuwa amepigana dhidi ya mfalme wa Moabu aliyetangulia na akawa amechukua ardhi yake yote mpaka Arnoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyo sababu watunga mashairi husema:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:27"
      },
      "items": [
        {
          "text": "\"Njoo Heshboni na ujengwe tena;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:27"
      },
      "items": [
        {
          "text": "mji wa Sihoni na ufanywe upya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Moto uliwaka kutoka Heshboni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "mwali wa moto kutoka mji wa Sihoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "Uliteketeza Ari ya Moabu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "raiya wa mahali pa Arnoni palipoinuka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wako, ee Moabu!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Umeharibiwa, enyi watu wa Kemoshi!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Amewatoa wanawe kuwa wakimbizi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "na binti zake kama mateka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "kwa Mfalme Sihoni wa Waamori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini tumewashinda;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "Heshboni umeharibiwa hadi Diboni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "Tumebomoa hadi kufikia Nofa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "ulioenea hadi Medeba.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Israeli akaishi katika nchi ya Waamori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Mose kutuma wapelelezi kwenda mji wa Yazeri, Waisraeli waliteka viunga vya mji huo na kuwafukuza Waamori waliokuwa wanaishi huko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakageuka na kwenda katika njia inayoelekea Bashani, naye Ogu mfalme wa Bashani pamoja na jeshi lake lote wakatoka kupigana nao huko Edrei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.34",
                "verseOrgIds": [
                  "NUM.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Usimwogope Ogu, kwa sababu nimeshamkabidhi mikononi mwako, pamoja na jeshi lake lote na nchi yake. Mtendee kama ulivyomtendea Sihoni mfalme wa Waamori, ambaye alitawala huko Heshboni.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakamuua, pamoja na wanawe na jeshi lake lote, bila ya kumwacha hata mtu mmoja hai. Nao wakaimiliki nchi yake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.35",
            "verseOrgIds": [
              "NUM.21.35"
            ]
          }
        }
      ]
    }
