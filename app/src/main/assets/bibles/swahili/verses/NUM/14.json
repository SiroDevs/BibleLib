          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, kwa kiburi chao walipanda juu kuelekea nchi ya vilima virefu, ijapokuwa Mose hakutoka kambini wala Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
