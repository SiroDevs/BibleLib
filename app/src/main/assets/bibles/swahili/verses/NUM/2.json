          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila la Manase litafuata baada ya Efraimu. Kiongozi wa watu wa Manase ni Gamalieli mwana wa Pedasuri.",
          "type": "text"
        },
