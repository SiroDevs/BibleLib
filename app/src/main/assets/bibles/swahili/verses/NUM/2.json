          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila la Zabuloni litafuata. Kiongozi wa watu wa Zabuloni ni Eliabu mwana wa Heloni.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
