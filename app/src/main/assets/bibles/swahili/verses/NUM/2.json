            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waisraeli watapiga kambi zao kuzunguka Hema la Kukutania kwa umbali fulani kutoka kwenye hema, kila mwanaume chini ya alama yake pamoja na bendera ya jamaa yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
