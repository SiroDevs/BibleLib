          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanaume wote walio katika kambi ya Dani ni 157,600. Wao watakuwa wa mwisho kuondoka chini ya alama yao.",
          "type": "text"
        }
      ]
    },
    {
