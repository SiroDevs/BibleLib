          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila la Benyamini litafuata baada ya Manase. Kiongozi wa watu wa Benyamini ni Abidani mwana wa Gideoni.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
