          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upande wa magharibi kutakuwepo na kambi ya makundi ya Efraimu chini ya alama yao. Kiongozi wa watu wa Efraimu ni Elishama mwana wa Amihudi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundi lake lina watu 40,500.",
          "type": "text"
        }
      ]
    },
