          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila la Isakari watapiga kambi karibu na Yuda. Kiongozi wa watu wa Isakari ni Nethaneli mwana wa Suari.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
