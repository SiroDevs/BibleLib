                "verseOrgIds": [
                  "NUM.3.39"
                ]
              }
            }
          ]
        },
        {
          "text": ", kufuatana na koo, pamoja na kila mume mwenye umri wa mwezi mmoja au zaidi, walikuwa 22,000.",
