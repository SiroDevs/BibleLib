              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Merari kulikuwa na koo za Wamahli na Wamushi; hizi zilikuwa koo za Merari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
