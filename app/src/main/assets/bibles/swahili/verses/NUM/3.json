          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusanya shekeli tano",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "text": "kwa kila mmoja, kufuatana na shekeli ya mahali patakatifu, ambayo ina uzito wa gera ishirini.",
