                "verseOrgIds": [
                  "NUM.3.40"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Wahesabu wazaliwa wa kwanza wa kiume wote wa Waisraeli wenye umri wa mwezi mmoja au zaidi na uorodheshe majina yao.",
          "type": "text",
