    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Kohathi kulikuwepo koo za Waamramu, Waishari, Wahebroni na Wauzieli; hizi ndizo zilizokuwa koo za Wakohathi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.27",
            "verseOrgIds": [
              "NUM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesabu ya waume wote wenye mwezi mmoja au zaidi ilikuwa watu 8,600. Wakohathi waliwajibika kutunza mahali patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koo za Wakohathi zilitakiwa kuweka kambi zao upande wa kusini wa Maskani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiongozi wa jamaa za koo za Wakohathi alikuwa Elisafani mwana wa Uzieli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwajibika kutunza Sanduku la Agano, meza, kinara cha taa, madhabahu, na vile vyombo vya mahali patakatifu vinavyotumika kuhudumu, pazia, na kila kitu kinachohusika na matumizi yake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiongozi mkuu wa Walawi alikuwa Eleazari mwana wa kuhani, Aroni. Aliwekwa juu ya wale waliowajibika kutunza mahali patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
