          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili kukomboa wazao wa kwanza 273 wa Waisraeli ambao wamezidi hesabu ya Walawi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
