          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Mose akakusanya fedha za ukombozi kutoka kwa wale ambao hesabu yao ilizidi wale waliokombolewa na Walawi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
