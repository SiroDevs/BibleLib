          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutokana na wazaliwa wa kwanza wa Waisraeli alikusanya fedha yenye uzito wa shekeli 1,365",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "text": "kufuatana na shekeli ya mahali patakatifu.",
          "type": "text",
          "attrs": {
