          "text": "Kama nyoka akiuma kabla ya kufanyiwa uaguzi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
