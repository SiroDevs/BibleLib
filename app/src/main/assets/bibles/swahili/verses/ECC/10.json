            "number": "8",
            "style": "v",
            "sid": "ECC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye achimbaye shimo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
