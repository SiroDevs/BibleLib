    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:12"
      },
      "items": [
        {
          "text": "yana neema,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:12"
      },
      "items": [
        {
          "text": "bali mpumbavu huangamizwa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:12"
      },
      "items": [
        {
          "text": "na midomo yake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanzoni maneno yake ni upumbavu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        }
      ]
    },
