    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kila Jambo Lina Wakati Wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna wakati kwa ajili ya kila jambo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:1"
      },
      "items": [
        {
          "text": "nayo majira kwa kila tendo chini ya mbingu:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kuzaliwa na wakati wa kufa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.2",
            "verseOrgIds": [
              "ECC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:2"
      },
      "items": [
        {
          "text": "wakati wa kupanda na wakati wa kungʼoa yaliyopandwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.2",
            "verseOrgIds": [
              "ECC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kuua na wakati wa kuponya,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.3",
            "verseOrgIds": [
              "ECC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:3"
      },
      "items": [
        {
          "text": "wakati wa kubomoa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.3",
            "verseOrgIds": [
              "ECC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:3"
      },
      "items": [
        {
          "text": "na wakati wa kujenga,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.3",
            "verseOrgIds": [
              "ECC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kulia na wakati wa kucheka,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.4",
            "verseOrgIds": [
              "ECC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:4"
      },
      "items": [
        {
          "text": "wakati wa kuomboleza na wakati wa kucheza,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.4",
            "verseOrgIds": [
              "ECC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kutawanya mawe na wakati wa kukusanya mawe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.5",
            "verseOrgIds": [
              "ECC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:5"
      },
      "items": [
        {
          "text": "wakati wa kukumbatia na wakati wa kutokumbatia,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.5",
            "verseOrgIds": [
              "ECC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kutafuta na wakati wa kupoteza,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.6",
            "verseOrgIds": [
              "ECC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:6"
      },
      "items": [
        {
          "text": "wakati wa kuweka na wakati wa kutupa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.6",
            "verseOrgIds": [
              "ECC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kurarua na wakati wa kushona,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
              "ECC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:7"
      },
      "items": [
        {
          "text": "wakati wa kunyamaza na wakati wa kuzungumza,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
              "ECC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa kupenda na wakati wa kuchukia,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:8"
      },
      "items": [
        {
          "text": "wakati wa vita na wakati wa amani.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfanyakazi anapata faida gani kutokana na taabu yake?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimeona mzigo Mungu alioweka juu ya wanadamu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amefanya kila kitu kiwe kizuri kwa wakati wake. Pia ameiweka hiyo milele katika mioyo ya wanadamu, wala hawawezi kutambua kwa kina yale ambayo Mungu amefanya tangu mwanzo hadi mwisho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninajua kwamba hakuna kitu bora kwa wanadamu kuliko kuwa na furaha na kutenda mema wakati wanapoishi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena ni karama ya Mungu kila mtu apate kula na kunywa na kujiburudisha kwa mema katika kazi yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninajua kwamba kila kitu anachokifanya Mungu kitadumu milele, hakuna kinachoweza kuongezwa au kupunguzwa. Mungu hufanya hivyo ili watu wamche yeye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochote kilichopo kilishakuwepo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:15"
      },
      "items": [
        {
          "text": "na kitakachokuwepo kimekwishakuwepo kabla;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:15"
      },
      "items": [
        {
          "text": "naye Mungu huyaita yale yaliyopita yarudi tena.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia nikaona kitu kingine tena chini ya jua:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 3:16"
      },
      "items": [
        {
          "text": "Mahali pa kutolea hukumu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:16"
      },
      "items": [
        {
          "text": "uovu ulikuwepo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 3:16"
      },
      "items": [
        {
          "text": "mahali pa kupatia haki,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:16"
      },
      "items": [
        {
          "text": "uovu ulikuwepo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikafikiri moyoni mwangu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 3:17"
      },
      "items": [
        {
          "text": "\"Mungu atawaleta hukumuni",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:17"
      },
      "items": [
        {
          "text": "wote wawili wenye haki na waovu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 3:17"
      },
      "items": [
        {
          "text": "kwa maana kutakuwako na wakati kwa ajili ya kila jambo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 3:17"
      },
      "items": [
        {
          "text": "wakati kwa ajili ya kila tendo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia nikafikiri, \"Kuhusu wanadamu, Mungu huwajaribu ili wajione kwamba wao ni kama wanyama.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatima ya mwanadamu ni kama ile ya wanyama; wote wana mwisho unaofanana: Jinsi anavyokufa mnyama, ndivyo anavyokufa mwanadamu. Wote wana pumzi inayofanana; mwanadamu hana cha zaidi kuliko mnyama. Kila kitu ni ubatili.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.19",
            "verseOrgIds": [
              "ECC.3.19"
            ]
          }
        },
        {
          "name": "verse",
