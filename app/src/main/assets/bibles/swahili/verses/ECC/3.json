            "sid": "ECC 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani ajuaye kama roho ya mtu huenda juu na roho ya mnyama hushuka chini ardhini?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.21",
