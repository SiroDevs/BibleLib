              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wote huenda mahali panapofanana; wote hutoka mavumbini, mavumbini wote hurudi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
            "verseOrgIds": [
              "ECC.3.20"
            ]
          }
        },
        {
