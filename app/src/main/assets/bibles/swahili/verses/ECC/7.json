  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ECC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hekima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afadhali sifa nzuri kuliko manukato safi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:1"
      },
      "items": [
        {
          "text": "nayo siku ya kufa kuliko ya kuzaliwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afadhali kwenda kwenye nyumba ya msiba",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "kuliko kwenda kwenye nyumba ya karamu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "kwa kuwa kifo ni hatima ya kila mwanadamu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "imewapasa walio hai kuliweka hili mioyoni mwao.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huzuni ni afadhali kuliko kicheko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:3"
      },
      "items": [
        {
          "text": "kwa sababu uso wenye huzuni wafaa kwa moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wa wenye hekima uko katika nyumba ya msiba,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:4"
      },
      "items": [
        {
          "text": "lakini moyo wa wapumbavu uko katika nyumba ya anasa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afadhali kusikia karipio la mtu mwenye hekima,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:5"
      },
      "items": [
        {
          "text": "kuliko kusikiliza wimbo wa wapumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ilivyo kuvunjika kwa miiba chini ya sufuria,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:6"
      },
      "items": [
        {
          "text": "ndivyo kilivyo kicheko cha wapumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:6"
      },
      "items": [
        {
          "text": "Hili nalo pia ni ubatili.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuluma humfanya mtu mwenye hekima kuwa mpumbavu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:7"
      },
      "items": [
        {
          "text": "nayo rushwa huuharibu moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisho wa jambo ni bora kuliko mwanzo wake,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:8"
      },
      "items": [
        {
          "text": "uvumilivu ni bora kuliko kiburi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiwe mwepesi kukasirika rohoni mwako,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:9"
      },
      "items": [
        {
          "text": "kwa kuwa hasira hukaa kifuani mwa wapumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiseme, \"Kwa nini siku za kale zilikuwa bora kuliko siku hizi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:10"
      },
      "items": [
        {
          "text": "Kwa maana si hekima kuuliza maswali kama hayo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekima, kama ulivyo urithi, ni kitu chema",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:11"
      },
      "items": [
        {
          "text": "na huwafaidia wale walionalo jua.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekima ni ulinzi kama fedha ilivyo ulinzi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "lakini faida ya maarifa ni hii:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "kwamba hekima huhifadhi maisha ya aliye nayo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tafakari kile Mungu alichokitenda:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:13"
      },
      "items": [
        {
          "text": "Nani awezaye kunyoosha",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:13"
      },
      "items": [
        {
          "text": "kile ambacho yeye amekipinda?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakati zikiwa nzuri, ufurahi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "lakini nyakati zikiwa mbaya, tafakari:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "Mungu amefanya hiyo moja,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "naam, sanjari",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        },
        {
          "text": "na hiyo nyingine.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "Kwa hiyo, mwanadamu hawezi kugundua",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "kitu chochote kuhusu maisha yake ya baadaye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
