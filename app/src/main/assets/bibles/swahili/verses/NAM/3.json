            "number": "1",
            "style": "v",
            "sid": "NAM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wa mji umwagao damu,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "uliojaa uongo,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "umejaa nyara,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "usiokosa kuwa na vitu vya kuteka nyara.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelele za mijeledi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "vishindo vya magurudumu,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "farasi waendao mbio",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "na mshtuo wa magari ya vita!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapanda farasi wanaenda mbio,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "panga zinameremeta,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "na mikuki inangʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "Majeruhi wengi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "malundo ya maiti,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "idadi kubwa ya miili isiyohesabika,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "watu wanajikwaa juu ya mizoga:",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yote haya kwa sababu ya wingi wa tamaa za kahaba,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "anayeshawishi, bibi wa mambo ya uchawi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "anayewatia utumwani mataifa kwa ukahaba wake",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "na pia jamaa za watu kwa ulozi wake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NAM.3.5",
                "verseOrgIds": [
                  "NAM.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote anasema,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "\"Mimi ni kinyume na ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "Nitafunika uso wako kwa gauni lako.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "Nitaonyesha mataifa uchi wako",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "na falme aibu yako.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakutupia uchafu,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "nitakufanyia dharau",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "na kukufanya kioja.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wote wanaokuona watakukimbia na kusema,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "'Ninawi ipo katika kuangamia:",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "ni nani atakayeomboleza kwa ajili yake?'",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "Nitampata wapi yeyote wa kukufariji?\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, wewe ni bora kuliko No-Amoni,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "uliopo katika Mto Naili,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "uliozungukwa na maji?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "Mto ulikuwa kinga yake,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "nayo maji yalikuwa ukuta wake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushi",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        },
        {
          "text": "na Misri walikuwa nguvu zake zisizo na mpaka;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:9"
      },
      "items": [
        {
          "text": "Putu na Libia walikuwa miongoni mwa wale walioungana naye.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo alichukuliwa mateka",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "na kwenda uhamishoni.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "Watoto wake wachanga walivunjwa vunjwa vipande",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "kwenye mwanzo wa kila barabara.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
