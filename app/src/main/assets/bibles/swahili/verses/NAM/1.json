    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "na vilima huyeyuka.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "Nchi hutetemeka mbele yake,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "dunia na wote waishio ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani awezaye kuzuia hasira yake yenye uchungu?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Nani awezaye kuvumilia hasira yake kali?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Ghadhabu yake imemiminwa kama moto,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "na miamba inapasuka mbele zake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
