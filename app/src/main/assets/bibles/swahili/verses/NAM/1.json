          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno alilosema Mungu kuhusu Ninawi. Kitabu cha maono cha Nahumu, Mwelkoshi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.1",
            "verseOrgIds": [
              "NAM.1.1"
            ]
          }
        }
      ]
    },
