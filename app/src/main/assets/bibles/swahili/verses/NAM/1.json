          "text": "Ee Ninawi, kutoka kwako amejitokeza mmoja,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:11"
      },
      "items": [
        {
          "text": "ambaye anapanga shauri baya",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
    },
