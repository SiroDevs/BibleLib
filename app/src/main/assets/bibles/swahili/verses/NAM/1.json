                "verseId": "NAM.1.2",
                "verseOrgIds": [
                  "NAM.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mwenye wivu na Mungu mlipiza kisasi;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.2",
                "verseOrgIds": [
                  "NAM.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hulipiza kisasi na amejaa ghadhabu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
