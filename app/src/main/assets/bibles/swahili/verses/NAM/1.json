      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "yeye atalikomesha;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
