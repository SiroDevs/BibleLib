          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akasema, \"Bwana na asikasirike, lakini niruhusu nizungumze tena mara moja tu. Itakuwaje kama watapatikana huko watu kumi tu?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
