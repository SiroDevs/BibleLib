  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "GEN 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Akutana Na Esau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akainua macho akamwona Esau akija na watu wake 400, kwa hiyo akawagawanya watoto kati ya Lea, Raheli na wale watumishi wake wawili wa kike.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaweka wale watumishi wa kike na watoto wao mbele, Lea na watoto wake wakafuata, Raheli na Yosefu wakaja nyuma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye mwenyewe akatangulia mbele na kusujudu mara saba alipomkaribia ndugu yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Esau akamkimbilia Yakobo kumlaki na kumkumbatia, akamwangukia shingoni na kumbusu. Nao wakalia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akainua macho akawaona wale wanawake na watoto. Akauliza, \"Hawa uliofuatana nao ni nani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:5"
      },
      "items": [
        {
          "text": "Yakobo akamjibu, \"Ni watoto ambao Mungu amempa mtumishi wako kwa neema.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wale watumishi wa kike na watoto wao wakakaribia na kusujudu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Lea na watoto wake wakaja na kusujudu. Mwisho wa wote wakaja Yosefu na Raheli, nao pia wakasujudu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akauliza, \"Una maana gani kuhusu makundi hayo yote niliyokutana nayo?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:8"
      },
      "items": [
        {
          "text": "Akasema, \"Ni ili kupata kibali machoni pako, bwana wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Esau akamwambia, \"Ndugu yangu, tayari nina wingi wa mali. Ulivyo navyo viwe vyako mwenyewe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akasema, \"La hasha! Tafadhali, kama nimepata kibali machoni pako, upokee zawadi hii kutoka kwangu. Kwa maana kuuona uso wako, ni kama kuuona uso wa Mungu, kwa kuwa umenipokea kwa takabali kubwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tafadhali ukubali zawadi iliyoletwa kwako, kwa kuwa Mungu amenineemesha na ninavyo vyote ninavyohitaji.\" Kwa sababu Yakobo alisisitiza, Esau akapokea.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Esau akasema, \"Na tuendelee na safari, nitakuwa pamoja nawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Yakobo akamwambia, \"Bwana wangu unajua kwamba watoto ni wachanga na kwamba ni lazima nitunze hawa kondoo wake na ngʼombe wanaonyonyesha. Wakipelekwa kwa haraka hata kama ni kwa siku moja tu, wanyama wote watakufa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo bwana wangu umtangulie mtumishi wako, wakati mimi nikija polepole kwa mwendo wa makundi yaliyo mbele yangu na mwendo wa watoto, mpaka nifike kwa bwana wangu huko Seiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akamwambia, \"Basi na niwaache baadhi ya watu wangu pamoja nawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:15"
      },
      "items": [
        {
          "text": "Yakobo akauliza, \"Lakini kwa nini ufanye hivyo, niache tu nipate kibali machoni pa bwana wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo siku hiyo Esau akashika njia akarudi Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamoja na hayo, Yakobo akaenda Sukothi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        },
        {
          "text": "mahali alipojijengea makazi kwa ajili yake na mabanda kwa ajili ya mifugo yake. Hii ndiyo sababu sehemu ile inaitwa Sukothi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Yakobo kutoka Padan-Aramu, alifika salama katika mji wa Shekemu huko Kanaani na kuweka kambi yake karibu na mji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.18",
            "verseOrgIds": [
              "GEN.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanunua kiwanja kutoka kwa wana wa Hamori, baba wa Shekemu, kwa bei ya vipande mia vya fedha, ambapo alipiga hema lake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.19",
            "verseOrgIds": [
              "GEN.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pale akajenga madhabahu na kupaita El-Elohe-Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.20",
            "verseOrgIds": [
              "GEN.33.20"
            ]
          }
        }
      ]
    }
  ],
