      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:23"
      },
      "items": [
        {
          "text": "Hushimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        }
      ]
    },
    {
