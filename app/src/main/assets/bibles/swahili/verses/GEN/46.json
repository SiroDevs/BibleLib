          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Benyamini ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:21"
      },
      "items": [
        {
          "text": "Bela, Bekeri, Ashbeli, Gera, Naamani, Ehi, Roshi, Mupimu, Hupimu na Ardi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio wana wa Raheli aliomzalia Yakobo; jumla yao ni kumi na wanne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.22",
            "verseOrgIds": [
              "GEN.46.22"
            ]
          }
        }
      ]
    },
