  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "GEN 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Aenda Misri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Israeli akaondoka na vyote vilivyokuwa mali yake, naye alipofika Beer-Sheba, akamtolea dhabihu Mungu wa Isaki baba yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.1",
            "verseOrgIds": [
              "GEN.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akanena na Israeli katika maono usiku na kusema, \"Yakobo! Yakobo!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 46:2"
      },
      "items": [
        {
          "text": "Akajibu, \"Mimi hapa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akamwambia, \"Mimi ndimi Mungu wa baba yako, usiogope kushuka Misri, kwa maana huko nitakufanya taifa kubwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.3",
            "verseOrgIds": [
              "GEN.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitashuka Misri pamoja nawe, nami hakika nitakurudisha tena Kanaani. Mikono ya Yosefu mwenyewe ndiyo itakayofunga macho yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.4",
            "verseOrgIds": [
              "GEN.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yakobo akaondoka Beer-Sheba nao wana wa Israeli wakamchukua baba yao Yakobo na watoto wao na wake zao katika magari ya kukokotwa yale Farao aliyokuwa amempelekea kumsafirisha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.5",
            "verseOrgIds": [
              "GEN.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakachukua pia mifugo yao na mali walizokuwa wamezipata Kanaani, Yakobo na uzao wake wote wakashuka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.6",
            "verseOrgIds": [
              "GEN.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawachukua wanawe na binti zake, wajukuu wake wa kiume na wa kike, yaani uzao wake wote mpaka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo majina ya wana wa Israeli (Yakobo na wazao wake), waliokwenda Misri:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 46:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 46:8"
      },
      "items": [
        {
          "text": "Reubeni mzaliwa wa kwanza wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Reubeni ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:9"
      },
      "items": [
        {
          "text": "Hanoki, Palu, Hesroni na Karmi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Simeoni ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:10"
      },
      "items": [
        {
          "text": "Yemueli, Yamini, Ohadi, Yakini, Sohari na Shauli mwana wa mwanamke Mkanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Lawi ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:11"
      },
      "items": [
        {
          "text": "Gershoni, Kohathi na Merari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Yuda ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:12"
      },
      "items": [
        {
          "text": "Eri, Onani, Shela, Peresi na Zera (lakini Eri na Onani walifariki katika nchi ya Kanaani).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:12"
      },
      "items": [
        {
          "text": "Wana wa Peresi ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "GEN 46:12"
      },
      "items": [
        {
          "text": "Hesroni na Hamuli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Isakari ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:13"
      },
      "items": [
        {
          "text": "Tola, Puva, Yashubu na Shimroni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Zabuloni ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:14"
      },
      "items": [
        {
          "text": "Seredi, Eloni na Yaleeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio wana wa Lea aliomzalia Yakobo huko Padan-Aramu pamoja na binti yake Dina. Jumla ya wanawe na binti zake walikuwa thelathini na watatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.15",
            "verseOrgIds": [
              "GEN.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Gadi ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:16"
      },
      "items": [
        {
          "text": "Sefoni, Hagi, Shuni, Esboni, Eri, Arodi na Areli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Asheri ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Imna, Ishva, Ishvi na Beria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Dada yao alikuwa Sera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Wana wa Beria ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Heberi na Malkieli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio watoto Zilpa aliomzalia Yakobo, ambao Labani alimpa binti yake Lea; jumla yao walikuwa kumi na sita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.18",
            "verseOrgIds": [
              "GEN.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Raheli mke wa Yakobo ni:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:19"
      },
      "items": [
        {
          "text": "Yosefu na Benyamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko Misri, Asenathi binti wa Potifera, aliyekuwa kuhani wa mji wa Oni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.20",
            "verseOrgIds": [
              "GEN.46.20"
            ]
          }
        },
        {
          "text": "alimzalia Yosefu wana wawili, Manase na Efraimu.",
          "type": "text",
          "attrs": {
