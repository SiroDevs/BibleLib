        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agano La Tohara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu alipokuwa na miaka tisini na tisa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.17.1",
                "verseOrgIds": [
                  "GEN.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamtokea akamwambia, \"Mimi ndimi Mungu Mwenyezi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "text": "enenda mbele zangu na uishi kwa unyofu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitafanya Agano langu kati yangu na wewe, nami nitakuzidisha sana sana.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu akaanguka kifudifudi, naye Mungu akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa upande wangu, hili ndilo Agano langu na wewe: Wewe utakuwa baba wa mataifa mengi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jina lako hutaitwa tena Abramu, bali jina lako litakuwa Abrahamu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "text": "kwa maana nimekufanya wewe baba wa mataifa mengi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakufanya uwe na uzao mwingi sana, kwako yatatoka mataifa nao wafalme watatoka kwako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitalithibitisha Agano langu kama Agano la milele kati yangu na wewe na wazao wako baada yako na vizazi vijavyo niwe Mungu wako na Mungu wa wazao wako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchi yote ya Kanaani, unakoishi sasa kama mgeni, nitakupa kuwa milki yako milele, na uzao wako, nami nitakuwa Mungu wao.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mungu akamwambia Abrahamu, \"Kwa upande wako, lazima ushike Agano langu, wewe na wazao wako kwa ajili ya vizazi vijavyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ni Agano langu na wewe pamoja na wazao wako baada yako, Agano mtakalolishika: Kila mwanaume miongoni mwenu atatahiriwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtafanyiwa tohara na hii itakuwa ni alama ya Agano kati yangu na ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa vizazi vijavyo, kila mwanaume miongoni mwenu mwenye siku nane ni lazima atahiriwe, pamoja na watakaozaliwa nyumbani mwako au walionunuliwa kwa fedha kutoka kwa mgeni, wale ambao sio watoto wako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awe amezaliwa nyumbani mwako au amenunuliwa kwa fedha yako, ni lazima watahiriwe. Agano langu katika mwili wako litakuwa ni Agano la milele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mwanaume asiyetahiriwa, ambaye hajapata tohara ya mwilini, atatengwa na watu wake, amelivunja Agano langu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.17.15",
                "verseOrgIds": [
                  "GEN.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Abrahamu, \"Kwa upande wa Sarai mkeo, hutamwita tena Sarai bali jina lake litakuwa Sara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitambariki na hakika nitakupatia mwana kwake. Nitambariki na kwamba atakuwa mama wa mataifa, wafalme wa mataifa watatoka kwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akaanguka kifudifudi, akacheka na kusema moyoni mwake, \"Je, mtu wa miaka mia moja aweza kuzaa mwana? Je, Sara atazaa mtoto katika umri wa miaka tisini?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu akamwambia Mungu, \"Laiti Ishmaeli naye angeshiriki baraka yako!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mungu akasema, \"Ndiyo, lakini mkeo Sara atakuzalia wewe mwana, nawe utamwita jina lake Isaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "text": "Nitalithibitisha Agano langu naye kama Agano la milele kwa ajili yake na wazao wake baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa upande wa Ishmaeli, nimekusikia: hakika nitambariki, nitamfanya awe na uzao mwingi na nitaongeza sana idadi yake. Atakuwa baba wa watawala kumi na wawili, nami nitamfanya awe taifa kubwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Agano langu nitalithibitisha kwa Isaki, ambaye Sara atakuzalia mwaka ujao majira kama haya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati alipomaliza kuzungumza na Abrahamu, Mungu akapanda juu akaondoka kwa Abrahamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile ile, Abrahamu akamchukua Ishmaeli mwanawe na wote waliozaliwa nyumbani mwake pamoja na walionunuliwa kwa fedha zake, kila mwanaume wa nyumbani mwake, akawatahiri, kama Mungu alivyomwagiza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu alikuwa na umri wa miaka tisini na tisa alipotahiriwa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Ishmaeli mwanawe alitahiriwa akiwa na umri wa miaka kumi na mitatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu na Ishmaeli mwanawe walitahiriwa siku ile ile,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
              "GEN.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mwanaume nyumbani mwa Abrahamu, pamoja na wote waliozaliwa nyumbani mwake au aliyenunuliwa kwa fedha kutoka kwa mgeni, alitahiriwa pamoja naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.27",
            "verseOrgIds": [
              "GEN.17.27"
            ]
          }
        }
      ]
    }
  ],
