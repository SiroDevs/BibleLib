              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hii ni orodha iliyoandikwa ya vizazi vya Adamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        }
      ]
    },
    {
