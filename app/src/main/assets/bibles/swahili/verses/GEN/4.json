      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "\"Ada na Sila nisikilizeni mimi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
