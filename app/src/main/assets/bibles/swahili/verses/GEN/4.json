              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama Kaini atalipizwa kisasi mara saba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
            "verseOrgIds": [
              "GEN.4.24"
