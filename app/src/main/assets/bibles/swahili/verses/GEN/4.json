              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameki akawaambia wake zake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
