      "attrs": {
        "style": "q2",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "wake wa Lameki sikieni maneno yangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
      ]
