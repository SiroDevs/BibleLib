          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio wazao wa Tera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 11:27"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 11:27"
      },
      "items": [
        {
          "text": "Tera aliwazaa Abramu, Nahori na Harani. Harani akamzaa Loti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera alipokuwa bado hai, Harani akafa huko Uru ya Wakaldayo, nchi alimozaliwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu na Nahori walioa. Mke wa Abramu aliitwa Sarai, na mke wa Nahori aliitwa Milka; Milka na Iska walikuwa watoto wa Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarai alikuwa tasa, hakuwa na watoto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera akamchukua Abramu mwanawe, Loti mwana wa Harani mwanawe, na Sarai mkwewe, mke wa Abramu mwanawe, wakatoka kwa pamoja katika Uru ya Wakaldayo kwenda nchi ya Kanaani. Lakini walipofika Harani, wakaishi huko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera alikufa huko Harani akiwa na miaka 205.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
      ]
