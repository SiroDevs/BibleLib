  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "GEN 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda Na Tamari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ule, Yuda akawaacha ndugu zake, akaenda kuishi na Hira Mwadulami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko Yuda akakutana na binti wa Kikanaani aitwaye Shua, akamwoa na akakutana naye kimwili,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akapata mimba, akamzaa mwana, ambaye alimwita Eri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapata mimba tena, akamzaa mwana na kumwita Onani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamzaa mwana mwingine tena, akamwita Shela. Huyu alimzalia mahali paitwapo Kezibu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akampatia Eri, mzaliwa wake wa kwanza, mke aitwaye Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Eri, mzaliwa wa kwanza wa Yuda, alikuwa mwovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.38.7",
                "verseOrgIds": [
                  "GEN.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwa hiyo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.38.7",
                "verseOrgIds": [
                  "GEN.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akamuua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yuda akamwambia Onani, \"Kutana kimwili na mke wa ndugu yako, na utimize wajibu wako kwake kama mke wa ndugu yako, ili umpatie ndugu yako uzao.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Onani alijua kwamba uzao haungekuwa wake, kwa hiyo kila alipokutana kimwili na mke wa ndugu yake, alimwaga chini mbegu za kiume ili asimpatie ndugu yake uzao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alichofanya kilikuwa kiovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.38.10",
                "verseOrgIds": [
                  "GEN.38.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", hivyo, pia",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.38.10",
                "verseOrgIds": [
                  "GEN.38.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akamuua Onani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yuda akamwambia Tamari mkwewe, \"Ishi kama mjane nyumbani mwa baba yako mpaka mwanangu Shela atakapokua.\" Kwa maana alifikiri, \"Angeweza kufa pia kama ndugu zake.\" Kwa hiyo Tamari alikwenda kuishi nyumbani kwa baba yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya muda mrefu mke wa Yuda binti wa Shua akafariki. Baada ya msiba, Yuda alikwenda Timna, kwa watu waliokuwa wakikata kondoo wake manyoya, naye alifuatana na rafiki yake Hira Mwadulami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.12",
            "verseOrgIds": [
              "GEN.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari alipoambiwa, \"Baba mkwe wako yuko njiani kwenda Timna kukata kondoo wake manyoya,\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.13",
            "verseOrgIds": [
              "GEN.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "alivua mavazi yake ya ujane, akajifunika kwa shela ili asifahamike, akaketi kwenye mlango wa Enaimu, ambao upo njiani kuelekea Timna. Akafanya hivyo kwa sababu aliona kwamba, ingawa Shela amekua, lakini alikuwa hajakabidhiwa kwake kuwa mkewe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.14",
            "verseOrgIds": [
              "GEN.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda alipomwona alifikiri ni kahaba, kwa sababu alikuwa amefunika uso wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.15",
            "verseOrgIds": [
              "GEN.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasipo kutambua kwamba alikuwa mkwe wake, akamwendea kando ya njia na kumwambia, \"Njoo sasa, nikutane na wewe kimwili.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:16"
      },
      "items": [
        {
          "text": "Yule mkwewe akamuuliza, \"Utanipa nini nikikutana nawe kimwili?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia, \"Nitakutumia mwana-mbuzi kutoka kundi langu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:17"
      },
      "items": [
        {
          "text": "Akamuuliza, \"Utanipa kitu chochote kama amana mpaka utakapompeleka?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamuuliza, \"Nikupe amana gani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:18"
      },
      "items": [
        {
          "text": "Akamjibu, \"Pete yako na kamba yake pamoja na fimbo iliyo mkononi mwako.\" Kwa hiyo akampa vitu hivyo kisha akakutana naye kimwili, naye akapata mimba yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari akaondoka, akavua shela yake akavaa tena nguo zake za ujane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ule ule, Yuda akamtuma rafiki yake Mwadulami apeleke yule mwana-mbuzi ili arudishiwe amana yake kutoka kwa yule mwanamke, lakini yule rafiki yake hakumkuta yule mwanamke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawauliza watu wanaoishi mahali pale, \"Yuko wapi yule kahaba wa mahali pa kuabudia miungu aliyekuwa kando ya barabara hapa Enaimu?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:21"
      },
      "items": [
        {
          "text": "Wakamjibu, \"Hajawahi kuwepo mwanamke yeyote kahaba wa mahali pa kuabudia miungu hapa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo akamrudia Yuda na kumwambia, \"Sikumpata. Zaidi ya hayo, watu wanaoishi mahali pale walisema 'Hapakuwahi kuwepo mwanamke yeyote kahaba wa mahali pa kuabudia miungu hapa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yuda akasema, \"Mwache avichukue vitu hivyo, ama sivyo tutakuwa kichekesho. Hata hivyo, nilimpelekea mwana-mbuzi, lakini hukumkuta.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya miezi mitatu Yuda akaambiwa, \"Tamari mkweo ana hatia ya kuwa kahaba, na matokeo yake ana mimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:24"
      },
      "items": [
        {
          "text": "Yuda akasema, \"Mtoeni nje na achomwe moto hadi afe!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokuwa akitolewa nje, akatuma ujumbe kwa baba mkwe wake kusema, \"Nina mimba ya mtu mwenye vitu hivi.\" Akaongeza kusema, \"Angalia kama utatambua kwamba pete hii na kamba yake pamoja na fimbo hii ni vya nani.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akavitambua na kusema, \"Yeye ana haki kuliko mimi, kwa kuwa sikumkabidhi kwa mwanangu Shela ili awe mkewe.\" Tangu hapo hakukutana naye kimwili tena.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ulipofika wa kujifungua, kukawa na wana mapacha tumboni mwake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokuwa akijifungua, mmoja akatoa mkono wake nje, kwa hiyo mkunga akachukua uzi mwekundu na kuufunga mkononi mwa yule mtoto, akasema, \"Huyu ametoka kwanza.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini alipourudisha mkono wake ndugu yake akaanza kutoka, naye akasema, \"Hivi ndivyo ulivyotoka kwa nguvu!\" Akaitwa Peresi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha ndugu yake, aliyekuwa na uzi mwekundu mkononi, akatoka, naye akaitwa Zera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        }
      ]
    }
  ],
