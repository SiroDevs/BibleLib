  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "GEN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuangamizwa Kwa Sodoma Na Gomora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wale wawili wakafika Sodoma wakati wa jioni, naye Loti alikuwa ameketi kwenye lango la mji. Wakati alipowaona, aliondoka kwenda kuwalaki na kuwasujudia hadi chini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.1",
            "verseOrgIds": [
              "GEN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, \"Bwana zangu, tafadhali karibuni kwenye nyumba ya mtumishi wenu. Mnaweza kunawa miguu na kulala hapa kisha asubuhi na mapema mwendelee na safari yenu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 19:2"
      },
      "items": [
        {
          "text": "Wakamjibu, \"La hasha, tutalala hapa nje uwanjani.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini akasisitiza kwa nguvu kwamba waingie pamoja naye nyumbani kwake. Akawaandalia chakula, mikate isiyotiwa chachu, nao wakala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.3",
            "verseOrgIds": [
              "GEN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabla hawajaenda kulala, watu wote kutoka kila sehemu ya mji wa Sodoma, vijana kwa wazee, waliizunguka nyumba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.4",
            "verseOrgIds": [
              "GEN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwita Loti wakisema, \"Wako wapi wale watu ambao walikuja kwako jioni hii? Watoe nje kwetu ili tuweze kuwalawiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.5",
            "verseOrgIds": [
              "GEN.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti akatoka nje kuonana nao, akaufunga mlango nyuma yake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.6",
            "verseOrgIds": [
              "GEN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akasema, \"La hasha, rafiki zangu. Msifanye jambo hili ovu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.7",
            "verseOrgIds": [
              "GEN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, ninao binti wawili ambao kamwe hawajakutana kimwili na mwanaume. Acha niwatoe nje kwenu, nanyi mnaweza kuwafanyia lolote mnalotaka. Lakini msiwafanyie chochote watu hawa, kwa sababu wako kwenye ulinzi chini ya dari langu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.8",
            "verseOrgIds": [
              "GEN.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamjibu, \"Tuondokee mbali.\" Wakaendelea kusema, \"Huyu mtu alikuja hapa kama mgeni na sasa anataka kuwa mwamuzi wetu! Tutakutenda vibaya kuliko wao.\" Waliendelea kumlazimisha Loti na kusonga mbele ili kuvunja mlango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.9",
            "verseOrgIds": [
              "GEN.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu wale waliokuwa ndani wakanyoosha mkono wakamvuta Loti ndani ya nyumba na kufunga mlango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.10",
            "verseOrgIds": [
              "GEN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakawapiga kwa upofu wale watu waliokuwa mlangoni mwa ile nyumba, vijana kwa wazee, hivyo hawakuweza kuupata mlango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale watu wawili wakamwambia Loti, \"Una mtu mwingine yeyote hapa, wakwe zako, wana au binti, ama yeyote mwingine aliye wako katika mji huu? Waondoe hapa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.12",
            "verseOrgIds": [
              "GEN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu tunapaangamiza mahali hapa. Kilio kwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.13",
                "verseOrgIds": [
                  "GEN.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dhidi ya watu wa hapa ni kikubwa kiasi kwamba ametutuma kupaangamiza.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Loti alitoka ili kuzungumza na wakwe zake, waliokuwa wamewaposa binti zake. Akawaambia, \"Fanyeni haraka kuondoka mahali hapa, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.14",
                "verseOrgIds": [
                  "GEN.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "yu karibu kuangamiza mji huu!\" Lakini wakwe zake walifikiri kwamba alikuwa akitania.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunako mapambazuko, malaika wakamhimiza Loti, wakamwambia, \"Fanya haraka! Mchukue mke wako na binti zako wawili walioko hapa, la sivyo utaangamizwa wakati mji utakapoadhibiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.15",
            "verseOrgIds": [
              "GEN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipositasita, wale watu wakamshika mkono wake na mikono ya mke wake na binti zake wawili na kuwaongoza salama nje ya mji, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.16",
                "verseOrgIds": [
                  "GEN.19.16"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa na huruma kwao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara walipokwisha kuwatoa nje, mmoja wao akawaambia, \"Mkimbie kwa usalama wenu! Msitazame nyuma, wala msisimame popote katika nchi tambarare! Kimbilieni milimani, ama sivyo mtaangamizwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.17",
            "verseOrgIds": [
              "GEN.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Loti akawajibu, \"La hasha, bwana zangu, tafadhalini!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.18",
            "verseOrgIds": [
              "GEN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumishi wenu amepata kibali mbele ya macho yenu, nanyi mmeonyesha wema mkubwa kwangu kwa kuokoa maisha yangu. Lakini siwezi kukimbilia milimani, janga hili litanikumba, nami nitakufa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, hapa kuna mji karibu wa kukimbilia, nao ni mdogo. Niruhusuni nikimbilie humo, ni mdogo sana, ama sivyo? Ndipo maisha yangu yatasalimika.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia, \"Vema sana, nitalikubali hili ombi pia, sitauangamiza mji ulioutaja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ukimbilie huko haraka, kwa sababu sitaweza kufanya lolote mpaka ufike huko.\" (Ndiyo maana mji huo ukaitwa Soari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
          "text": ")",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Loti alipofika Soari, jua lilikuwa limechomoza katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.24",
                "verseOrgIds": [
                  "GEN.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": "akanyesha moto wa kiberiti uliotoka mbinguni kwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.24",
                "verseOrgIds": [
                  "GEN.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": "juu ya Sodoma na Gomora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo akaiteketeza miji ile na eneo lote la tambarare, pamoja na wote waliokuwa wanaishi katika miji, hata pia mimea yote katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mke wa Loti akatazama nyuma, hivyo akawa nguzo ya chumvi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubuhi na mapema siku iliyofuata, Abrahamu akaamka na kurudi mahali pale aliposimama mbele za",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.27",
                "verseOrgIds": [
                  "GEN.19.27"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatazama upande wa Sodoma na Gomora, kuelekea nchi yote ya tambarare, akaona moshi mzito ukipanda kutoka kwenye nchi, kama moshi utokao kwenye tanuru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Mungu alipoiangamiza miji ya tambarare alimkumbuka Abrahamu, akamtoa Loti kutoka kwenye lile janga lililoharibu miji ile ambamo Loti alikuwa ameishi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Loti Na Binti Zake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti na binti zake wawili waliondoka Soari na kufanya makao yao kule milimani, kwa maana aliogopa kukaa Soari. Yeye na binti zake wawili waliishi katika pango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku moja binti mkubwa akamwambia yule mdogo, \"Baba yetu ni mzee na hakuna mwanaume mahali hapa atakayekutana na sisi kimwili, kama ilivyo desturi ya mahali pote duniani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumnyweshe baba yetu mvinyo kisha tukutane naye kimwili ili tuhifadhi uzao wetu kupitia baba yetu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ule walimnywesha baba yao mvinyo, alipolewa binti yake mkubwa akaingia na kukutana naye kimwili. Baba yao hakujua wakati binti yake alipoingia kulala naye wala alipotoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iliyofuata binti mkubwa akamwambia yule mdogo, \"Usiku uliopita mimi nilikutana kimwili na baba yangu. Tumnyweshe divai tena, usiku huu nawe ukutane naye kimwili ili tuweze kuhifadhi uzao wetu kupitia baba yetu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakamnywesha baba yao mvinyo tena usiku ule, naye binti yake mdogo akaingia, akakutana naye kimwili. Kwa mara nyingine baba yao hakujua binti yake alipolala naye wala alipoondoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo binti wawili wa Loti wakapata mimba kwa baba yao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binti mkubwa akamzaa mwana, akamwita jina lake Moabu; ndio baba wa Wamoabu hata leo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binti mdogo naye pia akamzaa mwana, naye akamwita Benami; ndiye baba wa Waamoni hata leo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    }
  ],
