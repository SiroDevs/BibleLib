          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sasa basi, tafadhali mruhusu mtumishi abaki hapa kama mtumwa wa bwana wangu badala ya kijana, naye kijana umruhusu arudi na ndugu zake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        },
        {
