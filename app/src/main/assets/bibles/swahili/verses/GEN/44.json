              "type": "text"
            }
          ]
        },
        {
          "text": "akiona kijana hayupo nasi, atakufa. Watumishi wako watashusha kichwa chenye mvi cha baba yetu kaburini kwa huzuni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 44:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumwa wako alimhakikishia baba yangu usalama wa kijana. Nikamwambia, 'Kama sikumrudisha kwako nitakuwa mwenye lawama mbele yako, baba yangu, maisha yangu yote!'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        }
      ]
    },
