          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninawezaje kurudi kwa baba yangu kama kijana hatakuwa pamoja nami? La hasha! Usiniache nikaone huzuni ile itakayompata baba yangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.34",
