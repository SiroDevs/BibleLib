          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia Yakobo akakutana na Raheli kimwili, naye akampenda Raheli zaidi kuliko Lea. Yakobo akamtumikia Labani kwa miaka mingine saba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
