          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yakobo akafanya hivyo. Akamaliza juma na Lea, kisha Labani akampa Raheli binti yake kuwa mke wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
