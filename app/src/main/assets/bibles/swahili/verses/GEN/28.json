  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "GEN 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Isaki akamwita Yakobo, akambariki na akamwamuru, akisema, \"Usioe mwanamke wa Kikanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda mara moja mpaka Padan-Aramu, kwenye nyumba ya Bethueli baba wa mama yako. Uchukue mke kati ya binti za Labani ambaye ni ndugu wa mama yako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu Mwenyezi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "text": "na akubariki uwe na uzao uongezeke idadi yako upate kuwa jamii kubwa ya watu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akupe wewe na uzao wako baraka aliyopewa Abrahamu, upate kumiliki nchi unayoishi sasa kama mgeni, nchi ambayo Mungu alimpa Abrahamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Isaki akamuaga Yakobo, naye akaenda Padan-Aramu, kwa Labani mwana wa Bethueli Mwaramu, ndugu wa Rebeka, aliyekuwa mama wa Yakobo na Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa Esau akajua kuwa Isaki amembariki Yakobo na kumtuma kwenda Padan-Aramu ili achukue mke huko na kwamba alipombariki alimwamuru akisema, \"Usioe mke katika binti za Wakanaani,\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tena kwamba Yakobo amewatii baba yake na mama yake naye amekwenda Padan-Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akatambua jinsi ambavyo baba yake Isaki anavyowachukia binti za Wakanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Esau akaenda kwa Ishmaeli, akamwoa Mahalati, ndugu wa Nebayothi na binti wa Ishmaeli mwana wa Abrahamu, kuongezea wale wake wengine aliokuwa nao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndoto Ya Yakobo Huko Betheli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akatoka Beer-Sheba kwenda Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipofika mahali fulani, akalala hapo kwa sababu jua lilikuwa limetua. Akachukua jiwe moja la mahali pale, akaliweka chini ya kichwa chake akajinyoosha akalala usingizi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaota ndoto ambayo aliona ngazi imesimamishwa juu ya ardhi, ncha yake ikiwa imefika mbinguni na malaika wa Mungu wakawa wakipanda na kushuka juu yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu yake alisimama",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", akasema, \"Mimi ni",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.13",
                "verseOrgIds": [
                  "GEN.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba yako Abrahamu na Mungu wa Isaki. Nchi ambayo umelala juu yake, nitakupa wewe na uzao wako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzao wako utakuwa kama mavumbi ya nchi, nawe utaenea upande wa magharibi na mashariki, kaskazini na kusini. Kupitia wewe na uzao wako mataifa yote ya duniani yatabarikiwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.14",
            "verseOrgIds": [
              "GEN.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko pamoja nawe nami nitakulinda kila uendako na nitakurudisha katika nchi hii. Sitakuacha mpaka nitakapofanya hayo niliyokuahidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.15",
            "verseOrgIds": [
              "GEN.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo alipoamka kutoka usingizini, akawaza, \"Hakika",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.16",
                "verseOrgIds": [
                  "GEN.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "yuko mahali hapa, wala mimi sikujua.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo akaogopa, akasema, \"Mahali hapa panatisha kama nini! Bila shaka hapa ndipo nyumba ya Mungu ilipo, hili ni lango la mbinguni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.17",
            "verseOrgIds": [
              "GEN.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubuhi yake na mapema, Yakobo akalichukua lile jiwe aliloliweka chini ya kichwa chake, akalisimamisha kama nguzo na kumimina mafuta juu yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.18",
            "verseOrgIds": [
              "GEN.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahali pale akapaita Betheli,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        },
        {
          "text": "ingawa mji ule hapo kwanza uliitwa Luzu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yakobo akaweka nadhiri, akisema, \"Kama Mungu akiwa pamoja nami na kunilinda katika safari niendayo, akinipa chakula nile na nguo nivae",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.20",
            "verseOrgIds": [
              "GEN.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nirudi salama nyumbani kwa baba yangu, hapo ndipo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "GEN.28.21",
                "verseOrgIds": [
                  "GEN.28.21"
                ]
              }
            }
          ]
        },
        {
          "text": "atakuwa Mungu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalo jiwe hili nililolisimamisha kama nguzo litakuwa nyumba ya Mungu na katika yote utakayonipa nitakutolea wewe sehemu ya kumi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.22",
            "verseOrgIds": [
              "GEN.28.22"
            ]
          }
        }
      ]
    }
  ],
