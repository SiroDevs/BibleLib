              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini nitakapopumzika na baba zangu, unichukue kutoka Misri, ukanizike walipozikwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
