  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "GEN 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Ambariki Farao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu akaenda na kumwambia Farao, \"Baba yangu na ndugu zangu wamekuja kutoka nchi ya Kanaani wakiwa na makundi yao ya kondoo, mbuzi na ngʼombe, pamoja na kila kitu walicho nacho, nao sasa wapo huko Gosheni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachagua ndugu zake watano na kuwaonyesha kwa Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akawauliza hao ndugu zake, \"Kazi yenu ni nini?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 47:3"
      },
      "items": [
        {
          "text": "Wakamjibu, \"Watumishi wako ni wachunga mifugo, kama vile baba zetu walivyokuwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia wakamwambia Farao, \"Tumekuja kukaa huku kwa muda mfupi, kwa sababu njaa ni kali huko Kanaani, na mifugo ya watumishi wako haina malisho. Kwa hiyo sasa, tafadhali uruhusu watumishi wako wakae huko Gosheni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.4",
            "verseOrgIds": [
              "GEN.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akamwambia Yosefu, \"Baba yako na ndugu zako wamekuja kwako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.5",
            "verseOrgIds": [
              "GEN.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nayo nchi ya Misri ipo mbele yako, uwakalishe baba yako na ndugu zako katika sehemu iliyo bora kupita zote katika nchi. Na waishi Gosheni. Kama unamfahamu yeyote miongoni mwao mwenye uwezo maalum, waweke wawe wasimamizi wa mifugo yangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yosefu akamleta Yakobo baba yake na kumtambulisha mbele ya Farao. Baada ya Yakobo kumbariki Farao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.7",
            "verseOrgIds": [
              "GEN.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akamuuliza, \"Je una umri gani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.8",
            "verseOrgIds": [
              "GEN.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yakobo akamwambia Farao, \"Siku za miaka ya kusafiri kwangu ni miaka 130. Miaka yangu imekuwa michache na ya taabu, wala haikufikia miaka ya kusafiri ya baba zangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.9",
            "verseOrgIds": [
              "GEN.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yakobo akambariki Farao, naye akaondoka mbele ya uso wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.10",
            "verseOrgIds": [
              "GEN.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yosefu akawakalisha baba yake na ndugu zake katika nchi ya Misri na kuwapa milki katika sehemu bora sana ya nchi, wilaya ya Ramesesi, kama Farao alivyoelekeza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.11",
            "verseOrgIds": [
              "GEN.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia Yosefu akampa baba yake, na ndugu zake na wote wa nyumbani mwa baba yake vyakula, kwa kulingana na hesabu ya watoto wao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.12",
            "verseOrgIds": [
              "GEN.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uongozi Wa Yosefu Wakati Wa Njaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, hapakuwepo chakula katika sehemu yote kwa kuwa njaa ilikuwa kali sana; Misri na Kanaani zote zikaharibiwa kwa sababu ya njaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.13",
            "verseOrgIds": [
              "GEN.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu akakusanya fedha zote zilizopatikana kutoka mauzo ya nafaka huko Misri na Kanaani, akazileta kwenye jumba la kifalme la Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.14",
            "verseOrgIds": [
              "GEN.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedha za watu wa Misri na Kanaani zilipokwisha, Wamisri wote wakamjia Yosefu na kumwambia, \"Tupatie chakula. Kwa nini tufe mbele ya macho yako? Fedha zetu zimekwisha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.15",
            "verseOrgIds": [
              "GEN.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu akawaambia, \"Basi leteni mifugo yenu, nitawauzia chakula kwa kubadilisha na mifugo yenu, kwa kuwa fedha zenu zimekwisha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.16",
            "verseOrgIds": [
              "GEN.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakaleta mifugo yao kwa Yosefu, naye akawapa chakula kwa kubadilishana na farasi zao, kondoo na mbuzi zao, ngʼombe na punda zao. Katika mwaka huo wote Yosefu akawapa chakula kwa kubadilishana na mifugo yao yote.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.17",
            "verseOrgIds": [
              "GEN.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ule ulipokwisha, wakamjia mwaka uliofuata na kumwambia, \"Hatuwezi kuficha ukweli mbele za bwana wetu kwamba, kwa kuwa fedha zetu zimekwisha na wanyama wetu ni mali yako, sasa hakuna chochote kilichosalia kwa ajili ya bwana wetu isipokuwa miili yetu na ardhi yetu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.18",
            "verseOrgIds": [
              "GEN.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini tuangamie mbele ya macho yako, sisi pamoja na nchi yetu? Utununue sisi pamoja na ardhi yetu ili kubadilishana kwa chakula. Nasi pamoja na nchi yetu tutakuwa watumwa wa Farao. Tupe sisi mbegu ili tuweze kuishi wala tusife, nchi yetu isije ikawa ukiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.19",
            "verseOrgIds": [
              "GEN.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Yosefu akamnunulia Farao nchi yote ya Misri. Wamisri, mmoja baada ya mwingine, waliuza mashamba yao, kwa sababu njaa ilikuwa kali sana kwao. Nchi ikawa mali ya Farao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.20",
            "verseOrgIds": [
              "GEN.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Yosefu akawafanya watu watumike kama watumwa, kuanzia upande mmoja wa Misri hadi upande mwingine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.21",
            "verseOrgIds": [
              "GEN.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, hakununua nchi ya makuhani, kwa sababu walikuwa wanapata mgawo wao wa kawaida kutoka kwa Farao, nao walikuwa na chakula cha kuwatosha kutokana na mgawo waliopewa na Farao. Hii ndiyo sababu hawakuuza ardhi yao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.22",
            "verseOrgIds": [
              "GEN.47.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu akawaambia watu, \"Kwa vile nimewanunua ninyi pamoja na nchi yenu leo kuwa mali ya Farao, hapa kuna mbegu kwa ajili yenu ili mweze kuziotesha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.23",
            "verseOrgIds": [
              "GEN.47.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 47:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wakati mazao yatakapokuwa tayari, mpeni Farao sehemu ya tano. Sehemu hizo nne zitakazobaki mtaziweka kama mbegu kwa ajili ya mashamba na kwa ajili ya chakula chenu wenyewe na cha watu wa nyumbani mwenu na watoto wenu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.24",
            "verseOrgIds": [
              "GEN.47.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 47:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia, \"Umeokoa maisha yetu. Basi na tupate kibali mbele ya macho ya bwana wetu; tutakuwa watumwa wa Farao.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yosefu akaiweka iwe sheria kuhusu nchi ya Misri, ambayo inatumika mpaka leo, kwamba, sehemu ya tano ya mazao ni mali ya Farao. Ni nchi ya makuhani tu ambayo haikuwa ya Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Waisraeli wakaishi Misri katika nchi ya Gosheni. Wakapata mali huko wakastawi na kuongezeka kwa wingi sana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akaishi Misri miaka kumi na saba, nayo miaka ya maisha yake ilikuwa 147.",
          "type": "text",
