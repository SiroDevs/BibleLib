        "style": "s1"
      },
      "items": [
        {
          "text": "Kifo Cha Yakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
