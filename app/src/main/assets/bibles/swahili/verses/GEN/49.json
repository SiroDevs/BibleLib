          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo alipowapa maelekezo haya: \"Mimi niko karibu kukusanywa kwa watu wangu. Mnizike pamoja na baba zangu kwenye pango katika shamba la Efroni, Mhiti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "pango lililoko katika shamba la Makpela, karibu na Mamre huko Kanaani, ambalo Abrahamu alinunua kwa ajili ya mahali pa kuzikia kutoka kwa Efroni, Mhiti, pamoja na shamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko ndiko Abrahamu na Sara mkewe walikozikwa, huko akazikwa Isaki na Rebeka mkewe, na huko nilimzika Lea.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamba hilo na pango lililoko ndani yake lilinunuliwa kutoka kwa Wahiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        }
      ]
    },
