  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "GEN 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Abariki Wanawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yakobo akawaita wanawe na kusema: \"Kusanyikeni kunizunguka ili niweze kuwaambia lile litakalowatokea siku zijazo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kusanyikeni na msikilize, enyi wana wa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:2"
      },
      "items": [
        {
          "text": "msikilizeni baba yenu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Reubeni, wewe ni mzaliwa wangu wa kwanza,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "nguvu zangu, tunda la kwanza la nguvu zangu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "umepita kwa heshima, umepita kwa uwezo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiyezuiwa kama maji, basi hutakuwa mkuu tena,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "kwa kuwa ulipanda kwenye kitanda cha baba yako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "kwenye kitanda changu na kukinajisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simeoni na Lawi ni wana ndugu:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:5"
      },
      "items": [
        {
          "text": "panga zao ni silaha za jeuri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi na nisiingie katika baraza lao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "nami nisiunganike katika kusanyiko lao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "kwa kuwa wamewaua watu katika hasira yao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "walikata mishipa ya miguu ya mafahali",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "kama walivyopenda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasira yao na ilaaniwe, kwa kuwa ni kali mno,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "nayo ghadhabu yao ni ya ukatili!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "Nitawatawanya katika Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "Na kuwasambaza katika Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yuda, ndugu zako watakusifu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "mkono wako utakuwa shingoni mwa adui zako;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "wana wa baba yako watakusujudia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Yuda, wewe ni mwana simba;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "unarudi toka mawindoni, mwanangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "Kama simba hunyemelea na kulala chini,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "kama simba jike: nani athubutuye kumwamsha?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fimbo ya ufalme haitaondoka kwa Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "wala fimbo ya mtawala kati ya miguu yake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "hadi aje yeye ambaye milki ni yake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "ambaye utii wa mataifa ni wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamfunga punda wake katika mzabibu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "naye mwana-punda wake kwenye tawi lililo bora zaidi;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "atafua mavazi yake katika divai,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "majoho yake katika damu ya mizabibu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macho yake yatakuwa mekundu kwa divai,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:12"
      },
      "items": [
        {
          "text": "meno yake yatakuwa meupe kwa maziwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zabuloni ataishi pwani ya bahari",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:13"
      },
      "items": [
        {
          "text": "na kuwa bandari za kuegesha meli;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:13"
      },
      "items": [
        {
          "text": "mpaka wake utapanuka kuelekea Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
