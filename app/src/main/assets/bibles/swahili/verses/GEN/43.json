          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu hao walikuwa wameketi mbele yake kwa mfuatano wa umri wao, kuanzia mzaliwa wa kwanza hadi mzaliwa wa mwisho, wakatazamana wao kwa wao kwa mshangao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.33",
            "verseOrgIds": [
