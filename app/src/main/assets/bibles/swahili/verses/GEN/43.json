        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 43:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakampakulia Yosefu peke yake, ndugu zake peke yao na Wamisri waliokula pamoja naye peke yao, kwa sababu Wamisri wasingeweza kula pamoja na Waebrania, kwa maana ilikuwa ni chukizo kwa Wamisri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.32",
            "verseOrgIds": [
              "GEN.43.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
