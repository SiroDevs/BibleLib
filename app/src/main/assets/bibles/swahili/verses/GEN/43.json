              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kunawa uso wake, akatoka nje na huku akijizuia akasema, \"Pakueni chakula.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.31",
            "verseOrgIds": [
              "GEN.43.31"
            ]
          }
        }
      ]
    },
    {
