                "verseId": "HAB.3.8",
                "verseOrgIds": [
                  "HAB.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", uliikasirikia mito?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        }
      ]
