            "number": "1",
            "style": "v",
            "sid": "HAB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala ya nabii Habakuki iliyoimbwa kwa shigionothi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.1",
            "verseOrgIds": [
              "HAB.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.2",
                "verseOrgIds": [
                  "HAB.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nimezisikia sifa zako;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "nami naogopa kwa matendo yako, Ee",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAB.3.2",
                "verseOrgIds": [
                  "HAB.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "Fufua kazi yako katikati ya miaka,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "katikati ya miaka tangaza habari yako;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:2"
      },
      "items": [
        {
          "text": "katika ghadhabu kumbuka rehema.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.2",
            "verseOrgIds": [
              "HAB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu alitoka Temani,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "yeye Aliye Mtakatifu kutoka Mlima Parani.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "Utukufu wake ulifunika mbingu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:3"
      },
      "items": [
        {
          "text": "na sifa zake zikaifunika dunia.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.3",
            "verseOrgIds": [
              "HAB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mngʼao wake ulikuwa kama jua lichomozalo;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "mionzi ilimulika kutoka mkononi mwake,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:4"
      },
      "items": [
        {
          "text": "ambako nguvu zake zilifichwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.4",
            "verseOrgIds": [
              "HAB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauni ilimtangulia;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:5"
      },
      "items": [
        {
          "text": "maradhi ya kuambukiza yalifuata nyayo zake.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.5",
            "verseOrgIds": [
              "HAB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alisimama, akaitikisa dunia;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "alitazama, na kuyafanya mataifa yatetemeke.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Milima ya zamani iligeuka mavumbi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "na vilima vilivyozeeka vikaanguka.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:6"
      },
      "items": [
        {
          "text": "Njia zake ni za milele.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.6",
            "verseOrgIds": [
              "HAB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliona watu wa Kushani katika dhiki,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 3:7"
      },
      "items": [
        {
          "text": "na makazi ya Midiani katika maumivu makali.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.3.7",
            "verseOrgIds": [
              "HAB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
