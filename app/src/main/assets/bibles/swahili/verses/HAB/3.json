          "type": "text",
          "attrs": {
            "verseId": "HAB.3.8",
            "verseOrgIds": [
              "HAB.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
