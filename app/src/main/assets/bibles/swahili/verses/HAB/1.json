    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lalamiko La Habakuki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAB.1.2",
                "verseOrgIds": [
                  "HAB.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", hata lini nitakuomba msaada,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:2"
      },
      "items": [
        {
          "text": "lakini wewe husikilizi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:2"
      },
      "items": [
        {
          "text": "Au kukulilia, \"Udhalimu!\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:2"
      },
      "items": [
        {
          "text": "Lakini hutaki kuokoa?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini unanifanya nitazame dhuluma?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:3"
      },
      "items": [
        {
          "text": "Kwa nini unavumilia makosa?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:3"
      },
      "items": [
        {
          "text": "Uharibifu na udhalimu viko mbele yangu;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:3"
      },
      "items": [
        {
          "text": "kuna mabishano na mapambano kwa wingi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo sheria imepotoshwa,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:4"
      },
      "items": [
        {
          "text": "nayo haki haipo kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:4"
      },
      "items": [
        {
          "text": "Waovu wanawazunguka wenye haki,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:4"
      },
      "items": [
        {
          "text": "kwa hiyo haki imepotoshwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jibu La",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yatazame mataifa,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "uangalie na ushangae kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "Kwa sababu katika siku zako nitafanya kitu",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "ambacho hungeamini,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "hata kama ungeambiwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawainua Wakaldayo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:6"
      },
      "items": [
        {
          "text": "watu hao wakatili na wenye haraka,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:6"
      },
      "items": [
        {
          "text": "ambao hupita dunia yote",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:6"
      },
      "items": [
        {
          "text": "kuteka mahali pa kuishi pasipo pao wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni watu wanoogopwa na wanaotisha;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:7"
      },
      "items": [
        {
          "text": "wenyewe ndio sheria yao,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:7"
      },
      "items": [
        {
          "text": "na huinua heshima yao wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farasi wao ni wepesi kuliko chui,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "na wakali kuliko mbwa mwitu wakati wa machweo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "Askari wapanda farasi wao huenda mbio;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "waendesha farasi wao wanatoka mbali.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "Wanaruka kasi kama tai ili kurarua;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wote wanakuja tayari kwa fujo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:9"
      },
      "items": [
        {
          "text": "Makundi yao ya wajeuri yanasonga mbele",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:9"
      },
      "items": [
        {
          "text": "kama upepo wa jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:9"
      },
      "items": [
        {
          "text": "na kukusanya wafungwa",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:9"
      },
      "items": [
        {
          "text": "kama mchanga.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanawabeza wafalme,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:10"
      },
      "items": [
        {
          "text": "na kuwadhihaki watawala.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:10"
      },
      "items": [
        {
          "text": "Wanaicheka miji yote iliyozungushiwa maboma;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:10"
      },
      "items": [
        {
          "text": "wanafanya malundo ya udongo na kuiteka hiyo miji.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wanapita kasi kama upepo na kusonga mbele:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
