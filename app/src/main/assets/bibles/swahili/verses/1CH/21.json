                "verseOrgIds": [
                  "1CH.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "madhabahu kwenye sakafu ya kupuria nafaka ya Arauna Myebusi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Daudi akakwea, akalitii lile neno ambalo Gadi alikuwa amelisema katika jina la",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
