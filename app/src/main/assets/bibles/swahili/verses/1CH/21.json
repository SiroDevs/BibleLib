            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, Daudi alipoona kwamba",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.28",
                "verseOrgIds": [
                  "1CH.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "amemjibu kule kwenye uwanja wa kupuria nafaka wa Arauna Myebusi, akatoa dhabihu huko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maskani ya",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.29",
                "verseOrgIds": [
                  "1CH.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ambayo Mose aliitengeneza kule jangwani, pamoja na madhabahu ya sadaka ya kuteketezwa kwa wakati huo vilikuwa viko mahali pa juu pa kuabudia huko Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Daudi hakuthubutu kuisogelea ili kumuuliza Mungu, kwa sababu aliuogopa upanga wa yule malaika wa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        },
