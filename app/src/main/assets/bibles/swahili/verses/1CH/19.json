  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1CH 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vita Dhidi Ya Waamoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.10.1-2SA.10.19"
          },
          "items": [
            {
              "text": "2 Samweli 10:1-19",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya muda, Nahashi mfalme wa Waamoni akafa, mwanawe akaingia mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.1",
            "verseOrgIds": [
              "1CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akawaza, \"Nitamtendea wema Hanuni mwana wa Nahashi, kwa sababu baba yake alinitendea wema.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:2"
      },
      "items": [
        {
          "text": "Hivyo Daudi akatuma wajumbe ili kumfariji Hanuni kwa ajili ya kifo cha baba yake. Watu wa Daudi walipofika kwa Hanuni katika nchi ya Waamoni ili kumfariji,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakuu wa Waamoni wakamwambia Hanuni, \"Hivi unadhani Daudi anamheshimu baba yako kwa kuwatuma wajumbe kukufariji? Je, hawa watu hawakuja kuipeleleza na kuidadisi nchi ili waishinde?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.3",
            "verseOrgIds": [
              "1CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Hanuni akawakamata watu wa Daudi, akawanyoa ndevu akakata nguo zao katikati kwenye matako, akawaacha waende zao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.4",
            "verseOrgIds": [
              "1CH.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mmoja alipofika na kumpasha Daudi habari za watu hawa, akawatuma wajumbe wengine kuwalaki, kwa maana walikuwa wamevunjiwa heshima sana. Mfalme akasema, \"Kaeni huko Yeriko mpaka ndevu zenu ziote, ndipo mje.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamoni walipotambua kuwa wamekuwa machukizo kwa Daudi, Hanuni na Waamoni wakatuma talanta 1,000",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "text": "za fedha ili kukodisha magari ya vita pamoja na waendeshaji wa hayo magari ya kukokotwa na farasi, kutoka Aramu-Naharaimu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "text": "Aramu-Maaka na Soba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakodisha magari ya vita 32,000 yakiwa na waendeshaji wake, pamoja na mfalme wa Maaka na vikosi vyake, wakaja na kupiga kambi karibu na Medeba. Waamoni nao wakakusanyika toka miji yao, wakatoka ili kupigana vita.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aliposikia jambo hili, akamtuma Yoabu na jeshi lote la wapiganaji.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamoni wakatoka wakajipanga wakiwa tayari kwa vita langoni la mji wao, wakati wale wafalme wengine waliokuja nao walijipanga kwa vita uwanjani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu akaona kuwa mbele yake na nyuma yake kumepangwa vita; kwa hiyo akachagua baadhi ya vikosi vilivyo bora sana katika Israeli akavipanga dhidi ya Waaramu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaweka wale wanajeshi wengine waliobaki chini ya amri ya Abishai ndugu yake, nao wakapangwa ili wakabiliane na Waamoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu akasema, \"Kama Waaramu watanizidi nguvu, basi itakupasa wewe unisaidie; lakini kama Waamoni watakuzidi nguvu, basi mimi nitakusaidia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe hodari na tupigane kwa ujasiri kwa ajili ya watu wetu na miji ya Mungu wetu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1CH.19.13",
                "verseOrgIds": [
                  "1CH.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": "atafanya lile lililo jema machoni pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoabu na vikosi vyake wakasonga mbele kupigana na Waaramu, nao Waaramu wakakimbia mbele yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamoni walipoona Waaramu wanakimbia, nao pia wakakimbia mbele ya nduguye Abishai na kuingia ndani ya mji. Basi Yoabu akarudi Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Waaramu kuona kwamba wameshindwa na Israeli, wakapeleka wajumbe na kuwataka Waaramu wengine kutoka ngʼambo ya Mto Frati, wakiongozwa na Shofaki, jemadari wa jeshi la Hadadezeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.16",
            "verseOrgIds": [
              "1CH.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alipoambiwa haya, akawakusanya Israeli wote na kuvuka Yordani. Akasonga mbele dhidi yao na akajipanga kuwakabili. Daudi akapanga vita ili kupigana na Waaramu, nao wakapigana dhidi yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.17",
            "verseOrgIds": [
              "1CH.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Waaramu wakakimbia mbele ya Israeli, naye Daudi akawaua waendesha magari 7,000 na askari wao wa miguu 40,000. Pia akamuua Shofaki, jemadari wa jeshi lao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.18",
            "verseOrgIds": [
              "1CH.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raiya wa Hadadezeri walipoona kuwa wameshindwa na Israeli, wakafanya mapatano ya amani na Daudi, wakawa watumishi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:19"
      },
      "items": [
        {
          "text": "Hivyo Waaramu hawakukubali kuwasaidia Waamoni tena.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.20",
    "number": "20",
    "bookId": "1CH"
  },
