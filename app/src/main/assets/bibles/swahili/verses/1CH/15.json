          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebania, Yoshafati, Nethaneli, Amasai, Zekaria, Benaya na Eliezeri, makuhani, walikuwa wapiga tarumbeta mbele ya Sanduku la Mungu. Obed-Edomu na Yehiya waliwekwa pia kuwa mabawabu wa Sanduku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi pamoja na wazee wa Israeli na majemadari wa vikosi vya elfu wakaenda ili kulipandisha Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.25",
                "verseOrgIds": [
                  "1CH.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "kutoka nyumba ya Obed-Edomu kwa shangwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu Mungu alikuwa amewasaidia Walawi waliokuwa wanalichukua Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.26",
                "verseOrgIds": [
                  "1CH.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", mafahali saba na kondoo dume saba walitolewa dhabihu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi alikuwa amevaa joho la kitani safi, kama walivyokuwa wamevaa Walawi wote waliokuwa wanalichukua lile Sanduku, waimbaji nao walivaa vivyo hivyo, pamoja na Kenania aliyekuwa anaongoza nyimbo za waimbaji. Daudi alivaa pia kisibau cha kitani safi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Israeli wote wakalipandisha Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.28",
                "verseOrgIds": [
                  "1CH.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa shangwe, wakipiga pembe za kondoo dume, tarumbeta, matoazi, wakipiga zeze na vinubi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
      ]
    },
