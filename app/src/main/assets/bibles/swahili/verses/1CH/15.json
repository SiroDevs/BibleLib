          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berekia na Elikana walikuwa mabawabu kwa ajili ya Sanduku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
