              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Beria walikuwa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
