              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Miklothi ambaye alikuwa baba yake Shimea. Hawa pia waliishi karibu na jamaa zao huko Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
