          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri akamzaa Kishi, Kishi akamzaa Sauli, Sauli akamzaa Yonathani, Malki-Shua, Abinadabu na Esh-Baali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        }
