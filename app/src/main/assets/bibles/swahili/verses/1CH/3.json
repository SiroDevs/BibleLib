      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wana Wa Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio waliokuwa wana wa Daudi waliozaliwa huko Hebroni:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:1"
      },
      "items": [
        {
          "text": "Mzaliwa wa kwanza alikuwa Amnoni ambaye mama yake aliitwa Ahinoamu wa Yezreeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:1"
      },
      "items": [
        {
          "text": "wa pili, Danieli ambaye mama yake alikuwa Abigaili wa Karmeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa tatu alikuwa Absalomu, ambaye mama yake alikuwa Maaka, binti Talmai mfalme wa Geshuri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:2"
      },
      "items": [
        {
          "text": "wa nne, Adoniya, ambaye mama yake alikuwa Hagithi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa tano alikuwa Shefatia ambaye mama yake alikuwa Abitali;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:3"
      },
      "items": [
        {
          "text": "wa sita alikuwa Ithreamu, aliyezaliwa na mke wake Egla.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa sita walizaliwa huko Hebroni ambako Daudi alitawala kwa miaka saba na miezi sita.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CH 3:4"
      },
      "items": [
        {
          "text": "Daudi alitawala Yerusalemu kwa miaka thelathini na mitatu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao hawa ndio watoto wa Daudi waliozaliwa huko Yerusalemu:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:5"
      },
      "items": [
        {
          "text": "mkewe Bathsheba, binti Amieli, alimzalia Shamua,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "text": "Shobabu, Nathani na Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia kulikuwa na wana wengine: Ibihari, Elishua, Elifeleti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noga, Nefegi, Yafia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.7",
            "verseOrgIds": [
              "1CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama, Eliada na Elifeleti; wote walikuwa tisa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa wote walikuwa wana wa Daudi, mbali na wale wana waliozaliwa na masuria. Naye Tamari alikuwa dada yao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wafalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
