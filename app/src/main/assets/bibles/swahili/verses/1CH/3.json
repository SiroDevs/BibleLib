        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:15"
      },
      "items": [
        {
          "text": "Yehoyakimu mwanawe wa pili,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.15",
            "verseOrgIds": [
              "1CH.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:15"
      },
