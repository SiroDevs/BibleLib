          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Walawi wakafanya wajibu wao katika Hema la Kukutania, katika Mahali Patakatifu chini ya uongozi wa ndugu zao wazao wa Aroni, kwa ajili ya utumishi katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
