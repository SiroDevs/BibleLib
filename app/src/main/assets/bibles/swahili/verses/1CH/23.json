                "verseOrgIds": [
                  "1CH.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
