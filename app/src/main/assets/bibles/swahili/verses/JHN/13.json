  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JHN 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awanawisha Wanafunzi Wake Miguu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilikuwa mara tu kabla ya Sikukuu ya Pasaka. Yesu alijua ya kuwa wakati wake wa kuondoka ulimwenguni ili kurudi kwa Baba umewadia. Alikuwa amewapenda watu wake waliokuwa ulimwenguni, naam, aliwapenda hadi kipimo cha mwisho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.1",
            "verseOrgIds": [
              "JHN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati alipokuwa akila chakula cha jioni na wanafunzi wake, ibilisi alikuwa amekwisha kutia ndani ya moyo wa Yuda Iskariote, mwana wa Simoni, wazo la kumsaliti Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.2",
            "verseOrgIds": [
              "JHN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akijua ya kwamba Baba ameweka vitu vyote chini ya mamlaka yake na kwamba yeye alitoka kwa Mungu na alikuwa anarudi kwa Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.3",
            "verseOrgIds": [
              "JHN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hivyo aliondoka chakulani, akavua vazi lake la nje, akajifunga kitambaa kiunoni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.4",
            "verseOrgIds": [
              "JHN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akamimina maji kwenye sinia na kuanza kuwanawisha wanafunzi wake miguu na kuikausha kwa kile kitambaa alichokuwa amejifunga kiunoni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.5",
            "verseOrgIds": [
              "JHN.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipomfikia Simoni Petro, Petro akamwambia, \"Bwana, je, wewe utaninawisha mimi miguu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.6",
            "verseOrgIds": [
              "JHN.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.7",
            "verseOrgIds": [
              "JHN.13.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hivi sasa hutambui lile ninalofanya, lakini baadaye utaelewa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.7",
                "verseOrgIds": [
                  "JHN.13.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akamwambia, \"La, wewe hutaninawisha miguu kamwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:8"
      },
      "items": [
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama nisipokunawisha, wewe huna sehemu nami.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.8",
                "verseOrgIds": [
                  "JHN.13.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Simoni Petro akajibu, \"Usininawishe miguu peke yake, Bwana, bali pamoja na mikono na kichwa pia!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtu aliyekwisha kuoga anahitaji kunawa miguu tu, kwani mwili wake wote ni safi. Ninyi ni safi, ingawa si kila mmoja wenu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.10",
                "verseOrgIds": [
                  "JHN.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa yeye alijua ni nani ambaye angemsaliti, ndiyo sababu akasema si kila mmoja aliyekuwa safi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipomaliza kuwanawisha miguu yao, alivaa tena mavazi yake, akarudi alikokuwa ameketi, akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, mmeelewa nililowafanyia?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.12",
                "verseOrgIds": [
                  "JHN.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi mnaniita mimi 'Mwalimu' na 'Bwana,' hii ni sawa, maana ndivyo nilivyo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.13",
                "verseOrgIds": [
                  "JHN.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.13",
            "verseOrgIds": [
              "JHN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa hiyo, ikiwa mimi niliye Bwana wenu na Mwalimu wenu nimewanawisha ninyi miguu, pia hamna budi kunawishana miguu ninyi kwa ninyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.14",
                "verseOrgIds": [
                  "JHN.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.14",
            "verseOrgIds": [
              "JHN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mimi nimewawekea kielelezo kwamba imewapasa kutenda kama vile nilivyowatendea ninyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.15",
                "verseOrgIds": [
                  "JHN.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.15",
            "verseOrgIds": [
              "JHN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amin, amin nawaambia, mtumishi si mkuu kuliko bwana wake, wala aliyetumwa si mkuu kuliko yule aliyemtuma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.16",
                "verseOrgIds": [
                  "JHN.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.16",
            "verseOrgIds": [
              "JHN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sasa kwa kuwa mmejua mambo haya, heri yenu ninyi kama mkiyatenda.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.17",
                "verseOrgIds": [
                  "JHN.13.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sisemi hivi kuhusu ninyi nyote. Ninawajua wale niliowachagua. Lakini ni ili Andiko lipate kutimia, kwamba, 'Yeye aliyekula chakula changu, ameinua kisigino chake dhidi yangu.'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.18",
                "verseOrgIds": [
                  "JHN.13.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ninawaambia mambo haya kabla hayajatukia, ili yatakapotukia mpate kuamini ya kuwa Mimi ndiye.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.19",
                "verseOrgIds": [
                  "JHN.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.19",
            "verseOrgIds": [
              "JHN.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amin, amin nawaambia, yeyote anayempokea yule niliyemtuma anipokea mimi, naye anipokeaye mimi ampokea yeye aliyenituma mimi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.20",
                "verseOrgIds": [
                  "JHN.13.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Anatabiri Kusalitiwa Kwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.26.20-MAT.26.25"
          },
          "items": [
            {
              "text": "Mathayo 26:20-25",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.14.17-MRK.14.21"
          },
          "items": [
            {
              "text": "Marko 14:17-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.22.21-LUK.22.23"
          },
          "items": [
            {
              "text": "Luka 22:21-23",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kusema haya, Yesu alifadhaika sana moyoni, akasema,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
            "verseOrgIds": [
              "JHN.13.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amin, amin nawaambia, mmoja wenu atanisaliti.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.21",
                "verseOrgIds": [
                  "JHN.13.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanafunzi wake wakatazamana bila kujua kuwa alikuwa anamsema nani.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.22",
            "verseOrgIds": [
              "JHN.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa wanafunzi wake ambaye Yesu alimpenda sana, alikuwa ameegama kifuani mwa Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.23",
            "verseOrgIds": [
              "JHN.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro akampungia mkono yule mwanafunzi, akamwambia, \"Muulize anamaanisha nani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.24",
            "verseOrgIds": [
              "JHN.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanafunzi akamwegemea Yesu, akamuuliza, \"Bwana, tuambie, ni nani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.25",
            "verseOrgIds": [
              "JHN.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ni yule nitakayempa hiki kipande cha mkate baada ya kukichovya kwenye bakuli.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.26",
                "verseOrgIds": [
                  "JHN.13.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Hivyo baada ya kukichovya kile kipande cha mkate, akampa Yuda Iskariote, mwana wa Simoni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara tu baada ya kukipokea kile kipande cha mkate, Shetani akamwingia.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:27"
      },
      "items": [
        {
          "text": "Yesu akamwambia Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lile unalotaka kulitenda litende haraka.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.27",
                "verseOrgIds": [
                  "JHN.13.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna hata mmoja wa wale waliokuwa wameketi naye mezani aliyeelewa kwa nini Yesu alimwambia hivyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.28",
            "verseOrgIds": [
              "JHN.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa Yuda alikuwa mtunza fedha, wengine walifikiri Yesu alikuwa amemwambia akanunue vitu vilivyohitajika kwa ajili ya Sikukuu, au kuwapa maskini chochote.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara tu baada ya kupokea ule mkate, Yuda akatoka nje. Wakati huo ulikuwa ni usiku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atabiri Petro Kumkana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.26.31-MAT.26.35"
          },
          "items": [
            {
              "text": "Mathayo 26:31-35",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.14.27-MRK.14.31"
          },
          "items": [
            {
              "text": "Marko 14:27-31",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.22.31-LUK.22.34"
          },
          "items": [
            {
              "text": "Luka 22:31-34",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Yuda kutoka nje, Yesu akasema,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.31",
            "verseOrgIds": [
              "JHN.13.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sasa Mwana wa Adamu ametukuzwa, naye Mungu ametukuzwa ndani yake.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.31",
                "verseOrgIds": [
                  "JHN.13.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.31",
            "verseOrgIds": [
              "JHN.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ikiwa Mungu ametukuzwa ndani ya Mwana, Mungu atamtukuza Mwana ndani yake mwenyewe naye atamtukuza mara.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.32",
                "verseOrgIds": [
                  "JHN.13.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Watoto wangu, mimi bado niko pamoja nanyi kwa kitambo kidogo. Mtanitafuta, na kama vile nilivyowaambia Wayahudi, vivyo hivyo sasa nawaambia na ninyi. Niendako, ninyi hamwezi kuja.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.33",
                "verseOrgIds": [
                  "JHN.13.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amri mpya nawapa: Mpendane kama mimi nilivyowapenda ninyi, vivyo hivyo nanyi mpendane.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.34",
                "verseOrgIds": [
                  "JHN.13.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama mkipendana ninyi kwa ninyi, kwa njia hii, watu wote watajua kuwa ninyi ni wanafunzi wangu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.35",
                "verseOrgIds": [
                  "JHN.13.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro akamuuliza, \"Bwana, unakwenda wapi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:36"
      },
      "items": [
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ninakokwenda huwezi kunifuata sasa, lakini utanifuata baadaye.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.36",
                "verseOrgIds": [
                  "JHN.13.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akamuuliza tena, \"Bwana, kwa nini siwezi kukufuata sasa? Mimi niko tayari kuutoa uhai wangu kwa ajili yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.38",
            "verseOrgIds": [
              "JHN.13.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, ni kweli uko tayari kuutoa uhai wako kwa ajili yangu? Amin, amin nakuambia, kabla jogoo hajawika, utanikana mara tatu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.13.38",
                "verseOrgIds": [
                  "JHN.13.38"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
