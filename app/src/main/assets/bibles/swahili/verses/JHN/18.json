              "text": "Luka 23:1-5",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Wayahudi wakamchukua Yesu kutoka kwa Kayafa na kumpeleka kwenye jumba la kifalme la mtawala wa Kirumi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.28",
            "verseOrgIds": [
              "JHN.18.28"
            ]
          }
        },
        {
          "text": "Wakati huo ilikuwa ni alfajiri, ili kuepuka kuwa najisi kwa taratibu za ibada, Wayahudi hawakuingia ndani kwa sababu ya sheria za Kiyahudi. Wangehesabiwa kuwa najisi kama wangeingia nyumbani mwa mtu asiye Myahudi na wasingeruhusiwa kushiriki katika Sikukuu ya Pasaka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.28",
            "verseOrgIds": [
              "JHN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Pilato akatoka nje walikokuwa akawauliza, \"Mmeleta mashtaka gani kumhusu mtu huyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.29",
            "verseOrgIds": [
              "JHN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao wakamjibu, \"Kama huyu mtu hakuwa mhalifu tusingemleta kwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.30",
            "verseOrgIds": [
              "JHN.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akawaambia, \"Basi mchukueni ninyi mkamhukumu kwa kufuata sheria zenu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:31"
      },
      "items": [
        {
          "text": "Wayahudi wakamjibu, \"Sisi haturuhusiwi kutoa hukumu ya kifo kwa mtu yeyote.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walisema hivyo ili yale maneno aliyosema Yesu kuhusu kifo atakachokufa yapate kutimia.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Pilato akaingia ndani ya jumba la kifalme, akamwita Yesu, akamuuliza, \"Wewe ndiye mfalme wa Wayahudi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.33",
            "verseOrgIds": [
              "JHN.18.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.34",
            "verseOrgIds": [
              "JHN.18.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, unauliza swali hili kutokana na mawazo yako mwenyewe, au uliambiwa na watu kunihusu mimi?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.34",
                "verseOrgIds": [
                  "JHN.18.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akamjibu, \"Mimi si Myahudi, ama sivyo? Taifa lako mwenyewe na viongozi wa makuhani wamekukabidhi kwangu. Umefanya kosa gani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.35",
            "verseOrgIds": [
              "JHN.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.36",
            "verseOrgIds": [
              "JHN.18.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ufalme wangu si wa ulimwengu huu. Ufalme wangu ungekuwa wa ulimwengu huu, wafuasi wangu wangenipigania ili nisitiwe mikononi mwa Wayahudi. Lakini kama ilivyo, ufalme wangu hautoki hapa ulimwenguni.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.36",
                "verseOrgIds": [
                  "JHN.18.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akamuuliza, \"Kwa hiyo wewe ni mfalme?\" Yesu akajibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wewe wasema kwamba mimi ni mfalme. Kwa kusudi hili nilizaliwa, na kwa ajili ya hili nilikuja ulimwenguni, ili niishuhudie kweli. Mtu yeyote aliye wa kweli husikia sauti yangu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.37",
                "verseOrgIds": [
                  "JHN.18.37"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akamuuliza Yesu, \"Kweli ni nini?\" Baada ya kusema haya Pilato akaenda nje tena akawaambia wale viongozi wa Wayahudi waliomshtaki Yesu, \"Sioni kosa lolote alilotenda mtu huyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ninyi mna desturi yenu kwamba wakati wa Pasaka nimwachie huru mfungwa mmoja mnayemtaka. Je, mnataka niwafungulie huyu 'Mfalme wa Wayahudi'?\"",
          "type": "text",
