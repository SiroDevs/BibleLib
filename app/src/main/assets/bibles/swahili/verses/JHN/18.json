        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo Simoni Petro alikuwa amesimama akiota moto. Baadhi ya wale waliokuwepo wakamuuliza, \"Je, wewe si mmoja wa wanafunzi wake?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:25"
      },
      "items": [
        {
          "text": "Petro akakana, akasema, \"Sio mimi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa watumishi wa kuhani mkuu, ndugu yake yule mtu ambaye Petro alikuwa amemkata sikio, akamuuliza, \"Je, mimi sikukuona kule bustanini ukiwa na Yesu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.26",
            "verseOrgIds": [
              "JHN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa mara nyingine tena Petro akakana, naye jogoo akawika wakati huo huo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Apelekwa Kwa Pilato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.27.1-MAT.27.2"
          },
          "items": [
            {
              "text": "Mathayo 27:1-2",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.27.11-MAT.27.14"
          },
