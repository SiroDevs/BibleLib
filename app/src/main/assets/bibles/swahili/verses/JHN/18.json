    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alipomaliza kuomba, akaondoka na wanafunzi wake wakavuka Bonde la Kidroni. Upande wa pili palikuwa na bustani, yeye na wanafunzi wake wakaingia humo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.1",
            "verseOrgIds": [
              "JHN.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yuda, yule aliyemsaliti alipafahamu mahali hapo kwani Yesu alikuwa akikutana humo na wanafunzi wake mara kwa mara.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.2",
            "verseOrgIds": [
              "JHN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yuda akaja bustanini. Aliongoza kikosi cha askari wa Kirumi, na baadhi ya maafisa kutoka kwa viongozi wa makuhani na Mafarisayo. Nao walikuwa wamechukua taa, mienge na silaha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.3",
            "verseOrgIds": [
              "JHN.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akijua yale yote yatakayompata, akajitokeza mbele yao akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.4",
            "verseOrgIds": [
              "JHN.18.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mnamtafuta nani?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.4",
                "verseOrgIds": [
                  "JHN.18.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao wakamjibu, \"Yesu wa Nazareti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:5"
      },
      "items": [
        {
          "text": "Yesu akawajibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi ndiye.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.5",
                "verseOrgIds": [
                  "JHN.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Yuda, yule aliyemsaliti alikuwa amesimama pamoja nao.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alipowaambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi ndiye,\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.6",
                "verseOrgIds": [
                  "JHN.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "walirudi nyuma na kuanguka chini!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawauliza tena,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mnamtafuta nani?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.7",
                "verseOrgIds": [
                  "JHN.18.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:7"
      },
      "items": [
        {
          "text": "Nao wakamjibu, \"Yesu wa Nazareti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.8",
            "verseOrgIds": [
              "JHN.18.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nimekwisha kuwaambia kuwa, mimi ndiye; kwa hiyo kama mnanitafuta mimi, waacheni hawa watu waende zao.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.8",
                "verseOrgIds": [
                  "JHN.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.8",
            "verseOrgIds": [
              "JHN.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hii ilikuwa ili litimie lile neno alilosema,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.9",
            "verseOrgIds": [
              "JHN.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sikumpoteza hata mmoja miongoni mwa wale ulionipa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.9",
                "verseOrgIds": [
                  "JHN.18.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro, aliyekuwa na upanga, akaufuta na kumkata sikio la kuume mtumishi wa kuhani mkuu. Jina la mtumishi huyo aliitwa Malko.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.10",
            "verseOrgIds": [
              "JHN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamwambia Petro,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Rudisha upanga wako kwenye ala yake. Je, hainipasi kukinywea kikombe alichonipa Baba?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.11",
                "verseOrgIds": [
                  "JHN.18.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Mbele Ya Kuhani Mkuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo wale askari, wakiwa pamoja na majemadari wao na maafisa wa Wayahudi, wakamkamata Yesu na kumfunga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.12",
            "verseOrgIds": [
              "JHN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwanza wakampeleka kwa Anasi, mkwewe Kayafa, aliyekuwa kuhani mkuu mwaka ule.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.13",
            "verseOrgIds": [
              "JHN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayafa ndiye alikuwa amewashauri Wayahudi kwamba imempasa mtu mmoja kufa kwa ajili ya watu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Anamkana Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.26.69-MAT.26.70"
          },
          "items": [
            {
              "text": "Mathayo 26:69-70",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.14.55-MRK.14.64"
          },
          "items": [
            {
              "text": "Marko 14:55-64",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.22.66-LUK.22.71"
          },
          "items": [
            {
              "text": "Luka 22:66-71",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro pamoja na mwanafunzi mwingine walikuwa wakimfuata Yesu. Huyu mwanafunzi mwingine alikuwa anafahamika kwa kuhani mkuu, hivyo aliingia ndani ya ukumbi pamoja na Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.15",
            "verseOrgIds": [
              "JHN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Petro alisimama nje karibu na lango, ndipo yule mwanafunzi mwingine, aliyejulikana na kuhani mkuu, akazungumza na msichana aliyekuwa analinda lango, akamruhusu Petro aingie ndani.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.16",
            "verseOrgIds": [
              "JHN.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule msichana akamuuliza Petro, \"Je, wewe pia si mmoja wa wanafunzi wa mtu huyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:17"
      },
      "items": [
        {
          "text": "Petro akajibu, \"Sio mimi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale watumishi na askari walikuwa wamesimama wakiota moto wa makaa kwa sababu palikuwa na baridi, Petro naye alikuwa amesimama pamoja nao akiota moto.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuhani Mkuu Amhoji Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo kuhani mkuu akawa anamuuliza Yesu kuhusu wanafunzi wake na mafundisho yake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.19",
            "verseOrgIds": [
              "JHN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nimekuwa nikizungumza waziwazi mbele ya watu wote. Siku zote nimefundisha katika masinagogi na Hekaluni, mahali ambapo Wayahudi wote hukusanyika. Sikusema jambo lolote kwa siri.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.20",
                "verseOrgIds": [
                  "JHN.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbona unaniuliza mimi maswali? Waulize wale walionisikia yale niliyowaambia. Wao wanajua niliyosema.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.21",
                "verseOrgIds": [
                  "JHN.18.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipomaliza kusema hayo, mmoja wa askari aliyekuwa amesimama karibu naye, akampiga Yesu kofi usoni, kisha akasema, \"Je, hivyo ndivyo unavyomjibu kuhani mkuu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.22",
            "verseOrgIds": [
              "JHN.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu akasema,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama nimesema jambo baya, shuhudia huo ubaya niliousema. Lakini kama nimesema yaliyo kweli, mbona umenipiga?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.23",
                "verseOrgIds": [
                  "JHN.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Anasi akampeleka Yesu kwa kuhani mkuu Kayafa, akiwa bado amefungwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Amkana Yesu Tena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
