  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JHN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Mzabibu Wa Kweli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi ndimi mzabibu wa kweli na Baba yangu ndiye mkulima.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.1",
                "verseOrgIds": [
                  "JHN.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.1",
            "verseOrgIds": [
              "JHN.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kila tawi ndani yangu lisilozaa matunda, Baba yangu hulikata, nalo kila tawi lizaalo, hulisafisha ili lipate kuzaa matunda zaidi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.2",
                "verseOrgIds": [
                  "JHN.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.2",
            "verseOrgIds": [
              "JHN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi mmekwisha kuwa safi kwa sababu ya lile neno nililonena nanyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.3",
                "verseOrgIds": [
                  "JHN.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.3",
            "verseOrgIds": [
              "JHN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kaeni ndani yangu, nami nikae ndani yenu. Kama vile tawi lisivyoweza kuzaa matunda lisipokaa ndani ya mzabibu, vivyo hivyo ninyi msipokaa ndani yangu hamwezi kuzaa matunda.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.4",
                "verseOrgIds": [
                  "JHN.15.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi ni mzabibu, ninyi ni matawi. Akaaye ndani yangu, nami ndani yake, huyo huzaa sana, maana pasipo mimi ninyi hamwezi kufanya jambo lolote.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.5",
                "verseOrgIds": [
                  "JHN.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.5",
            "verseOrgIds": [
              "JHN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mtu yeyote asipokaa ndani yangu, hutupwa nje kama tawi na kunyauka. Matawi kama hayo hukusanywa na kutupwa motoni, yakateketea.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.6",
                "verseOrgIds": [
                  "JHN.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.6",
            "verseOrgIds": [
              "JHN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi mkikaa ndani yangu na maneno yangu yakikaa ndani yenu, ombeni lolote mtakalo, nanyi mtatendewa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.7",
                "verseOrgIds": [
                  "JHN.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.7",
            "verseOrgIds": [
              "JHN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa hiyo Baba yangu hutukuzwa, kwa vile mzaavyo matunda mengi, nanyi mtakuwa wanafunzi wangu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.8",
                "verseOrgIds": [
                  "JHN.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama vile Baba alivyonipenda mimi, hivyo ndivyo mimi nilivyowapenda ninyi. Basi kaeni katika pendo langu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.9",
                "verseOrgIds": [
                  "JHN.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mkizishika amri zangu mtakaa katika pendo langu, kama mimi nilivyozishika amri za Baba yangu na kukaa katika pendo lake.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.10",
                "verseOrgIds": [
                  "JHN.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.10",
            "verseOrgIds": [
              "JHN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimewaambia mambo haya ili furaha yangu iwe ndani yenu na furaha yenu iwe kamili.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.11",
                "verseOrgIds": [
                  "JHN.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amri yangu ndiyo hii: Mpendane kama mimi nilivyowapenda ninyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.12",
                "verseOrgIds": [
                  "JHN.15.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hakuna mtu mwenye upendo mkuu kuliko huu, mtu kuutoa uhai wake kwa ajili ya rafiki zake.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.13",
                "verseOrgIds": [
                  "JHN.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi ni rafiki zangu mkifanya ninayowaamuru.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.14",
                "verseOrgIds": [
                  "JHN.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Siwaiti ninyi watumishi tena, kwa sababu watumishi hawajui bwana wao analofanya, bali nimewaita ninyi rafiki, kwa maana nimewajulisha mambo yote niliyoyasikia kutoka kwa Baba yangu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.15",
                "verseOrgIds": [
                  "JHN.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Si ninyi mlionichagua, bali mimi ndiye niliyewachagua ninyi na kuwaweka mwende mkazae matunda, na matunda yenu yapate kudumu. Ili nalo lolote mtakalomwomba Baba katika Jina langu, awape ninyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.16",
                "verseOrgIds": [
                  "JHN.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amri yangu ndiyo hii: Mpendane.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.17",
                "verseOrgIds": [
                  "JHN.15.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulimwengu Wawachukia Wanafunzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama ulimwengu ukiwachukia ninyi, kumbukeni kwamba ulinichukia mimi kabla yenu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.18",
                "verseOrgIds": [
                  "JHN.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama mngekuwa wa ulimwengu, ulimwengu ungeliwapenda kama vile unavyowapenda walio wake. Kwa sababu ninyi si wa ulimwengu, lakini mimi nimewachagua kutoka ulimwengu, hii ndiyo sababu ulimwengu unawachukia.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.19",
                "verseOrgIds": [
                  "JHN.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kumbukeni lile neno nililowaambia, 'Hakuna mtumishi aliye mkuu kuliko bwana wake.' Kama wamenitesa mimi, nanyi pia watawatesa. Kama wamelishika neno langu, watalishika na neno lenu pia.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.20",
                "verseOrgIds": [
                  "JHN.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Watawatendea ninyi haya yote kwa ajili ya Jina langu, kwa sababu hawamjui yeye aliyenituma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.21",
                "verseOrgIds": [
                  "JHN.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
              "JHN.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
