              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo baba wa huyo mtoto akakumbuka kuwa huo ndio wakati ambapo Yesu alikuwa amemwambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
