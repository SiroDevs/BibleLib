{
  "id": "JHN.4",
  "number": "4",
  "bookId": "JHN",
  "reference": "Yohana 4",
  "copyright": "Biblica® Toleo Wazi la Neno: Biblia Takatifu™ Hakimiliki © 1984, 1989, 2009, 2015 na Biblica, Inc. Biblica® Open Kiswahili Contemporary Version™ Copyright © 1984, 1989, 2009, 2015 by Biblica, Inc. \"Biblica\" ni alama ya biashara iliyosajiliwa katika Ofisi ya Hataza na Alama za Biashara Marekani (United States Patent and Trademark Office) na shirika la Biblica, Inc. Imetumiwa na ruhusa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JHN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Azungumza Na Mwanamke Msamaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafarisayo wakasikia kwamba Yesu alikuwa anapata na kubatiza wanafunzi wengi zaidi kuliko Yohana,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.1",
            "verseOrgIds": [
              "JHN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingawa kwa kweli si Yesu mwenyewe aliyekuwa akibatiza, ila ni wanafunzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.2",
            "verseOrgIds": [
              "JHN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana alipojua mambo haya, aliondoka Uyahudi akarudi tena Galilaya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.3",
            "verseOrgIds": [
              "JHN.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo ilimlazimu apitie Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.4",
            "verseOrgIds": [
              "JHN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafika kwenye mji mmoja wa Samaria uitwao Sikari, karibu na lile shamba ambalo Yakobo alimpa mwanawe Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.5",
            "verseOrgIds": [
              "JHN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko ndiko kulikokuwa na kile kisima cha Yakobo. Naye Yesu alikuwa amechoka kwa kuwa alikuwa ametoka safarini. Akaketi karibu na hicho kisima. Ilikuwa yapata saa sita mchana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanamke mmoja Msamaria akaja kuteka maji, Yesu akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naomba maji ninywe.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.7",
                "verseOrgIds": [
                  "JHN.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Wakati huo wanafunzi wake walikuwa wamekwenda mjini kununua chakula.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.8",
            "verseOrgIds": [
              "JHN.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke Msamaria akamjibu, \"Wewe ni Myahudi na mimi ni Msamaria. Yawezekanaje uniombe nikupe maji ya kunywa?\" (Wayahudi walikuwa hawashirikiani kabisa na Wasamaria.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.9",
            "verseOrgIds": [
              "JHN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.10",
            "verseOrgIds": [
              "JHN.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama ungelijua karama ya Mungu, naye ni nani anayekuambia, Nipe maji ninywe, wewe ungelimwomba yeye, naye angelikupa maji yaliyo hai.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.10",
                "verseOrgIds": [
                  "JHN.4.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akamjibu, \"Bwana, wewe huna chombo cha kutekea maji na kisima hiki ni kirefu. Hayo maji ya uzima utayapata wapi?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.11",
            "verseOrgIds": [
              "JHN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwani wewe ni mkuu kuliko baba yetu Yakobo ambaye alitupatia kisima hiki, ambacho yeye pamoja na watoto wake na mifugo yake walikitumia?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.12",
            "verseOrgIds": [
              "JHN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kila mtu anayekunywa maji ya kisima hiki ataona kiu tena.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.13",
                "verseOrgIds": [
                  "JHN.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini yeyote anywaye maji nitakayompa hataona kiu kamwe. Maji nitakayompa yatakuwa ndani yake chemchemi ya maji, yakibubujika uzima wa milele.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.14",
                "verseOrgIds": [
                  "JHN.4.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akamwambia, \"Bwana, tafadhali nipe maji hayo ili nisipate kiu tena na wala nisije tena hapa kuteka maji!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.16",
            "verseOrgIds": [
              "JHN.4.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nenda ukamwite mumeo, uje naye hapa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.16",
                "verseOrgIds": [
                  "JHN.4.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akajibu, \"Sina mume.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 4:17"
      },
      "items": [
        {
          "text": "Yesu akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Umesema kweli kuwa huna mume.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.17",
                "verseOrgIds": [
                  "JHN.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana umeshakuwa na wanaume watano na mwanaume unayeishi naye sasa si mume wako! Umesema ukweli.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.18",
                "verseOrgIds": [
                  "JHN.4.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akasema, \"Bwana, naona bila shaka wewe ni nabii.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.19",
            "verseOrgIds": [
              "JHN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba zetu waliabudu kwenye mlima huu, lakini ninyi Wayahudi mnasema ni lazima tukaabudu huko Yerusalemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.20",
            "verseOrgIds": [
              "JHN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwanamke, niamini, wakati unakuja ambapo hamtamwabudu Baba katika mlima huu, wala huko Yerusalemu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.21",
                "verseOrgIds": [
                  "JHN.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi Wasamaria mnaabudu msichokijua. Sisi Wayahudi tunamwabudu Mungu tunayemjua kwa sababu wokovu unatoka kwa Wayahudi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.22",
                "verseOrgIds": [
                  "JHN.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.22",
            "verseOrgIds": [
              "JHN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini saa yaja, tena ipo, ambapo wale waabuduo halisi, watamwabudu Baba katika roho na kweli. Watu wanaoabudu namna hii, ndio Baba anawatafuta.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.23",
                "verseOrgIds": [
                  "JHN.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.23",
            "verseOrgIds": [
              "JHN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mungu ni Roho na wote wanaomwabudu imewapasa kumwabudu katika roho na kweli.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.24",
                "verseOrgIds": [
                  "JHN.4.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akamwambia, \"Ninafahamu kwamba Masiya (aitwaye Kristo) anakuja. Yeye akija, atatueleza mambo yote.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.25",
            "verseOrgIds": [
              "JHN.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi ninayezungumza nawe, ndiye.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.26",
                "verseOrgIds": [
                  "JHN.4.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo wanafunzi wake wakarudi, wakashangaa sana kumwona akizungumza na mwanamke. Lakini hakuna aliyemuuliza, \"Unataka nini kwake?\" Au \"Kwa nini unazungumza naye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.27",
            "verseOrgIds": [
              "JHN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akaacha mtungi wake, akarudi mjini akawaambia watu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.28",
            "verseOrgIds": [
              "JHN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Njooni mkamwone mtu aliyeniambia kila kitu nilichotenda! Je, yawezekana huyu ndiye Kristo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.29",
            "verseOrgIds": [
              "JHN.4.29"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.29",
            "verseOrgIds": [
              "JHN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakamiminika watu kutoka mjini wakamwendea Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo wanafunzi wake walikuwa wakimsihi, \"Rabi, kula angalau chochote.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.31",
            "verseOrgIds": [
              "JHN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini yeye akawajibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.32",
            "verseOrgIds": [
              "JHN.4.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi ninacho chakula ambacho ninyi hamkifahamu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.32",
                "verseOrgIds": [
                  "JHN.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wanafunzi wakaanza kuulizana, \"Kuna mtu ambaye amemletea chakula?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.33",
            "verseOrgIds": [
              "JHN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Yesu akawajibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chakula changu ni kufanya mapenzi ya Mungu ambaye amenituma na kuikamilisha kazi yake.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.34",
                "verseOrgIds": [
                  "JHN.4.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Je, ninyi hamsemi, 'Bado miezi minne tuvune?' Inueni macho yenu myaangalie mashamba jinsi mazao yalivyo tayari kuvunwa!",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.35",
                "verseOrgIds": [
                  "JHN.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.35",
            "verseOrgIds": [
              "JHN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mvunaji tayari anapokea mshahara wake, naye anakusanya mazao kwa ajili ya uzima wa milele. Ili yeye apandaye na yeye avunaye wafurahi pamoja.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.36",
                "verseOrgIds": [
                  "JHN.4.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.36",
            "verseOrgIds": [
              "JHN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hivyo kule kusema, 'Mmoja hupanda na mwingine huvuna,' ni kweli kabisa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.37",
                "verseOrgIds": [
                  "JHN.4.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.37",
            "verseOrgIds": [
              "JHN.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Niliwatuma mkavune mazao ambayo hamkupanda, wengine walifanya kazi ngumu, nanyi mmevuna faida ya taabu yao.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.38",
                "verseOrgIds": [
                  "JHN.4.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wasamaria Wengi Waamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasamaria wengi katika mji ule wakamwamini Yesu kwa sababu ya ushuhuda wa yule mwanamke alipowaambia kwamba, \"Ameniambia kila kitu nilichotenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.39",
            "verseOrgIds": [
              "JHN.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo wale Wasamaria walipomjia, wakamsihi akae kwao. Naye akakaa huko siku mbili.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.40",
            "verseOrgIds": [
              "JHN.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu ya neno lake, watu wengi wakaamini.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.41",
            "verseOrgIds": [
              "JHN.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia yule mwanamke, \"Sasa tunaamini, wala si kwa sababu ya maneno yako tu, bali kwa kuwa tumemsikia sisi wenyewe. Tumejua hakika kweli ya kwamba huyu ndiye Kristo, Mwokozi wa ulimwengu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amponya Mwana Wa Afisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya zile siku mbili, Yesu aliondoka kwenda Galilaya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.43",
            "verseOrgIds": [
              "JHN.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Basi Yesu mwenyewe alikuwa amesema kwamba nabii hapati heshima katika nchi yake mwenyewe.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.44",
            "verseOrgIds": [
              "JHN.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipofika Galilaya, Wagalilaya walimkaribisha, kwani walikuwa wameona yale aliyoyatenda huko Yerusalemu wakati wa Sikukuu ya Pasaka. Kwa maana wao pia walikuwa wamehudhuria hiyo Sikukuu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.45",
            "verseOrgIds": [
              "JHN.4.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yesu akaja tena mpaka Kana ya Galilaya, kule alikokuwa amebadili maji kuwa divai. Huko kulikuwepo na afisa mmoja wa mfalme, ambaye mwanawe alikuwa mgonjwa huko Kapernaumu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.46",
            "verseOrgIds": [
              "JHN.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo mtu aliposikia kwamba Yesu alikuwa amewasili Galilaya kutoka Uyahudi, alimwendea na kumwomba ili aje kumponya mwanawe, aliyekuwa mgonjwa karibu ya kufa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.47",
            "verseOrgIds": [
              "JHN.4.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.48",
            "verseOrgIds": [
              "JHN.4.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ninyi watu msipoona ishara na miujiza kamwe hamtaamini.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.48",
                "verseOrgIds": [
                  "JHN.4.48"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule afisa wa mfalme akamwambia, \"Bwana, tafadhali shuka kabla mwanangu hajafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.49",
            "verseOrgIds": [
              "JHN.4.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 4:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.50",
            "verseOrgIds": [
              "JHN.4.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Enenda zako, mwanao yu hai.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.50",
                "verseOrgIds": [
                  "JHN.4.50"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 4:50"
      },
      "items": [
        {
          "text": "Yule afisa akaamini yale maneno Yesu aliyomwambia, akaondoka akaenda zake.",
          "type": "text",
          "attrs": {
