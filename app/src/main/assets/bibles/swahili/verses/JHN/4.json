              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokuwa bado yuko njiani, akakutana na watumishi wake wakamwambia kwamba mwanawe yu mzima.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.51",
            "verseOrgIds": [
              "JHN.4.51"
            ]
          }
        },
        {
