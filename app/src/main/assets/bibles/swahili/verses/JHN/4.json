          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawauliza saa ambayo alianza kupata nafuu. Wakamwambia, \"Jana yapata saa saba, homa ilimwacha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.52",
            "verseOrgIds": [
