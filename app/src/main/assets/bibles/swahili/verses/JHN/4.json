        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwanao yu hai.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.53",
                "verseOrgIds": [
                  "JHN.4.53"
                ]
              }
            }
