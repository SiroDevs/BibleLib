          },
          "items": [
            {
              "text": "Marko 16:14-18",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.20.19-JHN.20.23"
          },
          "items": [
