    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini baba yake akawaambia watumishi, 'Leteni upesi joho lililo bora sana, tieni pete kidoleni mwake na viatu miguuni mwake.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.22",
                "verseOrgIds": [
                  "LUK.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Leteni ndama aliyenona, mkamchinje ili tuwe na karamu, tule na kufurahi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.23",
                "verseOrgIds": [
                  "LUK.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana huyu mwanangu alikuwa amekufa na sasa yu hai tena; alikuwa amepotea na sasa amepatikana!' Nao wakaanza kufanya tafrija.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.24",
                "verseOrgIds": [
                  "LUK.15.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wakati huo, yule mwana mkubwa alikuwa shambani. Alipokaribia nyumbani, akasikia sauti ya nyimbo na watu wakicheza.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.25",
                "verseOrgIds": [
                  "LUK.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akamwita mmoja wa watumishi na kumuuliza, 'Kuna nini?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.26",
                "verseOrgIds": [
                  "LUK.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akamwambia, 'Ndugu yako amekuja, naye baba yako amemchinjia ndama aliyenona kwa sababu mwanawe amerudi nyumbani akiwa salama na mzima.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.27",
                "verseOrgIds": [
                  "LUK.15.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 15:28"
          },
          "items": [
