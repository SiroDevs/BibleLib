              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yule mwana mkubwa akakasirika, akakataa kuingia ndani. Basi baba yake akatoka nje na kumsihi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.28",
                "verseOrgIds": [
                  "LUK.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini yeye akamjibu baba yake, 'Tazama! Miaka yote hii nimekutumikia na hata siku moja sijaacha kutii amri zako, lakini hujanipa hata mwana-mbuzi ili nifurahi na rafiki zangu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.29",
                "verseOrgIds": [
                  "LUK.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini huyu mwanao ambaye ametapanya mali yako kwa makahaba aliporudi nyumbani, wewe umemchinjia ndama aliyenona!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.30",
                "verseOrgIds": [
                  "LUK.15.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
