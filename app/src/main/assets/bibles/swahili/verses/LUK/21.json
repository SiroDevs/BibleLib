    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtakapoona mji wa Yerusalemu umezungukwa na majeshi, basi fahamuni kwamba kuharibiwa kwake kumekaribia.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.20",
                "verseOrgIds": [
                  "LUK.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wakati huo, wale walio Uyahudi wakimbilie milimani, walio mjini Yerusalemu watoke humo, nao wale walioko mashambani wasiingie mjini.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.21",
                "verseOrgIds": [
                  "LUK.21.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa sababu huu utakuwa ni wakati wa adhabu ili kutimiza yote yaliyoandikwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.22",
                "verseOrgIds": [
                  "LUK.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ole wao wenye mimba na wale wanaonyonyesha watoto siku hizo! Kutakuwa na dhiki kuu katika nchi na ghadhabu juu ya hawa watu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.23",
                "verseOrgIds": [
                  "LUK.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wataanguka kwa makali ya upanga, na wengine watachukuliwa kuwa mateka katika mataifa yote. Nao mji wa Yerusalemu utakanyagwa na watu wa Mataifa hadi muda wa hao watu wa Mataifa utimie.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.24",
                "verseOrgIds": [
                  "LUK.21.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
