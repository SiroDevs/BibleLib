  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "LUK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tubu, La Sivyo Utaangamia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo huo, kulikuwa na watu waliomwambia Yesu habari za Wagalilaya ambao Pilato aliwaua, na damu ya hao watu akaichanganya na dhabihu yao waliyokuwa wanatoa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mnadhani kwamba hawa Wagalilaya ambao walikufa kifo cha namna hiyo walikuwa na dhambi kuwazidi Wagalilaya wengine wote?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.2",
                "verseOrgIds": [
                  "LUK.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "La hasha! Ninyi nanyi msipotubu, mtaangamia vivyo hivyo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.3",
                "verseOrgIds": [
                  "LUK.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.3",
            "verseOrgIds": [
              "LUK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Au wale watu kumi na wanane waliokufa walipoangukiwa na mnara huko Siloamu: mnadhani wao walikuwa waovu kuliko watu wote waliokuwa wanaishi Yerusalemu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.4",
                "verseOrgIds": [
                  "LUK.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nawaambia, la hasha! Ninyi nanyi msipotubu, wote mtaangamia vivyo hivyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.5",
                "verseOrgIds": [
                  "LUK.13.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Mti Usiozaa Matunda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yesu akawaambia mfano huu:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtu mmoja alikuwa na mtini uliopandwa katika shamba lake la mizabibu, akaja ili kutafuta tini kwenye mti huo, lakini hakupata hata moja.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.6",
                "verseOrgIds": [
                  "LUK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hivyo akamwambia mtunza shamba: 'Tazama, kwa muda wa miaka mitatu sasa nimekuwa nikija kutafuta matunda kwenye mtini huu, nami sikupata hata moja. Ukate! Kwa nini uendelee kuharibu ardhi?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.7",
                "verseOrgIds": [
                  "LUK.13.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yule mtunza shamba akamjibu, 'Bwana, uache tena kwa mwaka mmoja zaidi, nami nitaupalilia na kuuwekea mbolea.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.8",
                "verseOrgIds": [
                  "LUK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama ukizaa matunda mwaka ujao, vyema, la sivyo uukate.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.9",
                "verseOrgIds": [
                  "LUK.13.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amponya Mwanamke Kilema Siku Ya Sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yesu alikuwa akifundisha katika sinagogi mojawapo siku ya Sabato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo huo akaja mwanamke mmoja aliyekuwa na pepo mchafu, naye alikuwa amepinda mgongo kwa muda wa miaka kumi na minane, wala alikuwa hawezi kunyooka wima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alipomwona, akamwita, akamwambia,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwanamke, uwe huru, umepona ugonjwa wako.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.12",
                "verseOrgIds": [
                  "LUK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alipomwekea mikono yake, mara akasimama wima akaanza kumtukuza Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kiongozi wa sinagogi akakasirika kwa sababu Yesu alikuwa ameponya mtu siku ya Sabato. Akaambia ule umati wa watu, \"Kuna siku sita ambazo watu wanapaswa kufanya kazi. Katika siku hizo, njooni mponywe, lakini si katika siku ya Sabato.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Bwana akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Enyi wanafiki! Je, kila mmoja wenu hamfungulii ngʼombe wake au punda wake kutoka zizini akampeleka kumnywesha maji siku ya Sabato?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.15",
                "verseOrgIds": [
                  "LUK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Je, huyu mwanamke, ambaye ni binti wa Abrahamu, aliyeteswa na Shetani akiwa amemfunga kwa miaka yote hii kumi na minane, hakustahili kufunguliwa kutoka kifungo hicho siku ya Sabato?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.16",
                "verseOrgIds": [
                  "LUK.13.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliposema haya, wapinzani wake wakaaibika, lakini watu wakafurahi kwa ajili ya mambo ya ajabu aliyoyafanya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Punje Ya Haradali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.13.31-MAT.13.32"
          },
          "items": [
            {
              "text": "Mathayo 13:31-32",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.4.30-MRK.4.32"
          },
          "items": [
            {
              "text": "Marko 4:30-32",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yesu akauliza,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ufalme wa Mungu unafanana na nini? Nitaufananisha na nini?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.18",
                "verseOrgIds": [
                  "LUK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Umefanana na punje ya haradali ambayo mtu aliichukua na kuipanda katika shamba lake. Nayo ikakua, ikawa mti nao ndege wa angani wakatengeneza viota vyao kwenye matawi yake.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.19",
                "verseOrgIds": [
                  "LUK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Chachu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.13.33"
          },
          "items": [
            {
              "text": "Mathayo 13:33",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akauliza tena,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nitaufananisha Ufalme wa Mungu na nini?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.20",
                "verseOrgIds": [
                  "LUK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unafanana na chachu ambayo mwanamke aliichukua akaichanganya katika kiasi kikubwa cha unga mpaka wote ukaumuka.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.21",
                "verseOrgIds": [
                  "LUK.13.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlango Mwembamba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.7.13-MAT.7.14"
          },
          "items": [
            {
              "text": "Mathayo 7:13-14",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.7.21-MAT.7.23"
          },
          "items": [
            {
              "text": "21-23",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akapita katika miji na vijiji, akifundisha wakati alisafiri kwenda Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mmoja akamuuliza, \"Bwana, ni watu wachache tu watakaookolewa?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Jitahidini sana kuingia kupitia mlango mwembamba, kwa maana nawaambia wengi watajaribu kuingia, lakini hawataweza.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.24",
                "verseOrgIds": [
                  "LUK.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wakati mwenye nyumba atakapoondoka na kufunga mlango, mtasimama nje mkibisha mlango na kusema, 'Bwana! Tufungulie mlango!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini yeye atawajibu, 'Siwajui ninyi, wala mtokako.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo mtamjibu, 'Tulikula na kunywa pamoja nawe, tena ulifundisha katika mitaa yetu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.26",
                "verseOrgIds": [
                  "LUK.13.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini yeye atawajibu, 'Siwajui ninyi, wala mtokako. Ondokeni kwangu, ninyi watenda maovu!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.27",
                "verseOrgIds": [
                  "LUK.13.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo kutakuwako kilio na kusaga meno, mtakapowaona Abrahamu, Isaki, Yakobo na manabii wote wakiwa katika Ufalme wa Mungu, lakini ninyi mkiwa mmetupwa nje.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.28",
                "verseOrgIds": [
                  "LUK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Watu watatoka mashariki na magharibi, kaskazini na kusini, nao wataketi kwenye sehemu walizoandaliwa karamuni katika Ufalme wa Mungu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.29",
                "verseOrgIds": [
                  "LUK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tazama, kunao walio wa mwisho watakaokuwa wa kwanza, nao wa kwanza watakaokuwa wa mwisho.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.30",
                "verseOrgIds": [
                  "LUK.13.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Aomboleza Kwa Ajili Ya Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.23.37-MAT.23.39"
          },
          "items": [
            {
              "text": "Mathayo 23:37-39",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo huo baadhi ya Mafarisayo wakamwendea Yesu na kumwambia, \"Ondoka hapa uende mahali pengine kwa maana Herode anataka kukuua.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawajibu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nendeni mkamwambie yule mbweha, 'Ninafukuza pepo wachafu na kuponya wagonjwa leo na kesho, nami siku ya tatu nitaikamilisha kazi yangu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.32",
                "verseOrgIds": [
                  "LUK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sina budi kuendelea na safari yangu leo, kesho na kesho kutwa: kwa maana haiwezekani nabii kufa mahali pengine isipokuwa Yerusalemu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.33",
                "verseOrgIds": [
                  "LUK.13.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ee Yerusalemu, Yerusalemu, uwauaye manabii na kuwapiga mawe wale waliotumwa kwako! Mara ngapi nimetamani kuwakusanya watoto wako pamoja, kama vile kuku akusanyavyo vifaranga wake chini ya mabawa yake, lakini hukutaka!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.34",
                "verseOrgIds": [
                  "LUK.13.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tazama nyumba yenu imeachwa ukiwa. Ninawaambia, hamtaniona tena mpaka wakati ule mtakaposema, 'Amebarikiwa yeye ajaye kwa jina la Bwana.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.35",
                "verseOrgIds": [
                  "LUK.13.35"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
