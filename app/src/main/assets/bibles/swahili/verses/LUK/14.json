    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umati mkubwa wa watu ulikuwa ukisafiri pamoja na Yesu, naye akageuka, akawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
              "LUK.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtu yeyote anayekuja kwangu hawezi kuwa mwanafunzi wangu kama hatanipenda mimi zaidi ya baba yake na mama yake, mke wake na watoto wake, ndugu zake na dada zake, naam, hata maisha yake mwenyewe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.26",
                "verseOrgIds": [
                  "LUK.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yeyote asiyeuchukua msalaba wake na kunifuata hawezi kuwa mwanafunzi wangu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.27",
                "verseOrgIds": [
                  "LUK.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ni nani miongoni mwenu ambaye kama anataka kujenga nyumba, hakai kwanza chini na kufanya makisio ya gharama aone kama ana fedha za kutosha kukamilisha?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.28",
                "verseOrgIds": [
                  "LUK.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "La sivyo, akiisha kuweka msingi, naye akiwa hana uwezo wa kuikamilisha, wote waionao wataanza kumdhihaki,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.29",
                "verseOrgIds": [
                  "LUK.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "wakisema, 'Mtu huyu alianza kujenga lakini hakuweza kukamilisha.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.30",
                "verseOrgIds": [
                  "LUK.14.30"
                ]
              }
            }
          ]
