  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LUK 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Nyumbani Mwa Farisayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa siku moja Yesu alipokuwa amekwenda kula chakula kwa mmoja wa viongozi wa Mafarisayo siku ya Sabato, watu walikuwa wakimchunguza kwa bidii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papo hapo mbele yake palikuwa na mtu mmoja mwenye ugonjwa wa kuvimba mwili.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawauliza wale Mafarisayo na walimu wa sheria,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, ni halali kuponya watu siku ya Sabato au la?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.3",
                "verseOrgIds": [
                  "LUK.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakaa kimya. Hivyo Yesu akamshika yule mgonjwa mkono na kumponya, akamruhusu aende zake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama mmoja wenu angekuwa na mtoto au ngʼombe wake aliyetumbukia katika kisima siku ya Sabato, je, hamtamvuta mara moja na kumtoa?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.5",
                "verseOrgIds": [
                  "LUK.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao hawakuwa na la kusema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unyenyekevu Na Ukarimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipoona jinsi wageni walivyokuwa wanachagua mahali pa heshima wakati wa kula, akawaambia mfano huu:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtu akikualika arusini, usikae mahali pa mgeni wa heshima kwa kuwa inawezekana amealikwa mtu mheshimiwa kuliko wewe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.8",
                "verseOrgIds": [
                  "LUK.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama mkifanya hivyo yule aliyewaalika ninyi wawili atakuja na kukuambia, 'Mpishe huyu mtu kiti chako.' Ndipo kwa aibu utalazimika kukaa katika nafasi ya chini kabisa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.9",
                "verseOrgIds": [
                  "LUK.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Badala yake, unapoalikwa, chagua nafasi ya chini, ili yule mwenyeji wako atakapokuona atakuja na kukuambia, 'Rafiki yangu, nenda kwenye nafasi iliyo bora zaidi.' Kwa jinsi hii utakuwa umepewa heshima mbele ya wageni wenzako wote.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.10",
                "verseOrgIds": [
                  "LUK.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana kila mtu ajikwezaye atashushwa, naye ajishushaye atakwezwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.11",
                "verseOrgIds": [
                  "LUK.14.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yesu akamwambia yule aliyewaalika,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Uandaapo karamu ya chakula cha mchana au cha jioni, usialike rafiki zako au ndugu zako au jamaa zako au majirani zako walio matajiri tu. Ukifanya hivyo, wao nao wanaweza kukualika kwao, nawe ukawa umelipwa kile ulichofanya na kupata thawabu yako.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.12",
                "verseOrgIds": [
                  "LUK.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bali ufanyapo karamu, waalike maskini, vilema na vipofu,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.13",
                "verseOrgIds": [
                  "LUK.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nawe utabarikiwa kwa sababu hawa hawana uwezo wa kukulipa. Mungu atakulipa wakati wa ufufuo wa wenye haki.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.14",
                "verseOrgIds": [
                  "LUK.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Karamu Kuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.22.1-MAT.22.10"
          },
          "items": [
            {
              "text": "Mathayo 22:1-10",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa wale waliokuwa pamoja naye mezani aliposikia hivi akamwambia Yesu, \"Amebarikiwa mtu yule atakayekula katika karamu ya Ufalme wa Mungu!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamjibu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtu mmoja alikuwa anaandaa karamu kubwa, akaalika watu wengi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.16",
                "verseOrgIds": [
                  "LUK.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wakati wa karamu ulipofika, akamtuma mtumishi wake akawaambie wale walioalikwa, 'Karibuni, kila kitu ki tayari sasa.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.17",
                "verseOrgIds": [
                  "LUK.14.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini wote, kila mmoja, wakaanza kutoa udhuru: Wa kwanza akasema, 'Nimenunua shamba, lazima niende kuliona. Tafadhali niwie radhi.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.18",
                "verseOrgIds": [
                  "LUK.14.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwingine akasema, 'Ndipo tu nimenunua jozi tano za ngʼombe wa kulimia, nami ninakwenda kuwajaribu, tafadhali niwie radhi.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.19",
                "verseOrgIds": [
                  "LUK.14.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.19",
            "verseOrgIds": [
              "LUK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mwingine akasema, 'Nimeoa mke, kwa hiyo siwezi kuja.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.20",
                "verseOrgIds": [
                  "LUK.14.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yule mtumishi akarudi, akampa bwana wake taarifa. Ndipo yule mwenye nyumba akakasirika, akamwagiza yule mtumishi wake, akisema, 'Nenda upesi kwenye mitaa na vichochoro vya mjini uwalete maskini, vilema, vipofu na viwete.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.21",
                "verseOrgIds": [
                  "LUK.14.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yule mtumishi akamwambia, 'Bwana, yale uliyoniagiza nimefanya, lakini bado ipo nafasi.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.22",
                "verseOrgIds": [
                  "LUK.14.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo yule bwana akamwambia mtumishi wake, 'Nenda kwenye barabara na vijia vilivyoko nje ya mji na uwalazimishe watu waingie ili nyumba yangu ipate kujaa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.23",
                "verseOrgIds": [
                  "LUK.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.23",
            "verseOrgIds": [
              "LUK.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana nawaambia, hakuna hata mmoja wa wale walioalikwa atakayeionja karamu yangu.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.24",
                "verseOrgIds": [
                  "LUK.14.24"
                ]
              }
            }
          ]
        }
