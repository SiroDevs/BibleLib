        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chumvi ni nzuri, lakini chumvi ikiwa imepoteza ladha yake, itafanywaje ili iweze kukolea tena?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.34",
