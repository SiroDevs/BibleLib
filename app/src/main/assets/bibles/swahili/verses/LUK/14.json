    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Au ni mfalme gani atokaye kwenda kupigana vita na mfalme mwingine, ambaye hakai chini kwanza na kufikiri iwapo akiwa na jeshi la watu 10,000 ataweza kupigana na yule anayekuja na jeshi la watu 20,000?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.31",
                "verseOrgIds": [
                  "LUK.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.31",
            "verseOrgIds": [
              "LUK.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama hawezi, basi wakati yule mwingine akiwa bado yuko mbali, yeye hutuma ujumbe wa watu na kuomba masharti ya amani.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.32",
                "verseOrgIds": [
                  "LUK.14.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Vivyo hivyo, yeyote miongoni mwenu ambaye hawezi kuacha vyote alivyo navyo, hawezi kuwa mwanafunzi wangu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.33",
                "verseOrgIds": [
                  "LUK.14.33"
                ]
              }
            }
          ]
        }
