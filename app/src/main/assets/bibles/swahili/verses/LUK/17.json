        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Watu walikuwa wakila na kunywa, wakioa na kuolewa, mpaka siku ile Noa alipoingia katika safina. Ndipo gharika ikaja na kuwaangamiza wote.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.27",
                "verseOrgIds": [
                  "LUK.17.27"
                ]
              }
            }
          ]
        }
      ]
