          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama ilivyokuwa siku za Noa, ndivyo itakavyokuwa katika siku za Mwana wa Adamu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.26",
                "verseOrgIds": [
                  "LUK.17.26"
                ]
              }
