        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndivyo ilivyokuwa katika siku za Loti: Watu walikuwa wakila na kunywa, wakinunua na kuuza, wakilima na kujenga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.28",
                "verseOrgIds": [
                  "LUK.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini siku ile Loti alipoondoka Sodoma, ikanyesha mvua ya moto na kiberiti kutoka mbinguni ukawaangamiza wote.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.29",
                "verseOrgIds": [
                  "LUK.17.29"
                ]
              }
