          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakamuuliza, \"Haya yatatukia wapi Bwana?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
