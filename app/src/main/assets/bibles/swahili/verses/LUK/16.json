            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abrahamu akamwambia, 'Kama wasipowasikiliza Mose na Manabii, hawataweza kushawishika hata kama mtu akifufuka kutoka kwa wafu.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.31",
