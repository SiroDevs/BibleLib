            "number": "2",
            "style": "v",
            "sid": "SNG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama yungiyungi katikati ya miiba",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:2"
      },
      "items": [
        {
          "text": "ndivyo alivyo mpenzi wangu katikati ya wanawali.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mpendwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mti wa mtofaa miongoni mwa miti ya msituni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "ndivyo alivyo mpenzi wangu",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "miongoni mwa wanaume vijana.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "Ninafurahia kuketi kivulini mwa mwanaume huyu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "na tunda lake ni tamu kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amenichukua mpaka kwenye ukumbi wa karamu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:4"
      },
      "items": [
        {
          "text": "na bendera ya huyu mwanaume",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:4"
      },
      "items": [
        {
          "text": "juu yangu ni upendo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitie nguvu kwa zabibu kavu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "niburudishe kwa matofaa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "kwa maana ninazimia kwa mapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkono wake wa kushoto uko chini ya kichwa changu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:6"
      },
      "items": [
        {
          "text": "na mkono wake wa kuume unanikumbatia.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binti za Yerusalemu, ninawaagiza",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "kwa paa na kwa ayala wa shambani:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "Msichochee wala kuamsha mapenzi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "hata yatakapotaka yenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shairi La Pili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mpendwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikiliza! Mpenzi wangu!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "Tazama! Huyu hapa anakuja,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "akirukaruka juu milimani",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "akizunguka juu ya vilima.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpenzi wangu ni kama paa au ayala kijana.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "Tazama! Anasimama nyuma ya ukuta wetu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "akitazama kupitia madirishani,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "akichungulia kimiani.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpenzi wangu alizungumza na kuniambia,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:10"
      },
      "items": [
        {
          "text": "\"Inuka, mpenzi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:10"
      },
      "items": [
        {
          "text": "mrembo wangu, tufuatane.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama! Wakati wa masika umepita,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:11"
      },
      "items": [
        {
          "text": "mvua imekwisha na ikapita.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maua yanatokea juu ya nchi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "majira ya kuimba yamewadia,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "sauti za njiwa zinasikika",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "katika nchi yetu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtini unatunga matunda yake ya mwanzoni,",
          "type": "text",
          "attrs": {
