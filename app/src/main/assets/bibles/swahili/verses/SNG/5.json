  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "SNG 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mpenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimekuja kwenye bustani yangu, dada yangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "bibi arusi wangu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nimekusanya manemane yangu pamoja",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "na kikolezo changu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Nimekula sega langu la asali na asali yangu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nimekunywa divai yangu na maziwa yangu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Marafiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Kuleni, enyi marafiki, mnywe;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "kunyweni ya kutosha, ee wapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shairi La Nne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mpendwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nililala lakini moyo wangu ulikuwa macho.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Sikiliza! Mpenzi wangu anabisha:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "\"Nifungulie, dada yangu, mpenzi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "hua wangu, asiye na hitilafu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Kichwa changu kimeloa umande,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "na nywele zangu manyunyu ya usiku.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimevua joho langu:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "je, ni lazima nivae tena?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "Nimenawa miguu yangu:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "je, ni lazima niichafue tena?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpenzi wangu aliweka mkono wake kwenye tundu la komeo;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:4"
      },
      "items": [
        {
          "text": "moyo wangu ulianza kugonga kwa ajili yake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliinuka kumfungulia mpenzi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "mikono yangu ikidondosha manemane,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "vidole vyangu vikitiririka manemane,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "penye vipini vya komeo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilimfungulia mpenzi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "lakini mpenzi wangu alishaondoka;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "alikuwa amekwenda zake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Moyo wangu ulishuka kwa kuondoka kwake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Nilimtafuta lakini sikumpata.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Nilimwita lakini hakunijibu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walinzi walinikuta",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "walipokuwa wakifanya zamu za ulinzi mjini.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "Walinipiga, wakanijeruhi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "wakaninyangʼanya joho langu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "hao walinzi wa kuta!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyi binti za Yerusalemu, ninawaagiza:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "kama mkimpata mpenzi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "mtamwambia nini?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "Mwambieni ninazimia kwa mapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Marafiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, mpendwa wako ni bora kuliko wengine namna gani,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "wewe uliye mzuri kupita wanawake wote?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
