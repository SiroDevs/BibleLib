  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hukumu Ya",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu Ya Ahazia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kifo cha Mfalme Ahabu, nchi ya Moabu iliasi dhidi ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Ahazia alikuwa ameanguka huko Samaria kutoka baraza ya chumba chake cha juu, akaumia. Hivyo akatuma wajumbe, akiwaambia, \"Nendeni mkaulize kwa Baal-Zebubu, mungu wa Ekroni, mkaone kama nitapona kutokana na kuumia huku.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini malaika wa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.3",
                "verseOrgIds": [
                  "2KI.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Eliya, Mtishbi, \"Panda ukakutane na wajumbe wa mfalme wa Samaria, uwaulize, 'Je, ni kwa sababu hakuna Mungu katika Israeli ndiyo maana mnakwenda kumuuliza Baal-Zebubu, mungu wa Ekroni?'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.4",
                "verseOrgIds": [
                  "2KI.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'Hutaondoka kwenye kitanda unachokilalia. Hakika utakufa!' \" Hivyo Eliya akaenda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajumbe waliporudi kwa mfalme, akawauliza, \"Kwa nini mmerudi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamjibu, \"Mtu fulani alikuja kukutana nasi, naye akatuambia, 'Rudini kwa mfalme aliyewatuma na mkamwambie, \"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.6",
                "verseOrgIds": [
                  "2KI.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": ": Je, ni kwa sababu hakuna Mungu katika Israeli ndiyo maana unawatuma watu kwenda kuuliza kwa Baal-Zebubu, mungu wa Ekroni? Kwa hiyo hutaondoka kwenye kitanda unachokilalia. Hakika utakufa!\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akawauliza, \"Alikuwa mtu wa namna gani ambaye mlikutana naye, akawaambia hili?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamjibu, \"Alikuwa mtu aliyekuwa na vazi la manyoya na mkanda wa ngozi kiunoni mwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:8"
      },
      "items": [
        {
          "text": "Mfalme akasema, \"Huyo alikuwa ni Eliya, Mtishbi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfalme akamtuma mkuu mmoja wa kikosi pamoja na kikosi chake cha askari hamsini kwa nabii Eliya. Yule mkuu wa kikosi akamwendea Eliya, aliyekuwa ameketi juu ya kilima, na kumwambia, \"Mtu wa Mungu, mfalme anasema, 'Shuka chini!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya akamjibu yule mkuu wa kikosi, \"Ikiwa mimi ni mtu wa Mungu, moto na ushuke kutoka mbinguni ukuteketeze wewe na watu wako hamsini!\" Ndipo moto ukashuka kutoka mbinguni na kuwateketeza yule mkuu wa kikosi pamoja na watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliposikia hili, mfalme akatuma kwa Eliya mkuu wa kikosi mwingine na askari wake hamsini. Yule mkuu wa kikosi akamwambia Eliya, \"Mtu wa Mungu, hili ndilo asemalo mfalme, 'Shuka chini mara moja!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya akajibu, \"Ikiwa mimi ni mtu wa Mungu, moto na ushuke kutoka mbinguni ukuteketeze wewe na watu wako hamsini!\" Ndipo moto wa Mungu ukashuka kutoka mbinguni, ukamteketeza yeye na watu wake hamsini.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo mfalme akatuma mkuu wa kikosi wa tatu na watu wake hamsini. Huyu mkuu wa kikosi wa tatu akapanda na kupiga magoti mbele ya Eliya, akiomba, \"Mtu wa Mungu, tafadhali niachie uhai wangu na uhai wa hawa watu hamsini, watumishi wako!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, moto umeshuka kutoka mbinguni na kuwateketeza wale wakuu wa vikosi viwili vya kwanza pamoja na watu wao. Lakini sasa niachie uhai wangu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.15",
                "verseOrgIds": [
                  "2KI.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Eliya, \"Shuka pamoja naye, usimwogope.\" Hivyo Eliya akainuka na kushuka pamoja naye kwa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia mfalme, \"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.16",
                "verseOrgIds": [
                  "2KI.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": ": Je, ni kwa sababu hakuna Mungu katika Israeli wa kumuuliza habari, ndiyo maana ukatuma wajumbe kuuliza Baal-Zebubu, mungu wa Ekroni? Kwa sababu umefanya hili, kamwe hutaondoka kwenye kitanda unachokilalia. Hakika utakufa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo akafa, sawasawa na lile neno la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.17",
                "verseOrgIds": [
                  "2KI.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ambalo Eliya alikuwa amesema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:17"
      },
      "items": [
        {
          "text": "Kwa kuwa Ahazia hakuwa na mwana, Yoramu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "text": "akawa mfalme baada yake katika mwaka wa pili wa Yehoramu mwana wa Yehoshafati mfalme wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa matukio mengine ya utawala wa Ahazia na yale aliyoyafanya, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
    }
  ],
