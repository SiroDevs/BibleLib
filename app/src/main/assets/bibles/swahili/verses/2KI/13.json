  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoahazi Mfalme Wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa ishirini na tatu wa utawala wa Yoashi mwana wa Ahazia mfalme wa Yuda, Yehoahazi mwana wa Yehu alianza kutawala Israeli katika Samaria, naye akatawala miaka kumi na saba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.2",
                "verseOrgIds": [
                  "2KI.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa kufuata dhambi za Yeroboamu mwana wa Nebati, ambazo alikuwa amesababisha Israeli kuzitenda, na wala hakuziacha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo hasira ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.3",
                "verseOrgIds": [
                  "2KI.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ikawaka dhidi ya Israeli na kwa muda mrefu akawaweka chini ya utawala wa Hazaeli mfalme wa Aramu, na Ben-Hadadi mwanawe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehoahazi akamsihi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "rehema, naye",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akamsikiliza, kwa maana aliona jinsi mfalme wa Aramu alivyokuwa akiwatesa Israeli vikali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.5",
                "verseOrgIds": [
                  "2KI.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akamtoa mwokozi kwa ajili ya Israeli, nao wakaokoka kutoka kwenye mamlaka ya Aramu. Hivyo Waisraeli wakaishi katika nyumba zao wenyewe kama ilivyokuwa hapo awali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hawakuziacha dhambi za nyumba ya Yeroboamu, ambazo alisababisha Israeli kuzitenda, bali wakaendelea kuzitenda. Nguzo ya Ashera pia iliendelea kusimama katika Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapakubaki kitu chochote katika jeshi la Yehoahazi isipokuwa wapanda farasi hamsini, magari kumi ya vita na askari wa miguu elfu kumi, kwa kuwa mfalme wa Aramu alikuwa amewaangamiza hao wengine na kuwafanya kama mavumbi wakati wa kupura nafaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Yehoahazi yote aliyoyafanya na mafanikio yake, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahazi akalala pamoja na baba zake, akazikwa huko Samaria. Naye Yehoashi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        },
        {
          "text": "mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoashi Mfalme Wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa thelathini na saba wa utawala wa Yoashi mfalme wa Yuda, Yehoashi mwana wa Yehoahazi alianza kutawala Israeli huko Samaria, naye akatawala miaka kumi na sita.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alifanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.11",
                "verseOrgIds": [
                  "2KI.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", na hakuacha dhambi yoyote kati ya zile za Yeroboamu mwana wa Nebati ambazo alikuwa amesababisha Israeli kuzitenda, bali aliendelea kuzitenda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa matukio mengine ya utawala wa Yehoashi, yote aliyoyafanya na mafanikio yake, pamoja na vita yake dhidi ya Amazia mfalme wa Yuda, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoashi akalala pamoja na baba zake, akazikwa Samaria pamoja na wafalme wa Israeli. Yeroboamu akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huu, Elisha alikuwa anaumwa na ugonjwa ambao baadaye ulimuua. Yehoashi mfalme wa Israeli akashuka kwenda kumwona na kumlilia. Akalia, \"Baba yangu! Baba yangu! Magari ya vita ya Israeli na wapanda farasi wake!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akasema, \"Leta upinde na baadhi ya mishale,\" naye mfalme akafanya hivyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akamwambia mfalme wa Israeli, \"Shika upinde mikononi mwako.\" Alipokwisha kuichukua, Elisha akaweka mikono yake juu ya mikono ya mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akasema, \"Fungua dirisha la mashariki,\" naye akalifungua. Elisha akasema, \"Piga mshale!\" Naye akapiga mshale. Elisha akasema, \"Mshale wa ushindi wa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.17",
                "verseOrgIds": [
                  "2KI.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", mshale wa ushindi juu ya Aramu! Utawaangamiza Waaramu kabisa huko Afeki.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akasema, \"Chukua mishale,\" naye mfalme akaichukua. Elisha akamwambia, \"Piga ardhi kwa hiyo mishale.\" Akaipiga mara tatu, halafu akaacha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu wa Mungu akamkasirikia na akasema, \"Ungepiga chini mara tano au sita, ndipo ungeishinda Aramu na kuiangamiza kabisa. Lakini sasa utaishinda mara tatu tu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akafa, nao wakamzika.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 13:20"
      },
      "items": [
        {
          "text": "Vikosi vya Wamoabu vilikuwa vinashambulia nchi kwa vita kila mwaka wakati wa vuli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa Waisraeli fulani walipokuwa wanamzika mtu, ghafula wakaona kikosi cha washambuliaji, basi wakaitupa ile maiti ya yule mtu ndani ya kaburi la Elisha. Wakati ile maiti ilipogusa mifupa ya Elisha, yule mtu akafufuka na kusimama kwa miguu yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaeli mfalme wa Aramu aliwatesa Israeli wakati wote wa utawala wa Yehoahazi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
