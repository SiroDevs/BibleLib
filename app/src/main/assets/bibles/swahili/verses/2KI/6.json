  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shoka Laelea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa manabii wakamwambia Elisha, \"Tazama, mahali hapa tunapokutana nawe ni padogo sana kwetu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.1",
            "verseOrgIds": [
              "2KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twendeni Yordani, mahali ambapo kila mmoja wetu anaweza kupata nguzo moja, nasi tujenge huko mahali petu pa kuishi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:2"
      },
      "items": [
        {
          "text": "Naye akawaambia, \"Nendeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mmoja wao akasema, \"Je, tafadhali, huwezi kufuatana na watumishi wako?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:3"
      },
      "items": [
        {
          "text": "Elisha akajibu, \"Nitakuja.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akaenda pamoja nao.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:4"
      },
      "items": [
        {
          "text": "Basi wakaenda Yordani, nao wakaanza kukata miti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wao alipokuwa anakata mti, shoka lilitumbukia kwenye maji. Akalia, \"Ee bwana wangu, shoka lilikuwa la kuazima!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu wa Mungu akauliza, \"Je, liliangukia wapi?\" Alipomwonyesha mahali penyewe, Elisha akakata kijiti na kukitupa mahali pale, nalo shoka likaelea.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.6",
            "verseOrgIds": [
              "2KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, \"Lichukue.\" Kisha yule mtu akanyoosha mkono wake, akalichukua.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.7",
            "verseOrgIds": [
              "2KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisha Awanasa Waaramu Waliopofushwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo mfalme wa Aramu alikuwa akipigana vita na Israeli. Baada ya kukubaliana na maafisa wake, akasema, \"Nitapiga kambi yangu mahali fulani na fulani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.8",
            "verseOrgIds": [
              "2KI.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu wa Mungu akatuma ujumbe kwa mfalme wa Israeli: \"Jihadhari usije ukapita mahali pale, kwa sababu Waaramu wanashuka huko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.9",
            "verseOrgIds": [
              "2KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo mfalme wa Israeli akatuma neno la tahadhari mahali pale alikokuwa ameelekezwa na mtu wa Mungu. Mara kwa mara Elisha alimwonya mfalme kwamba watu wawe macho kwenye maeneo kama hayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili lilimfadhaisha sana mfalme wa Aramu. Akawaita maafisa wake, akawauliza, \"Je, hamtaniambia ni nani miongoni mwenu aliye upande wa mfalme wa Israeli?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.11",
            "verseOrgIds": [
              "2KI.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa maafisa wake akasema, \"Mfalme bwana wangu, hakuna hata mmoja wetu. Lakini Elisha, yule nabii aliye Israeli, humwambia mfalme wa Israeli hata yale maneno unayozungumza katika chumba chako cha kulala.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akaagiza akisema, \"Nendeni, mkatafute aliko, ili niweze kutuma watu kumkamata.\" Taarifa ikarudi kwamba, \"Yuko Dothani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.13",
            "verseOrgIds": [
              "2KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akatuma farasi na magari ya vita na jeshi lenye nguvu huko. Walikwenda usiku na kuuzunguka mji.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.14",
            "verseOrgIds": [
              "2KI.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesho yake asubuhi na mapema, mtumishi wa mtu wa Mungu alipoamka na kutoka nje, jeshi, pamoja na farasi na magari ya vita, likawa limeuzunguka mji. Mtumishi wake akasema, \"Ole wetu, bwana wangu! Tutafanya nini?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabii akajibu, \"Usiogope. Wale walio pamoja nasi ni wengi zaidi kuliko wale walio pamoja nao.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.16",
            "verseOrgIds": [
              "2KI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Elisha akaomba, \"Ee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.17",
                "verseOrgIds": [
                  "2KI.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", mfumbue macho huyu mtumishi ili apate kuona.\" Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.17",
                "verseOrgIds": [
                  "2KI.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akayafumbua macho ya yule mtumishi, naye akatazama na kuona vilima vimejaa farasi na magari ya moto, yamemzunguka Elisha pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati adui waliposhuka kumwelekea, Elisha akamwomba",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.18",
                "verseOrgIds": [
                  "2KI.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": ": \"Wapige watu hawa kwa upofu.\" Basi Mungu akawapiga kwa upofu, kama Elisha alivyoomba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akawaambia, \"Hii sio njia yenyewe, na huu sio huo mji. Nifuateni mimi, nami nitawapeleka kwa huyo mtu mnayemtafuta.\" Naye akawapeleka Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.19",
            "verseOrgIds": [
              "2KI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kuingia mjini, Elisha akasema, \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.20",
                "verseOrgIds": [
                  "2KI.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", yafungue macho ya watu hawa ili wapate kuona.\" Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.20",
                "verseOrgIds": [
                  "2KI.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akayafungua macho yao, na walipotazama, kumbe hapo ndipo walipojikuta, ndani ya Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mfalme wa Israeli alipowaona, akamuuliza Elisha, \"Je, baba yangu, niwaue?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akajibu, \"Usiwaue. Je, utawaua watu uliowateka kwa upanga wako mwenyewe na upinde wako? Wape chakula na maji ili wapate kula na kunywa, na kisha wamrudie bwana wao.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.22",
            "verseOrgIds": [
              "2KI.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akawaandalia karamu kubwa, na baada ya kula na kunywa, akawaaga nao wakarudi kwa bwana wao. Hivyo, vikosi kutoka Aramu vikakoma kuvamia nchi ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njaa Katika Samaria Iliyozingirwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kitambo kidogo, Ben-Hadadi mfalme wa Aramu akaandaa jeshi lake lote akapanda kwenda kuihusuru Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.24",
            "verseOrgIds": [
              "2KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukawa na njaa kuu katika mji. Samaria ilizingirwa kwa muda mrefu, kiasi kwamba kichwa cha punda kiliuzwa kwa shekeli themanini",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "text": "za fedha, na robo ya kibaba",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "text": "cha mavi ya njiwa kiliuzwa kwa shekeli tano",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "text": "za fedha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mfalme wa Israeli alipokuwa anapita juu ya ukuta, mwanamke mmoja akamlilia, \"Bwana wangu mfalme, nisaidie!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akajibu, \"Ikiwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.27",
                "verseOrgIds": [
                  "2KI.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "hakusaidii, nitakutolea wapi msaada? Je, ni kutoka kwenye sakafu ya kupuria? Au kwenye shinikizo la divai?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akamuuliza, \"Kwani kuna nini?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:28"
      },
      "items": [
        {
          "text": "Yule mwanamke akamjibu, \"Huyu mwanamke aliniambia, 'Mtoe mwanao ili tupate kumla leo, na kesho tutamla mwanangu.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi tukampika mwanangu na kumla. Siku iliyofuata nikamwambia, 'Mtoe mwanao ili tupate kumla.' Lakini akawa amemficha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mfalme aliposikia maneno ya yule mwanamke, alirarua mavazi yake. Naye alipoendelea kutembea ukutani, watu wakamtazama, na ndani ya mavazi yake alikuwa amevaa nguo ya gunia mwilini mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, \"Mungu na anitendee hivyo na kuzidi, ikiwa kichwa cha Elisha mwana wa Shafati kitabaki juu ya mabega yake leo!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huu, Elisha alikuwa ameketi ndani ya nyumba yake, akiwa pamoja na wazee. Mfalme akatuma mjumbe kumtangulia, lakini kabla hajafika, Elisha akawaambia wale wazee, \"Hammwoni huyu muuaji jinsi anavyotuma mtu kukata kichwa changu? Tazama, wakati mjumbe huyo atakapofika, fungeni mlango na mzuieni asiingie. Je, vishindo vya nyayo za bwana wake haviko nyuma yake?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipokuwa angali bado anazungumza nao, mjumbe akamfikia. Naye mfalme akasema, \"Maafa haya yanatoka kwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.33",
                "verseOrgIds": [
                  "2KI.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": ". Kwa nini niendelee kumngoja",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.33",
                "verseOrgIds": [
                  "2KI.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "zaidi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
  ],
