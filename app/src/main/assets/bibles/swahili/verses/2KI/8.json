          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kumi na mbili wa utawala wa Yoramu mwana wa Ahabu mfalme wa Israeli, Ahazia mwana wa Yehoramu mfalme wa Yuda alianza kutawala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia alikuwa na umri wa miaka ishirini na miwili alipoanza kutawala, naye akatawala katika Yerusalemu kwa mwaka mmoja. Mama yake aliitwa Athalia, mjukuu wa Omri mfalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenenda katika njia za nyumba ya Ahabu, na kutenda maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.27",
                "verseOrgIds": [
                  "2KI.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", kama nyumba ya Ahabu ilivyokuwa imefanya, kwa kuwa alikuwa ameoa kutoka nyumba ya Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia akaenda vitani na Yoramu mwana wa Ahabu kupigana na Hazaeli mfalme wa Aramu huko Ramoth-Gileadi. Waaramu wakamjeruhi Yoramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Mfalme Yoramu akarudi Yezreeli ili apate kuuguza majeraha aliyojeruhiwa na Waaramu huko Ramothi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        },
        {
          "text": "alipopigana na Hazaeli mfalme wa Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:29"
      },
      "items": [
        {
          "text": "Ndipo Ahazia mwana wa Yehoramu mfalme wa Yuda akashuka kwenda Yezreeli kumtazama Yoramu mwana wa Ahabu, kwa sababu alikuwa amejeruhiwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    }
