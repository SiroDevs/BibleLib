          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ardhi Ya Mshunami Yarudishwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huu, Elisha alikuwa amemwambia yule mwanamke ambaye mwanawe alikuwa amefufuliwa, \"Ondoka wewe na jamaa yako ukaishi mahali popote unapoweza kwa kitambo kidogo, kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.1",
                "verseOrgIds": [
                  "2KI.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ameamuru njaa katika nchi hii ambayo itadumu kwa miaka saba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mwanamke akafanya kama vile yule mtu wa Mungu alivyosema. Yeye na jamaa yake wakaondoka na kwenda kuishi katika nchi ya Wafilisti kwa miaka saba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya miaka saba, yule mwanamke akarudi kutoka nchi ya Wafilisti, akaenda kwa mfalme kumsihi kwa ajili ya nyumba yake na shamba lake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme alikuwa anazungumza na Gehazi, mtumishi wa mtu wa Mungu, naye alikuwa amesema, \"Hebu niambie mambo yote makuu yaliyofanywa na Elisha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Gehazi alipokuwa akimweleza mfalme jinsi Elisha alivyomfufua mtu, yule mwanamke ambaye mwanawe alikuwa amefufuliwa na Elisha akaja ili amsihi mfalme kwa ajili ya nyumba yake na shamba lake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:5"
      },
      "items": [
        {
          "text": "Gehazi akasema, \"Huyu ndiye huyo mwanamke, bwana wangu mfalme, na huyu ndiye mwanawe ambaye Elisha alimfufua.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akamuuliza yule mwanamke kuhusu mambo hayo, naye akamweleza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:6"
      },
      "items": [
        {
          "text": "Ndipo akaamuru afisa ashughulikie shauri lake na kumwambia, \"Mrudishie huyu mwanamke kila kitu kilichokuwa mali yake, pamoja na mapato yote yaliyotokana na shamba lake tangu siku alipoondoka nchini hadi sasa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hazaeli Anamuua Ben-Hadadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akaenda Dameski, naye Ben-Hadadi mfalme wa Aramu alikuwa mgonjwa. Mfalme alipoambiwa, \"Mtu wa Mungu ametoka mbali akapanda hadi hapa,\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.7",
            "verseOrgIds": [
              "2KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "mfalme akamwambia Hazaeli. \"Chukua zawadi na uende kumlaki huyo mtu wa Mungu. Muulize",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.8",
                "verseOrgIds": [
                  "2KI.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kupitia yeye, kwamba, 'Je, nitapona ugonjwa huu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaeli akaenda kumlaki Elisha, akiwa amechukua zawadi ya kila kitu kizuri kilichopatikana Dameski, mizigo iliyobebwa na ngamia arobaini. Akaingia ndani na kusimama mbele yake, akasema, \"Mwanao Ben-Hadadi mfalme wa Aramu amenituma niulize, 'Je, nitapona ugonjwa huu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akajibu, \"Nenda ukamwambie, 'Hakika utapona'; lakini",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.10",
                "verseOrgIds": [
                  "2KI.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "amenifunulia kwamba kweli atakufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akamkazia Hazaeli macho kwa nguvu mpaka akaona aibu. Kisha mtu wa Mungu akaanza kulia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaeli akauliza \"Kwa nini bwana wangu analia?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:12"
      },
      "items": [
        {
          "text": "Elisha akajibu, \"Kwa sababu najua mabaya utakayowatendea Waisraeli. Utachoma moto ngome zao, utawaua vijana wao kwa upanga, kuwatupa chini kwa nguvu watoto wachanga, na kuwatumbua wanawake wenye mimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaeli akasema, \"Itawezekanaje mtumishi wako, aliye mbwa tu, kufanya tendo la ajabu namna hiyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:13"
      },
      "items": [
        {
          "text": "Elisha akamjibu, \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.13",
                "verseOrgIds": [
                  "2KI.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "amenionyesha kuwa utakuwa mfalme wa Aramu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Hazaeli akamwacha Elisha na kumrudia bwana wake. Ben-Hadadi akamuuliza, \"Elisha alikuambia nini?\" Hazaeli akajibu, \"Aliniambia kwamba hakika utapona.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kesho yake Hazaeli akachukua nguo nzito, akailoweka ndani ya maji, akaitandaza juu ya uso wa mfalme, hivyo akafa. Kisha Hazaeli akaingia mahali pake kuwa mfalme wa Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoramu Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.21.1-2CH.21.20"
          },
          "items": [
            {
              "text": "2 Nyakati 21:1-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa tano wa Yoramu mwana wa Ahabu mfalme wa Israeli, wakati huo Yehoshafati akiwa mfalme wa Yuda, Yehoramu mwana wa Yehoshafati akaanza kutawala kama mfalme wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.16",
            "verseOrgIds": [
              "2KI.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikuwa na umri wa miaka thelathini na miwili alipoanza kutawala, naye akatawala huko Yerusalemu kwa miaka minane.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.17",
            "verseOrgIds": [
              "2KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenenda katika njia za wafalme wa Israeli, kama nyumba ya Ahabu ilivyokuwa imefanya, kwa kuwa alimwoa binti wa Ahabu. Akatenda maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.18",
                "verseOrgIds": [
                  "2KI.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, kwa ajili ya Daudi mtumishi wake,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.19",
                "verseOrgIds": [
                  "2KI.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "hakutaka kuiangamiza Yuda. Alikuwa ameahidi kuidumisha taa kwa ajili ya Daudi na wazao wake milele.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa Yehoramu, Edomu waliasi dhidi ya Yuda na kujiwekea mfalme wao wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.20",
            "verseOrgIds": [
              "2KI.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yehoramu akaenda Sairi pamoja na magari yake yote ya vita. Waedomu wakamzunguka yeye na majemadari wake wa magari yake ya vita, lakini akaondoka, akapenya usiku na kuwashambulia Waedomu. Hata hivyo, jeshi lake likatorokea nyumbani mwao.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.21",
            "verseOrgIds": [
              "2KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi leo Edomu wameasi dhidi ya Yuda. Libna pia wakaasi wakati huo huo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa matukio mengine ya utawala wa Yehoramu na yote aliyoyafanya, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu akalala pamoja na baba zake, na akazikwa pamoja nao katika Mji wa Daudi. Naye Ahazia mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazia Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
