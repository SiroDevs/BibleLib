        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazi Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.28"
          },
          "items": [
            {
              "text": "2 Nyakati 28",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kumi na saba wa utawala wa Peka mwana wa Remalia, Ahazi mwana wa Yothamu mfalme wa Yuda alianza kutawala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi alikuwa na miaka ishirini alipoanza kutawala, akatawala huko Yerusalemu kwa miaka kumi na sita. Tofauti na Daudi baba yake, hakufanya yaliyo mema machoni pa Bwana, Mungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenenda katika njia za wafalme wa Israeli, na hata akamtoa mwanawe kafara katika moto, akifuata njia za machukizo za mataifa ambayo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.3",
                "verseOrgIds": [
                  "2KI.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa ameyafukuza mbele ya Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatoa kafara na kufukiza uvumba katika mahali pa juu pa kuabudia miungu, juu ya vilima, na chini ya kila mti uliotanda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Resini mfalme wa Aramu na Peka mwana wa Remalia mfalme wa Israeli wakaondoka kwenda kupigana dhidi ya Yerusalemu na kumzunguka Ahazi kwa jeshi, lakini hawakuweza kumshinda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ule, Resini mfalme wa Aramu akaurudisha Elathi kwa Aramu kwa kuwafukuza watu wa Yuda. Kisha Waedomu wakahamia Elathi, nao wanaishi huko mpaka leo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi akatuma wajumbe kumwambia Tiglath-Pileseri mfalme wa Ashuru kwamba, \"Mimi ni mtumishi na mtumwa wako. Njoo na uniokoe kutoka mkononi mwa mfalme wa Aramu na wa mfalme wa Israeli, ambao wananishambulia.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ahazi akachukua fedha na dhahabu zilizopatikana ndani ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.8",
                "verseOrgIds": [
                  "2KI.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na katika hazina ya jumba la mfalme, na kuzituma kama zawadi kwa mfalme wa Ashuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Ashuru akamwitikia kwa kushambulia Dameski na kuiteka. Akawahamishia wenyeji wake huko Kiri, na kumuua Resini.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mfalme Ahazi akaenda Dameski kukutana na Tiglath-Pileseri wa Ashuru. Akaona madhabahu huko Dameski, naye akamtumia Uria kuhani mchoro wa hayo madhabahu, pamoja na maelezo ya mpango kamili wa ujenzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Uria kuhani akajenga madhabahu kulingana na mipango yote ambayo Mfalme Ahazi alikuwa ameituma kutoka Dameski, na akamaliza ujenzi kabla ya Mfalme Ahazi kurudi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme aliporudi kutoka Dameski na kuona hayo madhabahu, akayasogelea na kutoa sadaka juu yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatoa sadaka yake ya kuteketezwa na sadaka ya nafaka, akamimina sadaka ya kinywaji na kunyunyizia damu ya sadaka zake za amani juu ya hayo madhabahu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Ahazi akayaondoa madhabahu ya zamani ya shaba kutoka hapo mbele ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.14",
                "verseOrgIds": [
                  "2KI.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", yaliyokuwa yamesimama kati ya ingilio la Hekalu na hayo madhabahu mapya, naye akayaweka upande wa kaskazini mwa hayo madhabahu mapya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mfalme Ahazi akatoa amri zifuatazo kwa Uria kuhani: \"Juu ya hayo madhabahu kubwa mapya, toa sadaka ya asubuhi ya kuteketezwa na sadaka ya jioni ya nafaka, sadaka ya mfalme ya kuteketezwa pamoja na sadaka yake ya nafaka, sadaka ya kuteketezwa ya watu wote wa nchi, pamoja na sadaka yao ya nafaka na sadaka yao ya kinywaji. Unyunyize juu ya hayo madhabahu damu yote ya sadaka za kuteketezwa na dhabihu. Lakini mimi nitatumia hayo madhabahu ya zamani ya shaba kwa ajili ya kutafuta uongozi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Uria kuhani akafanya kama Mfalme Ahazi alivyoagiza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Ahazi akaondoa mbao za pembeni na kuondoa masinia kwenye vile vishikilio vilivyohamishika. Akaondoa ile Bahari kutoka kwenye mafahali wa shaba walioishikilia, na kuiweka kwenye kitako cha jiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa heshima ya mfalme wa Ashuru, akaliondoa pia pazia la Sabato lililokuwa limewekwa ndani ya Hekalu, na akaondoa ile njia ya kifalme ya kuingia kwenye Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.18",
                "verseOrgIds": [
                  "2KI.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Ahazi na yale aliyoyafanya, je hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi akalala na baba zake, naye akazikwa pamoja nao katika Mji wa Daudi. Naye Hezekia mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    }
  ],
