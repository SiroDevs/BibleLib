      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akasema, \"Sikiliza neno la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.7.1",
                "verseOrgIds": [
                  "2KI.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Hivi ndivyo asemavyo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.7.1",
                "verseOrgIds": [
                  "2KI.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ": Wakati kama huu kesho, kipimo kimoja",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "text": "cha unga mzuri kitauzwa kwa shekeli moja ya fedha,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "text": "na vibaba viwili vya shayiri kwa shekeli moja ya fedha katika lango la Samaria.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule afisa ambaye mfalme alikuwa anauegemea mkono wake akamwambia yule mtu wa Mungu, \"Tazama, hata kama",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.7.2",
                "verseOrgIds": [
                  "2KI.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "atafungua madirisha ya mbinguni, je, jambo hili litawezekana?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 7:2"
      },
      "items": [
        {
          "text": "Elisha akajibu, \"Utaona kwa macho yako mwenyewe, lakini wewe hutakula chochote kati ya hivyo!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwisho Wa Kuzingirwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi kulikuwepo na watu wanne wenye ukoma katika ingilio la lango la mji. Wakaambiana, \"Kwa nini tukae hapa mpaka tufe?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.3",
            "verseOrgIds": [
              "2KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama tukisema, 'Tutaingia mjini,' mjini kuna njaa, nasi tutakufa humo. Kama tukikaa hapa, tutakufa. Kwa hiyo twende kwenye kambi ya Waaramu na tujisalimishe. Kama wakituacha hai, tutaishi; kama wakituua, basi na tufe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.4",
            "verseOrgIds": [
              "2KI.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa giza la jioni, wakaondoka na kwenda kwenye kambi ya Waaramu. Walipofika mwanzo wa kambi, hapakuwa na mtu,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa Bwana alilifanya jeshi la Waaramu lisikie sauti kama ya magari ya vita, farasi na jeshi kubwa, kiasi kwamba waliambiana, \"Tazama, mfalme wa Israeli ameajiri mfalme wa Wahiti na mfalme wa Wamisri kuja kutushambulia sisi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.6",
            "verseOrgIds": [
              "2KI.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakaondoka na kukimbia wakati wa giza la jioni na kuacha mahema yao, farasi wao na punda wao. Wakakimbia kuokoa maisha yao na kuacha kila kitu ndani ya kambi kama kilivyokuwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.7",
            "verseOrgIds": [
              "2KI.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale watu wenye ukoma walipofika mwanzoni mwa kambi, wakaingia kwenye mojawapo ya mahema. Wakala na kunywa, na kuchukua fedha, dhahabu na nguo, wakaenda kuvificha. Wakarudi na kuingia katika hema jingine, na kuchukua baadhi ya vitu kutoka ndani yake na kuvificha pia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.8",
            "verseOrgIds": [
              "2KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakaambiana, \"Hili tunalolifanya sio jema. Hii ni siku ya habari njema, nasi tunakaa kimya. Kama tukisubiri mpaka mapambazuko, maafa yatatupata. Twendeni mara moja tukatoe habari hizi katika jumba la mfalme.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.9",
            "verseOrgIds": [
              "2KI.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo wakaenda mjini na kuwaita walinzi wa langoni, wakawaambia, \"Tulikwenda katika kambi ya Waaramu lakini hapakuwepo na mtu huko, hata sauti ya mtu yeyote, ila farasi na punda waliofungwa na mahema yaliyoachwa kama yalivyokuwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.10",
            "verseOrgIds": [
              "2KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walinzi wa langoni wakatangaza habari ile kwa sauti kuu, na taarifa hii ikatolewa ndani ya jumba la mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.11",
            "verseOrgIds": [
              "2KI.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akaamka usiku na kuwaambia maafisa wake, \"Nitawaambia kile Waaramu walichotufanyia. Wanajua kwamba tuna njaa, hivyo wameacha kambi yao ili kujificha mashambani, wakifikiri, 'Kwa hakika watatoka nje ya mji, nasi tutawakamata wakiwa hai na kuingia ndani ya mji.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.12",
            "verseOrgIds": [
              "2KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa maafisa wake akajibu, \"Waamuru watu wachache wakawachukue farasi watano kati ya wale waliobaki katika mji. Hatima yao itakuwa kama ya Waisraeli wote walio hapa. Watakuwa tu kama Waisraeli hawa ambao wanangoja kifo. Hivyo tuwatumeni wajue kumetendeka nini.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.13",
            "verseOrgIds": [
              "2KI.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wakachagua magari mawili ya vita pamoja na farasi wake, naye mfalme akawatuma wafuatilie jeshi la Waaramu. Akawaamuru waendeshaji akisema, \"Nendeni mkaone ni nini kilichotokea.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.14",
            "verseOrgIds": [
              "2KI.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawafuatia hadi Yordani, nao wakakuta barabara yote ikiwa imetapakaa nguo na vyombo vya Waaramu walivyokuwa wamevitupa walipokuwa wanatoroka. Basi wale wajumbe wakarudi na kutoa taarifa kwa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.15",
            "verseOrgIds": [
              "2KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wakatoka na kuteka nyara kambi ya Waaramu. Kwa hiyo kipimo cha unga mzuri kikauzwa kwa shekeli, na vipimo viwili vya shayiri kwa shekeli, kama vile",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.7.16",
                "verseOrgIds": [
                  "2KI.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyokuwa amesema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mfalme alikuwa amemweka yule afisa ambaye mfalme alikuwa anauegemea mkono wake awe msimamizi wa lango. Nao watu wakamkanyaga walipoingia langoni, naye akafa, kama vile mtu wa Mungu alivyokuwa ametangulia kusema wakati mfalme alipofika nyumbani kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.17",
            "verseOrgIds": [
              "2KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikatokea kama vile mtu wa Mungu alivyokuwa amemwambia mfalme: \"Wakati kama huu kesho, kipimo kimoja cha unga mzuri kitauzwa kwa shekeli moja ya fedha, na vibaba viwili vya shayiri kwa shekeli moja ya fedha katika lango la Samaria.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.18",
            "verseOrgIds": [
              "2KI.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule afisa alikuwa amemwambia yule mtu wa Mungu, \"Tazama, hata kama",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.19",
            "verseOrgIds": [
              "2KI.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.7.19",
                "verseOrgIds": [
                  "2KI.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "atafungua madirisha ya mbinguni, je, jambo hili litawezekana?\" Naye yule mtu wa Mungu alikuwa amemjibu, \"Utaona kwa macho yako mwenyewe, lakini wewe hutakula chochote kati ya hivyo!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.19",
            "verseOrgIds": [
              "2KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndivyo hasa ilivyotokea kwake, kwa kuwa watu walimkanyaga langoni, naye akafa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.20",
            "verseOrgIds": [
              "2KI.7.20"
            ]
          }
        }
      ]
    }
  ],
