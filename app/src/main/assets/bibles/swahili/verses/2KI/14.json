              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.25",
                "verseOrgIds": [
                  "2KI.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, lililosemwa kupitia mtumishi wake Yona mwana wa Amitai, nabii kutoka Gath-Heferi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
