              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye alirudishia mipaka ya Israeli kuanzia Lebo-Hamathi hadi Bahari ya Araba, sawasawa na neno la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
