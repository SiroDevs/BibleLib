          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu akalala pamoja na baba zake, wafalme wa Israeli. Naye Zekaria mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
