          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Yothamu na yale aliyoyafanya, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Yuda?",
          "type": "text",
          "attrs": {
