          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, mahali pa juu pa kuabudia hapakuondolewa. Watu waliendelea kutoa kafara na kufukiza uvumba huko. Yothamu akajenga upya Lango la Juu la Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
