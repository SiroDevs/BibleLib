          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa pili wa utawala wa Peka mwana wa Remalia mfalme wa Israeli, Yothamu mwana wa Uzia mfalme wa Yuda alianza kutawala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikuwa na miaka ishirini na mitano alipoanza kutawala, naye akatawala huko Yerusalemu miaka kumi na sita. Mama yake aliitwa Yerusha binti Sadoki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
