          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa utawala wa Peka mfalme wa Israeli, Tiglath-Pileseri mfalme wa Ashuru alikuja na kuteka Iyoni, Abel-Beth-Maaka, Yanoa, Kedeshi na Hazori. Akateka miji ya Gileadi na Galilaya, pamoja na nchi yote ya Naftali, na kuwahamishia watu wote Ashuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Hoshea mwana wa Ela akafanya shauri baya dhidi ya Peka mwana wa Remalia. Akamshambulia na kumuua, kisha akaingia mahali pake kuwa mfalme katika mwaka wa ishirini wa Yothamu mwana wa Uzia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        }
      ]
    },
    {
