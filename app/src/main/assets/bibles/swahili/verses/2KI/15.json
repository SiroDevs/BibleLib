                "verseId": "2KI.15.34",
                "verseOrgIds": [
                  "2KI.15.34"
                ]
              }
            }
          ]
        },
        {
          "text": ", kama Uzia baba yake alivyokuwa amefanya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
