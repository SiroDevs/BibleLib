          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pekahia akafanya uovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.15.24",
                "verseOrgIds": [
                  "2KI.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": ". Hakuziacha dhambi za Yeroboamu mwana wa Nebati, ambazo alisababisha Israeli kuzitenda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wa maafisa wake wakuu, Peka mwana wa Remalia, akafanya shauri baya dhidi yake. Akachukua watu hamsini wa Gileadi pamoja naye, akamuua Pekahia, pamoja na Argobu na Aria, katika ngome ya jumba la kifalme huko Samaria. Kwa hiyo Peka akamuua Pekahia, naye akaingia mahali pake kuwa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        }
      ]
    },
    {
