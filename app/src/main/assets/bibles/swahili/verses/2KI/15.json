          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Pekahia na yote aliyoyafanya yameandikwa katika kitabu cha kumbukumbu za wafalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
