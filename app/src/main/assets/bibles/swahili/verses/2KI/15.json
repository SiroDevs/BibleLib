                "verseOrgIds": [
                  "2KI.15.37"
                ]
              }
            }
          ]
        },
        {
          "text": "akaanza kuwatuma Resini mfalme wa Aramu na Peka mwana wa Remalia dhidi ya Yuda.)",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
