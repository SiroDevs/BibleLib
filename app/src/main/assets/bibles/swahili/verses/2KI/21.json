        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase alikuwa na umri wa miaka kumi na miwili alipoanza kutawala, naye akatawala huko Yerusalemu miaka hamsini na mitano. Mama yake aliitwa Hefsiba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.2",
                "verseOrgIds": [
                  "2KI.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", akafuata desturi za machukizo za mataifa ambayo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.2",
                "verseOrgIds": [
                  "2KI.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "aliyafukuza mbele ya Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajenga upya mahali pa juu pa kuabudia miungu ambapo Hezekia baba yake alikuwa amepabomoa. Pia akasimamisha madhabahu za Baali na kutengeneza nguzo ya Ashera, kama Ahabu mfalme wa Israeli alivyofanya. Akalisujudia jeshi lote la angani na kuliabudu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajenga madhabahu katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.4",
                "verseOrgIds": [
                  "2KI.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ambamo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.4",
                "verseOrgIds": [
                  "2KI.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa amesema, \"Katika Yerusalemu nitaliweka Jina langu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika nyua zote mbili za Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.5",
                "verseOrgIds": [
                  "2KI.21.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", akajenga madhabahu kwa ajili ya jeshi lote la angani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamtoa kafara mwanawe mwenyewe katika moto, akafanya uchawi na uaguzi, na akataka shauri kwa wapiga ramli na kwa mizimu. Akafanya maovu mengi sana machoni mwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.6",
                "verseOrgIds": [
                  "2KI.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na kumghadhibisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachukua nguzo ya Ashera aliyoichonga na kuiweka katika Hekalu, ambalo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.7",
                "verseOrgIds": [
                  "2KI.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa amemwambia Daudi na mwanawe Solomoni, \"Katika Hekalu hili na katika Yerusalemu niliouchagua kutoka kabila zote za Israeli, nitaliweka Jina langu milele.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitaifanya tena miguu ya Waisraeli itangetange kutoka nchi niliyowapa baba zao, ikiwa watakuwa waangalifu kufanya kila kitu nilichowaamuru, na kuishika Sheria yote ambayo walipewa na Mose mtumishi wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hawa watu hawakusikiliza. Manase akawapotosha, hivyo kwamba walifanya maovu mengi kuliko mataifa ambayo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.9",
                "verseOrgIds": [
                  "2KI.21.9"
                ]
              }
            }
          ]
        },
        {
          "text": "aliyaangamiza mbele ya Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.10",
                "verseOrgIds": [
                  "2KI.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema kupitia watumishi wake manabii:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Manase mfalme wa Yuda ametenda dhambi hizi za kuchukiza. Amefanya maovu mengi kuliko Waamori waliokuwepo kabla yake, na ameiongoza Yuda katika dhambi kwa sanamu zake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.12",
                "verseOrgIds": [
                  "2KI.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli: Nitaleta maafa makubwa juu ya Yerusalemu na Yuda, kiasi kwamba masikio ya kila mmoja atakayesikia habari zake yatawasha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitanyoosha juu ya Yerusalemu kamba ya kupimia iliyotumika dhidi ya Samaria, na timazi iliyotumika dhidi ya nyumba ya Ahabu. Nitaifutilia mbali Yerusalemu kama mtu afutaye sahani, nikiifuta na kuifunikiza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.13",
            "verseOrgIds": [
              "2KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawakataa mabaki wa urithi wangu na kuwatia mikononi mwa adui zao. Watapokonywa mali zao na kutekwa nyara na adui zao wote,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu wametenda uovu machoni pangu na kunighadhibisha tangu siku baba zao walipotoka Misri mpaka siku ya leo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaidi ya hayo, Manase pia alimwaga damu nyingi isiyo na hatia, hivi kwamba aliijaza Yerusalemu kutoka mwanzo hadi mwisho, mbali na dhambi ambayo alikuwa amesababisha Yuda kufanya, na hivyo wakatenda maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.21.16",
                "verseOrgIds": [
                  "2KI.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Manase, na yote aliyoyafanya, pamoja na dhambi alizotenda, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase akalala pamoja na baba zake na akazikwa katika bustani ya jumba lake la kifalme, katika bustani ya Uza. Naye Amoni mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amoni Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.33.21-2CH.33.25"
          },
          "items": [
            {
              "text": "2 Nyakati 33:21-25",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni alikuwa na miaka ishirini na miwili alipoanza kutawala, naye akatawala huko Yerusalemu kwa miaka miwili. Mamaye aliitwa Meshulemethi binti Haruzi, kutoka Yotba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
