              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wa nchi wakawaua wale wote waliokuwa wamefanya hila dhidi ya Mfalme Amoni. Wakamfanya Yosia mwanawe kuwa mfalme mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
