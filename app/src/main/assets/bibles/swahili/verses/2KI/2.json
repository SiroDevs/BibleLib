          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.1",
                "verseOrgIds": [
                  "2KI.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "alipokuwa karibu kumchukua Eliya mbinguni kwa upepo wa kisulisuli, Eliya na Elisha walikuwa njiani wakitoka Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya akamwambia Elisha, \"Kaa hapa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "amenituma Betheli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:2"
      },
      "items": [
        {
          "text": "Lakini Elisha akasema, \"Kwa hakika, kama",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "aishivyo na wewe uishivyo, sitakuacha.\" Kwa hiyo wakaenda Betheli pamoja.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa manabii waliokuwako huko Betheli wakamjia Elisha na kumuuliza, \"Je, unajua ya kwamba",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.3",
                "verseOrgIds": [
                  "2KI.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "atakuondolea bwana wako leo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:3"
      },
      "items": [
        {
          "text": "Elisha akawajibu, \"Ndiyo, najua, lakini msizungumze juu ya jambo hilo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
