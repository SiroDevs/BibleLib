                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "aishivyo na wewe uishivyo, sitakuacha.\" Hivyo wakaenda Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
