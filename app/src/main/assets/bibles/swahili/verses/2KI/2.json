          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Eliya akamwambia, \"Baki hapa, Elisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
