    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa manabii waliokuwako huko Yeriko wakamwendea Elisha na kumuuliza, \"Je, unajua ya kwamba",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
