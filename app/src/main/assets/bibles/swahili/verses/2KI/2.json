                "verseOrgIds": [
                  "2KI.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "atakuondolea bwana wako leo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
