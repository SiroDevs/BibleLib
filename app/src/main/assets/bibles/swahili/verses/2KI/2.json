                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "amenituma Yeriko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:4"
      },
      "items": [
        {
          "text": "Naye akajibu, \"Kwa hakika kama",
          "type": "text",
          "attrs": {
