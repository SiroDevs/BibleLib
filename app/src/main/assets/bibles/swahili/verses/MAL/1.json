  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujumbe: Neno la",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.1",
                "verseOrgIds": [
                  "MAL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa Israeli kupitia kwa Malaki.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Alipendwa, Esau Alichukiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.2",
                "verseOrgIds": [
                  "MAL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "asema, \"Nimewapenda ninyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:2"
      },
      "items": [
        {
          "text": "\"Lakini ninyi mnauliza, 'Wewe umetupendaje?' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.2",
                "verseOrgIds": [
                  "MAL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "asema, \"Je, Esau hakuwa ndugu yake Yakobo? Hata hivyo nimempenda Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini nikamchukia Esau, nami nimeifanya milima yake kuwa ukiwa, na urithi wake nimewapa mbweha wa jangwani.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.3",
            "verseOrgIds": [
              "MAL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu anaweza kusema, \"Ingawa tumepondapondwa, tutajenga upya magofu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:4"
      },
      "items": [
        {
          "text": "Lakini hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.4",
                "verseOrgIds": [
                  "MAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote asemalo: \"Wanaweza kujenga, lakini nitabomoa. Wataitwa Nchi Ovu, watu ambao siku zote wapo chini ya ghadhabu ya",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.4",
                "verseOrgIds": [
                  "MAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtayaona kwa macho yenu wenyewe na kusema, '",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.5",
                "verseOrgIds": [
                  "MAL.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mkuu, hata nje ya mipaka ya Israeli!'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhabihu Zilizo Na Mawaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwana humheshimu baba yake, naye mtumishi humheshimu bwana wake. Kama mimi ni baba, iko wapi heshima ninayostahili? Kama mimi ni bwana, iko wapi heshima ninayostahili?\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.6",
                "verseOrgIds": [
                  "MAL.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote. \"Ni ninyi, enyi makuhani, mnaolidharau Jina langu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:6"
      },
      "items": [
        {
          "text": "\"Lakini mnauliza, 'Tumelidharau Jina lako kwa namna gani?'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mnatoa sadaka chakula kilichotiwa unajisi juu ya madhabahu yangu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:7"
      },
      "items": [
        {
          "text": "\"Lakini ninyi mnauliza, 'Tumekutia unajisi kwa namna gani?'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:7"
      },
      "items": [
        {
          "text": "\"Kwa kusema kuwa meza ya",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.7",
                "verseOrgIds": [
                  "MAL.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ya kudharauliwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mletapo dhabihu za wanyama walio vipofu, je, hilo si kosa? Mnapoleta dhabihu zilizo vilema au wanyama wagonjwa, je, hilo si kosa? Jaribuni kuvitoa kwa mtawala wenu! Je, angefurahishwa nanyi? Je, atawakubalia?\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.8",
                "verseOrgIds": [
                  "MAL.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Basi mwombeni Mungu awe na neema kwetu. Je, kwa sadaka kama hizo kutoka mikononi mwenu, atawapokea?\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.9",
                "verseOrgIds": [
                  "MAL.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laiti mmoja wenu angalifunga milango ya Hekalu, ili msije mkawasha moto usiokuwa na faida juu ya madhabahu yangu! Sina furaha nanyi,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.10",
                "verseOrgIds": [
                  "MAL.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, \"nami sitaikubali sadaka toka mikononi mwenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jina langu litakuwa kuu miongoni mwa mataifa, kuanzia mawio ya jua hata machweo yake. Kila mahali uvumba na sadaka safi zitaletwa kwa Jina langu, kwa sababu Jina langu litakuwa kuu miongoni mwa mataifa,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.11",
                "verseOrgIds": [
                  "MAL.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini mnalinajisi Jina langu kwa kusema kuhusu meza ya Bwana, 'Imetiwa unajisi pamoja na chakula chake. Ni ya kudharauliwa.'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi mnasema, 'Mzigo gani huu!' Nanyi mnaidharau kwa kiburi,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.13",
                "verseOrgIds": [
                  "MAL.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:13"
      },
      "items": [
        {
          "text": "\"Wakati mnapowaleta wanyama mliopokonya kwa nguvu, walio vilema au walio wagonjwa na kuwatoa kama dhabihu, je, niwakubali kutoka mikononi mwenu?\" asema",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.13",
                "verseOrgIds": [
                  "MAL.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 1:14"
          },
          "items": [
            {
              "text": "14",
