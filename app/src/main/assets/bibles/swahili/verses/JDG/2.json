            }
          ]
        },
        {
          "text": "alikuwa pamoja na huyo mwamuzi, naye aliwaokoa kutoka mikononi mwa adui zao kwa kipindi chote alichoishi yule mwamuzi. Kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
