        },
        {
          "text": "aliwahurumia kwa sababu ya kilio chao cha huzuni kwa ajili ya wale waliokuwa wakiwatesa na kuwataabisha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
