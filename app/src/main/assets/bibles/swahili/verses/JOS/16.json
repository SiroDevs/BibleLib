    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgawo Kwa Efraimu Na Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgawanyo wa Yosefu ulianzia Yordani ya Yeriko, mashariki mwa miji ya Yeriko na kutoka hapo ulipanda kupitia jangwani na kuingia katika nchi ya vilima ya Betheli.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukaendelea kutoka Betheli (ndiyo Luzu), ukavuka kuingia eneo la Waariki huko Atarothi,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukateremkia kuelekea magharibi hadi eneo la Wayafleti ukienea hadi eneo la Beth-Horoni ya Chini hadi Gezeri, ukiishia baharini.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Manase na Efraimu, wazao wa Yosefu, walipokea urithi wao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo lilikuwa eneo la Efraimu, ukoo kwa ukoo:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 16:5"
      },
      "items": [
        {
          "text": "Mpaka wa urithi wao ulianzia Ataroth-Adari upande wa mashariki hadi Beth-Horoni ya Juu,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuendelea mpaka baharini. Kutoka Mikmeta upande wa kaskazini ulipinda kuelekea mashariki hadi Taanath-Shilo, ukiupita hadi Yanoa upande wa mashariki.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha uliteremka kutoka Yanoa hadi Atarothi na Naara, ukagusa Yeriko na kutokea katika Mto Yordani.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Tapua mpaka ulikwenda magharibi hadi Bonde la Kana na kuishia baharini. Huu ulikuwa ndio urithi wa kabila la Waefraimu, ukoo kwa ukoo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia ulijumuisha miji yote na vijiji vyake ambavyo vilitengwa kwa ajili ya Waefraimu ndani ya urithi wa kabila la Manase.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawakuwatoa Wakanaani waishio Gezeri; mpaka leo Wakanaani wanaishi miongoni mwa watu wa Efraimu lakini wanatakiwa kufanya kazi ngumu za kulazimishwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.10",
            "verseOrgIds": [
              "JOS.16.10"
            ]
          }
        }
      ]
    }
  ],
