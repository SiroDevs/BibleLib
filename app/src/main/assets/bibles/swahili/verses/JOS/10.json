  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jua Linasimama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya haya Adoni-Sedeki mfalme wa Yerusalemu alisikia kuwa Yoshua alikuwa ameteka mji wa Ai na kuuangamiza kabisa, tena alikuwa ameua mfalme wake, kama alivyofanya huko Yeriko na mfalme wake, tena ya kuwa watu wa Gibeoni walikuwa wamefanya mapatano ya amani na Waisraeli, na walikuwa wakiishi karibu yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.1",
            "verseOrgIds": [
              "JOS.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye na watu wake wakataharuki mno kwa kuwa Gibeoni ulikuwa mji mkubwa kama mmojawapo ya miji ya kifalme; ulikuwa mkubwa kuliko Ai, nao watu wake wote walikuwa mashujaa wa vita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.2",
            "verseOrgIds": [
              "JOS.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Adoni-Sedeki mfalme wa Yerusalemu akaomba msaada kwa Hohamu mfalme wa Hebroni, Piramu mfalme wa Yarmuthi, Yafia mfalme wa Lakishi, na Debiri mfalme wa Egloni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.3",
            "verseOrgIds": [
              "JOS.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia, \"Njooni mnisaidie kuipiga Gibeoni, kwa sababu imefanya mapatano ya amani na Yoshua na Waisraeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.4",
            "verseOrgIds": [
              "JOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo hao wafalme watano wa Waamori, ambao ni wafalme wa Yerusalemu, Hebroni, Yarmuthi, Lakishi na Egloni, wakaunganisha majeshi yao. Wakapanda na vikosi vyao vyote, nao wakajipanga dhidi ya Gibeoni na kuishambulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.5",
            "verseOrgIds": [
              "JOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Wagibeoni wakatuma ujumbe kwa Yoshua kwenye kambi ya Gilgali na kumwambia, \"Usiwatelekeze watumishi wako. Panda haraka uje kwetu kutuokoa! Tusaidie, kwa sababu wafalme wote wa Waamori wakaao kwenye nchi ya vilima wameunganisha majeshi yao pamoja dhidi yetu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.6",
            "verseOrgIds": [
              "JOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoshua akaondoka Gilgali pamoja na jeshi lake lote, wakiwepo watu wote mashujaa wa vita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.7",
            "verseOrgIds": [
              "JOS.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.8",
                "verseOrgIds": [
                  "JOS.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Yoshua, \"Usiwaogope watu hao, nimewatia mkononi mwako. Hakuna yeyote atakayeweza kushindana nawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.8",
            "verseOrgIds": [
              "JOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Yoshua kutembea usiku kucha kutoka Gilgali, akawashambulia ghafula.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.9",
            "verseOrgIds": [
              "JOS.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.10",
                "verseOrgIds": [
                  "JOS.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akawafadhaisha mbele ya Waisraeli, nao wakawashinda kwa ushindi mkuu huko Gibeoni. Israeli wakawafukuza kuelekea njia iendayo Beth-Horoni wakiwaua mpaka kufikia njia iendayo Azeka na Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.10",
            "verseOrgIds": [
              "JOS.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokuwa wakikimbia mbele ya Israeli kwenye barabara iteremkayo kutoka Beth-Horoni hadi Azeka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.11",
                "verseOrgIds": [
                  "JOS.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akawavumishia mawe makubwa ya mvua kutoka mbinguni, na wengi wao wakauawa na hayo mawe kuliko wale waliouawa kwa upanga wa Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile ambayo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.12",
                "verseOrgIds": [
                  "JOS.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "aliwapeana Waamori kwa Israeli, Yoshua akanena na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.12",
                "verseOrgIds": [
                  "JOS.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akiwa mbele ya Waisraeli akasema:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "\"Wewe jua, simama juu ya Gibeoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "wewe mwezi, tulia juu ya Bonde la Aiyaloni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo jua likasimama,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "nao mwezi ukatulia,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "hadi taifa hilo lilipokwisha",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "kujilipizia kisasi kwa adui wake,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "kama ilivyoandikwa katika Kitabu cha Yashari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "Jua likasimama kimya katikati ya mbingu, likachelewa kuzama muda wa siku moja nzima.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haijakuwepo siku nyingine kama hiyo kabla au baada, siku ambayo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.14",
                "verseOrgIds": [
                  "JOS.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "alimsikiliza mwanadamu. Hakika",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.14",
                "verseOrgIds": [
                  "JOS.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa akiwapigania Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akarudi kambini huko Gilgali pamoja na Israeli yote.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.15",
            "verseOrgIds": [
              "JOS.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wafalme Watano Wa Waamori Wauawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wale wafalme watano wakawa wamekimbia kujificha kwenye pango huko Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.16",
            "verseOrgIds": [
              "JOS.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua alipoambiwa kuwa wafalme hao watano wamekutwa wakiwa wamejificha ndani ya pango huko Makeda,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.17",
            "verseOrgIds": [
              "JOS.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "akasema, \"Vingirisheni mawe makubwa kwenye mdomo wa hilo pango, tena wekeni walinzi wa kulilinda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.18",
            "verseOrgIds": [
              "JOS.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini msiwaache! Wafuatieni adui zenu, washambulieni kutoka nyuma, wala msiwaache wafike kwenye miji yao, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.19",
                "verseOrgIds": [
                  "JOS.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu amewatia mkononi mwenu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yoshua pamoja na Waisraeli wakawaangamiza kabisa karibu wote, lakini wachache waliosalia walifika kwenye miji yao yenye maboma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.20",
            "verseOrgIds": [
              "JOS.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi jeshi lote likarudi salama kwa Yoshua huko kambini Makeda, na hakuna yeyote aliyetoa neno kinyume cha Waisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.21",
            "verseOrgIds": [
              "JOS.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akasema, \"Haya fungueni mdomo wa pango, mniletee hao wafalme watano.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.22",
            "verseOrgIds": [
              "JOS.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakawatoa hao wafalme watano nje ya pango: wafalme wa Yerusalemu, Hebroni, Yarmuthi, Lakishi na Egloni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.23",
            "verseOrgIds": [
              "JOS.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokuwa wamewaleta hawa wafalme kwa Yoshua, akawaita watu wote wa Israeli, na kuwaambia majemadari wa vita waliokwenda pamoja naye, \"Njooni hapa mweke nyayo zenu juu ya shingo za hawa wafalme.\" Basi wakaja wakaweka nyayo zao shingoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.24",
            "verseOrgIds": [
              "JOS.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akawaambia, \"Msiogope, wala msivunjike moyo. Kuweni hodari na wenye ushujaa. Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.25",
                "verseOrgIds": [
                  "JOS.10.25"
                ]
              }
            }
          ]
        },
        {
          "text": "atakalowatendea adui zenu wote mnaokwenda kupigana nao.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akawapiga na kuwaua wale wafalme na kuwatundika juu ya miti mitano, nao wakaachwa wakiningʼinia juu ya ile miti hadi jioni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.26",
            "verseOrgIds": [
              "JOS.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa kuzama jua Yoshua akaamuru, nao wakawashusha kutoka kwenye ile miti na kuwatupa kwenye lile pango ambalo walikuwa wamejificha. Kwenye mdomo wa lile pango wakaweka mawe makubwa, ambayo yapo hadi leo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile Yoshua akateka Makeda. Akamuua kila mmoja katika ule mji, pamoja na mfalme wake kwa upanga. Hakubakiza mtu yeyote. Akamfanyia mfalme wa Makeda kama vile alivyokuwa amemfanyia mfalme wa Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Yaangamiza Miji Ya Kusini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akaondoka Makeda akiwa pamoja na Israeli yote mpaka mji wa Libna na kuushambulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.30",
                "verseOrgIds": [
                  "JOS.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "pia akautia huo mji wa Libna pamoja na mfalme wake mikononi mwa Israeli. Yoshua akaangamiza ule mji na kila mtu aliyekuwa ndani yake kwa upanga. Hakubakiza huko mtu yeyote. Akamfanyia mfalme wa Libna kama alivyokuwa amemfanyia mfalme wa Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yoshua akaondoka Libna kwenda Lakishi akiwa pamoja na Israeli yote; wakajipanga dhidi yake na kuushambulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.32",
                "verseOrgIds": [
                  "JOS.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "akautia Lakishi mikononi mwa Israeli, Yoshua akauteka siku ya pili. Yoshua akauangamiza mji na kila kilichokuwa ndani yake kwa upanga, kama tu vile alivyokuwa ameufanyia mji wa Libna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo huo, Horamu mfalme wa Gezeri alikuwa amepanda ili kusaidia Lakishi, lakini Yoshua akamshinda pamoja na jeshi lake, hadi hapakubakia mtu yeyote.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akaondoka Lakishi kwenda Egloni akiwa pamoja na Israeli yote; wakajipanga dhidi yake na kuushambulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakauteka mji huo siku ile ile, wakaupiga kwa upanga na kumwangamiza kila mmoja aliyekuwa ndani yake, kama vile walivyokuwa wameufanyia Lakishi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yoshua akapanda kutoka Egloni kwenda Hebroni akiwa pamoja na Israeli yote na kuushambulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakauteka mji na kuupiga kwa upanga, pamoja na mfalme wake, vijiji vyake na kila mmoja aliyekuwa ndani yake. Hawakubakiza mtu yeyote. Kama vile huko Egloni, waliuangamiza kabisa pamoja na kila mmoja aliyekuwa ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua na Israeli wote wakageuka na kuushambulia Debiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakauteka mji, mfalme wake na vijiji vyake, na kuupiga kwa upanga. Kila mmoja aliyekuwa ndani yake wakamwangamiza kabisa. Hawakubakiza mtu yeyote. Wakaufanyia Debiri na mfalme wake kama vile walivyokuwa wameifanyia miji ya Libna na Hebroni na wafalme wao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yoshua akalishinda eneo hilo lote, ikiwa ni pamoja na nchi ya vilima, na Negebu, na sehemu ya magharibi chini ya vilima, materemko ya milima, pamoja na wafalme wake wote. Hakubakiza mtu yeyote. Akaangamiza kabisa kila kitu chenye pumzi, kama vile",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.40",
                "verseOrgIds": [
                  "JOS.10.40"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, alivyokuwa ameamuru.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akawashinda kuanzia Kadesh-Barnea hadi Gaza na kutoka eneo lote la Gosheni hadi Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafalme hawa wote pamoja na nchi zao Yoshua aliwashinda kwa wakati mmoja, kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.42",
                "verseOrgIds": [
                  "JOS.10.42"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, aliwapigania Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akarudi pamoja na Israeli yote kwenye kambi huko Gilgali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
      ]
    }
