  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgawanyo Wa Nchi Magharibi Mwa Yordani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi haya ndiyo maeneo Waisraeli waliyopokea kama urithi katika nchi ya Kanaani, ambayo kuhani Eleazari, Yoshua mwana wa Nuni na viongozi wa koo za kabila za Israeli waliwagawia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urithi wao uligawanywa kwa kura kwa yale makabila tisa na nusu, kama",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.2",
                "verseOrgIds": [
                  "JOS.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyoamuru Mose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alikuwa amewapa yale makabila mawili na nusu urithi wao upande wa mashariki mwa Yordani, lakini Walawi hawakupewa urithi miongoni mwa hao wengine,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa wana wa Yosefu walikuwa makabila mawili; Manase na Efraimu. Walawi hawakupata mgawo wa ardhi, bali walipewa miji tu kwa ajili ya kuishi, pamoja na maeneo ya malisho kwa ajili ya makundi yao ya kondoo, mbuzi na ngʼombe wao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Waisraeli wakagawana ile nchi, kama vile",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.5",
                "verseOrgIds": [
                  "JOS.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyomwagiza Mose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalebu Anapewa Mji Wa Hebroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wa Yuda wakamwendea Yoshua huko Gilgali, naye Kalebu mwana wa Yefune yule Mkenizi, akamwambia, \"Unajua jambo ambalo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.6",
                "verseOrgIds": [
                  "JOS.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "alimwambia Mose mtu wa Mungu huko Kadesh-Barnea kukuhusu wewe na mimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilikuwa na umri wa miaka arobaini, wakati Mose mtumishi wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.7",
                "verseOrgIds": [
                  "JOS.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", aliponituma kutoka Kadesh-Barnea kuipeleleza hiyo nchi. Nami nikamletea taarifa kama kulingana na nilivyosadiki moyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ndugu zangu tuliopanda nao waliifanya mioyo ya watu iyeyuke kwa hofu. Bali mimi, nilimfuata",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.8",
                "verseOrgIds": [
                  "JOS.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wangu kwa moyo wote.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo katika siku ile, Mose akaniapia, 'Nchi ambayo umeikanyaga kwa miguu yako itakuwa urithi wako na wa watoto wako milele, kwa sababu umemfuata",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.9",
                "verseOrgIds": [
                  "JOS.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wangu kwa moyo wote.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sasa basi, kama vile",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.10",
                "verseOrgIds": [
                  "JOS.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyoahidi, ameniweka hai kwa miaka arobaini na mitano tangu wakati alipomwambia Mose jambo hili, wakati Waisraeli wakiwa wanazunguka jangwani. Hivyo mimi hapa leo, nina umri wa miaka themanini na mitano!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bado ninazo nguvu kama siku ile Mose aliponituma. Bado ninazo nguvu za kwenda vitani sasa kama vile nilivyokuwa wakati ule.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nipe nchi hii ya vilima, ambayo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.12",
                "verseOrgIds": [
                  "JOS.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "aliniahidi siku ile. Wewe mwenyewe ulisikia wakati ule kwamba Waanaki walikuwako huko na miji yao ilikuwa mikubwa na yenye maboma, lakini, kwa msaada wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.12",
                "verseOrgIds": [
                  "JOS.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", nitawafukuza watoke huko kama vile alivyonena.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua akambariki Kalebu mwana wa Yefune, na akampa Hebroni kama urithi wake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Hebroni imekuwa mali ya Kalebu mwana wa Yefune Mkenizi tangu wakati ule, kwa sababu alimwandama",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.14.14",
                "verseOrgIds": [
                  "JOS.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, kwa moyo wote.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Hebroni uliitwa Kiriath-Arba hapo mwanzo, kutokana na huyo Arba ambaye alikuwa mtu mkuu kupita wote miongoni mwa Waanaki.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 14:15"
      },
      "items": [
        {
          "text": "Kisha nchi ikawa na amani bila vita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
