              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watu wakamwambia Yoshua, \"Tutamtumikia",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.24",
                "verseOrgIds": [
                  "JOS.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu na kumtii yeye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile Yoshua akafanya agano kwa ajili ya watu na hapo Shekemu ndipo alipowaandikia amri na sheria.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.25",
            "verseOrgIds": [
              "JOS.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoshua akayaandika mambo haya katika Kitabu cha Sheria ya Mungu. Ndipo akalitwaa jiwe kubwa, akalisimamisha huko chini ya mwaloni, karibu na mahali patakatifu pa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.26",
            "verseOrgIds": [
              "JOS.24.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.26",
                "verseOrgIds": [
                  "JOS.24.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.26",
            "verseOrgIds": [
              "JOS.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akawaambia watu wote, \"Angalieni! Jiwe hili litakuwa shahidi juu yetu. Limesikia maneno yote",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.27",
                "verseOrgIds": [
                  "JOS.24.27"
                ]
              }
            }
          ]
        },
        {
          "text": "aliyotuambia. Litakuwa shahidi juu yenu kama mtakuwa waongo kwa Mungu wenu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuzikwa Katika Nchi Ya Ahadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoshua akawatuma watu kila mmoja aende katika urithi wake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya mambo haya, Yoshua mwana wa Nuni, mtumishi wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.29",
                "verseOrgIds": [
                  "JOS.24.29"
                ]
              }
            }
          ]
        },
        {
          "text": "akafa akiwa na umri wa miaka mia moja na kumi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wakamzika katika nchi ya urithi wake, huko Timnath-Sera",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
        {
          "text": "katika nchi ya vilima ya Efraimu, kaskazini ya Mlima wa Gaashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
