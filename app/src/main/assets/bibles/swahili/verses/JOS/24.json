        },
        {
          "text": "Israeli wakamtumikia",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.31",
                "verseOrgIds": [
                  "JOS.24.31"
                ]
              }
            }
          ]
        },
        {
          "text": "siku zote za maisha ya Yoshua, na za hao wazee walioishi baada ya Yoshua kufa, ambao waliona kila kitu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.31",
                "verseOrgIds": [
                  "JOS.24.31"
                ]
              }
            }
          ]
        },
        {
          "text": "alichowatendea Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo ile mifupa ya Yosefu, ambayo Waisraeli waliipandisha kutoka huko Misri, wakaizika huko Shekemu kwenye eneo, ambalo Yakobo alilinunua kwa wana wa Hamori baba yake Shekemu, kwa vipande mia vya fedha. Eneo hili likawa ni urithi wa uzao wa Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Eleazari mwana wa Aroni akafariki akazikwa huko Gibea, mlima aliokuwa amepewa mtoto wake Finehasi, kwenye nchi ya vilima ya Efraimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
            "verseOrgIds": [
              "JOS.24.33"
            ]
          }
        }
      ]
