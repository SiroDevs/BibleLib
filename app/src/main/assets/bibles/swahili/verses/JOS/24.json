                "verseOrgIds": [
                  "JOS.24.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        }
