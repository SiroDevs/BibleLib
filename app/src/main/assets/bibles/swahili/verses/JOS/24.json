      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 24:22"
      },
      "items": [
        {
          "text": "Nao wakajibu, \"Ndiyo, tu mashahidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akawaambia, \"Sasa basi, itupeni mbali hiyo miungu migeni iliyo katikati yenu, nanyi mtoleeni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.23",
                "verseOrgIds": [
                  "JOS.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, mioyo yenu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
