          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeriko Yatekwa Na Kuangamizwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi malango ya Yeriko yalifungwa kwa uthabiti kwa ajili ya Waisraeli. Hakuna mtu yeyote aliyetoka au kuingia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.1",
            "verseOrgIds": [
              "JOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.2",
                "verseOrgIds": [
                  "JOS.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Yoshua, \"Tazama, nimeitia Yeriko mikononi mwako, pamoja na mfalme wake na watu wake wa vita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zunguka mji mara moja pamoja na watu wote wenye silaha. Fanya hivi kwa siku sita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe na makuhani saba wakibeba mabaragumu ya pembe za kondoo dume mbele ya Sanduku. Siku ya saba, mzunguke mji mara saba, nao makuhani wakipiga baragumu hizo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utakapowasikia wamepaliza sauti kubwa ya baragumu, watu wote wapige kelele kwa sauti kuu, kisha ukuta wa mji utaanguka na watu watapanda, kila mtu akiendelea mbele.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoshua mwana wa Nuni akaita makuhani na kuwaambia, \"Chukueni Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.6",
                "verseOrgIds": [
                  "JOS.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na makuhani saba wachukue baragumu za pembe za kondoo dume mbele yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akawaagiza watu, \"Songeni mbele! Mkauzunguke mji, na walinzi wenye silaha watangulie mbele ya Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.7",
                "verseOrgIds": [
                  "JOS.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Yoshua kuzungumza na watu, wale makuhani saba wenye kuzibeba zile baragumu saba mbele za",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.8",
                "verseOrgIds": [
                  "JOS.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", wakatangulia mbele, wakipiga baragumu zao na Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.8",
                "verseOrgIds": [
                  "JOS.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "likawafuata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walinzi waliokuwa na silaha wakaenda mbele ya hao makuhani waliopiga hizo baragumu na hao walinzi wa nyuma wakafuata Sanduku. Wakati wote huu baragumu zilikuwa zikipigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali Yoshua alikuwa amewaagiza watu, \"Msipige kelele ya vita, msipaze sauti zenu, wala kusema neno lolote mpaka siku ile nitakayowaambia mpige kelele. Ndipo mtapiga kelele!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akalipeleka Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.11",
                "verseOrgIds": [
                  "JOS.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kuzungushwa huo mji, likizungushwa mara moja. Kisha watu wakarudi kambini kulala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akaamka mapema asubuhi iliyofuata nao makuhani wakalichukua Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.12",
                "verseOrgIds": [
                  "JOS.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale Makuhani saba wakizibeba zile baragumu saba wakatangulia mbele ya Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.13",
                "verseOrgIds": [
                  "JOS.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wakizipiga. Watu wenye silaha wakatangulia mbele yao na walinzi wa nyuma wakalifuata Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.13",
                "verseOrgIds": [
                  "JOS.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", huku baragumu hizo zikiendelea kulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya pili wakauzunguka mji mara moja na kurudi kambini. Wakafanya hivi kwa siku sita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.14",
            "verseOrgIds": [
              "JOS.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya saba, wakaamka asubuhi na mapema wakauzunguka mji kama walivyokuwa wakifanya, isipokuwa siku ile waliuzunguka mji mara saba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.15",
            "verseOrgIds": [
              "JOS.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipouzunguka mara ya saba, makuhani walipopiga baragumu kwa sauti kubwa, Yoshua akawaamuru watu akisema, \"Pigeni kelele! Kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
            "verseOrgIds": [
              "JOS.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.16",
                "verseOrgIds": [
                  "JOS.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "amewapa mji huu!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
            "verseOrgIds": [
              "JOS.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mji huu pamoja na vyote vilivyomo ndani yake utawekwa wakfu kwa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.17",
                "verseOrgIds": [
                  "JOS.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ila Rahabu tu, yule kahaba na wote ambao wako pamoja naye nyumbani mwake ndio watakaosalimishwa, kwa sababu aliwaficha wale wapelelezi tuliowatuma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mjiepushe na vitu vilivyowekwa wakfu, msije mkachukua chochote katika hivyo, msije mkajiletea maangamizi katika maskani ya Israeli na kuiletea taabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.18",
            "verseOrgIds": [
              "JOS.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedha yote na dhahabu, vyombo vya shaba na chuma ni vitakatifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.19",
                "verseOrgIds": [
                  "JOS.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", lazima viletwe katika hazina yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati baragumu zilipopigwa, watu walipiga kelele, na katika sauti ya baragumu, na watu kupaza sauti, ukuta ukaanguka; hivyo kila mtu akapanda akiendelea mbele na kuuteka mji.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakauweka mji wakfu kwa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.21",
                "verseOrgIds": [
                  "JOS.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", na kila chenye uhai ndani yake walikiangamiza kwa upanga, wanaume kwa wanawake, vijana kwa wazee, ngʼombe, kondoo na punda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
