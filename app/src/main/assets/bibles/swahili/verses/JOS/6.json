                "verseOrgIds": [
                  "JOS.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mtu atakayeinuka kuujenga tena mji huu wa Yeriko:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
