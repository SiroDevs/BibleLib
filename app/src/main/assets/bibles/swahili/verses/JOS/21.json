          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoka kabila la Reubeni walipewa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 21:36"
      },
      "items": [
        {
          "text": "Bezeri, Yahasa,",
