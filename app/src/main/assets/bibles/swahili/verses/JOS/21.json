          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koo za Wamerari (Walawi waliobaki) walipewa:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.34",
            "verseOrgIds": [
              "JOS.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 21:34"
      },
      "items": [
        {
          "text": "kutoka kabila la Zabuloni,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 21:34"
      },
      "items": [
        {
          "text": "Yokneamu, Karta,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimna na Nahalali, pamoja na sehemu zake za malisho, ilikuwa miji minne;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
