          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.43",
                "verseOrgIds": [
                  "JOS.21.43"
                ]
              }
            }
          ]
        },
        {
          "text": "akawapa Israeli nchi yote aliyokuwa ameapa kuwapa baba zao, nao wakaimiliki na kukaa humo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.44",
                "verseOrgIds": [
                  "JOS.21.44"
                ]
              }
            }
          ]
        },
        {
          "text": "akawapa pumziko kila upande, kama vile alivyokuwa amewaapia baba zao, hakuna hata mmoja wa adui zao aliyeweza kusimama mbele yao,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.44",
                "verseOrgIds": [
                  "JOS.21.44"
                ]
              }
            }
          ]
        },
        {
          "text": "akawatia adui zao wote mikononi mwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna hata mojawapo ya ahadi nzuri ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.45",
                "verseOrgIds": [
                  "JOS.21.45"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa nyumba ya Israeli ambayo haikutimia; kila moja ilitimia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
