          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa kabila la Walawi, Mose hakuwapa urithi;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.33",
            "verseOrgIds": [
              "JOS.13.33"
            ]
          }
        },
