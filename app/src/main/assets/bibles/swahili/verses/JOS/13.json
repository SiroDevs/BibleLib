          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huu ndio urithi alioupeana Mose wakati alipokuwa katika tambarare za Moabu, ngʼambo ya Yordani mashariki mwa Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
