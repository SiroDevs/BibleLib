          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo maeneo ambayo Mose alikuwa amewapa hiyo nusu ya kabila la Manase, yaani kwa nusu ya jamaa ya uzao wa Manase, ukoo kwa ukoo:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        }
