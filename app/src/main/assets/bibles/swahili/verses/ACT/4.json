  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ACT 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Na Yohana Mbele Ya Baraza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Petro na Yohana walipokuwa wakisema na watu, makuhani, mkuu wa walinzi wa Hekalu na Masadukayo wakawajia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.1",
            "verseOrgIds": [
              "ACT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "huku wakiwa wamekasirika sana kwa sababu mitume walikuwa wanawafundisha watu na kuhubiri kwamba kuna ufufuo wa wafu ndani ya Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.2",
            "verseOrgIds": [
              "ACT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawakamata Petro na Yohana na kuwatia gerezani mpaka kesho yake kwa kuwa ilikuwa jioni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.3",
            "verseOrgIds": [
              "ACT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wengi waliosikia lile neno waliamini, idadi yao ilikuwa yapata wanaume 5,000.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.4",
            "verseOrgIds": [
              "ACT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesho yake, viongozi wa Kiyahudi, wazee na walimu wa sheria wakakusanyika Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.5",
            "verseOrgIds": [
              "ACT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walikuwepo kuhani mkuu Anasi, Kayafa, Yohana, Iskanda, na wengi wa jamaa ya kuhani mkuu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.6",
            "verseOrgIds": [
              "ACT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kuwasimamisha Petro na Yohana katikati yao, wakawauliza, \"Ni kwa uwezo gani au kwa jina la nani mmefanya jambo hili?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.7",
            "verseOrgIds": [
              "ACT.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro, akiwa amejaa Roho Mtakatifu, akajibu, \"Enyi watawala na wazee wa watu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.8",
            "verseOrgIds": [
              "ACT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama leo tukihojiwa kwa habari ya mambo mema aliyotendewa yule kiwete na kuulizwa jinsi alivyoponywa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.9",
            "verseOrgIds": [
              "ACT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijulikane kwenu nyote na kwa watu wote wa Israeli kwamba: Ni kwa jina la Yesu Kristo wa Nazareti, ambaye ninyi mlimsulubisha lakini Mungu akamfufua kutoka kwa wafu, kwa jina hilo mtu huyu anasimama mbele yenu akiwa mzima kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.10",
            "verseOrgIds": [
              "ACT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyu ndiye",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 4:11"
      },
      "items": [
        {
          "text": "\" 'jiwe ambalo ninyi wajenzi mlilikataa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 4:11"
      },
      "items": [
        {
          "text": "ambalo limekuwa jiwe kuu la pembeni.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.11",
            "verseOrgIds": [
              "ACT.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala hakuna wokovu katika mwingine awaye yote, kwa maana hakuna jina jingine chini ya mbingu walilopewa wanadamu litupasalo sisi kuokolewa kwalo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.12",
            "verseOrgIds": [
              "ACT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ujasiri Wa Petro Na Yohana Washangaza Watu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale viongozi na wazee walipoona ujasiri wa Petro na Yohana na kujua ya kuwa walikuwa watu wa kawaida, wasio na elimu, walishangaa sana, wakatambua kwamba hawa watu walikuwa na Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.13",
            "verseOrgIds": [
              "ACT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa kuwa walikuwa wanamwona yule kiwete aliyeponywa amesimama pale pamoja nao, hawakuweza kusema lolote kuwapinga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.14",
            "verseOrgIds": [
              "ACT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawaamuru watoke nje ya Baraza la Wayahudi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.15",
            "verseOrgIds": [
              "ACT.4.15"
            ]
          }
        },
        {
          "text": "wakati wakisemezana jambo hilo wao kwa wao.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.15",
            "verseOrgIds": [
              "ACT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaulizana, \"Tuwafanyie nini watu hawa? Hatuwezi kukanusha muujiza huu mkubwa walioufanya ambao ni dhahiri kwa kila mtu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.16",
            "verseOrgIds": [
              "ACT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ili kuzuia jambo hili lisiendelee kuenea zaidi kwa watu, ni lazima tuwaonye watu hawa ili wasiseme tena na mtu yeyote kwa jina la Yesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.17",
            "verseOrgIds": [
              "ACT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakawaita tena ndani na kuwaamuru wasiseme wala kufundisha kamwe kwa hili jina la Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.18",
            "verseOrgIds": [
              "ACT.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imetupasa Kumtii Mungu Kuliko Wanadamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Petro na Yohana wakajibu, \"Amueni ninyi wenyewe iwapo ni haki mbele za Mungu kuwatii ninyi kuliko kumtii Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.19",
            "verseOrgIds": [
              "ACT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sisi hatuwezi kuacha kusema yale tuliyoyaona na kuyasikia.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.20",
            "verseOrgIds": [
              "ACT.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya vitisho vingi, wakawaacha waende zao. Hawakuona njia yoyote ya kuwaadhibu, kwa sababu ya watu, kwa kuwa watu wote walikuwa wakimsifu Mungu kwa kile kilichokuwa kimetukia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.21",
            "verseOrgIds": [
              "ACT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa umri wa yule mtu aliyekuwa ameponywa kwa muujiza ulikuwa zaidi ya miaka arobaini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.22",
            "verseOrgIds": [
              "ACT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Ya Waumini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Punde Petro na Yohana walipoachiliwa, walirudi kwa waumini wenzao wakawaeleza waliyoambiwa na viongozi wa makuhani na wazee.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.23",
            "verseOrgIds": [
              "ACT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu waliposikia hayo, wakainua sauti zao, wakamwomba Mungu kwa pamoja, wakisema, \"Bwana Mwenyezi, uliyeziumba mbingu na nchi na bahari, na vitu vyote vilivyomo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.24",
            "verseOrgIds": [
              "ACT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe ulisema kwa Roho Mtakatifu kupitia kwa kinywa cha baba yetu Daudi, mtumishi wako, ukasema:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.25",
            "verseOrgIds": [
              "ACT.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 4:25"
      },
      "items": [
        {
          "text": "\" 'Mbona mataifa wanaghadhibika,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.25",
            "verseOrgIds": [
              "ACT.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 4:25"
      },
      "items": [
        {
          "text": "na kabila za watu zinawaza ubatili?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.25",
            "verseOrgIds": [
              "ACT.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafalme wa dunia wamejipanga,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.26",
            "verseOrgIds": [
              "ACT.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 4:26"
      },
      "items": [
        {
          "text": "na watawala wanakusanyika pamoja",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.26",
            "verseOrgIds": [
              "ACT.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 4:26"
      },
      "items": [
        {
          "text": "dhidi ya Bwana",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.26",
            "verseOrgIds": [
              "ACT.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 4:26"
      },
      "items": [
        {
          "text": "na dhidi ya Mpakwa Mafuta wake.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.26",
            "verseOrgIds": [
              "ACT.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kweli Herode na Pontio Pilato pamoja na watu wa Mataifa na Waisraeli, walikusanyika katika mji huu dhidi ya mwanao mtakatifu Yesu uliyemtia mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.27",
            "verseOrgIds": [
              "ACT.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao wakafanya yale ambayo uweza wako na mapenzi yako yalikuwa yamekusudia yatokee tangu zamani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.28",
            "verseOrgIds": [
              "ACT.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa, Bwana angalia vitisho vyao na utuwezeshe sisi watumishi wako kulinena neno lako kwa ujasiri mkuu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.29",
            "verseOrgIds": [
              "ACT.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyoosha mkono wako ili kuponya wagonjwa na kutenda ishara na miujiza kwa jina la Mwanao mtakatifu Yesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.30",
            "verseOrgIds": [
              "ACT.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokwisha kuomba, mahali walipokuwa wamekutanika pakatikiswa, wote wakajazwa na Roho Mtakatifu, wakanena neno la Mungu kwa ujasiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.31",
            "verseOrgIds": [
              "ACT.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Walioamini Washirikiana Mali Zao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale walioamini wote walikuwa na moyo mmoja na nia moja. Wala hakuna hata mmoja aliyesema chochote alichokuwa nacho ni mali yake mwenyewe, lakini walishirikiana kila kitu walichokuwa nacho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitume wakatoa ushuhuda wa kufufuka kwa Bwana Yesu kwa nguvu nyingi na neema ya Mungu ilikuwa juu yao wote.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala hapakuwepo mtu yeyote miongoni mwao aliyekuwa mhitaji, kwa sababu mara kwa mara wale waliokuwa na mashamba na nyumba waliviuza, wakaleta thamani ya vitu vilivyouzwa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakaiweka miguuni pa mitume, kila mtu akagawiwa kadiri ya mahitaji yake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
            "verseOrgIds": [
              "ACT.4.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu, Mlawi kutoka Kipro, ambaye mitume walimwita Barnaba (maana yake Mwana wa Faraja),",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
            "verseOrgIds": [
              "ACT.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "aliuza shamba alilokuwa nalo, akaleta hizo fedha alizopata na kuziweka miguuni pa mitume.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.37",
            "verseOrgIds": [
              "ACT.4.37"
            ]
          }
        }
      ]
    }
