          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili achukue nafasi ya huduma ya utume ambayo Yuda aliiacha ili aende mahali pake mwenyewe.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
