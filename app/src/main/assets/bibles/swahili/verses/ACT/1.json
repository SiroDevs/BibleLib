          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakawapigia kura, nayo kura ikamwangukia Mathiya, naye akaongezwa kwenye wale mitume kumi na mmoja.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
