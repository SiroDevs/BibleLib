            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakaomba, wakasema, \"Bwana, wewe waujua moyo wa kila mtu. Tuonyeshe ni yupi kati ya hawa wawili uliyemchagua",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
