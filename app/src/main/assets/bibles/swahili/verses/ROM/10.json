  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ROM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndugu zangu, shauku ya moyo wangu na maombi yangu kwa Mungu ni kwa ajili ya Waisraeli, kwamba waokolewe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.1",
            "verseOrgIds": [
              "ROM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ninaweza nikashuhudia wazi kwamba wao wana juhudi kubwa kwa ajili ya Mungu, lakini juhudi yao haina maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.2",
            "verseOrgIds": [
              "ROM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hawakuijua haki itokayo kwa Mungu, wakatafuta kuweka haki yao wenyewe, hawakujitia chini ya haki ya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.3",
            "verseOrgIds": [
              "ROM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana Kristo ni ukomo wa sheria ili kuwe na haki kwa kila mtu aaminiye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wokovu Ni Kwa Ajili Ya Wote",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anaandika kuhusu haki ile itokanayo na sheria, kwamba, \"Mtu atendaye matendo hayo ataishi kwa hayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ile haki itokanayo na imani husema hivi: \"Usiseme moyoni mwako, 'Ni nani atakayepanda mbinguni?' \" (yaani ili kumleta Kristo chini)",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"au 'Ni nani atashuka kwenda kuzimu?' \" (yaani ili kumleta Kristo kutoka kwa wafu.)",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.7",
            "verseOrgIds": [
              "ROM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini andiko lasemaje? \"Lile neno liko karibu nawe, liko kinywani mwako na moyoni mwako,\" yaani, lile neno la imani tunalolihubiri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.8",
            "verseOrgIds": [
              "ROM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu kama ukikiri kwa kinywa chako kwamba \"Yesu ni Bwana,\" na kuamini moyoni mwako kwamba Mungu alimfufua kutoka kwa wafu, utaokoka.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.9",
            "verseOrgIds": [
              "ROM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana kwa moyo mtu huamini na hivyo kuhesabiwa haki, tena kwa kinywa mtu hukiri na hivyo kupata wokovu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.10",
            "verseOrgIds": [
              "ROM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama yasemavyo Maandiko, \"Yeyote amwaminiye hataaibika kamwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.11",
            "verseOrgIds": [
              "ROM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana hakuna tofauti kati ya Myahudi na Myunani, yeye ni Bwana wa wote, mwenye utajiri kwa wote wamwitao.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.12",
            "verseOrgIds": [
              "ROM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana, \"Kila mtu atakayeliitia Jina la Bwana, ataokolewa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watamwitaje yeye ambaye hawajamwamini? Nao watawezaje kumwamini yeye ambaye hawajamsikia? Tena watamsikiaje bila mtu kuwahubiria?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.14",
            "verseOrgIds": [
              "ROM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watahubirije wasipopelekwa? Kama ilivyoandikwa, \"Tazama jinsi ilivyo mizuri miguu yao wale wanaohubiri habari njema!\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini si wote waliotii Habari Njema. Kwa maana Isaya asema, \"Bwana, ni nani aliyeamini ujumbe wetu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, imani chanzo chake ni kusikia, na kusikia huja kwa neno la Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini nauliza: Je, wao hawakusikia? Naam, wamesikia, kwa maana:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 10:18"
      },
      "items": [
        {
          "text": "\"Sauti yao imeenea duniani pote,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:18"
      },
      "items": [
        {
          "text": "nayo maneno yao yameenea",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:18"
      },
      "items": [
        {
          "text": "hadi miisho ya ulimwengu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nauliza tena: Je, Waisraeli hawakuelewa? Kwanza, Mose asema,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 10:19"
      },
      "items": [
        {
          "text": "\"Nitawafanya mwe na wivu",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:19"
      },
      "items": [
        {
          "text": "kwa watu wale ambao si taifa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 10:19"
      },
      "items": [
        {
          "text": "Nitawakasirisha kwa taifa",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:19"
      },
      "items": [
        {
          "text": "lile lisilo na ufahamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.19",
            "verseOrgIds": [
              "ROM.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Isaya kwa ujasiri mwingi anasema,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.20",
            "verseOrgIds": [
              "ROM.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 10:20"
      },
      "items": [
        {
          "text": "\"Nimeonekana na watu wale ambao hawakunitafuta.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.20",
            "verseOrgIds": [
              "ROM.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:20"
      },
      "items": [
        {
          "text": "Nilijifunua kwa watu",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.20",
            "verseOrgIds": [
              "ROM.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:20"
      },
      "items": [
        {
          "text": "wale ambao hawakunitafuta.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.20",
            "verseOrgIds": [
              "ROM.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kuhusu Israeli anasema,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.21",
            "verseOrgIds": [
              "ROM.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 10:21"
      },
      "items": [
        {
          "text": "\"Mchana kutwa nimewanyooshea",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.21",
            "verseOrgIds": [
              "ROM.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 10:21"
      },
      "items": [
        {
          "text": "watu wakaidi na wasiotii mikono yangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.21",
            "verseOrgIds": [
              "ROM.10.21"
            ]
          }
        }
      ]
    }
  ],
