            "sid": "ROM 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini? Kwa sababu hawakuitafuta kwa njia ya imani bali kwa njia ya matendo. Wakajikwaa kwenye lile \"jiwe la kukwaza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
            "verseOrgIds": [
              "ROM.9.32"
            ]
          }
        },
