          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo tuseme nini basi? Kwamba watu wa Mataifa ambao hawakutafuta haki, wamepata haki ile iliyo kwa njia ya imani.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.30",
            "verseOrgIds": [
