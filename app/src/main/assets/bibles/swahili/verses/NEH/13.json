              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia nilihakikisha kwamba matoleo ya kuni yaliletwa kwa wakati unaopaswa, na malimbuko kwa wakati wake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
