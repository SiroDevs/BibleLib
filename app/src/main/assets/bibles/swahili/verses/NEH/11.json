              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika En-Rimoni, katika Sora, katika Yarmuthi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
        {
          "name": "verse",
