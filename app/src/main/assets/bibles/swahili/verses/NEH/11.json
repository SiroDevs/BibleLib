              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika Siklagi, katika Mekona na makazi yake,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
            ]
