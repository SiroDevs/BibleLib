          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoa, Adulamu na vijiji vyake, katika Lakishi na mashamba yake, na katika Azeka na makazi yake. Hivyo walikuwa wakiishi kuanzia Beer-Sheba mpaka Bonde la Hinomu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        }
