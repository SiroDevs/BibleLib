      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "kwa sababu mna nguvu,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "na neno la Mungu linakaa ndani yenu,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
