      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "yeye aliye tangu mwanzo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "Nawaandikia ninyi vijana",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "kwa sababu mmemshinda yule mwovu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "Nawaandikia ninyi watoto wadogo,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:13"
      },
      "items": [
        {
          "text": "kwa sababu mmemjua Baba.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        }
      ]
    },
