  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Wanawali Kumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wakati huo, Ufalme wa Mbinguni utakuwa kama wanawali kumi waliochukua taa zao na kwenda kumlaki bwana arusi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.1",
                "verseOrgIds": [
                  "MAT.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Watano wao walikuwa wapumbavu na watano walikuwa wenye busara.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.2",
                "verseOrgIds": [
                  "MAT.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wale wapumbavu walichukua taa zao lakini hawakuchukua mafuta ya akiba,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.3",
                "verseOrgIds": [
                  "MAT.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "lakini wale wenye busara walichukua taa zao na mafuta ya akiba kwenye vyombo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.4",
                "verseOrgIds": [
                  "MAT.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwana arusi alipokawia kuja wale wanawali wote wakasinzia na kulala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.5",
                "verseOrgIds": [
                  "MAT.25.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Usiku wa manane pakawa na kelele: 'Tazameni, huyu hapa bwana arusi! Tokeni nje mkamlaki!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.6",
                "verseOrgIds": [
                  "MAT.25.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo wale wanawali wote wakaamka na kuzitengeneza taa zao.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.7",
                "verseOrgIds": [
                  "MAT.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wale wapumbavu wakawaambia wale wenye busara, 'Tupatieni mafuta yenu kidogo; taa zetu zinazimika.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.8",
                "verseOrgIds": [
                  "MAT.25.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini wale wenye busara wakawajibu, 'Sivyo, hayatutoshi sisi na ninyi pia. Afadhali mwende kwa wauzao mkajinunulie mafuta yenu.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.9",
                "verseOrgIds": [
                  "MAT.25.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nao walipokuwa wakienda kununua mafuta, bwana arusi akafika. Wale wanawali waliokuwa tayari wakaingia ndani pamoja naye kwenye karamu ya arusi na mlango ukafungwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.10",
                "verseOrgIds": [
                  "MAT.25.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Baadaye wale wanawali wengine nao wakaja, wakaita, 'Bwana! Bwana! Tufungulie mlango!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.11",
                "verseOrgIds": [
                  "MAT.25.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini yeye bwana arusi akawajibu, 'Amin, amin nawaambia, siwajui ninyi!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.12",
                "verseOrgIds": [
                  "MAT.25.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa hiyo kesheni, kwa sababu hamjui siku wala saa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.13",
                "verseOrgIds": [
                  "MAT.25.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Watumishi Watatu Na Talanta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.19.11-LUK.19.27"
          },
          "items": [
            {
              "text": "Luka 19:11-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tena, Ufalme wa Mbinguni ni kama mtu aliyetaka kusafiri, naye akawaita watumishi wake na kuweka mali yake kwenye uangalizi wao.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.14",
                "verseOrgIds": [
                  "MAT.25.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmoja akampa talanta",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.15",
                "verseOrgIds": [
                  "MAT.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "tano, mwingine talanta mbili, na mwingine talanta moja. Kila mmoja alipewa kwa kadiri ya uwezo wake. Kisha yeye akasafiri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.15",
                "verseOrgIds": [
                  "MAT.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yule aliyepewa talanta tano akaenda mara moja akafanya nazo biashara akapata talanta nyingine tano zaidi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.16",
                "verseOrgIds": [
                  "MAT.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yule aliyepewa talanta mbili akafanya vivyo hivyo, akapata nyingine mbili zaidi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.17",
                "verseOrgIds": [
                  "MAT.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini yule mtumishi aliyekuwa amepokea talanta moja, alikwenda akachimba shimo ardhini na kuificha ile fedha ya bwana wake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.18",
                "verseOrgIds": [
                  "MAT.25.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Baada ya muda mrefu, yule bwana wa wale watumishi akarudi na kufanya hesabu nao.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.19",
                "verseOrgIds": [
                  "MAT.25.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yule mtumishi aliyepokea talanta tano akaja, akaleta nyingine tano zaidi. Akasema, 'Bwana uliweka kwenye uangalizi wangu talanta tano. Tazama, nimepata faida ya talanta tano zaidi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.20",
                "verseOrgIds": [
                  "MAT.25.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwana wake akamwambia, 'Umefanya vizuri sana, mtumishi mwema na mwaminifu! Umekuwa mwaminifu kwa vitu vichache; nami nitakuweka kuwa msimamizi wa vitu vingi. Njoo ushiriki katika furaha ya bwana wako!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.21",
                "verseOrgIds": [
                  "MAT.25.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yule mwenye talanta mbili naye akaja. Akasema, 'Bwana, uliweka kwenye uangalizi wangu talanta mbili. Tazama nimepata hapa talanta mbili zaidi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.22",
                "verseOrgIds": [
                  "MAT.25.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwana wake akajibu, 'Umefanya vizuri sana, mtumishi mwema na mwaminifu. Umekuwa mwaminifu kwa vitu vichache; nami nitakuweka kuwa msimamizi wa vitu vingi. Njoo ushiriki katika furaha ya bwana wako!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.23",
                "verseOrgIds": [
                  "MAT.25.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kisha yule mtumishi aliyepokea talanta moja akaja, akasema, 'Bwana, nilijua kwamba wewe ni mtu mgumu, unayevuna mahali usipopanda na kukusanya mahali usipotawanya mbegu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.24",
                "verseOrgIds": [
                  "MAT.25.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa hiyo niliogopa, nikaenda, nikaificha talanta yako ardhini. Tazama, hii hapa ile iliyo mali yako.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.25",
                "verseOrgIds": [
                  "MAT.25.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwana wake akajibu, 'Wewe mtumishi mwovu na mvivu! Ulijua kwamba ninavuna mahali nisipopanda na kukusanya mahali nisipotawanya mbegu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.26",
                "verseOrgIds": [
                  "MAT.25.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Vyema basi, ingekupasa kuweka fedha yangu kwa watoa riba, ili nirudipo, nichukue ile iliyo yangu na faida yake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.27",
                "verseOrgIds": [
                  "MAT.25.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Basi mnyangʼanyeni hiyo talanta, mkampe yule mwenye talanta kumi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.28",
                "verseOrgIds": [
                  "MAT.25.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana kila mtu aliye na kitu atapewa zaidi, naye atakuwa navyo tele. Lakini yule asiye na kitu, hata kile alicho nacho atanyangʼanywa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.29",
                "verseOrgIds": [
                  "MAT.25.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nanyi mtupeni huyo mtumishi asiyefaa nje, kwenye giza, mahali ambako kutakuwa na kilio na kusaga meno.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.30",
                "verseOrgIds": [
                  "MAT.25.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kondoo Na Mbuzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwana wa Adamu atakapokuja katika utukufu wake na malaika wote watakatifu pamoja naye, ndipo atakapoketi juu ya kiti cha enzi cha utukufu wake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.31",
                "verseOrgIds": [
                  "MAT.25.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mataifa yote watakusanyika mbele zake, naye atawatenga kama mchungaji anavyotenga kondoo na mbuzi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.32",
                "verseOrgIds": [
                  "MAT.25.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Atawaweka kondoo upande wake wa kuume, na mbuzi upande wake wa kushoto.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.33",
                "verseOrgIds": [
                  "MAT.25.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo Mfalme atawaambia wale walioko upande wake wa kuume, 'Njooni, ninyi mliobarikiwa na Baba yangu; urithini Ufalme ulioandaliwa kwa ajili yenu tangu kuumbwa kwa ulimwengu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.34",
                "verseOrgIds": [
                  "MAT.25.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana nilikuwa na njaa mkanipa chakula, nilikuwa na kiu mkaninywesha, nilikuwa mgeni mkanikaribisha,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.35",
                "verseOrgIds": [
                  "MAT.25.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nilikuwa uchi mkanivika, nilikuwa mgonjwa mkanitunza, nami nilikuwa kifungoni mkaja kunitembelea.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.36",
                "verseOrgIds": [
                  "MAT.25.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo wale wenye haki watakapomjibu, 'Bwana, ni lini tulikuona ukiwa na njaa tukakulisha, au ukiwa na kiu tukakunywesha?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.37",
                "verseOrgIds": [
                  "MAT.25.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lini tulikuona ukiwa mgeni tukakukaribisha, au ukiwa uchi tukakuvika?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.38",
                "verseOrgIds": [
                  "MAT.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tena ni lini tulikuona ukiwa mgonjwa tukakutunza, au ukiwa kifungoni tukakutembelea?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.39",
                "verseOrgIds": [
                  "MAT.25.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye Mfalme atawajibu, 'Amin nawaambia, kwa jinsi mlivyomtendea mmojawapo wa hawa ndugu zangu walio wadogo, mlinitendea mimi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.40",
                "verseOrgIds": [
                  "MAT.25.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kisha atawaambia wale walio upande wake wa kushoto, 'Ondokeni kwangu, ninyi mliolaaniwa, nendeni kwenye moto wa milele ulioandaliwa kwa ajili ya ibilisi na malaika zake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.41",
                "verseOrgIds": [
                  "MAT.25.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana nilikuwa na njaa hamkunipa chakula, nilikuwa na kiu hamkuninywesha,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.42",
                "verseOrgIds": [
                  "MAT.25.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nilikuwa mgeni nanyi hamkunikaribisha, nilikuwa uchi hamkunivika, nilikuwa mgonjwa hamkunitunza, na nilikuwa gerezani nanyi hamkuja kunitembelea.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.43",
                "verseOrgIds": [
                  "MAT.25.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo wao pia watajibu, 'Bwana ni lini tulikuona ukiwa na njaa au kiu, au ukiwa mgeni au uchi, au ukiwa mgonjwa na kifungoni na hatukukuhudumia?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.44",
                "verseOrgIds": [
                  "MAT.25.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
