            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ili kufunga kwenu kusionekane na watu wengine ila Baba yenu aketiye mahali pa siri; naye Baba yenu aonaye sirini atawapa thawabu yenu kwa wazi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
