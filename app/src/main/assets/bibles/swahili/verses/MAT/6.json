        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa sababu mahali hazina yako ilipo, hapo ndipo pia moyo wako utakapokuwa.",
