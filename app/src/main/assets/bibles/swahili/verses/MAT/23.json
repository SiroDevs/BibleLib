        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tazama nyumba yenu imeachwa ukiwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.38",
                "verseOrgIds": [
                  "MAT.23.38"
                ]
              }
            }
          ]
        },
