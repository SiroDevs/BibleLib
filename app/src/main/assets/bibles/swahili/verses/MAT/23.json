          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana nawaambia, hamtaniona tena tangu sasa mpaka mtakaposema, 'Amebarikiwa yeye ajaye kwa Jina la Bwana.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.39",
