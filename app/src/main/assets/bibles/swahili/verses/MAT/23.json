              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ninyi nyoka, ninyi uzao wa nyoka wenye sumu! Mtaiepukaje hukumu ya jehanamu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.33",
                "verseOrgIds": [
                  "MAT.23.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa sababu hii, tazameni, natuma kwenu manabii na wenye hekima na walimu. Baadhi yao mtawaua na kuwasulubisha, na wengine wao mtawapiga mijeledi katika masinagogi yenu na kuwafuatia kutoka mji mmoja hadi mji mwingine.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.34",
                "verseOrgIds": [
                  "MAT.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hivyo ile damu ya wenye haki wote iliyomwagwa hapa duniani, tangu damu ya Abeli, ambaye alikuwa hana hatia, hadi damu ya Zekaria mwana wa Barakia, mliyemuua kati ya patakatifu na madhabahu, itawajia juu yenu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.35",
                "verseOrgIds": [
                  "MAT.23.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amin, nawaambia, haya yote yatakuja juu ya kizazi hiki.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.36",
                "verseOrgIds": [
                  "MAT.23.36"
                ]
              }
            }
