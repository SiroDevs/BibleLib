      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awashutumu Walimu Wa Sheria Na Mafarisayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.12.38-MRK.12.40"
          },
          "items": [
            {
              "text": "Marko 12:38-40",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.11.39-LUK.11.52"
          },
          "items": [
            {
              "text": "Luka 11:39-52",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.20.45-LUK.20.47"
          },
          "items": [
            {
              "text": "20:45-47",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yesu akauambia umati wa watu pamoja na wanafunzi wake:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Walimu wa sheria na Mafarisayo wameketi katika kiti cha Mose,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.2",
                "verseOrgIds": [
                  "MAT.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "hivyo inawapasa kuwatii na kufanya kila kitu wanachowaambia. Lakini msifuate yale wanayotenda, kwa sababu hawatendi yale wanayohubiri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.3",
                "verseOrgIds": [
                  "MAT.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wao hufunga mizigo mikubwa na kuiweka mabegani mwa watu, lakini wao wenyewe hawako radhi hata kuinua kidole ili kuisogeza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.4",
                "verseOrgIds": [
                  "MAT.23.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wao hutenda mambo yao yote ili waonekane na watu. Hupanua vikasha vyao vyenye maandiko ya sheria na kurefusha matamvua ya mavazi yao.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.5",
                "verseOrgIds": [
                  "MAT.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wanapenda kukalia viti vya heshima katika karamu, na vile viti maalum sana katika masinagogi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.6",
                "verseOrgIds": [
                  "MAT.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hupenda kusalimiwa masokoni na kutaka watu wawaite 'Rabi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.7",
                "verseOrgIds": [
                  "MAT.23.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini ninyi msiitwe 'Rabi,' kwa sababu mnaye Bwana mmoja na ninyi nyote ni ndugu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.8",
                "verseOrgIds": [
                  "MAT.23.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nanyi msimwite mtu yeyote 'Baba,' hapa duniani, kwa maana mnaye Baba mmoja, naye yuko mbinguni.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.9",
                "verseOrgIds": [
                  "MAT.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wala msiitwe 'Mwalimu,' kwa maana mnaye mwalimu mmoja tu, ndiye Kristo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.10",
                "verseOrgIds": [
                  "MAT.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yeye aliye mkuu kuliko ninyi nyote miongoni mwenu atakuwa mtumishi wenu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.11",
                "verseOrgIds": [
                  "MAT.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa kuwa yeyote anayejikweza atashushwa, na yeyote anayejinyenyekeza atakwezwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.12",
                "verseOrgIds": [
                  "MAT.23.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini ole wenu, walimu wa sheria na Mafarisayo, enyi wanafiki! Kwa maana mnawafungia watu milango ya Ufalme wa Mbinguni. Ninyi wenyewe hamuingii humo, nao wale wanaotaka kuingia mnawazuia. [",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.13",
                "verseOrgIds": [
                  "MAT.23.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.13",
            "verseOrgIds": [
              "MAT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ole wenu walimu wa sheria na Mafarisayo, enyi wanafiki! Mnakula katika nyumba za wajane, nanyi kwa kujifanya kuwa wema, mnasali sala ndefu. Kwa hiyo hukumu yenu itakuwa kuu zaidi.]",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.14",
                "verseOrgIds": [
                  "MAT.23.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ole wenu walimu wa sheria na Mafarisayo, enyi wanafiki! Ninyi mnasafiri baharini na nchi kavu ili kumfanya mtu mmoja mwongofu, lakini baada ya kumpata, mnamfanya mwana wa jehanamu mara mbili kuliko ninyi!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.15",
                "verseOrgIds": [
                  "MAT.23.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ole wenu, viongozi vipofu! Ninyi mwasema, 'Mtu akiapa kwa Hekalu, kiapo hicho si kitu; lakini mtu akiapa kwa dhahabu ya Hekalu, amefungwa kwa kiapo chake.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.16",
                "verseOrgIds": [
                  "MAT.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi vipofu wapumbavu! Ni kipi kilicho kikuu zaidi: ni ile dhahabu, au ni lile Hekalu linaloifanya hiyo dhahabu kuwa takatifu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.17",
                "verseOrgIds": [
                  "MAT.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pia mnasema, 'Mtu akiapa kwa madhabahu, si kitu; lakini mtu akiapa kwa sadaka iliyo juu ya madhabahu, amefungwa kwa kiapo chake'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.18",
                "verseOrgIds": [
                  "MAT.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninyi vipofu! Ni kipi kikuu zaidi: ni sadaka, au ni madhabahu yanayoifanya hiyo sadaka kuwa takatifu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.19",
                "verseOrgIds": [
                  "MAT.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa hiyo, mtu aapaye kwa madhabahu, huapa kwa hayo madhabahu na vitu vyote vilivyo juu yake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.20",
                "verseOrgIds": [
                  "MAT.23.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mtu aapaye kwa Hekalu, huapa kwa hilo Hekalu na kwa huyo akaaye ndani yake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.21",
                "verseOrgIds": [
                  "MAT.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
