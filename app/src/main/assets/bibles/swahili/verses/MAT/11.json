        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.10.21-LUK.10.22"
          },
          "items": [
            {
              "text": "Luka 10:21-22",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo Yesu alisema,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nakuhimidi Baba, Bwana wa mbingu na nchi, kwa kuwa umewaficha mambo haya wenye hekima na wenye elimu, nawe ukawafunulia watoto wadogo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.25",
                "verseOrgIds": [
                  "MAT.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naam, Baba, kwa kuwa hivyo ndivyo ilivyokupendeza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.26",
                "verseOrgIds": [
                  "MAT.11.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nimekabidhiwa vitu vyote na Baba yangu: Hakuna mtu amjuaye Mwana ila Baba, wala hakuna amjuaye Baba ila Mwana na yeyote ambaye Mwana anapenda kumfunulia.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.27",
                "verseOrgIds": [
                  "MAT.11.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awaita Waliolemewa Na Mizigo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Njooni kwangu, ninyi nyote mnaotaabika na kulemewa na mizigo, nami nitawapumzisha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.28",
                "verseOrgIds": [
                  "MAT.11.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Jifungeni nira yangu, mjifunze kutoka kwangu, kwa maana mimi ni mpole na mnyenyekevu wa moyo, nanyi mtapata raha nafsini mwenu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.29",
                "verseOrgIds": [
                  "MAT.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana nira yangu ni laini na mzigo wangu ni mwepesi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.30",
                "verseOrgIds": [
                  "MAT.11.30"
                ]
              }
            }
          ]
        }
      ]
    }
