        "style": "s1"
      },
      "items": [
        {
          "text": "Onyo Kwa Miji Isiyotubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
