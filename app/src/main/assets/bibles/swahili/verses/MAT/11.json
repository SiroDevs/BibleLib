    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu akaanza kushutumu miji ambamo alifanya miujiza yake mingi kuliko kwingine, kwa maana watu wake hawakutubu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ole wako, Korazini! Ole wako Bethsaida! Kwa maana kama miujiza iliyofanyika kwenu, ingefanyika Tiro na Sidoni, miji hiyo ingekuwa imetubu zamani kwa kuvaa magunia na kujipaka majivu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.21",
                "verseOrgIds": [
                  "MAT.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini nawaambia, itakuwa rahisi zaidi kwa Tiro na Sidoni kustahimili katika siku ya hukumu, kuliko ninyi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.22",
                "verseOrgIds": [
                  "MAT.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nawe Kapernaumu, je, utainuliwa hadi mbinguni? La hasha, utashushwa mpaka kuzimu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.23",
                "verseOrgIds": [
                  "MAT.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Miujiza iliyofanyika kwako ingefanyika huko Sodoma, mji huo ungalikuwepo hadi leo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.23",
                "verseOrgIds": [
                  "MAT.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini nakuambia kwamba, itakuwa rahisi zaidi kwa Sodoma kustahimili katika siku ya hukumu kuliko wewe.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.24",
                "verseOrgIds": [
                  "MAT.11.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hakuna Amjuaye Baba Ila Mwana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
