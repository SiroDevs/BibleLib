              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mvua ikanyesha, mafuriko yakaja, na upepo ukavuma ukaipiga hiyo nyumba. Lakini haikuanguka; kwa sababu msingi wake ulikuwa kwenye mwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.25",
                "verseOrgIds": [
                  "MAT.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.25",
            "verseOrgIds": [
              "MAT.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye kila anayesikia haya maneno yangu wala asiyatende, ni kama mtu mjinga aliyejenga nyumba yake kwenye mchanga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.26",
                "verseOrgIds": [
                  "MAT.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mvua ikanyesha, mafuriko yakaja, nao upepo ukavuma ukaipiga hiyo nyumba, nayo ikaanguka kwa kishindo kikubwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.27",
                "verseOrgIds": [
                  "MAT.7.27"
                ]
              }
