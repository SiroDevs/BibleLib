        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wengi wataniambia siku ile, 'Bwana, Bwana, hatukutoa unabii kwa jina lako, na kwa jina lako kutoa pepo wachafu na kufanya miujiza mingi?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.22",
                "verseOrgIds": [
                  "MAT.7.22"
                ]
              }
            }
          ]
        },
        {
