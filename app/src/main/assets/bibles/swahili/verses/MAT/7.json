              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo nitakapowaambia wazi, 'Sikuwajua kamwe. Ondokeni kwangu, ninyi watenda maovu!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.23",
