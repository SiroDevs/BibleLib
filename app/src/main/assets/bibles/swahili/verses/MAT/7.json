        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Si kila mtu aniambiaye, 'Bwana, Bwana,' atakayeingia katika Ufalme wa Mbinguni, bali ni yeye afanyaye mapenzi ya Baba yangu aliye mbinguni.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.21",
                "verseOrgIds": [
                  "MAT.7.21"
                ]
              }
            }
          ]
        },
