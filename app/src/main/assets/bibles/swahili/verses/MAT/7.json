          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu alifundisha kama yeye aliye na mamlaka, wala si kama walimu wao wa sheria.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.29",
            "verseOrgIds": [
              "MAT.7.29"
            ]
          }
