        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa hiyo kila mtu ayasikiaye haya maneno yangu na kuyatenda, ni kama mtu mwenye busara aliyejenga nyumba yake kwenye mwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.24",
                "verseOrgIds": [
                  "MAT.7.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
              "MAT.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 7:25"
          },
          "items": [
