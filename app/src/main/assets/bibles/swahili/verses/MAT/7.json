              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alipomaliza kusema maneno haya, makutano ya watu wakashangazwa sana na mafundisho yake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.28",
            "verseOrgIds": [
              "MAT.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
