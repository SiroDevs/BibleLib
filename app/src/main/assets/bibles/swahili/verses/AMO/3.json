          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba amenguruma:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "je, ni nani ambaye hataogopa?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.8",
                "verseOrgIds": [
                  "AMO.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi ametamka:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "je, ni nani awezaye kukosa kutoa unabii?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangazeni katika ngome za Ashdodi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "na katika ngome za Misri:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "\"Kusanyikeni juu ya milima ya Samaria;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "angalieni wingi wa wasiwasi ulio ndani yake,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "na uonevu ulio miongoni mwa watu wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.10",
                "verseOrgIds": [
                  "AMO.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "asema: \"Hawajui kutenda lililo jema,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:10"
      },
      "items": [
        {
          "text": "wale ambao hujilundikia nyara",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:10"
      },
      "items": [
        {
          "text": "na vitu vilivyotekwa katika ngome zao.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.11",
                "verseOrgIds": [
                  "AMO.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi:",
