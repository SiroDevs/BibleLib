  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "AMO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ole Kwa Wanaoridhika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wenu ninyi mnaostarehe na kuridhika katika Sayuni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "na ninyi mnaojisikia salama juu ya Mlima Samaria,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "ninyi watu mashuhuri wa taifa lililoendelea kuliko mataifa mengine,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "ambao watu wa Israeli wanawategemea!",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nendeni Kalne mkaone kutoka huko;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "mwende hadi Hamathi iliyo kuu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "kisha mshuke hadi Gathi ya Wafilisti.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Je, wao ni bora kuliko falme zenu mbili?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Je, nchi yao ni kubwa kuliko yenu?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnaiweka mbali siku iliyo mbaya",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:3"
      },
      "items": [
        {
          "text": "na kuleta karibu utawala wa kuogofya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi mnalala juu ya vitanda vilivyofunikwa kwa pembe za ndovu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "na kujinyoosha juu ya viti vya fahari.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "Mnajilisha kwa wana-kondoo wazuri",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "na ndama walionenepeshwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi mnapiga vinubi kama Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:5"
      },
      "items": [
        {
          "text": "huku mkitunga nyimbo za vinanda mbalimbali.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnakunywa mvinyo kwa bakuli zilizojazwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "na mnajipaka mafuta mazuri,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "lakini hamhuzuniki kwa maangamizi ya Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo mtakuwa miongoni mwa watu wa kwanza kwenda uhamishoni;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:7"
      },
      "items": [
        {
          "text": "karamu zenu na kustarehe kutakoma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachukia Kiburi Cha Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi ameapa kwa nafsi yake mwenyewe:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu Mwenye Nguvu Zote asema:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "\"Nachukia kiburi cha Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "nachukia ngome zake;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "nitautoa mji wao na kila kitu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "kilichomo ndani mwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama watu kumi watabaki katika nyumba moja, wao pia watakufa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama jamaa ambaye atachoma miili akija ili kuitoa nje ya nyumba, na kumuuliza yeyote ambaye bado anajificha humo, \"Je, yuko mtu yeyote pamoja nawe?\" Naye akisema, \"Hapana,\" ndipo atakaposema, \"Nyamaza kimya! Haturuhusiwi kutaja jina la",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.10",
                "verseOrgIds": [
                  "AMO.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.11",
                "verseOrgIds": [
                  "AMO.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ameamuru,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "naye atabomoa jumba kubwa vipande vipande",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "na nyumba ndogo vipande vidogo vidogo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, farasi waweza kukimbia kwenye miamba mikali?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Je, aweza mtu kulima huko kwa maksai?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Lakini mmegeuza haki kuwa sumu",
