    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Kuangamizwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilimwona Bwana akiwa amesimama kando ya madhabahu, naye akasema:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "\"Piga vichwa vya nguzo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "ili vizingiti vitikisike.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Viangushe juu ya vichwa vya watu wote;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "na wale watakaosalia nitawaua kwa upanga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Hakuna awaye yote atakayekimbia,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "hakuna atakayetoroka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajapojichimbia chini mpaka kwenye vina vya kuzimu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "kutoka huko mkono wangu utawatoa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "Wajapopanda juu hadi kwenye mbingu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "kutoka huko nitawashusha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajapojificha juu ya kilele cha Karmeli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "huko nitawawinda na kuwakamata.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "Wajapojificha kutoka kwenye uso wangu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "katika vilindi vya bahari,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "huko nako nitaamuru joka kuwauma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajapopelekwa uhamishoni na adui zao,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "huko nako nitaamuru upanga uwaue.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "Nitawakazia macho yangu kwa mabaya",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "wala si kwa mazuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.5",
                "verseOrgIds": [
                  "AMO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "yeye agusaye dunia nayo ikayeyuka,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "na wote wakaao ndani mwake wakaomboleza:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "nayo nchi yote huinuka kama Naili,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "kisha hushuka kama mto wa Misri;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye ambaye hujenga jumba lake la kifalme katika mbingu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "na kuisimika misingi yake juu ya dunia,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "yeye aitaye maji ya bahari",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "na kuyamwaga juu ya uso wa nchi:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.6",
                "verseOrgIds": [
                  "AMO.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ndilo jina lake.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, Waisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "ninyi si sawa kwangu kama Wakushi?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "asema",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "\"Je, sikuleta Israeli kutoka Misri,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "Wafilisti kutoka Kaftori,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "na Washamu kutoka Kiri?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hakika macho ya",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.8",
                "verseOrgIds": [
                  "AMO.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "yako juu ya ufalme wenye dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "Nami nitauangamiza",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
