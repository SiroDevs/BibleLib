  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOB 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanadamu aliyezaliwa na mwanamke",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:1"
      },
      "items": [
        {
          "text": "siku zake ni chache nazo zimejaa taabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huchanua kama ua kisha hunyauka;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:2"
      },
      "items": [
        {
          "text": "huwa kama kivuli kipitacho upesi, wala hadumu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, unamwekea jicho lako mtu kama huyo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:3"
      },
      "items": [
        {
          "text": "Je, utamleta mbele yako katika hukumu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani awezaye kutoa kitu safi kutoka kitu najisi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:4"
      },
      "items": [
        {
          "text": "Hakuna awezaye!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku za mwanadamu zimewekewa mpaka;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "umekwisha kutangaza idadi ya miezi yake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "na kuweka mpaka ambao hawezi kuuvuka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo angalia mbali umwache,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:6"
      },
      "items": [
        {
          "text": "hadi awe amekamilisha muda wake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:6"
      },
      "items": [
        {
          "text": "kama mtu aliyeajiriwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa maana lipo tumaini kwa mti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "kama ukikatwa utachipuka tena,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "nayo machipukizi yake mapya hayatakoma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizizi yake yaweza kuchakaa ardhini",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:8"
      },
      "items": [
        {
          "text": "na kisiki chake kufa udongoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini kwa kupata dalili ya maji utachipua",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:9"
      },
      "items": [
        {
          "text": "na kutoa machipukizi kama mche.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mwanadamu hufa, na huo ndio mwisho wake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:10"
      },
      "items": [
        {
          "text": "hutoa pumzi ya mwisho, naye hayuko tena!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile maji yatowekavyo katika bahari,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:11"
      },
      "items": [
        {
          "text": "au mkondo wa mto ukaushwavyo na kuwa mkavu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndivyo mwanadamu alalavyo chini asiamke;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "hadi mbingu zitakapokuwa hazipo tena,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "wanadamu hawataamka au kuamshwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "kutoka kwenye usingizi wao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laiti kama ungenificha kaburini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "na kunisitiri hadi hasira yako ipite!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "Laiti ungeniwekea wakati,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "na kisha ukanikumbuka!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, kama mtu akifa, aweza kuishi tena?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "Siku zote za kazi zangu ngumu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "nitangojea kufanywa upya kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utaniita nami nitakuitika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:15"
      },
      "items": [
        {
          "text": "utakionea shauku kiumbe ambacho mikono yako ilikiumba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika ndipo utakapozihesabu hatua zangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.16",
            "verseOrgIds": [
              "JOB.14.16"
            ]
          }
        }
      ]
    },
    {
