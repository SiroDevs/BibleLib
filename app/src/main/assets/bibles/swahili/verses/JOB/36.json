  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JOB 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elihu Atukuza Wema Wa Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu akaendelea kusema:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.1",
            "verseOrgIds": [
              "JOB.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nivumilie kidogo zaidi nami nitakuonyesha",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:2"
      },
      "items": [
        {
          "text": "kwamba yako mengi zaidi ya kusemwa kwa ajili ya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninayapata maarifa yangu kutoka mbali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:3"
      },
      "items": [
        {
          "text": "nami nitamhesabia haki Muumba wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe na hakika kwamba maneno yangu si ya uongo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:4"
      },
      "items": [
        {
          "text": "mmoja aliye mkamilifu katika maarifa yuko pamoja na wewe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mungu ni mwenye nguvu, lakini hamdharau mwanadamu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:5"
      },
      "items": [
        {
          "text": "ni mwenye nguvu, naye ni thabiti katika shauri lake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawaachi waovu waendelee kuishi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:6"
      },
      "items": [
        {
          "text": "bali huwapa walioteswa haki yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye haondoi macho yake kwa wenye haki;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "huwaketisha penye viti vya enzi pamoja na wafalme",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "na kuwatukuza milele.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ikiwa watu wamefungwa kwenye minyororo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:8"
      },
      "items": [
        {
          "text": "wakiwa wameshikiliwa na kamba za mateso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "huwaonyesha yale waliyoyatenda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:9"
      },
      "items": [
        {
          "text": "kwamba wametenda dhambi kwa majivuno.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwafanya wao kusikia maonyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:10"
      },
      "items": [
        {
          "text": "na huwaagiza kutubu uovu wao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama wakitii na kumtumikia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "wataishi siku zao zilizobaki katika mafanikio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "na miaka yao katika utoshelevu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wasiposikiliza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "wataangamia kwa upanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "nao watakufa pasipo maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wasiomcha Mungu moyoni mwao huficha chuki;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:13"
      },
      "items": [
        {
          "text": "hata anapowafunga, hawamwombi msaada.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanakufa wangali vijana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:14"
      },
      "items": [
        {
          "text": "miongoni mwa wanaume hanithi wa mahali pa kuabudia miungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali wao wanaoteseka huwaokoa katika mateso yao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:15"
      },
      "items": [
        {
          "text": "na kuzungumza nao katika dhiki zao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeye anakubembeleza utoke katika mataya ya dhiki,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "ili kukuweka mahali palipo na nafasi mbali na kizuizi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "hadi kwenye meza yako ya faraja iliyojaa vyakula vizuri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sasa umelemewa na hukumu kwa ajili ya uovu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:17"
      },
      "items": [
        {
          "text": "hukumu na haki vimekukamata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
