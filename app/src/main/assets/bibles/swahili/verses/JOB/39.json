  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "JOB 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, wajua ni wakati gani mbuzi wa mlimani wanapozaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:1"
      },
      "items": [
        {
          "text": "Je, watambua ni wakati gani kulungu jike azaapo mtoto wake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, waweza kuhesabu miezi hadi wazaapo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:2"
      },
      "items": [
        {
          "text": "Je, unajua majira yao ya kuzaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao hujiinamisha na kuzaa watoto wao;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:3"
      },
      "items": [
        {
          "text": "utungu wa kuzaa unakoma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watoto wao hustawi na kuongezeka nguvu nyikani;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:4"
      },
      "items": [
        {
          "text": "huenda zao wala hawarudi tena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ni nani aliyemwachia punda-mwitu awe huru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:5"
      },
      "items": [
        {
          "text": "Ni nani aliyezifungua kamba zake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimempa nchi isiyokaliwa na watu kuwa masikani yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:6"
      },
      "items": [
        {
          "text": "nchi ya chumvi kuwa makao yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huzicheka ghasia za mji,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:7"
      },
      "items": [
        {
          "text": "wala hasikii kelele za mwendesha gari.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huzunguka vilimani kwa ajili ya malisho",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:8"
      },
      "items": [
        {
          "text": "na kutafuta kila kitu kibichi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, nyati atakubali kukutumikia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:9"
      },
      "items": [
        {
          "text": "Atakaa karibu na hori lako usiku?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, waweza kumfungia kwenye matuta kwa kamba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:10"
      },
      "items": [
        {
          "text": "Je, atalima mabonde nyuma yako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, utamtumainia kwa ajili ya nguvu zake nyingi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:11"
      },
      "items": [
        {
          "text": "Utamwachia yeye kazi zako nzito?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utaweza kumwamini akuletee nafaka yako nyumbani",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:12"
      },
      "items": [
        {
          "text": "kutoka shambani na kuikusanya kwenye sakafu yako ya kupuria?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mbuni hupigapiga mabawa yake kwa furaha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:13"
      },
      "items": [
        {
          "text": "lakini hayawezi kulinganishwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:13"
      },
      "items": [
        {
          "text": "na mabawa na manyoya ya korongo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyataga mayai yake juu ya ardhi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:14"
      },
      "items": [
        {
          "text": "na kuyaacha yapate joto mchangani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bila kujali kuwa mguu waweza kuyaponda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:15"
      },
      "items": [
        {
          "text": "kwamba baadhi ya wanyama wa porini wanaweza kuyakanyaga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye huyafanyia makinda yake ukatili kama vile si yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:16"
      },
      "items": [
        {
          "text": "hajali kwamba taabu yake inaweza ikawa bure,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa Mungu hakumjalia hekima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:17"
      },
      "items": [
        {
          "text": "wala hakumpa fungu la akili njema.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini akunjuapo mabawa yake kukimbia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:18"
      },
      "items": [
        {
          "text": "humcheka farasi pamoja na yeye aliyempanda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
