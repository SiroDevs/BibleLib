    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Sehemu Ya Pili: Mazungumzo Ya Ayubu Na Rafiki Zake Watatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JOB.3-JOB.31"
          },
          "items": [
            {
              "text": "Ayubu 3–31",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms2"
      },
      "items": [
        {
          "text": "Hotuba Ya Kwanza Ya Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Anazungumza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya jambo hili, Ayubu akafumbua kinywa chake na kuilaani siku ya kuzaliwa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.1",
            "verseOrgIds": [
              "JOB.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akasema:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.2",
            "verseOrgIds": [
              "JOB.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Siku ya kuzaliwa kwangu na ipotelee mbali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:3"
      },
      "items": [
        {
          "text": "nao usiku ule iliposemekana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:3"
      },
      "items": [
        {
          "text": "'Mtoto wa kiume amezaliwa!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.3",
            "verseOrgIds": [
              "JOB.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile na iwe giza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "Mungu juu na asiiangalie;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:4"
      },
      "items": [
        {
          "text": "nayo nuru isiiangazie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giza na kivuli kikuu kiikalie tena;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "wingu na likae juu yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:5"
      },
      "items": [
        {
          "text": "weusi na uifunike nuru yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ule na ushikwe na giza kuu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "usihesabiwe katika siku za mwaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:6"
      },
      "items": [
        {
          "text": "wala usihesabiwe katika siku za mwezi wowote.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ule na uwe tasa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:7"
      },
      "items": [
        {
          "text": "sauti ya furaha na isisikike ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale wazilaanio siku wailaani hiyo siku,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:8"
      },
      "items": [
        {
          "text": "wale walio tayari kumwamsha Lewiathani.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyota zake za alfajiri na ziwe giza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "nao ungojee mwanga bila mafanikio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "wala usiuone mwonzi wa kwanza",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:9"
      },
      "items": [
        {
          "text": "wa mapambazuko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.9",
            "verseOrgIds": [
              "JOB.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu huo usiku haukunifungia",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "mlango wa tumbo la mama yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "ili kuyaficha macho yangu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:10"
      },
      "items": [
        {
          "text": "kutokana na taabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.10",
            "verseOrgIds": [
              "JOB.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa nini sikuangamia wakati wa kuzaliwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:11"
      },
      "items": [
        {
          "text": "Kwa nini sikufa nilipokuwa ninatoka tumboni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini pakawa na magoti ya kunipokea",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:12"
      },
      "items": [
        {
          "text": "na matiti ili nipate kunyonyeshwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.12",
            "verseOrgIds": [
              "JOB.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana sasa ningekuwa nimepumzika kwa amani.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:13"
      },
      "items": [
        {
          "text": "Ningekuwa nimelala na kupumzika",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamoja na wafalme na washauri wa dunia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:14"
      },
      "items": [
        {
          "text": "waliojijengea mahali ambapo sasa ni magofu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.14",
            "verseOrgIds": [
              "JOB.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamoja na watawala waliokuwa na dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 3:15"
      },
      "items": [
        {
          "text": "waliozijaza nyumba zao kwa fedha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.15",
            "verseOrgIds": [
              "JOB.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
