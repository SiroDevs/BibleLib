  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JOB 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms2"
      },
      "items": [
        {
          "text": "Hotuba Ya Nne Ya Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Anajibu: Mimi Ni Mtu Wa Kuchekwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Ayubu akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.1",
            "verseOrgIds": [
              "JOB.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bila shaka ninyi ndio watu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:2"
      },
      "items": [
        {
          "text": "nayo hekima itakoma mtakapokufa!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mimi ninao ufahamu kama ninyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "mimi si duni kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "Ni nani asiyejua mambo haya yote?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimekuwa mtu wa kuchekwa na rafiki zangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "ingawa nilimwita Mungu naye akanijibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "mimi ni mtu wa kuchekwa tu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "ingawa ni mwadilifu na nisiye na hatia!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanadamu wakiwa katika utulivu huwa na dharau kwa wale wenye msiba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 12:5"
      },
      "items": [
        {
          "text": "kana kwamba ndiyo haki ya wale ambao miguu yao inateleza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hema za wanyangʼanyi hazisumbuliwi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "wale wanaomghadhibisha Mungu wako salama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "wale wamchukuao mungu wao mikononi mwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini ulizeni wanyama, nao watawafundisha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:7"
      },
      "items": [
        {
          "text": "au ndege wa angani, nao watawaambia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "au zungumzeni na dunia, nayo itawafundisha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:8"
      },
      "items": [
        {
          "text": "au acheni samaki wa baharini wawape taarifa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani miongoni mwa hawa wote asiyejua",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:9"
      },
      "items": [
        {
          "text": "kwamba mkono wa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.9",
                "verseOrgIds": [
                  "JOB.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ndio uliofanya hili?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkononi mwake kuna uhai wa kila kiumbe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:10"
      },
      "items": [
        {
          "text": "na pumzi ya wanadamu wote.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, sikio haliyajaribu maneno",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:11"
      },
      "items": [
        {
          "text": "kama vile ulimi uonjavyo chakula?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, hekima haipatikani katikati ya wazee?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:12"
      },
      "items": [
        {
          "text": "Je, maisha marefu hayaleti ufahamu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hekima na nguvu ni vya Mungu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:13"
      },
      "items": [
        {
          "text": "shauri na ufahamu ni vyake yeye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kile anachokibomoa hakiwezi kujengeka tena;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:14"
      },
      "items": [
        {
          "text": "mtu aliyefungiwa naye hawezi kufunguliwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akizuia maji, huwa pana ukame;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:15"
      },
      "items": [
        {
          "text": "akiyaachia maji, huharibu nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwake kuna nguvu na ushindi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:16"
      },
      "items": [
        {
          "text": "adanganywaye na adanganyaye, wote wawili ni wake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
