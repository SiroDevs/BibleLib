  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JOB 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms2"
      },
      "items": [
        {
          "text": "Hotuba Ya Tano Ya Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Anathibitisha Tena Hali Yake Ya Kutokuwa Na Hatia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Ayubu akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.1",
            "verseOrgIds": [
              "JOB.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimepata kusikia mambo mengi kama haya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:2"
      },
      "items": [
        {
          "text": "nanyi nyote ni wafariji wenye kutaabisha!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, maneno yenu mengi yasiyo na maana hayana mwisho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:3"
      },
      "items": [
        {
          "text": "Mna nini hata mwendelee kushindana kwa maneno?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi pia ningeweza kuzungumza kama ninyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "kama mngekuwa katika hali yangu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "ningeweza kutoa hotuba nzuri dhidi yenu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "na kuwatikisia ninyi kichwa changu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kinywa changu kingewatia moyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:5"
      },
      "items": [
        {
          "text": "faraja kutoka midomoni mwangu, ingewaletea nafuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini kama nikisema, maumivu yangu bado hayatulizwi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:6"
      },
      "items": [
        {
          "text": "nami kama nikijizuia, wala hayaondoki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, hakika umenichakaza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:7"
      },
      "items": [
        {
          "text": "umewaangamiza kabisa watu wa nyumbani mwangu wote.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umenikunjakunja, nalo limekuwa ushahidi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:8"
      },
      "items": [
        {
          "text": "nako kukonda kwangu kumeongezeka sana na kushuhudia dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu amenishambulia na kunirarua katika hasira yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "na kunisagia meno yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "adui yangu hunikazia macho yake makali.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wamenifumbulia vinywa vyao kunidhihaki;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "hunipiga shavuni mwangu kwa dharau,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "na kuungana pamoja dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu amenigeuzia kwa watu wabaya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:11"
      },
      "items": [
        {
          "text": "na kunitupa katika makucha ya waovu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo yote yalikuwa mazuri, lakini alinivunjavunja;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "amenikamata shingo na kuniponda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "Amenifanya mimi kuwa shabaha yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wapiga upinde wake wananizunguka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "Bila huruma, huchoma figo zangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "na kuimwaga nyongo yangu juu ya nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huniponda tena na tena;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:14"
      },
      "items": [
        {
          "text": "hunishambulia kama shujaa wa vita.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimejishonea nguo ya gunia juu ya mwili wangu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:15"
      },
      "items": [
        {
          "text": "nami nimekizika kipaji cha uso wangu kwenye vumbi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uso wangu umekuwa mwekundu kwa kulia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:16"
      },
      "items": [
        {
          "text": "macho yangu yamepigwa na giza kuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
