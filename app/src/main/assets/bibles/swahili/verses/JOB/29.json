  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JOB 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Anamaliza Utetezi Wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubu akaendelea na hoja yake, akasema:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.1",
            "verseOrgIds": [
              "JOB.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tazama jinsi ninavyoitamani miezi iliyopita,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:2"
      },
      "items": [
        {
          "text": "zile siku ambazo Mungu alikuwa akinilinda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati taa yake iliniangazia kichwani changu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:3"
      },
      "items": [
        {
          "text": "na kwa mwanga wake Mungu nikapita katikati ya giza!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natamani siku zile nilizokuwa katika ustawi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:4"
      },
      "items": [
        {
          "text": "wakati urafiki wa Mungu wa ndani ulipoibariki nyumba yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati Mwenyezi alikuwa pamoja nami,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:5"
      },
      "items": [
        {
          "text": "nao watoto wangu walikuwa wamenizunguka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati njia yangu ilikuwa imenyweshewa siagi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:6"
      },
      "items": [
        {
          "text": "nao mwamba ukanimiminia vijito vya mafuta ya zeituni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wakati nilipokwenda kwenye lango la mji",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:7"
      },
      "items": [
        {
          "text": "na kuketi katika kiwanja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "vijana waliniona wakakaa kando,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:8"
      },
      "items": [
        {
          "text": "nao wazee walioketi wakasimama;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakuu wakaacha kuzungumza",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:9"
      },
      "items": [
        {
          "text": "na kuziba vinywa vyao kwa mikono yao;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenye vyeo wakanyamazishwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:10"
      },
      "items": [
        {
          "text": "nazo ndimi zao zikagandamana na makaakaa ya vinywa vyao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyote aliyenisikia alinena mema juu yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:11"
      },
      "items": [
        {
          "text": "nao walioniona walinisifu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu nilimwokoa maskini aliyeomba msaada,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:12"
      },
      "items": [
        {
          "text": "naye yatima aliyekuwa hana wa kumsaidia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu aliyekuwa karibu kufa alinibariki,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:13"
      },
      "items": [
        {
          "text": "nami niliufanya moyo wa mjane kuimba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliivaa haki kama vazi langu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:14"
      },
      "items": [
        {
          "text": "uadilifu ulikuwa joho langu na kilemba changu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilikuwa macho ya kipofu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:15"
      },
      "items": [
        {
          "text": "na miguu kwa kiwete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilikuwa baba kwa mhitaji;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:16"
      },
      "items": [
        {
          "text": "nilimtetea mgeni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliyavunja meno makali ya waovu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:17"
      },
      "items": [
        {
          "text": "na kuwapokonya wahanga kwenye meno yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nikafikiri, 'Nitafia katika nyumba yangu mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:18"
      },
      "items": [
        {
          "text": "nazo siku zangu zitakuwa nyingi kama chembechembe za mchanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizizi yangu itafika mpaka kwenye maji,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.19",
            "verseOrgIds": [
              "JOB.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:19"
      },
