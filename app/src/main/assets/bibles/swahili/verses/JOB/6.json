  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOB 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms2"
      },
      "items": [
        {
          "text": "Hotuba Ya Pili Ya Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Anajibu: Malalamiko Yangu Ni Ya Haki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Ayubu akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.1",
            "verseOrgIds": [
              "JOB.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laiti uchungu wangu ungeweza kupimwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:2"
      },
      "items": [
        {
          "text": "nayo taabu yangu yote ingewekwa kwenye mizani!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hakika ingekuwa nzito kuliko mchanga wa bahari zote,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:3"
      },
      "items": [
        {
          "text": "kwa hiyo si ajabu maneno yangu yamekuwa ya haraka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishale ya Mwenyezi iko ndani yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "roho yangu inakunywa sumu yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "vitisho vya Mungu vimejipanga dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, punda-mwitu hulia akiwa na majani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "au ngʼombe dume hulia akiwa na chakula?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, chakula kisicho na ladha huliwa bila chumvi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:6"
      },
      "items": [
        {
          "text": "au upo utamu katika ute mweupe wa yai?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninakataa kuvigusa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:7"
      },
      "items": [
        {
          "text": "vyakula vya aina hii hunichukiza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laiti ningepata haja yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:8"
      },
      "items": [
        {
          "text": "kwamba Mungu angenijalia hilo nililotarajia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba Mungu angekuwa radhi kuniponda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:9"
      },
      "items": [
        {
          "text": "kuuachia mkono wake na kunikatilia mbali!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo bado ningekuwa na hii faraja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "furaha yangu katika maumivu makali:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "kwamba sikuwa nimeyakana maneno yake yeye Aliye Mtakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ninazo nguvu gani, hata niendelee kutumaini?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "Matazamio yangu ya mbele ni nini, hata niendelee kuwa mvumilivu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, mimi nina nguvu za jiwe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:12"
      },
      "items": [
        {
          "text": "Je, mwili wangu ni shaba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, ninao uwezo wowote wa kujisaidia mimi mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:13"
      },
      "items": [
        {
          "text": "wakati ambapo mafanikio yamefukuziwa mbali nami?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mtu anayekata tamaa angetazamia moyo wa kujitoa wa rafiki zake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:14"
      },
      "items": [
        {
          "text": "hata kama akiacha uchaji wa Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ndugu zangu sio wa kutegemewa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:15"
      },
      "items": [
        {
          "text": "ni kama vijito vya msimu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:15"
      },
      "items": [
        {
          "text": "ni kama vijito ambavyo hufurika",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati vimefunikwa barafu iyeyukayo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.16",
            "verseOrgIds": [
              "JOB.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:16"
      },
      "items": [
        {
          "text": "ambavyo hujazwa na theluji inayoyeyuka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.16",
            "verseOrgIds": [
              "JOB.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini hukauka majira ya ukame,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
              "JOB.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:17"
      },
      "items": [
        {
          "text": "na wakati wa hari hutoweka katika mikondo yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
              "JOB.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
