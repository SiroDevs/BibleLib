  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JOB 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bildadi Anasema: Yampasa Ayubu Atubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Bildadi Mshuhi akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.1",
            "verseOrgIds": [
              "JOB.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hata lini wewe utasema mambo kama haya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:2"
      },
      "items": [
        {
          "text": "Maneno yako ni kama upepo mkuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, Mungu hupotosha hukumu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:3"
      },
      "items": [
        {
          "text": "Je, Mwenyezi hupotosha kile kilicho haki?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watoto wako walipomtenda dhambi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:4"
      },
      "items": [
        {
          "text": "aliwapa adhabu ya dhambi yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ukimtafuta Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:5"
      },
      "items": [
        {
          "text": "nawe ukamsihi Mwenyezi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiwa wewe ni safi na mnyofu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "hata sasa atainuka mwenyewe kwa niaba yako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "na kukurudisha katika mahali pako pa haki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijapokuwa mwanzo wako ulikuwa mdogo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:7"
      },
      "items": [
        {
          "text": "lakini mwisho wako utakuwa wa mafanikio.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ukaulize vizazi vilivyotangulia",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:8"
      },
      "items": [
        {
          "text": "na uone baba zao walijifunza nini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa sisi tumezaliwa jana tu na hatujui lolote,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:9"
      },
      "items": [
        {
          "text": "nazo siku zetu duniani ni kama kivuli tu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, hawatakufundisha na kukueleza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:10"
      },
      "items": [
        {
          "text": "Je, hawataleta maneno kutoka kwenye kufahamu kwao?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, mafunjo yaweza kumea mahali pasipo na matope?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:11"
      },
      "items": [
        {
          "text": "Matete yaweza kustawi bila maji?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati bado yanaendelea kukua kabla ya kukatwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:12"
      },
      "items": [
        {
          "text": "hunyauka haraka kuliko majani mengine.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huu ndio mwisho wa watu wote wanaomsahau Mungu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:13"
      },
      "items": [
        {
          "text": "vivyo hivyo matumaini ya wasiomjali Mungu huangamia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lile analolitumainia huvunjika upesi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:14"
      },
      "items": [
        {
          "text": "lile analolitegemea ni utando wa buibui.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huutegemea utando wake, lakini hausimami;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:15"
      },
      "items": [
        {
          "text": "huungʼangʼania, lakini haudumu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ni kama mti ulionyeshewa vizuri wakati wa jua,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:16"
      },
      "items": [
        {
          "text": "ukieneza machipukizi yake bustanini;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "huifunganisha mizizi yake kwenye lundo la mawe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:17"
      },
      "items": [
        {
          "text": "na kutafuta nafasi katikati ya mawe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unapongʼolewa kutoka mahali pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:18"
      },
      "items": [
        {
          "text": "ndipo mahali pale huukana na kusema,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:18"
      },
      "items": [
        {
          "text": "'Mimi kamwe sikukuona.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
