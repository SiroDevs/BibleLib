      "attrs": {
        "style": "q2",
        "vid": "JOB 34:31"
      },
      "items": [
        {
          "text": "'Nimekosa lakini sitatenda dhambi tena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
