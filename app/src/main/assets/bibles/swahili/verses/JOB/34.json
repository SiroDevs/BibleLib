  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "JOB 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elihu Anatangaza Haki Ya Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Elihu akasema:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.1",
            "verseOrgIds": [
              "JOB.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sikieni maneno yangu, enyi watu wenye hekima;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:2"
      },
      "items": [
        {
          "text": "nisikilizeni mimi, ninyi watu wenye maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa sikio huyajaribu maneno",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:3"
      },
      "items": [
        {
          "text": "kama vile ulimi uonjavyo chakula.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tujichagulie wenyewe yaliyo sawa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:4"
      },
      "items": [
        {
          "text": "nasi tujifunze pamoja yaliyo mema.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ayubu anasema, 'Mimi sina hatia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:5"
      },
      "items": [
        {
          "text": "lakini Mungu ameninyima haki yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa niko sawa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "ninaonekana mwongo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "nami ingawa sina kosa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "kidonda changu hakiponi.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mtu gani aliye kama Ayubu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:7"
      },
      "items": [
        {
          "text": "anywaye dharau kama maji?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashirikianaye na watenda mabaya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:8"
      },
      "items": [
        {
          "text": "na kuchangamana na watu waovu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa anasema, 'Haimfaidi mwanadamu kitu chochote",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:9"
      },
      "items": [
        {
          "text": "anapojitahidi kumpendeza Mungu.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hivyo nisikilizeni mimi, ninyi watu wenye ufahamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Kamwe Mungu hatendi uovu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Mwenyezi hafanyi kosa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humlipa mwanadamu kwa ajili ya lile alilotenda;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:11"
      },
      "items": [
        {
          "text": "huleta juu yake kile ambacho matendo yake yanastahili.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jambo lisiloweza kufikiriwa kwamba Mungu angefanya makosa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:12"
      },
      "items": [
        {
          "text": "kwamba Mwenyezi angepotosha hukumu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, ni nani aliyemtawaza juu ya dunia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:13"
      },
      "items": [
        {
          "text": "Ni nani aliyemweka kuwa mwangalizi wa ulimwengu wote?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama lilikuwa kusudi la Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:14"
      },
      "items": [
        {
          "text": "naye akaiondoa Roho yake na pumzi yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanadamu wote wangeliangamia kwa pamoja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:15"
      },
      "items": [
        {
          "text": "na mtu angerudi mavumbini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama ninyi mnaufahamu, sikieni hili;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:16"
      },
      "items": [
        {
          "text": "sikilizeni hili nisemalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, yeye aichukiaye haki aweza kutawala?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:17"
      },
      "items": [
        {
          "text": "Je, utamhukumu mwenye haki, Aliye na Nguvu Zote?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, si ni yeye awaambiaye wafalme, 'Ninyi hamfai kitu,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
