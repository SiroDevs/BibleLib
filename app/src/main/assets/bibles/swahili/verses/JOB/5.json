  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elifazi Anaendelea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ita kama unataka, lakini ni nani atakayekujibu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:1"
      },
      "items": [
        {
          "text": "Ni yupi kati ya hao watakatifu utakayemgeukia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuweka uchungu moyoni humuua mpumbavu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:2"
      },
      "items": [
        {
          "text": "nao wivu humchinja mjinga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi mwenyewe nimemwona mpumbavu akistawi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:3"
      },
      "items": [
        {
          "text": "lakini ghafula nyumba yake ikawa imelaaniwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watoto wake wako mbali na usalama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:4"
      },
      "items": [
        {
          "text": "hushindwa mahakamani bila mtetezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenye njaa huyala mavuno yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "wakiyatoa hata katikati ya miiba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "nao wenye kiu huitamani sana mali yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana taabu haioti kutoka kwenye udongo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:6"
      },
      "items": [
        {
          "text": "wala udhia hauchipui kutoka ardhini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mwanadamu huzaliwa ili kutaabika,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:7"
      },
      "items": [
        {
          "text": "kwa hakika kama cheche za moto zirukavyo kuelekea juu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini ingekuwa ni mimi, ningemlalamikia Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:8"
      },
      "items": [
        {
          "text": "ningeliweka shauri langu mbele zake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye hutenda maajabu yasiyoweza kutambuliwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:9"
      },
      "items": [
        {
          "text": "miujiza isiyoweza kuhesabika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye huipa nchi mvua,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:10"
      },
      "items": [
        {
          "text": "huyapeleka maji kunyesha mashamba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwainua juu wanyonge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:11"
      },
      "items": [
        {
          "text": "nao wale waombolezao huinuliwa wakawa salama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huipinga mipango ya wenye hila,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:12"
      },
      "items": [
        {
          "text": "ili mikono yao isifikie ufanisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye huwanasa wenye hekima katika hila yao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:13"
      },
      "items": [
        {
          "text": "nayo mipango ya wadanganyifu huifagilia mbali.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giza huwapata wakati wa mchana;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:14"
      },
      "items": [
        {
          "text": "wakati wa adhuhuri hupapasa kama vile usiku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humwokoa mhitaji kutokana na upanga ulioko kinywani mwao;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:15"
      },
      "items": [
        {
          "text": "huwaokoa kutokana na makucha ya wenye nguvu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo maskini analo tarajio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:16"
      },
      "items": [
        {
          "text": "nao udhalimu hufumba kinywa chake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Heri mtu yule ambaye Mungu humrudi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:17"
      },
      "items": [
        {
          "text": "kwa hiyo usidharau adhabu yake Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hutia jeraha, lakini pia huyafunga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:18"
      },
      "items": [
        {
          "text": "huumiza, lakini mikono yake pia huponya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
