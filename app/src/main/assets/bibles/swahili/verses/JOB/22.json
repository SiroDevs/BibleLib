  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOB 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elifazi Anasema: Uovu Wa Ayubu Ni Mkubwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Elifazi Mtemani akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.1",
            "verseOrgIds": [
              "JOB.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, mwanadamu aweza kuwa wa faida kwa Mungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:2"
      },
      "items": [
        {
          "text": "Je, hata mtu mwenye hekima aweza kumfaidi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, Mwenyezi angefurahia nini",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:3"
      },
      "items": [
        {
          "text": "kama ungekuwa mwadilifu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 22:3"
      },
      "items": [
        {
          "text": "Au je, yeye angepata faida gani",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:3"
      },
      "items": [
        {
          "text": "kama njia zako zingekuwa kamilifu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, ni kwa ajili ya utaua wako ndiyo maana anakukemea",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:4"
      },
      "items": [
        {
          "text": "na kuleta mashtaka dhidi yako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, uovu wako si mkuu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:5"
      },
      "items": [
        {
          "text": "Dhambi zako si hazina mwisho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umedai dhamana kwa ndugu zako bila sababu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:6"
      },
      "items": [
        {
          "text": "umewavua watu nguo zao, ukawaacha uchi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hukumpa maji aliyechoka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:7"
      },
      "items": [
        {
          "text": "nawe ulimnyima chakula mwenye njaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingawa ulikuwa mtu mwenye uwezo ukimiliki nchi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:8"
      },
      "items": [
        {
          "text": "mtu uliyeheshimiwa, ukiishi ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umewafukuza wajane mikono mitupu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:9"
      },
      "items": [
        {
          "text": "na kuzivunja nguvu za yatima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyo sababu mitego imekuzunguka pande zote,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:10"
      },
      "items": [
        {
          "text": "hatari ya ghafula inakutia hofu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiyo sababu ni giza sana huwezi kuona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:11"
      },
      "items": [
        {
          "text": "tena ndiyo sababu mafuriko ya maji yamekufunika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, Mungu hayuko katika mbingu za juu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:12"
      },
      "items": [
        {
          "text": "Juu kuliko nyota zilizo juu sana!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo wewe wasema, 'Mungu anajua nini?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:13"
      },
      "items": [
        {
          "text": "Je, yeye huhukumu katika giza kama hilo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawingu mazito ni pazia lake, hivyo hatuoni sisi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:14"
      },
      "items": [
        {
          "text": "atembeapo juu ya anga la dunia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, utaifuata njia ya zamani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:15"
      },
      "items": [
        {
          "text": "ambayo watu waovu waliikanyaga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliondolewa kabla ya wakati wao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:16"
      },
      "items": [
        {
          "text": "misingi yao ikachukuliwa na mafuriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walimwambia Mungu, 'Tuache sisi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:17"
      },
      "items": [
        {
          "text": "Huyo Mwenyezi aweza kutufanyia nini?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ndiye alizijaza nyumba zao na vitu vizuri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:18"
      },
      "items": [
        {
          "text": "hivyo ninajitenga mbali na mashauri ya waovu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
