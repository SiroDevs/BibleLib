    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bildadi Anasema: Mwanadamu Awezaje Kuwa Mwadilifu Mbele Za Mungu?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Bildadi Mshuhi akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.1",
            "verseOrgIds": [
              "JOB.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mamlaka na kuheshimiwa ni vyake Mungu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:2"
      },
      "items": [
        {
          "text": "yeye huthibitisha amani katika mbingu juu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, majeshi yake yaweza kuhesabika?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:3"
      },
      "items": [
        {
          "text": "Ni nani asiyeangaziwa na nuru yake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu awezaje kuwa mwadilifu mbele za Mungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:4"
      },
      "items": [
        {
          "text": "Awezaje mtu aliyezaliwa na mwanamke kuwa safi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa hata mwezi sio mwangavu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:5"
      },
      "items": [
        {
          "text": "nazo nyota si safi machoni pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "sembuse mtu ambaye ni funza:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:6"
      },
      "items": [
        {
          "text": "mwanadamu ambaye ni buu tu!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    }
