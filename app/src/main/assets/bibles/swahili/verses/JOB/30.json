  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JOB 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini sasa watu wadogo kwa umri kuniliko wananidhihaki,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "watu ambao baba zao ningekataa kwa dharau",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "kuwaweka pamoja na mbwa wangu wa kulinda kondoo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguvu za mikono yao zingekuwa na faida gani kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:2"
      },
      "items": [
        {
          "text": "kwa kuwa nguvu zao zilikuwa zimewaishia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakiwa wamekonda kutokana na kupungukiwa na kwa njaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:3"
      },
      "items": [
        {
          "text": "walizurura usiku katika nchi kame iliyo ukiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika vichaka walikusanya mimea ya chumvi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:4"
      },
      "items": [
        {
          "text": "nacho chakula chao kilikuwa mizizi ya mti wa mfagio.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walifukuzwa mbali na watu wao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:5"
      },
      "items": [
        {
          "text": "wakipigiwa kelele kama wevi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walilazimika kuishi katika mikondo ya vijito vilivyokauka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:6"
      },
      "items": [
        {
          "text": "kwenye majabali na mahandaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenye vichaka walilia kama punda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:7"
      },
      "items": [
        {
          "text": "na walijisongasonga pamoja kwenye vichaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao ni watoto wa wapumbavu wenye asili ya ubaya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:8"
      },
      "items": [
        {
          "text": "waliofukuzwa watoke katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nao sasa wana wao wananidhihaki katika nyimbo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:9"
      },
      "items": [
        {
          "text": "nimekuwa kitu cha dhihaka kwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wananichukia sana na kujitenga nami,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:10"
      },
      "items": [
        {
          "text": "wala hawasiti kunitemea mate usoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa kwa kuwa Mungu ameilegeza kamba ya upinde wangu na kunitesa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:11"
      },
      "items": [
        {
          "text": "wamekuwa huru kunitendea waonavyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuume kwangu kundi linashambulia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "wao huitegea miguu yangu tanzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "na kunizingira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huizuia njia yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "nao hufanikiwa katika kuniletea maafa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "nami sina yeyote wa kunisaidia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wananijia kama watu wapitao katika ufa mpana;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:14"
      },
      "items": [
        {
          "text": "katikati ya magofu huja na kunishambulia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vitisho vimenifunika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "heshima yangu imetoweshwa kama kwa upepo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "salama yangu imetoweka kama wingu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sasa maisha yangu yamefikia mwisho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:16"
      },
      "items": [
        {
          "text": "siku za mateso zimenikamata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku mifupa yangu inachoma;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:17"
      },
      "items": [
        {
          "text": "maumivu yanayonitafuna hayatulii kamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
