  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms2"
      },
      "items": [
        {
          "text": "Hotuba Ya Tatu Ya Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hakuna Mpatanishi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Ayubu akajibu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.1",
            "verseOrgIds": [
              "JOB.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naam, najua hili ni kweli.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "Lakini mwanadamu awezaje kuwa mwadilifu mbele za Mungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa mtu angetaka kushindana naye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:3"
      },
      "items": [
        {
          "text": "asingaliweza kumjibu Mungu hata mara moja miongoni mwa elfu moja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekima yake ni kubwa sana na ana uwezo mwingi mno.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:4"
      },
      "items": [
        {
          "text": "Ni nani aliyempinga naye akawa salama?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiondoa milima bila yenyewe kujua",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:5"
      },
      "items": [
        {
          "text": "na kuipindua kwa hasira yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aitikisa dunia kutoka mahali pake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:6"
      },
      "items": [
        {
          "text": "na kuzifanya nguzo zake zitetemeke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Husema na jua, nalo likaacha kuangaza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:7"
      },
      "items": [
        {
          "text": "naye huizima mianga ya nyota.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye peke yake huzitandaza mbingu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:8"
      },
      "items": [
        {
          "text": "na kuyakanyaga mawimbi ya bahari.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ndiye Muumba wa nyota za Dubu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        },
        {
          "text": "na Orioni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:9"
      },
      "items": [
        {
          "text": "Kilimia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        },
        {
          "text": "na makundi ya nyota za kusini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hutenda maajabu yasiyopimika,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:10"
      },
      "items": [
        {
          "text": "miujiza isiyoweza kuhesabiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapopita karibu nami, siwezi kumwona;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:11"
      },
      "items": [
        {
          "text": "apitapo mbele yangu, simtambui.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapochukua kwa ghafula, ni nani awezaye kumzuia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:12"
      },
      "items": [
        {
          "text": "Ni nani awezaye kumwambia, 'Unafanya nini?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu hataizuia hasira yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:13"
      },
      "items": [
        {
          "text": "hata jeshi kubwa la Rahabu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        },
        {
          "text": "lenye nguvu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:13"
      },
      "items": [
        {
          "text": "linajikunyata miguuni pake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ni vipi basi mimi nitaweza kubishana naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:14"
      },
      "items": [
        {
          "text": "Nawezaje kupata maneno ya kuhojiana naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa sikuwa na hatia, sikuweza kumjibu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "ningeweza tu kumsihi Mhukumu wangu anihurumie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata kama ningemwita kwenye shauri, naye akakubali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:16"
      },
      "items": [
        {
          "text": "siamini kama angenisikiliza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye angeniangamiza kwa dhoruba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:17"
      },
      "items": [
        {
          "text": "na kuongeza majeraha yangu pasipo na sababu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asingeniacha nipumue",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:18"
      },
      "items": [
        {
