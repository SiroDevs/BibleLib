  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "JOB 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimefanya agano na macho yangu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:1"
      },
      "items": [
        {
          "text": "yasimtazame msichana kwa kumtamani.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa fungu la mwanadamu ni gani kutoka kwa Mungu juu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 31:2"
      },
      "items": [
        {
          "text": "urithi wake kutoka kwa Mungu Mwenye Nguvu Aliye juu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, si uharibifu kwa watu waovu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:3"
      },
      "items": [
        {
          "text": "maangamizi kwa wale watendao mabaya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, yeye hazioni njia zangu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:4"
      },
      "items": [
        {
          "text": "na kuihesabu kila hatua yangu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama nimeishi katika uongo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:5"
      },
      "items": [
        {
          "text": "au mguu wangu umekimbilia udanganyifu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu na anipime katika mizani za uaminifu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:6"
      },
      "items": [
        {
          "text": "naye atajua kwamba sina hatia:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama hatua zangu zimepotoka kutoka kwenye njia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "kama moyo wangu umeongozwa na macho yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "au kama mikono yangu imetiwa unajisi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi wengine na wale nilichokipanda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:8"
      },
      "items": [
        {
          "text": "nayo yale yote niliyootesha na yangʼolewe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama moyo wangu umeshawishiwa na mwanamke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:9"
      },
      "items": [
        {
          "text": "au kama nimevizia mlangoni mwa jirani yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi mke wangu na asage nafaka ya mwanaume mwingine,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:10"
      },
      "items": [
        {
          "text": "nao wanaume wengine walale naye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hilo lingekuwa aibu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:11"
      },
      "items": [
        {
          "text": "naam, dhambi ya kuhukumiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni moto uwakao kwa Uharibifu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:12"
      },
      "items": [
        {
          "text": "ungekuwa umengʼoa mavuno yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama ningewanyima haki watumishi wangu wanaume au vijakazi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:13"
      },
      "items": [
        {
          "text": "walipokuwa na manungʼuniko dhidi yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nitafanya nini Mungu atakaponikabili?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:14"
      },
      "items": [
        {
          "text": "Nitamjibu nini nitakapoitwa kutoa hesabu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, yeye aliyeniumba tumboni mwa mama yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:15"
      },
      "items": [
        {
          "text": "si ndiye aliwaumba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 31:15"
      },
      "items": [
        {
          "text": "Je, si ni yeye huyo mmoja aliyetuumba sote",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:15"
      },
      "items": [
        {
          "text": "ndani ya mama zetu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ikiwa nimewanyima maskini haja zao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:16"
      },
      "items": [
        {
          "text": "au kuyaacha macho ya wajane yadhoofike,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama nimekula chakula changu mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:17"
      },
      "items": [
        {
          "text": "bila kuwashirikisha yatima;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
