  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOB 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu: Mateso Yangu Hayana Mwisho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, mwanadamu hana kazi ngumu duniani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:1"
      },
      "items": [
        {
          "text": "Siku zake si kama zile za mtu aliyeajiriwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtumwa anavyovionea shauku vivuli vya jioni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:2"
      },
      "items": [
        {
          "text": "au mtu aliyeajiriwa anavyoungojea mshahara wake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndivyo nilivyogawiwa miezi ya ubatili,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:3"
      },
      "items": [
        {
          "text": "nami nimeandikiwa huzuni usiku hata usiku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati nilalapo ninawaza, 'Itachukua muda gani kabla sijaamka?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:4"
      },
      "items": [
        {
          "text": "Usiku huwa mrefu, nami najigeuzageuza hadi mapambazuko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwili wangu umevikwa mabuu na uchafu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:5"
      },
      "items": [
        {
          "text": "ngozi yangu imetumbuka na kutunga usaha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Anamlilia Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Siku zangu zinapita upesi kuliko mtande wa kufuma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:6"
      },
      "items": [
        {
          "text": "nazo zinafikia mwisho wake bila matumaini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbuka, Ee Mungu, maisha yangu ni kama pumzi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:7"
      },
      "items": [
        {
          "text": "macho yangu kamwe hayataona tena raha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lile jicho linaloniona sasa halitaniona tena;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:8"
      },
      "items": [
        {
          "text": "utanitafuta, wala sitakuwepo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile wingu liondokavyo na kutoweka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:9"
      },
      "items": [
        {
          "text": "vivyo hivyo yeye ashukaye kaburini",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        },
        {
          "text": "harudi tena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwe harudi tena nyumbani mwake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:10"
      },
      "items": [
        {
          "text": "wala mahali pake hapatamjua tena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa hiyo sitanyamaza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "nitanena kutokana na maumivu makuu ya roho yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "nitalalama kwa uchungu wa nafsi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, mimi ni bahari, au mnyama mkubwa mno akaaye vilindini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:12"
      },
      "items": [
        {
          "text": "hata uniweke chini ya ulinzi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninapofikiri kwamba kitanda changu kitanifariji,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:13"
      },
      "items": [
        {
          "text": "nacho kiti changu cha fahari kitapunguza malalamiko yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo wanitisha kwa ndoto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:14"
      },
      "items": [
        {
          "text": "na kunitia hofu kwa maono,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "hivyo ninachagua kujinyonga na kufa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:15"
      },
      "items": [
        {
          "text": "kuliko huu mwili wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninayachukia maisha yangu; nisingetamani kuendelea kuishi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:16"
      },
      "items": [
        {
          "text": "Niache; siku zangu ni ubatili.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanadamu ni kitu gani hata umjali kiasi hiki,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:17"
      },
      "items": [
        {
          "text": "kwamba unamtia sana maanani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba unamwangalia kila asubuhi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
