  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu: Nayachukia Maisha Yangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nayachukia sana haya maisha yangu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "kwa hiyo nitatoa malalamiko yangu kwa wazi bila kujizuia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "nami nitanena kutokana na uchungu wa moyo wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitamwambia Mungu: Usinihukumu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:2"
      },
      "items": [
        {
          "text": "bali niambie una mashtaka gani dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, inakupendeza wewe kunionea,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "kuikataa kwa dharau kazi ya mikono yako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "huku wewe ukitabasamu juu ya mipango ya waovu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, wewe una macho ya kimwili?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:4"
      },
      "items": [
        {
          "text": "Je, wewe huona kama mwanadamu aonavyo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, siku zako ni kama zile za mwanadamu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:5"
      },
      "items": [
        {
          "text": "au miaka yako ni kama ile ya mtu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kwamba utafute makosa yangu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:6"
      },
      "items": [
        {
          "text": "na kuichunguza dhambi yangu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingawa wajua kuwa mimi sina hatia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:7"
      },
      "items": [
        {
          "text": "na hakuna awezaye kunitoa mkononi mwako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mikono yako ndiyo iliyoniumba na kunifanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:8"
      },
      "items": [
        {
          "text": "Je, sasa utageuka na kuniangamiza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbuka kuwa ulinifinyanga kama udongo wa mfinyanzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:9"
      },
      "items": [
        {
          "text": "Je, sasa utanifanya kuwa mavumbi tena?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, wewe hukunimimina mimi kama maziwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:10"
      },
      "items": [
        {
          "text": "na kunigandisha kama jibini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukanivika ngozi na nyama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:11"
      },
      "items": [
        {
          "text": "na kuniunga pamoja kwa mifupa na mishipa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umenipa uhai na kunitendea wema,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:12"
      },
      "items": [
        {
          "text": "katika uangalizi wako umeilinda roho yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini hili ndilo ulilolificha moyoni mwako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:13"
      },
      "items": [
        {
          "text": "nami ninajua kuwa hili lilikuwa katika nia yako:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama nilifanya dhambi, ungekuwa umeniona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:14"
      },
      "items": [
        {
          "text": "wala usingeacha kosa langu lipite bila kuadhibiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama nina hatia, ole wangu!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "Hata kama ningekuwa sina hatia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "siwezi kukiinua kichwa changu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "kwa kuwa nimejawa na aibu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "na kuzama katika mateso yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama nikiinua kichwa changu juu, unaninyatia kama simba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:16"
      },
      "items": [
        {
          "text": "na kuonyesha tena uwezo wa kutisha dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe waleta mashahidi wapya dhidi yangu",
          "type": "text",
