      "attrs": {
        "style": "q2",
        "vid": "JOB 13:21"
      },
      "items": [
        {
          "text": "nawe uache kuniogofya kwa hofu zako kuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
