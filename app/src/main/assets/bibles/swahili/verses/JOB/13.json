      "attrs": {
        "style": "q2",
        "vid": "JOB 13:22"
      },
      "items": [
        {
          "text": "au niache niseme, nawe upate kujibu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
