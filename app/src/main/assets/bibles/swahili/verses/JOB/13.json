      "attrs": {
        "style": "q2",
        "vid": "JOB 13:20"
      },
      "items": [
        {
          "text": "nami sitajificha uso wako:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
