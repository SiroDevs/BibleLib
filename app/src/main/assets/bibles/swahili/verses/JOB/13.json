      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:19"
      },
      "items": [
        {
          "text": "Kama ndivyo, nitanyamaza kimya na nife.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
