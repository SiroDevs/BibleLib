  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "JOB 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayubu Analalamikia Jeuri Duniani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa nini Mwenyezi asiweke nyakati kwa ajili ya hukumu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:1"
      },
      "items": [
        {
          "text": "Kwa nini wale wamjuao wazitafute siku kama hizo bila mafanikio?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu husogeza mawe ya mpaka;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:2"
      },
      "items": [
        {
          "text": "huchunga makundi ya wanyama waliyonyangʼanya kwa nguvu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huwanyangʼanya yatima punda wao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:3"
      },
      "items": [
        {
          "text": "na kumchukua rehani fahali wa mjane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humsukuma mhitaji kutoka njia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:4"
      },
      "items": [
        {
          "text": "na kuwafanya maskini wote wa nchi kulazimika kujificha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama punda-mwitu jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "maskini huzunguka katika kazi zao za kutafuta chakula;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "mahali palipo jangwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "huwapa chakula cha watoto wao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hukusanya chakula mashambani na kuokota masazo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:6"
      },
      "items": [
        {
          "text": "katika mashamba ya mizabibu ya waovu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukosa nguo, usiku kucha hukaa uchi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:7"
      },
      "items": [
        {
          "text": "hawana chochote cha kujifunika baridi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hutota kwa mvua za mlimani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:8"
      },
      "items": [
        {
          "text": "nao huikumbatia miamba kwa ajili ya kukosa pa kujisitiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtoto yatima hupokonywa matitini;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:9"
      },
      "items": [
        {
          "text": "mtoto wachanga wa maskini hunyakuliwa kwa ajili ya deni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kukosa nguo, hutembea uchi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:10"
      },
      "items": [
        {
          "text": "hubeba miganda ya ngano, lakini huwa na njaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hukamua zeituni katika mawe ya kusagia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:11"
      },
      "items": [
        {
          "text": "hukanyaga mashinikizo, lakini wanaona kiu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilio cha huzuni cha wanaokufa kinapaa kutoka mjini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "nazo nafsi za waliojeruhiwa zinalilia msaada.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "Lakini Mungu hamlaumu mtu yeyote",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "kwa kutenda mabaya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wako wale wanaoiasi nuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "wasiofahamu njia zake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "wala hawakai katika mapito yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mwanga wa mchana unapotoweka, muuaji huinuka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "naye huwaua maskini na mhitaji;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "wakati wa usiku hunyemelea kama mwizi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jicho la mzinzi hungojea wakati wa giza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "naye hufikiri, 'Hakuna jicho litakaloniona,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "naye huuficha uso wake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika giza, huvunja majumba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
