          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa hiyo, hivi ndivyo asemavyo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": ": 'Nitairudia Yerusalemu kwa rehema na huko nyumba yangu itajengwa tena. Nayo kamba ya kupimia itanyooshwa Yerusalemu,' asema",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Endelea kutangaza zaidi kwamba: Hivi ndivyo asemavyo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote: 'Miji yangu itafurika tena ustawi na",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "atamfariji tena Sayuni na kumchagua Yerusalemu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maono Ya Pili: Pembe Nne Na Mafundi Wanne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikatazama juu, na pale mbele yangu nikaona pembe nne!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.18",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamuuliza yule malaika aliyekuwa akizungumza nami, \"Ni nini hivi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:19"
      },
      "items": [
        {
          "text": "Akanijibu, \"Hizi ni zile pembe zilizowatawanya Yuda, Israeli na Yerusalemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.20",
                "verseOrgIds": [
                  "ZEC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akanionyesha mafundi wanne.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikauliza, \"Hawa wanakuja kufanya nini?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:21"
      },
      "items": [
        {
          "text": "Akanijibu, \"Hizi ndizo pembe zilizowatawanya Yuda ili asiwepo atakayeweza kuinua kichwa chake, lakini mafundi wamekuja kuzitia hofu na kuzitupa chini hizi pembe za mataifa ambayo yaliinua pembe zao dhidi ya nchi ya Yuda na kuwatawanya watu wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    }
