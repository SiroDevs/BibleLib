    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hukumu Juu Ya Adui Za Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "Neno la",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "liko kinyume na nchi ya Hadraki",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "na Dameski itakuwa mahali pa kupumzika,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "kwa kuwa macho ya watu na ya kabila zote",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "za Israeli yako kwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pia juu ya Hamathi inayopakana nayo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:2"
      },
      "items": [
        {
          "text": "juu ya Tiro na Sidoni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:2"
      },
      "items": [
        {
          "text": "ingawa wana ujuzi mwingi sana.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiro amejijengea ngome imara,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "amelundika fedha kama mavumbi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "na dhahabu kama taka za mitaani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Bwana atamwondolea mali zake",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "na kuuangamiza uwezo wake wa baharini,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "naye atateketezwa kwa moto.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashkeloni ataona hili na kuogopa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gaza atagaagaa kwa maumivu makali,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "pia Ekroni, kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "matumaini yake yatanyauka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gaza atampoteza mfalme wake",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "na Ashkeloni ataachwa pweke.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wageni watakalia mji wa Ashdodi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:6"
      },
      "items": [
        {
          "text": "nami nitakatilia mbali kiburi cha Wafilisti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitaondoa damu vinywani mwao,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "chakula kile walichokatazwa kati ya meno yao.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "Mabaki yao yatakuwa mali ya Mungu wetu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "nao watakuwa viongozi katika Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "naye Ekroni atakuwa kama Wayebusi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini nitailinda nyumba yangu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "dhidi ya majeshi ya wanyangʼanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "Kamwe mdhalimu hatashambulia watu wangu tena,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "kwa maana sasa ninawachunga.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuja Kwa Mfalme Wa Sayuni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shangilia sana, ee Binti Sayuni!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Piga kelele, Binti Yerusalemu!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Tazama, Mfalme wako anakuja kwako,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "ni mwenye haki, naye ana wokovu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "ni mpole, naye amepanda punda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "mwana-punda, mtoto wa punda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitaondoa magari ya vita kutoka Efraimu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "na farasi wa vita kutoka Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "nao upinde wa vita utavunjwa.",
          "type": "text",
          "attrs": {
