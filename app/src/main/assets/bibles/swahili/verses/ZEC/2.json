  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ZEC 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maono Ya Tatu: Mtu Mwenye Kamba Ya Kupimia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikatazama juu: pale mbele yangu alikuwepo mtu mwenye kamba ya kupimia mkononi mwake!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.1",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamuuliza, \"Unakwenda wapi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 2:2"
      },
      "items": [
        {
          "text": "Akanijibu, \"Kupima Yerusalemu, kupata urefu na upana wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha malaika aliyekuwa akizungumza nami akaondoka, malaika mwingine akaja kukutana naye",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.3",
            "verseOrgIds": [
              "ZEC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kumwambia: \"Kimbia, umwambie yule kijana, 'Yerusalemu utakuwa mji usio na kuta kwa sababu ya wingi wa watu na mifugo iliyomo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.4",
            "verseOrgIds": [
              "ZEC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi mwenyewe nitakuwa ukuta wa moto kuuzunguka,' asema",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.5",
                "verseOrgIds": [
                  "ZEC.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'nami nitakuwa utukufu wake ndani yake.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Njooni! Njooni! Kimbieni mtoke katika nchi ya kaskazini,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.6",
                "verseOrgIds": [
                  "ZEC.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Kwa kuwa nimewatawanya kwenye pande nne za mbingu,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.6",
                "verseOrgIds": [
                  "ZEC.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Njoo, ee Sayuni! Kimbia, wewe ukaaye ndani ya Binti Babeli!\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.7",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hivi ndivyo asemavyo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.8",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.8",
                "verseOrgIds": [
                  "ZEC.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote: \"Baada ya yeye kuniheshimu na kunituma mimi dhidi ya mataifa yaliyokuteka nyara, kwa kuwa yeyote awagusaye ninyi, anaigusa mboni ya jicho lake,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.8",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakika nitauinua mkono wangu dhidi yao ili watumwa wao wawateke nyara. Ndipo mtakapojua ya kwamba",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.9",
                "verseOrgIds": [
                  "ZEC.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote amenituma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Piga kelele na ufurahie, ee Binti Sayuni, kwa maana ninakuja, nami nitaishi miongoni mwenu,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.10",
                "verseOrgIds": [
                  "ZEC.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mataifa mengi yataunganishwa na",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.11",
                "verseOrgIds": [
                  "ZEC.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "siku hiyo, nao watakuwa watu wangu. Nitaishi miongoni mwenu nanyi mtajua kwamba",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.11",
                "verseOrgIds": [
                  "ZEC.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote amenituma kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.12",
                "verseOrgIds": [
                  "ZEC.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "atairithi Yuda kama fungu lake katika nchi takatifu na atachagua tena Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulieni mbele za",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.2.13",
                "verseOrgIds": [
                  "ZEC.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", enyi watu wote, kwa sababu ameinuka kutoka makao yake matakatifu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.17"
            ]
          }
        }
      ]
    }
  ],
