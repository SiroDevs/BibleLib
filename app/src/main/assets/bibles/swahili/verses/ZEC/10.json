          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwombeni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mvua wakati wa vuli;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "ndiye",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "atengenezaye mawingu ya tufani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "Huwapa watu manyunyu ya mvua,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "pia mimea ya shambani kwa ajili ya kila mtu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanamu huzungumza udanganyifu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "waaguzi huona maono ya uongo;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "husimulia ndoto ambazo si za kweli,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "wanatoa faraja batili.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "Kwa hiyo watu wanatangatanga kama kondoo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "walioonewa kwa kukosa mchungaji.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hasira yangu inawaka dhidi ya wachungaji,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "nami nitawaadhibu viongozi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.3",
                "verseOrgIds": [
                  "ZEC.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "atalichunga kundi lake,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "nyumba ya Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "naye atawafanya kuwa kama farasi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "mwenye kiburi akiwa vitani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka Yuda litatokea Jiwe la pembeni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "kutoka kwake vitatoka vigingi vya hema,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "kutoka kwake utatoka upinde wa vita,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "kutoka kwake atatoka kila mtawala.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa pamoja watakuwa kama mashujaa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "wanaokanyaga barabara za matope",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "wakati wa vita.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "Kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.5",
                "verseOrgIds": [
                  "ZEC.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yu pamoja nao,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "watapigana na kuwashinda wapanda farasi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nitaiimarisha nyumba ya Yuda",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "na kuiokoa nyumba ya Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "Nitawarejesha kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "nina huruma juu yao.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "Watakuwa kama watu ambao",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "sijawahi kuwakataa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "kwa sababu mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.6",
                "verseOrgIds": [
                  "ZEC.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wao,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "nami nitawajibu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waefraimu watakuwa kama mashujaa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "mioyo yao itafurahi kana kwamba ni kwa divai.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "Watoto wao wataona na kufurahi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
