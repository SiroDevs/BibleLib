  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ZEC 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fungua milango yako, ee Lebanoni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:1"
      },
      "items": [
        {
          "text": "ili moto uteketeze mierezi yako!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piga yowe, ee mti wa msunobari,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "kwa kuwa mwerezi umeanguka;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "miti ya fahari imeharibiwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "Piga yowe, enyi mialoni ya Bashani,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "msitu mnene umefyekwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikiliza yowe la wachungaji;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "malisho yao manono yameangamizwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "Sikia ngurumo za simba;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "kichaka kilichostawi sana",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "cha Yordani kimeharibiwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wachungaji Wawili Wa Kondoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.4",
                "verseOrgIds": [
                  "ZEC.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wangu: \"Lilishe kundi lililokusudiwa kuchinjwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanunuzi wake huwachinja na kuondoka pasipo kuadhibiwa. Wale wanaowauza husema, '",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.5",
                "verseOrgIds": [
                  "ZEC.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "asifiwe, mimi ni tajiri!' Wachungaji wao wenyewe hawawahurumii.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa sitawahurumia tena watu wa nchi,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.6",
                "verseOrgIds": [
                  "ZEC.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Nitawakabidhi kila mtu mkononi mwa jirani yake na mfalme wake. Wataitenda jeuri nchi, nami sitawaokoa kutoka mikononi mwao.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo nikalilisha kundi lililotiwa alama kwa kuchinjwa, hasa kundi lililoonewa sana. Kisha nikachukua fimbo mbili, moja nikaiita Fadhili na nyingine Umoja, nami nikalilisha kundi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwezi mmoja nikawaondoa wachungaji watatu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 11:8"
      },
      "items": [
        {
          "text": "Kundi la kondoo likanichukia, nami nikachoshwa nao,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikasema, \"Sitakuwa mchungaji wenu. Waache wanaokufa wafe na wanaoangamia waangamie. Wale waliobakia kila mmoja na ale nyama ya mwenzake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikachukua fimbo yangu inayoitwa Fadhili nikaivunja, kutangua Agano nililofanya na mataifa yote.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likatanguka siku hiyo, kwa hiyo wale waliodhurika katika kundi, waliokuwa wakiniangalia wakajua kuwa hilo lilikuwa neno la",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.11",
                "verseOrgIds": [
                  "ZEC.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikawaambia, \"Mkiona kuwa ni vyema, nipeni ujira wangu, la sivyo, basi msinipe.\" Kwa hiyo wakanilipa vipande thelathini vya fedha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.13",
                "verseOrgIds": [
                  "ZEC.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akaniambia, \"Mtupie mfinyanzi,\" hiyo bei nzuri waliyonithaminia! Kwa hiyo nikachukua hivyo vipande thelathini vya fedha na kumtupia huyo mfinyanzi katika nyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.13",
                "verseOrgIds": [
                  "ZEC.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikaivunja fimbo yangu ya pili iitwayo Umoja, kuvunja undugu kati ya Yuda na Israeli!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.11.15",
                "verseOrgIds": [
                  "ZEC.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akaniambia, \"Vitwae tena vifaa vya mchungaji mpumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ninakwenda kumwinua mchungaji juu ya nchi ambaye hatamjali aliyepotea, wala kuwatafuta wale wachanga au kuwaponya waliojeruhiwa, wala kuwalisha wenye afya, lakini atakula nyama ya kondoo wanono na kuzirarua kwato zao.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ole wa mchungaji asiyefaa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:17"
      },
      "items": [
        {
          "text": "anayeliacha kundi!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:17"
      },
      "items": [
        {
          "text": "Upanga na uupige mkono wake na jicho lake la kuume!",
