              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wenyeji wa mji mmoja watakwenda kwenye mji mwingine na kusema, 'Twende mara moja na tukamsihi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
