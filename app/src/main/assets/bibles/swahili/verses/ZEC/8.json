                  "ZEC.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", na kumtafuta",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
