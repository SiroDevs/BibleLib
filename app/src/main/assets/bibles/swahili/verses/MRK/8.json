  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MRK 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Alisha Wanaume 4,000",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.15.32-MAT.15.39"
          },
          "items": [
            {
              "text": "Mathayo 15:32-39",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku hizo, umati mkubwa wa watu ulikusanyika tena. Kwa kuwa walikuwa hawana chakula, Yesu akawaita wanafunzi wake akawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.1",
            "verseOrgIds": [
              "MRK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ninauhurumia huu umati wa watu, kwa sababu sasa wamekuwa nami kwa muda wa siku tatu na hawana chakula.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.2",
                "verseOrgIds": [
                  "MRK.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.2",
            "verseOrgIds": [
              "MRK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nikiwaaga waende nyumbani bila kula, watazimia njiani kwa sababu baadhi yao wametoka mbali.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.3",
                "verseOrgIds": [
                  "MRK.8.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanafunzi wake wakamjibu, \"Lakini hapa nyikani tutapata wapi mikate ya kutosha kuwalisha?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mna mikate mingapi?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.5",
                "verseOrgIds": [
                  "MRK.8.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:5"
      },
      "items": [
        {
          "text": "Wakajibu, \"Tuna mikate saba.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia watu waketi chini. Akiisha kuichukua mikate saba na kushukuru, akaimega na kuwapa wanafunzi wake ili wawagawie watu. Wanafunzi wake wakafanya hivyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.6",
            "verseOrgIds": [
              "MRK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walikuwa pia na visamaki vichache, Yesu akavibariki, akawaamuru wanafunzi wake wawagawie watu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.7",
            "verseOrgIds": [
              "MRK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale watu walikula na kutosheka. Baadaye wanafunzi wakakusanya vipande vilivyosalia, wakajaza vikapu saba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.8",
            "verseOrgIds": [
              "MRK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu waliokula walikuwa wapata 4,000. Akiisha kuwaaga,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.9",
            "verseOrgIds": [
              "MRK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "aliingia kwenye mashua pamoja na wanafunzi wake, akaenda sehemu za Dalmanutha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafarisayo Waomba Ishara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.12.38-MAT.12.42"
          },
          "items": [
            {
              "text": "Mathayo 12:38-42",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.16.1-MAT.16.4"
          },
          "items": [
            {
              "text": "16:1-4",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafarisayo wakaja, wakaanza kumhoji Yesu. Ili kumtega, wakamwomba awaonyeshe ishara kutoka mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akahuzunika moyoni, akawaambia,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa nini kizazi hiki kinataka ishara? Amin nawaambieni, hakitapewa ishara yoyote.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.12",
                "verseOrgIds": [
                  "MRK.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akawaacha, akarudi kwenye mashua, akavuka hadi ngʼambo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chachu Ya Mafarisayo Na Ya Herode",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.16.5-MAT.16.12"
          },
          "items": [
            {
              "text": "Mathayo 16:5-12",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanafunzi walikuwa wamesahau kuchukua mikate ya kutosha. Walikuwa na mkate mmoja tu kwenye mashua.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.14",
            "verseOrgIds": [
              "MRK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawaonya:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Jihadharini na chachu ya Mafarisayo na ya Herode.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.15",
                "verseOrgIds": [
                  "MRK.8.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakajadiliana wao kwa wao, na kusema, \"Anasema hivi kwa sababu hatukuleta mikate.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu, akifahamu majadiliano yao, akawauliza:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mbona mnajadiliana kuhusu kutokuwa na mikate? Je, bado hamtambui wala hamwelewi? Je, mbona mioyo yenu ni migumu kiasi hicho?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.17",
                "verseOrgIds": [
                  "MRK.8.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Je, mna macho lakini mnashindwa kuona, na mna masikio lakini mnashindwa kusikia? Je, hamkumbuki?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.18",
                "verseOrgIds": [
                  "MRK.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.18",
            "verseOrgIds": [
              "MRK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nilipoimega ile mikate mitano kuwalisha watu 5,000, mlikusanya vikapu vingapi vilivyojaa vya masazo?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.19",
                "verseOrgIds": [
                  "MRK.8.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:19"
      },
      "items": [
        {
          "text": "Wakamjibu, \"Kumi na viwili.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, nilipoimega ile mikate saba kuwalisha watu 4,000, mlikusanya vikapu vingapi vilivyojaa vya masazo?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.20",
                "verseOrgIds": [
                  "MRK.8.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:20"
      },
      "items": [
        {
          "text": "Wakamjibu, \"Saba.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.20",
            "verseOrgIds": [
              "MRK.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.21",
            "verseOrgIds": [
              "MRK.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, bado hamwelewi?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.21",
                "verseOrgIds": [
                  "MRK.8.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Amponya Kipofu Huko Bethsaida",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakafika Bethsaida na baadhi ya watu wakamleta mtu mmoja kipofu wakamsihi Yesu amguse.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamshika mkono huyo kipofu akampeleka nje ya kijiji. Baada ya kuyatemea mate macho ya yule kipofu na kumwekea mikono, Yesu akamuuliza,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unaona chochote?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.23",
                "verseOrgIds": [
                  "MRK.8.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule kipofu akaangalia, akasema, \"Ninaona watu, wanaonekana kama miti inayotembea.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamwekea tena mikono machoni. Kisha macho yake yakafunguka, kuona kwake kukarejea naye akaona kila kitu dhahiri.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akamuaga aende nyumbani kwake, akimwambia,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hata kijijini usiingie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.26",
                "verseOrgIds": [
                  "MRK.8.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Amkiri Yesu Kuwa Ndiye Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.16.13-MAT.16.20"
          },
          "items": [
            {
              "text": "Mathayo 16:13-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.18-LUK.9.21"
          },
          "items": [
            {
              "text": "Luka 9:18-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu na wanafunzi wake wakaondoka kwenda katika vijiji vya Kaisaria-Filipi. Walipokuwa njiani, Yesu akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Watu husema mimi ni nani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.27",
                "verseOrgIds": [
                  "MRK.8.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamjibu, \"Baadhi husema wewe ni Yohana Mbatizaji, wengine husema ni Eliya, na bado wengine husema wewe ni mmojawapo wa manabii.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawauliza,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je, ninyi mnasema mimi ni nani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.29",
                "verseOrgIds": [
                  "MRK.8.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:29"
      },
      "items": [
        {
          "text": "Petro akajibu, \"Wewe ndiwe Kristo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawaonya wasimwambie mtu yeyote habari zake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atabiri Kifo Chake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.16.21-MAT.16.28"
          },
          "items": [
            {
              "text": "Mathayo 16:21-28",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.22-LUK.9.27"
          },
          "items": [
            {
              "text": "Luka 9:22-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akaanza kuwafundisha wanafunzi wake kuwa Mwana wa Adamu lazima atapata mateso mengi na kukataliwa na wazee, viongozi wa makuhani, na walimu wa sheria, na kwamba itampasa auawe lakini baada ya siku tatu afufuke.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyasema haya waziwazi, ndipo Petro akamchukua kando na akaanza kumkemea.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Yesu alipogeuka na kuwaangalia wanafunzi wake, akamkemea Petro. Akasema,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Rudi nyuma yangu, Shetani! Moyo wako hauwazi yaliyo ya Mungu, bali ya wanadamu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.33",
                "verseOrgIds": [
                  "MRK.8.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akauita ule umati wa watu pamoja na wanafunzi wake, akasema,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtu yeyote akitaka kunifuata, ni lazima ajikane mwenyewe, auchukue msalaba wake, anifuate.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.34",
                "verseOrgIds": [
                  "MRK.8.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa maana yeyote anayetaka kuyaokoa maisha yake atayapoteza, lakini yeyote atakayeyapoteza maisha yake kwa ajili yangu na kwa ajili ya Injili atayaokoa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.35",
                "verseOrgIds": [
                  "MRK.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Je, itamfaidi nini mtu kuupata ulimwengu wote, lakini akayapoteza maisha yake?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.36",
                "verseOrgIds": [
                  "MRK.8.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Au mtu atatoa nini badala ya nafsi yake?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.37",
                "verseOrgIds": [
                  "MRK.8.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mtu yeyote akinionea aibu mimi na maneno yangu katika kizazi hiki cha uzinzi na dhambi, Mwana wa Adamu naye atamwonea aibu wakati atakapokuja katika utukufu wa Baba yake pamoja na malaika watakatifu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.38",
                "verseOrgIds": [
                  "MRK.8.38"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
