          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Vivyo hivyo, myaonapo mambo haya yakitukia, mnatambua kwamba wakati u karibu, hata malangoni.",
