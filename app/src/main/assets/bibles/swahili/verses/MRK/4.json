    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia tena,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tuufananishe Ufalme wa Mungu na nini? Au tutumie mfano gani ili kuueleza?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.30",
                "verseOrgIds": [
                  "MRK.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ni kama punje ya haradali, ambayo ni mbegu ndogo sana kuliko mbegu zote zinazopandwa ardhini.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.31",
                "verseOrgIds": [
                  "MRK.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini ikishaota, hukua ikawa mmea mkubwa kuliko yote ya bustanini, ikawa na matawi makubwa hata ndege wa angani wanaweza kujenga viota kwenye matawi yake.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.32",
                "verseOrgIds": [
                  "MRK.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa mifano mingine mingi kama hii Yesu alinena nao neno lake, kwa kadiri walivyoweza kulielewa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusema nao neno lolote pasipo mfano. Lakini alipokuwa na wanafunzi wake, aliwafafanulia kila kitu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atuliza Dhoruba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.8.23-MAT.8.27"
          },
          "items": [
            {
              "text": "Mathayo 8:23-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.8.22-LUK.8.25"
          },
          "items": [
            {
              "text": "Luka 8:22-25",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo ilipokaribia jioni, aliwaambia wanafunzi wake,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tuvukeni twende mpaka ngʼambo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.35",
                "verseOrgIds": [
                  "MRK.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakauacha ule umati wa watu, na wakamchukua vile alivyokuwa kwenye mashua. Palikuwa pia na mashua nyingine nyingi pamoja naye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.36",
            "verseOrgIds": [
              "MRK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukawa na dhoruba kali, nayo mawimbi yakaipiga ile mashua hata ikawa karibu kujaa maji.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.37",
            "verseOrgIds": [
              "MRK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alikuwa katika shetri, akiwa analala juu ya mto. Wanafunzi wake wakamwamsha, wakamwambia, \"Mwalimu, hujali kama tunazama?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaamka, akaukemea ule upepo, akayaambia yale mawimbi,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Uwe kimya! Tulia!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.39",
                "verseOrgIds": [
                  "MRK.4.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Ule upepo ukatulia, kukawa shwari kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akawaambia wanafunzi wake,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.40",
            "verseOrgIds": [
              "MRK.4.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa nini mnaogopa hivyo? Je, bado hamna imani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.40",
                "verseOrgIds": [
                  "MRK.4.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wakawa wameogopa sana, wakaulizana, \"Ni nani huyu ambaye hata upepo na mawimbi vinamtii?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.41",
            "verseOrgIds": [
              "MRK.4.41"
            ]
          }
        }
      ]
    }
  ],
