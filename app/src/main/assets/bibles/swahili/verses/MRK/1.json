        "style": "s1"
      },
      "items": [
        {
          "text": "Mahubiri Ya Yohana Mbatizaji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
