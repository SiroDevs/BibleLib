          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana hapatakuwepo tena na maono ya uongo wala ubashiri wa udanganyifu miongoni mwa watu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
