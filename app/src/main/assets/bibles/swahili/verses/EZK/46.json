              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika pembe nne za huo ukumbi wa nje kulikuwa na kumbi nyingine, zenye urefu wa dhiraa arobaini na upana wake dhiraa thelathini, ambapo hizo kumbi kwenye hizo pembe nne zilikuwa na vipimo vilivyo sawa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzunguko wa ndani wa hizo kumbi nne ulikuwa na ukingo wa jiwe, zikiwa na sehemu zilizojengwa kwa ajili ya moto kuzunguka chini ya huo ukingo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
              "EZK.46.23"
            ]
          }
        },
        {
          "name": "verse",
