          "text": "ulionewa wivu na miti yote ya Edeni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "katika bustani ya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
