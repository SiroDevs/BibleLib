    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bonde La Mifupa Mikavu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkono wa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.1",
                "verseOrgIds": [
                  "EZK.37.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ulikuwa juu yangu, naye akanitoa nje kwa Roho wa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.1",
                "verseOrgIds": [
                  "EZK.37.1"
                ]
              }
            }
          ]
        },
        {
          "text": "na kuniweka katikati ya bonde lililokuwa limejaa mifupa tele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanipitisha pande zote kwenye hiyo mifupa, nami nikaona mifupa mingi sana ndani ya lile bonde, mifupa iliyokuwa imekauka sana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaniuliza, \"Mwanadamu, mifupa hii yaweza kuishi?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 37:3"
      },
      "items": [
        {
          "text": "Nikajibu, \"Ee",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.3",
                "verseOrgIds": [
                  "EZK.37.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi, wewe peke yako wajua.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akaniambia, \"Itabirie mifupa hii na uiambie, 'Enyi mifupa mikavu, sikieni neno la",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.4",
                "verseOrgIds": [
                  "EZK.37.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.5",
                "verseOrgIds": [
                  "EZK.37.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo kwa hii mifupa: Nitatia pumzi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "text": "ndani yenu, nanyi mtaishi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawawekea mishipa, nami nitaifanya nyama ije juu yenu na kuwafunika kwa ngozi. Nitatia pumzi ndani yenu, nanyi mtakuwa hai. Ndipo mtakapojua kuwa Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.6",
                "verseOrgIds": [
                  "EZK.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikatabiri kama nilivyoamriwa. Wakati nilipokuwa ninatabiri, kukawa na sauti, sauti ya kugongana, nayo mifupa ikasogeleana, mfupa kwa mfupa mwenziwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.7",
            "verseOrgIds": [
              "EZK.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikatazama, mishipa na nyama vikatokea juu ya mifupa na ngozi ikaifunika, lakini hapakuwepo pumzi ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.8",
            "verseOrgIds": [
              "EZK.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo aliponiambia, \"Utabirie upepo, tabiri, mwanadamu na uuambie, 'Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.9",
                "verseOrgIds": [
                  "EZK.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo: Njoo kutoka pande nne, ee pumzi, nawe upulizie pumzi ndani ya hawa waliouawa, ili wapate kuishi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo nikatabiri kama alivyoniamuru, nayo pumzi ikawaingia, wakawa hai na wakasimama kwa miguu yao, jeshi kubwa mno.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.10",
            "verseOrgIds": [
              "EZK.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akaniambia: \"Mwanadamu, mifupa hii ni nyumba yote ya Israeli. Nao wanasema, 'Mifupa yetu imekauka na tumaini letu limetoweka, tumekatiliwa mbali.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.11",
            "verseOrgIds": [
              "EZK.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo watabirie na uwaambie: 'Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.12",
                "verseOrgIds": [
                  "EZK.37.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo: Enyi watu wangu, nitayafunua makaburi yenu na kuwatoa ndani yake, nami nitawarudisha tena katika nchi ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ninyi watu wangu, mtakapojua kuwa Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.13",
                "verseOrgIds": [
                  "EZK.37.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", nitakapoyafunua makaburi yenu na kuwatoa humo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitatia Roho yangu ndani yenu nanyi mtaishi, nami nitawakalisha katika nchi yenu wenyewe. Ndipo mtakapojua kwamba Mimi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.14",
                "verseOrgIds": [
                  "EZK.37.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nimenena, nami nitalitenda, asema",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.14",
                "verseOrgIds": [
                  "EZK.37.14"
                ]
              }
            }
          ]
        },
        {
          "text": "!' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Taifa Moja Chini Ya Mfalme Mmoja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.15",
                "verseOrgIds": [
                  "EZK.37.15"
                ]
              }
            }
          ]
        },
        {
          "text": "likanijia kusema:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanadamu, chukua fimbo na uandike juu yake, 'Hii ni kwa ajili ya Yuda na Waisraeli waliofungamana naye.' Kisha chukua fimbo nyingine, uandike juu yake, 'Fimbo ya Efraimu, ni kwa ajili ya Yosefu na nyumba yote ya Israeli wanaofungamana naye.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziunganishe pamoja kuwa fimbo moja ili kwamba ziwe fimbo moja katika mkono wako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.17",
            "verseOrgIds": [
              "EZK.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Watu wako watakapokuuliza, 'Je, hutatuambia ni nini maana ya jambo hili?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.18",
            "verseOrgIds": [
              "EZK.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambie, 'Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.19",
                "verseOrgIds": [
                  "EZK.37.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo: Nitaichukua fimbo ya Yosefu, iliyoko mikononi mwa Efraimu na ya makabila ya Israeli yanayofungamana naye na kuiunganisha na fimbo ya Yuda, nikizifanya kuwa fimbo moja, nao watakuwa wamoja katika mkono wangu.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inua mbele ya macho yao zile fimbo ulizoziandika",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.20",
            "verseOrgIds": [
              "EZK.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha waambie, 'Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.21",
                "verseOrgIds": [
                  "EZK.37.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo: Nitawatoa Waisraeli katika mataifa walikokuwa wamekwenda. Nitawakusanya popote walipo na kuwarudisha katika nchi yao wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawafanya kuwa taifa moja katika nchi, katika milima ya Israeli. Patakuwa na mfalme mmoja juu yao wote na kamwe hawatagawanyika tena kuwa mataifa mawili au kugawanyika katika falme mbili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.22",
            "verseOrgIds": [
              "EZK.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawatajitia tena unajisi kwa sanamu zao na vinyago vyao visivyo na maana wala kwa makosa yao yoyote, kwa maana nitawaokoa kutoka dhambi zao zote zilizowarudisha nyuma, nami nitawatakasa. Wao watakuwa watu wangu, nami nitakuwa Mungu wao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.23",
            "verseOrgIds": [
              "EZK.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mtumishi wangu Daudi atakuwa mfalme juu yao, nao wote watakuwa na mchungaji mmoja. Watafuata sheria zangu na kuzishika amri zangu kwa uangalifu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wataishi katika nchi niliyompa mtumishi wangu Yakobo, nchi ambamo baba zenu waliishi. Wao na watoto wao na watoto wa watoto wao wataishi humo milele, naye Daudi mtumishi wangu atakuwa mkuu wao milele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.25",
            "verseOrgIds": [
              "EZK.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitafanya nao Agano la amani, litakuwa Agano la milele. Nitawafanya imara na kuongeza idadi yao, nami nitaweka mahali patakatifu pangu miongoni mwao milele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.26",
            "verseOrgIds": [
              "EZK.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maskani yangu yatakuwa pamoja nao, nitakuwa Mungu wao, nao watakuwa watu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
              "EZK.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mataifa watakapojua kwamba Mimi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.28",
                "verseOrgIds": [
                  "EZK.37.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ndiye ninayeifanya Israeli kuwa takatifu, wakati mahali patakatifu pangu patakapokuwa miongoni mwao milele.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        }
      ]
