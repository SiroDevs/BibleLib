                "verseId": "EZK.13.20",
                "verseOrgIds": [
                  "EZK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo: Mimi niko kinyume na hizo hirizi zenu za uchawi ambazo kwa hizo mnawatega watu kama ndege, nami nitazirarua kutoka mikononi mwenu, nitawaweka huru watu wale mliowatega kama ndege.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitazirarua shela zenu na kuwaokoa watu wangu kutoka mikononi mwenu, nao hawatakuwa tena mawindo ya nguvu zenu. Ndipo mtakapojua kuwa Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
              "EZK.13.21"
            ]
          }
        },
