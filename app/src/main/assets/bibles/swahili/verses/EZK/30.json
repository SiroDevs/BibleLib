                "verseOrgIds": [
                  "EZK.30.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", nitakapoutia upanga wangu mkononi mwa mfalme wa Babeli, naye ataunyoosha dhidi ya Misri.",
