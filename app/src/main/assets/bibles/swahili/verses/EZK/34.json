                "verseOrgIds": [
                  "EZK.34.24"
                ]
              }
            }
          ]
        },
        {
          "text": "nitakuwa Mungu wao, naye mtumishi wangu Daudi atakuwa mkuu miongoni mwao. Mimi",
          "type": "text",
          "attrs": {
