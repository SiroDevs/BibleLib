          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitaweka juu yao mchungaji mmoja, mtumishi wangu Daudi, naye atawachunga, atawachunga na kuwa mchungaji wao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.23",
