  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "EZK 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mto Kutoka Hekaluni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule mtu akanirudisha mpaka kwenye ingilio la Hekalu, nami nikaona maji yakitoka chini ya kizingiti cha Hekalu yakitiririkia upande wa mashariki (kwa maana upande wa mbele wa Hekalu ulielekea mashariki). Maji yalikuwa yakitoka chini upande wa kusini wa Hekalu, kusini mwa madhabahu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akanitoa nje kupitia lango la kaskazini na kunizungusha mpaka kwenye lango la nje linaloelekea mashariki, nayo maji yalikuwa yakitiririka kutoka upande wa kusini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu yule alipokwenda upande wa mashariki akiwa na kamba ya kupimia mkononi mwake, akapima dhiraa 1,000",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "text": "kisha akanipitisha kwenye hayo maji ambayo yalifika kwenye vifundo vya miguu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapima dhiraa 1,000 nyingine na kunipitisha kwenye hayo maji ambayo yalifika magotini. Akapima dhiraa nyingine 1,000 na kunipitisha kwenye hayo maji ambayo yalifika kiunoni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapima tena dhiraa 1,000 nyingine, lakini wakati huu yalikuwa mto ambao sikuweza kuvuka, kwa kuwa maji yalikuwa na kina kirefu ambacho ni cha kuogelea, mto ambao hakuna mtu yeyote ambaye angeweza kuvuka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaniuliza, \"Je, mwanadamu, unaona hili?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 47:6"
      },
      "items": [
        {
          "text": "Kisha akanirudisha mpaka kwenye ukingo wa huo mto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilipofika pale, nikaona idadi kubwa ya miti kila upande wa ule mto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaniambia, \"Haya maji yanatiririka kuelekea nchi ya mashariki na kushuka mpaka Araba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "text": "ambapo huingia Baharini. Yanapomwagikia kwenye hiyo Bahari,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "text": "maji yaliyoko humo huponywa na kuwa safi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popote mto huu uendapo kila kiumbe hai kinachoyaparamia hayo maji kitaishi, nako kutakuwa na samaki wengi mno, mara maji haya yafikapo huko. Maji hayo yatakuwa hai na kila kitu kitakachoishi kule mto uendako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wavuvi watasimama kando ya bahari, kuanzia En-Gedi hadi En-Eglaimu huko patakuwa mahali pa kutandaza nyavu za kuvulia samaki. Samaki watakuwa wa aina nyingi, kama samaki wa Bahari Kuu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini madimbwi yake na mabwawa yake hayatakuwa na maji yanayofaa kunywa, bali yatabakia kuwa maji ya chumvi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miti ya matunda ya kila aina itaota kwenye kingo zote mbili za mto huu. Majani yake hayatanyauka wala haitaacha kuwa na matunda katika matawi yake. Kila mwezi kutakuwa na matunda, kwa sababu maji yatokayo patakatifu yanaitiririkia. Matunda yake yatakuwa chakula na majani yake yatakuwa dawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mipaka Mipya Ya Nchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.47.13",
                "verseOrgIds": [
                  "EZK.47.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi asemalo: \"Hii ndiyo mipaka ambayo kwayo mtagawanya hiyo nchi kuwa urithi miongoni mwa hayo makabila kumi na mawili ya Israeli, pamoja na mafungu mawili ya Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.13",
            "verseOrgIds": [
              "EZK.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtagawa kwa usawa miongoni mwao. Kwa sababu niliapa kwa mkono ulioinuliwa kuwapa baba zenu, nchi hii itakuwa urithi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.14",
            "verseOrgIds": [
              "EZK.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Huu ndio utakuwa mpaka wa hiyo nchi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 47:15"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 47:15"
      },
      "items": [
        {
          "text": "\"Upande wa kaskazini utaanzia Bahari Kuu kwa njia ya Hethloni kupitia Lebo-Hamathi hadi maingilio ya Sedadi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.15",
            "verseOrgIds": [
              "EZK.47.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berotha na Sibraimu (ambao uko kwenye mpaka kati ya Dameski na Hamathi), hadi kufikia Haser-Hatikoni, ambao uko katika mpaka wa Haurani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.16",
            "verseOrgIds": [
              "EZK.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo mpaka utaendelea kuanzia Baharini hadi Hasar-Enoni, ukiambaa na mpaka wa kaskazini wa Dameski, pamoja na mpaka wa Hamathi upande wa kaskazini. Huu utakuwa ndio mpaka wa kaskazini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.17",
            "verseOrgIds": [
              "EZK.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upande wa mashariki mpaka utapita kati ya Haurani na Dameski, kuambaa Yordani na kati ya Gileadi na nchi ya Israeli, hadi bahari ya mashariki",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        },
        {
          "text": "na kufika Tamari. Huu utakuwa ndio mpaka wa mashariki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.18",
            "verseOrgIds": [
              "EZK.47.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upande wa kusini utaanzia Tamari hadi kufikia maji ya Meriba-Kadeshi, kisha utaambaa na Kijito cha Misri hadi Bahari Kuu. Huu utakuwa ndio mpaka wa kusini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.19",
            "verseOrgIds": [
              "EZK.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upande wa magharibi, Bahari Kuu itakuwa ndio mpaka hadi kwenye sehemu mkabala na Lebo-Hamathi. Huu utakuwa ndio mpaka wa magharibi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.20",
            "verseOrgIds": [
              "EZK.47.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mtagawanya nchi hii miongoni mwenu kufuatana na makabila ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.21",
            "verseOrgIds": [
              "EZK.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtaigawanya kuwa urithi kwa ajili yenu na kwa ajili ya wageni wanaoishi miongoni mwenu na ambao wana watoto. Wao watakuwa kwenu kama wenyeji wazawa wa Israeli, pamoja na ninyi watagawiwa urithi miongoni mwa makabila ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.22",
            "verseOrgIds": [
              "EZK.47.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika kabila lolote mgeni atakapoishi hapo ndipo mtakapompatia urithi wake,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.23",
            "verseOrgIds": [
              "EZK.47.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EZK.47.23",
                "verseOrgIds": [
                  "EZK.47.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.23",
            "verseOrgIds": [
              "EZK.47.23"
            ]
          }
        }
      ]
    }
  ],
