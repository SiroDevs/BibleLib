      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "wala hakutaka rehani kwa ajili ya mkopo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "Hanyangʼanyi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "bali huwapa wenye njaa chakula chake",
          "type": "text",
          "attrs": {
