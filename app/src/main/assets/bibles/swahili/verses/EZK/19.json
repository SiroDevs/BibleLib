      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "katika shamba lako la mizabibu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "uliopandwa kando ya maji,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "ukiwa unazaa sana na wenye matawi mengi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
