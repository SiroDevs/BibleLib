          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matawi yake yalikuwa na nguvu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:11"
      },
