              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa maana hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
