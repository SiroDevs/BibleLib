                "verseOrgIds": [
                  "EZK.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": "likanijia, kusema:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
