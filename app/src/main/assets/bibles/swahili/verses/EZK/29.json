                "verseId": "EZK.29.16",
                "verseOrgIds": [
                  "EZK.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
      ]
    },
