                "verseOrgIds": [
                  "EZK.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        }
