              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa ishirini na saba, mwezi wa kwanza, siku ya kwanza, neno la",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "char",
