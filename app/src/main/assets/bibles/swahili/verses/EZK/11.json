              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watafuata amri zangu na kuwa waangalifu kutii sheria zangu. Watakuwa watu wangu nami nitakuwa Mungu wao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.20",
            "verseOrgIds": [
              "EZK.11.20"
            ]
          }
        },
        {
          "name": "verse",
