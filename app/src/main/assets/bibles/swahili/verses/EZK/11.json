                "verseOrgIds": [
                  "EZK.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ukapaa juu kutoka mji, ukatua juu ya mlima ulio upande wa mashariki ya mji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
