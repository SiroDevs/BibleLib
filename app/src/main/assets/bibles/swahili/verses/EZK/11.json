              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho akaniinua na kunileta mpaka kwa watu wa uhamisho huko Ukaldayo nikiwa katika yale maono niliyopewa na Roho wa Mungu.",
          "type": "text",
          "attrs": {
