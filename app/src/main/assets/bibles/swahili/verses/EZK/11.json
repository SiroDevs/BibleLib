                "verseOrgIds": [
                  "EZK.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.21",
            "verseOrgIds": [
              "EZK.11.21"
            ]
          }
        }
      ]
    },
