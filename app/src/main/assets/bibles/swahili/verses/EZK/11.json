              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wale makerubi, wenye magurudumu pembeni mwao, wakakunjua mabawa yao, nao utukufu wa Mungu wa Israeli ulikuwa juu yao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
