          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi utukufu wa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
            "verseOrgIds": [
              "EZK.11.23"
            ]
          }
