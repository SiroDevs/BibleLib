          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa wale ambao mioyo yao imeambatana na vinyago vyao vya upotovu na sanamu zao za machukizo, nitaleta juu ya vichwa vyao yale waliyotenda asema",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.21",
            "verseOrgIds": [
              "EZK.11.21"
            ]
          }
        },
