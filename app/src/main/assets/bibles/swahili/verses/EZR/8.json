        "style": "s1"
      },
      "items": [
        {
          "text": "Orodha Ya Viongozi Wa Jamaa Waliorudi Na Ezra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa ndio viongozi wa jamaa pamoja na wale walioandikwa ambao walikuja pamoja nami kutoka Babeli wakati wa utawala wa Mfalme Artashasta:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa wazao wa Finehasi, alikuwa Gershoni;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 8:2"
      },
      "items": [
        {
          "text": "wa wazao wa Ithamari, alikuwa Danieli;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 8:2"
      },
      "items": [
        {
          "text": "wa wazao wa Daudi, alikuwa Hatushi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa wazao wa Shekania;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZR 8:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 8:3"
      },
      "items": [
        {
          "text": "wa wazao wa Paroshi, alikuwa Zekaria, na watu 150 walioandikishwa pamoja naye;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa wazao wa Pahath-Moabu, alikuwa Eliehoenai mwana wa Zerahia na wanaume 200 pamoja naye;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
