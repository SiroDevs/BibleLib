        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kifo Cha Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mose akaupanda mlima Nebo kutoka tambarare za Moabu mpaka kilele cha Pisga, ngʼambo ya Yeriko. Huko",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.1",
                "verseOrgIds": [
                  "DEU.34.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwonyesha nchi yote: kutoka Gileadi mpaka Dani,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naftali yote, nchi ya Efraimu na Manase, nchi yote ya Yuda mpaka bahari ya magharibi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.2",
            "verseOrgIds": [
              "DEU.34.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.2",
            "verseOrgIds": [
              "DEU.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negebu na nchi yote kuanzia Bonde la Yeriko, Mji wa Mitende, hadi Soari.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.3",
            "verseOrgIds": [
              "DEU.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.4",
                "verseOrgIds": [
                  "DEU.34.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia, \"Hii ndiyo nchi niliyomwahidi Abrahamu na Isaki na Yakobo kwa kiapo niliposema, 'Nitawapa wazao wako.' Nimekuruhusu uione kwa macho yako, lakini hutavuka kuingia.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mose mtumishi wa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.5",
                "verseOrgIds": [
                  "DEU.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akafa huko Moabu, kama",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.5",
                "verseOrgIds": [
                  "DEU.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyokuwa amesema.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akamzika huko Moabu, katika bonde mkabala na Beth-Peori, lakini hakuna ajuaye kaburi lake lilipo mpaka leo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
            "verseOrgIds": [
              "DEU.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alikuwa na umri wa miaka mia moja na ishirini alipofariki; hata hivyo nguvu ya macho yake haikufifia wala mwili wake haukudhoofika.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.7",
            "verseOrgIds": [
              "DEU.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli wakaomboleza kwa ajili ya Mose kwenye tambarare za Moabu kwa siku thelathini, mpaka wakati wa kulia na kuomboleza ulipopita.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoshua mwana wa Nuni alijazwa roho ya hekima kwa sababu Mose alikuwa ameweka mikono yake juu yake. Kwa hiyo Waisraeli wakamsikiliza na wakafanya yale ambayo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.9",
                "verseOrgIds": [
                  "DEU.34.9"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa amemwagiza Mose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangu wakati huo, katika Israeli hajainuka nabii mwingine kama Mose, ambaye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.10",
                "verseOrgIds": [
                  "DEU.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": "alimjua uso kwa uso,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aliyetenda ishara zote zile za miujiza na maajabu ambayo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.34.11",
                "verseOrgIds": [
                  "DEU.34.11"
                ]
              }
            }
          ]
        },
        {
          "text": "alimtuma kuyatenda huko Misri, yaani kwa Farao na maafisa wake wote na nchi yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hakuna mtu yeyote aliyewahi kuonyesha nguvu nyingi ama kutenda matendo ya kutisha ambayo Mose aliwahi kuyafanya mbele ya Israeli yote.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
  ],
