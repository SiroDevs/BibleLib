    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amri Kumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "EXO.20.1-EXO.20.17"
          },
          "items": [
            {
              "text": "Kutoka 20:1-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akawaita Israeli wote, akawaambia:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DEU 5:1"
      },
      "items": [
        {
          "text": "Ee Israeli, sikilizeni amri na sheria ninazowatangazia leo. Jifunzeni, na mwe na hakika kuzifuata.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.2",
                "verseOrgIds": [
                  "DEU.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu alifanya Agano nasi katika mlima wa Horebu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si kwamba",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.3",
                "verseOrgIds": [
                  "DEU.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "alifanya Agano na baba zetu, bali alifanya nasi, nasi sote ambao tuko hai hapa leo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.4",
                "verseOrgIds": [
                  "DEU.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "alisema nanyi uso kwa uso kutoka moto juu ya mlima.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Wakati huo nilisimama kati ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.5",
                "verseOrgIds": [
                  "DEU.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "na ninyi kuwatangazia neno la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.5",
                "verseOrgIds": [
                  "DEU.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwa sababu mliogopa ule moto, nanyi hamkupanda mlimani.) Naye Mungu alisema:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.6",
            "verseOrgIds": [
              "DEU.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.6",
                "verseOrgIds": [
                  "DEU.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, niliyekutoa katika nchi ya Misri, kutoka nchi ya utumwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.6",
            "verseOrgIds": [
              "DEU.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiwe na miungu mingine ila mimi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.7",
            "verseOrgIds": [
              "DEU.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usijitengenezee sanamu katika umbo la kitu chochote kilicho juu mbinguni au duniani chini au ndani ya maji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usivisujudie wala kuviabudu; kwa kuwa Mimi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.9",
                "verseOrgIds": [
                  "DEU.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, ni Mungu mwenye wivu, ninayewaadhibu watoto kwa ajili ya dhambi za baba zao hadi kizazi cha tatu na cha nne cha wanichukiao,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini ninaonyesha upendo kwa maelfu ya vizazi vya wale wanipendao na kuzishika amri zangu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usilitaje bure jina la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.11",
                "verseOrgIds": [
                  "DEU.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.11",
                "verseOrgIds": [
                  "DEU.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "hataacha kumhesabia hatia yeye alitajaye jina lake bure.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhimisha siku ya Sabato na kuiweka takatifu, kama",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.12",
                "verseOrgIds": [
                  "DEU.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako alivyokuagiza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa siku sita utafanya kazi na kutenda shughuli zako zote.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini siku ya Saba ni Sabato kwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.14",
                "verseOrgIds": [
                  "DEU.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wako. Siku hiyo hutafanya kazi yoyote, wewe, wala mwanao au binti yako, wala mtumishi wa kiume au mtumishi wa kike, wala ngʼombe wako, punda wako au mnyama wako yeyote, wala mgeni aliyeko malangoni mwako, ili kwamba mtumishi wako wa kiume na wa kike wapate kupumzika kama wewe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbuka mlikuwa watumwa huko Misri, na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.15",
                "verseOrgIds": [
                  "DEU.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu aliwatoa huko kwa mkono wenye nguvu na kwa mkono ulionyooshwa. Kwa hiyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.15",
                "verseOrgIds": [
                  "DEU.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako amekuagiza kuiadhimisha siku ya Sabato.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waheshimu baba yako na mama yako, kama",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.16",
                "verseOrgIds": [
                  "DEU.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako alivyokuagiza, ili siku zako zipate kuwa nyingi na kufanikiwa katika nchi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.16",
                "verseOrgIds": [
                  "DEU.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako anayokupa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiue.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.17",
            "verseOrgIds": [
              "DEU.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
