          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo ya siri ni ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.29",
                "verseOrgIds": [
                  "DEU.29.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu, bali yaliyofunuliwa ni yetu na watoto wetu milele, ili tuweze kuyafanya maneno yote ya sheria hii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
