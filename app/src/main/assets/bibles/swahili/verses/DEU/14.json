                "verseOrgIds": [
                  "DEU.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu apate kuwabariki ninyi katika kazi zote za mikono yenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
