          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwishoni mwa kila mwaka wa tatu, leteni zaka zote za mazao ya miaka ile na uyahifadhi kwenye miji yenu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili Walawi (ambao hawana mashamba wala urithi wao wenyewe) na wageni, yatima na wajane wanaoishi kwenye miji yenu wapate kuja kula na kushiba, ili",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
