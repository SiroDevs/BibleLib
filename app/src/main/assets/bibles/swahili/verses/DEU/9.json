                "verseOrgIds": [
                  "DEU.9.22"
                ]
              }
            }
          ]
        },
        {
          "text": "huko Tabera, Masa na Kibroth-Hataava.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        }
