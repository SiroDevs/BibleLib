          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilevile wakati",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.23",
                "verseOrgIds": [
                  "DEU.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "alipowatuma kutoka Kadesh-Barnea, alisema, \"Kweeni, mkaimiliki nchi ambayo nimewapa.\" Lakini mliasi dhidi ya agizo la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.23",
                "verseOrgIds": [
                  "DEU.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu. Hamkumtegemea wala kumtii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmekuwa waasi dhidi ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.24",
                "verseOrgIds": [
                  "DEU.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "tangu nilipowajua ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
