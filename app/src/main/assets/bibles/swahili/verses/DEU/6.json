          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.22",
                "verseOrgIds": [
                  "DEU.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akapeleka mbele yetu ishara za miujiza na maajabu makubwa na ya kutisha mno juu ya Misri na Farao pamoja na nyumba yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.22",
            "verseOrgIds": [
              "DEU.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Mungu akatutoa huko, akatuleta na kutupa nchi hii ambayo aliwaahidi baba zetu kwa kiapo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.23",
            "verseOrgIds": [
              "DEU.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
