          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambie: \"Tulikuwa watumwa wa Farao huko Misri, lakini",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.21",
                "verseOrgIds": [
                  "DEU.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "alitutoa sisi kutoka Misri kwa mkono wenye nguvu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
