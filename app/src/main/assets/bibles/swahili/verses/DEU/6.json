              "type": "text"
            }
          ]
        },
        {
          "text": "Siku zijazo, mtoto wako atakapokuuliza, \"Ni nini maana ya masharti haya, amri na sheria hizi ambazo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.20",
                "verseOrgIds": [
                  "DEU.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako alikuagiza wewe?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
