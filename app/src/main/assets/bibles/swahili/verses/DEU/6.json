                "verseId": "DEU.6.24",
                "verseOrgIds": [
                  "DEU.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "akatuagiza tutii amri hizi zote na kumcha",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.24",
                "verseOrgIds": [
                  "DEU.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu, ili tupate kustawi na kuendelea kuwa hai kama ilivyo leo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
