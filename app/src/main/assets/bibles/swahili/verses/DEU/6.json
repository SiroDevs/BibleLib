          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama tukizitii kwa bidii amri hizi zote mbele za",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
            "verseOrgIds": [
              "DEU.6.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.25",
                "verseOrgIds": [
                  "DEU.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu, kama alivyotuamuru sisi, hiyo itakuwa haki yetu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
