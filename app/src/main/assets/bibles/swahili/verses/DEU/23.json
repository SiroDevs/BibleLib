                "verseOrgIds": [
                  "DEU.23.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako kwa kinywa chako mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        }
      ]
    },
    {
