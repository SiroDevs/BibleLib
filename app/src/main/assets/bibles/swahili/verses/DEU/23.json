              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochote kitakachotamkwa kwa midomo yako ni lazima uhakikishe umekifanya, kwa sababu uliweka nadhiri yako kwa hiari mbele za",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "char",
