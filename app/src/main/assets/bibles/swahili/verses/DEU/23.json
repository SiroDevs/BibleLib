  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "DEU 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutengwa Na Mkutano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiingie mtu yeyote aliyehasiwa kwa kupondwa makende au kwa kukatwa uume wake katika kusanyiko la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.1",
                "verseOrgIds": [
                  "DEU.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu yeyote ambaye amezaliwa kwenye ndoa isiyo halali au wazao wake wasiingie kwenye kusanyiko la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.2",
                "verseOrgIds": [
                  "DEU.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", hata mpaka kizazi cha kumi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapatakuwa na Mwamoni au Mmoabu au yeyote wa wazao wao atakayeruhusiwa kuingia katika kusanyiko la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.3",
                "verseOrgIds": [
                  "DEU.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", hata mpaka kizazi cha kumi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hawakuja kuwalaki wakiwa na mkate na maji mlipokuwa njiani mlipotoka Misri, tena walimwajiri Balaamu mwana wa Beori kutoka Pethori iliyoko Aramu-Naharaimu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.4",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "text": "ili kuwalaani ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.4",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.5",
                "verseOrgIds": [
                  "DEU.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu hakumsikiliza Balaamu bali aligeuza laana kuwa baraka kwenu kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.5",
                "verseOrgIds": [
                  "DEU.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu anawapenda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msitafute mapatano ya urafiki nao maisha yenu yote.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.6",
            "verseOrgIds": [
              "DEU.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimchukie Mwedomu, kwa kuwa yeye ni ndugu yako. Usimchukie Mmisri, kwa sababu uliishi kama mgeni katika nchi yake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
            "verseOrgIds": [
              "DEU.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kizazi cha tatu cha watoto watakaozaliwa nao wanaweza kuingia katika kusanyiko la",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.8",
                "verseOrgIds": [
                  "DEU.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unajisi Katika Kambi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unapokuwa umepiga kambi dhidi ya adui zako, jitenge na kitu chochote kisicho safi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.9",
            "verseOrgIds": [
              "DEU.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa mtu amechafuka kwa sababu ya kutokwa na shahawa usiku, inampasa atoke nje ya kambi na kukaa huko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.10",
            "verseOrgIds": [
              "DEU.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini jioni ikikaribia ataoga, na baada ya jua kuzama ataingia tena kambini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.11",
            "verseOrgIds": [
              "DEU.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tengeni mahali nje ya kambi ambapo mnaweza kwenda kujisaidia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.12",
            "verseOrgIds": [
              "DEU.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama sehemu ya vifaa vyenu kuweni na kitu cha kulimia, nanyi mnapojisaidia, chimba shimo na kisha funika kile kikutokacho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.13",
            "verseOrgIds": [
              "DEU.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.14",
                "verseOrgIds": [
                  "DEU.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu hutembea katika kambi yenu ili kuwalinda na kuwaweka adui zenu mikononi mwenu. Kambi yenu ni lazima iwe takatifu, ili asione kitu chochote miongoni mwenu kilicho kichafu akageuka na kuwaacha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sheria Mbalimbali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa mtumwa amekimbilia kwako, usimrudishe kwa bwana wake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.15",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwache aishi miongoni mwenu mahali popote anapopapenda na katika mji wowote anaochagua. Usimwonee.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiwepo Mwisraeli mwanamke kahaba au mwanaume hanithi wa mahali pa kuabudia miungu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwe usilete mapato ya ukahaba ikiwa ni ya mwanamke au ni ya mwanaume katika nyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.18",
                "verseOrgIds": [
                  "DEU.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako kwa ajili ya nadhiri yoyote, kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.18",
                "verseOrgIds": [
                  "DEU.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako anachukizwa na yote mawili.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimtoze ndugu yako riba, iwe ni fedha ama chakula ama kitu kingine chochote ambacho waweza kupata riba juu yake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unaweza kumtoza mgeni riba, lakini siyo nduguyo Mwisraeli, ili kwamba",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.20",
                "verseOrgIds": [
                  "DEU.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako akubariki katika kila kitu unachoweka mkono katika nchi unayoingia kuimiliki.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukiweka nadhiri kwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.21",
                "verseOrgIds": [
                  "DEU.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, usichelewe kuitimiza, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
