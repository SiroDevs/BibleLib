                "verseOrgIds": [
                  "DEU.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako atakudai, nawe utakuwa na hatia ya dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
