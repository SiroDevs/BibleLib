              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.3.24",
                "verseOrgIds": [
                  "DEU.3.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi, umemwonyesha mtumishi wako ukuu wako na mkono wako wenye uweza. Kwa kuwa ni mungu yupi aliye mbinguni au duniani anayeweza kufanya kazi na matendo makuu kama ufanyayo wewe?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acha niende nikaione hiyo nchi nzuri ngʼambo ya Yordani, ile nchi nzuri ya vilima na Lebanoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
