          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamori ambao waliishi katika vilima hivyo waliinuka dhidi yenu, wakawafukuza kama kundi la nyuki wakiwapiga njia yote ya Seiri mpaka Horma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
