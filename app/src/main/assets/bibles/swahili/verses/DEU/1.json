                "verseId": "DEU.1.45",
                "verseOrgIds": [
                  "DEU.1.45"
                ]
              }
            }
          ]
        },
        {
          "text": ", lakini Mungu hakusikiliza kilio chenu, wala hakuwajali.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
