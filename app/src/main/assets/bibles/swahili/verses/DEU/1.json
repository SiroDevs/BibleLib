        },
        {
          "text": "Hivyo niliwaambia, lakini hamkutaka kusikia. Mliasi dhidi ya amri ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.43",
                "verseOrgIds": [
                  "DEU.1.43"
                ]
              }
            }
          ]
        },
        {
          "text": ", na katika kiburi chenu mlienda katika nchi ya vilima.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
