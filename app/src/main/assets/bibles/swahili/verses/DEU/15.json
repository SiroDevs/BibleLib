          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mnyama ana dosari, akiwa ni kilema au kipofu au kama ana kilema kibaya, kamwe usimtoe dhabihu kwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
