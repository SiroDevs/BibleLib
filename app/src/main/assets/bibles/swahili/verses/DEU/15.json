                "verseOrgIds": [
                  "DEU.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
