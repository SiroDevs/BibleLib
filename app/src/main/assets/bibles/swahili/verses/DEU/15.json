              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.20",
                "verseOrgIds": [
                  "DEU.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu pale mahali atakapopachagua.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
