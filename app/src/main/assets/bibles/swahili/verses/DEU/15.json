              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mwaka ninyi na jamaa zenu mtapaswa kuwala mbele za",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
