  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "DEU 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mahali Pekee Pa Kuabudia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hizi ndizo amri na sheria ambazo ni lazima mwe waangalifu kuzifuata katika nchi ambayo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.1",
                "verseOrgIds": [
                  "DEU.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba zenu, amewapa kumiliki, kwa muda wote mtakaoishi katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haribuni kabisa kila mahali pao pa kuabudia kwenye milima mirefu, vilima na chini ya kila mti mkubwa ambamo mataifa haya mnayokwenda kuchukua ardhi yao huabudia miungu yao.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bomoeni madhabahu zao, vunjeni yale mawe wanayoabudu, chomeni moto nguzo zao za Ashera; katilieni mbali sanamu za miungu yao na mfute majina yao mahali hapo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwe msimwabudu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.4",
                "verseOrgIds": [
                  "DEU.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu kama wanavyoabudu wao.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali mtatafuta mahali",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.5",
                "verseOrgIds": [
                  "DEU.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu atakapopachagua katika makabila yenu yote ili aliweke jina lake huko kuwa makao yake. Mahali hapo ndipo iwapasapo kwenda;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hapo ndipo mtakapoleta sadaka zenu za kuteketezwa na dhabihu, zaka zenu na changizo zenu, kile ulichoweka nadhiri kutoa, sadaka zenu za hiari na malimbuko ya makundi yenu ya ngʼombe pamoja na mbuzi na kondoo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo, katika uwepo wa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, ninyi pamoja na jamaa zenu, mtakula na kufurahia kila kitu ambacho mmegusa kwa mikono yenu, kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu amewabariki.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifanye kama tunavyofanya hapa leo, kila mtu anavyopenda mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa bado hamjafikia mahali pa mapumziko na urithi ambao",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.9",
                "verseOrgIds": [
                  "DEU.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu anawapa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtavuka Yordani na kuishi katika nchi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.10",
                "verseOrgIds": [
                  "DEU.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu anayowapa kama urithi, naye atawapa pumziko kutokana na adui zenu wote wanaowazunguka ili ninyi mpate kuishi kwa salama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha kuhusu mahali",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu atakapopachagua kuwa mahali pa makao ya Jina lake, hapo ndipo inapowapasa kuleta kila kitu ninachowaamuru: sadaka zenu za kuteketezwa na dhabihu, zaka zenu na changizo, pamoja na vitu vyote vyenye thamani ambavyo mmeweka nadhiri kumtolea",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo furahini mbele za",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.12",
                "verseOrgIds": [
                  "DEU.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, ninyi, wana wenu na binti zenu, watumishi wenu wa kiume na wa kike, pamoja na Walawi kutoka miji yenu ambao hawana mgawo wala urithi wao wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuweni waangalifu, msitoe dhabihu zenu za kuteketezwa mahali popote mnapopapenda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtazitoa tu mahali pale ambapo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.14",
                "verseOrgIds": [
                  "DEU.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "atachagua katika mojawapo ya makabila yenu, nanyi hapo zingatieni kila jambo ninalowaamuru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, mnaweza kuwachinja wanyama wenu katika miji yenu yoyote ile na kula nyama nyingi mpendavyo kama vile mmemchinja paa au kulungu, kulingana na baraka mtakazojaliwa na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.15",
                "verseOrgIds": [
                  "DEU.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu. Watu walio najisi au walio safi wanaweza kula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kamwe usinywe damu; imwage juu ya ardhi kama maji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamruhusiwi kula katika miji yenu zaka yenu ya nafaka, ya divai mpya na ya mafuta, au mzaliwa wa kwanza wa makundi yenu ya ngʼombe na makundi yenu ya mbuzi na kondoo, wala chochote ambacho mmeweka nadhiri kukitoa, au sadaka zako za hiari, wala matoleo maalum.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badala yake, mtakula vitu hivyo katika uwepo wa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu mahali ambapo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu atapachagua: wewe, wana wako na binti zako, watumishi wako wa kiume na wa kike, na Walawi kutoka miji yenu. Mnatakiwa mfurahi mbele za",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu kwa kula kitu mtakachoweka mikono yenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe waangalifu msiwapuuze Walawi kwa muda wote mnaoishi katika nchi yenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.20",
                "verseOrgIds": [
                  "DEU.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu atakapokuwa ameongeza nchi yenu kama alivyowaahidi, nanyi mkitamani nyama na mkisema, \"Ningependa nyama,\" hapo unaweza kula nyingi upendavyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mahali ambapo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu atapachagua kuweka Jina lake ni mbali sana kutoka kwenu, unaweza kuchinja wanyama kutoka makundi yenu ya ngʼombe, ya mbuzi na ya kondoo ambayo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "amewapa, kama nilivyokuamuru, na mkiwa katika miji yenu wenyewe mnaweza kula nyingi mtakavyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mle kama vile mngekula paa na kulungu. Wote walio najisi kiibada na walio safi mwaweza kula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hakikisheni kwamba hamkunywa damu, kwa sababu damu ni uhai, kamwe msile uhai pamoja na nyama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamruhusiwi kamwe kunywa damu; imwageni juu ya ardhi kama maji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msinywe damu, ili mweze kufanikiwa ninyi pamoja na watoto wenu baada yenu, kwa sababu mtakuwa mkifanya lililo haki machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.25",
                "verseOrgIds": [
                  "DEU.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini vichukueni vitu vyenu vilivyowekwa wakfu pamoja na vile mlivyoweka nadhiri, mwende mahali pale",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.26",
                "verseOrgIds": [
                  "DEU.12.26"
                ]
              }
            }
          ]
        },
        {
          "text": "atakapopachagua.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leteni sadaka zenu za kuteketezwa juu ya madhabahu ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, vyote nyama na damu. Damu ya dhabihu zenu lazima imiminwe kando ya madhabahu ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, lakini nyama mnaweza kula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwe waangalifu kutii masharti haya yote ninayowapa, ili kwamba siku zote mweze kufanikiwa, ninyi pamoja na watoto wenu baada yenu, kwa sababu mtakuwa mkifanya lililo jema na sahihi mbele za macho ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.28",
                "verseOrgIds": [
                  "DEU.12.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.29",
                "verseOrgIds": [
                  "DEU.12.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu atayakatilia mbali mbele yenu mataifa ambayo punde kidogo mtayavamia na kuyaondoa. Lakini mtakapokuwa mmeyafukuza na kuishi katika nchi yao,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na baada ya kuangamizwa mbele yenu, mwe waangalifu msijiingize katika tanzi kwa kuuliza habari za miungu yao, mkisema, \"Je, mataifa haya hutumikiaje miungu yao? Nasi tutafanya vivyo hivyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamwe msimwabudu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu kwa njia wanayoabudu miungu yao, kwa sababu katika kuabudu miungu yao, wanafanya aina zote za machukizo anayoyachukia",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": ". Hata huwateketeza wana wao na binti zao kwa moto kama kafara kwa miungu yao.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angalieni kwamba mnafanya yote niliyowaamuru; msiongeze kitu wala msipunguze kitu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
            "verseOrgIds": [
              "DEU.13.1"
            ]
          }
        }
      ]
    }
  ],
