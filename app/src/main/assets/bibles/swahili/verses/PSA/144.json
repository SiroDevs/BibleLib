          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sifa ni kwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.1",
                "verseOrgIds": [
                  "PSA.144.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwamba wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "aifundishaye mikono yangu vita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "na vidole vyangu kupigana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
