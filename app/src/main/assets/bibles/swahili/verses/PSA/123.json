      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:1"
      },
      "items": [
        {
          "text": "kwako wewe ambaye kiti chako cha enzi kiko mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
