          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile macho ya watumwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
