    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Kwa Ajili Ya Kutaka Haki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi ya Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 82:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu anaongoza kusanyiko kuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:1"
      },
      "items": [
        {
          "text": "anatoa hukumu miongoni mwa \"miungu\":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 82:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hata lini utaendelea kuwatetea wasio haki",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:2"
      },
      "items": [
        {
          "text": "na kuonyesha upendeleo kwa waovu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 82:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teteeni wanyonge na yatima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:3"
      },
      "items": [
        {
          "text": "tunzeni haki za maskini na walioonewa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 82:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwokoeni mnyonge na mhitaji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:4"
      },
      "items": [
        {
          "text": "wakomboeni kutoka mkononi mwa mwovu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 82:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hawajui lolote, hawaelewi lolote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "Wanatembea gizani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "misingi yote ya dunia imetikisika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 82:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nilisema, 'Ninyi ni \"miungu\";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:6"
      },
      "items": [
        {
          "text": "ninyi nyote ni wana wa Aliye Juu Sana.'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 82:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtakufa kama wanadamu wa kawaida;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:7"
      },
      "items": [
        {
          "text": "mtaanguka kama mtawala mwingine yeyote.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 82:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, inuka uihukumu nchi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:8"
      },
      "items": [
        {
          "text": "kwa kuwa mataifa yote ni urithi wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    }
  ],
