        {
          "text": "Zaburi 43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Ya Mtu Aliyeko Uhamishoni Yanaendelea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu unihukumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "nitetee dhidi ya taifa lisilomcha Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "niokoe na watu wadanganyifu na waovu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe ni Mungu ngome yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Kwa nini umenikataa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Kwa nini niendelee kuomboleza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "nikiwa nimeonewa na adui?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuma hima nuru yako na kweli yako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "na viniongoze;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "vinilete mpaka mlima wako mtakatifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "mpaka mahali unapoishi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nitakwenda madhabahuni pa Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "kwa Mungu, furaha yangu na shangwe yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "Nitakusifu kwa kinubi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "Ee Mungu, Mungu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee nafsi yangu, kwa nini unasononeka?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Kwa nini unafadhaika hivyo ndani yangu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Weka tumaini lako kwa Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "kwa sababu bado nitamsifu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Mwokozi wangu na Mungu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    }
  ],
