      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:6"
      },
      "items": [
        {
          "text": "akiwapa nchi za mataifa mengine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
