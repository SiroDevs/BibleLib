                "verseId": "PSA.111.1",
                "verseOrgIds": [
                  "PSA.111.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa moyo wangu wote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
