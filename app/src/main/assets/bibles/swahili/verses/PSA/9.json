        {
          "text": "Zaburi 9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shukrani Kwa Mungu Kwa Ajili Ya Haki Yake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Mtindo wa muth-labeni.",
          "type": "text"
        },
        {
          "text": "Zaburi ya Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.1",
                "verseOrgIds": [
                  "PSA.9.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nitakutukuza kwa moyo wangu wote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:1"
      },
      "items": [
        {
          "text": "nitayasimulia matendo yako yote ya ajabu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitafurahi na kushangilia ndani yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:2"
      },
      "items": [
        {
          "text": "Nitaliimbia sifa jina lako, Ewe Uliye Juu Sana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adui zangu wamerudi nyuma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:3"
      },
      "items": [
        {
          "text": "wamejikwaa na kuangamia mbele zako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana umetetea haki yangu na msimamo wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:4"
      },
      "items": [
        {
          "text": "umeketi kwenye kiti chako cha enzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:4"
      },
      "items": [
        {
          "text": "ukihukumu kwa haki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umekemea mataifa na kuwaangamiza waovu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:5"
      },
      "items": [
        {
          "text": "umeyafuta majina yao milele na milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uharibifu usiokoma umempata adui,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "umeingʼoa miji yao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "hata kumbukumbu lao limetoweka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.7",
                "verseOrgIds": [
                  "PSA.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "anatawala milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:7"
      },
      "items": [
        {
          "text": "ameweka kiti chake cha enzi apate kuhukumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu atahukumu ulimwengu kwa haki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:8"
      },
      "items": [
        {
          "text": "atatawala mataifa kwa haki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.9",
                "verseOrgIds": [
                  "PSA.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kimbilio la watu wanaoonewa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:9"
      },
      "items": [
        {
          "text": "ni ngome imara wakati wa shida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wote wanaolijua jina lako watakutumaini wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "kwa maana wewe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.10",
                "verseOrgIds": [
                  "PSA.9.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "hujawaacha kamwe wakutafutao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwimbieni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.11",
                "verseOrgIds": [
                  "PSA.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sifa, amefanywa mtawala Sayuni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:11"
      },
      "items": [
        {
          "text": "tangazeni miongoni mwa mataifa, yale aliyoyatenda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana yeye alipizaye kisasi cha damu hukumbuka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:12"
      },
      "items": [
        {
          "text": "hapuuzi kilio cha wanaoonewa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.13",
                "verseOrgIds": [
                  "PSA.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", tazama jinsi walivyo wengi adui zangu wanaonitesa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:13"
      },
      "items": [
        {
          "text": "Nihurumie, uniinue kutoka malango ya mauti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili niweze kutangaza sifa zako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:14"
      },
      "items": [
        {
