    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumtumaini Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Mtindo wa \"Njiwa mkimya wa mbali.\" Utenzi wa Daudi. Baada ya kukamatwa na Wafilisti huko Gathi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu unihurumie, maana watu wananifuatia vikali;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:1"
      },
      "items": [
        {
          "text": "mchana kutwa wanazidisha mashambulizi yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasingiziaji wangu wananifuatia mchana kutwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:2"
      },
      "items": [
        {
          "text": "wengi wananishambulia kwa kiburi chao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati ninapoogopa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:3"
      },
      "items": [
        {
          "text": "nitakutumaini wewe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika Mungu, ambaye neno lake ninalisifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "katika Mungu ninatumaini; sitaogopa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "Mwanadamu apatikanaye na kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "atanitenda nini?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchana kutwa wanayageuza maneno yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:5"
      },
      "items": [
        {
          "text": "siku zote wanapanga shauri la kunidhuru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wananifanyia hila, wanajificha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "wanatazama hatua zangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "wakiwa na shauku ya kuutoa uhai wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasiepuke kwa vyovyote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:7"
      },
      "items": [
        {
          "text": "Ee Mungu, katika hasira yako yaangushe mataifa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andika maombolezo yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "orodhesha machozi yangu katika gombo lako:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "je, haya hayapo katika kumbukumbu zako?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo adui zangu watarudi nyuma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "ninapoita msaada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:9"
      },
      "items": [
