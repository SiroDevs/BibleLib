              "attrs": {
                "verseId": "PSA.30.1",
                "verseOrgIds": [
                  "PSA.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
