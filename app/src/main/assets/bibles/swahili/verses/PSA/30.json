    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "Inawezekana kilio kiwepo usiku kucha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
