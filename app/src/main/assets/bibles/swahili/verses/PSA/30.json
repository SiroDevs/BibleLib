      "items": [
        {
          "text": "Maombi Ya Shukrani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Utenzi wa kuweka wakfu hekalu. Zaburi ya Daudi.",
          "type": "text"
        }
      ]
    },
