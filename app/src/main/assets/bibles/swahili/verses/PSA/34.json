          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.1",
                "verseOrgIds": [
                  "PSA.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nyakati zote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
