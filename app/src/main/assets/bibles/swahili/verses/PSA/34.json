          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitamtukuza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
