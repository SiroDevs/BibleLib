    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sifa Na Wema Wa Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi ya Daudi, alipojifanya mwendawazimu mbele ya Abimeleki, ambaye alimfukuza, naye akaondoka.",
          "type": "text"
        }
      ]
    },
    {
