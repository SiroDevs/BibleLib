        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sala Kwa Ajili Ya Haki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.1",
                "verseOrgIds": [
                  "PSA.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", unasimama mbali?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:1"
      },
      "items": [
        {
          "text": "Kwa nini unajificha wakati wa shida?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika kiburi chake, mwovu humtesa maskini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:2"
      },
      "items": [
        {
          "text": "waovu na wanaswe katika hila wanazozitunga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujivunia tamaa za moyo wake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:3"
      },
      "items": [
        {
          "text": "humbariki mlafi na kumtukana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.3",
                "verseOrgIds": [
                  "PSA.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika kiburi chake, mwovu hamtafuti Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:4"
      },
      "items": [
        {
          "text": "katika mawazo yake yote",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:4"
      },
      "items": [
        {
          "text": "hakuna nafasi ya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njia zake daima hufanikiwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "hujivuna na amri zako ziko mbali naye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "huwacheka kwa dharau adui zake wote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anajisemea mwenyewe, \"Hakuna kitakachonitikisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:6"
      },
      "items": [
        {
          "text": "daima nitakuwa na furaha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:6"
      },
      "items": [
        {
          "text": "kamwe sitakuwa na shida.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinywa chake kimejaa laana, uongo na vitisho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:7"
      },
      "items": [
        {
          "text": "shida na ubaya viko chini ya ulimi wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huvizia karibu na vijiji;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "kutoka mafichoni huwanasa wasio na hatia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "akivizia wapitaji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huvizia kama simba aliye mawindoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "huvizia kumkamata mnyonge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "huwakamata wanyonge na kuwaburuza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "katika wavu wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mateka wake hupondwa, huzimia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:10"
      },
      "items": [
        {
          "text": "wanaanguka katika nguvu zake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anajisemea mwenyewe, \"Mungu amesahau,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:11"
      },
      "items": [
        {
          "text": "huficha uso wake na haoni kabisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inuka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.12",
                "verseOrgIds": [
                  "PSA.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "! Inua mkono wako, Ee Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:12"
      },
      "items": [
        {
          "text": "Usiwasahau wanyonge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini mtu mwovu anamtukana Mungu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "Kwa nini anajiambia mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "\"Hataniita nitoe hesabu?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wewe, Ee Mungu, unaona shida na huzuni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "umekubali kuyapokea mkononi mwako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
