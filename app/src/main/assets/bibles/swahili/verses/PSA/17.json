          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huifunga mioyo yao iliyo migumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:10"
      },
      "items": [
        {
          "text": "vinywa vyao hunena kwa majivuno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamenifuatia nyayo zangu, sasa wamenizingira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:11"
      },
      "items": [
        {
          "text": "wakiwa macho, waniangushe chini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamefanana na simba mwenye njaa awindaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:12"
      },
      "items": [
        {
          "text": "kama simba mkubwa anyemeleaye mafichoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inuka, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.13",
                "verseOrgIds": [
                  "PSA.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", pambana nao, uwaangushe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:13"
      },
      "items": [
        {
          "text": "niokoe kutokana na waovu kwa upanga wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
