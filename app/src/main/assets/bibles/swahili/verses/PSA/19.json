    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Utukufu Wa Mungu Katika Uumbaji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Zaburi ya Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbingu zinatangaza utukufu wa Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:1"
      },
      "items": [
        {
          "text": "anga zahubiri kazi ya mikono yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku baada ya siku zinatoa habari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:2"
      },
      "items": [
        {
          "text": "usiku baada ya usiku zinatangaza maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna msemo wala lugha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:3"
      },
      "items": [
        {
          "text": "ambapo sauti zao hazisikiki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauti yao imeenea duniani pote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "nayo maneno yao yameenea",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "hadi miisho ya ulimwengu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 19:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "Katika mbingu amepiga hema kwa ajili ya jua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "linafanana na bwana arusi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:5"
      },
      "items": [
        {
          "text": "akitoka chumbani mwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:5"
      },
      "items": [
        {
          "text": "kama shujaa afurahiavyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:5"
      },
      "items": [
        {
          "text": "kukamilisha kushindana kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huchomoza upande mmoja wa mbingu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "na kufanya mzunguko wake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "hadi upande mwingine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "Hakuna kilichojificha joto lake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheria ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.7",
                "verseOrgIds": [
                  "PSA.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kamilifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "ikihuisha nafsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "Shuhuda za",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.7",
                "verseOrgIds": [
                  "PSA.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni za kuaminika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "zikimpa mjinga hekima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
