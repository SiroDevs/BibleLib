      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "pamoja na hao watendao mabaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
