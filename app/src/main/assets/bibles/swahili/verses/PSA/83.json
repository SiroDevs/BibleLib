    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Kwa Ajili Ya Kushindwa Kwa Adui Wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wimbo. Zaburi ya Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 83:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, usinyamaze kimya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:1"
      },
      "items": [
        {
          "text": "usinyamaze, Ee Mungu, usitulie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 83:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama watesi wako wanafanya fujo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:2"
      },
      "items": [
        {
          "text": "jinsi adui zako wanavyoinua vichwa vyao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 83:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hila, wanafanya shauri dhidi ya watu wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:3"
      },
      "items": [
        {
          "text": "wanafanya shauri baya dhidi ya wale unaowapenda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 83:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanasema, \"Njooni, tuwaangamize kama taifa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:4"
      },
      "items": [
        {
          "text": "ili jina la Israeli lisikumbukwe tena.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 83:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nia moja wanapanga mashauri mabaya pamoja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:5"
      },
      "items": [
        {
          "text": "wanafanya muungano dhidi yako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 83:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mahema ya Edomu na Waishmaeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:6"
      },
      "items": [
        {
          "text": "ya Wamoabu na Wahagari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 83:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gebali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        },
        {
          "text": "Amoni na Amaleki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:7"
      },
      "items": [
        {
          "text": "Ufilisti, pamoja na watu wa Tiro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 83:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata Ashuru wameungana nao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:8"
      },
      "items": [
        {
          "text": "kuwapa nguvu wazao wa Loti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 83:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwatendee kama vile ulivyowatendea Midiani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:9"
      },
      "items": [
        {
          "text": "na kama vile ulivyowatendea Sisera na Yabini",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:9"
      },
      "items": [
        {
          "text": "hapo kijito cha Kishoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 83:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambao waliangamia huko Endori",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:10"
      },
      "items": [
        {
          "text": "na wakawa kama takataka juu ya nchi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 83:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafanye wakuu wao kama Orebu na Zeebu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:11"
      },
      "items": [
        {
          "text": "watawala wao kama Zeba na Salmuna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 83:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambao walisema, \"Na tumiliki nchi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "ya malisho ya Mungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 83:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu wangu, wapeperushe kama mavumbi ya kisulisuli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:13"
      },
      "items": [
        {
          "text": "kama makapi yapeperushwayo na upepo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 83:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile moto uteketezavyo msitu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:14"
      },
      "items": [
        {
          "text": "au mwali wa moto unavyounguza milima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 83:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wafuatilie kwa tufani yako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:15"
      },
      "items": [
        {
          "text": "na kuwafadhaisha kwa dhoruba yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 83:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funika nyuso zao kwa aibu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:16"
      },
      "items": [
        {
          "text": "ili watu walitafute jina lako, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.83.16",
                "verseOrgIds": [
                  "PSA.83.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 83:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao na waaibishwe na kufadhaishwa milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.17",
            "verseOrgIds": [
              "PSA.83.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
