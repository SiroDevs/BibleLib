      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "hawatashikamana nami.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
