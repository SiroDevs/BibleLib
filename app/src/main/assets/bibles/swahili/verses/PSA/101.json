      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:4"
      },
      "items": [
        {
          "text": "nitajitenga na kila ubaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
