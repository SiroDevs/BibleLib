      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "ee mji wa Mungu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
