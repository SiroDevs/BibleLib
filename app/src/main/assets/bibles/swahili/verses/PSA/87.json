    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "\"Huyu na yule walizaliwa humo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "naye Aliye Juu Sana mwenyewe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "atamwimarisha.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
