        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matendo Makuu Ya Mungu Yanakumbukwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Mtindo wa Yeduthuni. Zaburi ya Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 77:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilimlilia Mungu ili anisaidie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:1"
      },
      "items": [
        {
          "text": "nilimlilia Mungu ili anisikie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 77:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilipokuwa katika taabu, nilimtafuta Bwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "usiku nilinyoosha mikono bila kuchoka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "na nafsi yangu ilikataa kufarijika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 77:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, nilikukumbuka wewe, nikalia kwa huzuni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "text": "nikatafakari, roho yangu ikadhoofika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 77:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulizuia macho yangu kufumba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:4"
      },
      "items": [
        {
          "text": "nilikuwa nasumbuka, nikashindwa kusema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 77:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilitafakari juu ya siku zilizopita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:5"
      },
      "items": [
        {
          "text": "miaka mingi iliyopita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 77:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nilikumbuka nilivyoimba nyimbo usiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:6"
      },
      "items": [
        {
          "text": "Moyo wangu ulitafakari",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:6"
      },
      "items": [
        {
          "text": "na roho yangu ikauliza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 77:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, Bwana atakataa milele?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:7"
      },
      "items": [
        {
          "text": "Je, hatatenda mema tena?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 77:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, upendo wake usio na mwisho umetoweka milele?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:8"
      },
      "items": [
        {
          "text": "Je, ahadi yake imekoma nyakati zote?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 77:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, Mungu amesahau kuwa na huruma?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:9"
      },
      "items": [
        {
          "text": "Je, katika hasira amezuia huruma yake?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 77:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikawaza, \"Huu ndio udhaifu wangu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:10"
      },
      "items": [
        {
          "text": "lakini nitakumbuka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 77:10"
      },
      "items": [
        {
          "text": "miaka ya mkono wa kuume",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:10"
      },
      "items": [
        {
          "text": "wa Aliye Juu Sana.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 77:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitayakumbuka matendo ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.11",
                "verseOrgIds": [
                  "PSA.77.12"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:11"
      },
      "items": [
        {
          "text": "naam, nitaikumbuka miujiza yako ya zamani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 77:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitazitafakari kazi zako zote",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:12"
      },
      "items": [
        {
          "text": "na kuyawaza matendo yako makuu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 77:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, njia zako ni takatifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 77:13"
      },
      "items": [
        {
          "text": "Ni mungu yupi aliye mkuu kama Mungu wetu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 77:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe ndiwe Mungu utendaye miujiza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:14"
      },
      "items": [
        {
          "text": "umeonyesha uwezo wako katikati ya mataifa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 77:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa mkono wako wenye nguvu umewakomboa watu wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:15"
      },
      "items": [
        {
          "text": "uzao wa Yakobo na Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 77:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maji yalikuona, Ee Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
