              "attrs": {
                "verseId": "PSA.27.4",
                "verseOrgIds": [
                  "PSA.27.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "siku zote za maisha yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "niutazame uzuri wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.4",
                "verseOrgIds": [
                  "PSA.27.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "na kumtafuta hekaluni mwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa siku ya shida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "atanihifadhi salama katika maskani yake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "atanificha uvulini mwa hema yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "na kuniweka juu kwenye mwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha kichwa changu kitainuliwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "juu ya adui zangu wanaonizunguka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "Katika maskani yake nitatoa dhabihu kwa kelele za shangwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "nitamwimbia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.6",
                "verseOrgIds": [
                  "PSA.27.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na kumsifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
