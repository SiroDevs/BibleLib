      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "niweze kukaa nyumbani mwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
