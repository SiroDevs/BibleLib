            "number": "2",
            "style": "v",
            "sid": "PSA 100:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwabuduni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        },
        {
          "name": "char",
