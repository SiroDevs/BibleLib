      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:5"
      },
      "items": [
        {
          "text": "uaminifu wake unadumu kwa vizazi vyote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
