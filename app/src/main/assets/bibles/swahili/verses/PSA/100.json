              "attrs": {
                "verseId": "PSA.100.3",
                "verseOrgIds": [
                  "PSA.100.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ndiye Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "Yeye ndiye alituumba, sisi tu mali yake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "sisi tu watu wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "kondoo wa malisho yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
