            "sid": "PSA 100:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingieni malangoni mwake kwa shukrani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "na katika nyua zake kwa kusifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
