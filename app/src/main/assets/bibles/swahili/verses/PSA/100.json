                "verseId": "PSA.100.2",
                "verseOrgIds": [
                  "PSA.100.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa furaha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:2"
      },
      "items": [
        {
          "text": "njooni mbele zake kwa nyimbo za shangwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
