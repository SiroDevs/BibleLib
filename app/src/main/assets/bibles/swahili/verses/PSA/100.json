            "sid": "PSA 100:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.100.5",
                "verseOrgIds": [
                  "PSA.100.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mwema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
