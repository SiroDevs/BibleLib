          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpigieni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.100.1",
                "verseOrgIds": [
                  "PSA.100.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kelele za shangwe, dunia yote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
