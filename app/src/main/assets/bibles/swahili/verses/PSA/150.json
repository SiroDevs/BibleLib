      "attrs": {
        "style": "q1",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "Msifuni Mungu katika patakatifu pake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
