              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "msifuni kwa matari na kucheza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
