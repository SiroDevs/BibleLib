      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:3"
      },
      "items": [
        {
          "text": "msifuni kwa kinubi na zeze,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
