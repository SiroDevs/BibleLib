          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifuni kwa matendo yake makuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
