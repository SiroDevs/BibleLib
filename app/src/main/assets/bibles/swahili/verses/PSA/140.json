          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "katika mashimo ya matope,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "wasiinuke tena kamwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
