      "attrs": {
        "style": "q2",
        "vid": "PSA 140:7"
      },
      "items": [
        {
          "text": "unikingaye kichwa changu siku ya vita:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
