            "style": "v",
            "sid": "PSA 140:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wao hufanya ndimi zao kali kama za nyoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:3"
      },
      "items": [
        {
          "text": "sumu ya nyoka iko midomoni mwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
