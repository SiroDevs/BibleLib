          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.1",
                "verseOrgIds": [
                  "PSA.140.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", niokoe, kutoka kwa watu waovu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
