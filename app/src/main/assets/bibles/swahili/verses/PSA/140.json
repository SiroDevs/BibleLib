      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:9"
      },
      "items": [
        {
          "text": "na shida zinazosababishwa na midomo yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
