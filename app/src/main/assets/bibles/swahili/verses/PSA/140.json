          "text": "Mwenyezi, Mwokozi wangu mwenye nguvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
