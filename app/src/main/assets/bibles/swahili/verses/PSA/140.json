      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "wanaopanga kunikwaza miguu yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
