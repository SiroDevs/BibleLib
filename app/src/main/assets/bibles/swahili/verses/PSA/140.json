      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "wametega mitego kwenye njia yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
