          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenye kiburi wameficha mtego wa kuninasa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
