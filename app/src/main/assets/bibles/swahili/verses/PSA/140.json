      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:11"
      },
      "items": [
        {
          "text": "maafa na yawawinde watu wenye jeuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
