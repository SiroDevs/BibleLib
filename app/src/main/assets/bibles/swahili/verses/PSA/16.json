      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "pamoja na furaha za milele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
