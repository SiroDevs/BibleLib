      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:5"
      },
      "items": [
        {
          "text": "umeyafanya mambo yangu yote yawe salama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
