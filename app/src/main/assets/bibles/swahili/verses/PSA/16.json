          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
