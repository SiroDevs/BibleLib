        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilimwambia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.2",
                "verseOrgIds": [
                  "PSA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Wewe ndiwe Bwana wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:2"
      },
      "items": [
        {
          "text": "pasipo wewe sina jambo jema.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa habari ya watakatifu walioko duniani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:3"
      },
      "items": [
        {
          "text": "ndio walio wa fahari ambao ninapendezwa nao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huzuni itaongezeka kwa wale",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "wanaokimbilia miungu mingine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "Sitazimimina sadaka zao za damu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "au kutaja majina yao midomoni mwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
