      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:8"
      },
      "items": [
        {
          "text": "Kwa sababu yuko mkono wangu wa kuume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:8"
      },
      "items": [
        {
          "text": "sitatikisika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
