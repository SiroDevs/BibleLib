      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "Ee Mungu ulipizaye kisasi, uangaze sasa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
