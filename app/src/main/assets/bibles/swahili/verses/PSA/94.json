      "attrs": {
        "style": "q2",
        "vid": "PSA 94:4"
      },
      "items": [
        {
          "text": "watenda mabaya wote wamejaa majivuno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
