        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uovu Wa Wanadamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "PSA.14"
          },
          "items": [
            {
              "text": "Zaburi 14",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Mtindo wa mahalathi. Utenzi wa Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpumbavu anasema moyoni mwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "\"Hakuna Mungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "Wameharibika, na njia zao ni za uovu kabisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "hakuna hata mmoja atendaye mema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu anawachungulia wanadamu chini",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "kutoka mbinguni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "aone kama wako wenye akili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "wowote wanaomtafuta Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mmoja amegeukia mbali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "wameharibika wote pamoja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "hakuna atendaye mema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "Naam, hakuna hata mmoja!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, watendao mabaya kamwe hawatajifunza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "wale ambao huwala watu wangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "kama watu walavyo mkate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "hao ambao hawamwiti Mungu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo waliingiwa na hofu kuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "ambapo hapakuwa cha kutetemesha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "Mungu alitawanya mifupa ya wale waliokushambulia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "uliwaaibisha, kwa sababu Mungu aliwadharau.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laiti wokovu wa Israeli ungalikuja kutoka Sayuni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "Wakati Mungu arejeshapo wafungwa wa watu wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "Yakobo na ashangilie, Israeli na afurahi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    }
  ],
