      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:3"
      },
      "items": [
        {
          "text": "naye hufanya lolote limpendezalo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
