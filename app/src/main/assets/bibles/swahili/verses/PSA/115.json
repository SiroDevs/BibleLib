              "attrs": {
                "verseId": "PSA.115.1",
                "verseOrgIds": [
                  "PSA.115.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", sio kwetu sisi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
