      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:2"
      },
      "items": [
        {
          "text": "\"Yuko wapi Mungu wao?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
