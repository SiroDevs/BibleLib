      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "kwa sababu ya upendo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
