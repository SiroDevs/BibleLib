          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sanamu zao ni za fedha na dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
