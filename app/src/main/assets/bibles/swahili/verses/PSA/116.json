      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:1"
      },
      "items": [
        {
          "text": "amesikia kilio changu ili anihurumie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
