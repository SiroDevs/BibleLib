              "attrs": {
                "verseId": "PSA.116.1",
                "verseOrgIds": [
                  "PSA.116.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa maana amesikia sauti yangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
