          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu amenitegea sikio lake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
