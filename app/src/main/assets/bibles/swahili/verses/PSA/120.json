          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wangu kwa kuwa naishi Mesheki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
