      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:3"
      },
      "items": [
        {
          "text": "au akufanyie nini zaidi, ewe ulimi mdanganyifu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
