      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:6"
      },
      "items": [
        {
          "text": "miongoni mwa wale wanaochukia amani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
