    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mungu Mlinzi Wetu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 91:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye akaaye mahali pa salama pake Yeye Aliye Juu Sana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "atadumu katika uvuli wake Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 91:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitasema kumhusu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.2",
                "verseOrgIds": [
                  "PSA.91.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Yeye ndiye kimbilio langu na ngome yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "Mungu wangu, ambaye ninamtumaini.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 91:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika yeye ataniokoa na mtego wa mwindaji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "na maradhi ya kuambukiza ya kuua.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 91:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atakufunika kwa manyoya yake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "chini ya mbawa zake utapata kimbilio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "uaminifu wake utakuwa ngao na kinga yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 91:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hutaogopa vitisho vya usiku,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:5"
      },
      "items": [
        {
          "text": "wala mshale urukao mchana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 91:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala maradhi ya kuambukiza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:6"
      },
      "items": [
        {
          "text": "yanayonyemelea gizani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:6"
      },
      "items": [
        {
          "text": "wala tauni iharibuyo adhuhuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 91:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijapo watu elfu wataangukia kando yako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "kumi elfu mkono wako wa kuume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "lakini haitakukaribia wewe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 91:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utatazama tu kwa macho yako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:8"
      },
      "items": [
        {
          "text": "na kuona adhabu ya waovu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 91:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ukimfanya Aliye Juu Sana kuwa makao yako:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:9"
      },
      "items": [
        {
          "text": "naam,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.9",
                "verseOrgIds": [
                  "PSA.91.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ambaye ni kimbilio langu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 91:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi hakuna madhara yatakayokupata wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:10"
      },
      "items": [
        {
          "text": "hakuna maafa yataikaribia hema yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 91:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa atawaagiza malaika zake kwa ajili yako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:11"
      },
      "items": [
        {
          "text": "wakulinde katika njia zako zote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 91:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikononi mwao watakuinua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:12"
      },
      "items": [
        {
          "text": "ili usijikwae mguu wako kwenye jiwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 91:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utawakanyaga simba na nyoka wakali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:13"
      },
      "items": [
        {
          "text": "simba mkubwa na nyoka utawaponda kwa miguu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 91:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.14",
                "verseOrgIds": [
                  "PSA.91.14"
                ]
              }
            }
          ]
        },
        {
          "text": "asema, \"Kwa kuwa ananipenda, nitamwokoa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:14"
      },
      "items": [
        {
          "text": "nitamlinda, kwa kuwa analikiri Jina langu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 91:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataniita, nami nitamjibu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:15"
      },
      "items": [
        {
          "text": "nitakuwa pamoja naye katika taabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:15"
      },
      "items": [
        {
          "text": "nitamwokoa na kumheshimu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 91:16"
          },
