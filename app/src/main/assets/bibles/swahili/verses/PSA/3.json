      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 3:8"
      },
      "items": [
        {
          "text": "Baraka yako na iwe juu ya watu wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        }
