          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitaogopa makumi elfu ya adui,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:6"
      },
      "items": [
        {
          "text": "wanaojipanga dhidi yangu kila upande.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
