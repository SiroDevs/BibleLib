      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 137:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tutaimbaje nyimbo za",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.4",
                "verseOrgIds": [
                  "PSA.137.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:4"
      },
      "items": [
        {
          "text": "tukiwa nchi ya kigeni?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 137:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikikusahau wewe, ee Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:5"
      },
      "items": [
        {
          "text": "basi mkono wangu wa kuume na usahau ujuzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 137:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulimi wangu ushikamane na kaakaa la kinywa changu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "kama sitakukumbuka wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "kama nisipokufikiri Yerusalemu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "kuwa furaha yangu kubwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
