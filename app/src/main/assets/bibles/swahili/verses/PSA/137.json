            "sid": "PSA 137:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kando ya mito ya Babeli tuliketi, tukaomboleza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:1"
      },
      "items": [
        {
          "text": "tulipokumbuka Sayuni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 137:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenye miti ya huko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:2"
      },
      "items": [
        {
          "text": "tulitundika vinubi vyetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 137:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa maana huko hao waliotuteka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "walitaka tuwaimbie nyimbo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "watesi wetu walidai nyimbo za furaha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "walisema, \"Tuimbieni wimbo mmoja kati ya nyimbo za Sayuni!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
