              "attrs": {
                "verseId": "PSA.137.7",
                "verseOrgIds": [
                  "PSA.137.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", walichokifanya Waedomu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "siku ile Yerusalemu ilipoanguka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "Walisema, \"Bomoa, Bomoa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "mpaka kwenye misingi yake!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 137:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee binti Babeli, uliyehukumiwa kuangamizwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:8"
      },
      "items": [
        {
          "text": "heri yeye atakayekulipiza wewe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:8"
      },
      "items": [
        {
          "text": "kwa yale uliyotutenda sisi:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 137:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye ambaye atawakamata watoto wako wachanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:9"
      },
      "items": [
        {
          "text": "na kuwaponda juu ya miamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
