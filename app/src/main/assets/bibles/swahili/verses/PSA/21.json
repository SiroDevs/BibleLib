        {
          "text": "Zaburi 21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shukrani Kwa Mungu Kwa Ajili Ya Ushindi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Zaburi ya Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.1",
                "verseOrgIds": [
                  "PSA.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", mfalme huzifurahia nguvu zako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:1"
      },
      "items": [
        {
          "text": "Tazama jinsi ilivyo kuu furaha yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:1"
      },
      "items": [
        {
          "text": "kwa ushindi unaompa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.1",
            "verseOrgIds": [
              "PSA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umempa haja ya moyo wake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:2"
      },
      "items": [
        {
          "text": "na hukumzuilia maombi ya midomo yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.2",
            "verseOrgIds": [
              "PSA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulimkaribisha kwa baraka tele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:3"
      },
      "items": [
        {
          "text": "na kumvika taji ya dhahabu safi kichwani pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.3",
            "verseOrgIds": [
              "PSA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikuomba maisha, nawe ukampa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:4"
      },
      "items": [
        {
          "text": "wingi wa siku milele na milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.4",
            "verseOrgIds": [
              "PSA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutokana na ushindi uliompa, utukufu wake ni mkubwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:5"
      },
      "items": [
        {
          "text": "umeweka juu yake fahari na utukufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.5",
            "verseOrgIds": [
              "PSA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika umempa baraka za milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:6"
      },
      "items": [
        {
          "text": "umemfanya awe na furaha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:6"
      },
      "items": [
        {
          "text": "kwa shangwe ya uwepo wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.6",
            "verseOrgIds": [
              "PSA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa mfalme anamtumaini",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.7",
                "verseOrgIds": [
                  "PSA.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:7"
      },
      "items": [
        {
          "text": "kwa upendo usiokoma wa Aliye Juu Sana hatatikiswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.7",
            "verseOrgIds": [
              "PSA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkono wako utawashika adui zako wote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:8"
      },
      "items": [
        {
          "text": "mkono wako wa kuume utawakamata adui zako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.8",
            "verseOrgIds": [
              "PSA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati utakapojitokeza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "utawafanya kama tanuru ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "Katika ghadhabu yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.21.9",
                "verseOrgIds": [
                  "PSA.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "atawameza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:9"
      },
      "items": [
        {
          "text": "moto wake utawateketeza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.9",
            "verseOrgIds": [
              "PSA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utawaangamiza wazao wao kutoka duniani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:10"
      },
      "items": [
        {
          "text": "uzao wao kutoka wanadamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.10",
            "verseOrgIds": [
              "PSA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa watapanga mabaya dhidi yako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:11"
      },
      "items": [
        {
          "text": "na kutunga hila, hawawezi kufanikiwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.11",
            "verseOrgIds": [
              "PSA.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa utawafanya wakimbie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:12"
      },
      "items": [
        {
          "text": "utakapowalenga usoni pao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 21:12"
      },
      "items": [
        {
          "text": "kwa mshale kutoka kwenye upinde wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.21.12",
            "verseOrgIds": [
              "PSA.21.13"
            ]
          }
        }
      ]
    },
