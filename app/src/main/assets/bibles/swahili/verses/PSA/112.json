    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "Heri mtu yule amchaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.112.1",
                "verseOrgIds": [
                  "PSA.112.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "mtu yule apendezwaye sana na amri zake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 112:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watoto wake watakuwa wenye uwezo katika nchi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:2"
      },
      "items": [
        {
          "text": "kizazi cha watu waadilifu kitabarikiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 112:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumbani mwake kuna mali na utajiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:3"
      },
      "items": [
        {
          "text": "haki yake hudumu milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 112:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata gizani nuru humzukia mtu mwadilifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:4"
      },
      "items": [
        {
          "text": "yule mwenye rehema, huruma na haki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 112:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mema yatamjia mtu yule aliye mkarimu na mwenye kukopesha bila riba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:5"
      },
      "items": [
        {
          "text": "anayefanya mambo yake kwa haki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 112:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika hatatikisika kamwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:6"
      },
      "items": [
        {
          "text": "mtu mwenye haki atakumbukwa milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 112:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hataogopa habari mbaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:7"
      },
      "items": [
        {
          "text": "moyo wake ni thabiti, ukimtegemea",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.112.7",
                "verseOrgIds": [
                  "PSA.112.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 112:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wake ni salama, hatakuwa na hofu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:8"
      },
      "items": [
        {
          "text": "mwishoni ataona ushindi dhidi ya adui zake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 112:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ametawanya vipawa vyake kwa ukarimu akawapa maskini;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "haki yake hudumu milele;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "pembe yake itatukuzwa kwa heshima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 112:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mwovu ataona na kuchukizwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "atasaga meno yake na kutoweka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "kutamani kwa mtu mwovu kutaishia patupu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    }
