      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Furaha Ya Kweli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
