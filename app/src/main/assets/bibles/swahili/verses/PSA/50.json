      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "au kuchukua agano langu midomoni mwako?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
