      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:18"
      },
      "items": [
        {
          "text": "unapiga kura yako pamoja na wazinzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.18",
            "verseOrgIds": [
              "PSA.50.18"
            ]
          }
        }
      ]
    },
    {
