      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:17"
      },
      "items": [
        {
          "text": "na kuyatupa maneno yangu nyuma yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
        }
      ]
    },
    {
