      },
      "items": [
        {
          "text": "75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mungu Ni Mwamuzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Mtindo wa \"Usiharibu!\" Zaburi ya Asafu. Wimbo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 75:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, tunakushukuru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "tunakushukuru wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "kwa kuwa jina lako li karibu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "watu husimulia matendo yako ya ajabu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 75:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unasema, \"Ninachagua wakati maalum;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:2"
      },
      "items": [
        {
          "text": "ni mimi nihukumuye kwa haki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 75:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati dunia na watu wake wote inapotetemeka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:3"
      },
      "items": [
        {
          "text": "ni mimi ninayezishikilia nguzo zake imara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 75:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa wale wenye majivuno ninasema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "'Msijisifu tena,'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "kwa wale waovu, 'Msiinue pembe zenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 75:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msiinue pembe zenu dhidi ya mbingu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:5"
      },
      "items": [
        {
          "text": "msiseme kwa shingo zilizonyooshwa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 75:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna yeyote atokaye mashariki wala magharibi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:6"
      },
      "items": [
        {
          "text": "au kutoka jangwani awezaye kumkweza mwanadamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 75:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali Mungu ndiye ahukumuye:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:7"
      },
      "items": [
        {
          "text": "Humshusha huyu na kumkweza mwingine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 75:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkononi mwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.75.8",
                "verseOrgIds": [
                  "PSA.75.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kuna kikombe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "kilichojaa mvinyo unaotoka povu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "uliochanganywa na vikolezo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "huumimina, nao waovu wote wa dunia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "hunywa mpaka tone la mwisho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 75:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali mimi, nitatangaza hili milele;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:9"
      },
      "items": [
        {
          "text": "nitaimba sifa kwa Mungu wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 75:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitazikatilia mbali pembe za waovu wote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:10"
      },
      "items": [
        {
          "text": "bali pembe za wenye haki zitainuliwa juu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    }
  ],
