  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "PSA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuomba Ulinzi Wa Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Mtindo wa \"Usiharibu!\" Utenzi wa Daudi. Wakati Sauli alipotuma wapelelezi nyumbani mwa Daudi ili wamuue.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, uniokoe na adui zangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:1"
      },
      "items": [
        {
          "text": "unilinde kutokana na hao wanaoinuka dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uniponye na watu watendao mabaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:2"
      },
      "items": [
        {
          "text": "uniokoe kutokana na wamwagao damu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama wanavyonivizia!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "Watu wakali wananifanyia hila,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "ingawa Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.3",
                "verseOrgIds": [
                  "PSA.59.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", mimi sijakosea",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "wala kutenda dhambi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sijatenda kosa; hata hivyo wako tayari kunishambulia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "Inuka unisaidie, uone hali yangu mbaya!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.5",
                "verseOrgIds": [
                  "PSA.59.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, Mungu wa Israeli!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "Zinduka uyaadhibu mataifa yote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "usionyeshe huruma kwa wasaliti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurudi wakati wa jioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "wakibweka kama mbwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "wakiuzurura mji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama yale wanayotema kutoka vinywa vyao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "hutema upanga kutoka midomo yao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "nao husema, \"Ni nani atakayetusikia?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.8",
                "verseOrgIds": [
                  "PSA.59.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", uwacheke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:8"
      },
      "items": [
        {
          "text": "unayadharau mataifa hayo yote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee nguvu yangu, ninakutazama wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:9"
      },
      "items": [
        {
          "text": "wewe, Ee Mungu, ndiwe ngome yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu wangu unipendaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 59:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "Mungu atanitangulia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "naye atanifanya niwachekelee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "wale wanaonisingizia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini usiwaue, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.59.11",
                "verseOrgIds": [
                  "PSA.59.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", ngao yetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "au sivyo watu wangu watasahau.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "Katika uwezo wako wafanye watangetange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "na uwashushe chini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya dhambi za vinywa vyao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "kwa ajili ya maneno ya midomo yao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "waache wanaswe katika kiburi chao.",
          "type": "text",
          "attrs": {
