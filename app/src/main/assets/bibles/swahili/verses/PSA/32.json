      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:7"
      },
      "items": [
        {
          "text": "utaniepusha na taabu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
