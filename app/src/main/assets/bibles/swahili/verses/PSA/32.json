          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shangilieni katika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.11",
                "verseOrgIds": [
                  "PSA.32.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na mfurahi, enyi wenye haki!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:11"
      },
      "items": [
        {
          "text": "Imbeni, nyote mlio wanyofu wa moyo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
