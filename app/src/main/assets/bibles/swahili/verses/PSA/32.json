      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:8"
      },
      "items": [
        {
          "text": "nitakushauri na kukuangalia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
