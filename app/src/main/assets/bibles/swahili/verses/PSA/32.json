      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "wasio na akili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "ambao ni lazima waongozwe kwa lijamu na hatamu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "la sivyo hawatakukaribia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mwovu ana taabu nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:10"
      },
      "items": [
        {
          "text": "bali upendo usio na kikomo wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.10",
                "verseOrgIds": [
                  "PSA.32.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:10"
      },
      "items": [
        {
          "text": "unamzunguka mtu anayemtumaini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
