              "attrs": {
                "verseId": "PSA.138.1",
                "verseOrgIds": [
                  "PSA.138.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwa moyo wangu wote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
