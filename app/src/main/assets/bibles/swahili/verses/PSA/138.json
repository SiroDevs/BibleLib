      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:1"
      },
      "items": [
        {
          "text": "mbele ya \"miungu\" nitaimba sifa zako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
