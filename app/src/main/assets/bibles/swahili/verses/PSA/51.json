        "sid": "PSA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuomba Msamaha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Zaburi ya Daudi. Baada ya kukemewa na nabii Nathani kwa kuzini na Bathsheba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, unihurumie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "kwa kadiri ya upendo wako usiokoma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "kwa kadiri ya huruma yako kuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "uyafute makosa yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unioshe na uovu wangu wote",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:2"
      },
      "items": [
        {
          "text": "na unitakase dhambi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ninajua makosa yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:3"
      },
      "items": [
        {
          "text": "na dhambi yangu iko mbele yangu daima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhidi yako, wewe peke yako, nimetenda dhambi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "na kufanya yaliyo mabaya machoni pako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "ili uthibitike kuwa wa kweli unenapo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "na kuwa na haki utoapo hukumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika mimi nilizaliwa mwenye dhambi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:5"
      },
      "items": [
        {
          "text": "mwenye dhambi tangu nilipotungwa mimba kwa mama yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika wewe wapendezwa na kweli itokayo moyoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:6"
      },
      "items": [
        {
          "text": "ndani sana ya moyo wangu wanifundisha hekima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nioshe kwa hisopo, nami nitakuwa safi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:7"
      },
      "items": [
        {
          "text": "unisafishe, nami nitakuwa mweupe kuliko theluji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unipe kusikia furaha na shangwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:8"
      },
      "items": [
        {
          "text": "mifupa uliyoiponda na ifurahi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufiche uso wako usizitazame dhambi zangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:9"
      },
      "items": [
        {
          "text": "na uufute uovu wangu wote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, uniumbie moyo safi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:10"
      },
      "items": [
        {
          "text": "uifanye upya roho ya uthabiti ndani yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usinitupe kutoka mbele zako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:11"
      },
      "items": [
        {
          "text": "wala kuniondolea Roho wako Mtakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unirudishie tena furaha ya wokovu wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:12"
      },
      "items": [
        {
          "text": "unipe roho ya utii, ili initegemeze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nitakapowafundisha wakosaji njia zako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:13"
      },
      "items": [
        {
          "text": "na wenye dhambi watakugeukia wewe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, Mungu uniokoaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "niokoe na hatia ya kumwaga damu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "nao ulimi wangu utaimba juu ya haki yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.51.15",
                "verseOrgIds": [
                  "PSA.51.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", fungua midomo yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:15"
      },
      "items": [
        {
          "text": "na kinywa changu kitatangaza sifa zako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 51:16"
          },
          "items": [
            {
              "text": "16",
