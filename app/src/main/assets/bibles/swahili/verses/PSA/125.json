          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.1",
                "verseOrgIds": [
                  "PSA.125.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kama mlima Sayuni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
