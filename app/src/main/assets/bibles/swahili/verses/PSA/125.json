      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "ambao hauwezi kutikisika, bali wadumu milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
