    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Kwa Ajili Ya Wokovu Wa Taifa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi ya Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 79:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, mataifa yameuvamia urithi wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "wamelinajisi Hekalu lako takatifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "wameifanya Yerusalemu kuwa magofu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 79:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wametoa maiti za watumishi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "kuwa chakula cha ndege wa angani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "na nyama ya watakatifu wako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "kwa wanyama wa nchi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 79:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamemwaga damu kama maji",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "kuzunguka Yerusalemu yote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "wala hakuna yeyote wa kuwazika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 79:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumekuwa kitu cha aibu kwa jirani zetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "cha dharau na mzaha kwa wale wanaotuzunguka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 79:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata lini, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.79.5",
                "verseOrgIds": [
                  "PSA.79.5"
                ]
              }
            }
          ]
        },
        {
          "text": "? Je, wewe utakasirika milele?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:5"
      },
      "items": [
        {
          "text": "Wivu wako utawaka kama moto hadi lini?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 79:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaga ghadhabu yako kwa mataifa yasiyokukubali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "juu ya falme za hao wasioliitia jina lako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 79:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa maana wamemrarua Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:7"
      },
      "items": [
        {
          "text": "na kuharibu nchi ya makao yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 79:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usituhesabie dhambi za baba zetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "huruma yako na itujie hima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "kwa maana tu wahitaji mno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 79:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu Mwokozi wetu, utusaidie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "kwa ajili ya utukufu wa jina lako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "tuokoe na kutusamehe dhambi zetu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "kwa ajili ya jina lako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 79:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini mataifa waseme,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "\"Yuko wapi Mungu wenu?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "Mbele ya macho yetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "dhihirisha kati ya mataifa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "kwamba unalipiza kisasi damu iliyomwagwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "ya watumishi wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 79:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilio cha huzuni cha wafungwa kifike mbele zako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "kwa nguvu za mkono wako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "hifadhi wale waliohukumiwa kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 79:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipize jirani zetu mara saba vifuani mwao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:12"
      },
      "items": [
        {
          "text": "aibu walizovurumisha juu yako, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.79.12",
                "verseOrgIds": [
                  "PSA.79.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 79:13"
          },
          "items": [
