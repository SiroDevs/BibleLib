      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:11"
      },
      "items": [
        {
          "text": "Mungu aghadhibikaye kila siku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
