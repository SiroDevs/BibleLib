        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.1",
                "verseOrgIds": [
                  "PSA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wangu, ninakukimbilia wewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:1"
      },
      "items": [
        {
          "text": "uniokoe na kunikomboa na wote wanaonifuatia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
