          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "la sivyo watanirarua kama simba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.3"
