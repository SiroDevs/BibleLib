          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu ya Kushi, Mbenyamini.",
          "type": "text"
        }
      ]
    },
