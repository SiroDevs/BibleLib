      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:2"
      },
      "items": [
        {
          "text": "na kunichana vipande vipande, asiwepo wa kuniokoa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
