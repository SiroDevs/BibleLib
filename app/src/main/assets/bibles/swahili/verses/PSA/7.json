      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:10"
      },
      "items": [
        {
          "text": "awaokoaye wanyofu wa moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
