          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.8",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu Mwenye Nguvu Zote, sikia maombi yangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
