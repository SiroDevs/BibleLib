    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:8"
      },
      "items": [
        {
          "text": "nisikilize, Ee Mungu wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 84:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, uitazame ngao yetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:9"
      },
      "items": [
        {
          "text": "mtazame kwa wema mpakwa mafuta wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
