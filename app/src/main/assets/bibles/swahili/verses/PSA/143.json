      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "katika uaminifu na haki yako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
