          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimhukumu mtumishi wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
