          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njia yao na iwe giza na ya utelezi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
