                "verseOrgIds": [
                  "PSA.35.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akiwafukuza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
