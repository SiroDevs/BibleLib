      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:5"
      },
      "items": [
        {
          "text": "malaika wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
