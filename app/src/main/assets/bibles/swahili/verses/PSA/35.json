        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.1",
                "verseOrgIds": [
                  "PSA.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", pingana na wale wanaopingana nami,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:1"
      },
      "items": [
        {
          "text": "upigane na hao wanaopigana nami.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
