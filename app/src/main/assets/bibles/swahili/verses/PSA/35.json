    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "kwa maangamizo yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nafsi yangu itashangilia katika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.9",
                "verseOrgIds": [
                  "PSA.35.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:9"
      },
      "items": [
        {
          "text": "na kuufurahia wokovu wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitapaza sauti yangu nikisema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "\"Ni nani aliye kama wewe, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.10",
                "verseOrgIds": [
                  "PSA.35.10"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "Wewe huwaokoa maskini kutokana na wale walio na nguvu kuliko wao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "maskini na mhitaji kutokana na wanaowanyangʼanya!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashahidi wakatili wanainuka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:11"
      },
      "items": [
        {
          "text": "wananiuliza mambo nisiyoyajua.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wananilipa baya kwa jema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:12"
      },
      "items": [
        {
          "text": "na kuiacha nafsi yangu ukiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini walipokuwa wagonjwa, nilivaa nguo ya gunia",
          "type": "text",
          "attrs": {
