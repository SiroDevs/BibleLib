            "sid": "PSA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawe kama makapi yapeperushwayo na upepo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
