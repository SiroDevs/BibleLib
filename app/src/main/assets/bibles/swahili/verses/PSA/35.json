      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "warudishwe nyuma kwa hofu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
