      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "nitalisifu jina lako milele na milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
