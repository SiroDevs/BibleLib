      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "msifuni juu vileleni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
