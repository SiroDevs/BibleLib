            "number": "2",
            "style": "v",
            "sid": "PSA 148:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifuni, enyi malaika wake wote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:2"
      },
      "items": [
        {
          "text": "msifuni yeye, enyi jeshi lake lote la mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 148:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifuni yeye, enyi jua na mwezi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:3"
      },
      "items": [
        {
          "text": "msifuni yeye, enyi nyota zote zingʼaazo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 148:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msifuni yeye, enyi mbingu zilizo juu sana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:4"
      },
      "items": [
        {
          "text": "na ninyi maji juu ya anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
