      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:8"
      },
      "items": [
        {
          "text": "pepo za dhoruba zinazofanya amri zake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
