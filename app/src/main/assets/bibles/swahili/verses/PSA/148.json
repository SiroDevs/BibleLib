          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "umeme wa radi na mvua ya mawe, theluji na mawingu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
