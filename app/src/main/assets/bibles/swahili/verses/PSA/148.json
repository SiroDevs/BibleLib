            "sid": "PSA 148:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vilisifu jina la",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.148.5",
                "verseOrgIds": [
                  "PSA.148.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:5"
      },
      "items": [
        {
          "text": "kwa maana aliamuru navyo vikaumbwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
