            "number": "6",
            "style": "v",
            "sid": "PSA 148:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliviweka mahali pake milele na milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
