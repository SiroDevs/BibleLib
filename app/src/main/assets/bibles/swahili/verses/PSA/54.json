      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuomba Ulinzi Wa Mungu Kutokana Na Adui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Na ala za nyuzi za uimbaji. Utenzi wa Daudi. Wakati Wazifu walimwendea Sauli na kumjulisha, \"Je, Daudi hajifichi miongoni mwetu?\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu uniokoe kwa jina lako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:1"
      },
      "items": [
        {
          "text": "unifanyie hukumu kwa uwezo wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, sikia maombi yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:2"
      },
      "items": [
        {
          "text": "usikilize maneno ya kinywa changu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wageni wananishambulia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "watu wakatili wanayatafuta maisha yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "watu wasiomjali Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika Mungu ni msaada wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:4"
      },
      "items": [
        {
          "text": "Bwana ndiye anayenitegemeza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabaya na yawarudie wale wanaonisingizia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:5"
      },
      "items": [
        {
          "text": "kwa uaminifu wako uwaangamize.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakutolea dhabihu za hiari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.54.6",
                "verseOrgIds": [
                  "PSA.54.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", nitalisifu jina lako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "kwa kuwa ni vyema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ameniokoa katika shida zangu zote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:7"
      },
      "items": [
        {
          "text": "na macho yangu yamewatazama adui zangu kwa ushindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    }
  ],
