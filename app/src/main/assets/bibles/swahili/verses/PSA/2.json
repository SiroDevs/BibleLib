    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfalme Aliyechaguliwa Na Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini mataifa wanashauriana kufanya mabaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:1"
      },
      "items": [
        {
          "text": "na kabila za watu kula njama bure?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafalme wa dunia wanajipanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "na watawala wanajikusanya pamoja",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "dhidi ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.2.2",
                "verseOrgIds": [
                  "PSA.2.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "na dhidi ya Mpakwa Mafuta wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanasema, \"Tuvunje minyororo yao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:3"
      },
      "items": [
        {
          "text": "na kuvitupilia mbali vifungo vyao.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye atawalaye mbinguni hucheka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:4"
      },
      "items": [
        {
          "text": "Bwana huwadharau.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha huwakemea katika hasira yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:5"
      },
      "items": [
        {
          "text": "na kuwaogopesha katika ghadhabu yake, akisema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimemtawaza Mfalme wangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:6"
      },
      "items": [
        {
          "text": "juu ya Sayuni, mlima wangu mtakatifu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ushindi Wa Mfalme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitatangaza amri ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.2.7",
                "verseOrgIds": [
                  "PSA.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "Yeye aliniambia, \"Wewe ni Mwanangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "leo mimi nimekuzaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niombe, nami nitayafanya mataifa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "kuwa urithi wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "miisho ya dunia kuwa milki yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utawatawala kwa fimbo ya chuma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:9"
      },
      "items": [
        {
          "text": "na kuwavunjavunja kama chombo cha mfinyanzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, ninyi wafalme, kuweni na hekima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:10"
      },
      "items": [
        {
          "text": "mwonyeke, enyi watawala wa dunia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumikieni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.2.11",
                "verseOrgIds": [
                  "PSA.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa hofu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:11"
      },
      "items": [
        {
          "text": "na mshangilie kwa kutetemeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbusu Mwana, asije akakasirika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "nawe ukaangamizwa katika njia yako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "kwa maana hasira yake inaweza kuwaka ghafula.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "Heri wote wanaomkimbilia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    }
  ],
