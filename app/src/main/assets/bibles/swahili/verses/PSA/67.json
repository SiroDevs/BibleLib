        {
          "text": "Zaburi 67",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mataifa Yahimizwa Kumsifu Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Na ala za nyuzi za muziki. Zaburi. Wimbo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 67:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu aturehemu na kutubariki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:1"
      },
      "items": [
        {
          "text": "na kutuangazia nuru za uso wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 67:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili njia zako zijulikane duniani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:2"
      },
      "items": [
        {
          "text": "wokovu wako katikati ya mataifa yote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
