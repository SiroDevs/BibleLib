      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wimbo Wa Kumsifu Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 95:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooni, tumwimbie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.1",
                "verseOrgIds": [
                  "PSA.95.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa furaha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:1"
      },
      "items": [
        {
          "text": "tumfanyie kelele za shangwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:1"
      },
      "items": [
        {
          "text": "Mwamba wa wokovu wetu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 95:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuje mbele zake kwa shukrani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:2"
      },
      "items": [
        {
          "text": "tumtukuze kwa vinanda na nyimbo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 95:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.3",
                "verseOrgIds": [
                  "PSA.95.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ni Mungu mkuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:3"
      },
      "items": [
        {
          "text": "mfalme mkuu juu ya miungu yote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 95:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkononi mwake mna vilindi vya dunia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:4"
      },
      "items": [
        {
          "text": "na vilele vya milima ni mali yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 95:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahari ni yake, kwani ndiye aliifanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:5"
      },
      "items": [
        {
          "text": "na mikono yake iliumba nchi kavu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 95:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooni, tusujudu, tumwabudu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:6"
      },
      "items": [
        {
          "text": "tupige magoti mbele za",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.6",
                "verseOrgIds": [
                  "PSA.95.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Muumba wetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 95:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa maana yeye ndiye Mungu wetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "na sisi ni watu wa malisho yake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "kondoo chini ya utunzaji wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 95:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "Kama mkiisikia sauti yake leo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 95:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "msiifanye mioyo yenu migumu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:8"
      },
      "items": [
        {
          "text": "kama mlivyofanya kule Meriba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 95:8"
      },
      "items": [
        {
          "text": "kama mlivyofanya siku ile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:8"
      },
      "items": [
        {
          "text": "kule Masa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        },
        {
          "text": "jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 95:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambapo baba zenu walinijaribu na kunipima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:9"
      },
      "items": [
        {
          "text": "ingawa walikuwa wameyaona matendo yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 95:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa miaka arobaini nilikasirikia kizazi kile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:10"
      },
      "items": [
        {
          "text": "nikasema, \"Hawa ni taifa ambalo mioyo yao imepotoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:10"
      },
      "items": [
        {
          "text": "nao hawajazijua njia zangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 95:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo nikatangaza kwa kiapo katika hasira yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:11"
      },
      "items": [
        {
          "text": "\"Kamwe hawataingia rahani mwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    }
