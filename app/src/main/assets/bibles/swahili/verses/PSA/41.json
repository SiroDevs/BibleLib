      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "atambariki katika nchi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "na hatamwacha katika tamaa ya adui zake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
