      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "ameniinulia kisigino chake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
