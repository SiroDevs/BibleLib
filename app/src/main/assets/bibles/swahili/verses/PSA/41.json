          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.2",
                "verseOrgIds": [
                  "PSA.41.3"
                ]
              }
            }
          ]
        },
        {
          "text": "atamlinda na kuyahifadhi maisha yake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
