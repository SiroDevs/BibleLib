      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:11"
      },
      "items": [
        {
          "text": "kwa kuwa adui yangu hanishindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika uadilifu wangu unanitegemeza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:12"
      },
      "items": [
        {
          "text": "na kuniweka kwenye uwepo wako milele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
