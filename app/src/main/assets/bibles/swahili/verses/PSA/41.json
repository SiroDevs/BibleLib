    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:3"
      },
      "items": [
        {
          "text": "atamwinua kutoka kitandani mwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilisema, \"Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.4",
                "verseOrgIds": [
                  "PSA.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nihurumie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:4"
      },
      "items": [
        {
          "text": "niponye, maana nimekutenda dhambi wewe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adui zangu wanasema kwa hila,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:5"
      },
      "items": [
        {
          "text": "\"Lini atakufa, na jina lake litokomee kabisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila anapokuja mtu kunitazama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "huzungumza uongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "huku moyo wake hukusanya masingizio;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "kisha huondoka na kuyasambaza huku na huko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
