    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Zaburi ya Daudi.",
          "type": "text"
        }
      ]
    },
    {
