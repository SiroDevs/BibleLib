      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:10"
      },
      "items": [
        {
          "text": "ukaniinue tena, ili niweze kuwalipiza kisasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
