          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.13",
                "verseOrgIds": [
                  "PSA.41.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        }
