          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heri mtu yule anayemjali mnyonge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
