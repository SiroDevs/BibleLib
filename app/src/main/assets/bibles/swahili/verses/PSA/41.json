      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.3",
                "verseOrgIds": [
                  "PSA.41.4"
                ]
              }
            }
          ]
        },
        {
          "text": "atamtegemeza awapo mgonjwa kitandani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
