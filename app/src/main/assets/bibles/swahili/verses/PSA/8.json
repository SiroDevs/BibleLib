                "verseId": "PSA.8.9",
                "verseOrgIds": [
                  "PSA.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", Bwana wetu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.10"
            ]
          }
        }
      ]
