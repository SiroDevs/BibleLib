  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "PSA 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Upumbavu Wa Kutegemea Mali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mwimbishaji. Zaburi ya wana wa Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikieni haya, enyi mataifa yote,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:1"
      },
      "items": [
        {
          "text": "sikilizeni, ninyi wote mkaao dunia hii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakubwa kwa wadogo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:2"
      },
      "items": [
        {
          "text": "matajiri na maskini pamoja:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinywa changu kitasema maneno ya hekima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:3"
      },
      "items": [
        {
          "text": "usemi wa moyo wangu utatoa ufahamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitatega sikio langu nisikilize mithali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:4"
      },
      "items": [
        {
          "text": "nitafafanua kitendawili kwa zeze:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini niogope siku mbaya zinapokuja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:5"
      },
      "items": [
        {
          "text": "wakati wadanganyifu waovu wanaponizunguka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wale wanaotegemea mali zao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:6"
      },
      "items": [
        {
          "text": "na kujivunia utajiri wao mwingi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna mwanadamu awaye yote",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "awezaye kuukomboa uhai wa mwingine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "au kumpa Mungu fidia kwa ajili yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fidia ya uhai ni gharama kubwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:8"
      },
      "items": [
        {
          "text": "hakuna malipo yoyote yanayotosha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kwamba aishi milele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:9"
      },
      "items": [
        {
          "text": "na asione uharibifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wote wanaona kwamba watu wenye hekima hufa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "wajinga na wapumbavu vivyo hivyo huangamia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "na kuwaachia wengine mali zao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makaburi yao yatabaki kuwa nyumba zao za milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "makao yao vizazi vyote;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "ingawa walikuwa na mashamba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "na kuyaita kwa majina yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mwanadamu, licha ya utajiri wake, hadumu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:12"
      },
      "items": [
        {
          "text": "anafanana na mnyama aangamiaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hii ndiyo hatima ya wale wanaojitumainia wenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "pia ya wafuasi wao, waliothibitisha misemo yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama kondoo, wamewekewa kwenda kaburini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "nacho kifo kitawala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "Wanyofu watawatawala asubuhi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "maumbile yao yataozea kaburini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "mbali na majumba yao makubwa ya fahari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Mungu atakomboa uhai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        },
        {
          "text": "wangu na kaburi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:15"
      },
      "items": [
        {
          "text": "hakika atanichukua kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
