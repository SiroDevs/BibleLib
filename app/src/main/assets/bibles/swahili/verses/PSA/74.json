        {
          "text": "Zaburi 74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Kwa Ajili Ya Taifa Kuokolewa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Utenzi wa Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 74:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, mbona umetukataa milele?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "Mbona hasira yako inatoka moshi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "juu ya kondoo wa malisho yako?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 74:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbuka watu uliowanunua zamani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "kabila la urithi wako, ambao uliwakomboa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "Mlima Sayuni, ambamo uliishi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 74:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geuza hatua zako kuelekea magofu haya ya kudumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "uharibifu wote huu ambao adui ameuleta pale patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 74:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adui zako wamenguruma pale ulipokutana nasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:4"
      },
      "items": [
        {
          "text": "wanaweka bendera zao kama alama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 74:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walifanya kama watu wanaotumia mashoka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:5"
      },
      "items": [
        {
          "text": "kukata kichaka cha miti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 74:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walivunjavunja milango yote iliyonakshiwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:6"
      },
      "items": [
        {
          "text": "kwa mashoka na vishoka vyao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 74:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliteketeza kabisa mahali pako patakatifu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:7"
      },
      "items": [
        {
          "text": "wakayanajisi makao ya Jina lako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 74:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walisema mioyoni mwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "\"Tutawaponda kabisa!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "Walichoma kila mahali ambapo Mungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "aliabudiwa katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 74:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatukupewa ishara za miujiza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "hakuna manabii waliobaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "hakuna yeyote kati yetu ajuaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "hali hii itachukua muda gani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 74:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu, mtesi atakudhihaki mpaka lini?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "Je, adui watalitukana jina lako milele?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 74:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini unazuia mkono wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "mkono wako wa kuume?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "Uutoe kutoka makunjo ya vazi lako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "na uwaangamize!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 74:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wewe, Ee Mungu, ni mfalme wangu tangu zamani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:12"
      },
      "items": [
        {
          "text": "unaleta wokovu duniani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 74:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wewe uliyeigawanya bahari kwa uweza wako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:13"
      },
      "items": [
        {
          "text": "ulivunja vichwa vya wanyama wakubwa wa kutisha katika maji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 74:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wewe uliyeponda vichwa vya Lewiathani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:14"
      },
      "items": [
        {
          "text": "nawe ukamtoa kama chakula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:14"
      },
      "items": [
        {
          "text": "kwa viumbe vya jangwani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 74:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wewe uliyefungua chemchemi na vijito,",
          "type": "text",
          "attrs": {
