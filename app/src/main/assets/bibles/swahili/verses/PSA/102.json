    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Ya Mtu Mwenye Taabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Maombi ya mtu aliyechoka. Anapoteseka na kumimina malalamiko yake kwa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 102:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.1",
                "verseOrgIds": [
                  "PSA.102.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", usikie maombi yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:1"
      },
      "items": [
        {
          "text": "kilio changu cha kuomba msaada kikufikie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.1",
            "verseOrgIds": [
              "PSA.102.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 102:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usinifiche uso wako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "ninapokuwa katika shida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "Unitegee sikio lako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:2"
      },
      "items": [
        {
          "text": "ninapoita, unijibu kwa upesi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.2",
            "verseOrgIds": [
              "PSA.102.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 102:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa siku zangu zinatoweka kama moshi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:3"
      },
      "items": [
        {
          "text": "mifupa yangu inaungua kama kaa la moto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.3",
            "verseOrgIds": [
              "PSA.102.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 102:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wangu umefifia na kunyauka kama jani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:4"
      },
      "items": [
        {
          "text": "ninasahau kula chakula changu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.4",
            "verseOrgIds": [
              "PSA.102.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 102:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu ya kusononeka kwangu kwa uchungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:5"
      },
      "items": [
        {
          "text": "nimebakia ngozi na mifupa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.5",
            "verseOrgIds": [
              "PSA.102.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 102:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimekuwa kama bundi wa jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:6"
      },
      "items": [
        {
          "text": "kama bundi kwenye magofu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.6",
            "verseOrgIds": [
              "PSA.102.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 102:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilalapo sipati usingizi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:7"
      },
      "items": [
        {
          "text": "nimekuwa kama ndege mpweke",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:7"
      },
      "items": [
        {
          "text": "kwenye paa la nyumba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.7",
            "verseOrgIds": [
              "PSA.102.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 102:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchana kutwa adui zangu hunidhihaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:8"
      },
      "items": [
        {
          "text": "wale wanaonizunguka hutumia jina langu kama laana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.8",
            "verseOrgIds": [
              "PSA.102.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 102:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninakula majivu kama chakula changu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:9"
      },
      "items": [
        {
          "text": "na nimechanganya kinywaji changu na machozi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.9",
            "verseOrgIds": [
              "PSA.102.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 102:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu ya ghadhabu yako kuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:10"
      },
      "items": [
        {
          "text": "kwa maana umeniinua na kunitupa kando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.10",
            "verseOrgIds": [
              "PSA.102.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 102:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku zangu ni kama kivuli cha jioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:11"
      },
      "items": [
        {
          "text": "ninanyauka kama jani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.11",
            "verseOrgIds": [
              "PSA.102.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 102:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wewe, Ee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.12",
                "verseOrgIds": [
                  "PSA.102.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", umeketi katika kiti chako cha enzi milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:12"
      },
      "items": [
        {
          "text": "sifa zako za ukuu zaendelea vizazi vyote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.12",
            "verseOrgIds": [
              "PSA.102.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 102:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utainuka na kuihurumia Sayuni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "kwa maana ni wakati wa kumwonyesha wema;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:13"
      },
      "items": [
        {
          "text": "wakati uliokubalika umewadia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.13",
            "verseOrgIds": [
              "PSA.102.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 102:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana mawe yake ni ya thamani kwa watumishi wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:14"
      },
      "items": [
        {
          "text": "vumbi lake lenyewe hulionea huruma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.14",
            "verseOrgIds": [
              "PSA.102.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 102:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataifa wataogopa jina la",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.102.15",
                "verseOrgIds": [
                  "PSA.102.16"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.15",
            "verseOrgIds": [
              "PSA.102.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
