      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "naye hatabadilisha mawazo yake:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "\"Wewe ni kuhani milele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
