      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:4"
      },
      "items": [
        {
          "text": "kwa mfano wa Melkizedeki.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
