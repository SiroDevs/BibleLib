      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:2"
      },
      "items": [
        {
          "text": "utatawala katikati ya adui zako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
