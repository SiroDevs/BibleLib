            "number": "5",
            "style": "v",
            "sid": "PSA 110:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana yuko mkono wako wa kuume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:5"
      },
      "items": [
        {
          "text": "atawaponda wafalme siku ya ghadhabu yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 110:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atawahukumu mataifa, akilundika mizoga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:6"
      },
      "items": [
        {
          "text": "na kuwaponda watawala wa dunia nzima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 110:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atakunywa maji katika kijito kando ya njia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:7"
      },
      "items": [
        {
          "text": "kwa hiyo atainua kichwa chake juu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
