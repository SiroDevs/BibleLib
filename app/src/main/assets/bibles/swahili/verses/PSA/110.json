                "verseOrgIds": [
                  "PSA.110.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ataeneza fimbo yako ya utawala yenye nguvu kutoka Sayuni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
