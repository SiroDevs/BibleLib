                "verseOrgIds": [
                  "PSA.110.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ameapa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.4",
            "verseOrgIds": [
              "PSA.110.4"
            ]
          }
