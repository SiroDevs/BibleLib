          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hunihuisha nafsi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "Huniongoza katika njia za haki",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "kwa ajili ya jina lake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
