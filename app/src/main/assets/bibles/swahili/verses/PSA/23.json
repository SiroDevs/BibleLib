      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "siku zote za maisha yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
