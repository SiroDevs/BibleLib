          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawingu na giza nene vinamzunguka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
