      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:3"
      },
      "items": [
        {
          "text": "na huteketeza adui zake pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
