          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umeme wake wa radi humulika dunia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
