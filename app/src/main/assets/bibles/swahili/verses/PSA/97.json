              "attrs": {
                "verseId": "PSA.97.9",
                "verseOrgIds": [
                  "PSA.97.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ndiwe Uliye Juu Sana kuliko dunia yote;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
