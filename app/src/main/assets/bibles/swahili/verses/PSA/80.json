    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 80:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulileta mzabibu kutoka Misri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
