            "sid": "PSA 80:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu Mwenye Nguvu Zote, uturejeshe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
