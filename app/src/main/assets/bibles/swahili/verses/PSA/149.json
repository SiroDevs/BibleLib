              "attrs": {
                "verseId": "PSA.149.1",
                "verseOrgIds": [
                  "PSA.149.1"
                ]
              }
            }
          ]
        },
        {
          "text": "wimbo mpya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "sifa zake katika kusanyiko la watakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 149:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli na washangilie katika Muumba wao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:2"
      },
      "items": [
        {
          "text": "watu wa Sayuni na wafurahi katika Mfalme wao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 149:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na walisifu jina lake kwa kucheza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:3"
      },
      "items": [
        {
          "text": "na wampigie muziki kwa matari na kinubi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 149:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PSA.149.4",
                "verseOrgIds": [
                  "PSA.149.4"
                ]
              }
            }
          ]
        },
        {
          "text": "anapendezwa na watu wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:4"
      },
      "items": [
        {
          "text": "anawavika wanyenyekevu taji ya wokovu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 149:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watakatifu washangilie katika heshima hii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:5"
      },
      "items": [
        {
          "text": "na waimbe kwa shangwe vitandani mwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
