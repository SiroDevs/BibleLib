          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sifa za Mungu na ziwe vinywani mwao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:6"
      },
      "items": [
        {
          "text": "na upanga ukatao kuwili mikononi mwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
