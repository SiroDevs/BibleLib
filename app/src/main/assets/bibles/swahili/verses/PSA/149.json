      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "Mwimbieni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
