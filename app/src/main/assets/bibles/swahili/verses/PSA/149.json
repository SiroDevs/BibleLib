      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:8"
      },
      "items": [
        {
          "text": "wakuu wao kwa pingu za chuma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.8",
            "verseOrgIds": [
              "PSA.149.8"
            ]
          }
