          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kuwafanyia hukumu iliyoandikwa dhidi yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
