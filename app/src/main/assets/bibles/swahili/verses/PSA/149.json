      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:9"
      },
      "items": [
        {
          "text": "Huu ndio utukufu wa watakatifu wake wote.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
