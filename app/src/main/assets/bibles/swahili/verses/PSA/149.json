      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:7"
      },
      "items": [
        {
          "text": "na adhabu juu ya mataifa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        }
