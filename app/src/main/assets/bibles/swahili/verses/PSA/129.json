                "verseOrgIds": [
                  "PSA.129.8"
                ]
              }
            }
          ]
        },
        {
          "text": "iwe juu yako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
