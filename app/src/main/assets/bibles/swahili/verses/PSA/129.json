          "text": "Lakini",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
