      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:8"
      },
      "items": [
        {
          "text": "\"Baraka ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
