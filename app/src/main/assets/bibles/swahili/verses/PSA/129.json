      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:6"
      },
      "items": [
        {
          "text": "ambayo hunyauka kabla hayajakua;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.6",
            "verseOrgIds": [
              "PSA.129.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
