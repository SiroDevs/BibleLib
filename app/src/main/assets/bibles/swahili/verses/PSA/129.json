                "verseId": "PSA.129.4",
                "verseOrgIds": [
                  "PSA.129.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mwenye haki;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
