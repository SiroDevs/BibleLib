    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Utukufu Ulioahidiwa Wa Nyumba Mpya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAG 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ya ishirini na moja ya mwezi wa saba, neno la",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.1",
            "verseOrgIds": [
              "HAG.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.1",
                "verseOrgIds": [
                  "HAG.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "lilikuja kupitia nabii Hagai, kusema:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.1",
            "verseOrgIds": [
              "HAG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sema na Zerubabeli mwana wa Shealtieli, mtawala wa Yuda, kuhani mkuu Yoshua mwana wa Yehosadaki, na mabaki ya watu. Uwaulize,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
            "verseOrgIds": [
              "HAG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ni nani miongoni mwenu aliyebaki ambaye aliiona hii nyumba katika utukufu wake wa mwanzo? Sasa inaonekanaje kwenu? Je, haionekani kwenu kama si kitu?",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.3",
            "verseOrgIds": [
              "HAG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sasa uwe imara, ee Zerubabeli,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.4",
                "verseOrgIds": [
                  "HAG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": ". 'Kuwa imara, ee kuhani mkuu Yoshua mwana wa Yehosadaki. Mwe imara, enyi watu wote wa nchi,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.4",
                "verseOrgIds": [
                  "HAG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'na mfanye kazi. Kwa kuwa mimi nipo pamoja nanyi,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.4",
                "verseOrgIds": [
                  "HAG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.4",
            "verseOrgIds": [
              "HAG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Hili ndilo nililoagana nanyi mlipotoka katika nchi ya Misri. Pia Roho wangu anadumu katikati yenu. Msiogope.'",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.6",
                "verseOrgIds": [
                  "HAG.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote: 'Baada ya muda kidogo kwa mara nyingine nitazitikisa mbingu na nchi, bahari na nchi kavu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitatikisa mataifa yote, nacho kile kinachotamaniwa na mataifa yote kitakuja, nami nitaujaza utukufu katika nyumba hii,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.7",
                "verseOrgIds": [
                  "HAG.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Fedha ni mali yangu na dhahabu ni mali yangu,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.8",
                "verseOrgIds": [
                  "HAG.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Utukufu wa nyumba hii ya sasa utakuwa mkubwa kuliko utukufu wa ile nyumba ya mwanzoni,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.9",
                "verseOrgIds": [
                  "HAG.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote. 'Na mahali hapa nitawapa amani,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.9",
                "verseOrgIds": [
                  "HAG.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baraka Kwa Watu Waliotiwa Unajisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ya ishirini na nne ya mwezi wa tisa, katika mwaka wa pili wa utawala wa Mfalme Dario, neno la",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.10",
                "verseOrgIds": [
                  "HAG.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "lilikuja kwa nabii Hagai:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.11",
                "verseOrgIds": [
                  "HAG.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote: 'Ulizeni makuhani jinsi sheria inavyosema:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtu akibeba nyama iliyowekwa wakfu katika pindo la vazi lake, kisha lile pindo likagusa mkate au mchuzi, divai, mafuta au chakula kingine, je, kitu hicho kitakuwa kimewekwa wakfu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:12"
      },
      "items": [
        {
          "text": "Makuhani wakajibu, \"La hasha.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Hagai akasema, \"Je, kama mtu aliyetiwa unajisi kwa kugusa maiti akigusa mojawapo ya vitu hivi, kitu hicho kitakuwa kimetiwa unajisi?\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:13"
      },
      "items": [
        {
          "text": "Makuhani wakajibu, \"Ndiyo, huwa kimenajisiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Hagai akasema, \" 'Basi ndivyo walivyo machoni pangu hawa watu na taifa hili,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.14",
                "verseOrgIds": [
                  "HAG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". 'Lolote wafanyalo na chochote watoacho hapo ni najisi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Sasa fikirini kwa uangalifu kuanzia leo na kuendelea: tafakarini jinsi mambo yalivyokuwa kabla halijawekwa jiwe moja juu ya lingine katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.15",
                "verseOrgIds": [
                  "HAG.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mtu alipoendea lundo la nafaka la vipimo ishirini, kulikuwa na vipimo kumi tu. Wakati mtu alipoendea pipa la mvinyo ili kuchota vipimo hamsini, kulikuwa na vipimo ishirini tu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.16",
            "verseOrgIds": [
              "HAG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kazi zenu zote za mikono nilizipiga kwa ukame, ukungu na mvua ya mawe, lakini hata hivyo, hamkunigeukia mimi,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.17",
                "verseOrgIds": [
                  "HAG.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Tangu leo na kuendelea, kuanzia siku hii ya ishirini na nne ya mwezi wa tisa, tafakarini siku ambayo msingi wa Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.18",
                "verseOrgIds": [
                  "HAG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "uliwekwa. Tafakarini:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, bado kuna mbegu iliyobakia ghalani? Mpaka sasa, hakuna mzabibu au mtini, mkomamanga wala mzeituni uliozaa tunda.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:19"
      },
      "items": [
        {
          "text": "\" 'Kuanzia leo na kuendelea, nitawabariki.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zerubabeli Pete Ya Muhuri Ya",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.20",
                "verseOrgIds": [
                  "HAG.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "likamjia Hagai kwa mara ya pili katika siku ya ishirini na nne ya mwezi kusema:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HAG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwambie Zerubabeli mtawala wa Yuda kwamba nitazitikisa mbingu na nchi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.21",
            "verseOrgIds": [
              "HAG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HAG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitapindua viti vya enzi vya falme, na kuziharibu kabisa nguvu za falme za kigeni. Nitapindua magari ya vita pamoja na waendeshaji wake; farasi na wapanda farasi wataanguka, kila mmoja kwa upanga wa ndugu yake.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.22",
            "verseOrgIds": [
              "HAG.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HAG 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Katika siku ile,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, 'nitakuchukua wewe, mtumishi wangu Zerubabeli mwana wa Shealtieli,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": ". 'Nitakufanya kama pete yangu ya muhuri, kwa kuwa nimekuchagua,' asema",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        }
      ]
    }
