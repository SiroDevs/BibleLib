              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.1",
                "verseOrgIds": [
                  "EXO.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tazama, nimemchagua Bezaleli mwana wa Uri, mwana wa Huri, wa kabila la Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.2",
            "verseOrgIds": [
              "EXO.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nimemjaza Roho wa Mungu, pamoja na ustadi, uwezo na ujuzi katika aina zote za ufundi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kubuni michoro ya kupendeza katika ufundi wa dhahabu, fedha na shaba,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuchonga vito na kuvitia mahali, kufanya ufundi kwa mbao, na kujishughulisha na aina zote za ufundi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena nimemteua Oholiabu mwana wa Ahisamaki, wa kabila la Dani, ili kumsaidia. Pia mafundi wote nimewapa ustadi wa kutengeneza kila kitu nilichokuamuru wewe:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hema la Kukutania, Sanduku la Ushuhuda pamoja na kiti cha rehema juu yake, pia na vifaa vyote vya kwenye hema,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "meza na vifaa vyake, kinara cha taa cha dhahabu safi na vifaa vyake vyote, madhabahu ya kufukizia uvumba,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "madhabahu ya sadaka ya kuteketezwa na vyombo vyake vyote, sinia na kinara chake,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamoja na mavazi matakatifu yaliyofumwa ya kuhani Aroni, na mavazi kwa ajili ya wanawe wakati wanahudumu katika kazi ya ukuhani,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pia mafuta ya upako na uvumba wenye harufu nzuri kwa ajili ya Mahali Patakatifu. Watavitengeneza sawasawa kama vile nilivyokuagiza wewe.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.12",
                "verseOrgIds": [
                  "EXO.31.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waambie Waisraeli, 'Ninyi ni lazima mzishike Sabato zangu. Hii itakuwa ni ishara kati yangu na ninyi kwa ajili ya vizazi vijavyo, ili mpate kujua kwamba Mimi Ndimi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.13",
                "verseOrgIds": [
                  "EXO.31.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", niwafanyaye ninyi watakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mtaishika Sabato, kwa sababu ni takatifu kwenu. Yeyote atakayeinajisi lazima auawe, yeyote atakayefanya kazi siku hiyo lazima akafie mbali na watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa siku sita, mtafanya kazi, lakini siku ya saba ni Sabato ya kupumzika, takatifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.15",
                "verseOrgIds": [
                  "EXO.31.15"
                ]
              }
            }
          ]
        },
        {
          "text": ". Yeyote afanyaye kazi yoyote siku ya Sabato ni lazima auawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli wataishika Sabato, kuiadhimisha kwa vizazi vijavyo kuwa Agano la milele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itakuwa ishara kati yangu na Waisraeli milele, kwa kuwa kwa muda wa siku sita",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.17",
                "verseOrgIds": [
                  "EXO.31.17"
                ]
              }
            }
          ]
        },
        {
          "text": "aliumba mbingu na dunia, na siku ya saba akaacha kufanya kazi, akapumzika.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.31.18",
                "verseOrgIds": [
                  "EXO.31.18"
                ]
              }
            }
          ]
        },
        {
          "text": "alipomaliza kusema na Mose juu ya Mlima Sinai, Mungu akampa vile vibao viwili vya Ushuhuda, vibao vya mawe vilivyoandikwa kwa kidole cha Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
      ]
    }
  ],
