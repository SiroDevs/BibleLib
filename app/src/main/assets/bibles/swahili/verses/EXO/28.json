      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mavazi Mengine Ya Kikuhani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
