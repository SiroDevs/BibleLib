                "verseId": "EXO.28.30",
                "verseOrgIds": [
                  "EXO.28.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
