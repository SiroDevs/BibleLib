        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mungu akasema maneno haya yote:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.2",
                "verseOrgIds": [
                  "EXO.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, niliyekutoa Misri, kutoka nchi ya utumwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiwe na miungu mingine ila mimi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.3",
            "verseOrgIds": [
              "EXO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usijitengenezee sanamu katika umbo la kitu chochote kilicho juu mbinguni, au duniani chini, au ndani ya maji.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usivisujudie wala kuviabudu; kwa kuwa Mimi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.5",
                "verseOrgIds": [
                  "EXO.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, ni Mungu mwenye wivu, ninayewaadhibu watoto kwa ajili ya dhambi za baba zao hadi kizazi cha tatu na cha nne cha wanichukiao,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini ninaonyesha upendo kwa maelfu ya vizazi vya wale wanipendao na kuzishika amri zangu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usilitaje bure jina la",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.7",
                "verseOrgIds": [
                  "EXO.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.7",
                "verseOrgIds": [
                  "EXO.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": "hataacha kumhesabia hatia yeye alitajaye jina lake bure.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikumbuke siku ya Sabato, uitakase.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.8",
            "verseOrgIds": [
              "EXO.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa siku sita utafanya kazi na kutenda shughuli zako zote,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini siku ya saba ni Sabato kwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.10",
                "verseOrgIds": [
                  "EXO.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako. Siku hiyo hutafanya kazi yoyote, wewe, wala mwanao au binti yako, wala mtumishi wako wa kiume au wa kike, wala wanyama wako, wala mgeni aliye ndani ya malango yako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa kwa siku sita,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.11",
                "verseOrgIds": [
                  "EXO.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "aliumba mbingu na nchi, bahari na vyote vilivyomo, lakini akapumzika siku ya saba. Kwa hiyo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.11",
                "verseOrgIds": [
                  "EXO.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akaibariki siku ya Sabato na kuifanya takatifu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waheshimu baba yako na mama yako, ili upate kuishi siku nyingi katika nchi anayokupa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.12",
                "verseOrgIds": [
                  "EXO.20.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiue.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.13",
            "verseOrgIds": [
              "EXO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usizini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.14",
            "verseOrgIds": [
              "EXO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiibe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.15",
            "verseOrgIds": [
              "EXO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimshuhudie jirani yako uongo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.16",
            "verseOrgIds": [
              "EXO.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiitamani nyumba ya jirani yako. Usimtamani mke wa jirani yako, wala mtumishi wake wa kiume au wa kike, wala ngʼombe wake au punda wake, wala chochote kile alicho nacho jirani yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Watu Wanaogopa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "DEU.5.22-DEU.5.33"
          },
          "items": [
            {
              "text": "Kumbukumbu 5:22-33",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu walipoona ngurumo na radi, na kusikia mlio wa tarumbeta, na kuuona mlima katika moshi, walitetemeka kwa woga. Wakasimama mbali",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wakamwambia Mose, \"Sema nasi wewe mwenyewe, nasi tutakusikiliza. Lakini usimwache Mungu aseme nasi, la sivyo tutakufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akawaambia watu, \"Msiogope! Mungu amekuja kuwajaribu, ili kwamba hofu ya Mungu iwakalie, msitende dhambi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wakabaki mbali, wakati Mose alipolisogelea lile giza nene mahali pale Mungu alipokuwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sanamu Na Madhabahu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
