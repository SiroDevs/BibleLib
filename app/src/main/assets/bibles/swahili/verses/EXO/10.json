          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akamjibu, \"Iwe kama ulivyosema! Kamwe sitauona uso wako tena.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
