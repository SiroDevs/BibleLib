              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.19",
                "verseOrgIds": [
                  "EXO.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "akaugeuza upepo ukavuma kutoka magharibi, wenye nguvu nyingi, ambao uliwaondoa wale nzige na kuwapeleka kwenye Bahari ya Shamu. Hakuna nzige hata mmoja aliyebaki popote katika nchi ya Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.20",
                "verseOrgIds": [
                  "EXO.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akaufanya moyo wa Farao kuwa mgumu, wala hakuwaachia Waisraeli waondoke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        }
