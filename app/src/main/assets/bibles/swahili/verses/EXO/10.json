                  "EXO.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "akaufanya moyo wa Farao kuwa mgumu, hakuwa radhi kuwaachia waondoke.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akamwambia Mose, \"Ondoka mbele yangu! Hakikisha kuwa hutakuja mbele yangu tena! Siku ile utakapouona uso wangu utakufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
      ]
    },
