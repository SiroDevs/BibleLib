          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akajibu, \"Mara tu nitakapoondoka, nitamwomba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.29",
                "verseOrgIds": [
                  "EXO.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": "na kesho mainzi yataondoka kwa Farao, kwa maafisa wake na kwa watu wake. Hakikisha tu kwamba Farao hatatenda kwa udanganyifu tena kwa kutokuwaachia watu waende kumtolea",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.29",
                "verseOrgIds": [
                  "EXO.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": "dhabihu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
      ]
    },
