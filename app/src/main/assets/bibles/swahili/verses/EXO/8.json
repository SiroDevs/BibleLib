                "verseOrgIds": [
                  "EXO.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "akafanya lile Mose alilomwomba. Mainzi yakaondoka kwa Farao, kwa maafisa wake na kwa watu wake, wala hakuna hata inzi aliyebakia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
