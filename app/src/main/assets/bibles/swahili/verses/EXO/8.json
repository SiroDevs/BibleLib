              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wakati huu pia Farao akaushupaza moyo wake, wala hakuwaruhusu Waisraeli waondoke.",
          "type": "text",
          "attrs": {
