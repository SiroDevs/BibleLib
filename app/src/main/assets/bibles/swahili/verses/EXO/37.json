              "type": "text"
            }
          ]
        },
        {
          "text": "Akatengeneza pete mbili za dhahabu kwa ajili ya madhabahu chini ya huo ukingo, zikiwa mbili kila upande, za kushikilia hiyo mipiko iliyotumika kuyabebea madhabahu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.27",
            "verseOrgIds": [
