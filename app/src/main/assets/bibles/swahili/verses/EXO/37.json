          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatengeneza mipiko kwa miti ya mshita na kuifunika kwa dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
            "verseOrgIds": [
