          ]
        },
        {
          "text": "vile vitako vya ule ua uliozunguka na vile vya ingilio, na vigingi vyote vya Maskani pamoja na ule ua uliozunguka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.31",
            "verseOrgIds": [
              "EXO.38.31"
            ]
