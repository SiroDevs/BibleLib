              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badala yake, Farao akageuka, akaenda kwenye jumba lake la kifalme, wala hakulitia hili moyoni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
