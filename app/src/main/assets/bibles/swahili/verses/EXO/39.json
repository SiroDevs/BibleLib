                "verseOrgIds": [
                  "EXO.39.29"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyomwagiza Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        }
