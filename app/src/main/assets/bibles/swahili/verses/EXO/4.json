        },
        {
          "text": "nao wakaamini. Nao waliposikia kuwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        },
        {
          "name": "char",
