                "verseOrgIds": [
                  "EXO.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Aroni, \"Nenda jangwani ukamlaki Mose.\" Basi akakutana na Mose kwenye mlima wa Mungu, akambusu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mose akamwambia Aroni kila kitu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.28",
                "verseOrgIds": [
                  "EXO.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "alichomtuma kusema, vilevile habari za ishara na maajabu alizokuwa amemwamuru kufanya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        }
      ]
    },
