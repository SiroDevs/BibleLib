          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni wakawakusanya wazee wote wa Waisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
              "EXO.4.29"
            ]
