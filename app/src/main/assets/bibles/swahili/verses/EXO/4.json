                "verseOrgIds": [
                  "EXO.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "alichokuwa amemwambia Mose. Pia akafanya ishara mbele ya watu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
