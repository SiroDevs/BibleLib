    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agano Lathibitishwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mungu akamwambia Mose, \"Njooni huku juu kwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.1",
                "verseOrgIds": [
                  "EXO.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", wewe na Aroni, Nadabu na Abihu, pamoja na wazee sabini wa Israeli. Mniabudu kwa mbali,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini Mose peke yake ndiye atakayemkaribia",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.2",
                "verseOrgIds": [
                  "EXO.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "; wengine wasije karibu. Nao watu wasije wakapanda pamoja naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alipokwenda na kuwaambia watu maneno yote na sheria zote za",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.3",
                "verseOrgIds": [
                  "EXO.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", wakaitikia kwa sauti moja, \"Kila kitu alichosema",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.3",
                "verseOrgIds": [
                  "EXO.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "tutakifanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mose akaandika kila kitu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.4",
                "verseOrgIds": [
                  "EXO.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "alichokuwa amesema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 24:4"
      },
      "items": [
        {
          "text": "Akaamka kesho yake asubuhi na mapema na kujenga madhabahu chini ya mlima na kusimamisha nguzo kumi na mbili za mawe kuwakilisha makabila kumi na mawili ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akawatuma vijana wanaume wa Kiisraeli, nao wakatoa sadaka za kuteketezwa na dhabihu za mafahali wachanga kuwa sadaka za amani kwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.5",
            "verseOrgIds": [
              "EXO.24.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.5",
                "verseOrgIds": [
                  "EXO.24.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.5",
            "verseOrgIds": [
              "EXO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akachukua nusu ya damu ya wale wanyama na kuiweka kwenye mabakuli na nusu nyingine akainyunyiza juu ya madhabahu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.6",
            "verseOrgIds": [
              "EXO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akachukua kile Kitabu cha Agano na kuwasomea watu. Nao wakajibu, \"Tutafanya kila kitu alichosema",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.7",
            "verseOrgIds": [
              "EXO.24.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.7",
                "verseOrgIds": [
                  "EXO.24.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", nasi tutatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.7",
            "verseOrgIds": [
              "EXO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mose akachukua ile damu, akawanyunyizia wale watu, akasema, \"Hii ni damu ya agano ambalo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.8",
                "verseOrgIds": [
                  "EXO.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": "amelifanya nanyi kufuatana na maneno haya yote.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni, Nadabu na Abihu, pamoja na wazee sabini wa Israeli wakapanda mlimani,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.9",
            "verseOrgIds": [
              "EXO.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao wakamwona Mungu wa Israeli. Chini ya miguu yake kulikuwa na kitu kama sakafu ya mawe ya yakuti samawi, iliyo safi kama anga angavu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
              "EXO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Mungu hakuinua mkono wake dhidi ya hawa viongozi wa Waisraeli; walimwona Mungu, nao wakala na kunywa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.12",
                "verseOrgIds": [
                  "EXO.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Panda uje kwangu huku mlimani na ukae hapa, nami nitakupa vibao vya mawe, vyenye sheria na amri ambazo nimeziandika ziwe mwongozo wao.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Mose akaondoka na Yoshua mtumishi wake, naye Mose akapanda juu kwenye mlima wa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akawaambia wazee wa Israeli, \"Tungojeni hapa mpaka tutakapowarudia. Aroni na Huri wako pamoja nanyi, na kila aliye na neno aweza kuwaendea wao.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose alipopanda juu mlimani, wingu liliufunika huo mlima,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.15",
            "verseOrgIds": [
              "EXO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao utukufu wa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.16",
                "verseOrgIds": [
                  "EXO.24.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ukatua juu ya Mlima Sinai. Kwa muda wa siku sita wingu lilifunika mlima, na siku ya saba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.16",
                "verseOrgIds": [
                  "EXO.24.16"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwita Mose kutoka katikati ya lile wingu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Waisraeli utukufu wa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.17",
            "verseOrgIds": [
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.24.17",
                "verseOrgIds": [
                  "EXO.24.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ulionekana kama moto uteketezao juu ya mlima.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.17",
            "verseOrgIds": [
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mose akaingia ndani ya lile wingu alivyokuwa akipanda mlimani. Naye akakaa huko mlimani kwa muda wa siku arobaini, usiku na mchana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.18",
            "verseOrgIds": [
              "EXO.24.18"
            ]
          }
        }
      ]
    }
  ],
