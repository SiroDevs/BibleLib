          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.29",
                "verseOrgIds": [
                  "EXO.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ngurumo zitakoma na hapatakuwepo mvua ya mawe tena, ili upate kujua kuwa, nchi ni mali ya",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.29",
                "verseOrgIds": [
                  "EXO.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ninajua kuwa wewe na maafisa wako bado hammwogopi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        },
        {
          "name": "char",
