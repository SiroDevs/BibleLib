                "verseOrgIds": [
                  "EXO.9.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        }
