    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pigo La Tano: Vifo Vya Mifugo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.1",
                "verseOrgIds": [
                  "EXO.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Nenda kwa Farao ukamwambie, 'Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.1",
                "verseOrgIds": [
                  "EXO.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Waebrania asemalo: \"Waachie watu wangu waende ili wapate kuniabudu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ukikataa kuwaachia waende, nawe ukiendelea kuwashikilia,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.2",
            "verseOrgIds": [
              "EXO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mkono wa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.3",
                "verseOrgIds": [
                  "EXO.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "utaleta pigo baya kwa mifugo yako, juu ya farasi wako, punda, ngamia, ngʼombe wako, kondoo na mbuzi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.4",
                "verseOrgIds": [
                  "EXO.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ataweka tofauti kati ya mifugo ya Israeli na ile ya Misri, kwamba hakuna mnyama wa Mwisraeli atakayekufa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.5",
                "verseOrgIds": [
                  "EXO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akaweka wakati na kusema, \"Kesho",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.5",
                "verseOrgIds": [
                  "EXO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "atalitenda hili katika nchi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iliyofuata",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.6",
                "verseOrgIds": [
                  "EXO.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akalitenda: Mifugo yote ya Wamisri ikafa, lakini hakuna hata mnyama mmoja wa wana wa Israeli aliyekufa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akatuma watu kuchunguza, nao wakakuta kuwa hakuna hata mnyama mmoja wa Waisraeli aliyekufa. Lakini moyo wa Farao haukukubali kuwaachia watu waende.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pigo La Sita: Majipu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.8",
                "verseOrgIds": [
                  "EXO.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose na Aroni, \"Chukueni majivu ya tanuru, naye Mose ayarushe angani mbele ya Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatakuwa vumbi jepesi juu ya nchi yote ya Misri, pia yatatokea majipu yenye kufura juu ya watu na wanyama katika nchi yote.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.9",
            "verseOrgIds": [
              "EXO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakachukua majivu kwenye tanuru na kusimama mbele ya Farao. Mose akayarusha hewani, nayo majipu yenye kufura yakatokea miilini mwa watu na wanyama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.10",
            "verseOrgIds": [
              "EXO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waganga hawakuweza kusimama mbele ya Mose kwa sababu ya majipu yale yaliyokuwa miilini mwao na juu ya miili ya Wamisri wote.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.11",
            "verseOrgIds": [
              "EXO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.12",
                "verseOrgIds": [
                  "EXO.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akaufanya moyo wa Farao kuwa mgumu, naye hakuwasikiliza Mose na Aroni, sawasawa kama vile",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.12",
                "verseOrgIds": [
                  "EXO.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyokuwa amemwambia Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pigo La Saba: Mvua Ya Mawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.13",
                "verseOrgIds": [
                  "EXO.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Amka mapema asubuhi, usimame mbele ya Farao, umwambie, 'Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.13",
                "verseOrgIds": [
                  "EXO.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Waebrania: Waachie watu wangu waende, ili kwamba waweze kuniabudu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "au wakati huu nitaleta mapigo yangu yenye nguvu dhidi yako, maafisa wako na watu wako, ili upate kujua kuwa hakuna mwingine kama Mimi katika dunia yote.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.14",
            "verseOrgIds": [
              "EXO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa mpaka sasa ningelikuwa nimenyoosha mkono wangu na kukupiga wewe na watu wako kwa pigo ambalo lingekufutilia mbali juu ya nchi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.15",
            "verseOrgIds": [
              "EXO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini nimekuinua wewe kwa kusudi hili hasa, ili nipate kukuonyesha uwezo wangu, na ili Jina langu lipate kutangazwa duniani yote.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bado unaendelea kujiinua juu ya watu wangu, wala hutaki kuwaachia waende.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, kesho wakati kama huu nitaleta mvua mbaya sana ya mawe ambayo haijapata kunyesha katika nchi ya Misri, tangu siku ilipoumbwa mpaka leo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.18",
            "verseOrgIds": [
              "EXO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa toa amri urudishe wanyama wote watoke malishoni na chochote ambacho kipo mashambani waje mpaka mahali pa usalama, kwa sababu mvua ya mawe itanyesha juu ya kila mtu na kila mnyama ambaye hajaletwa ndani ambao bado wako nje mashambani, nao watakufa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.19",
            "verseOrgIds": [
              "EXO.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale maafisa wa Farao ambao waliliogopa neno la",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.20",
                "verseOrgIds": [
                  "EXO.9.20"
                ]
              }
            }
          ]
        },
        {
          "text": "wakafanya haraka kuwaleta watumwa wao na mifugo yao ndani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wale waliopuuza neno la",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.21",
                "verseOrgIds": [
                  "EXO.9.21"
                ]
              }
            }
          ]
        },
        {
          "text": "wakawaacha watumwa wao na mifugo yao shambani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        }
      ]
