    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mose akaondoka kwa Farao akaenda nje ya mji. Mose akanyoosha mikono yake kuelekea kwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.33",
                "verseOrgIds": [
                  "EXO.9.33"
                ]
              }
            }
          ]
        },
        {
          "text": ", ngurumo na mvua ya mawe vikakoma, mvua haikuendelea tena kunyesha nchini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao alipoona kwamba mvua ya mawe na ngurumo zimekoma, akafanya dhambi tena. Yeye na maafisa wake wakafanya mioyo yao kuwa migumu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo moyo wa Farao ukawa mgumu, wala hakuwaachia Waisraeli waende, kama vile",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.9.35",
                "verseOrgIds": [
                  "EXO.9.35"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyokuwa amesema kupitia Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
      ]
