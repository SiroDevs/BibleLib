              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.26",
                "verseOrgIds": [
                  "EXO.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose, \"Nyoosha mkono wako juu ya bahari ili maji yarudiane yawafunike Wamisri, magari yao ya vita na wapanda farasi wao.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akanyoosha mkono wake juu ya bahari, wakati wa mapambazuko bahari ikarudiana na kuwa kama kawaida. Wamisri wakajaribu kuyakimbia maji, lakini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.27",
                "verseOrgIds": [
                  "EXO.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "akawasukumia ndani ya bahari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maji yakarudiana na kuyafunika magari ya vita na wapanda farasi pamoja na jeshi lote la Farao lililokuwa limewafuata Waisraeli ndani ya bahari. Hakuna hata mmoja wao aliyenusurika.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
              "EXO.14.28"
            ]
          }
        }
      ]
    },
    {
