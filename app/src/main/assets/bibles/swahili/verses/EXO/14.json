                "verseOrgIds": [
                  "EXO.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "akaliangalia jeshi la Wamisri kutoka ile nguzo ya moto na ya wingu, akalifadhaisha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akayaondoa magurudumu ya magari yao, kwa hivyo wakayaendesha kwa shida. Nao Wamisri wakasema, \"Tuachane na Waisraeli!",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.25",
                "verseOrgIds": [
                  "EXO.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "anawapigania dhidi ya Misri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
      ]
    },
