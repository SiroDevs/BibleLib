          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Waisraeli wakapita baharini mahali pakavu, ukiwepo ukuta wa maji upande wao wa kuume na upande wao wa kushoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
