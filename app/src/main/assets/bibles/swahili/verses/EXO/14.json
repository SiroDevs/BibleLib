                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "aliodhihirisha dhidi ya Wamisri, watu wakamwogopa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "name": "char",
