                "verseOrgIds": [
                  "EXO.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "akawaokoa Waisraeli kutoka mikononi mwa Wamisri, nao Waisraeli wakawaona Wamisri wamelala ufuoni mwa bahari wakiwa wamekufa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
