              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbuka, Ee",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LAM.5.1",
                "verseOrgIds": [
                  "LAM.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", yaliyotupata,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:1"
      },
      "items": [
        {
          "text": "tazama, nawe uione aibu yetu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urithi wetu umegeuziwa kwa wageni,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:2"
      },
      "items": [
        {
          "text": "na nyumba zetu kwa wageni.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumekuwa yatima wasio na baba,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:3"
      },
      "items": [
        {
          "text": "mama zetu wamekuwa kama wajane.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni lazima tununue maji tunayokunywa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:4"
      },
      "items": [
        {
          "text": "kuni zetu zapatikana tu kwa kununua.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanaotufuatilia wapo kwenye visigino vyetu,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:5"
      },
      "items": [
        {
          "text": "tumechoka na hakuna pumziko.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumejitolea kwa Misri na Ashuru",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:6"
      },
      "items": [
        {
          "text": "tupate chakula cha kutosha.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba zetu walitenda dhambi na hawapo tena,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:7"
      },
      "items": [
        {
          "text": "na sisi tunachukua adhabu yao.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watumwa wanatutawala",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:8"
      },
      "items": [
        {
          "text": "na hakuna wa kutuokoa mikononi yao.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunapata chakula chetu kwa kuhatarisha maisha yetu",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:9"
      },
      "items": [
        {
          "text": "kwa sababu ya upanga jangwani.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngozi yetu ina joto kama tanuru,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:10"
      },
      "items": [
        {
          "text": "kwa sababu ya fadhaa itokanayo na njaa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanawake wametendwa jeuri katika Sayuni,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:11"
      },
      "items": [
        {
          "text": "na mabikira katika miji ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakuu wametungikwa juu kwa mikono yao,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
