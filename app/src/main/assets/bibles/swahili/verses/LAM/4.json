          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jinsi dhahabu ilivyopoteza mngʼao wake,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "dhahabu iliyo safi haingʼai!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Vito vya thamani vimetawanywa",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "kwenye mwanzo wa kila barabara.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Sayuni wenye thamani,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
