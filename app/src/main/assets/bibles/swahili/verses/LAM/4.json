          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "Wale waliokuzwa wakivaa nguo za zambarau",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
