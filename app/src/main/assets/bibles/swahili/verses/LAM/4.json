      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "kunyonyesha watoto wao,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "lakini watu wangu wamekuwa wasio na huruma",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "kama mbuni jangwani.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
