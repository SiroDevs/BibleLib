      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "miili yao ilikuwa myekundu kuliko marijani,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
