      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "umegandamana na kaakaa la kinywa chake,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "watoto huomba mkate,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
