  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1PE 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jiwe Lililo Hai Na Watu Waliochaguliwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, wekeni mbali nanyi uovu wote na udanganyifu wote, unafiki, wivu na masingizio ya kila namna.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.1",
            "verseOrgIds": [
              "1PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama watoto wachanga, waliozaliwa sasa, yatamanini maziwa ya kiroho yasiyochanganywa na kitu kingine chochote, ili kwa hayo mpate kukua katika wokovu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.2",
            "verseOrgIds": [
              "1PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiwa kweli mmeonja ya kwamba Bwana ni mwema.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnapokuja kwake, yeye aliye Jiwe lililo hai, lililokataliwa na wanadamu bali kwa Mungu ni teule na la thamani kwake,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.4",
            "verseOrgIds": [
              "1PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninyi nanyi, kama mawe yaliyo hai, mnajengwa kuwa nyumba ya kiroho, ili mpate kuwa ukuhani mtakatifu, mkitoa dhabihu za kiroho zinazokubaliwa na Mungu kwa njia ya Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.5",
            "verseOrgIds": [
              "1PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana imeandikwa katika Maandiko:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "\"Tazama, naweka katika Sayuni,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "jiwe la pembeni teule lenye thamani,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "na yeyote atakayemwamini",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "hataaibika kamwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenu ninyi mnaoamini, jiwe hili ni la thamani. Lakini kwao wasioamini,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:7"
      },
      "items": [
        {
          "text": "\"Jiwe walilolikataa waashi",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:7"
      },
      "items": [
        {
          "text": "limekuwa jiwe kuu la pembeni,\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tena,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "\"Jiwe lenye kuwafanya watu wajikwae,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "na mwamba wa kuwaangusha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "Wanajikwaa kwa sababu hawakulitii lile neno, kama walivyowekewa tangu zamani.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ninyi ni taifa teule, ukuhani wa kifalme, taifa takatifu, watu walio milki ya Mungu, mlioitwa ili kutangaza sifa zake yeye aliyewaita kutoka gizani mkaingie katika nuru yake ya ajabu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanzo ninyi mlikuwa si taifa, lakini sasa ninyi ni taifa la Mungu. Mwanzo mlikuwa hamjapata rehema, lakini sasa mmepata rehema.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapenzi, ninawasihi, mkiwa kama wageni na wapitaji hapa ulimwenguni, epukeni tamaa mbaya za mwili ambazo hupigana vita na roho zenu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuweni na mwenendo mzuri mbele ya watu wasiomjua Mungu, ili kama wanawasingizia kuwa watenda mabaya, wayaone matendo yenu mema nao wamtukuze Mungu siku atakapokuja kwetu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwatii Wenye Mamlaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya Bwana, tiini kila mamlaka iliyowekwa na wanadamu: Kwa mfalme kwani ndiye aliye na mamlaka ya juu zaidi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "au kwa maafisa aliowaweka, kwa kuwa mfalme amewatuma ili kuwaadhibu wale wanaokosa, na kuwapongeza wale watendao mema.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ni mapenzi ya Mungu kwamba kwa kutenda mema mnyamazishe maneno ya kijinga ya watu wapumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishini kama watu huru, lakini msitumie uhuru wenu kama kisingizio cha kutenda uovu, bali ishini kama watumishi wa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mheshimuni kila mtu ipasavyo: Wapendeni jamaa ya ndugu waumini, mcheni Mungu, mpeni heshima mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi watumwa, watiini mabwana zenu kwa heshima yote, si wale mabwana walio wema na wapole peke yao, bali pia wale walio wakali.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana ni jambo la sifa kama mtu akivumilia anapoteswa kwa uonevu kwa ajili ya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwani ni faida gani kwa mtu kustahimili anapopigwa kwa sababu ya makosa yake? Lakini kama mkiteswa kwa sababu ya kutenda mema, nanyi mkastahimili, hili ni jambo la kusifiwa mbele za Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfano Wa Mateso Ya Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi mliitwa kwa ajili ya haya, kwa sababu Kristo naye aliteswa kwa ajili yenu, akiwaachia kielelezo, ili mzifuate nyayo zake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeye hakutenda dhambi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:22"
      },
      "items": [
        {
          "text": "wala hila haikuonekana kinywani mwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye alipotukanwa, hakurudisha matukano; alipoteswa, hakutishia, bali alijikabidhi kwa yeye ahukumuye kwa haki.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.23",
            "verseOrgIds": [
              "1PE.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
