              "1KI.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndama Wa Dhahabu Huko Betheli Na Dani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yeroboamu akajenga Shekemu akaizungushia ngome katika nchi ya vilima ya Efraimu na akaishi huko. Akatoka huko, akaenda akajenga Penueli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu akawaza moyoni mwake, \"Sasa inawezekana ufalme ukarudi katika nyumba ya Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama watu hawa watapanda kwenda kutoa dhabihu katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.27",
                "verseOrgIds": [
                  "1KI.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "huko Yerusalemu, mioyo yao itamrudia bwana wao, Rehoboamu mfalme wa Yuda. Wataniua mimi na kurudi kwa Mfalme Rehoboamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kutafuta shauri, mfalme akatengeneza ndama wawili wa dhahabu. Akawaambia watu, \"Ni gharama kubwa kwenu kukwea kwenda Yerusalemu. Hii hapa miungu yenu, ee Israeli, iliyowapandisha kutoka Misri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndama mmoja akamweka Betheli na mwingine Dani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalo jambo hili likawa dhambi, watu wakawa wanaenda hadi Dani kumwabudu huyo aliyewekwa huko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu akajenga madhabahu mahali pa juu pa kuabudia miungu na kuwateua makuhani kutoka watu wa aina zote, ijapokuwa hawakuwa Walawi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia Yeroboamu akaweka sikukuu katika siku ya kumi na tano ya mwezi wa nane, kama sikukuu iliyokuwa ikifanyika huko Yuda, na akatoa dhabihu juu ya madhabahu. Akafanya hivyo huko Betheli akitoa dhabihu kwa ndama alizotengeneza. Huko Betheli akawaweka makuhani, na pia katika sehemu za juu za kuabudia miungu alizozitengeneza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ya kumi na tano ya mwezi wa nane, mwezi aliouchagua mwenyewe, alitoa dhabihu juu ya madhabahu aliyokuwa amejenga huko Betheli. Kwa hiyo akaweka sikukuu kwa ajili ya Waisraeli na akapanda madhabahuni kutoa sadaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
    }
