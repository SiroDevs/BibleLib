    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa 480 baada ya Waisraeli kutoka nchi ya Misri, katika mwaka wa nne wa utawala wa Solomoni katika Israeli, katika mwezi wa Zivu, ambao ndio mwezi wa pili, alianza kujenga Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.1",
                "verseOrgIds": [
                  "1KI.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekalu hilo Mfalme Solomoni alilojenga kwa ajili ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.2",
                "verseOrgIds": [
                  "1KI.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "lilikuwa na urefu wa dhiraa sitini,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "text": "upana wa dhiraa ishirini",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "text": "na kimo cha dhiraa thelathini",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "text": "kwenda juu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraza ya mbele ya Hekalu ilienea dhiraa ishirini kulingana na upana wa Hekalu na kujitokeza dhiraa kumi mbele ya Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatengeneza madirisha membamba yenye vidirisha vidogo vya juu katika Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanyiza vyumba vya pembeni kulizunguka Hekalu lote vikishikamana na kuta za Hekalu na za Patakatifu pa Patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghorofa ya chini kabisa ilikuwa na upana wa dhiraa tano,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "text": "ya kati ilikuwa dhiraa sita na ya tatu ilikuwa dhiraa saba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "text": "Kuzunguka ukuta wa nje wa Hekalu akapunguza ukuta pande zote ili boriti zisishikane kwenye kuta za Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika kujenga Hekalu, yalitumika tu mawe yaliyochongwa huko machimboni, wala hakuna nyundo, patasi au chombo kingine chochote cha chuma kilichosikika sauti yake katika eneo la ujenzi wa Hekalu wakati lilipokuwa likijengwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingilio la ghorofa ya chini kabisa lilikuwa upande wa kusini wa Hekalu, ngazi ilielekea ghorofa ya kati na kutokea hapo ilielekea hadi ghorofa ya tatu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Solomoni akajenga Hekalu na kulikamilisha, akiliweka paa za boriti na mbao za mierezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Solomoni akajenga vyumba vya pembeni kuzunguka Hekalu lote. Kimo cha kila kimoja kilikuwa dhiraa tano. Navyo vilikuwa vimeunganishwa na Hekalu kwa boriti za mierezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.11",
                "verseOrgIds": [
                  "1KI.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "likamjia Solomoni kusema:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa habari ya Hekalu hili unalojenga, kama ukifuata amri zangu, ukatunza masharti yangu na kushika maagizo yangu yote na kuyatii, kwa kupitia wewe nitatimiza ahadi niliyomwahidi Daudi baba yako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitakaa miongoni mwa Waisraeli, nami sitawaacha watu wangu Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Solomoni akajenga Hekalu na kulikamilisha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazifunika kuta zake za ndani kwa mbao za mierezi, akizipigilia ukutani kuanzia sakafuni mwa Hekalu hadi kwenye dari na kufunika sakafu ya Hekalu kwa mbao za misunobari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagawa dhiraa ishirini sehemu ya nyuma ya Hekalu kwa mbao za mierezi kuanzia kwenye sakafu hadi darini ili kufanya sehemu takatifu ya ndani, yaani Patakatifu pa Patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukumbi mkubwa uliokuwa mbele ya chumba hiki ndio ulikuwa na urefu wa dhiraa arobaini.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekalu ndani ilikuwa ya mierezi iliyonakshiwa mifano ya maboga na maua yaliyochanua. Kila kitu kilikuwa cha mwerezi, hakuna jiwe ambalo lilionekana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani ya Hekalu akatengeneza sehemu takatifu ya ndani, kwa ajili ya kuweka Sanduku la Agano la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.19",
                "verseOrgIds": [
                  "1KI.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sehemu takatifu ya ndani ilikuwa na upana, urefu na kimo cha dhiraa ishirini ndani kwa ndani. Akaifunika ndani kwa dhahabu safi, pia akaifunika madhabahu ya mierezi vivyo hivyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni akaifunika sehemu ya ndani ya Hekalu kwa dhahabu safi, naye akaitandaza mikufu ya dhahabu kutoka upande moja hadi ule mwingine mbele ya Patakatifu pa Patakatifu, ambako palifunikwa kwa dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akafunika sehemu yote ya ndani kwa dhahabu. Pia akafunika madhabahu yale yaliyokuwa ndani ya Patakatifu pa Patakatifu kwa dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika Patakatifu pa Patakatifu akatengeneza makerubi wawili kwa mzeituni, kila moja likiwa na dhiraa kumi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "text": "kwenda juu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawa moja la kerubi wa kwanza lilikuwa na urefu wa dhiraa tano na bawa jingine dhiraa tano, hivyo urefu kutoka ncha ya bawa moja hadi ncha ya bawa jingine ulikuwa dhiraa kumi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubi wa pili alikuwa na urefu wa dhiraa kumi pia, hivyo makerubi hao wawili walifanana kwa vipimo na kwa umbo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimo cha kila kerubi kilikuwa dhiraa kumi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliwaweka makerubi hao ndani ya Patakatifu pa Patakatifu pa Hekalu, mabawa yake yakiwa yamekunjuliwa. Bawa la kerubi mmoja liligusa ukuta mmoja, wakati bawa la yule mwingine liligusa ukuta mwingine, nayo mabawa yao mengine yaligusana katikati ya chumba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafunika wale makerubi kwa dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya kuta zote zilizozunguka Hekalu, za vyumba vya ndani na vya nje, zilipambwa kwa nakshi zilizokatwa za makerubi, miti ya mitende na maua yaliyochanua.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia alifunika sakafu zote za vyumba vya ndani na vya nje vya Hekalu kwa dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ingilio la Patakatifu pa Patakatifu akatengeneza milango ya mbao za mzeituni, zikiwa na miimo na vizingiti vyenye umbo la pembe tano.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya milango miwili ya mbao za mzeituni alinakshi makerubi, miti ya mitende pamoja na maua yaliyochanua na kufunika makerubi na miti ya mitende kwa dhahabu iliyofuliwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa njia iyo hiyo akatengeneza miimo yenye pande nne ya miti ya mizeituni, kwa ajili ya ingilio la ukumbi mkubwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na milango miwili iliyoweza kukunjuka iliyotengenezwa kwa mbao za msunobari na kila mmoja ulikuwa na bawaba ambazo zingeuwezesha kujikunja kila kipande juu ya kingine.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanakshi makerubi, miti ya mitende na maua yaliyochanua juu yake na kufunika kwa dhahabu iliyonyooshwa vizuri juu ya michoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akajenga ua wa ndani safu tatu za mawe yaliyochongwa na safu moja ya boriti za mierezi zilizorembwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msingi wa Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.37",
                "verseOrgIds": [
                  "1KI.6.37"
                ]
              }
            }
          ]
        },
        {
          "text": "uliwekwa katika mwaka wa nne, katika mwezi wa Zivu, ndio mwezi wa tano.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kumi na moja, mwezi wa Buli, ndio mwezi wa nane, Hekalu lilikamilika katika hatua zake zote kwa kufuatana na maelekezo yake Solomoni. Alilijenga kwa miaka saba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
    }
