    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abiya Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.13.1-2CH.14.1"
          },
          "items": [
            {
              "text": "2 Nyakati 13:1–14:1",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kumi na nane wa utawala wa Yeroboamu mwana wa Nebati, Abiya akawa mfalme wa Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.1",
            "verseOrgIds": [
              "1KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akatawala huko Yerusalemu miaka mitatu. Mama yake aliitwa Maaka binti Abishalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.2",
            "verseOrgIds": [
              "1KI.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alitenda dhambi zote baba yake alizotenda kabla yake; moyo wake haukuwa mkamilifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.3",
                "verseOrgIds": [
                  "1KI.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wake kama moyo wa Daudi baba yake ulivyokuwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamoja na hayo, kwa ajili ya Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.4",
                "verseOrgIds": [
                  "1KI.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wake akampa taa katika Yerusalemu kwa kumwinua mwana atawale badala yake na kwa kuifanya Yerusalemu kuwa imara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa Daudi alifanya yaliyo mema machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.5",
                "verseOrgIds": [
                  "1KI.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "na hakushindwa kushika maagizo yote ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.5",
                "verseOrgIds": [
                  "1KI.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "siku zote za uhai wake, isipokuwa katika habari ya Uria, Mhiti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na vita kati ya Rehoboamu na Yeroboamu wakati wote wa maisha ya Abiya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
            "verseOrgIds": [
              "1KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa habari ya matukio mengine ya utawala wa Abiya na yote aliyofanya, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Yuda? Kulikuwa na vita kati ya Abiya na Yeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.7",
            "verseOrgIds": [
              "1KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abiya akalala na baba zake akazikwa katika Mji wa Daudi. Asa mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asa Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.15.16-2CH.16.6"
          },
          "items": [
            {
              "text": "2 Nyakati 15:16–16:6",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa ishirini wa utawala wa Yeroboamu mfalme wa Israeli, Asa akawa mfalme wa Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akatawala katika Yerusalemu miaka arobaini na mmoja. Bibi yake aliitwa Maaka binti Abishalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa akatenda yaliyo mema machoni mwa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.11",
                "verseOrgIds": [
                  "1KI.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", kama alivyokuwa ametenda Daudi baba yake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawafukuza mahanithi wa mahali pa kuabudia miungu kutoka nchi na kuondoa sanamu zote ambazo baba zake walikuwa wametengeneza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata akamwondoa bibi yake Maaka kwenye wadhifa wake kama mama malkia, kwa sababu alikuwa ametengeneza nguzo ya Ashera ya kuchukiza. Asa akaikata hiyo nguzo na kuiteketeza kwa moto katika Bonde la Kidroni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijapokuwa hakuondoa mahali pa juu pa kuabudia miungu, moyo wa Asa ulikuwa umejiweka kwa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.14",
                "verseOrgIds": [
                  "1KI.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kikamilifu maisha yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaleta ndani ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.15",
                "verseOrgIds": [
                  "1KI.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "fedha na dhahabu na vile vyombo ambavyo yeye na baba yake walikuwa wameviweka wakfu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na vita kati ya Asa na Baasha mfalme wa Israeli siku zote za utawala wao.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.16",
            "verseOrgIds": [
              "1KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Baasha wa Israeli akashambulia Yuda na kuweka ngome mji wa Rama ili kumzuia yeyote asitoke wala kuingia nchi ya Mfalme Asa wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.17",
            "verseOrgIds": [
              "1KI.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Asa akachukua fedha yote na dhahabu iliyokuwa imeachwa katika hazina za Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.18",
                "verseOrgIds": [
                  "1KI.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "na za jumba lake mwenyewe la kifalme. Akawakabidhi maafisa wake na kuwatuma kwa Ben-Hadadi mwana wa Tabrimoni, mwana wa Hezioni, mfalme wa Aramu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "text": "aliyekuwa akitawala Dameski.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akasema na pawepo mkataba kati yangu na wewe, kama ulivyokuwepo kati ya baba yangu na baba yako. Tazama, nimekuletea zawadi ya fedha na dhahabu. Sasa vunja mkataba wako na Baasha mfalme wa Israeli ili aniondokee mimi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Hadadi akakubaliana na Mfalme Asa na kutuma majemadari wa majeshi yake dhidi ya miji ya Israeli. Akaishinda miji ya Iyoni, Dani, Abel-Beth-Maaka na Kinerethi yote, pamoja na Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Baasha aliposikia hili, akaacha kuijenga Rama na akaenda kuishi Tirsa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mfalme Asa akatoa amri kwa Yuda yote, pasipo kumbagua hata mmoja, kubeba mawe na mbao kutoka Rama, ambazo Baasha alikuwa akitumia huko. Mfalme Asa akazitumia kujengea Geba iliyoko Benyamini na Mispa pia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.22",
            "verseOrgIds": [
              "1KI.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa matukio yote ya utawala wa Asa, mafanikio yake yote, yote aliyofanya na miji aliyoijenga, je, hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Yuda? Katika uzee wake, hata hivyo, alipata ugonjwa wa miguu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Asa akalala pamoja na baba zake na kuzikwa pamoja nao katika mji wa Daudi baba yake. Naye Yehoshafati mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nadabu Mfalme Wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabu mwana wa Yeroboamu akawa mfalme wa Israeli katika mwaka wa pili wa utawala wa Mfalme Asa wa Yuda, naye akatawala Israeli kwa miaka miwili.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.26",
                "verseOrgIds": [
                  "1KI.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", akienenda katika njia za baba yake na katika dhambi yake, ambayo alisababisha Israeli kuifanya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasha mwana wa Ahiya wa nyumba ya Isakari akafanya shauri baya dhidi yake, naye akamuua huko Gibethoni, mji wa Wafilisti, wakati Nadabu na Israeli yote walipokuwa wameuzingira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasha akamuua Nadabu katika mwaka wa tatu wa utawala wa Asa mfalme wa Yuda, naye Baasha akaingia mahali pake kuwa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara tu alipoanza kutawala, aliua jamaa yote ya Yeroboamu. Hakumwachia Yeroboamu yeyote aliyekuwa hai, bali aliwaangamiza wote, kulingana na neno la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.29",
                "verseOrgIds": [
                  "1KI.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "lililotolewa kupitia kwa mtumishi wake Ahiya Mshiloni,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa sababu ya dhambi alizokuwa amezitenda Yeroboamu na kusababisha Israeli kuzitenda, tena kwa sababu alimkasirisha",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.30",
                "verseOrgIds": [
                  "1KI.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa matukio mengine ya utawala wa Nadabu na yote aliyofanya, je hayakuandikwa katika kitabu cha kumbukumbu za wafalme wa Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na vita kati ya Asa na Baasha mfalme wa Israeli wakati wote wa utawala wao.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baasha Mfalme Wa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa tatu wa utawala wa Asa mfalme wa Yuda, Baasha mwana wa Ahiya akawa mfalme wa Israeli yote huko Tirsa, naye akatawala kwa miaka ishirini na minne.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatenda maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.34",
                "verseOrgIds": [
                  "1KI.15.34"
                ]
              }
            }
          ]
        },
        {
          "text": ", akienenda katika njia za Yeroboamu na dhambi yake, ambayo alikuwa amesababisha Israeli kuitenda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        }
