              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaani, wazao wao waliobakia katika nchi, ambao Waisraeli hawangeweza kuwaangamiza kabisa: hawa Solomoni akawalazimisha kuwa watumwa katika shokoa, kama ilivyo hadi leo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.21",
            "verseOrgIds": [
              "1KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
