      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "mataji mawili yenye umbo la bakuli juu ya hizo nguzo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
