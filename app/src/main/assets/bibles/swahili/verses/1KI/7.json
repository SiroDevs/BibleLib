          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "makomamanga 400 kwa ajili ya hizo nyavu mbili (safu mbili za makomamanga kwa kila wavu, yakipamba hayo mataji mawili yenye umbo la bakuli juu ya hizo nguzo);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.42",
            "verseOrgIds": [
              "1KI.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "vitako kumi pamoja na masinia yake kumi;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.43",
            "verseOrgIds": [
              "1KI.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
