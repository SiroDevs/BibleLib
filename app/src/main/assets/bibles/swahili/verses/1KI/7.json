  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1KI 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni Ajenga Jumba Lake La Kifalme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilimchukua Solomoni miaka kumi na mitatu kukamilisha ujenzi wa Jumba lake la kifalme.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.1",
            "verseOrgIds": [
              "1KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alijenga Jumba la Kifalme la Msitu wa Lebanoni, urefu wake ulikuwa dhiraa 100,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "text": "upana wake dhiraa hamsini na kimo chake dhiraa thelathini,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "text": "likiwa na safu nne za nguzo za mierezi zikishikilia boriti za mierezi zilizorembwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilipauliwa kwa mierezi juu ya boriti zile zilizolala juu ya nguzo arobaini na tano, kumi na tano kwa kila safu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.3",
            "verseOrgIds": [
              "1KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madirisha yake yaliwekwa juu kwa safu tatu, yakielekeana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.4",
            "verseOrgIds": [
              "1KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Milango yote ilikuwa na miimo ya mstatili, ilikuwa upande wa mbele katika safu tatu, ikielekeana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.5",
            "verseOrgIds": [
              "1KI.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajenga ukumbi wa nguzo, ambao urefu wake ulikuwa dhiraa hamsini",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        },
        {
          "text": "na upana wake dhiraa thelathini. Mbele ya jengo hilo kulikuwepo baraza. Mbele ya baraza kulikuwepo na nguzo na paa lililoningʼinia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajenga ukumbi wa kiti cha enzi, Ukumbi wa Hukumu, mahali ambapo angelitolea hukumu, akaufunika kwa mierezi kutoka sakafuni hadi darini.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.7",
            "verseOrgIds": [
              "1KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenye jumba la kifalme ambamo angeliishi, aliiweka nyuma zaidi, ikiwa na mjengo wa aina moja na hiyo nyingine. Pia Solomoni akajenga jumba la kifalme linalofanana na huo ukumbi mkubwa kwa ajili ya binti Farao, aliyekuwa amemwoa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.8",
            "verseOrgIds": [
              "1KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujenzi huu wote, kuanzia nje mpaka kwenye ua mkuu na kuanzia kwenye msingi hadi upenuni, ulifanywa kwa mawe ya ubora wa hali ya juu yaliyokuwa yamechongwa kwa vipimo na kusawazishwa kwa msumeno nyuso zake za ndani na za nje.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.9",
            "verseOrgIds": [
              "1KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misingi iliwekwa kwa mawe makubwa yaliyo bora, yenye urefu wa dhiraa kumi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "text": "na mengine yenye urefu wa dhiraa nane",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sehemu za juu kulikuwepo na mawe yenye ubora wa hali ya juu, yaliyokatwa kwa vipimo na boriti za mierezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.11",
            "verseOrgIds": [
              "1KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ule ua mkuu ulizungukwa na ukuta wa safu tatu za mawe yaliyochongwa na safu moja ya boriti za mierezi zilizorembwa, kama ulivyokuwa ua wa ndani wa Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.12",
                "verseOrgIds": [
                  "1KI.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "na baraza yake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samani Za Hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.4"
          },
          "items": [
            {
              "text": "2 Nyakati 4",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Solomoni akatuma watu Tiro kumleta Hiramu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.13",
            "verseOrgIds": [
              "1KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambaye mama yake alikuwa mjane kutoka kabila la Naftali na baba yake alikuwa mtu wa Tiro tena fundi wa shaba. Hiramu alikuwa na ustadi wa hali ya juu na mzoefu katika aina zote za kazi ya shaba. Alikuja kwa Mfalme Solomoni na kufanya kazi zake zote alizopangiwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.14",
            "verseOrgIds": [
              "1KI.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu akasubu nguzo mbili za shaba, kila moja ikiwa na urefu wa dhiraa kumi na nane,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "text": "kila nguzo ikiwa na mzingo wa dhiraa kumi na mbili",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "text": "kwa mstari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia alitengeneza mataji mawili ya shaba ya kusubu ili kuyaweka juu ya hizo nguzo; kila taji lilikuwa na kimo cha dhiraa tano",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "text": "kwenda juu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wavu wa mikufu iliyosokotewa kwenye zile taji juu ya zile nguzo, saba kwa kila taji.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.17",
            "verseOrgIds": [
              "1KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatengeneza makomamanga katika safu mbili kuzunguka kila wavu kuremba mataji yaliyo juu ya nguzo. Alifanya hivyo kwa kila nguzo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.18",
            "verseOrgIds": [
              "1KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataji yaliyokuwa juu ya nguzo kwenye baraza, yalikuwa katika umbo la yungiyungi, kimo chake ni dhiraa nne",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya mataji ya zile nguzo mbili, juu ya ile sehemu yenye umbo kama bakuli, karibu na ule wavu, kulikuwa na yale makomamanga 200 katika safu kuzunguka pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.20",
            "verseOrgIds": [
              "1KI.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu akasimamisha nguzo kwenye baraza ya Hekalu. Nguzo ya upande wa kusini akaiita Yakini,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "text": "na ile ya upande wa kaskazini Boazi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataji yaliyokuwa juu yalikuwa na umbo la yungiyungi. Hivyo kazi ya nguzo ikakamilika.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.22",
            "verseOrgIds": [
              "1KI.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu akasubu Bahari ya chuma, yenye umbo la mviringo, ya dhiraa kumi kutoka ukingo hadi ukingo na kimo cha dhiraa tano. Mzunguko wake ulikuwa dhiraa thelathini.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chini ya ukingo, ilizungukwa na maboga, kumi kwenye kila dhiraa moja. Maboga yalikuwa yamesubiwa katika safu mbili ili kuwa kitu kimoja na hiyo bahari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.24",
            "verseOrgIds": [
              "1KI.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahari iliwekwa juu ya mafahali kumi na wawili, watatu wakielekea kaskazini, watatu wakielekea magharibi, watatu wakielekea kusini na watatu wakielekea mashariki. Bahari iliwekwa juu yao na sehemu zao za nyuma zilielekeana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.25",
            "verseOrgIds": [
              "1KI.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilikuwa na unene wa nyanda nne",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        },
        {
          "text": "na ukingo wake ulifanana na ukingo wa kikombe, kama ua la yungiyungi iliyochanua. Iliweza kuchukua bathi 2,000.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia akatengeneza vitako kumi vya shaba vinavyoweza kuhamishika, kila kimoja kilikuwa na urefu wa dhiraa nne, upana dhiraa nne na kimo chake dhiraa tatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivi ndivyo vile vitako vilivyotengenezwa: Vilikuwa na mbao za pembeni zilizoshikamanishwa na mihimili.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.28",
            "verseOrgIds": [
              "1KI.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya mbao kati ya hiyo mihimili kulikuwa na simba, mafahali na makerubi, pia kwenye mihimili yake. Juu na chini ya simba na mafahali kulikuwa kumesokotewa taji za kufuliwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.29",
            "verseOrgIds": [
              "1KI.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila kitako kilikuwa na magurudumu manne ya shaba, na vyuma vya katikati vya kuyazungusha hayo magurudumu na kila kimoja kilikuwa na sinia kwenye vishikizo vinne vya taji iliyosubiwa kila upande.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.30",
            "verseOrgIds": [
              "1KI.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani ya kitako kulikuwa na nafasi ya wazi iliyokuwa na umbile la mviringo lenye kina cha dhiraa moja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "text": "Nafasi hii ya wazi ilikuwa ya mviringo, pamoja na kitako chake ilikuwa dhiraa moja na nusu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "text": "Kuzunguka huo mdomo wake kulitiwa nakshi. Papi za vitako zilikuwa mraba na si za mviringo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magurudumu manne yalikuwa chini ya papi, na vyuma vya katikati vya kuzungushia magurudumu hayo vilikuwa vimeunganishwa kwenye kitako. Kipenyo cha kila gurudumu kilikuwa dhiraa moja na nusu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.32",
            "verseOrgIds": [
              "1KI.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magurudumu yalitengenezwa kama ya magari ya vita ya kukokotwa, vyuma vya katikati vya magurudumu, duara zake, matindi yake na vikombe vyake vyote vilikuwa vya kusubu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.33",
            "verseOrgIds": [
              "1KI.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila kitako kilikuwa na mikono minne, moja kwenye kila pembe, ukitokeza kutoka kwenye kitako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.34",
            "verseOrgIds": [
              "1KI.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu ya kitako kulikuwepo na utepe wa mviringo wenye kina cha nusu dhiraa. Vishikio na papi vilishikamana upande wa juu wa kitako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.35",
            "verseOrgIds": [
              "1KI.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alitia nakshi za makerubi, simba na miti ya mitende juu ya uso wa vishikio na juu ya papi, katika kila nafasi iliyopatikana, pamoja na mataji yaliyosokotwa kuzunguka pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.36",
            "verseOrgIds": [
              "1KI.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivi ndivyo Hiramu alivyotengeneza vile vitako kumi. Vyote vilikuwa vya kusubu kwenye kalibu za kufanana kwa vipimo na kwa umbo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.37",
            "verseOrgIds": [
              "1KI.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akatengeneza masinia kumi ya shaba, kila moja likiwa na ujazo wa bathi arobaini,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "text": "yakiwa na kipenyo cha dhiraa nne",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "text": "kila sinia moja kwa kila kimoja ya vile vitako kumi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliweka vitako vitano upande wa kusini wa Hekalu na vingine vitano upande wa kaskazini. Akaweka ile bahari upande wa kusini, katika pembe ya kusini ya Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia akatengeneza masinia, masepetu na mabakuli ya kunyunyizia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:40"
      },
      "items": [
        {
          "text": "Kwa hiyo Huramu akakamilisha kazi zote katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.40",
                "verseOrgIds": [
                  "1KI.7.40"
                ]
              }
            }
          ]
        },
        {
          "text": "kama vile Mfalme Solomoni alikuwa amemwagiza, yaani:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
