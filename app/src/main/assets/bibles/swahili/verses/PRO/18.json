      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu ajitengaye na wengine",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:1"
      },
      "items": [
        {
          "text": "hufuata matakwa yake mwenyewe;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:1"
      },
      "items": [
        {
          "text": "hupiga vita kila shauri jema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpumbavu hafurahii ufahamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:2"
      },
      "items": [
        {
          "text": "bali hufurahia kutangaza",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:2"
      },
      "items": [
        {
          "text": "maoni yake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati uovu unapokuja, dharau huja pia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:3"
      },
      "items": [
        {
          "text": "pamoja na aibu huja lawama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneno ya kinywa cha mwanadamu ni kina cha maji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:4"
      },
      "items": [
        {
          "text": "bali chemchemi ya hekima ni kijito kinachobubujika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sio vizuri kumpendelea mtu mwovu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:5"
      },
      "items": [
        {
          "text": "au kumnyima haki asiye na hatia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Midomo ya mpumbavu humletea ugomvi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:6"
      },
      "items": [
        {
          "text": "na kinywa chake hualika kipigo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinywa cha mpumbavu ni uharibifu wake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:7"
      },
      "items": [
        {
          "text": "na midomo yake ni mtego kwa nafsi yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneno ya mchongezi ni kama chakula kitamu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:8"
      },
      "items": [
        {
          "text": "huingia sehemu za ndani sana za mtu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu aliye mlegevu katika kazi yake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:9"
      },
      "items": [
        {
          "text": "ni ndugu na yule anayeharibu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jina la",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.18.10",
                "verseOrgIds": [
                  "PRO.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ngome imara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:10"
      },
      "items": [
        {
          "text": "wenye haki huikimbilia na kuwa salama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mali ya tajiri ni mji wake wenye ngome,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:11"
      },
      "items": [
        {
          "text": "wanaudhania kuwa ukuta usioweza kurukwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabla ya anguko moyo wa mtu hujaa kiburi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:12"
      },
      "items": [
        {
          "text": "bali unyenyekevu hutangulia heshima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ajibuye kabla ya kusikiliza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:13"
      },
      "items": [
        {
          "text": "huo ni upumbavu wake na aibu yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho ya mtu itastahimili katika ugonjwa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:14"
      },
      "items": [
        {
          "text": "bali roho iliyovunjika ni nani awezaye kuistahimili?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wa mwenye ufahamu hujipatia maarifa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:15"
      },
      "items": [
        {
          "text": "masikio ya mwenye hekima huyatafuta maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zawadi humfungulia njia mtoaji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:16"
      },
      "items": [
        {
          "text": "nayo humleta mbele ya wakuu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
            ]
          }
        }
      ]
    },
    {
