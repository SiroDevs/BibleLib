          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maonyo Dhidi Ya Upumbavu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, kama umekuwa mdhamini wa jirani yako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:1"
      },
      "items": [
        {
          "text": "ikiwa umeshika mikono kwa kuweka ahadi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:1"
      },
      "items": [
        {
          "text": "kwa ajili ya mwingine,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama umetegwa na ulichosema,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:2"
      },
      "items": [
        {
          "text": "umenaswa kwa maneno ya kinywa chako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi fanya hivi mwanangu, ili ujiweke huru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "kwa kuwa umeanguka mikononi mwa jirani yako:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "Nenda ukajinyenyekeshe kwake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "msihi jirani yako!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiruhusu usingizi machoni pako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:4"
      },
      "items": [
        {
          "text": "usiruhusu kope zako zisinzie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiweke huru, kama swala mkononi mwa mwindaji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:5"
      },
      "items": [
        {
          "text": "kama ndege kutoka kwenye mtego wa mwindaji.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe mvivu, mwendee mchwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:6"
      },
      "items": [
        {
          "text": "zitafakari njia zake ukapate hekima!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana yeye hana msimamizi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:7"
      },
      "items": [
        {
          "text": "wala mwangalizi, au mtawala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini hujiwekea akiba wakati wa kiangazi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:8"
      },
      "items": [
        {
          "text": "na hukusanya chakula chake wakati wa mavuno.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe mvivu, utalala hata lini?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:9"
      },
      "items": [
        {
          "text": "Utaamka lini kutoka usingizi wako?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bado kulala kidogo, kusinzia kidogo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:10"
      },
      "items": [
        {
          "text": "bado kukunja mikono kidogo upate kupumzika:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "hivyo umaskini utakuja juu yako kama mnyangʼanyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:11"
      },
      "items": [
        {
          "text": "na kupungukiwa kutakujia kama mtu mwenye silaha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mbaya sana na mlaghai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:12"
      },
      "items": [
        {
          "text": "ambaye huzungukazunguka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "PRO 6:12"
      },
      "items": [
        {
          "text": "na maneno ya upotovu,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambaye anakonyeza kwa jicho lake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "anayetoa ishara kwa miguu yake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "na kuashiria kwa vidole vyake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambaye hupanga ubaya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "PRO 6:14"
      },
      "items": [
        {
          "text": "kwa udanganyifu moyoni mwake:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:14"
      },
      "items": [
        {
          "text": "daima huchochea fitina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo maafa yatamkumba ghafula;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:15"
      },
      "items": [
        {
          "text": "ataangamizwa mara, pasipo msaada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna vitu sita anavyovichukia",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.16",
                "verseOrgIds": [
                  "PRO.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:16"
      },
      "items": [
        {
          "text": "naam, viko saba vilivyo chukizo kwake:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
