  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "PRO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mwovu hukimbia ingawa hakuna yeyote anayemfukuza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.1",
            "verseOrgIds": [
              "PRO.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:1"
      },
      "items": [
        {
          "text": "bali wenye haki ni wajasiri kama simba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.1",
            "verseOrgIds": [
              "PRO.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati nchi inapokuwa na uasi, inakuwa na viongozi wengi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.2",
            "verseOrgIds": [
              "PRO.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:2"
      },
      "items": [
        {
          "text": "bali mwenye ufahamu na maarifa hudumisha utaratibu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.2",
            "verseOrgIds": [
              "PRO.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu maskini amwoneaye yeye aliye maskini zaidi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.3",
            "verseOrgIds": [
              "PRO.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:3"
      },
      "items": [
        {
          "text": "ni kama mvua ya dhoruba isiyosaza mazao.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.3",
            "verseOrgIds": [
              "PRO.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale waiachao sheria huwasifu waovu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.4",
            "verseOrgIds": [
              "PRO.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:4"
      },
      "items": [
        {
          "text": "bali wale waishikao sheria huwapinga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.4",
            "verseOrgIds": [
              "PRO.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wabaya hawaelewi haki,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.5",
            "verseOrgIds": [
              "PRO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:5"
      },
      "items": [
        {
          "text": "bali wale wamtafutao",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.5",
            "verseOrgIds": [
              "PRO.28.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.28.5",
                "verseOrgIds": [
                  "PRO.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wanaielewa kikamilifu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.5",
            "verseOrgIds": [
              "PRO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afadhali maskini ambaye mwenendo wake hauna lawama",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.6",
            "verseOrgIds": [
              "PRO.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:6"
      },
      "items": [
        {
          "text": "kuliko tajiri ambaye njia zake ni potovu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.6",
            "verseOrgIds": [
              "PRO.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ashikaye sheria ni mwana mwenye ufahamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:7"
      },
      "items": [
        {
          "text": "bali rafiki wa walafi humwaibisha baba yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye aongezaye utajiri wake kwa riba kubwa mno",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:8"
      },
      "items": [
        {
          "text": "hukusanya kwa ajili ya mwingine,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:8"
      },
      "items": [
        {
          "text": "ambaye atawahurumia maskini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtu yeyote akikataa kusikia sheria,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.9",
            "verseOrgIds": [
              "PRO.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:9"
      },
      "items": [
        {
          "text": "hata maombi yake ni chukizo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.9",
            "verseOrgIds": [
              "PRO.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ambaye humwongoza mwenye haki kwenye mapito mabaya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:10"
      },
      "items": [
        {
          "text": "ataanguka kwenye mtego wake mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:10"
      },
      "items": [
        {
          "text": "bali wasio na lawama watapokea urithi mwema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu tajiri anaweza kuwa na hekima machoni pake mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.11",
            "verseOrgIds": [
              "PRO.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:11"
      },
      "items": [
        {
          "text": "bali mtu maskini mwenye ufahamu atamfichua.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.11",
            "verseOrgIds": [
              "PRO.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye haki ashindapo, kuna furaha kubwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:12"
      },
      "items": [
        {
          "text": "bali waovu watawalapo, watu hujificha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye afichaye dhambi zake hatafanikiwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:13"
      },
      "items": [
        {
          "text": "bali yeyote aziungamaye na kuziacha hupata rehema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amebarikiwa mtu ambaye siku zote humcha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.28.14",
                "verseOrgIds": [
                  "PRO.28.14"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:14"
      },
      "items": [
        {
          "text": "bali yeye afanyaye moyo wake kuwa mgumu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:14"
      },
      "items": [
        {
          "text": "huangukia kwenye taabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama simba angurumaye au dubu ashambuliaye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.15",
            "verseOrgIds": [
              "PRO.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:15"
      },
      "items": [
        {
          "text": "ndivyo alivyo mtu mwovu atawalaye wanyonge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.15",
            "verseOrgIds": [
              "PRO.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
