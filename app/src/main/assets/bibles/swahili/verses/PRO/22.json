          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye apendaye moyo safi na yeye ambaye maneno yake ni ya neema,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:11"
      },
      "items": [
        {
          "text": "mfalme atakuwa rafiki yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macho ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.12",
                "verseOrgIds": [
                  "PRO.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hulinda maarifa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:12"
      },
      "items": [
        {
          "text": "bali huyapinga maneno ya asiye mwaminifu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
