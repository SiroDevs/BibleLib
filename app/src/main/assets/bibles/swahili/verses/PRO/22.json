            "number": "13",
            "style": "v",
            "sid": "PRO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvivu husema, \"Yuko simba nje!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:13"
      },
      "items": [
        {
          "text": "au, \"Nitauawa katika mitaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinywa cha mwanamke kahaba ni shimo refu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:14"
      },
      "items": [
        {
          "text": "yeye aliye chini ya ghadhabu ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.14",
                "verseOrgIds": [
                  "PRO.22.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:14"
      },
      "items": [
        {
          "text": "atatumbukia ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
