  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "PRO 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama theluji wakati wa kiangazi au mvua wakati wa mavuno,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:1"
      },
      "items": [
        {
          "text": "ndivyo asivyostahili heshima mpumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama shomoro apigapigavyo mabawa yake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:2"
      },
      "items": [
        {
          "text": "au mbayuwayu katika kuruka kwake kasi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:2"
      },
      "items": [
        {
          "text": "ndivyo ilivyo laana isiyo na sababu haimpati mtu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjeledi kwa farasi, lijamu kwa punda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:3"
      },
      "items": [
        {
          "text": "nayo fimbo kwa migongo ya wapumbavu!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimjibu mpumbavu sawasawa na upumbavu wake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:4"
      },
      "items": [
        {
          "text": "ama wewe mwenyewe utakuwa kama yeye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjibu mpumbavu sawasawa na upumbavu wake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:5"
      },
      "items": [
        {
          "text": "ama atakuwa mwenye hekima machoni pake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile ilivyo kujikata miguu au kunywa hasara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:6"
      },
      "items": [
        {
          "text": "ndivyo ilivyo kutuma ujumbe kwa mkono wa mpumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama miguu ya kiwete inavyoningʼinia",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:7"
      },
      "items": [
        {
          "text": "ndivyo ilivyo mithali katika kinywa cha mpumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama kufunga jiwe kwenye kombeo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:8"
      },
      "items": [
        {
          "text": "ndivyo ilivyo kumpa mpumbavu heshima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mwiba kwenye mkono wa mlevi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:9"
      },
      "items": [
        {
          "text": "ndivyo ilivyo mithali kinywani mwa mpumbavu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mpiga upinde ambaye hujeruhi ovyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:10"
      },
      "items": [
        {
          "text": "ndivyo alivyo yeye aajiriye mpumbavu au yeyote apitaye njiani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mbwa ayarudiavyo matapiko yake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:11"
      },
      "items": [
        {
          "text": "ndivyo mpumbavu arudiavyo upumbavu wake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, unamwona mtu ajionaye mwenye hekima",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:12"
      },
      "items": [
        {
          "text": "machoni pake mwenyewe?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:12"
      },
      "items": [
        {
          "text": "Liko tumaini zaidi kwa mpumbavu kuliko kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvivu husema, \"Yuko simba barabarani,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:13"
      },
      "items": [
        {
          "text": "simba mkali anazunguka mitaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile mlango ugeukavyo kwenye bawaba zake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:14"
      },
      "items": [
        {
          "text": "ndivyo mvivu ajigeuzavyo kitandani mwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mvivu hutumbukiza mkono wake kwenye sahani,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:15"
      },
      "items": [
        {
          "text": "naye huchoka kuupeleka kwenye kinywa chake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mvivu ni mwenye hekima machoni pake mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:16"
      },
      "items": [
        {
          "text": "kuliko watu saba wawezao kujibu kwa busara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
