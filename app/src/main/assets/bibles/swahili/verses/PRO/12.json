                "verseOrgIds": [
                  "PRO.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "humhukumu mwenye hila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
