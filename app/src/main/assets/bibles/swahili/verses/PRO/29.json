  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "PRO 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu anayeendelea kuwa na shingo ngumu baada ya maonyo mengi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:1"
      },
      "items": [
        {
          "text": "ataangamia ghafula, wala hapati dawa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenye haki wanapostawi, watu hufurahi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:2"
      },
      "items": [
        {
          "text": "waovu watawalapo, watu hulia kwa huzuni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu apendaye hekima huleta furaha kwa baba yake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:3"
      },
      "items": [
        {
          "text": "bali aambatanaye na makahaba hutapanya mali yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa haki mfalme huipa nchi uthabiti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:4"
      },
      "items": [
        {
          "text": "bali mfalme aliye na tamaa ya rushwa huiangamiza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyote amsifuye jirani yake isivyostahili,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:5"
      },
      "items": [
        {
          "text": "anautandaza wavu kuitega miguu yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mbaya hutegwa na dhambi yake mwenyewe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:6"
      },
      "items": [
        {
          "text": "bali mwenye haki huweza kuimba na kufurahi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye haki hujali haki kwa ajili ya maskini,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:7"
      },
      "items": [
        {
          "text": "bali mwovu hajishughulishi na hilo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenye mzaha huuchochea mji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:8"
      },
      "items": [
        {
          "text": "bali watu wenye hekima hugeuzia mbali hasira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mwenye hekima akienda mahakamani na mpumbavu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:9"
      },
      "items": [
        {
          "text": "mpumbavu hukasirika na kudhihaki, wala hakuna amani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wamwagao damu humchukia mtu mwadilifu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:10"
      },
      "items": [
        {
          "text": "na hutafuta kumuua mtu mnyofu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpumbavu huonyesha hasira yake yote,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:11"
      },
      "items": [
        {
          "text": "bali mwenye hekima hujizuia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtawala akisikiliza uongo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:12"
      },
      "items": [
        {
          "text": "maafisa wake wote huwa waovu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu maskini na mtu anayeonea wanafanana kwa jambo hili:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "PRO.29.13",
                "verseOrgIds": [
                  "PRO.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "hutia nuru macho yao wote wawili.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mfalme akiwaamua maskini kwa haki,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:14"
      },
      "items": [
        {
          "text": "kiti chake cha enzi kitakuwa thabiti siku zote.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fimbo ya maonyo hutia hekima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:15"
      },
      "items": [
        {
          "text": "bali mtoto aliyeachiwa bila maonyo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:15"
      },
      "items": [
        {
          "text": "humwaibisha mama yake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati waovu wanapostawi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:16"
      },
      "items": [
        {
          "text": "pia dhambi vivyo hivyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:16"
      },
      "items": [
        {
          "text": "lakini wenye haki wataliona anguko lao.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
