      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:22"
      },
      "items": [
        {
          "text": "yeye huvaa kitani safi na urujuani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.22",
            "verseOrgIds": [
              "PRO.31.22"
            ]
          }
        }
      ]
    },
    {
