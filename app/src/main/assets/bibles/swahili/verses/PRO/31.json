          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mume wake anaheshimiwa kwenye lango la mji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.23",
            "verseOrgIds": [
              "PRO.31.23"
            ]
