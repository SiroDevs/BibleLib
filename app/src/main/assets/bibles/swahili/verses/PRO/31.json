      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:23"
      },
      "items": [
        {
          "text": "aketipo miongoni mwa wazee wa nchi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.23",
            "verseOrgIds": [
              "PRO.31.23"
            ]
          }
        }
      ]
    },
