      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:1"
      },
      "items": [
        {
          "text": "bali neno liumizalo huchochea hasira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
