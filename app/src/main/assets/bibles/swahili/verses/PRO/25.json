  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "PRO 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mithali Zaidi Za Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hizi ni mithali zaidi za Solomoni, zilizonakiliwa na watu wa Hezekia mfalme wa Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.1",
            "verseOrgIds": [
              "PRO.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni Utukufu wa Mungu kuficha jambo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:2"
      },
      "items": [
        {
          "text": "bali ni utukufu wa wafalme kuchunguza jambo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mbingu zilivyo juu na nchi ilivyo chini,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:3"
      },
      "items": [
        {
          "text": "ndivyo ambavyo mioyo ya wafalme haichunguziki.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondoa takataka kwenye madini ya fedha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:4"
      },
      "items": [
        {
          "text": "nako ndani yake kutatokea chombo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:4"
      },
      "items": [
        {
          "text": "cha mfua fedha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondoa waovu mbele ya mfalme,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:5"
      },
      "items": [
        {
          "text": "nacho kiti chake cha enzi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:5"
      },
      "items": [
        {
          "text": "kitaimarishwa kwa njia ya haki.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usijikweze mwenyewe mbele ya mfalme,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:6"
      },
      "items": [
        {
          "text": "wala usidai nafasi miongoni mwa watu wakuu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni afadhali yeye akuambie, \"Njoo huku juu,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:7"
      },
      "items": [
        {
          "text": "kuliko yeye kukuaibisha mbele ya mkuu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PRO 25:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 25:7"
      },
      "items": [
        {
          "text": "Kile ulichokiona kwa macho yako",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "usiharakishe kukipeleka mahakamani,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 25:8"
      },
      "items": [
        {
          "text": "maana utafanya nini mwishoni",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:8"
      },
      "items": [
        {
          "text": "kama jirani yako atakuaibisha?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ukifanya shauri na jirani yako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:9"
      },
      "items": [
        {
          "text": "usisaliti siri ya mtu mwingine,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama yeye aisikiaye aweza kukuaibisha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:10"
      },
      "items": [
        {
          "text": "na kamwe sifa yako mbaya haitaondoka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno lisemwalo kwa wakati ufaao",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:11"
      },
      "items": [
        {
          "text": "ni kama matunda ya mtofaa ya dhahabu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:11"
      },
      "items": [
        {
          "text": "yaliyowekwa kwenye vijalizo vya fedha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile kipuli cha dhahabu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:12"
      },
      "items": [
        {
          "text": "au pambo la dhahabu safi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 25:12"
      },
      "items": [
        {
          "text": "ndivyo lilivyo karipio la mtu mwenye hekima",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:12"
      },
      "items": [
        {
          "text": "kwa sikio lisikilizalo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile ubaridi wa theluji wakati wa mavuno",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:13"
      },
      "items": [
        {
          "text": "ndivyo alivyo mjumbe mwaminifu kwa wale wamtumao,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:13"
      },
      "items": [
        {
          "text": "huburudisha roho za bwana zake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile mawingu na upepo pasipo mvua",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:14"
      },
      "items": [
        {
          "text": "ndivyo alivyo mtu ajisifuye kwa zawadi ambazo hatoi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa njia ya uvumilivu mtawala aweza kushawishiwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.15",
            "verseOrgIds": [
              "PRO.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:15"
      },
      "items": [
        {
          "text": "nao ulimi laini waweza kuvunja mfupa.",
