                "verseId": "PRO.19.14",
                "verseOrgIds": [
                  "PRO.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
            ]
          }
        }
      ]
    },
