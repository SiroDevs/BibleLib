          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa zitakuongezea miaka mingi ya maisha yako",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
