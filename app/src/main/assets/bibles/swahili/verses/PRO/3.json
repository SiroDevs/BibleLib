      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:1"
      },
      "items": [
        {
          "text": "bali zitunze amri zangu moyoni mwako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
