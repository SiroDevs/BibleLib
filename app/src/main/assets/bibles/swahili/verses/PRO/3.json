      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "vifunge shingoni mwako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "viandike katika ubao wa moyo wako.",
