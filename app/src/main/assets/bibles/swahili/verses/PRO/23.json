      "attrs": {
        "style": "q2",
        "vid": "PRO 23:13"
      },
      "items": [
        {
          "text": "ukimwadhibu kwa fimbo, hatakufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        }
      ]
    },
    {
