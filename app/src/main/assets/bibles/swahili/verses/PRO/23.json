      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:15"
      },
      "items": [
        {
          "text": "basi moyo wangu utafurahi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
