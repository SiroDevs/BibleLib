      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:14"
      },
      "items": [
        {
          "text": "na kuiokoa nafsi yake kutoka mautini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
