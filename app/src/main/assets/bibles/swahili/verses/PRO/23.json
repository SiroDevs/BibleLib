      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uketipo kula chakula na mtawala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:1"
      },
      "items": [
        {
          "text": "angalia vyema kile kilicho mbele yako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na utie kisu kooni mwako",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:2"
      },
      "items": [
        {
          "text": "kama ukiwa mlafi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usitamani vyakula vyake vitamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:3"
      },
      "items": [
        {
          "text": "kwa kuwa chakula hicho ni cha hila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usijitaabishe ili kuupata utajiri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:4"
      },
      "items": [
        {
          "text": "uwe na hekima kuonyesha kujizuia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumba na kufumbua utajiri hutoweka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:5"
      },
      "items": [
        {
          "text": "huwa kama umepata mabawa ghafula,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:5"
      },
      "items": [
        {
          "text": "ukaruka na kutoweka angani kama tai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usile chakula cha mtu mchoyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:6"
      },
      "items": [
        {
          "text": "usitamani vyakula vyake vitamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa maana yeye ni aina ya mtu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "ambaye kila mara anafikiri juu ya gharama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "Anakuambia, \"Kula na kunywa,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "lakini moyo wake hauko pamoja nawe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utatapika kile kidogo ulichokula,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:8"
      },
      "items": [
        {
          "text": "nawe utakuwa umepoteza bure",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:8"
      },
      "items": [
        {
          "text": "maneno yako ya kumsifu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
