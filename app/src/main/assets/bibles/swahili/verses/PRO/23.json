      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:12"
      },
      "items": [
        {
          "text": "na masikio yako kwenye maneno ya maarifa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
