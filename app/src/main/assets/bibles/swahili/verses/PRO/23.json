          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadhibu kwa fimbo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
