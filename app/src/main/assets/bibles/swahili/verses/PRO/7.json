  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PRO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyo Dhidi Ya Mwanamke Mzinzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, shika maneno yangu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:1"
      },
      "items": [
        {
          "text": "na kuzihifadhi amri zangu ndani yako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shika amri zangu nawe utaishi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:2"
      },
      "items": [
        {
          "text": "linda mafundisho yangu kama mboni ya jicho lako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yafunge katika vidole vyako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:3"
      },
      "items": [
        {
          "text": "yaandike katika kibao cha moyo wako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambie hekima, \"Wewe ni dada yangu,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:4"
      },
      "items": [
        {
          "text": "uite ufahamu jamaa yako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "watakuepusha na mwanamke mzinzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:5"
      },
      "items": [
        {
          "text": "kutokana na mwanamke mpotovu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:5"
      },
      "items": [
        {
          "text": "na maneno yake ya kubembeleza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenye dirisha la nyumba yangu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:6"
      },
      "items": [
        {
          "text": "nilitazama nje kupitia upenyo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:6"
      },
      "items": [
        {
          "text": "kwenye mwimo wa dirisha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliona miongoni mwa wajinga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "nikagundua miongoni mwa wanaume vijana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "kijana asiye na akili.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikuwa akishuka njiani karibu na pembe ya kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:8"
      },
      "items": [
        {
          "text": "akielekea kwenye nyumba ya huyo mwanamke",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati wa machweo, jua likipungua nuru yake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:9"
      },
      "items": [
        {
          "text": "giza la usiku lilipokuwa likiingia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo huyo mwanamke akatoka kumlaki,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:10"
      },
      "items": [
        {
          "text": "hali amevaa kama kahaba akiwa na nia ya udanganyifu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ni mwanamke mwenye makelele na mkaidi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:11"
      },
      "items": [
        {
          "text": "miguu yake haitulii nyumbani;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mara kwenye barabara za mji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:12"
      },
      "items": [
        {
          "text": "mara kwenye viwanja vikubwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:12"
      },
      "items": [
        {
          "text": "kwenye kila pembe huvizia.)",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo mwanamke alimkumbatia kijana na kumbusu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:13"
      },
      "items": [
        {
          "text": "na kwa uso usio na haya akamwambia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nina sadaka za amani nyumbani;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:14"
      },
      "items": [
        {
          "text": "leo nimetimiza nadhiri zangu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo nimetoka nje kukulaki;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:15"
      },
      "items": [
        {
          "text": "nimekutafuta na nimekupata!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimetandika kitanda changu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:16"
      },
      "items": [
        {
          "text": "kwa kitani za rangi kutoka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimetia manukato kitanda changu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:17"
      },
      "items": [
        {
          "text": "kwa manemane, udi na mdalasini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
