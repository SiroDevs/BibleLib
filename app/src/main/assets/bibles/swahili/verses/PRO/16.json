          "text": "kwa maana kiti cha ufalme hufanywa imara kwa njia ya haki.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
