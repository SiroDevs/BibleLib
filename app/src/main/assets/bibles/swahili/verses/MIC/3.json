      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Viongozi Na Manabii Wakemewa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikasema,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "\"Sikilizeni enyi viongozi wa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "enyi watawala wa nyumba ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "Je, hampaswi kujua hukumu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninyi mnaochukia mema",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "na kupenda maovu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "ninyi mnaowachuna watu wangu ngozi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "na kuondoa nyama kwenye mifupa yao;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninyi mnaokula nyama ya watu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
