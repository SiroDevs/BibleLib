          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo usiku utawajieni, msiweze kuwa na maono,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "na giza, msiweze kubashiri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "Jua litawachwea manabii hao,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "nao mchana utakuwa giza kwao.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
