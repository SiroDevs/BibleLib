      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "kumtangazia Yakobo kosa lake,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
