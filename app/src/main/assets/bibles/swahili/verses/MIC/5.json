    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "Ukombozi Na Uharibifu",
          "type": "text"
        }
      ]
