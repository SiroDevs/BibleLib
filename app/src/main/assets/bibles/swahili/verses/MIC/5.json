    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mtawala Aliyeahidiwa Kutoka Bethlehemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panga majeshi yako, ee mji wa majeshi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "kwa kuwa kuzingirwa kumepangwa dhidi yetu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "Watampiga mtawala wa Israeli",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "shavuni kwa fimbo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini wewe, Bethlehemu Efrathi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ingawa u mdogo miongoni mwa koo za Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "kutoka kwako atatokea kwa ajili yangu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "yeye atakayekuwa mtawala katika Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ambaye asili yake ni kutoka zamani,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "kutoka milele.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
