        {
          "text": "Kwa hiyo Israeli utaachwa mpaka wakati",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "mwanamke aliye na utungu atakapozaa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "na ndugu zake wengine warudi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
