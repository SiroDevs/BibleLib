    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahadi Ya Mungu Kwa Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.17.1-1CH.17.15"
          },
          "items": [
            {
              "text": "1 Nyakati 17:1-15",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya mfalme kuingia rasmi katika jumba lake la kifalme, naye",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.1",
            "verseOrgIds": [
              "2SA.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.1",
                "verseOrgIds": [
                  "2SA.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akiwa amemstarehesha pande zote mbali na adui zake,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.1",
            "verseOrgIds": [
              "2SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamwambia nabii Nathani, \"Mimi hapa, ninaishi katika jumba la kifalme la mierezi, wakati Sanduku la Mungu limebaki katika hema.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
            "verseOrgIds": [
              "2SA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nathani akamjibu mfalme, \"Lolote ulilo nalo moyoni, endelea ukalifanye, kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.3",
                "verseOrgIds": [
                  "2SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "yu pamoja nawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ule neno la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.4",
                "verseOrgIds": [
                  "2SA.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "likamjia Nathani, kusema:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nenda ukamwambie mtumishi wangu Daudi, 'Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.5",
                "verseOrgIds": [
                  "2SA.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": ": Je, ewe ndiwe wa kunijengea mimi nyumba ili nikae ndani yake?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sijakaa ndani ya nyumba tangu siku niliyowaleta Waisraeli kutoka Misri hadi leo. Nimekuwa nikitembea kutoka mahali pamoja hadi mahali pengine ndani ya hema kama makao yangu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popote nilipotembea pamoja na Waisraeli wote, je, nimewahi kumwambia kiongozi wao yeyote niliyemwamuru kuwachunga watu wangu Israeli, \"Kwa nini hujanijengea nyumba ya mierezi?\" '",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.7",
            "verseOrgIds": [
              "2SA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sasa basi, mwambie mtumishi wangu Daudi, 'Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.8",
                "verseOrgIds": [
                  "2SA.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote: Nilikutoa wewe kutoka machungani na kutoka kuandama kundi la kondoo na mbuzi ili kuwaongoza watu wangu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimekuwa pamoja nawe popote ulipokwenda, nami nimekuondolea mbali adui zako wote mbele yako. Basi nitalifanya jina lako kuwa kuu kama majina ya watu walio wakuu sana duniani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.9",
            "verseOrgIds": [
              "2SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitawapatia watu wangu Israeli mahali niwapande humo ili kwamba wawe na nyumbani kwao wenyewe wasisumbuliwe tena. Watu waovu hawatawaonea tena, kama walivyofanya mwanzoni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.10",
            "verseOrgIds": [
              "2SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kama walivyofanya tangu mwanzo wakati nilipowaweka viongozi juu ya watu wangu Israeli. Pia nitawapa raha mbele ya adui zenu wote.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2SA 7:11"
      },
      "items": [
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.11",
                "verseOrgIds": [
                  "2SA.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akuambia kwamba",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.11",
                "verseOrgIds": [
                  "2SA.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mwenyewe atakujengea nyumba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku zako zitakapokwisha nawe ulale pamoja na baba zako, nitainua mzao wako aingie mahali pako, ambaye atatoka viunoni mwako, nami nitauimarisha ufalme wake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.12",
            "verseOrgIds": [
              "2SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ndiye atakayejenga nyumba kwa ajili ya Jina langu, nami nitaimarisha kiti cha enzi cha ufalme wake milele.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.13",
            "verseOrgIds": [
              "2SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakuwa baba yake, naye atakuwa mwanangu. Atakapokosea nitamwadhibu kwa fimbo ya wanadamu, kwa adhabu ya kupigwa na wanadamu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.14",
            "verseOrgIds": [
              "2SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini upendo wangu kamwe hautaondolewa kwake, kama nilivyouondoa kwa Sauli, niliyemwondoa atoke mbele yako.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.15",
            "verseOrgIds": [
              "2SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba yako na ufalme wako utadumu milele mbele zangu, kiti chako cha enzi kitafanywa imara milele.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.16",
            "verseOrgIds": [
              "2SA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nathani akamwarifu Daudi maneno yote ya maono haya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.17",
            "verseOrgIds": [
              "2SA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maombi Ya Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.17.16-1CH.17.27"
          },
          "items": [
            {
              "text": "1 Nyakati 17:16-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mfalme Daudi akaingia ndani, akaketi mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.18",
                "verseOrgIds": [
                  "2SA.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", akasema:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2SA 7:18"
      },
      "items": [
        {
          "text": "\"Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.18",
                "verseOrgIds": [
                  "2SA.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi, mimi ni nani, na jamaa yangu ni nini, hata umenileta mpaka hapa nilipo?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, kana kwamba hili halitoshi machoni pako, Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.19",
                "verseOrgIds": [
                  "2SA.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi, wewe umenena pia kuhusu siku zijazo za nyumba ya mtumishi wako. Je, hii ndiyo njia yako ya kawaida ya kushughulika na mwanadamu, Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.19",
                "verseOrgIds": [
                  "2SA.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Je, Daudi aweza kukuambia nini zaidi? Kwa maana unamjua mtumishi wako, Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.20",
            "verseOrgIds": [
              "2SA.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.20",
                "verseOrgIds": [
                  "2SA.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.20",
            "verseOrgIds": [
              "2SA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya neno lako na kwa mapenzi yako, umefanya jambo hili kubwa na kulifanya lijulikane na lifahamike kwa mtumishi wako.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.21",
            "verseOrgIds": [
              "2SA.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tazama jinsi ulivyo mkuu, Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.22",
                "verseOrgIds": [
                  "2SA.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi! Hakuna mwingine kama wewe, wala hakuna Mungu ila wewe, kama vile tulivyosikia kwa masikio yetu wenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ni nani aliye kama watu wako Israeli, taifa pekee duniani ambalo Mungu alitoka kwenda kulikomboa kwa ajili yake mwenyewe, na kujifanyia jina mwenyewe, kwa kufanya maajabu makubwa na ya kutisha kwa kuwafukuza mataifa na miungu yao mbele ya watu wako, ambao uliwakomboa kutoka Misri?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.23",
            "verseOrgIds": [
              "2SA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umeimarisha watu wako Israeli hasa kama watu wako mwenyewe milele, nawe, Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.24",
                "verseOrgIds": [
                  "2SA.7.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", umekuwa Mungu wao.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Basi sasa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.25",
                "verseOrgIds": [
                  "2SA.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", ukaitimize ahadi uliyosema kuhusu mtumishi wako na nyumba yake milele. Fanya kama ulivyoahidi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kwamba jina lako litukuke milele. Ndipo watu watasema, '",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.26",
                "verseOrgIds": [
                  "2SA.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote ni Mungu juu ya Israeli!' Nayo nyumba ya mtumishi wako Daudi itakuwa imara mbele zako.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.27",
                "verseOrgIds": [
                  "2SA.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, Mungu wa Israeli, umelifunua hili kwa mtumishi wako, ukisema, 'Nitakujengea nyumba.' Hivyo mtumishi wako amepata ujasiri kukuletea dua hii.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.28",
                "verseOrgIds": [
                  "2SA.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi, wewe ndiwe Mungu! Maneno yako ndiyo kweli, nawe umemwahidi mtumishi wako mambo haya mazuri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa naomba uwe radhi kuibariki nyumba ya mtumishi wako, ili idumu mbele zako milele, kwa maana wewe, Ee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.29",
                "verseOrgIds": [
                  "2SA.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi, umesema, na kwa baraka zako nyumba ya mtumishi wako itaendelea kubarikiwa milele.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
      ]
    }
  ],
