  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2SA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Afahamishwa Kifo Cha Sauli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kifo cha Sauli, Daudi alipokuwa amerudi kutoka kuwashinda Waamaleki, Daudi alikaa siku mbili huko Siklagi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya tatu akaja mtu mwenye nguo zilizoraruka na mavumbi kichwani mwake kutoka kwenye kambi ya Sauli. Alipomjia Daudi, akajitupa chini ili kumpa heshima.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.2",
            "verseOrgIds": [
              "2SA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akamuuliza, \"Wewe umetoka wapi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.3",
            "verseOrgIds": [
              "2SA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:3"
      },
      "items": [
        {
          "text": "Akamjibu, \"Nimetoroka kutoka kambi ya Waisraeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.3",
            "verseOrgIds": [
              "2SA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akamuuliza, \"Ni nini kilichotokea? Niambie.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.4",
            "verseOrgIds": [
              "2SA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:4"
      },
      "items": [
        {
          "text": "Akasema, \"Watu walikimbia kutoka vitani. Wengi wao walianguka na kufa. Naye Sauli na Yonathani mwanawe wamekufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.4",
            "verseOrgIds": [
              "2SA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Daudi akamwambia huyo kijana aliyemletea taarifa, \"Je, umefahamuje kwamba Sauli na Yonathani mwanawe wamekufa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.5",
            "verseOrgIds": [
              "2SA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule kijana akasema, \"Nilijipata huko Mlima Gilboa, naye Sauli alikuwa huko akiegemea mkuki wake, na magari ya vita na wapanda farasi wa upande wa adui wakawa wamemkaribia sana.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.6",
            "verseOrgIds": [
              "2SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipogeuka na kuniona, akaniita, nami nikasema, 'Je, nifanye nini?'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.7",
            "verseOrgIds": [
              "2SA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akaniuliza, 'Wewe ni nani?'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:8"
      },
      "items": [
        {
          "text": "\"Nikamjibu, 'Mimi ni Mwamaleki.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kisha akaniambia, 'Nikaribie mimi na uniue! Niko katika maumivu makali ya kifo, lakini bado ningali hai.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.9",
            "verseOrgIds": [
              "2SA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa hiyo nikamkaribia nikamuua, kwa sababu nilijua kwamba baada ya kuanguka hangeweza kupona. Nami nikachukua lile taji lililokuwa kichwani mwake na utepe uliokuwa mkononi mwake nami nimevileta hapa kwa bwana wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Daudi pamoja na watu wote waliokuwa pamoja naye wakazishika nguo zao na kuzirarua.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaomboleza, wakalia pia na kufunga mpaka jioni kwa ajili ya Sauli na Yonathani mwanawe, kwa ajili ya jeshi la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.1.12",
                "verseOrgIds": [
                  "2SA.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "na nyumba ya Israeli, kwa sababu wameanguka kwa upanga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akamwambia yule kijana aliyemletea taarifa, \"Wewe ni mwenyeji wa wapi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 1:13"
      },
      "items": [
        {
          "text": "Akamjibu, \"Mimi ni mwana wa mgeni, Mwamaleki.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akamuuliza, \"Kwa nini hukuogopa kuinua mkono wako ili kumwangamiza mpakwa mafuta wa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.1.14",
                "verseOrgIds": [
                  "2SA.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Daudi akamwita mmoja wa watu wake na kumwambia, \"Nenda ukamuue!\" Kwa hiyo akampiga, naye akafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana Daudi alikuwa amemwambia, \"Damu yako iwe juu ya kichwa chako mwenyewe. Kinywa chako mwenyewe kimeshuhudia dhidi yako uliposema, 'Nilimuua mpakwa mafuta wa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.1.16",
                "verseOrgIds": [
                  "2SA.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ombolezo La Daudi Kwa Ajili Ya Sauli Na Yonathani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akafanya maombolezo haya kuhusu Sauli na Yonathani mwanawe,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.17",
            "verseOrgIds": [
              "2SA.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akaagiza kwamba watu wa Yuda wafundishwe ombolezo hili la upinde (ambalo limeandikwa katika Kitabu cha Yashari):",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Walio fahari yako, ee Israeli, wameuawa juu ya mahali pako palipoinuka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.19",
            "verseOrgIds": [
              "2SA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:19"
      },
      "items": [
        {
          "text": "Jinsi wenye nguvu walivyoanguka!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.19",
            "verseOrgIds": [
              "2SA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Msilisimulie hili katika Gathi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "msilitangaze hili katika",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "barabara za Ashkeloni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "binti za Wafilisti wasije wakafurahia,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "binti za hao wasiotahiriwa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "wasije wakashangilia.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
