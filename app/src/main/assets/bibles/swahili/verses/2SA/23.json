          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miongoni mwa wale Thelathini walikuwepo:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        }
      ]
    },
    {
