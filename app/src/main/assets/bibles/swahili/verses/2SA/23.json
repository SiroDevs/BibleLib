      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2SA 23:24"
      },
      "items": [
        {
          "text": "Asaheli ndugu wa Yoabu;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2SA 23:24"
      },
      "items": [
        {
          "text": "Elhanani mwana wa Dodo kutoka Bethlehemu;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
