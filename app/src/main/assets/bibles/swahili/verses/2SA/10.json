        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Awashinda Waamoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.19.1-1CH.19.19"
          },
          "items": [
            {
              "text": "1 Nyakati 19:1-19",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya muda, mfalme wa Waamoni akafa, naye Hanuni mwanawe akaingia mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akawaza, \"Nitamtendea wema Hanuni mwana wa Nahashi, kama vile baba yake alivyonitendea mimi wema.\" Hivyo Daudi akatuma wajumbe kuonyesha wema wake kwa Hanuni kuhusu baba yake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:2"
      },
      "items": [
        {
          "text": "Watu wa Daudi walipofika katika nchi ya Waamoni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakuu wa Waamoni wakamwambia Hanuni bwana wao, \"unadhani Daudi anamheshimu baba yako kwa kukutumia watu ili kuonyesha masikitiko? Je, Daudi hakuwatuma watu hawa kuchunguza na kuupeleleza mji ili kuupindua?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hanuni akawakamata watu wa Daudi, akawanyoa kila mmoja ndevu zake nusu, akakata mavazi yao nyuma katikati kwenye matako, akawaacha waende zao.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alipoambiwa jambo hili, akatuma wajumbe ili kwenda kuwalaki, kwa maana walikuwa wamevunjiwa heshima sana. Mfalme akasema, \"Kaeni huko Yeriko mpaka ndevu zenu ziote ndipo mje.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamoni walipotambua kuwa wamekuwa machukizo kwa Daudi, wakaajiri askari wa miguu 20,000 Waaramu kutoka Beth-Rehobu na Soba, pia mfalme wa Maaka pamoja na watu 1,000, na vilevile watu 12,000 kutoka Tobu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aliposikia jambo hili, akamtuma Yoabu na jeshi lote la wapiganaji.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamoni wakatoka wakajipanga wakiwa tayari kwa vita langoni la mji wao, wakati Waaramu wa Soba, wa Rehobu, watu wa Tobu na Maaka walikuwa peke yao kwenye eneo la wazi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu akaona kuwa mbele yake na nyuma yake kumepangwa vita; kwa hiyo akachagua baadhi ya vikosi vilivyo bora sana katika Israeli akavipanga dhidi ya Waaramu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaweka waliobaki chini ya uongozi wa Abishai nduguye na kuwapanga dhidi ya Waamoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu akasema, \"Kama Waaramu watanizidi nguvu, basi itawabidi mje kunisaidia. Lakini kama Waamoni watawazidi nguvu, basi nitakuja kuwasaidia.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe hodari na tupigane kwa ujasiri kwa ajili ya watu wetu na miji ya Mungu wetu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.10.12",
                "verseOrgIds": [
                  "2SA.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "atafanya lile lililo jema machoni pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoabu na vikosi vyake wakasonga mbele kupigana na Waaramu, nao Waaramu wakakimbia mbele yake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamoni walipoona Waaramu wanakimbia, nao wakakimbia mbele ya Abishai na kuingia ndani ya mji. Basi Yoabu akarudi kutoka kupigana na Waamoni na kufika Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Waaramu kuona wameshindwa na Israeli, wakajikusanya tena.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadezeri akaagiza Waaramu walioletwa kutoka ngʼambo ya Mto Frati, wakaenda Helamu pamoja na Shobaki jemadari wa jeshi la Hadadezeri akiwaongoza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alipoambiwa haya, akawakusanya Israeli wote, wakavuka Mto Yordani, wakaenda Helamu. Waaramu wakapanga vikosi vyao vya askari kukabiliana na kupigana dhidi ya Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Waaramu wakakimbia mbele ya Israeli, naye Daudi akawaua waendesha magari mia saba na askari wao wa miguu 40,000. Vilevile alimpiga Shobaki jemadari wa jeshi lao, naye akafa huko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafalme wote waliokuwa wanamtumikia Hadadezeri walipoona kuwa wameshindwa na Israeli, wakafanya amani na Waisraeli na wakawa chini yao.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:19"
      },
      "items": [
        {
          "text": "Hivyo Waaramu wakaogopa kuwasaidia Waamoni tena.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    }
  ],
