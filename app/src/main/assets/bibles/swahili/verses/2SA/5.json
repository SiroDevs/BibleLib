                "verseOrgIds": [
                  "2SA.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ametangulia mbele yako kupiga jeshi la Wafilisti.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
