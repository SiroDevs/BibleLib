              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafilisti walikwea kwa mara nyingine na kusambaa katika Bonde la Warefai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
