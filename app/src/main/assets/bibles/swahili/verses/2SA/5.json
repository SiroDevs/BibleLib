                "verseOrgIds": [
                  "2SA.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye akamjibu, \"Usipande moja kwa moja, bali wazungukie kwa nyuma na uwashambulie mbele ya miti ya miforosadi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
