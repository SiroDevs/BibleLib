          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara utakaposikia sauti ya kutembea kutoka kwenye vilele vya miti ya miforosadi, nenda haraka, kwa sababu hiyo itamaanisha kuwa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
