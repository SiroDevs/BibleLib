          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Atawazwa Mfalme Juu Ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.11.1-1CH.11.9"
          },
          "items": [
            {
              "text": "1 Nyakati 11:1-9",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.14.1-1CH.14.7"
          },
          "items": [
            {
              "text": "14:1-7",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makabila yote ya Israeli yakamjia Daudi huko Hebroni na kumwambia, \"Sisi tu nyama yako na damu yako hasa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.1",
            "verseOrgIds": [
              "2SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zamani, wakati Sauli alikuwa mfalme juu yetu, wewe ndiwe uliyeiongoza Israeli vitani. Naye",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.2",
                "verseOrgIds": [
                  "2SA.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuambia, 'Wewe utawachunga watu wangu Israeli, na utakuwa mtawala wao.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazee wote wa Israeli wakamwendea Mfalme Daudi huko Hebroni, mfalme akafanya mapatano nao huko Hebroni mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.3",
                "verseOrgIds": [
                  "2SA.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", nao wakamtia Daudi mafuta kuwa mfalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi alikuwa na miaka thelathini alipoanza kutawala, naye akatawala Israeli miaka arobaini.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko Hebroni alitawala Yuda kwa miaka saba na miezi sita, na katika Yerusalemu alitawala Israeli yote na Yuda kwa miaka thelathini na mitatu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Ateka Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme na watu wake wakaenda Yerusalemu kuwashambulia Wayebusi walioishi humo. Wayebusi wakamwambia Daudi, \"Wewe hutaingia humu, kwani hata vipofu na viwete wanaweza kukufukuza.\" Walidhani, \"Daudi hawezi kuingia humu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.6",
            "verseOrgIds": [
              "2SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo, Daudi akaiteka ngome ya Sayuni, Mji wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
              "2SA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ile, Daudi akasema, \"Yeyote ambaye atawashinda Wayebusi, atatumia huo mfereji kuwafikia hao 'viwete na vipofu' ambao ni adui za Daudi.\" Ndiyo sababu wanasema, \" 'Vipofu na viwete' hawataingia kwenye jumba la ufalme.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Daudi akafanya makao ndani ya ngome na kuiita Mji wa Daudi. Akajenga eneo linalozunguka kuanzia Milo",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
              "2SA.5.9"
            ]
          }
        },
        {
          "text": "kuelekea ndani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
              "2SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akazidi kuwa na nguvu zaidi na zaidi, kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.10",
                "verseOrgIds": [
                  "2SA.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu Mwenye Nguvu Zote alikuwa pamoja naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hiramu mfalme wa Tiro akawatuma wajumbe kwa Daudi, wakiwa na magogo ya mierezi, maseremala na waashi, nao wakajenga jumba la kifalme kwa ajili ya Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.11",
            "verseOrgIds": [
              "2SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi akafahamu kuwa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.12",
                "verseOrgIds": [
                  "2SA.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": "amemwimarisha kuwa mfalme juu ya Israeli na ameinua ufalme wake kwa ajili ya Israeli, watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Daudi kuondoka Hebroni, akajitwalia masuria zaidi na wake huko Yerusalemu, nao wana na binti wengi walizaliwa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.13",
            "verseOrgIds": [
              "2SA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo majina ya watoto waliozaliwa kwake huko: Shamua, Shobabu, Nathani, Solomoni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
            "verseOrgIds": [
              "2SA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibihari, Elishua, Nefegi, Yafia,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.15",
            "verseOrgIds": [
              "2SA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama, Eliada na Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.16",
            "verseOrgIds": [
              "2SA.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Awashinda Wafilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.14.8-1CH.14.17"
          },
          "items": [
            {
              "text": "1 Nyakati 14:8-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafilisti waliposikia kuwa Daudi ametiwa mafuta kuwa mfalme wa Israeli, wakapanda na jeshi lao lote kwenda kumsaka, lakini Daudi akapata habari hizo, naye akateremka kwenye ngome.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.17",
            "verseOrgIds": [
              "2SA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Wafilisti walikuwa wamekuja na kusambaa kwenye Bonde la Warefai,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.18",
            "verseOrgIds": [
              "2SA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa hiyo Daudi akamuuliza",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.19",
                "verseOrgIds": [
                  "2SA.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Je, niende kuwashambulia Wafilisti? Je, utawatia mikononi mwangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 5:19"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.19",
                "verseOrgIds": [
                  "2SA.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "akamjibu, \"Nenda, kwa maana hakika nitawatia Wafilisti mikononi mwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Daudi akaenda mpaka Baal-Perasimu, na huko akawashinda Wafilisti. Akasema, \"Kama mafuriko yafurikavyo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.20",
                "verseOrgIds": [
                  "2SA.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "amewafurikia adui zangu mbele yangu.\" Kwa hiyo mahali hapo pakaitwa Baal-Perasimu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafilisti wakaiacha miungu yao huko, naye Daudi na watu wake wakaichukua.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
      ]
