              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Daudi akamuuliza",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
