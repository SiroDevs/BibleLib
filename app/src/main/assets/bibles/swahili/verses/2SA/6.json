              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya kumaliza kutoa sadaka za kuteketezwa na sadaka za amani, Daudi akawabariki watu katika jina la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
