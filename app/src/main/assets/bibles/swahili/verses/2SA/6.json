          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Daudi akakusanya watu 30,000 wa Israeli waliochaguliwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye na watu wake wote wakatoka Baala ya Yuda",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "text": "kulipandisha Sanduku la Mungu kutoka huko, linaloitwa kwa Jina, naam, jina la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.2",
                "verseOrgIds": [
                  "2SA.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, ambaye anaketi katika kiti cha enzi kati ya makerubi walioko juu ya hilo Sanduku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaweka hilo Sanduku la Mungu juu ya gari jipya la kukokotwa na kulileta kutoka nyumba ya Abinadabu, iliyokuwa juu ya kilima. Uza na Ahio, wana wa Abinadabu, walikuwa wakiongoza hilo gari jipya la kukokotwa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "likiwa na Sanduku la Mungu juu yake, naye Ahio alikuwa anatembea akiwa mbele yake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na nyumba yote ya Israeli walikuwa wanacheza mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.5",
                "verseOrgIds": [
                  "2SA.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa nguvu zao zote, kwa nyimbo, vinubi, zeze, matari, kayamba na matoazi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipofika kwenye uwanja wa kupuria nafaka wa Nakoni, Uza akanyoosha mkono na kulishika Sanduku la Mungu kwa sababu maksai walijikwaa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasira ya",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.7",
                "verseOrgIds": [
                  "2SA.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ikawaka dhidi ya Uza kwa sababu ya kitendo chake cha kukosa heshima, kwa hiyo Mungu akampiga akafia papo hapo kando ya Sanduku la Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Daudi akakasirika kwa sababu ghadhabu ya",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.8",
                "verseOrgIds": [
                  "2SA.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ilifurika dhidi ya Uza, hivyo hadi leo mahali hapo panaitwa Peres-Uza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akamwogopa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.9",
                "verseOrgIds": [
                  "2SA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "siku ile, akasema, \"Ni jinsi gani Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.9",
                "verseOrgIds": [
                  "2SA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "litakavyoweza kunijia?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuwa radhi kulichukua Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.10",
                "verseOrgIds": [
                  "2SA.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwake katika Mji wa Daudi. Badala yake akalipeleka kwenye nyumba ya Obed-Edomu, Mgiti.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.11",
                "verseOrgIds": [
                  "2SA.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "likabaki katika nyumba ya Obed-Edomu, Mgiti, kwa miezi mitatu, naye",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.11",
                "verseOrgIds": [
                  "2SA.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akambariki pamoja na nyumba yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Mfalme Daudi akaambiwa, \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.12",
                "verseOrgIds": [
                  "2SA.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ameibariki nyumba ya Obed-Edomu pamoja na kila alicho nacho, kwa sababu ya Sanduku la Mungu.\" Basi Daudi akateremka na kulipandisha Sanduku la Mungu kutoka nyumba ya Obed-Edomu hadi Mji wa Daudi kwa shangwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale waliokuwa wamebeba Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.13",
                "verseOrgIds": [
                  "2SA.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "walipokuwa wametembea hatua sita, Daudi alitoa dhabihu fahali na ndama aliyenoneshwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi, akiwa amevaa kisibau cha kitani, alicheza mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.14",
                "verseOrgIds": [
                  "2SA.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa nguvu zake zote,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati yeye na nyumba yote ya Israeli walipopandisha Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.15",
                "verseOrgIds": [
                  "2SA.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa shangwe na sauti za tarumbeta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa Sanduku la",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.16",
                "verseOrgIds": [
                  "2SA.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "lilipokuwa linaingia katika Mji wa Daudi, Mikali binti Sauli akachungulia dirishani. Naye alipomwona Mfalme Daudi akirukaruka na kucheza mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.16",
                "verseOrgIds": [
                  "2SA.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", akamdharau moyoni mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 6:17"
