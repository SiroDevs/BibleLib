                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ambaye alinichagua mimi badala ya baba yako au mwingine yeyote kutoka nyumba yake wakati aliponiweka niwe mtawala juu ya Israeli, watu wa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
