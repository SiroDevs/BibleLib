  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "DAN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndoto Ya Nebukadneza Ya Mti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Nebukadneza,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Kwa kabila za watu, mataifa na watu wa kila lugha, wanaoishi katika ulimwengu wote:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Mafanikio yawe kwenu sana!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni furaha yangu kuwaambia kuhusu ishara za miujiza na maajabu ambayo Mungu Aliye Juu Sana amenifanyia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishara zake ni kuu aje,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.3",
            "verseOrgIds": [
              "DAN.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "na maajabu yake yana nguvu aje!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.3",
            "verseOrgIds": [
              "DAN.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "Ufalme wake ni ufalme wa milele;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.3",
            "verseOrgIds": [
              "DAN.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "enzi yake hudumu kutoka kizazi hadi kizazi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.3",
            "verseOrgIds": [
              "DAN.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi, Nebukadneza, nilikuwa nyumbani katika jumba langu la kifalme, nikiwa ninaishi kwa raha na hali ya kufanikiwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.4",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliota ndoto iliyoniogopesha. Nilipokuwa nimelala kitandani mwangu, njozi na maono yaliyopita mawazoni mwangu vilinitisha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.5",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo nikaagiza kwamba watu wote wenye hekima wa Babeli waletwe mbele yangu kunifasiria ndoto yangu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.6",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokuja waganga, wasihiri, wanajimu na waaguzi, niliwaambia ndoto yangu, lakini hawakuweza kunifasiria.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwishoni, Danieli alikuja mbele yangu nikamweleza hiyo ndoto. (Danieli anaitwa Belteshaza, kwa jina la mungu wangu, nayo roho ya miungu mitakatifu inakaa ndani yake.)",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.8",
            "verseOrgIds": [
              "DAN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilisema, \"Belteshaza, mkuu wa waganga, ninajua kuwa roho ya miungu mitakatifu iko ndani yako, wala hakuna siri iliyo ngumu kwako. Hii ndiyo ndoto yangu, nifasirie.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo maono niliyoona nilipokuwa nimelala kitandani mwangu: Nilitazama, na mbele yangu ulisimama mti katikati ya nchi. Ulikuwa mrefu sana.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mti ule ulikua, ukawa mkubwa na wenye nguvu, nayo ncha yake ikagusa anga; ulionekana mpaka miisho ya dunia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.11",
            "verseOrgIds": [
              "DAN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majani yake yalikuwa ya kupendeza, matunda yake yalikuwa mengi, na juu yake kulikuwa na chakula kwa ajili ya wote. Chini ya kivuli chake wanyama wa kondeni walipata hifadhi, na ndege wa angani waliishi katika matawi yake. Kila kiumbe kililishwa kutokana na mti huo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Katika maono niliyoyaona nikiwa nimelala kitandani mwangu, nilitazama, na mbele yangu alikuwepo mlinzi, aliye mtakatifu, akishuka kutoka mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita kwa sauti kubwa: 'Kateni mti huu, myafyeke matawi yake; yaondoeni majani yake na kuyatawanya matunda yake. Wanyama na wakimbie kutoka chini yake na ndege waondoke kutoka matawi yake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini acheni kisiki chake na mizizi, kikiwa kimefungwa kwa chuma na shaba, kibaki ardhini, kwenye majani ya kondeni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:15"
      },
      "items": [
        {
          "text": "\" 'Mwacheni aloweshwe na umande wa mbinguni, naye aachwe aishi pamoja na wanyama miongoni mwa mimea ya dunia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akili yake na ibadilishwe kutoka ile ya mwanadamu na apewe akili ya mnyama, mpaka nyakati saba zipite juu yake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Uamuzi huu umetangazwa na walinzi, hukumu imetangazwa na watakatifu, ili walio hai wajue kuwa Aliye Juu Sana ndiye anayetawala juu ya falme zote za wanadamu, naye humpa yeyote amtakaye na kumtawaza juu yake hata yeye aliye mnyonge sana miongoni mwa wanadamu.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hii ndiyo ndoto niliyoipata mimi, Mfalme Nebukadneza. Sasa Belteshaza, niambie maana yake, kwa maana hakuna hata mmoja wa wenye hekima katika ufalme wangu anayeweza kunifasiria. Bali wewe waweza, kwa sababu roho ya miungu mitakatifu imo ndani yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Danieli Anafasiri Ndoto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Danieli (aliyeitwa pia Belteshaza) alipofadhaika sana kwa muda, nayo mawazo yake yakamtia hofu. Basi mfalme akasema, \"Belteshaza, usiruhusu ndoto wala maana yake kukutia hofu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:19"
      },
      "items": [
        {
          "text": "Belteshaza akamjibu, \"Bwana wangu, laiti ndoto hii ingehusu adui zako, na maana yake iwahusu watesi wako!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mti uliouona, uliokua ukawa mkubwa na wenye nguvu, nayo ncha yake ikagusa anga na kuonekana duniani kote,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.20",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukiwa na majani ya kupendeza na matunda mengi, ukitoa chakula kwa wote, na ukiwapa hifadhi wanyama wa kondeni na kuwa mahali pa viota katika matawi yake kwa ajili ya ndege wa angani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.21",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee mfalme, wewe ndiwe ule mti! Umekuwa mkubwa na mwenye nguvu, nao ukuu wako umekua mpaka kufika juu angani, nayo mamlaka yako yameenea mpaka miisho ya dunia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.22",
            "verseOrgIds": [
              "DAN.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee mfalme, wewe ulimwona mlinzi, aliye mtakatifu, akishuka kutoka mbinguni na kusema, 'Ukateni mti na kuuangamiza, lakini kiacheni kisiki kikiwa kimefungwa kwa chuma na kwa shaba, kwenye majani ya kondeni, wakati mizizi yake inabaki ardhini. Mwacheni aloweshwe na umande wa mbinguni, mwacheni aishi kama wanyama pori mpaka nyakati saba zipite juu yake.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee mfalme, hii ndiyo tafsiri, na hii ni amri ya Aliye Juu Sana aliyoitoa dhidi ya bwana wangu mfalme:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe utafukuzwa mbali na wanadamu, nawe utaishi pamoja na wanyama pori; utakula manyasi kama ngʼombe, na kuloana kwa umande wa mbinguni. Nyakati saba zitapita juu yako, mpaka utakapokubali kuwa Yeye Aliye Juu Sana ndiye anayetawala juu ya falme za wanadamu, naye humtawaza yeyote amtakaye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amri ya kuacha kisiki pamoja na mizizi yake inamaanisha kwamba ufalme wako utarejezwa kwako utakapokubali kwamba Mbingu ndizo zitawalazo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, ee mfalme, uwe radhi kupokea shauri langu: Acha dhambi zako kwa kutenda yaliyo haki, ukaache uovu wako, na uwe na huruma kwa walioonewa. Hivyo itawezekana baada ya hayo, mafanikio yako yakaendelea.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndoto Inatimia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya yote yalimpata Mfalme Nebukadneza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miezi kumi na miwili baadaye, mfalme alipokuwa akitembea juu ya paa la jumba la kifalme la Babeli,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "alisema, \"Je, huu si Babeli mji mkuu nilioujenga kama makao ya kifalme, kwa uwezo wangu mkubwa, na kwa ajili ya utukufu wa enzi yangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneno hayo yalikuwa bado katika midomo yake wakati sauti ilipokuja kutoka mbinguni, ikisema, \"Mfalme Nebukadneza, hiki ndicho kilichoamriwa kwa ajili yako: Mamlaka yako ya ufalme yameondolewa kutoka kwako.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utafukuzwa mbali na wanadamu, ukaishi pamoja na wanyama pori, na utakula manyasi kama ngʼombe. Nyakati saba zitapita juu yako, mpaka utakapokubali kuwa Yeye Aliye Juu Sana ndiye anayetawala juu ya falme za wanadamu, naye humtawaza yeyote amtakaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papo hapo yale yaliyokuwa yamesemwa kuhusu Nebukadneza yakatimia. Alifukuzwa mbali na wanadamu, akala majani kama ngʼombe. Mwili wake uliloweshwa kwa umande wa mbinguni mpaka nywele zake zikakua kama manyoya ya tai na kucha zake kama makucha ya ndege.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisho wa huo wakati, mimi Nebukadneza, niliinua macho yangu kuelekea mbinguni, nazo fahamu zangu zikanirudia. Ndipo nikamsifu Yeye Aliye Juu Sana, nikamheshimu na kumhimidi yeye aishiye milele.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "Utawala wake ni utawala wa milele;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "ufalme wake hudumu kutoka kizazi na kizazi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataifa yote ya dunia",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "yanahesabiwa kuwa si kitu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Hufanya kama atakavyo",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "kwa majeshi ya mbinguni,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "na kwa mataifa ya dunia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Hakuna anayeweza kuuzuia mkono wake",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "au kumwambia, \"Umefanya nini wewe?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.35",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo huo fahamu zangu ziliponirudia, nikarudishiwa heshima yangu na fahari yangu kwa ajili ya utukufu wa ufalme wangu. Washauri wangu na wakuu wangu walikuja kunitafuta, nami nikarudishwa kwenye kiti changu cha ufalme hata nikawa mkuu kuliko mwanzoni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mimi, Nebukadneza, humhimidi, na humtukuza na kumsifu Mfalme wa mbinguni, kwa sababu kila kitu afanyacho ni haki, na njia zake zote ni adili. Nao waendao kwa kiburi anaweza kuwashusha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    }
  ],
