  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igeni mfano wangu, kama ninavyouiga mfano wa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Utaratibu Katika Kuabudu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninawasifu kwa kuwa mnanikumbuka katika kila jambo na kwa kushika mafundisho niliyowapa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napenda mfahamu kwamba kichwa cha kila mwanaume ni Kristo, na kichwa cha mwanamke ni mwanaume, nacho kichwa cha Kristo ni Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mwanaume anayeomba au kutoa unabii akiwa amefunika kichwa chake, anakiaibisha kichwa chake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kila mwanamke anayeomba au kutoa unabii pasipo kufunika kichwa chake, anakiaibisha kichwa chake, kwani ni sawa na yeye aliyenyoa nywele.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mwanamke hatajifunika kichwa chake, basi inampasa kunyoa nywele zake. Lakini kama ni aibu kwa mwanamke kukata au kunyoa nywele zake, basi afunike kichwa chake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haimpasi mwanaume kufunika kichwa chake kwa kuwa yeye ni mfano wa Mungu na utukufu wa Mungu, lakini mwanamke ni utukufu wa mwanaume.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana mwanaume hakutoka kwa mwanamke, bali mwanamke alitoka kwa mwanaume.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wala mwanaume hakuumbwa kwa ajili ya mwanamke, bali mwanamke kwa ajili ya mwanaume.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hii na kwa sababu ya malaika, inampasa mwanamke awe na ishara ya mamlaka juu yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini katika Bwana, mwanamke hajitegemei pasipo mwanaume na mwanaume hajitegemei pasipo mwanamke.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile mwanamke alivyoumbwa kutoka kwa mwanaume, vivyo hivyo mwanaume huzaliwa na mwanamke. Lakini vitu vyote vyatoka kwa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hukumuni ninyi wenyewe: Je, inafaa kwa mwanamke kumwomba Mungu bila kufunika kichwa chake?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, maumbile ya asili hayatufundishi kuwa ni aibu kwa mwanaume kuwa na nywele ndefu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mwanamke akiwa na nywele ndefu ni utukufu kwake? Kwa maana mwanamke amepewa nywele ndefu ili kumfunika.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtu anataka kubishana juu ya jambo hili, sisi wala makanisa ya Mungu hatutambui desturi nyingine.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matumizi Mabaya Ya Meza Ya Bwana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi katika maagizo yafuatayo, siwezi kuwasifu, kwa sababu mkutanikapo si kwa ajili ya faida bali kwa hasara.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwanza, mnapokutana kama kanisa, nasikia kwamba kuna mgawanyiko miongoni mwenu, nami kwa kiasi fulani nasadiki kuwa ndivyo ilivyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bila shaka lazima pawe na tofauti miongoni mwenu ili kuonyesha ni nani anayekubaliwa na Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkutanikapo pamoja si chakula cha Bwana mnachokula,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa mnapokula, kila mmoja wenu anakula bila kuwangoja wengine. Mmoja hukaa njaa na mwingine analewa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, hamna nyumbani kwenu ambako mnaweza kula na kunywa? Au mnalidharau kanisa la Mungu na kuwadhalilisha wale wasio na kitu? Niwaambie nini? Je, niwasifu juu ya jambo hili? La, hasha!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuanzishwa Kwa Meza Ya Bwana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.26.26-MAT.26.29"
          },
          "items": [
            {
              "text": "Mathayo 26:26-29",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.14.22-MRK.14.25"
          },
          "items": [
            {
              "text": "Marko 14:22-25",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.22.14-LUK.22.20"
          },
          "items": [
            {
              "text": "Luka 22:14-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana mimi nilipokea kutoka kwa Bwana yale niliyowapa ninyi, kwamba Bwana Yesu, usiku ule aliposalitiwa, alitwaa mkate,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akiisha kushukuru, akaumega, akasema,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Huu ndio mwili wangu, uliotolewa kwa ajili yenu. Fanyeni hivi kwa ukumbusho wangu.\"",
              "type": "text",
              "attrs": {
                "verseId": "1CO.11.24",
                "verseOrgIds": [
                  "1CO.11.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo baada ya kula, akakitwaa kikombe, akisema,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kikombe hiki ni agano jipya katika damu yangu. Fanyeni hivi kila mnywapo, kwa ukumbusho wangu.\"",
              "type": "text",
              "attrs": {
                "verseId": "1CO.11.25",
                "verseOrgIds": [
                  "1CO.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kila mlapo mkate huu na kunywea kikombe hiki, mnatangaza mauti ya Bwana mpaka ajapo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kushiriki Meza Ya Bwana Isivyostahili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, mtu yeyote alaye mkate huo au kukinywea kikombe hicho cha Bwana isivyostahili, atakuwa na hatia ya dhambi juu ya mwili na damu ya Bwana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.27",
            "verseOrgIds": [
              "1CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inampasa mtu ajichunguze mwenyewe, kabla ya kula mkate na kukinywea kikombe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana mtu yeyote alaye na kunywa pasipo kuutambua mwili wa Bwana, hula na kunywa hukumu juu yake mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
              "1CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hii ndiyo sababu wengi miongoni mwenu ni wagonjwa na dhaifu na wengine wenu hata wamekufa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama tungejichunguza wenyewe tusingehukumiwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
            "verseOrgIds": [
              "1CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunapohukumiwa na Bwana, tunaadibishwa ili tusije tukahukumiwa pamoja na ulimwengu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, ndugu zangu, mkutanikapo pamoja ili kula, mngojane.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
              "1CO.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtu akiwa na njaa, ale nyumbani kwake ili mkutanapo pamoja msije mkahukumiwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
            "verseOrgIds": [
              "1CO.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 11:34"
      },
      "items": [
        {
          "text": "Nami nitakapokuja nitawapa maelekezo zaidi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
            "verseOrgIds": [
              "1CO.11.34"
            ]
          }
        }
      ]
    }
  ],
