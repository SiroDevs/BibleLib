        "style": "s1"
      },
      "items": [
        {
          "text": "Mfalme Yehoahazi Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.23.30-2KI.23.35"
          },
          "items": [
            {
              "text": "2 Wafalme 23:30-35",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa nchi wakamchukua Yehoahazi mwana wa Yosia na kumfanya mfalme mahali pa baba yake huko Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahazi alikuwa na umri wa miaka ishirini na mitatu alipoanza kutawala, akatawala huko Yerusalemu kwa miezi mitatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Misri akamwondoa madarakani huko Yerusalemu na akatoza Yuda kodi ya talanta 100",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "text": "za fedha na talanta moja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "text": "ya dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Misri akamweka Eliakimu, nduguye Yehoahazi, kuwa mfalme juu ya Yuda na Yerusalemu na kubadili jina la Eliakimu kuwa Yehoyakimu. Lakini Neko akamchukua Yehoahazi, Nduguye Eliakimu akampeleka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakimu Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.23.35-2KI.24.7"
          },
          "items": [
            {
              "text": "2 Wafalme 23:35–24:7",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakimu alikuwa na umri wa miaka ishirini na mitano alipoanza kutawala, naye akatawala huko Yerusalemu miaka kumi na mmoja. Akafanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.5",
                "verseOrgIds": [
                  "2CH.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadneza mfalme wa Babeli akamshambulia na kumfunga kwa pingu za shaba akampeleka Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadneza akachukua pia vyombo kutoka Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.7",
                "verseOrgIds": [
                  "2CH.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": "na kuviweka katika hekalu lake",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "text": "huko Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Yehoyakimu, machukizo aliyoyafanya na yote yaliyoonekana dhidi yake, yameandikwa katika kitabu cha wafalme wa Israeli na Yuda. Naye Yehoyakini mwanawe akawa mfalme baada yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakini Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.24.8-2KI.24.17"
          },
          "items": [
            {
              "text": "2 Wafalme 24:8-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakini alikuwa na miaka kumi na minane alipoanza kutawala, naye akatawala huko Yerusalemu miezi mitatu na siku kumi. Akafanya yaliyo maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.9",
                "verseOrgIds": [
                  "2CH.36.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamo majira ya vuli, Mfalme Nebukadneza akatuma watu, nao wakamleta Babeli, pamoja na vyombo vya thamani kutoka Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.10",
                "verseOrgIds": [
                  "2CH.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Naye akamfanya Sedekia, ndugu yake Yehoyakimu kuwa mfalme wa Yuda na Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfalme Sedekia Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.24.18-2KI.24.20"
          },
          "items": [
            {
              "text": "2 Wafalme 24:18-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JER.52.1-JER.52.3"
          },
          "items": [
            {
              "text": "Yeremia 52:1-3",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekia alikuwa na umri wa miaka ishirini na mmoja alipoanza kutawala, naye akatawala huko Yerusalemu kwa miaka kumi na mmoja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alifanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wake, wala hakujinyenyekeza mbele ya nabii Yeremia, ambaye alinena neno la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia alimwasi Mfalme Nebukadneza, ambaye alikuwa amemwapisha kwa jina la Mungu. Akashupaza shingo na akafanya moyo wake kuwa mgumu wala hakutaka kumgeukia",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.13",
                "verseOrgIds": [
                  "2CH.36.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaidi ya hayo viongozi wote wa makuhani pamoja na watu wakazidi kukosa uaminifu zaidi na zaidi, wakafanya machukizo yote kama walivyofanya mataifa wakinajisi Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.14",
                "verseOrgIds": [
                  "2CH.36.14"
                ]
              }
            }
          ]
        },
        {
          "text": "alilokuwa amelitakasa huko Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuanguka Kwa Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.25.1-2KI.25.21"
          },
          "items": [
