              "text": "2 Wafalme 25:1-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JER.52.3-JER.52.11"
          },
          "items": [
            {
              "text": "Yeremia 52:3-11",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.15",
                "verseOrgIds": [
                  "2CH.36.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba zao, akawapelekea neno kupitia wajumbe wake tena na tena, kwa sababu alikuwa anawahurumia watu wake pamoja na mahali pa maskani yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini waliwadhihaki wajumbe wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.16",
                "verseOrgIds": [
                  "2CH.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "wakayadharau maneno yake na kuwacheka manabii wake mpaka ghadhabu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.16",
                "verseOrgIds": [
                  "2CH.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ikawa kubwa dhidi ya watu wake na hakukuwa na namna ya kuituliza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akamwinua dhidi yao mfalme wa Wakaldayo, aliyewaua vijana wao wa kiume kwa upanga ndani ya mahali patakatifu, ambaye hakumbakiza kijana mwanaume wala kijana mwanamke, wazee wala vikongwe. Mungu akawatia wote mikononi mwa Nebukadneza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavichukua kwenda Babeli vyombo vyote kutoka Hekalu la Mungu, vikubwa na vidogo, hazina za Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.18",
                "verseOrgIds": [
                  "2CH.36.18"
                ]
              }
            }
          ]
        },
        {
          "text": "pamoja na hazina za mfalme na za maafisa wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalichoma Hekalu la Mungu na kuzibomoa kuta za Yerusalemu, wakachoma moto majumba yote ya kifalme na kuharibu kila kitu chake cha thamani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale watu walionusurika kuuawa kwa upanga wakachukuliwa kwenda uhamishoni Babeli. Nao wakawa watumishi wake na wa wanawe mpaka wakati wa utawala wa ufalme wa Uajemi ulifika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchi ikaendelea kufurahia pumziko lake la Sabato, wakati wote wa kufanywa kwake ukiwa ilipumzika mpaka ile miaka sabini ilipotimia katika kutimiza neno la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.21",
                "verseOrgIds": [
                  "2CH.36.21"
                ]
              }
            }
          ]
        },
        {
          "text": "lililonenwa na Yeremia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
