  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2CH 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa baada ya jambo hili, Wamoabu na Waamoni, pamoja na baadhi ya Wameuni wakaja ili wapigane vita na Yehoshafati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu fulani wakaja wakamwambia Yehoshafati, \"Jeshi kubwa linakuja dhidi yako kutoka Edomu tokea ngʼambo ile nyingine ya Bahari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "text": "Tayari liko Hasason-Tamari\" (yaani En-Gedi).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati akaogopa, akaazimu kumtafuta",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.3",
                "verseOrgIds": [
                  "2CH.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", na akatangaza kwa Yuda wote kufunga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Yuda wakakusanyika pamoja ili kutafuta msaada kutoka kwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.4",
                "verseOrgIds": [
                  "2CH.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wakaja kutoka kila mji wa Yuda ili kumtafuta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yehoshafati akasimama katika kusanyiko la Yuda na Yerusalemu katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.5",
                "verseOrgIds": [
                  "2CH.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", mbele ya ua mpya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akasema:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 20:6"
      },
      "items": [
        {
          "text": "\"Ee",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.6",
                "verseOrgIds": [
                  "2CH.20.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba zetu, si wewe ndiwe uliye Mungu mbinguni? Si wewe ndiwe utawalaye juu ya falme zote za mataifa? Uweza na nguvu viko mkononi mwako, wala hakuna yeyote awezaye kushindana nawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, si wewe, Ee Mungu wetu, uliyewafukuza wenyeji wa nchi hii mbele ya watu wako Israeli, ukawapa wazao wa Abrahamu, rafiki yako, hata milele?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.7",
            "verseOrgIds": [
              "2CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wameishi ndani yake na humo wamekujengea mahali patakatifu kwa ajili ya Jina lako, wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.8",
            "verseOrgIds": [
              "2CH.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kama maafa yakitujia, ikiwa ni upanga, hukumu, tauni, au njaa, tutasimama mbele zako, mbele ya Hekalu hili ambalo limeitwa kwa Jina lako na kukulilia katika shida yetu, nawe utatusikia na kutuokoa.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.9",
            "verseOrgIds": [
              "2CH.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini sasa hawa watu wa kutoka Amoni, Moabu na Mlima Seiri, ambao hukuwaruhusu Israeli wazivamie nchi zao wakati walitoka Misri, hivyo wakageukia mbali nao na hawakuwaangamiza,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.10",
            "verseOrgIds": [
              "2CH.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "tazama jinsi wanavyotulipa kwa kuja kututupa nje ya milki uliyotupa sisi kuwa urithi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.11",
            "verseOrgIds": [
              "2CH.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Mungu wetu, je, wewe hutawahukumu? Kwa kuwa sisi hatuna uwezo wa kukabiliana na jeshi hili kubwa linalokuja kutushambulia. Sisi hatujui la kufanya, bali macho yetu yanakutazama wewe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wote wa Yuda pamoja na wake zao, watoto wao na wadogo wao wakasimama pale mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.13",
                "verseOrgIds": [
                  "2CH.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Roho wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.14",
                "verseOrgIds": [
                  "2CH.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "akaja juu ya mtu mmoja jina lake Yahazieli mwana wa Zekaria, mwana wa Benaya, Mwana wa Yeieli, mwana wa Matania, Mlawi mzao wa Asafu alipokuwa amesimama katika kusanyiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema: \"Sikilizeni, enyi Yuda wote nanyi nyote mkaao Yerusalemu, nawe Mfalme Yehoshafati! Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.15",
                "verseOrgIds": [
                  "2CH.20.15"
                ]
              }
            }
          ]
        },
        {
          "text": "asemalo kwenu, 'Msiogope wala msifadhaike kwa sababu ya jeshi hili kubwa. Kwa maana vita hivi si vyenu, bali ni vya Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesho shukeni kukabiliana nao. Watakwea kwa kupandia Genge la Sisi, nanyi mtawakuta mwisho wa bonde, kabla ya Jangwa la Yerueli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.16",
            "verseOrgIds": [
              "2CH.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamtahitaji kupigana vita hivi. Kaeni kwenye nafasi zenu, simameni imara na mkaone wokovu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.17",
                "verseOrgIds": [
                  "2CH.20.17"
                ]
              }
            }
          ]
        },
        {
          "text": "atakaowapatia, enyi Yuda na Yerusalemu. Msiogope, wala msifadhaike. Kesho tokeni mwende mkawakabili, naye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.17",
                "verseOrgIds": [
                  "2CH.20.17"
                ]
              }
            }
          ]
        },
        {
          "text": "atakuwa pamoja nanyi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati akainamisha uso wake chini, nao watu wote wa Yuda na Yerusalemu wakaanguka chini ili kuabudu mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.18",
                "verseOrgIds": [
                  "2CH.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo baadhi ya Walawi kutoka kwa Wakohathi na kwa wana wa Kora wakasimama na kumsifu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.19",
                "verseOrgIds": [
                  "2CH.20.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, kwa sauti kuu sana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubuhi na mapema wakaondoka kuelekea Jangwa la Tekoa. Walipoanza safari, Yehoshafati akasimama akasema, \"Nisikilizeni, enyi Yuda, na watu wa Yerusalemu! Mwaminini",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.20",
                "verseOrgIds": [
                  "2CH.20.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, hivyo mtathibitika, wasadikini manabii wake nanyi mtafanikiwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipomaliza kushauriana na watu, Yehoshafati akawaweka watu wa kumwimbia",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.21",
                "verseOrgIds": [
                  "2CH.20.21"
                ]
              }
            }
          ]
        },
        {
          "text": "na kumsifu katika utukufu wa utakatifu wake walipokuwa wametangulia mbele ya jeshi, wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 20:21"
      },
      "items": [
        {
          "text": "\"Mshukuruni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.21",
                "verseOrgIds": [
                  "2CH.20.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 20:21"
      },
      "items": [
        {
          "text": "kwa kuwa upendo wake wadumu milele.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipoanza kuimba na kusifu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.22",
                "verseOrgIds": [
                  "2CH.20.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akaweka waviziao dhidi ya watu wa Amoni, Moabu na wale wa Mlima Seiri waliokuwa wamekuja kuishambulia Yuda, nao wakashindwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Amoni na Moabu wakawainukia watu wa Mlima Seiri ili kuwaua na kuwaangamiza kabisa. Baada ya kumaliza kuwachinja watu wa Seiri, wakaangamizana wao kwa wao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.23",
            "verseOrgIds": [
              "2CH.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda walipofika katika mnara wa ulinzi wa jangwani, wakaliangalia lile jeshi kubwa, wakaona ni maiti tupu zimetapakaa ardhini, wala hakuna yeyote aliyenusurika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.24",
            "verseOrgIds": [
              "2CH.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yehoshafati na watu wake wakaenda kujitwalia nyara kutoka kwao, nao wakakuta humo wingi wa mifugo, mali, nguo na vitu vya thamani, ambavyo vilikuwa vingi zaidi ya vile walivyoweza kuchukua. Wakakusanya nyara kwa siku tatu kwa sababu zilikuwa nyingi mno.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.25",
            "verseOrgIds": [
              "2CH.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya nne wakakusanyika katika Bonde la Beraka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "text": "kwa maana huko ndiko walikomsifu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.26",
                "verseOrgIds": [
                  "2CH.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ndiyo sababu linaitwa Bonde la Beraka mpaka leo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wote wa Yuda na Yerusalemu, wakiongozwa na Yehoshafati, wakarudi Yerusalemu wakiwa na furaha kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.27",
                "verseOrgIds": [
                  "2CH.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "alikuwa amewasababisha wafurahi juu ya adui zao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaingia Yerusalemu na kwenda hekaluni mwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.28",
                "verseOrgIds": [
                  "2CH.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": "wakiwa na vinubi, zeze na tarumbeta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hofu ya Mungu ikazipata falme zote za nchi waliposikia jinsi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.29",
                "verseOrgIds": [
                  "2CH.20.29"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyokuwa amepigana dhidi ya adui za Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufalme wa Yehoshafati ukawa na amani, kwa kuwa Mungu wake alikuwa amemstarehesha pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwisho Wa Utawala Wa Yehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.22.41-1KI.22.50"
          },
          "items": [
            {
              "text": "1 Wafalme 22:41-50",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yehoshafati akatawala Yuda. Alikuwa na umri wa miaka thelathini na mitano alipoanza kutawala, akatawala katika Yerusalemu kwa miaka ishirini na mitano. Mama yake aliitwa Azuba binti Shilhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alienenda katika njia za Asa baba yake wala hakwenda kinyume chake. Alifanya yaliyo mema machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.32",
                "verseOrgIds": [
                  "2CH.20.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo mahali pa juu pa kuabudia hapakuondolewa, na watu wakawa bado hawajaelekeza mioyo yao kwa Mungu wa baba zao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Yehoshafati, kuanzia mwanzo hadi mwisho, yameandikwa katika kitabu cha kumbukumbu cha Yehu mwana wa Hanani, ambazo zimeandikwa katika kitabu cha wafalme wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatimaye Yehoshafati mfalme wa Yuda akafanya urafiki na Ahazia mfalme wa Israeli ambaye alifanya maovu sana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.35",
            "verseOrgIds": [
              "2CH.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaungana naye kutengeneza meli nyingi za kwenda Tarshishi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "text": "nazo zilitengenezwa huko Esion-Geberi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Eliezeri mwana wa Dodavahu wa Maresha akatoa unabii dhidi ya Yehoshafati, akasema, \"Kwa kuwa umeungana na Ahazia,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.37",
                "verseOrgIds": [
                  "2CH.20.37"
                ]
              }
            }
          ]
        },
        {
          "text": "ataangamiza vile mlivyotengeneza.\" Zile meli zikavunjika na hazikuweza kungʼoa nanga ili kwenda Tarshishi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        }
      ]
    }
  ],
