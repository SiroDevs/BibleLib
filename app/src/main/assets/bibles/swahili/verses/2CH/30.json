                  "2CH.30.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akamsikia Hezekia akawaponya watu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
