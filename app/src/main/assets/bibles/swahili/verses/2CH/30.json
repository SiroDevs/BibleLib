          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        },
