        "style": "s1"
      },
      "items": [
        {
          "text": "Hekalu Lawekwa Wakfu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
