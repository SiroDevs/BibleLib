    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Solomoni kumaliza kuomba, moto ukashuka kutoka mbinguni na kuteketeza sadaka ya kuteketezwa na dhabihu, nao utukufu wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.1",
                "verseOrgIds": [
                  "2CH.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ukalijaza Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuhani hawakuweza kuingia ndani ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.2",
                "verseOrgIds": [
                  "2CH.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa sababu utukufu wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.2",
                "verseOrgIds": [
                  "2CH.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ulilijaza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli wote walipoona moto ukishuka na utukufu wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ukiwa juu ya Hekalu, wakapiga magoti sakafuni wakasujudu nyuso zao mpaka chini, nao wakamwabudu na kumshukuru",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wakisema,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "\"Yeye ni mwema;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "upendo wake unadumu milele.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfalme na watu wote wakatoa dhabihu mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.4",
                "verseOrgIds": [
                  "2CH.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mfalme Solomoni akatoa dhabihu ya ngʼombe 22,000 pamoja na kondoo na mbuzi 120,000. Hivyo ndivyo mfalme na watu wote walivyoweka wakfu Hekalu la Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuhani wakasimama kwenye nafasi zao, vivyo hivyo Walawi wakiwa na vyombo vya uimbaji vya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.6",
                "verseOrgIds": [
                  "2CH.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ambavyo Mfalme Daudi alikuwa ametengeneza kwa ajili ya kumsifu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.6",
                "verseOrgIds": [
                  "2CH.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", navyo vilitumika wakati aliposhukuru, akisema, \"Upendo wake wadumu milele.\" Mkabala na Walawi, makuhani walipiga tarumbeta zao, nao Waisraeli wote walikuwa wamesimama.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni akaweka wakfu sehemu ya katikati ya ua uliokuwa mbele ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.7",
                "verseOrgIds": [
                  "2CH.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "na hapo akatoa sadaka za kuteketezwa na mafuta ya sadaka za amani, kwa sababu madhabahu ya shaba aliyokuwa ametengeneza haikutosha kuweka sadaka hizo zote za kuteketezwa, sadaka za nafaka na za mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Solomoni akaiadhimisha sikukuu wakati ule kwa muda wa siku saba, na Israeli wote pamoja naye. Walikuwa kusanyiko kubwa sana, watu kutoka Lebo-Hamathi hadi Kijito cha Misri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ya nane walifanya kusanyiko, kwa kuwa walikuwa wanaadhimisha kuwekwa wakfu kwa madhabahu kwa muda wa siku saba na sikukuu kwa muda wa siku nyingine saba zaidi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ya ishirini na tatu ya mwezi wa saba Solomoni akawaaga watu waende nyumbani mwao, wakishangilia na kufurahi mioyoni mwao, kwa wema mwingi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.10",
                "verseOrgIds": [
                  "2CH.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu aliomtendea Daudi na Solomoni na kwa ajili ya watu wake Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu Amtokea Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.9.1-1KI.9.9"
          },
          "items": [
            {
              "text": "1 Wafalme 9:1-9",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni alipomaliza kujenga Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na jumba la kifalme, naye akiwa amefanikiwa kutenda yale yote aliyokuwa nayo moyoni mwake kufanya katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na katika jumba lake mwenyewe la kifalme,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.12",
                "verseOrgIds": [
                  "2CH.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akamtokea Solomoni usiku na kumwambia:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 7:12"
      },
      "items": [
        {
          "text": "\"Nimesikia maombi yako nami nimechagua mahali hapa kwa ajili yangu mwenyewe kuwa Hekalu kwa ajili ya dhabihu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wakati nitakapofunga mbingu ili isiwepo mvua, au nikiamuru nzige kula mazao ya nchi au nikituma tauni miongoni mwa watu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama watu wangu, wanaoitwa kwa Jina langu, watajinyenyekesha na kuomba na kuutafuta uso wangu na kuacha njia zao mbaya, basi nitasikia toka mbinguni na kuwasamehe dhambi yao na nitaiponya nchi yao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa macho yangu yatafumbuka na masikio yangu yatasikiliza kwa makini maombi yaombwayo mahali hapa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana sasa nimechagua na kutakasa Hekalu hili ili kwamba Jina langu lipate kuwa huko milele. Macho yangu na moyo wangu utakuwepo huko daima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa habari yako wewe, kama ukienenda mbele zangu kama Daudi baba yako alivyoenenda na kufanya yote nikuamuruyo, nawe ukizishika amri zangu na sheria zangu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakiimarisha kiti chako cha enzi kama nilivyoagana na Daudi baba yako niliposema, 'Hutakosa kamwe mtu wa kutawala juu ya Israeli.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini kama ukigeuka na kuyaacha maagizo na amri nilizowapa na kwenda kuitumikia miungu mingine na kuiabudu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo nitakapoingʼoa Israeli kutoka nchi yangu niliyowapa, nami nitalikataa Hekalu hili nililolitakasa kwa ajili ya Jina langu. Nitalifanya kitu cha kudharauliwa na kitu cha kudhihakiwa miongoni mwa watu wote.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa Hekalu hili linavutia sana sasa, wote watakaolipita watashangaa na kusema, 'Kwa nini",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.21",
                "verseOrgIds": [
                  "2CH.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "amefanya kitu kama hiki katika nchi hii na kwa Hekalu hili?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu watajibu, 'Ni kwa sababu wamemwacha",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.22",
                "verseOrgIds": [
                  "2CH.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba zao, aliyewatoa Misri, nao wamekumbatia miungu mingine, wakaiabudu na kuitumikia, ndiyo sababu ameyaleta maafa haya yote juu yao.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        }
      ]
    }
  ],
