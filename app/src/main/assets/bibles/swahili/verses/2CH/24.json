          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingawa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        },
        {
