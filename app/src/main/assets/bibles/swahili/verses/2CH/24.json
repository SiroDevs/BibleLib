                "verseId": "2CH.24.19",
                "verseOrgIds": [
                  "2CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "aliwatuma manabii wawarudishe watu kwake na ingawa waliwaonya, hawakuwasikiliza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
