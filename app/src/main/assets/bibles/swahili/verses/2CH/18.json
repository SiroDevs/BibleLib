            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.18",
                "verseOrgIds": [
                  "2CH.18.18"
                ]
              }
            }
          ]
        },
        {
          "text": ": Nilimwona",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.18",
                "verseOrgIds": [
                  "2CH.18.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ameketi juu ya kiti chake cha enzi pamoja na jeshi lote la mbinguni likiwa limesimama upande wa kulia na wa kushoto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.19",
                "verseOrgIds": [
                  "2CH.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema, 'Ni nani atakayemshawishi Ahabu, mfalme wa Israeli, ili aishambulie Ramoth-Gileadi na kukiendea kifo chake huko?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:19"
      },
      "items": [
        {
          "text": "\"Mmoja akapendekeza hili na mwingine lile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwishoni, roho akajitokeza, akasimama mbele za",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.20",
                "verseOrgIds": [
                  "2CH.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "na kusema, 'Nitamshawishi.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:20"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.20",
                "verseOrgIds": [
                  "2CH.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akauliza, 'Kwa njia gani?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akasema, 'Nitakwenda na kuwa roho ya uongo katika vinywa vya manabii wake wote.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:21"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.21",
                "verseOrgIds": [
                  "2CH.18.21"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema, 'Utafanikiwa katika kumshawishi. Nenda ukafanye hivyo.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa hiyo sasa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.22",
                "verseOrgIds": [
                  "2CH.18.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ameweka roho ya kudanganya ndani ya vinywa vya hawa manabii wako wote.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.22",
                "verseOrgIds": [
                  "2CH.18.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ameamuru maafa kwa ajili yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Sedekia mwana wa Kenaana akatoka na kumpiga Mikaya kofi usoni. Akauliza, \"Huyo Roho kutoka kwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.23",
                "verseOrgIds": [
                  "2CH.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "alipita njia gani alipotoka kwangu ili kusema nawe?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akajibu, \"Utagundua siku hiyo utakapokwenda kujificha kwenye chumba cha ndani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mfalme wa Israeli akaagiza, \"Mchukueni na mkamrudishe kwa Amoni mtawala wa mji na kwa Yoashi mwana wa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkaseme, 'Hivi ndivyo asemavyo mfalme: Mwekeni mtu huyu gerezani na asipewe chochote ila mkate na maji mpaka nitakaporudi salama.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.26",
            "verseOrgIds": [
              "2CH.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akasema, \"Kama utarudi salama, basi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.27",
                "verseOrgIds": [
                  "2CH.18.27"
                ]
              }
            }
          ]
        },
        {
          "text": "hajanena kupitia kwangu.\" Kisha akaongeza kusema, \"Zingatieni maneno yangu, enyi watu wote!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahabu Anauawa Huko Ramoth-Gileadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.22.29-1KI.22.35"
          },
          "items": [
            {
              "text": "1 Wafalme 22:29-35",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mfalme wa Israeli na Yehoshafati mfalme wa Yuda wakaenda Ramoth-Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Israeli akamwambia Yehoshafati, \"Nitaingia vitani nikiwa nimejibadilisha, lakini wewe uvae majoho yako ya kifalme.\" Kwa hiyo mfalme wa Israeli akajibadilisha na kwenda vitani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huu, mfalme wa Aramu alikuwa amewaagiza majemadari thelathini na wawili wa magari ya vita, \"Msipigane na yeyote, mdogo au mkubwa, isipokuwa mfalme wa Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wale majemadari wa magari ya vita walipomwona Yehoshafati, wakafikiri, \"Hakika huyu ndiye mfalme wa Israeli.\" Kwa hiyo wakageuka ili wamshambulie, lakini Yehoshafati akapiga kelele, naye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.31",
                "verseOrgIds": [
                  "2CH.18.31"
                ]
              }
            }
          ]
        },
        {
          "text": "akamsaidia. Mungu akawaondoa kwake,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "wale majemadari wakaona kwamba hakuwa mfalme wa Israeli nao wakaacha kumfuatilia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtu fulani akavuta upinde pasipo lengo na kumpiga mfalme wa Israeli katikati ya kiungio cha mavazi yake ya chuma, mfalme akamwambia mwendesha gari lake, \"Geuza gari na uniondoe mimi katika mapigano, nimejeruhiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vita vikaendelea mchana kutwa, naye mfalme wa Israeli akajitegemeza ndani ya gari lake kuwaelekea Waaramu hadi jioni. Basi jioni yake akafa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
      ]
    }
  ],
