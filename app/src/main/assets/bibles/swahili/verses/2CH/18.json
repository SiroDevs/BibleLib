          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akaendelea, \"Kwa hiyo lisikie neno la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
