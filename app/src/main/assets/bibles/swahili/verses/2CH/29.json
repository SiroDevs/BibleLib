        {
          "text": "Wanyama waliowekwa wakfu kwa sadaka ya kuteketezwa walikuwa mafahali 600, pamoja na kondoo na mbuzi 3,000.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
