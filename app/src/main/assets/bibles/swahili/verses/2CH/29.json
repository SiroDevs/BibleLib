    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia Mfalme Wa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.18.1-2KI.18.12"
          },
          "items": [
            {
              "text": "2 Wafalme 18:1-12",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia alikuwa na umri wa miaka ishirini na mitano alipoanza kutawala, naye akatawala huko Yerusalemu kwa miaka ishirini na tisa. Mama yake aliitwa Abiya binti Zekaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.1",
            "verseOrgIds": [
              "2CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya yaliyo mema machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.2",
                "verseOrgIds": [
                  "2CH.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kama Daudi baba yake alivyofanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwezi wa kwanza wa mwaka wa kwanza wa utawala wa alifungua milango ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.3",
                "verseOrgIds": [
                  "2CH.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", na kuikarabati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaingiza makuhani na Walawi ndani na kuwakutanisha katika uwanja upande wa mashariki",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.4",
            "verseOrgIds": [
              "2CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kusema: \"Nisikilizeni mimi, enyi Walawi! Jitakaseni nafsi zenu sasa, mkaitakase na nyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.5",
                "verseOrgIds": [
                  "2CH.29.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba zenu. Ondoeni uchafu wote kutoka mahali patakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba zetu hawakuwa waaminifu, walifanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.6",
                "verseOrgIds": [
                  "2CH.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu na wakamwacha yeye. Wakageuza nyuso zao mbali na Maskani ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.6",
                "verseOrgIds": [
                  "2CH.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wakamgeuzia visogo vyao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia walifunga milango ya ukumbi wa Hekalu na kuzima taa zake. Hawakufukiza uvumba wala kutoa sadaka yoyote ya kuteketezwa katika mahali patakatifu kwa Mungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, hasira ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.8",
                "verseOrgIds": [
                  "2CH.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ikashuka juu ya Yuda na Yerusalemu, naye akawa amewafanya kitu cha kutisha, cha kushangaza na kitu cha kufanyia mzaha kama mnavyoona kwa macho yenu wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hii ndiyo sababu baba zetu wameanguka kwa upanga na ndiyo sababu wana wetu na binti zetu, pia wake zetu wamekuwa mateka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa ninadhamiria moyoni mwangu kuweka Agano na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.10",
                "verseOrgIds": [
                  "2CH.29.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, ili hasira yake kali igeuziwe mbali nasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanangu, basi msipuuze jambo hili sasa, kwa kuwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.11",
                "verseOrgIds": [
                  "2CH.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": "amewachagua ninyi msimame mbele zake na kumtumikia, mkawe watumishi wake na mkamfukizie uvumba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Walawi wafuatao wakaanza kazi:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Kutoka kwa Wakohathi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Mahathi mwana wa Amasai na Yoeli mwana wa Azaria;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "kutoka kwa Wamerari,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Kishi mwana wa Abdi na Azaria mwana wa Yahaleleli;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "kutoka kwa Wagershoni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Yoa mwana wa Zima na Edeni mwana wa Yoa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoka kwa wana wa Elisafani,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "Shimri na Yeieli;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "kutoka kwa wana wa Asafu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "Zekaria na Matania;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutoka kwa wana wa Hemani,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:14"
      },
      "items": [
        {
          "text": "Yehieli na Shimei;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:14"
      },
      "items": [
        {
          "text": "kutoka kwa wana wa Yeduthuni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:14"
      },
      "items": [
        {
          "text": "Shemaya na Uzieli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipomaliza kuwakusanya ndugu zao na kujiweka wakfu, wakaingia ndani ili kutakasa Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.15",
                "verseOrgIds": [
                  "2CH.29.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", kama vile mfalme alivyokuwa ameagiza, kwa kufuata neno la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
