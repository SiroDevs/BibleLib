            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walianza kazi ya utakaso siku ya kwanza ya mwezi wa kwanza na kufikia siku ya nane ya mwezi huo wakawa wamefikia kwenye ukumbi wa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.17",
                "verseOrgIds": [
                  "2CH.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": ". Kwa siku zingine nane wakalitakasa Hekalu lenyewe la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.17",
                "verseOrgIds": [
                  "2CH.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": "wakakamilisha katika siku ya kumi na sita ya mwezi huo wa kwanza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        }
      ]
