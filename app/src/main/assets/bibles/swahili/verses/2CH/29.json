          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na sadaka nyingi za kuteketezwa, pamoja na mafuta ya wanyama ya sadaka za amani na sadaka za kinywaji ambazo ziliambatana na sadaka za kuteketezwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
