          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.16",
                "verseOrgIds": [
                  "2CH.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ili kupatakasa. Wakatoa nje penye ua wa Hekalu la Mungu kila kitu kichafu walichokikuta kwenye Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.16",
                "verseOrgIds": [
                  "2CH.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": ". Walawi wakavichukua na kuvipeleka nje katika Bonde la Kidroni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
