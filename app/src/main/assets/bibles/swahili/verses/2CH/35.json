    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mfalme Yosia Anaadhimisha Pasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.23.21-2KI.23.23"
          },
          "items": [
            {
              "text": "2 Wafalme 23:21-23",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia akaadhimisha Pasaka kwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.1",
                "verseOrgIds": [
                  "2CH.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "katika Yerusalemu, mwana-kondoo wa Pasaka akachinjwa siku ya kumi na nne ya mwezi wa kwanza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaweka makuhani kwenye wajibu wao na kuwatia moyo katika utumishi wa Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.2",
                "verseOrgIds": [
                  "2CH.35.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia Walawi, waliowafundisha Waisraeli wote na waliokuwa wamejiweka wakfu kwa ajili ya kazi ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.3",
                "verseOrgIds": [
                  "2CH.35.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Liwekeni hilo Sanduku takatifu katika Hekalu lile alilojenga Solomoni mwana wa Daudi mfalme wa Israeli. Halipaswi kubebwa huku na huko mabegani mwenu. Sasa mtumikieni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.3",
                "verseOrgIds": [
                  "2CH.35.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu na watu wake Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiandaeni kwa kufuata jamaa zenu katika migawanyo yenu, kufuatana na maelezo yaliyoandikwa na Daudi mfalme wa Israeli na mwanawe Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simameni mahali patakatifu kwa kufuata migawanyo ya jamaa za baba zenu kulingana na koo zenu na pawepo Walawi kwa ajili ya kila mgawanyo wa nyumba ya baba zenu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinjeni mwana-kondoo wa Pasaka, jitakaseni, nanyi kwa niaba ya koo zenu fanyeni maandalizi, mkitenda sawasawa na neno la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.6",
                "verseOrgIds": [
                  "2CH.35.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa mkono wa Mose.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yosia akawapa watu wote wana-mbuzi waliokuwepo jumla ya kondoo wapatao 30,000 kwa ajili ya sadaka ya Pasaka, pia na ngʼombe 10,000, vyote hivi kutoka mali binafsi ya mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pia maafisa wake, wakatoa kwa hiari yao wakawapa watu, makuhani na Walawi. Hilkia, Zekaria na Yehieli, waliokuwa maafisa wakuu wa Hekalu la Mungu, wakawapa makuhani sadaka za Pasaka wana-kondoo na wana-mbuzi 2,600 na mafahali 300.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konania na nduguze wawili, Shemaya na Nethaneli, pamoja na Hashabia, Yeieli na Yozabadi waliokuwa viongozi wa Walawi, nao pia wakawapa Walawi wana-kondoo na wana-mbuzi 5,000 na mafahali 500, kwa ajili ya sadaka za Pasaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huduma ilipomalizika kuandaliwa makuhani wakasimama mahali pao na Walawi katika migawanyo yao kama mfalme alivyokuwa ameamuru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana-kondoo wa Pasaka wakachinjwa, nao makuhani wakanyunyiza ile damu waliyokabidhiwa, wakati Walawi wakiwa wanawachuna wale wanyama ngozi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatenga sadaka za kuteketezwa ili waweze kugawia ili migawanyo kwa kufuata jamaa za baba zao ili watoe sadaka kwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.12",
                "verseOrgIds": [
                  "2CH.35.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kama ilivyoandikwa katika Kitabu cha Mose. Wakafanya vivyo hivyo kwa wale mafahali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawaoka wale wanyama wa Pasaka kwenye moto kama ilivyoamriwa, wakachemsha zile sadaka takatifu kwenye vyungu, masufuria makubwa na vikaango na kuwagawia watu wote upesi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatimaye wakafanya maandalizi kwa ajili yao wenyewe na kwa ajili ya makuhani, kwa sababu wale makuhani, yaani, wazao wa Aroni, walikuwa wanatoa sadaka za kuteketezwa pamoja na zile sehemu zilizonona mpaka usiku. Hivyo Walawi wakafanya maandalizi kwa ajili yao wenyewe na kwa ajili ya makuhani wa uzao wa Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waimbaji, wazao wa Asafu, walikuwa katika nafasi zao, kama ilivyoagizwa na Mfalme Daudi, Asafu, Hemani na Yeduthuni mwonaji wa Mfalme. Mabawabu katika kila lango hawakuhitaji kuacha nafasi zao kwa sababu Walawi wenzao walifanya maandalizi kwa ajili yao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakati ule huduma yote ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.16",
                "verseOrgIds": [
                  "2CH.35.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ilifanyika katika kuadhimisha Pasaka, kutoa sadaka za kuteketezwa juu ya madhabahu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.16",
                "verseOrgIds": [
                  "2CH.35.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kama alivyoamuru Mfalme Yosia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waisraeli waliokuwepo wakaadhimisha Pasaka wakati huo na Sikukuu ya Mikate Isiyotiwa Chachu kwa siku saba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa hakujafanyika Pasaka kama hii katika Israeli tangu siku za nabii Samweli wala hakukuwa na mfalme yeyote wa Israeli ambaye kamwe alishaadhimisha Pasaka kama ile aliyofanya Mfalme Yosia, akiwa na makuhani, Walawi na watu wote wa Yuda na watu wa Israeli waliokuwepo huko, pamoja na watu wa Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasaka iliadhimishwa katika mwaka wa kumi na nane wa utawala wa Mfalme Yosia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kifo Cha Yosia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.23.28-2KI.23.30"
          },
          "items": [
            {
              "text": "2 Wafalme 23:28-30",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya haya yote, Yosia alipomaliza kulitengeneza vizuri Hekalu, Neko mfalme wa Misri, akapanda ili kupigana huko Karkemishi katika Mto Frati, naye Yosia akatoka kwenda kupigana naye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Neko akamtumia wajumbe kusema, \"Kuna ugomvi gani kati yangu mimi na wewe, Ee Mfalme wa Yuda? Si wewe ninayekushambulia wakati huu, bali ile nyumba ambayo nina vita nayo, Mungu ameniambia niharakishe, kwa hivyo acha kumpinga Mungu, ambaye yuko pamoja nami, la sivyo atakuangamiza.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hata hivyo, Yosia hakukubali kumwacha, bali alijibadilisha ili kupigana naye vita. Hakusikiliza yale Neko aliyokuwa amemwambia kwa agizo la Mungu bali alikwenda kupigana naye katika tambarare ya Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapiga upinde wakampiga Mfalme Yosia, naye akawaambia maafisa wake, \"Niondoeni, nimejeruhiwa vibaya sana.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo wakamshusha kutoka kwenye gari lake la farasi, wakamweka kwenye gari lingine alilokuwa nalo na kumleta Yerusalemu, ambako alifia. Akazikwa katika makaburi ya baba zake, nayo Yuda yote na Yerusalemu wakamwombolezea Yosia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabii Yeremia akatunga maombolezo kwa ajili ya kifo chake, nao waimbaji wote, wanaume kwa wanawake, hufanya ukumbusho wa Yosia katika maombolezo hadi leo. Haya yakafanywa desturi katika Israeli, nayo yameandikwa katika Maombolezo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukio mengine ya utawala wa Yosia na matendo yake mema, kulingana na yale yaliyoandikwa katika sheria ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.26",
                "verseOrgIds": [
                  "2CH.35.26"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "matukio yote, kuanzia mwanzo hadi mwisho, yameandikwa katika kitabu cha wafalme wa Israeli na Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
            "verseOrgIds": [
              "2CH.35.27"
