                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "wala hawajatenda kulingana na yale yote yaliyoandikwa katika Kitabu hiki.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
