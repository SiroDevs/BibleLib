        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia Afanya Matengenezo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.22.1-2KI.22.2"
          },
          "items": [
            {
              "text": "2 Wafalme 22:1-2",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia alikuwa na miaka minane alipoanza kutawala, naye akatawala huko Yerusalemu miaka thelathini na mmoja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya yaliyo mema machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.2",
                "verseOrgIds": [
                  "2CH.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na kuenenda katika njia za Daudi baba yake, hakugeuka upande wa kuume wala wa kushoto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa nane wa utawala wake, alipokuwa angali bado mdogo, alianza kumtafuta Mungu wa Daudi baba yake. Katika mwaka wake wa kumi na mbili alianza kusafisha mahali pa juu pa kuabudia miungu pa Yuda na Yerusalemu, akiondoa nguzo za Ashera, sanamu za kuchonga na vinyago vya kusubu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbele ya macho yake, wakazibomoa madhabahu za Mabaali, wakazivunja madhabahu za kufukizia uvumba zilizokuwa zimesimama juu yake, wakazivunja nguzo za Ashera, sanamu na vinyago. Hivi alivivunja vipande vipande na kuvisambaza juu ya makaburi ya waliokuwa wamevitolea kafara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachoma mifupa ya makuhani wao juu ya madhabahu zao na kwa njia hiyo akaitakasa Yuda na Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika miji ya Manase, Efraimu na Simeoni, hadi Naftali na kwenye magofu yanayoizunguka,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akavunja madhabahu na nguzo za Ashera na kuzipondaponda hizo sanamu hadi zikawa unga na kukata vipande vipande madhabahu zote za kufukizia uvumba katika Israeli yote. Kisha akarudi Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kumi na nane wa utawala wa Yosia, ili kutakasa nchi na Hekalu, akawatuma Shafani, mwana wa Azalia na Maaseya mtawala wa mji, pamoja na Yoa mwana wa Yoahazi, mwandishi ili kukarabati Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.8",
                "verseOrgIds": [
                  "2CH.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwendea Hilkia kuhani mkuu na kumpa fedha ambazo zilikuwa zimeletwa ndani ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.9",
                "verseOrgIds": [
                  "2CH.34.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ambazo Walawi waliokuwa mabawabu walikuwa wamezikusanya kutoka kwa watu wa Manase, Efraimu na mabaki wote wa Israeli kutoka kwa watu wote wa Yuda na Benyamini na wakazi wa Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakazikabidhi hizo fedha kwa watu waliowekwa ili kusimamia kazi ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.10",
                "verseOrgIds": [
                  "2CH.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Hawa watu waliwalipa wafanyakazi waliokarabati na kutengeneza Hekalu lipate kurudi katika hali yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawapa pia mafundi seremala na waashi fedha ili kununua mawe yaliyochongwa, mbao kwa ajili ya kufungia na boriti kwa ajili ya majengo ambayo wafalme wa Yuda walikuwa wameyaacha yakawa magofu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wakafanya kazi kwa uaminifu. Waliokuwa wamewekwa juu yao ili kuwaelekeza ni Yahathi na Obadia, Walawi wa uzao wa Merari, Zekaria na Meshulamu, waliotoka kwenye uzao wa Kohathi. Walawi wote waliokuwa na ufundi wa kupiga ala za uimbaji,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakawa wasimamizi wa vibarua na kuwaongoza wale waliofanya kila aina ya kazi. Baadhi ya Walawi walikuwa waandishi, maafisa na mabawabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kitabu Cha Sheria Chapatikana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.22.3-2KI.22.20"
          },
          "items": [
            {
              "text": "2 Wafalme 22:3-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati walikuwa wakizitoa nje fedha zilizokuwa zimetolewa kwenye Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", kuhani Hilkia akakipata kile Kitabu cha Sheria ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kilichokua kimetolewa kwa mkono wa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkia akamwambia Shafani mwandishi, \"Nimekipata Kitabu cha Sheria ndani ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.15",
                "verseOrgIds": [
                  "2CH.34.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Akampa Shafani kile Kitabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Shafani akakipeleka kile Kitabu kwa mfalme na kumwambia, \"Maafisa wako wanafanya kila kitu kama walivyokabidhiwa kufanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamelipa fedha zilizokuwa katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.17",
                "verseOrgIds": [
                  "2CH.34.17"
                ]
              }
            }
          ]
        },
        {
          "text": "na wamewakabidhi wasimamizi na wafanyakazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Shafani mwandishi akamwarifu mfalme kuwa, \"Kuhani Hilkia amenipa Kitabu.\" Naye Shafani akakisoma mbele ya mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme aliposikia yale maneno ya Sheria, akayararua mavazi yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatoa maagizo haya kwa Hilkia, Ahikamu mwana wa Shafani, Abdoni mwana wa Mika, Shafani mwandishi na Asaya mtumishi wa mfalme,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nendeni mkamuulize",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
