          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akamtaka kila mmoja katika Yerusalemu na Benyamini kuweka ahadi zao wenyewe kwa hilo Agano, watu wa Yerusalemu wakafanya hivyo kwa kufuata Agano la",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.32",
                "verseOrgIds": [
                  "2CH.34.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba zao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
