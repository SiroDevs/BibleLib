          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia akaondoa machukizo yote ya sanamu kutoka nchi yote iliyokuwa mali ya Waisraeli na akawataka wale wote waliokuwako katika Israeli wamtumikie",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wao. Kwa muda wote alioishi, hawakushindwa kumfuata",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
