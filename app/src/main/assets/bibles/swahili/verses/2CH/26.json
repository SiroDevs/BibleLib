            "id": "2KI.14.21-2KI.14.22"
          },
          "items": [
            {
              "text": "2 Wafalme 14:21-22",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.15.1-2KI.15.7"
          },
          "items": [
            {
