    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia Ateswa Na Pashuri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa kuhani Pashuri mwana wa Imeri, mkuu wa maafisa wa Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.1",
                "verseOrgIds": [
                  "JER.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", alipomsikia Yeremia akitoa unabii juu ya mambo haya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaamuru Yeremia nabii apigwe na kufungwa kwenye mkatale katika Lango la Juu la Benyamini huko Hekaluni la",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.2",
                "verseOrgIds": [
                  "JER.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya pili Pashuri alipomwachia kutoka kwenye mkatale, Yeremia akamwambia, \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.3",
                "verseOrgIds": [
                  "JER.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "hakukuita jina lako kuwa Pashuri bali Magor-Misabibu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.4",
                "verseOrgIds": [
                  "JER.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": ": 'Nitakufanya kuwa hofu kuu kwako wewe mwenyewe na rafiki zako wote, na kwa macho yako mwenyewe utawaona wakianguka kwa upanga wa adui zao. Nitawatia Yuda wote mikononi mwa mfalme wa Babeli, ambaye atawachukua na kuwapeleka Babeli, ama awaue kwa upanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitatia utajiri wote wa mji huu kwa adui zao: yaani mazao yao yote, vitu vyao vyote vya thamani, na hazina zote za wafalme wa Yuda. Watavitwaa kwa nyara na kuvipeleka Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Pashuri pamoja na wote waishio katika nyumba yako mtakwenda uhamishoni Babeli. Mtafia humo na kuzikwa, wewe na rafiki zako wote ambao umewatabiria uongo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malalamiko Ya Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.7",
                "verseOrgIds": [
                  "JER.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", umenidanganya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "nami nikadanganyika;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "wewe una nguvu kuniliko,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "nawe umenishinda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "Ninadharauliwa mchana kutwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "kila mmoja ananidhihaki.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila ninenapo, ninapiga kelele",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "nikitangaza ukatili na uharibifu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "Kwa hiyo neno la",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.8",
                "verseOrgIds": [
                  "JER.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "limeniletea matukano",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "na mashutumu mchana kutwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama nikisema, \"Sitamtaja",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "wala kusema tena kwa jina lake,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "neno lake linawaka ndani ya moyo wangu kama moto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "moto uliofungwa ndani ya mifupa yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "Nimechoka sana kwa kulizuia ndani mwangu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "kweli, siwezi kujizuia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninasikia minongʼono mingi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "\"Hofu iko pande zote!",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Mshtakini! Twendeni tumshtaki!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Rafiki zangu wote wananisubiri niteleze,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "wakisema,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "\"Labda atadanganyika;",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "kisha tutamshinda",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "na kulipiza kisasi juu yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.11",
                "verseOrgIds": [
                  "JER.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "yu pamoja nami",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:11"
      },
      "items": [
        {
          "text": "kama shujaa mwenye nguvu;",
          "type": "text",
