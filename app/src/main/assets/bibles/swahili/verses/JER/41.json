  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JER 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwezi wa saba Ishmaeli mwana wa Nethania mwana wa Elishama, aliyekuwa wa uzao wa mfalme na pia alikuwa mmoja wa maafisa wa mfalme, akaja pamoja na watu kumi kwa Gedalia mwana wa Ahikamu huko Mispa. Walipokuwa wakila pamoja huko,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaeli mwana wa Nethania pamoja na wale watu kumi waliokuwa pamoja naye waliinuka na kumuua Gedalia mwana wa Ahikamu mwana wa Shafani kwa upanga, wakamuua yule ambaye mfalme wa Babeli alikuwa amemteua awe mtawala wa nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaeli akawaua pia Wayahudi wote waliokuwa na Gedalia huko Mispa, pamoja na askari wa Kikaldayo waliokuwa huko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku moja baada ya kuuawa kwa siri kwa Gedalia, kabla mtu yeyote hajafahamu jambo hilo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "watu themanini waliokuwa wamenyoa ndevu zao, waliorarua nguo zao na kujikatakata walikuja kutoka Shekemu, Shilo na Samaria wakileta sadaka za nafaka na uvumba katika nyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.41.5",
                "verseOrgIds": [
                  "JER.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaeli mwana wa Nethania akaondoka Mispa ili kwenda kuwalaki, huku akilia alipokuwa akienda. Alipokutana nao, akasema, \"Karibuni kwa Gedalia mwana wa Ahikamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipoingia mjini, Ishmaeli mwana wa Nethania na wale watu waliokuwa pamoja naye wakawachinja na kuwatupa ndani ya kisima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu kumi miongoni mwao wakamwambia Ishmaeli, \"Sisi usituue! Tuna ngano na shayiri, mafuta na asali, vilivyofichwa katika shamba.\" Kwa hiyo akawaacha na hakuwaua pamoja na wale wengine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi kile kisima ambacho alitupa zile maiti za watu aliowaua pamoja na Gedalia kilikuwa ni kile kisima ambacho Mfalme Asa alikifanya sehemu ya ulinzi wake dhidi ya Baasha mfalme wa Israeli. Ishmaeli mwana wa Nethania akakijaza kisima hicho kwa maiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmaeli akawafanya mateka watu wote ambao Nebuzaradani kiongozi wa walinzi wa mfalme alikuwa amewaacha huko Mispa na kumweka Gedalia mwana wa Ahikamu juu yao: walikuwa binti za mfalme pamoja na watu wote aliokuwa amewaacha huko. Ishmaeli mwana wa Nethania akawachukua mateka na kuondoka nao, akavuka kwenda kwa Waamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanani mwana wa Karea na maafisa wote wa jeshi waliokuwa pamoja naye waliposikia juu ya uhalifu wote ambao Ishmaeli mwana wa Nethania alikuwa ameufanya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "waliwachukua watu wao wote kwenda kupigana na Ishmaeli mwana wa Nethania. Wakakutana naye karibu na bwawa kubwa huko Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa watu wote waliokuwa na Ishmaeli walipomwona Yohanani mwana wa Karea pamoja na maafisa wa jeshi waliokuwa pamoja naye, wakafurahi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wote ambao Ishmaeli alikuwa amewachukua mateka huko Mispa wakageuka na kumfuata Yohanani mwana wa Karea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Ishmaeli mwana wa Nethania pamoja na watu wake wanane wakamtoroka Yohanani na kukimbilia kwa Waamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukimbilia Misri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yohanani mwana wa Karea pamoja na maafisa wote wa jeshi waliokuwa pamoja naye wakawaongoza wote walionusurika kutoka Mispa, ambao walipona kutoka mikononi mwa Ishmaeli mwana wa Nethania baada yake kumuua Gedalia mwana wa Ahikamu: walikuwa askari, wanawake, watoto na matowashi aliowaleta kutoka Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wakaenda mbele na kutua Geruth-Kimhamu karibu na Bethlehemu wakiwa njiani kwenda Misri",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kuwatoroka Wakaldayo. Waliwaogopa kwa sababu Ishmaeli mwana wa Nethania alikuwa amemuua Gedalia mwana wa Ahikamu, ambaye alikuwa amewekwa na mfalme wa Babeli kuwa mtawala wa nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
