  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JER 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Asiye Mwaminifu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama mtu akimpa talaka mkewe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "naye akamwacha na akaolewa na mtu mwingine,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "je, huyo mume aweza kumrudia tena?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Je, hiyo nchi haitanajisika kabisa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Lakini umeishi kama kahaba na wapenzi wengi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "je, sasa utanirudia tena?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "asema",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inua macho utazame miinuko iliyo kame na uone.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Je, pana mahali ambapo hawajalala nawe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Uliketi kando ya barabara ukiwasubiri wapenzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "ukakaa kama yeye ahamahamaye jangwani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Umeinajisi nchi",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "kwa ukahaba wako na uovu wako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo mvua imezuiliwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "nazo mvua za vuli hazikunyesha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "Hata hivyo, una uso usio na haya kama wa kahaba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "unakataa kutahayari kwa aibu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, wewe hujaniita hivi punde tu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:4"
      },
      "items": [
        {
          "text": "'Baba yangu, rafiki yangu tangu ujana wangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "je, utakasirika siku zote?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Je, ghadhabu yako itaendelea milele?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Hivi ndivyo unavyozungumza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "lakini unafanya maovu yote uwezayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wito Kwa Ajili Ya Toba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa utawala wa Mfalme Yosia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.6",
                "verseOrgIds": [
                  "JER.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "aliniambia, \"Umeona kile Israeli asiye mwaminifu amekifanya? Amepanda juu ya kila kilima kirefu, na chini ya kila mti uliotanda na amefanya uzinzi huko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi nilifikiri kuwa baada ya kuyafanya yote haya angelinirudia, lakini hakurudi, naye dada yake Yuda mdanganyifu aliona hili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilimpa Israeli asiye mwaminifu hati yake ya talaka, na kumfukuza kwa ajili ya uzinzi wake wote. Hata hivyo nikaona kuwa Yuda dada yake mdanganyifu hakuogopa. Yeye pia alitoka na kufanya uzinzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.8",
            "verseOrgIds": [
              "JER.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu uasherati wa Israeli haukuwa kitu kwake, Yuda aliinajisi nchi kwa kuzini na mawe na miti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.9",
            "verseOrgIds": [
              "JER.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamoja na hayo yote, Yuda dada yake mdanganyifu hakunirudia kwa moyo wake wote, bali kwa kujifanya tu,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.10",
                "verseOrgIds": [
                  "JER.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.11",
                "verseOrgIds": [
                  "JER.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akaniambia, \"Israeli asiye mwaminifu ana haki kuliko Yuda mdanganyifu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda, ukatangaze ujumbe huu kuelekea kaskazini:",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "\" 'Rudi, Israeli usiye mwaminifu,' asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.12",
                "verseOrgIds": [
                  "JER.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'sitakutazama tena kwa uso uliokunjamana,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "kwa kuwa mimi ni mwenye huruma,' asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.12",
                "verseOrgIds": [
                  "JER.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'Sitashika hasira yangu milele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 3:13"
          },
          "items": [
            {
