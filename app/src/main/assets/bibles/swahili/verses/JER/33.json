                "verseOrgIds": [
                  "JER.33.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Haki Yetu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
