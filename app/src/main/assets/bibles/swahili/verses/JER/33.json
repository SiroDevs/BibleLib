          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.17",
                "verseOrgIds": [
                  "JER.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": ": 'Daudi kamwe hatakosa mtu wa kukalia kiti cha enzi cha nyumba ya Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala hata makuhani, ambao ni Walawi, kamwe hawatakosa mtu wa kusimama mbele zangu daima ili kutoa sadaka za kuteketezwa, ili kuteketeza sadaka ya nafaka na kutoa dhabihu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.19",
                "verseOrgIds": [
                  "JER.33.19"
                ]
              }
            }
          ]
        },
        {
          "text": "likamjia Yeremia kusema:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.20",
                "verseOrgIds": [
                  "JER.33.20"
                ]
              }
            }
          ]
        },
        {
          "text": ": 'Ikiwa mtaweza kuvunja agano langu kuhusu usiku na mchana, ili usiku na mchana visiwepo kwa nyakati zake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi agano langu na Daudi mtumishi wangu, na agano langu na Walawi ambao ni makuhani wanaohudumu mbele zangu, linaweza kuvunjwa, na Daudi hatakuwa tena na mzao wa kutawala katika kiti chake cha enzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawafanya wazao wa Daudi mtumishi wangu na Walawi wanaohudumu mbele zangu wengi, wasioweza kuhesabika kama nyota za angani, tena wasiopimika kama mchanga wa ufuoni mwa bahari.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
