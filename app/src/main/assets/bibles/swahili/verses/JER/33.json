    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahadi Ya Kurudishwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati Yeremia alipokuwa angali amefungwa kwenye ua wa walinzi, neno la",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.1",
                "verseOrgIds": [
                  "JER.33.1"
                ]
              }
            }
          ]
        },
        {
          "text": "lilimjia mara ya pili kusema:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "asemalo, yeye aliyeumba dunia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "aliyeifanya na kuithibitisha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ndilo jina lake:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Niite nami nitakuitika na kukuambia mambo makuu na yasiyochunguzika, usiyoyajua.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.4",
                "verseOrgIds": [
                  "JER.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli, asemalo kuhusu nyumba katika mji huu na majumba ya kifalme ya Yuda yaliyobomolewa ili yatumiwe dhidi ya kule kuzungukwa na jeshi na upanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika kupigana na Wakaldayo: 'Zitajazwa na maiti za watu nitakaowachinja katika hasira na ghadhabu yangu. Nitauficha uso wangu kwa sababu ya maovu yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.5",
            "verseOrgIds": [
              "JER.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Hata hivyo, nitauletea afya na uponyaji, nitawaponya watu wangu na kuwafanya wafurahie amani tele na salama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawarudisha Yuda na Israeli kutoka nchi ya kutekwa kwao, na kuwajenga tena kama walivyokuwa hapo awali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawatakasa dhambi zote walizofanya dhidi yangu, na nitawasamehe dhambi zote za uasi dhidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.8",
            "verseOrgIds": [
              "JER.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mji huu utaniletea utukufu, furaha, sifa na heshima mbele ya mataifa yote ya dunia yatakayosikia mambo yote mazuri ninayoufanyia. Nao watashangaa na kutetemeka kwa ajili ya wingi wa mafanikio na amani nitakayoupatia.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.10",
                "verseOrgIds": [
                  "JER.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": ": 'Mnasema kuhusu mahali hapa kwamba, \"Ni mahali palipoachwa ukiwa, pasipo na wanadamu wala wanyama.\" Lakini katika miji ya Yuda na barabara za Yerusalemu ambazo zimeachwa, ambazo hazikaliwi na wanadamu wala wanyama, huko kutasikika kwa mara nyingine",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "sauti za shangwe na furaha, sauti za bibi na bwana arusi, na sauti za wale waletao sadaka za shukrani katika nyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", wakisema,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "\" ' \"Mshukuruni",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ni mwema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "upendo wake wadumu milele.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "Kwa kuwa nitairudishia nchi baraka kama zilivyokuwa hapo awali,' asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.12",
                "verseOrgIds": [
                  "JER.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote: 'Mahali hapa, ambapo ni ukiwa, pasipo na wanadamu wala wanyama: katika miji yake, patakuwepo tena malisho kwa ajili ya wachungaji kupumzisha makundi yao ya kondoo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika miji ya nchi ya vilima, ya vilima vya magharibi na ya Negebu, katika nchi ya Benyamini, katika vijiji vinavyoizunguka Yerusalemu na katika miji ya Yuda, makundi ya kondoo yatapita tena chini ya mkono wa yeye ayahesabuye,' asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.13",
                "verseOrgIds": [
                  "JER.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Siku zinakuja,' asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.14",
                "verseOrgIds": [
                  "JER.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'wakati nitakapotimiza ahadi yangu ya rehema niliyoifanya kwa nyumba ya Israeli na kwa nyumba ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Katika siku hizo na wakati huo",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "nitalifanya Tawi la haki lichipuke kutoka ukoo wa Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "naye atafanya lile lililo haki na sawa",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
