      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adhabu Isiyoepukika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.1",
                "verseOrgIds": [
                  "JER.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akaniambia: \"Hata kama Mose na Samweli wangesimama mbele zangu, moyo wangu usingewaelekea watu hawa. Waondoe mbele za macho yangu! Waache waende!",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao kama wakikuuliza, 'Twende wapi?' Waambie, 'Hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.2",
                "verseOrgIds": [
                  "JER.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "asemalo:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "\" 'Wale waliowekwa kwa ajili ya kufa, wakafe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "waliowekwa kwa ajili ya upanga, kwa upanga;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "waliowekwa kwa ajili ya njaa, kwa njaa:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "waliowekwa kwa ajili ya kutekwa, watekwe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.3",
                "verseOrgIds": [
                  "JER.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "asema, \"Nitatuma aina nne za waharabu dhidi yao: nazo ni upanga ili kuua na mbwa ili wakokote mbali, ndege wa angani na wanyama wa nchi ili kula na kuangamiza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawafanya wawe machukizo kwa falme zote za dunia kwa sababu ya kile alichofanya Manase mwana wa Hezekia mfalme wa Yuda huko Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ni nani atakayekuhurumia, ee Yerusalemu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Ni nani atakayeomboleza kwa ajili yako?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Ni nani atakayesimama ili kuuliza",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "kuhusu hali yako?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umenikataa mimi,\" asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.6",
                "verseOrgIds": [
                  "JER.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "\"Unazidi kukengeuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "Hivyo nitanyoosha mkono wangu juu yako na kukuangamiza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "siwezi kuendelea kukuonea huruma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawapepeta kwa uma wa kupepetea",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "kwenye malango ya miji katika nchi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "Nitaleta msiba na maangamizi juu ya watu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "kwa maana hawajabadili njia zao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitawafanya wajane wao kuwa wengi",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "kuliko mchanga wa bahari.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "Wakati wa adhuhuri nitamleta mharabu",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "dhidi ya mama wa vijana wao waume;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "kwa ghafula nitaleta juu yao",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "maumivu makuu na hofu kuu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mama mwenye watoto saba atazimia",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "na kupumua pumzi yake ya mwisho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Jua lake litatua kungali bado mchana,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "atatahayarika na kufedheheka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Wale wote waliobaki nitawaua kwa upanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "mbele ya adui zao,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "asema",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wangu, mama yangu, kwamba ulinizaa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "mtu ambaye ulimwengu wote",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "unashindana na kugombana naye!",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "Sikukopa wala sikukopesha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
