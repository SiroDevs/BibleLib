      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Tulitarajia amani,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
