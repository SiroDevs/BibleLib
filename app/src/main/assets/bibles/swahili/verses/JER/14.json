      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ninaona wale waliouawa kwa upanga;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
