      "attrs": {
        "style": "q2",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "usikidharau kiti chako cha enzi kilichotukuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
