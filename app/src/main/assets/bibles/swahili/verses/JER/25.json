              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachungaji hawatakuwa na mahali pa kukimbilia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
