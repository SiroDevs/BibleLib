      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:32"
      },
      "items": [
        {
          "text": "\"Tazama! Maafa yanaenea",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
