      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "mgaagae mavumbini,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
