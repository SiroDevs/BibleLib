                "verseOrgIds": [
                  "JER.25.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote asemalo:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        }
