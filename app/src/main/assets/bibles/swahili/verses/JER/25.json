          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lieni na kuomboleza, enyi wachungaji,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
