      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "kama vyombo vizuri vya udongo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
