        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anguko La Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.24.18-2KI.25.30"
          },
          "items": [
            {
              "text": "2 Wafalme 24:18–25:30",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekia alikuwa na umri wa miaka ishirini na mmoja alipoanza kutawala, naye akatawala huko Yerusalemu kwa miaka kumi na mmoja. Jina la mama yake aliitwa Hamutali binti Yeremia, kutoka Libna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alifanya maovu machoni pa",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.2",
                "verseOrgIds": [
                  "JER.52.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", kama alivyofanya Yehoyakimu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilikuwa ni kwa sababu ya hasira ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.3",
                "verseOrgIds": [
                  "JER.52.3"
                ]
              }
            }
          ]
        },
        {
          "text": "haya yote yalitokea Yerusalemu na Yuda, naye mwishoni akawaondoa mbele zake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:3"
      },
      "items": [
        {
          "text": "Basi, Sedekia akaasi dhidi ya mfalme wa Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo katika mwaka wa tisa wa utawala wa Sedekia, katika siku ya kumi ya mwezi wa kumi, Nebukadneza mfalme wa Babeli akiwa na jeshi lake lote alifanya vita dhidi ya Yerusalemu. Wakapiga kambi nje ya mji na kuuzunguka mji pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mji ulizungukwa na jeshi mpaka mwaka wa kumi na moja wa utawala wa Mfalme Sedekia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilipowadia siku ya tisa ya mwezi wa nne, njaa ikazidi kuwa kali sana ndani ya mji, hadi hapakuwa na chakula kwa ajili ya watu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha ukuta wa mji ukavunjwa na jeshi lote likakimbia. Wakaondoka mjini usiku kupitia lango lililokuwa kati ya kuta mbili karibu na bustani ya mfalme, ingawa Wakaldayo walikuwa wameuzunguka mji. Wakakimbia kuelekea Araba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini jeshi la Wakaldayo likamfuatia Mfalme Sedekia na kumpata katika sehemu tambarare za Yeriko. Askari wake wote wakatengwa naye na kutawanyika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akakamatwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:9"
      },
      "items": [
        {
          "text": "Akapelekwa kwa mfalme wa Babeli huko Ribla, katika nchi ya Hamathi, mahali ambapo alimtangazia hukumu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko Ribla mfalme wa Babeli aliwachinja wana wa Sedekia mbele ya macho yake. Pia akawaua maafisa wote wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akayangʼoa macho ya Sedekia, akamfunga kwa pingu za shaba na kumpeleka Babeli, alipomweka gerezani mpaka siku ya kifo chake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamo siku ya kumi ya mwezi wa tano, katika mwaka wa kumi na tisa wa utawala wa Nebukadneza mfalme wa Babeli, Nebuzaradani jemadari wa askari walinzi wa mfalme, aliyemtumikia mfalme wa Babeli, alikuja Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alichoma moto Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.13",
                "verseOrgIds": [
                  "JER.52.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", jumba la kifalme, na nyumba zote za Yerusalemu. Aliteketeza kila jengo muhimu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshi lote la Wakaldayo chini ya jemadari wa askari walinzi wa mfalme walivunja kuta zote zilizoizunguka Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani, jemadari wa askari walinzi, akawapeleka uhamishoni baadhi ya watu maskini sana na wale waliobaki katika mji, pamoja na mabaki ya watu wa kawaida, na wale waliojisalimisha kwa mfalme wa Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Nebuzaradani akawaacha mabaki ya wale watu maskini kabisa ili watunze mashamba ya mizabibu na mashamba mengine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaldayo walivunja vipande zile nguzo za shaba, vile vishikilio vya shaba vilivyohamishika, na ile Bahari ya shaba, ambavyo vyote vilikuwa katika Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.17",
                "verseOrgIds": [
                  "JER.52.17"
                ]
              }
            }
          ]
        },
        {
          "text": ". Hivyo wakaichukua hiyo shaba yote na kuipeleka Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakachukua pia vyungu, masepetu, mikasi ya kusawazishia tambi, mabakuli ya kunyunyizia, sahani na vyombo vyote vya shaba vilivyotumika katika huduma ya Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemadari wa askari walinzi wa mfalme akachukua yale masinia, vile vyetezo, yale mabakuli ya kunyunyizia, zile sufuria, vile vinara vya taa, zile sahani na yale mabakuli yaliyotumika kwa sadaka za vinywaji, vitu vyote vile vilivyokuwa vimetengenezwa kwa dhahabu safi au fedha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaba iliyotokana na zile nguzo mbili, ile Bahari na wale mafahali kumi na mawili wa shaba waliokuwa chini yake, pamoja na vile vishikilio vilivyohamishika, ambavyo Mfalme Solomoni alikuwa ametengeneza kwa ajili ya Hekalu la",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.20",
                "verseOrgIds": [
                  "JER.52.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", ilikuwa na uzito usioweza kupimika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila nguzo ilikuwa na urefu wa dhiraa kumi na nane, kimo chake na mzunguko dhiraa kumi na mbili, na unene wa nyanda nne, na zote zilikuwa wazi ndani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sehemu ya shaba juu ya ile nguzo moja ilikuwa na urefu wa dhiraa tano, na ilikuwa imepambwa kwa wavu na makomamanga ya shaba kuizunguka kote. Ile nguzo nyingine pamoja na makomamanga yake ilifanana na hiyo ya kwanza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na makomamanga tisini na sita pembeni; jumla ya makomamanga juu ya wavu uliokuwa umezunguka yalikuwa mia moja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule jemadari wa askari walinzi akawachukua kama wafungwa Seraya kuhani mkuu, kuhani Sefania aliyefuata kwa cheo, na mabawabu watatu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miongoni mwa wale watu waliokuwa wamesalia katika mji, alimchukua afisa kiongozi wa wapiganaji, na washauri saba wa mfalme. Akamchukua pia mwandishi aliyesimamia uandikishaji wa watu wa nchi, pamoja na watu wake sitini waliopatikana ndani ya mji.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani jemadari akawachukua hao wote na kuwapeleka kwa mfalme wa Babeli huko Ribla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huko Ribla, katika nchi ya Hamathi, mfalme wa Babeli akaamuru wanyongwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:27"
      },
      "items": [
        {
          "text": "Hivyo Yuda wakaenda utumwani, mbali na nchi yao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hii ndiyo hesabu ya watu ambao Nebukadneza aliwachukua kwenda uhamishoni:",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 52:28"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 52:28"
      },
      "items": [
        {
          "text": "katika mwaka wa saba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:28"
      },
      "items": [
        {
          "text": "Wayahudi 3,023;",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika mwaka wa kumi na nane wa utawala wa Nebukadneza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:29"
      },
      "items": [
        {
          "text": "watu 832 kutoka Yerusalemu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika mwaka wa ishirini na tatu wa utawala wake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Wayahudi 745 walichukuliwa kwenda uhamishoni na Nebuzaradani jemadari wa askari walinzi wa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Jumla ya watu wote walikuwa 4,600.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakini Anaachiwa Huru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa thelathini na saba tangu Yehoyakini mfalme wa Yuda apelekwe uhamishoni, katika mwaka ule ambao Evil-Merodaki",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "text": "alifanyika mfalme wa Babeli, alimwacha huru Yehoyakini mfalme wa Yuda, na kumfungua kutoka gerezani siku ya ishirini na tano ya mwezi wa kumi na mbili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alizungumza naye kwa upole na kumpa kiti cha heshima zaidi kuliko wale wafalme wengine aliokuwa nao huko Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Yehoyakini akayavua mavazi yake ya mfungwa, na siku zote za maisha yake zilizobaki alikula mezani mwa mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku kwa siku mfalme wa Babeli alimpa Yehoyakini posho siku zote za maisha yake, hadi siku ya kifo chake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
