              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enyi mabaki ya Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.42.19",
                "verseOrgIds": [
                  "JER.42.19"
                ]
              }
            }
          ]
        },
        {
          "text": "amewaambia, 'Msiende Misri.' Hakikisheni jambo hili: Ninawaonya leo",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba mmefanya kosa kubwa mioyoni mwenu mliponituma kwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.42.20",
                "verseOrgIds": [
                  "JER.42.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu na kusema, 'Mwombe",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.42.20",
                "verseOrgIds": [
                  "JER.42.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wetu kwa ajili yetu, nawe utuambie kila kitu atakachosema, nasi tutafanya.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimewaambieni leo, lakini bado ninyi hamtaki kumtii",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.42.21",
                "verseOrgIds": [
                  "JER.42.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu katika yote aliyonituma niwaambie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa, hakikisheni jambo hili: Mtakufa kwa upanga, njaa na tauni mahali ambapo mnataka kwenda kuishi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.22",
            "verseOrgIds": [
              "JER.42.22"
            ]
          }
        }
      ]
