  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JER 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katika Nyumba Ya Mfinyanzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo neno lililomjia Yeremia kutoka kwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.1",
                "verseOrgIds": [
                  "JER.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Shuka uende mpaka nyumba ya mfinyanzi, nami huko nitakupa ujumbe wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo nikashuka mpaka kwenye nyumba ya mfinyanzi, nikamkuta akifinyanga kwa gurudumu lake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini chombo alichokuwa akikifinyanga kutokana na udongo kilivunjika mikononi mwake, hivyo mfinyanzi akakifanya kuwa chombo kingine, umbo jingine kama vile ilivyoonekana vyema kwake yeye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha neno la",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.5",
                "verseOrgIds": [
                  "JER.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "likanijia kusema:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee nyumba ya Israeli, je, siwezi kuwafanyia kama huyu mfinyanzi afanyavyo?\" asema",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.6",
                "verseOrgIds": [
                  "JER.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Kama vile udongo ulivyo katika mikono ya mfinyanzi, ndivyo mlivyo katika mkono wangu, ee nyumba ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa wakati wowote nikitangaza kuwa taifa au ufalme utangʼolewa, utaangushwa na kuangamizwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiwa lile taifa nililolionya litatubia uovu wake, ndipo nitakapokuwa na huruma, wala sitawapiga kwa maafa niliyokuwa nimewakusudia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa wakati mwingine nitatangaza kuwa taifa ama utawala ujengwe na kuwekwa wakfu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiwa utafanya maovu mbele zangu na hukunitii, ndipo nitakapoghairi makusudio yangu mema niliyokuwa nimeyakusudia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Basi kwa hiyo waambie watu wa Yuda na wale waishio Yerusalemu, 'Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.11",
                "verseOrgIds": [
                  "JER.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": ": Tazama! Ninaandaa maafa kwa ajili yenu, nami ninabuni mabaya dhidi yenu. Kwa hiyo geukeni kutoka njia zenu mbaya, kila mmoja wenu, tengenezeni njia zenu na matendo yenu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wao watajibu, 'Hakuna faida. Tutaendelea na mipango yetu wenyewe, kila mmoja wetu atafuata ukaidi wa moyo wake mbaya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.13",
                "verseOrgIds": [
                  "JER.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "\"Ulizia miongoni mwa mataifa:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Ni nani alishasikia jambo kama hili?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Jambo la kutisha sana limefanywa",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "na Bikira Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, barafu ya Lebanoni iliwahi kutoweka",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "kwenye miteremko yake ya mawe wakati wowote?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "Je, maji yake baridi yatokayo katika vyanzo vilivyo mbali",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "yaliwahi kukoma kutiririka wakati wowote?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu wangu wamenisahau mimi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "wanafukizia uvumba sanamu zisizofaa kitu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "zilizowafanya wajikwae katika njia zao",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "na katika mapito ya zamani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "Zimewafanya wapite kwenye vichochoro",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "na kwenye barabara ambazo hazikujengwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchi yao itaharibiwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "itakuwa kitu cha kudharauliwa daima;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "wote wapitao karibu nayo watashangaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "na kutikisa vichwa vyao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama upepo utokao mashariki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "nitawatawanya mbele ya adui zao;",
          "type": "text",
          "attrs": {
