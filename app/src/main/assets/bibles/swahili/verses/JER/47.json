          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mnalia, 'Aa, upanga wa",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.47.6",
                "verseOrgIds": [
                  "JER.47.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "utaendelea mpaka lini ndipo upumzike?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "Rudi ndani ya ala yako;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "acha na utulie.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini upanga utatuliaje",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "wakati",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.47.7",
                "verseOrgIds": [
                  "JER.47.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ameuamuru,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "wakati ameuagiza kuishambulia Ashkeloni",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "pamoja na pwani yake?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
