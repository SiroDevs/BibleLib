                "verseOrgIds": [
                  "JER.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote asemalo: 'Nitawaadhibu. Vijana wao waume watakufa kwa upanga, wana wao na binti zao kwa njaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
