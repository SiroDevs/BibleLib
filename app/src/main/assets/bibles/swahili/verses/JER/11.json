                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "asemalo kuhusu watu wa Anathothi wale wanaotafuta uhai wako wakisema, 'Usitoe unabii kwa jina la",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
