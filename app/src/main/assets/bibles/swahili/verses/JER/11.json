                "verseOrgIds": [
                  "JER.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "alinifunulia hila zao mbaya, nilizifahamu, kwa kuwa wakati ule alinionyesha yale waliyokuwa wanayafanya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
