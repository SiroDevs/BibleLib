              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa hiyo hili ndilo",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "char",
