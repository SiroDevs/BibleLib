      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "ili jina lake lisikumbukwe tena.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
