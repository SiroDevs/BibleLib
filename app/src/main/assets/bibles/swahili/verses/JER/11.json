          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilikuwa kama mwana-kondoo mpole aliyeongozwa machinjoni; mimi sikutambua kwamba walikuwa wamefanya shauri baya dhidi yangu, wakisema,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "\"Sisi na tuuangamize mti na matunda yake;",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
