          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawatasaziwa hata mabaki kwao, kwa sababu nitaleta maafa kwa watu wa Anathothi katika mwaka wa adhabu yao.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.23",
            "verseOrgIds": [
              "JER.11.23"
            ]
          }
