                "verseId": "JER.11.21",
                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", la sivyo utakufa kwa mikono yetu':",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
