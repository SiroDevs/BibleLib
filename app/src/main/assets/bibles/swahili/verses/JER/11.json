      "attrs": {
        "style": "q2",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "nawe uchunguzaye moyo na akili,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
