              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini, Ee",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.20",
                "verseOrgIds": [
                  "JER.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, wewe uhukumuye kwa haki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
