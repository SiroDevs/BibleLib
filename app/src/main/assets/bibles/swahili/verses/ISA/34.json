    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hukumu Dhidi Ya Mataifa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooni karibu, enyi mataifa, nanyi msikilize;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "sikilizeni kwa makini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "enyi kabila za watu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "Dunia na isikie, navyo vyote vilivyo ndani yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "ulimwengu na vyote vitokavyo ndani yake!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.34.2",
                "verseOrgIds": [
                  "ISA.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ameyakasirikia mataifa yote;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "ghadhabu yake ni juu ya majeshi yao yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "Atawaangamiza kabisa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "atawatia mikononi mwa wachinjaji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliouawa watatupwa nje,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "maiti zao zitatoa uvundo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "milima itatota kwa damu zao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyota zote za mbinguni zitayeyuka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "na anga litasokotwa kama kitabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "jeshi lote la angani litaanguka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "kama majani yaliyonyauka kutoka kwenye mzabibu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "kama tini iliyonyauka kutoka kwenye mtini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upanga wangu umekunywa na kushiba huko mbinguni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "tazama, unashuka katika hukumu juu ya Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "wale watu ambao nimeshawahukumu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "kuwaangamiza kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upanga wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.34.6",
                "verseOrgIds": [
                  "ISA.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": "umeoga katika damu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "umefunikwa na mafuta ya nyama:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "damu ya kondoo na mbuzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "mafuta kutoka figo za kondoo dume.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "Kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.34.6",
                "verseOrgIds": [
                  "ISA.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ana dhabihu huko Bosra,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "na machinjo makuu huko Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyati wataanguka pamoja nao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "ndama waume na mafahali wakubwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "Nchi yao italowana kwa damu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "nayo mavumbi yataloa mafuta ya nyama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.34.8",
                "verseOrgIds": [
                  "ISA.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "anayo siku ya kulipiza kisasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:8"
      },
      "items": [
        {
          "text": "mwaka wa malipo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:8"
      },
      "items": [
        {
          "text": "siku ya kushindania shauri la Sayuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vijito vya Edomu vitageuka kuwa lami,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "mavumbi yake yatakuwa kiberiti kiunguzacho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "nchi yake itakuwa lami iwakayo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haitazimishwa usiku wala mchana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
