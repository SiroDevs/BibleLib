      },
      "items": [
        {
          "text": "63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siku Ya Mungu Ya Kisasi Na Ukombozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani huyu anayekuja kutoka Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "kutoka Bosra, mwenye mavazi yaliyotiwa madoa mekundu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "Ni nani huyu, aliyevikwa joho la kifahari,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "anayetembea kwa ukuu wa nguvu zake?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 63:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "\"Mimi ndimi, nisemaye katika haki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "mwenye nguvu wa kuokoa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini mavazi yako ni mekundu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:2"
      },
      "items": [
        {
          "text": "kama ya yule akanyagaye shinikizo la zabibu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimekanyaga shinikizo la zabibu peke yangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "kutoka mataifa hakuna mtu aliyekuwa pamoja nami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "Nimewaponda kwa miguu katika hasira yangu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "na kuwakanyaga chini katika ghadhabu yangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "damu yao ilitia matone kwenye mavazi yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "na kutia madoa nguo zangu zote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa siku ya kisasi ilikuwa moyoni mwangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:4"
      },
      "items": [
        {
          "text": "mwaka wa ukombozi wangu umefika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilitazama, lakini hakuwepo yeyote wa kunisaidia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:5"
      },
      "items": [
        {
          "text": "nilishangaa kwa kuwa hakuwepo yeyote aliyetoa msaada;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:5"
      },
      "items": [
        {
          "text": "hivyo mkono wangu wenyewe ndio ulionifanyia wokovu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:5"
      },
      "items": [
        {
          "text": "na ghadhabu yangu mwenyewe ndiyo iliyonitegemeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilikanyaga mataifa kwa miguu katika hasira yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:6"
      },
      "items": [
        {
          "text": "katika ghadhabu yangu niliwalewesha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:6"
      },
      "items": [
        {
          "text": "na kumwaga damu yao juu ya ardhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusifu Na Kuomba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitasimulia juu ya wema wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.63.7",
                "verseOrgIds": [
                  "ISA.63.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "kwa matendo ambayo apaswa kusifiwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "sawasawa na yote ambayo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.63.7",
                "verseOrgIds": [
                  "ISA.63.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "ametenda kwa ajili yetu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "naam, mambo mengi mema aliyoyatenda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "kwa ajili ya nyumba ya Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "sawasawa na huruma zake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "na wema wake mwingi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alisema, \"Hakika wao ni watu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:8"
      },
      "items": [
        {
          "text": "wana ambao hawatanidanganya\";",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:8"
      },
      "items": [
        {
          "text": "hivyo akawa Mwokozi wao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika taabu zao zote naye alitaabika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "na malaika wa uso wake akawaokoa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "Katika upendo wake na rehema zake aliwakomboa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "akawainua na kuwachukua siku zote zilizopita.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini waliasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
