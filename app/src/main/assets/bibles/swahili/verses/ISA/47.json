      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anguko La Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Shuka uketi mavumbini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "ee Bikira Binti Babeli;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "keti chini pasipo na kiti cha enzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "ee binti wa Wakaldayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "Hutaitwa tena mwororo wala wa kupendeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chukua mawe ya kusagia, usage unga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "vua shela yako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "Pandisha mavazi yako, ondoa viatu vyako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "vuka vijito kwa shida.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchi wako utafunuliwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "na aibu yako itaonekana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "Nitalipa kisasi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "sitamhurumia hata mmoja.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkombozi wetu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote ndilo jina lake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:4"
      },
      "items": [
        {
          "text": "ndiye yeye Aliye Mtakatifu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Keti kimya, ingia gizani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "Binti wa Wakaldayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "hutaitwa tena malkia wa falme.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niliwakasirikia watu wangu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "na kuaibisha urithi wangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "niliwatia mikononi mwako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "nawe hukuwaonea huruma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "Hata juu ya wazee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "uliweka nira nzito sana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukasema, 'Nitaendelea",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "kuwa malkia milele!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "Lakini hukutafakari mambo haya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "wala hukuwaza juu ya kile kingeweza kutokea.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sasa basi, sikiliza, ewe kiumbe mpenda anasa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "ukaaye mahali pako pa salama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "na kujiambia mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "'Mimi ndiye, wala hakuna mwingine zaidi yangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "Kamwe sitakuwa mjane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "wala sitafiwa na watoto.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya mawili yatakupata, kufumba na kufumbua,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "katika siku moja:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "kufiwa na watoto, na ujane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "Yote yatakupata kwa kipimo kikamilifu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "ijapokuwa uchawi wako ni mwingi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "na uaguzi wako ni mwingi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umeutegemea uovu wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "nawe umesema, 'Hakuna yeyote anionaye.'",
          "type": "text",
          "attrs": {
