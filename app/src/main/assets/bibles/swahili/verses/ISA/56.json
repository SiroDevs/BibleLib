      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "\"Dumisheni haki",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "na mkatende lile lililo sawa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "kwa maana wokovu wangu u karibu",
