            "sid": "ISA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diboni anakwea hadi kwenye hekalu lake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "mpaka mahali pake pa juu ili walie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Moabu anaombolezea Nebo na Medeba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Kila kichwa kimenyolewa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "na kila ndevu limeondolewa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamevaa nguo za magunia barabarani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "juu ya mapaa na kwenye viwanja",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "wote wanaomboleza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "wamelala kifudifudi kwa kulia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
