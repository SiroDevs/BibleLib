      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "wanakwenda huku wanalia;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "barabarani iendayo Horonaimu",
