            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku hizo Hezekia akaugua, naye akawa karibu kufa. Nabii Isaya mwana wa Amozi akaenda kwake na kumwambia, \"Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.1",
                "verseOrgIds": [
                  "ISA.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": ": Tengeneza mambo ya nyumba yako, kwa sababu utakufa, hutapona.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akaelekeza uso wake ukutani, akamwomba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.2",
                "verseOrgIds": [
                  "ISA.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.3",
                "verseOrgIds": [
                  "ISA.38.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", kumbuka jinsi nilivyoenenda mbele zako kwa uaminifu na kujitoa kwa moyo wangu wote, na kufanya yaliyo mema machoni pako.\" Naye Hezekia akalia kwa uchungu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo neno la",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.4",
                "verseOrgIds": [
                  "ISA.38.4"
                ]
              }
            }
          ]
        },
        {
          "text": "likamjia Isaya, kusema:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nenda ukamwambie Hezekia, 'Hili ndilo asemalo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.5",
                "verseOrgIds": [
                  "ISA.38.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa baba yako Daudi: Nimeyasikia maombi yako na nimeona machozi yako. Nitakuongezea miaka kumi na mitano katika maisha yako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitakuokoa wewe pamoja na mji huu mkononi mwa mfalme wa Ashuru. Nitaulinda mji huu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Hii ndiyo ishara ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kwako ya kwamba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "atafanya kile alichoahidi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitafanya kivuli cha jua kwenye ngazi iliyojengwa na Ahazi kirudi nyuma madaraja kumi.' \" Hivyo jua likarudi nyuma madaraja kumi ambayo lilikuwa limeshuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maandiko ya Hezekia mfalme wa Yuda baada ya kuugua kwake na kupona:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilisema, \"Katika ustawi wa maisha yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "je, ni lazima nipite katika malango ya mauti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "na kupokonywa miaka yangu iliyobaki?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilisema, \"Sitamwona tena",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.11",
                "verseOrgIds": [
                  "ISA.38.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.11",
                "verseOrgIds": [
                  "ISA.38.11"
                ]
              }
            }
          ]
        },
        {
          "text": "katika nchi ya walio hai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "wala sitamtazama tena mwanadamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "wala kuwa na wale ambao sasa wanakaa katika ulimwengu huu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama hema la mchunga mifugo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "nyumba yangu imebomolewa na kutwaliwa kutoka kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "Kama mfumaji nimevingirisha maisha yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "naye amenikatilia mbali kutoka kitanda cha mfumi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "Mchana na usiku uliyakomesha maisha yangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilingoja kwa uvumilivu hadi mapambazuko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "lakini alivunja mifupa yangu yote kama simba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "Mchana na usiku uliyakomesha maisha yangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nililia kama mbayuwayu au korongo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "niliomboleza kama hua aombolezaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "Macho yangu yalififia nilipotazama mbinguni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
