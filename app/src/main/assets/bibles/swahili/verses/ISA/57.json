        "sid": "ISA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibada Ya Sanamu Ya Israeli Iliyo Batili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye haki hupotea,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "wala hakuna hata mmoja awazaye hilo moyoni mwake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "watu wanaomcha Mungu huondolewa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "wala hakuna hata mmoja anayeelewa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "kuwa wenye haki wameondolewa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "ili wasipatikane na maovu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale waendao kwa unyofu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "huwa na amani;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "hupata pumziko walalapo mautini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lakini ninyi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:3"
      },
      "items": [
        {
          "text": "Njooni hapa, ninyi wana wa wachawi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:3"
      },
      "items": [
        {
          "text": "ninyi wazao wa wazinzi na makahaba!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnamdhihaki nani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Ni nani mnayemcheka kwa dharau,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "na kumtolea ndimi zenu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Je, ninyi si watoto wa waasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "uzao wa waongo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnawaka tamaa katikati ya mialoni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "na chini ya kila mti uliotanda matawi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "mnawatoa kafara watoto wenu kwenye mabonde",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "na chini ya majabali yenye mianya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sanamu zilizo katikati ya mawe laini ya mabondeni ndizo fungu lenu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "hizo ndizo sehemu yenu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Naam, kwa hizo mmemimina sadaka za vinywaji,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "na kutoa sadaka za nafaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Katika haya yote,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "niendelee kuona huruma?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umeweka kitanda chako juu kwenye kilima kirefu kilichoinuka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:7"
      },
      "items": [
        {
          "text": "huko ulikwenda kutoa dhabihu zako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya milango yako na miimo yako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "umeweka alama zako za kipagani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "Kwa kuniacha mimi, ulifunua kitanda chako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "umepanda juu yake na kukipanua sana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "ulifanya patano na wale ambao unapenda vitanda vyao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "nawe uliangalia uchi wao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulikwenda kwa Moleki",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        },
        {
          "text": "ukiwa na mafuta ya zeituni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "na ukaongeza manukato yako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "Ukawatuma wajumbe wako mbali sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "ukashuka kwenye kaburi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        },
        {
          "text": "lenyewe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulikuwa umechoshwa na njia zako zote,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "lakini hukusema, 'Hakuna tumaini.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "Ulipata uhuisho wa nguvu zako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
