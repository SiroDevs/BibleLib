    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unabii Dhidi Ya Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno kuhusu Babeli ambalo Isaya mwana wa Amozi aliliona:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twekeni bendera juu ya mlima usio na kitu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "wapazieni sauti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "wapungieni mkono waingie",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "katika malango ya wenye heshima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimewaamuru watakatifu wangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "nimewaita mashujaa wangu waitimize hasira yangu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "wale wanaoshangilia ushindi wangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikilizeni kelele juu ya milima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "kama ile ya umati mkubwa wa watu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "Sikilizeni, makelele katikati ya falme,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "kama mataifa yanayokusanyika pamoja!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.13.4",
                "verseOrgIds": [
                  "ISA.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote anakusanya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "jeshi kwa ajili ya vita.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanakuja kutoka nchi za mbali sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "kutoka miisho ya mbingu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.13.5",
                "verseOrgIds": [
                  "ISA.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "na silaha za ghadhabu yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "kuangamiza nchi yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ombolezeni, kwa maana siku ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.13.6",
                "verseOrgIds": [
                  "ISA.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "i karibu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:6"
      },
      "items": [
        {
          "text": "itakuja kama uharibifu kutoka kwa Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu ya hili, mikono yote italegea,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:7"
      },
      "items": [
        {
          "text": "moyo wa kila mtu utayeyuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hofu itawakamata,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "uchungu na maumivu makali yatawashika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "watagaagaa kama mwanamke aliye na utungu wa kuzaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "Watatazamana kwa hofu kila mtu na mwenzake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "nyuso zao zikiwaka kama moto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazameni, siku ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.13.9",
                "verseOrgIds": [
                  "ISA.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "inakuja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "siku katili, yenye ghadhabu na hasira kali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "kuifanya nchi kuwa ukiwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "na kuwaangamiza wenye dhambi waliomo ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyota za mbinguni na makundi ya nyota",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "havitatoa mwanga wake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "Jua linalochomoza litatiwa giza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "na mwezi hautatoa nuru yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitauadhibu ulimwengu kwa ajili ya uovu wake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "waovu kwa ajili ya dhambi zao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "Nitakomesha majivuno ya wenye kiburi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
