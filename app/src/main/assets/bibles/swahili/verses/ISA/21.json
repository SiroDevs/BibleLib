      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unabii Dhidi Ya Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno kuhusu Jangwa kando ya Bahari:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "Kama upepo wa kisulisuli unaopita katika nchi hadi kusini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "mshambuliaji anakuja kutoka jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "kutoka nchi inayotisha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimeonyeshwa maono ya kutisha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Msaliti anasaliti, mteka nyara anateka nyara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Elamu, shambulia! Umedi, izunguke kwa jeshi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Nitakomesha huzuni zote alizosababisha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika hili mwili wangu umeteswa na maumivu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "maumivu makali ya ghafula yamenishika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "kama yale ya mwanamke mwenye utungu wa kuzaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "Nimeduwazwa na lile ninalolisikia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "nimeshangazwa na lile ninaloliona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wangu unababaika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "woga unanifanya nitetemeke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "gizagiza la jioni nililolitamani sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "limekuwa hofu kuu kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanaandaa meza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "wanatandaza mazulia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "wanakula, wanakunywa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "Amkeni, enyi maafisa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "zitieni ngao mafuta!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hili ndilo Bwana analoniambia:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "\"Nenda, weka mlinzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "na atoe taarifa ya kile anachokiona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapoona magari ya vita",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "pamoja na kundi la farasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "wapanda punda au wapanda ngamia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "na awe macho, awe macho kikamilifu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mlinzi alipaza sauti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "\"Mchana baada ya mchana, bwana wangu, ninasimama katika mnara wa ulinzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "kila usiku ninakaa mahali pangu nilipoamriwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, yuaja mtu anayepanda gari la vita",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "pamoja na kundi la farasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Naye anajibu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "'Babeli umeanguka, umeanguka!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Vinyago vyote vya miungu yake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "vimelala chini vikiwa vimevunjwa!' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee watu wangu, mliopondwa kwenye sakafu ya kupuria,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:10"
      },
      "items": [
        {
          "text": "ninawaambia kile nilichokisikia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:10"
      },
      "items": [
        {
          "text": "kutoka kwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.21.10",
                "verseOrgIds": [
                  "ISA.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
