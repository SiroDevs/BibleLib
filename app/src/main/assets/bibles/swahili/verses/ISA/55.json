    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwaliko Kwa Wenye Kiu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Njooni, ninyi nyote wenye kiu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "njooni kwenye maji;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "nanyi ambao hamna fedha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "njooni, nunueni na mle!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "Njooni, nunueni divai na maziwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "bila fedha na bila gharama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nini kutumia fedha kwa kitu ambacho si chakula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "na kutaabikia kitu kisichoshibisha?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "Sikilizeni, nisikilizeni mimi na mle kilicho kizuri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "nazo nafsi zenu zitafurahia utajiri wa unono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegeni sikio mje kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "nisikieni mimi, ili nafsi zenu zipate kuishi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "Nitafanya agano la milele nanyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "pendo la uaminifu nililomwahidi Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, nimemfanya kuwa shahidi wa mataifa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:4"
      },
      "items": [
        {
          "text": "kiongozi na jemadari wa mataifa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika utaita mataifa usiyoyajua,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "nayo mataifa yale yasiyokujua yataharakisha kukujia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "kwa sababu ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.5",
                "verseOrgIds": [
                  "ISA.55.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "yeye Aliye Mtakatifu wa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "kwa maana amekutukuza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtafuteni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.6",
                "verseOrgIds": [
                  "ISA.55.6"
                ]
              }
            }
          ]
        },
        {
          "text": "maadamu anapatikana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:6"
      },
      "items": [
        {
          "text": "mwiteni maadamu yu karibu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu mwovu na aiache njia yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "na mtu mbaya na ayaache mawazo yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "Yeye na amrudie",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.7",
                "verseOrgIds": [
                  "ISA.55.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye atamrehemu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "arudi kwa Mungu wetu, kwa kuwa atamsamehe bure kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa kuwa mawazo yangu si mawazo yenu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "wala njia zenu si njia zangu,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "asema",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama vile mbingu zilivyo juu kuliko dunia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "ndivyo njia zangu zilivyo juu kuliko njia zenu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "na mawazo yangu kuliko mawazo yenu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile mvua na theluji",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "ishukavyo kutoka mbinguni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "nayo hairudi tena huko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "bila kunywesha dunia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "na kuichipusha na kuistawisha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
