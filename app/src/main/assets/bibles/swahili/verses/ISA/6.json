{
  "id": "ISA.6",
  "number": "6",
  "bookId": "ISA",
  "reference": "Isaya 6",
  "copyright": "Biblica® Toleo Wazi la Neno: Biblia Takatifu™ Hakimiliki © 1984, 1989, 2009, 2015 na Biblica, Inc. Biblica® Open Kiswahili Contemporary Version™ Copyright © 1984, 1989, 2009, 2015 by Biblica, Inc. \"Biblica\" ni alama ya biashara iliyosajiliwa katika Ofisi ya Hataza na Alama za Biashara Marekani (United States Patent and Trademark Office) na shirika la Biblica, Inc. Imetumiwa na ruhusa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ISA 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agizo Kwa Isaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka ule Mfalme Uzia alikufa, nilimwona Bwana ameketi katika kiti cha enzi, kilicho juu na kilichotukuzwa sana, nalo pindo la joho lake likajaza Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juu yake walikuwepo maserafi, kila mmoja alikuwa na mabawa sita: Kwa mabawa mawili walifunika nyuso zao, kwa mengine mawili walifunika miguu yao, na kwa mawili walikuwa wakiruka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao walikuwa wakiitana kila mmoja na mwenzake:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:3"
      },
      "items": [
        {
          "text": "\"Mtakatifu, Mtakatifu, Mtakatifu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:3"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.6.3",
                "verseOrgIds": [
                  "ISA.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:3"
      },
      "items": [
        {
          "text": "dunia yote imejaa utukufu wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sauti zao, miimo ya milango na vizingiti vilitikisika, nalo Hekalu likajaa moshi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikalia, \"Ole wangu! Nimeangamia! Kwa kuwa mimi ni mtu mwenye midomo michafu, nami ninaishi katikati ya watu wenye midomo michafu, nayo macho yangu yamemwona Mfalme,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.6.5",
                "verseOrgIds": [
                  "ISA.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mmoja wa wale maserafi akaruka kunijia akiwa na kaa la moto linalowaka mkononi mwake, ambalo alikuwa amelichukua kwa koleo kutoka madhabahuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanigusa nalo kinywa changu na kusema, \"Tazama, hili limegusa midomo yako, uovu wako umeondolewa, nayo dhambi yako imesamehewa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikasikia sauti ya Bwana ikisema, \"Nimtume nani? Ni nani atakayekwenda kwa ajili yetu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 6:8"
      },
      "items": [
        {
          "text": "Nami nikasema, \"Mimi hapa. Nitume mimi!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, \"Nenda ukawaambie watu hawa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:9"
      },
      "items": [
        {
          "text": "\" 'Mtaendelea daima kusikiliza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:9"
      },
      "items": [
        {
          "text": "lakini kamwe hamtaelewa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:9"
      },
      "items": [
        {
          "text": "mtaendelea daima kutazama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:9"
      },
      "items": [
        {
          "text": "lakini kamwe hamtatambua.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fanya mioyo ya watu hawa kuwa migumu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:10"
      },
      "items": [
        {
          "text": "fanya masikio yao yasisikie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:10"
      },
      "items": [
        {
          "text": "na upofushe macho yao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:10"
      },
      "items": [
        {
          "text": "Wasije wakaona kwa macho yao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:10"
      },
      "items": [
        {
          "text": "na wakasikiliza kwa masikio yao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:10"
      },
      "items": [
        {
          "text": "wakaelewa kwa mioyo yao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:10"
      },
      "items": [
        {
          "text": "nao wakageuka, nikawaponywa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikasema, \"Hadi lini, Ee Bwana?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 6:11"
      },
      "items": [
        {
          "text": "Naye akanijibu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:11"
      },
      "items": [
        {
          "text": "\"Hadi miji iwe imeachwa magofu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:11"
      },
      "items": [
        {
          "text": "na bila wakazi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:11"
      },
      "items": [
        {
          "text": "hadi nyumba zitakapobaki bila watu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:11"
      },
      "items": [
        {
          "text": "na mashamba yatakapoharibiwa na kuangamizwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hadi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.6.12",
                "verseOrgIds": [
                  "ISA.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "atakapokuwa amekwisha kumpeleka kila mmoja mbali sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:12"
      },
      "items": [
        {
          "text": "na nchi itakapokuwa imeachwa kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata kama sehemu ya kumi ya watu watabaki katika nchi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:13"
      },
      "items": [
        {
          "text": "itaharibiwa tena.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 6:13"
      },
      "items": [
        {
          "text": "Lakini kama vile mvinje na mwaloni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:13"
      },
      "items": [
        {
          "text": "ibakizavyo visiki inapokatwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 6:13"
      },
      "items": [
        {
          "text": "ndivyo mbegu takatifu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
