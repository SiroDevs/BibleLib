            "sid": "ISA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile, wimbo huu utaimbwa katika nchi ya Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Tuna mji ulio na nguvu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Mungu huufanya wokovu kuwa kuta zake na maboma yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fungua malango ili taifa lenye haki lipate kuingia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "taifa lile lidumishalo imani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
