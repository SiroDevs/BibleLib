      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "yeye ambaye moyo wake ni thabiti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
