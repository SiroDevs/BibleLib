      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "na kuutupa chini mavumbini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
