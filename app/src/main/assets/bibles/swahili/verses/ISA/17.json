    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Neno Dhidi Ya Dameski",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno kuhusu Dameski:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:1"
      },
      "items": [
        {
          "text": "\"Tazama, Dameski haitakuwa tena mji",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:1"
      },
      "items": [
        {
          "text": "bali itakuwa lundo la magofu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji ya Aroeri itaachwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:2"
      },
      "items": [
        {
          "text": "na itaachiwa mifugo ambayo italala huko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:2"
      },
      "items": [
        {
          "text": "bila yeyote wa kuyaogopesha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mji wenye ngome utatoweka kutoka Efraimu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "nao uweza wa ufalme kutoka Dameski;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "mabaki ya Aramu yatakuwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "kama utukufu wa Waisraeli,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "asema",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Katika siku ile utukufu wa Yakobo utafifia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:4"
      },
      "items": [
        {
          "text": "unono wa mwili wake utadhoofika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itakuwa kama mvunaji akusanyavyo nafaka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "na kuvuna nafaka kwa mikono yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "kama wakati mtu aokotapo masazo ya masuke",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "katika Bonde la Warefai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo baadhi ya masazo yatabaki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "kama vile mti wa mzeituni unavyopigwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "kukiachwa zeituni mbili au tatu juu ya matawi kileleni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "nne au tano katika matawi yazaayo sana,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "asema",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Mungu wa Israeli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile watu watamwangalia Muumba wao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:7"
      },
      "items": [
        {
          "text": "na kuelekeza macho yao kwa yule Aliye Mtakatifu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawataziangalia tena madhabahu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "kazi za mikono yao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "nao hawataheshimu nguzo za Ashera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "na madhabahu za kufukizia uvumba zilizofanywa kwa mikono yao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile miji yao iliyo imara, ambayo waliihama kwa sababu ya Waisraeli, itakuwa kama mahali palipoachwa pa vichaka na magugu. Nayo yote itakuwa ukiwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmemsahau Mungu Mwokozi wenu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "hamkumkumbuka Mwamba aliye ngome yenu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "Kwa hiyo, hata ingawa mlipandikiza mimea iliyo mizuri sana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "na kuotesha mizabibu ya kigeni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata kama siku ile unapoipandikiza, unaifanya iote",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:11"
      },
      "items": [
        {
          "text": "na asubuhi ile ile unayoipanda, unaifanya ichipue,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:11"
      },
      "items": [
        {
          "text": "hata hivyo mavuno yatakuwa kama si kitu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:11"
      },
      "items": [
        {
          "text": "katika siku ile ya ugonjwa na maumivu yasiyoponyeka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo! Ghadhabu ya mataifa mengi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:12"
      },
      "items": [
        {
          "text": "wanaghadhibika kama bahari iliyochafuka!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:12"
      },
      "items": [
        {
          "text": "Lo! Makelele ya mataifa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
