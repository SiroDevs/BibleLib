      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wokovu Kwa Ajili Ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.27.1",
                "verseOrgIds": [
                  "ISA.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ataadhibu kwa upanga wake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "upanga wake mkali, mkubwa na wenye nguvu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "ataadhibu Lewiathani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "text": "yule nyoka apitaye kwa mwendo laini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "Lewiathani yule nyoka mwenye kujipinda;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:1"
      },
      "items": [
        {
          "text": "atamuua joka huyo mkubwa sana wa baharini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:2"
      },
      "items": [
        {
          "text": "\"Imbeni kuhusu shamba la mizabibu lililozaa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.27.3",
                "verseOrgIds": [
                  "ISA.27.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ninalitunza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:3"
      },
      "items": [
        {
          "text": "nalinyweshea maji mfululizo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:3"
      },
      "items": [
        {
          "text": "Ninalichunga usiku na mchana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:3"
      },
      "items": [
        {
          "text": "ili mtu yeyote asije akalidhuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi sijakasirika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:4"
      },
      "items": [
        {
          "text": "Licha pangekuwepo michongoma na miiba kunikabili!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:4"
      },
      "items": [
        {
          "text": "Ningepambana dhidi yake katika vita,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:4"
      },
      "items": [
        {
          "text": "ningeliichoma moto yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au niwaache waje kwangu kwa ajili ya kupata kimbilio,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:5"
      },
      "items": [
        {
          "text": "wao na wafanye amani nami,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:5"
      },
      "items": [
        {
          "text": "naam, wafanye amani nami.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku zijazo, Yakobo atatia mizizi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:6"
      },
      "items": [
        {
          "text": "Israeli atatoa chipukizi na kuchanua maua,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:6"
      },
      "items": [
        {
          "text": "naye atajaza ulimwengu wote kwa matunda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.27.7",
                "verseOrgIds": [
                  "ISA.27.7"
                ]
              }
            }
          ]
        },
        {
          "text": "amempiga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:7"
      },
      "items": [
        {
          "text": "vile alivyowapiga wale waliompiga?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:7"
      },
      "items": [
        {
          "text": "Je, yeye ameuawa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:7"
      },
      "items": [
        {
          "text": "vile walivyouawa wale waliomuua yeye?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa vita na kwa kumfukuza unapingana naye:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:8"
      },
      "items": [
        {
          "text": "kwa mshindo wake mkali anamfukuza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:8"
      },
      "items": [
        {
          "text": "kama siku ile uvumapo upepo wa mashariki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hili, basi, hatia ya Yakobo itafanyiwa upatanisho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "nalo hili litakuwa matunda ya utimilizo wa kuondolewa kwa dhambi yake:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "Wakati atakapoyafanya mawe yote ya madhabahu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "kuwa kama mawe ya chokaa yaliyopondwa vipande vipande,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "hakuna nguzo za Ashera au madhabahu za kufukizia uvumba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:9"
      },
      "items": [
        {
          "text": "zitakazobaki zimesimama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mji ulio na boma umebaki ukiwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:10"
      },
      "items": [
        {
          "text": "makao yaliyotelekezwa, yaliyoachwa kama jangwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 27:10"
      },
      "items": [
        {
          "text": "Huko ndama hulisha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 27:10"
      },
      "items": [
        {
          "text": "huko hujilaza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
