      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "Amenituma kuwaganga waliovunjika moyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
