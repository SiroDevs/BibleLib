      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "kuwatangazia mateka uhuru wao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:1"
      },
      "items": [
