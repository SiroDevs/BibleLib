                "verseId": "ISA.61.1",
                "verseOrgIds": [
                  "ISA.61.1"
                ]
              }
            }
          ]
        },
        {
          "text": "amenitia mafuta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
