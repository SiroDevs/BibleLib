                "verseId": "ISA.61.1",
                "verseOrgIds": [
                  "ISA.61.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenyezi yu juu yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
