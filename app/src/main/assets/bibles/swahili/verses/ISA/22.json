        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unabii Kuhusu Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno kuhusu Bonde la Maono:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "Nini kinachokutaabisha sasa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "kwamba ninyi nyote mmepanda juu ya mapaa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe mji uliojaa ghasia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "ewe mji wa makelele na sherehe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "Watu wenu waliokufa hawakuuawa kwa upanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "wala hawakufa vitani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viongozi wako wote wamekimbia pamoja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "wamekamatwa bila kutumia upinde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "Ninyi nyote mliokamatwa mlichukuliwa wafungwa pamoja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "mlikimbia wakati adui alipokuwa bado mbali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo nilisema, \"Geukia mbali nami,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "niache nilie kwa uchungu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "Usijaribu kunifariji",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "juu ya maangamizi ya watu wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.5",
                "verseOrgIds": [
                  "ISA.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote, anayo siku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "ya ghasia, ya kukanyaga, na ya kuogofya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "katika Bonde la Maono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "siku ya kuangusha kuta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "na ya kupiga kelele mpaka milimani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elamu analichukua podo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "pamoja na waendesha magari ya vita na farasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "Kiri anaifungua ngao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabonde yako yaliyo mazuri sana yamejaa magari ya vita,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:7"
      },
      "items": [
        {
          "text": "nao wapanda farasi wamewekwa kwenye malango ya mji;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ulinzi wa Yuda umeondolewa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 22:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "Nawe ulitazama siku ile",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "silaha katika Jumba la Kifalme la Mwituni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mkaona kuwa Mji wa Daudi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "una matundu mengi katika ulinzi wake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "mkaweka akiba ya maji",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "kwenye Bwawa la Chini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlihesabu majengo katika Yerusalemu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:10"
      },
      "items": [
        {
          "text": "nanyi mkabomoa nyumba ili kuimarisha ukuta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlijenga bwawa la maji katikati ya kuta mbili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "kwa ajili ya maji ya Bwawa la Zamani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "lakini hamkumtazama Yule aliyelitengeneza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "au kuwa na heshima kwa Yule aliyeubuni tangu zamani za kale.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.12",
                "verseOrgIds": [
                  "ISA.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote,",
          "type": "text",
          "attrs": {
