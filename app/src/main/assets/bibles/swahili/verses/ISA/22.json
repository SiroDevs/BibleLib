      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "Mnasema, \"Tuleni na kunywa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
