      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "\"Wewe hukunifinyanga mimi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
