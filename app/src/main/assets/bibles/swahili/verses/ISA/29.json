                "verseOrgIds": [
                  "ISA.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", aliyemkomboa Abrahamu, analosema kwa nyumba ya Yakobo:",
          "type": "text",
          "attrs": {
