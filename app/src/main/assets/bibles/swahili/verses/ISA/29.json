      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "Je, chungu kinaweza kumwambia mfinyanzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
