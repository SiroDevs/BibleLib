                "verseOrgIds": [
                  "ISA.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "amenipa. Sisi ni ishara na mfano wake katika Israeli, kutoka kwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
