    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ashuru, Chombo Cha",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.1",
                "verseOrgIds": [
                  "ISA.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akaniambia, \"Chukua gombo kubwa, uandike juu yake kwa kalamu ya kawaida jina: Maher-Shalal-Hash-Bazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitawaita kuhani Uria, na Zekaria mwana wa Yeberekia kama mashahidi wangu waaminifu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikaenda kwa nabii mke, naye akapata mimba, akazaa mwana. Kisha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.3",
                "verseOrgIds": [
                  "ISA.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akaniambia, \"Mwite huyo mtoto Maher-Shalal-Hash-Bazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabla mtoto hajaweza kusema 'Baba yangu' au 'Mama yangu,' utajiri wa Dameski na nyara za Samaria zitachukuliwa na mfalme wa Ashuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.5",
                "verseOrgIds": [
                  "ISA.8.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akasema nami tena:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.5",
            "verseOrgIds": [
              "ISA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa sababu watu hawa wamekataa maji ya Shilo yatiririkayo taratibu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "wakamfurahia Resini na mwana wa Remalia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa hiyo Bwana yu karibu kuleta dhidi yao",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "mafuriko makubwa ya Mto:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "yaani mfalme wa Ashuru na fahari yake yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "Yatafurika juu ya mifereji yake yote,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "yatamwagikia juu ya kingo zake zote,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kufika hadi Yuda, yakizunguka kwa kasi juu yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "yakipita katikati na yakifika hadi shingoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "Mabawa yake yaliyokunjuliwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "yatafunika upana wa nchi yako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "Ee Imanueli!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inueni kilio cha vita, enyi mataifa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "na mkavunjwevunjwe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Sikilizeni, enyi nyote nchi za mbali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Jiandaeni kwa vita, nanyi mkavunjwevunjwe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Jiandaeni kwa vita, nanyi mkavunjwevunjwe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wekeni mikakati yenu, lakini itashindwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "fanyeni mipango yenu, lakini haitafanikiwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "kwa maana Mungu yu pamoja nasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwogope Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.11",
                "verseOrgIds": [
                  "ISA.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "alisema nami mkono wake wenye nguvu ukiwa juu yangu, akinionya nisifuate njia za taifa hili. Akasema:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usiite fitina kila kitu ambacho watu hawa hukiita fitina,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "usiogope kile wanachokiogopa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "wala usikihofu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.13",
                "verseOrgIds": [
                  "ISA.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote ndiye peke yake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "ikupasaye kumheshimu kuwa mtakatifu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "ndiye peke yake utakayemwogopa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "ndiye peke yake utakayemhofu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye atakuwa mahali patakatifu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
