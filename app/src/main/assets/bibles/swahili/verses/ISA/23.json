              "attrs": {
                "verseId": "ISA.23.17",
                "verseOrgIds": [
                  "ISA.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "atashughulika na Tiro. Naye atarudia ajira yake ya ukahaba, na atafanya biashara yake na falme zote juu ya uso wa dunia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
