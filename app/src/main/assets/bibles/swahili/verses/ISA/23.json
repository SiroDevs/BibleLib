          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Twaa kinubi, tembea mjini kote,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:16"
      },
      "items": [
        {
          "text": "ewe kahaba uliyesahauliwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
