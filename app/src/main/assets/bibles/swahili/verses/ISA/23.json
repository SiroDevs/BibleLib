      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:16"
      },
      "items": [
        {
          "text": "piga kinubi vizuri, imba nyimbo nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
