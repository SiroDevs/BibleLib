      "attrs": {
        "style": "q2",
        "vid": "ISA 23:14"
      },
      "items": [
        {
          "text": "ngome yenu imeangamizwa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.14",
            "verseOrgIds": [
              "ISA.23.14"
            ]
          }
        }
      ]
