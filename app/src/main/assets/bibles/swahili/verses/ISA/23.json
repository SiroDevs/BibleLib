    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unabii Kuhusu Tiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neno kuhusu Tiro:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Ombolezeni, enyi meli za Tarshishi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Kwa kuwa Tiro imeangamizwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "imeachwa bila nyumba wala bandari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Kuanzia nchi ya Kitimu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "neno limewajia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamazeni kimya, enyi watu wa kisiwani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "pia ninyi wafanyabiashara wa Sidoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "ambao mabaharia wamewatajirisha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenye maji makuu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "nafaka za Shihori zilikuja;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "mavuno ya Naili yalikuwa mapato ya Tiro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "naye akawa soko la mataifa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uaibishwe ee Sidoni, nawe ee ngome la bahari,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "kwa kuwa bahari imesema:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "\"Sijapata kuwa na uchungu wa kuzaa wala sijapata kuzaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "wala sijapata kulea wana wala kutunza mabinti.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habari ifikapo Misri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:5"
      },
      "items": [
        {
          "text": "watakuwa katika maumivu makuu kwa ajili ya taarifa kutoka Tiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vukeni mpaka Tarshishi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:6"
      },
      "items": [
        {
          "text": "ombolezeni, enyi watu wa kisiwani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, huu ndio mji wenu uliojaa sherehe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "mji wa zamani, zamani kabisa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "ambao miguu yake imeuchukua",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "kufanya makao nchi za mbali sana?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani amepanga hili dhidi ya Tiro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "mji utoao mataji,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "ambao wafanyabiashara wake ni wana wa mfalme",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "na wachuuzi wake ni watu mashuhuri wa dunia?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.9",
                "verseOrgIds": [
                  "ISA.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote ndiye alipanga jambo hili,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "ili kukishusha kiburi cha utukufu wote",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "na kuwanyenyekesha wale wote",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "ambao ni mashuhuri duniani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Binti Tarshishi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "pita katika nchi yako kama vile Mto Naili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "kwa kuwa huna tena bandari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.11",
                "verseOrgIds": [
                  "ISA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "amenyoosha mkono wake juu ya bahari",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "na kuzifanya falme zake zitetemeke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "Ametoa amri kuhusu Kanaani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "kwamba ngome zake ziangamizwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
