              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwishoni mwa miaka sabini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
