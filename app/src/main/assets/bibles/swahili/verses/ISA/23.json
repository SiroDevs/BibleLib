      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "\"Simama, vuka uende Kitimu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
