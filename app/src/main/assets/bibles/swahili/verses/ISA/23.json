      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "Wamesimamisha minara yao ya vita kuuzunguka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
