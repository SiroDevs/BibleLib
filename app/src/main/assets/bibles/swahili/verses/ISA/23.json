      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "hata huko hutapata pumziko.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
