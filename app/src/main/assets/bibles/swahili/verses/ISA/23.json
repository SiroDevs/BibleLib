          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo Tiro utasahauliwa kwa miaka sabini, muda wa maisha ya mfalme. Lakini mwisho wa miaka hiyo sabini, itakuwa kwa Tiro kama ilivyo katika wimbo wa kahaba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
