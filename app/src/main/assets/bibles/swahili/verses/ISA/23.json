      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "watu hawa ambao sasa hawaonekani kama wapo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "Waashuru wameifanya nchi hiyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "kuwa mahali pa viumbe wa jangwani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
