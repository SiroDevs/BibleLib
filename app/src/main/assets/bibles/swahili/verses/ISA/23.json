      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "ee Bikira Binti Sidoni, sasa umepondwa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
