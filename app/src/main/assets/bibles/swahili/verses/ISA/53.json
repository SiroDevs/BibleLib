            "sid": "ISA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani aliyeamini ujumbe wetu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:1"
      },
      "items": [
        {
          "text": "na mkono wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.1",
                "verseOrgIds": [
                  "ISA.53.1"
                ]
              }
            }
          ]
        },
        {
          "text": "umefunuliwa kwa nani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikua mbele yake kama mche mwororo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "na kama mzizi katika nchi kavu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "Hakuwa na uzuri wala utukufu wa kutuvutia kwake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "hakuwa na chochote katika sura yake cha kutufanya tumtamani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alidharauliwa na kukataliwa na wanadamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "mtu wa huzuni nyingi, ajuaye mateso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "Kama mtu ambaye watu humficha nyuso zao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "alidharauliwa, wala hatukumhesabu kuwa kitu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika alichukua udhaifu wetu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "na akajitwika huzuni zetu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "hata hivyo tulidhania kuwa amepigwa na Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "akapigwa sana naye, na kuteswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini alitobolewa kwa ajili ya makosa yetu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "alichubuliwa kwa ajili ya maovu yetu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "adhabu iliyotuletea sisi amani ilikuwa juu yake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "na kwa majeraha yake sisi tumepona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisi sote, kama kondoo, tumepotea,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "kila mmoja wetu amegeukia njia yake mwenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "naye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
