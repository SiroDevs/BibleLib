    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "kama vile kondoo anyamazavyo mbele ya wao wamkataye manyoya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
