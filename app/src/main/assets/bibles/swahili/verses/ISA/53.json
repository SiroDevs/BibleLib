                "verseId": "ISA.53.6",
                "verseOrgIds": [
                  "ISA.53.6"
                ]
              }
            }
          ]
        },
        {
          "text": "aliweka juu yake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "maovu yetu sisi sote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
