      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "hata hivyo hakufungua kinywa chake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
