      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "na kuvaa nguo zetu wenyewe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
