      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "ila wewe uturuhusu tu tuitwe kwa jina lako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
