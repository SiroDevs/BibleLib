          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku ile Tawi la",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.2",
                "verseOrgIds": [
                  "ISA.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "litakuwa zuri na lenye utukufu, nalo tunda la nchi litakuwa fahari na utukufu wa wale Waisraeli watakaonusurika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale watakaoachwa Sayuni, watakaobaki Yerusalemu, wataitwa watakatifu, wale wote ambao wameorodheshwa miongoni mwa walio hai huko Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana atausafisha uchafu wa wanawake wa Sayuni, atatakasa madoa ya damu kutoka Yerusalemu kwa Roho ya hukumu na Roho ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.4.5",
                "verseOrgIds": [
                  "ISA.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ataumba juu ya Mlima wote wa Sayuni, na juu ya wale wote wanaokusanyika hapo, wingu la moshi wakati wa mchana, na kungʼaa kwa miali ya moto wakati wa usiku, nako juu ya huo utukufu wote kutatanda kifuniko cha ulinzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utakuwa sitara na kivuli kutokana na joto la mchana, na kuwa mahali pa kujificha kutokana na dhoruba na mvua.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    }
