            "number": "1",
            "style": "v",
            "sid": "ISA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.24.1",
                "verseOrgIds": [
                  "ISA.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ataifanya dunia kuwa ukiwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "na kuiharibu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "naye atauharibu uso wake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "na kutawanya wakaao ndani yake:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndivyo itakavyokuwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "kwa makuhani na kwa watu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "kwa bwana na kwa mtumishi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "kwa bibi na kwa mtumishi wake wa kike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "kwa muuzaji na kwa mnunuzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "kwa mkopaji na kwa mkopeshaji,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "kwa mdaiwa na kwa mdai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunia itaharibiwa kabisa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:3"
      },
      "items": [
        {
          "text": "na kutekwa nyara kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 24:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text"
            }
          ]
        },
        {
          "text": "amesema neno hili.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunia inakauka na kunyauka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "dunia inanyongʼonyea na kunyauka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "waliotukuzwa wa dunia wananyongʼonyea.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunia imetiwa unajisi na watu wake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "wameacha kutii sheria,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "wamevunja amri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "na kuvunja agano la milele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo laana inaiteketeza dunia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "watu wake lazima waichukue hatia yao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "Kwa hiyo wakazi wa dunia wameteketezwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "nao waliosalia ni wachache sana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Divai mpya inakauka na mzabibu unanyauka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:7"
      },
      "items": [
        {
          "text": "watu wote wafurahishao wanalia kwa huzuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Furaha ya matoazi imekoma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "kelele za wenye furaha zimekoma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "shangwe za kinubi zimenyamaza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawanywi tena mvinyo pamoja na wimbo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:9"
      },
      "items": [
        {
          "text": "kileo ni kichungu kwa wanywaji wake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mji ulioharibiwa umekuwa ukiwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:10"
      },
      "items": [
        {
          "text": "mlango wa kila nyumba umefungwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabarani wanalilia kupata mvinyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "furaha yote imegeuka kuwa majonzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "furaha yote imefukuziwa mbali na dunia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mji umeachwa katika uharibifu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:12"
      },
      "items": [
        {
          "text": "lango lake limevunjwa vipande.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndivyo itakavyokuwa duniani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
