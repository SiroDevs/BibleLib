  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "ISA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miungu Ya Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beli anasujudu hadi nchi, Nebo anainama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "sanamu zao zabebwa na wanyama wa mizigo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "Vinyago hivi mnavyobeba kila mahali ni mzigo wa kulemea,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "mzigo kwa waliochoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vinyago pamoja na wale wanaovibeba wanainama chini;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "hiyo miungu haiwezi kuwaokoa watu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "wote wanakwenda utumwani pamoja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nisikilizeni mimi, ee nyumba ya Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "ninyi nyote mliobaki wa nyumba ya Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "ninyi ambao nimewategemeza tangu mlipotungwa mimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "nami nimewabeba tangu kuzaliwa kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata mpaka wakati wa uzee wenu na mvi, Mimi ndiye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "Mimi ndiye nitakayewasaidia ninyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "Nimewahuluku, nami nitawabeba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "nitawasaidia ninyi na kuwaokoa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mtanilinganisha na nani, au mtanihesabu kuwa sawa na nani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:5"
      },
      "items": [
        {
          "text": "Ni nani mtakayenifananisha naye ili tuweze kulinganishwa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wengine humwaga dhahabu kutoka kwenye mifuko yao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "na kupima fedha kwenye mizani;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "huajiri mfua dhahabu kutengeneza mungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "kisha huisujudia na kuiabudu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huiinua mabegani na kuichukua;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "huiweka mahali pake, papo hapo ndipo isimamapo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Wala haiwezi kusogea kutoka mahali pale.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Ingawa mtu huililia, haimjibu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "haiwezi kumwokoa kwenye taabu zake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kumbukeni hili, litieni akilini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:8"
      },
      "items": [
        {
          "text": "liwekeni moyoni, enyi waasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbukeni mambo yaliyopita, yale ya zamani za kale;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "mimi ndimi Mungu, wala hakuna mwingine;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "mimi ndimi Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "wala hakuna mwingine aliye kama mimi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mimi nitangazaye mwisho tangu mwanzo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "naam, tangu zamani za kale,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "mambo ambayo hayajatendeka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Ninasema: Kusudi langu ndilo litakalosimama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "nami nitatenda mapenzi yangu yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka mashariki ninaita ndege awindaye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "kutoka nchi ya mbali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "mtu atakayetimiza kusudi langu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "Lile ambalo nimelisema, ndilo nitakalolitimiza;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "lile nililolipanga, ndilo nitakalolitenda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
