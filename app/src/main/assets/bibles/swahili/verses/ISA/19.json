            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku hiyo kutakuwepo na njia kuu kutoka Misri hadi Ashuru. Waashuru watakwenda Misri, na Wamisri watakwenda Ashuru. Wamisri na Waashuru wataabudu pamoja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
