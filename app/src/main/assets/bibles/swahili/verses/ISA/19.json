                "verseOrgIds": [
                  "ISA.19.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Mwenye Nguvu Zote katika nchi ya Misri. Watakapomlilia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
