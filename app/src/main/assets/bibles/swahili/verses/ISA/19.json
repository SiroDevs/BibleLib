          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.20",
                "verseOrgIds": [
                  "ISA.19.20"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa sababu ya watesi wao, Mungu atawapelekea mwokozi na mtetezi, naye atawaokoa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
