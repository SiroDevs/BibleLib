              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.22",
                "verseOrgIds": [
                  "ISA.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ataipiga Misri kwa tauni; atawapiga na kuwaponya. Watamgeukia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.22",
                "verseOrgIds": [
                  "ISA.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", naye atayasikia maombi yao na kuwaponya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
