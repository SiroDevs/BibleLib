          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.21",
                "verseOrgIds": [
                  "ISA.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "atajijulisha mwenyewe kwa Wamisri, nao katika siku hiyo watamkubali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.21",
                "verseOrgIds": [
                  "ISA.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wataabudu kwa kumtolea dhabihu na sadaka za nafaka, watamwekea",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.21",
                "verseOrgIds": [
                  "ISA.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "nadhiri na kuzitimiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
