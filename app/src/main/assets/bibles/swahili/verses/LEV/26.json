              "text": "Kumbukumbu 7:12-24",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "DEU.28.1-DEU.28.14"
          },
          "items": [
            {
