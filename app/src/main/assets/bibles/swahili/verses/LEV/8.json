          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.8.29",
                "verseOrgIds": [
                  "LEV.8.29"
                ]
              }
            }
          ]
        },
        {
          "text": "alivyomwagiza Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        }
