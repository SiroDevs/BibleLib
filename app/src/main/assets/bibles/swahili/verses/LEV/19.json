    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sheria Mbalimbali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.1",
                "verseOrgIds": [
                  "LEV.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akamwambia Mose,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.1",
            "verseOrgIds": [
              "LEV.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sema na kusanyiko lote la Israeli na uwaambie: 'Kuweni watakatifu, kwa kuwa mimi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.2",
                "verseOrgIds": [
                  "LEV.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu, ni mtakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kila mmoja wenu ni lazima amheshimu mama yake na baba yake, na pia ni lazima kuzishika Sabato zangu. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.3",
                "verseOrgIds": [
                  "LEV.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Msiabudu sanamu, wala msijitengenezee miungu ya shaba. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.4",
                "verseOrgIds": [
                  "LEV.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mnapotoa dhabihu ya sadaka ya amani kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.5",
                "verseOrgIds": [
                  "LEV.19.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", toeni kwa namna ambayo itakubaliwa kwa niaba yenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadaka hiyo italiwa siku iyo hiyo mnayoitoa, au kesho yake; chochote kitakachobaki hadi siku ya tatu lazima kiteketezwe kwa moto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.6",
            "verseOrgIds": [
              "LEV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama sehemu yoyote ya sadaka hiyo italiwa siku ya tatu, itakuwa si safi, nayo haitakubaliwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.7",
            "verseOrgIds": [
              "LEV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyote atakayekula atawajibishwa, kwa sababu amenajisi kitu kilicho kitakatifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.8",
                "verseOrgIds": [
                  "LEV.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "; mtu huyo lazima akatiliwe mbali na watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Wakati uvunapo mavuno ya nchi yako, usivune hadi kwenye mipaka ya shamba lako, wala usikusanye mabaki ya mavuno yako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.9",
            "verseOrgIds": [
              "LEV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usirudi mara ya pili katika shamba lako la mizabibu, wala usiokote zabibu zilizoanguka chini. Ziache kwa ajili ya maskini na mgeni. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.10",
                "verseOrgIds": [
                  "LEV.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usiibe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:11"
      },
      "items": [
        {
          "text": "\" 'Usiseme uongo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:11"
      },
      "items": [
        {
          "text": "\" 'Msidanganyane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usiape kwa uongo kwa Jina langu, na hivyo kulinajisi jina la Mungu wako. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.12",
                "verseOrgIds": [
                  "LEV.19.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usimdhulumu wala kumwibia jirani yako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:13"
      },
      "items": [
        {
          "text": "\" 'Usishikilie mshahara wa kibarua usiku kucha hadi asubuhi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usimlaani kiziwi, wala usiweke kikwazo mbele ya kipofu, lakini umche Mungu wako. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.14",
                "verseOrgIds": [
                  "LEV.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usipotoshe haki; usionyeshe kumpendelea maskini, wala upendeleo kwa mwenye cheo, bali mwamulie jirani yako kwa haki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usieneze uchochezi miongoni mwa watu wako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:16"
      },
      "items": [
        {
          "text": "\" 'Usifanye kitu chochote kile kinachohatarisha maisha ya jirani yako. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.16",
                "verseOrgIds": [
                  "LEV.19.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usimchukie ndugu yako moyoni mwako. Karipia jirani yako kwa uwazi ili usishiriki hatia yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usijilipizie kisasi wala kuwa na kinyongo dhidi ya mmoja wa jamaa yako, lakini mpende jirani yako kama unavyojipenda wewe mwenyewe. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.18",
                "verseOrgIds": [
                  "LEV.19.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mtazishika amri zangu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\" 'Usiwaache wanyama wako wa kufugwa wakazaana na wengine wa aina tofauti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\" 'Usipande mbegu za aina mbili katika shamba lako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\" 'Usivae nguo iliyofumwa kwa nyuzi za aina mbili tofauti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kama mwanaume anakutana kimwili na mwanamke ambaye ni msichana mtumwa aliyeposwa na mwanaume mwingine, lakini ambaye hajakombolewa wala hajapewa uhuru, lazima iwepo adhabu inayofaa. Hata hivyo hawatauawa, kwa sababu msichana alikuwa bado hajaachwa huru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.20",
            "verseOrgIds": [
              "LEV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini huyo mtu lazima alete kondoo dume kwenye ingilio la Hema la Kukutania kwa ajili ya sadaka ya hatia kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.21",
                "verseOrgIds": [
                  "LEV.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupitia kwa huyo kondoo dume wa sadaka ya hatia, kuhani atafanya upatanisho kwa ajili yake mbele za",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.22",
                "verseOrgIds": [
                  "LEV.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa ajili ya dhambi aliyotenda, naye atasamehewa dhambi yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mtakapoingia katika hiyo nchi na kupanda aina yoyote ya mti wa matunda, hesabuni matunda yake kama yaliyokatazwa. Kwa miaka mitatu mtayahesabu kwamba yamekatazwa; hayaruhusiwi kuliwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.23",
            "verseOrgIds": [
              "LEV.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa nne matunda yote ya mti huo yatakuwa matakatifu, sadaka ya sifa kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.24",
                "verseOrgIds": [
                  "LEV.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali katika mwaka wa tano mnaweza kula matunda ya mti huo. Kwa njia hii mavuno yenu yataongezewa. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.25",
                "verseOrgIds": [
                  "LEV.19.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Msile nyama yoyote yenye damu ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:26"
      },
      "items": [
        {
          "text": "\" 'Msifanye uaguzi wala uchawi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Msikate nywele za kichwa denge, wala kunyoa pembe za ndevu zenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.27",
            "verseOrgIds": [
              "LEV.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Msichanje chale miili yenu kwa ajili ya mfu, wala msijichore alama juu ya miili yenu. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.28",
                "verseOrgIds": [
                  "LEV.19.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usimdhalilishe binti yako kwa kumfanya kahaba, la sivyo nchi itageukia ukahaba na kujaa uovu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Shika Sabato zangu na kuheshimu mahali pangu patakatifu. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.30",
                "verseOrgIds": [
                  "LEV.19.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Msiende kwa waaguzi, wala msitafute wapunga pepo, kwa maana watawanajisi. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.31",
                "verseOrgIds": [
                  "LEV.19.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Uwapo mbele ya mzee, simama ili kuonyesha heshima kwa wazee, nawe umche Mungu wako. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.32",
                "verseOrgIds": [
                  "LEV.19.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Wakati mgeni anaishi pamoja nawe katika nchi yako, usimnyanyase.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
              "LEV.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgeni anayeishi pamoja nawe ni lazima umtendee kama mmoja wa wazawa wa nchi yako. Mpende kama unavyojipenda mwenyewe, kwa maana ulikuwa mgeni katika nchi ya Misri. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.34",
                "verseOrgIds": [
                  "LEV.19.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Usitumie vipimo vya udanganyifu unapopima urefu, kupima uzito, wala kupima wingi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumia mizani halali, mawe ya kupimia uzito halali, efa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "text": "halali, na hini",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "text": "halali. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.36",
                "verseOrgIds": [
                  "LEV.19.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu wako, ambaye alikutoa katika nchi ya Misri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Shika amri zangu zote na sheria zangu zote, nawe uzifuate. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.37",
                "verseOrgIds": [
                  "LEV.19.37"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        }
      ]
    }
