              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ni lazima uwatenge Waisraeli kutokana na vitu ambavyo vinawafanya najisi, ili wasife katika unajisi wao kwa kunajisi makao yangu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        },
        {
          "text": "ambayo yapo katikati yao.' \"",
          "type": "text",
