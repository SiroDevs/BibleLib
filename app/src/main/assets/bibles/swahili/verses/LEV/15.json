                "verseOrgIds": [
                  "LEV.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa sababu ya unajisi wa kutokwa damu kwake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
