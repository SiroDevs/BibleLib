              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ni masharti kwa ajili ya mtu mwenye kutokwa na usaha, kwa ajili ya yeyote atakayetokwa na shahawa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
