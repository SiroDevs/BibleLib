          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kama akitoa kondoo au mbuzi kutoka kundi kama sadaka ya amani kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.3.6",
                "verseOrgIds": [
                  "LEV.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", atamtoa dume au jike asiye na dosari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama akimtoa mwana-kondoo, atamleta mbele za",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.3.7",
                "verseOrgIds": [
                  "LEV.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataweka mkono wake juu ya kichwa cha sadaka yake, naye atamchinja mbele ya Hema la Kukutania. Kisha wana wa Aroni watanyunyiza damu yake kwenye madhabahu pande zote.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka kwenye hiyo sadaka ya amani ataleta dhabihu iliyotolewa kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.3.9",
                "verseOrgIds": [
                  "LEV.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa moto: mafuta yake, mafuta yote ya mkia uliokatwa karibu na uti wa mgongo, mafuta yote yanayofunika sehemu za ndani au yale yanayounganika nazo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "figo mbili pamoja na mafuta yanayozizunguka yaliyo karibu na kiuno na yale yanayofunika ini, ambayo atayatoa pamoja na figo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani ataviteketeza juu ya madhabahu kama chakula, sadaka iliyotolewa kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.3.11",
                "verseOrgIds": [
                  "LEV.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa moto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
