          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Hii ni kanuni ya kudumu kwa vizazi vijavyo, popote muishipo: Msile mafuta yoyote ya mnyama wala damu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.17",
            "verseOrgIds": [
