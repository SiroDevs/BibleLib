          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kama sadaka yake ni mbuzi, ataileta mbele za",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
