                "verseOrgIds": [
                  "LEV.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", nalo litateketezwa kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila sadaka ya nafaka ya kuhani itateketezwa kabisa; kamwe haitaliwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
