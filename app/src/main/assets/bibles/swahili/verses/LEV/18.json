          ]
        },
        {
          "text": "\" 'Kila mtu atakayefanya mojawapo ya machukizo haya, watu hao ni lazima wakatiliwe mbali na watu wao.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
