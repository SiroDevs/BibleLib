          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa mambo haya yote yalifanywa na watu walioishi katika nchi hii kabla yenu, na nchi ikawa najisi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
