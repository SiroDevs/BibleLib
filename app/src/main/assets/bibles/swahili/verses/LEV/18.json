              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ni lazima uzitunze amri zangu na sheria zangu. Mzawa na wageni waishio miongoni mwenu kamwe wasifanye mambo yoyote ya machukizo haya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
