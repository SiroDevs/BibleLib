              "attrs": {
                "verseId": "LEV.7.30",
                "verseOrgIds": [
                  "LEV.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": "kuwa sadaka ya kuinuliwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani atayateketeza hayo mafuta juu ya madhabahu, lakini kidari kitakuwa cha Aroni na wanawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja la kulia la sadaka zako za amani utampa kuhani kama matoleo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
