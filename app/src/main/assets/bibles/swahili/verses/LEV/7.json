          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa Aroni atoaye damu na mafuta ya sadaka ya amani ndiye atakayepewa paja hilo la kulia kuwa fungu lake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka kwenye sadaka za amani za Waisraeli, mimi Mungu nimepokea kidari kile kilichoinuliwa pamoja na lile paja lililotolewa, nami nimevitoa kwa kuhani Aroni na wanawe kuwa fungu lao la kawaida kutoka kwa Waisraeli.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        }
      ]
