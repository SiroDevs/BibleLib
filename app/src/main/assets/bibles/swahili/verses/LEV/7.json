              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waambie Waisraeli: 'Mtu yeyote aletaye sadaka ya amani kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
