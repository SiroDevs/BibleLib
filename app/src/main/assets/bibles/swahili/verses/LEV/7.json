                "verseOrgIds": [
                  "LEV.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ataleta sehemu ya sadaka hiyo kama dhabihu yake kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
