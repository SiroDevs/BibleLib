          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiwa mtu yeyote atakunywa damu, mtu huyo lazima akatiliwe mbali na watu wake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
