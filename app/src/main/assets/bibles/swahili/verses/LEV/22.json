            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wakati ndama, mwana-kondoo au mwana-mbuzi azaliwapo, atabaki na mama yake kwa siku saba. Kuanzia siku ya nane na kuendelea anaweza kukubaliwa kuwa sadaka iliyotolewa kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.27",
                "verseOrgIds": [
                  "LEV.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa kuteketezwa kwa moto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimchinje ngʼombe na ndama wake, au kondoo na kitoto chake siku moja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        }
      ]
