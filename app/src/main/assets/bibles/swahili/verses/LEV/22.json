              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unapomtolea",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
