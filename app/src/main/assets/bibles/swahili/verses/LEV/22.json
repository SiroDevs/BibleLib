                "verseOrgIds": [
                  "LEV.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "dhabihu ya shukrani, itoe kwa namna ambayo itakubalika kwa niaba yako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
