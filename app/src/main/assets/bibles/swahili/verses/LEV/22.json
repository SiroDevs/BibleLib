          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msilinajisi Jina langu takatifu. Lazima nikubalike kuwa mtakatifu kwa Waisraeli. Mimi ndimi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
