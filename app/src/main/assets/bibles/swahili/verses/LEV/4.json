          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha kuhani atachukua sehemu ya ile damu kwa kidole chake na kuitia kwenye pembe za madhabahu ya sadaka ya kuteketezwa na kuimwaga damu iliyobaki chini ya madhabahu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
