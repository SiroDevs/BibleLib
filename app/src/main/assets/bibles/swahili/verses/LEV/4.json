          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atayaondoa mafuta yote, kama vile mafuta yaondolewavyo kwenye sadaka ya amani, naye kuhani atayateketeza juu ya madhabahu kama harufu nzuri ya kumpendeza",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
