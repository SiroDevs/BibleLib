          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atakapofahamishwa dhambi yake aliyoitenda, ni lazima alete mbuzi jike asiye na dosari kama sadaka yake kwa ajili ya dhambi aliyotenda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
