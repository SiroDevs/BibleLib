          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataweka mkono wake juu ya kichwa cha sadaka ya dhambi na kumchinjia mahali pa kuteketezea sadaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
