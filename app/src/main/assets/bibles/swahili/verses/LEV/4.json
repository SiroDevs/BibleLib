          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ikiwa ataleta mwana-kondoo kama sadaka yake ya dhambi, atamleta jike asiye na dosari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
