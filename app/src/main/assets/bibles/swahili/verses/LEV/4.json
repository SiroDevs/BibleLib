              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kama mtu katika jumuiya ametenda dhambi pasipo kukusudia na kufanya lile lililokatazwa katika amri yoyote ya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
