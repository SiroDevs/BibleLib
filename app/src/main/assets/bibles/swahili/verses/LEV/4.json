                "verseId": "LEV.4.31",
                "verseOrgIds": [
                  "LEV.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": ". Kwa njia hii kuhani atafanya upatanisho kwa ajili yake, naye atasamehewa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
