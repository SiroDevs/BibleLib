              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhani ataamua thamani yake hadi Mwaka wa Yubile, naye huyo mtu atalazimika kulipa thamani yake siku hiyo kama kitu kitakatifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
