                "verseOrgIds": [
                  "LEV.27.30"
                ]
              }
            }
          ]
        },
        {
          "text": "; ni takatifu kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
