          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lakini hakuna mtu atakayeweka wakfu mzaliwa wa kwanza wa mnyama, kwa kuwa mzaliwa wa kwanza tayari ni mali ya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
                ]
              }
            }
          ]
        },
        {
          "text": "; awe ngʼombe au kondoo, ni wa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
