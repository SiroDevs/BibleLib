          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mtu yeyote aliyewekwa wakfu ili kuangamizwa, hawezi kukombolewa. Mtu kama huyo lazima auawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
