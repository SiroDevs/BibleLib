          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zaka ya kila kitu kutoka shambani, iwe ni nafaka kutoka kwa ardhi, au tunda kutoka kwa miti, ni mali ya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
