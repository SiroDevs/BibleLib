          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
