                "verseId": "LEV.27.28",
                "verseOrgIds": [
                  "LEV.27.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", iwe ni binadamu, au mnyama, au ardhi ya jamaa, hakiwezi kuuzwa au kukombolewa. Chochote kilichowekwa wakfu ni kitakatifu sana kwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
