  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "REV 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mabakuli Saba Ya Ghadhabu Ya Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikasikia sauti kubwa kutoka mle Hekaluni ikiwaambia wale malaika saba, \"Nendeni, mkayamwage duniani hayo mabakuli saba ya ghadhabu ya Mungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa kwanza akaenda akalimwaga hilo bakuli lake juu ya nchi. Majipu mabaya yenye maumivu makali yakawapata wale watu wote waliokuwa na chapa ya yule mnyama na walioabudu sanamu yake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa pili akalimwaga bakuli lake baharini, nayo ikabadilika kuwa damu kama ya mtu aliyekufa na kila kiumbe hai kilichokuwa ndani ya bahari kikafa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa tatu akalimwaga bakuli lake katika mito na chemchemi za maji, nazo zikawa damu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikamsikia malaika msimamizi wa maji akisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 16:5"
      },
      "items": [
        {
          "text": "\"Wewe una haki katika hukumu hizi ulizotoa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:5"
      },
      "items": [
        {
          "text": "wewe uliyeko, uliyekuwako, Uliye Mtakatifu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:5"
      },
      "items": [
        {
          "text": "kwa sababu umehukumu hivyo;",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa walimwaga damu ya watakatifu wako",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:6"
      },
      "items": [
        {
          "text": "na manabii wako,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 16:6"
      },
      "items": [
        {
          "text": "nawe umewapa damu wanywe",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:6"
      },
      "items": [
        {
          "text": "kama walivyostahili.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikasikia madhabahu ikiitikia,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 16:7"
      },
      "items": [
        {
          "text": "\"Naam,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "REV.16.7",
                "verseOrgIds": [
                  "REV.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu Mwenyezi,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 16:7"
      },
      "items": [
        {
          "text": "hukumu zako ni kweli na haki.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa nne akamimina bakuli lake kwenye jua, nalo likapewa nguvu za kuwaunguza watu kwa moto.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wakaunguzwa na hilo joto kali, wakalaani Jina la Mungu, aliyekuwa na uwezo juu ya mapigo haya, tena wakakataa kutubu na kumtukuza Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa tano akamimina bakuli lake kwenye kiti cha enzi cha yule mnyama, nao ufalme wake ukagubikwa na giza. Watu wakatafuna ndimi zao kwa ajili ya maumivu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamlaani Mungu wa mbinguni kwa sababu ya maumivu na majeraha yao, wala hawakutubu kwa ajili ya matendo yao maovu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa sita akamimina bakuli lake kwenye mto mkubwa Frati, maji yake yakakauka ili kutayarisha njia kwa ajili ya wafalme watokao Mashariki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikaona roho wachafu watatu waliofanana na vyura wakitoka katika kinywa cha lile joka na katika kinywa cha yule mnyama na katika kinywa cha yule nabii wa uongo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hizo ndizo roho za pepo wachafu zitendazo miujiza. Nazo huwaendea wafalme wa ulimwengu wote na kuwakusanya tayari kwa ajili ya vita katika siku ile kuu ya Mungu Mwenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tazama, naja kama mwizi! Amebarikiwa yeye akeshaye na kuziweka tayari nguo zake ili asiende uchi na kuonekana aibu yake.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.16.15",
                "verseOrgIds": [
                  "REV.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wakawakusanya wafalme pamoja mahali paitwapo Armagedoni",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        },
        {
          "text": "kwa Kiebrania.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa saba akamimina bakuli lake angani na sauti kubwa ikatoka mle hekaluni katika kile kiti cha enzi, ikisema, \"Imekwisha kuwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukawa na mianga ya umeme wa radi, ngurumo, radi na tetemeko kubwa la ardhi. Hapajawa kamwe na tetemeko la ardhi kama hilo tangu mwanadamu awepo duniani, hivyo lilikuwa tetemeko kubwa ajabu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.18",
            "verseOrgIds": [
              "REV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ule mji mkubwa ukagawanyika katika sehemu tatu, nayo miji ya mataifa ikaanguka. Mungu akaukumbuka Babeli Mkuu na kumpa kikombe kilichojaa mvinyo wa ghadhabu ya hasira yake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.19",
            "verseOrgIds": [
              "REV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila kisiwa kikatoweka wala milima haikuonekana.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.20",
            "verseOrgIds": [
              "REV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvua kubwa ya mawe yenye uzito wa talanta moja",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.21",
            "verseOrgIds": [
              "REV.16.21"
            ]
          }
        },
        {
          "text": "ikashuka kutoka mbinguni, ikawaangukia wanadamu. Nao wanadamu wakamlaani Mungu kwa ajili ya hayo mapigo ya mvua ya mawe, kwa sababu pigo hilo lilikuwa la kutisha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.21",
            "verseOrgIds": [
              "REV.16.21"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "REV.17",
    "number": "17",
    "bookId": "REV"
  },
