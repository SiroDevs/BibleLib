            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:8"
      },
      "items": [
        {
          "text": "na kutoka kabila la Benyamini 12,000.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umati Mkubwa Wa Watu Kutoka Mataifa Yote",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya hili nikatazama na hapo mbele yangu palikuwa na umati mkubwa wa watu ambao hakuna yeyote awezaye kuuhesabu, kutoka kila taifa, kila kabila, kila jamaa na kila lugha, wamesimama mbele ya kile kiti cha enzi na mbele ya Mwana-Kondoo. Walikuwa wamevaa mavazi meupe na wakiwa wameshika matawi ya mitende mikononi mwao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao walikuwa wakipiga kelele kwa sauti kubwa wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:10"
      },
      "items": [
        {
          "text": "\"Wokovu una Mungu wetu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:10"
      },
      "items": [
        {
          "text": "yeye aketiye kwenye kiti cha enzi,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:10"
      },
      "items": [
        {
          "text": "na Mwana-Kondoo!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wote walikuwa wamesimama kukizunguka kile kiti cha enzi na wale wazee ishirini na wanne na wale viumbe wanne wenye uhai. Wakaanguka kifudifudi mbele ya hicho kiti cha enzi na kumwabudu Mungu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "\"Amen!",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "Sifa na utukufu",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "na hekima na shukrani na heshima",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "na uweza na nguvu",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "viwe kwa Mungu wetu milele na milele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "Amen!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mmoja wa wale wazee ishirini na wanne akaniuliza, \"Ni nani hawa waliovaa mavazi meupe, nao wametoka wapi?\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamjibu, \"Bwana, wewe wajua.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 7:14"
      },
      "items": [
        {
          "text": "Naye akasema, \"Hawa ni wale waliotoka katika ile dhiki kuu, nao wamefua mavazi yao katika damu ya Mwana-Kondoo na kuyafanya meupe kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "\"Wako mbele ya kiti cha enzi cha Mungu",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "na kumtumikia usiku na mchana",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "katika hekalu lake;",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "naye aketiye katika kile kiti cha enzi",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "atatanda hema yake juu yao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
