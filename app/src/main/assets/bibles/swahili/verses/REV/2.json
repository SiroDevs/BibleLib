          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwa Kanisa Lililoko Efeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa malaika wa kanisa lililoko Efeso andika:",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.1",
                "verseOrgIds": [
                  "REV.2.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Haya ndiyo maneno ya yule aliyezishika zile nyota saba katika mkono wake wa kuume na ambaye hutembea kati ya vile vinara saba vya taa vya dhahabu.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.1",
                "verseOrgIds": [
                  "REV.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.1",
            "verseOrgIds": [
              "REV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nayajua matendo yako, bidii yako na saburi yako. Najua kuwa huwezi kuvumiliana na watu waovu na ya kwamba umewajaribu wale wanaojifanya kuwa mitume na kumbe sio, nawe umewatambua kuwa ni waongo.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.2",
                "verseOrgIds": [
                  "REV.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.2",
            "verseOrgIds": [
              "REV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Umevumilia na kustahimili taabu kwa ajili ya Jina langu, wala hukuchoka.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.3",
                "verseOrgIds": [
                  "REV.2.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lakini nina neno dhidi yako: Umeuacha upendo wako wa kwanza.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.4",
                "verseOrgIds": [
                  "REV.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.4",
            "verseOrgIds": [
              "REV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kumbuka basi ni wapi ulikoangukia! Tubu na ukafanye matendo yale ya kwanza. Kama usipotubu, nitakuja kwako na kukiondoa kinara chako cha taa kutoka mahali pake.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.5",
                "verseOrgIds": [
                  "REV.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.5",
            "verseOrgIds": [
              "REV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini una jambo hili kwa upande wako: Unayachukia matendo ya Wanikolai, ambayo nami pia nayachukia.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.6",
                "verseOrgIds": [
                  "REV.2.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeye aliye na sikio na asikie yale ambayo Roho ayaambia makanisa. Yeye ashindaye, nitampa haki ya kula matunda toka kwa mti wa uzima, ambao uko katika paradiso",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.7",
                "verseOrgIds": [
                  "REV.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ya Mungu.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.7",
                "verseOrgIds": [
                  "REV.2.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwa Kanisa Lililoko Smirna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa malaika wa kanisa lililoko Smirna andika:",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.8",
                "verseOrgIds": [
                  "REV.2.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Haya ndiyo maneno yake yeye aliye wa Kwanza na wa Mwisho, aliyekufa kisha akafufuka.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.8",
                "verseOrgIds": [
                  "REV.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naijua dhiki yako na umaskini wako, lakini wewe ni tajiri! Nayajua masingizio ya wale wasemao kuwa ni Wayahudi lakini sio, bali wao ni sinagogi la Shetani.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.9",
                "verseOrgIds": [
                  "REV.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Usiogope mateso yatakayokupata. Nakuambia ibilisi atawatia baadhi yenu gerezani ili kuwajaribu, nanyi mtapata dhiki kwa muda wa siku kumi. Uwe mwaminifu hata kufa, nami nitakupa taji ya uzima.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.10",
                "verseOrgIds": [
                  "REV.2.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeye aliye na sikio na asikie yale ambayo Roho ayaambia makanisa. Yeye ashindaye hatadhuriwa kamwe na mauti ya pili.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.11",
                "verseOrgIds": [
                  "REV.2.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwa Kanisa Lililoko Pergamo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa malaika wa Kanisa lililoko Pergamo andika:",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.12",
                "verseOrgIds": [
                  "REV.2.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Haya ndiyo maneno yake yeye aliye na upanga mkali wenye makali kuwili.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.12",
                "verseOrgIds": [
                  "REV.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ninajua unakoishi, ni kule ambako Shetani ana kiti chake cha enzi. Lakini umelishika Jina langu. Wala hukuikana imani yako kwangu hata katika siku za shahidi wangu mwaminifu Antipa, ambaye aliuawa katika mji mkuu wenu, ambako ndiko anakoishi Shetani.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.13",
                "verseOrgIds": [
                  "REV.2.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hata hivyo, nina mambo machache dhidi yako: Unao watu wafuatao mafundisho ya Balaamu, yule aliyemfundisha Balaki kuwashawishi Waisraeli watende dhambi kwa kula vitu vilivyotolewa kafara kwa sanamu na kufanya uasherati.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.14",
                "verseOrgIds": [
                  "REV.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Vivyo hivyo unao wale wayashikayo mafundisho ya Wanikolai.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.15",
                "verseOrgIds": [
                  "REV.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Basi tubu! Ama sivyo, nitakuja kwako upesi na kupigana na watu hao kwa upanga wa kinywa changu.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.16",
                "verseOrgIds": [
                  "REV.2.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeye aliye na sikio na asikie yale ambayo Roho ayaambia makanisa. Yeye ashindaye nitampa baadhi ya ile mana iliyofichwa. Nitampa pia jiwe jeupe ambalo juu yake limeandikwa jina jipya asilolijua mtu, isipokuwa yule anayelipokea.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.17",
                "verseOrgIds": [
                  "REV.2.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwa Kanisa Lililoko Thiatira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwa malaika wa kanisa lililoko Thiatira andika:",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.18",
                "verseOrgIds": [
                  "REV.2.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:18"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Haya ndiyo maneno ya Mwana wa Mungu, ambaye macho yake ni kama mwali wa moto na ambaye miguu yake ni kama shaba iliyosuguliwa sana.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.18",
                "verseOrgIds": [
                  "REV.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nayajua matendo yako, upendo wako na imani yako, huduma na saburi yako na kwamba matendo yako ya sasa yamezidi yale ya kwanza.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.19",
                "verseOrgIds": [
                  "REV.2.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hata hivyo, nina neno dhidi yako: Unamvumilia yule mwanamke Yezebeli ambaye anajiita nabii, lakini anawafundisha na kuwapotosha watumishi wangu ili wafanye uasherati na kula vyakula vilivyotolewa kafara kwa sanamu.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.20",
                "verseOrgIds": [
                  "REV.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimempa muda ili atubu kwa ajili ya uasherati wake, lakini hataki.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.21",
                "verseOrgIds": [
                  "REV.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kwa hiyo nitamtupa kwenye kitanda cha mateso, na nitawafanya hao wanaozini naye kupata mateso makali wasipotubia njia zake.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.22",
                "verseOrgIds": [
                  "REV.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "REV 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nami nitawaua watoto wake. Nayo makanisa yote yatajua kwamba Mimi ndiye nichunguzaye mioyo na nia, na kwamba nitamlipa kila mmoja wenu kwa kadiri ya matendo yake.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.23",
                "verseOrgIds": [
                  "REV.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Basi nawaambia ninyi wengine mlioko Thiatira, ninyi ambao hamyafuati mafundisho ya Yezebeli, wala hamkujifunza hayo yanayoitwa mambo ya ndani sana ya Shetani (sitaweka mzigo mwingine wowote juu yenu):",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.24",
                "verseOrgIds": [
                  "REV.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lakini shikeni sana mlicho nacho, mpaka nitakapokuja.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.25",
                "verseOrgIds": [
                  "REV.2.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
