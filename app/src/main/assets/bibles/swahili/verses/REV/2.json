        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Atakayeshinda na kutenda mapenzi yangu mpaka mwisho, nitampa mamlaka juu ya mataifa:",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.26",
                "verseOrgIds": [
                  "REV.2.26"
                ]
              }
            }
