          },
          "items": [
            {
              "text": "atawavunja vipande vipande",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "REV 2:27"
      },
