          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyimbo za wapiga vinubi na waimbaji,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
          }
        }
