            "sid": "REV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha malaika mmoja mwenye nguvu akainua jiwe kubwa kama la kusagia akalitupa baharini akisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:21"
      },
      "items": [
        {
          "text": "\"Hivyo ndivyo mji mkubwa Babeli",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:21"
      },
      "items": [
        {
          "text": "utakavyotupwa chini kwa nguvu",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        }
      ]
    },
    {
