      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "hautaangaza ndani yako tena.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "Sauti ya bwana arusi na bibi arusi",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "kamwe haitasikika ndani yako tena.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
