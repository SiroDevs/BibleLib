      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:22"
      },
      "items": [
        {
          "text": "mwenye ujuzi wa aina yoyote.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
