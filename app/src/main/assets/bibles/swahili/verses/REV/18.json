  "bookId": "REV",
  "reference": "Ufunuo 18",
  "copyright": "Biblica® Toleo Wazi la Neno: Biblia Takatifu™ Hakimiliki © 1984, 1989, 2009, 2015 na Biblica, Inc. Biblica® Open Kiswahili Contemporary Version™ Copyright © 1984, 1989, 2009, 2015 by Biblica, Inc. \"Biblica\" ni alama ya biashara iliyosajiliwa katika Ofisi ya Hataza na Alama za Biashara Marekani (United States Patent and Trademark Office) na shirika la Biblica, Inc. Imetumiwa na ruhusa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "REV 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuanguka Kwa Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya haya nikaona malaika mwingine akishuka kutoka mbinguni, akiwa na mamlaka makuu na dunia ikamulikiwa na mngʼao wake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akalia kwa nguvu kwa sauti kubwa, akisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "\"Umeanguka! Umeanguka Babeli Mkuu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "Umekuwa makao ya mashetani",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "na makazi ya kila pepo mchafu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "makazi ya kila ndege na kila mnyama achukizaye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana mataifa yote yamekunywa",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "mvinyo wa ghadhabu ya uasherati wake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "Nao wafalme wa dunia wamefanya uzinzi nao,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "nao wafanyabiashara wa dunia",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "wametajirika kutokana na wingi wa utajiri wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikasikia sauti nyingine kutoka mbinguni ikisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:4"
      },
      "items": [
        {
          "text": "\"Tokeni katikati yake, enyi watu wangu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:4"
      },
      "items": [
        {
          "text": "ili msije mkashiriki dhambi zake,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:4"
      },
      "items": [
        {
          "text": "ili msije mkapatwa na pigo lake lolote;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa kuwa dhambi zake zimelundikana hadi mbinguni,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.5",
            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:5"
      },
      "items": [
        {
          "text": "naye Mungu ameukumbuka uhalifu wake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.5",
            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtendee kama yeye alivyotenda;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:6"
      },
      "items": [
        {
          "text": "umlipe mara mbili kwa ajili ya yale aliyotenda.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:6"
      },
      "items": [
        {
          "text": "Katika kikombe chake mchanganyie",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:6"
      },
      "items": [
        {
          "text": "mara mbili ya kile alichochanganya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpatie mateso na huzuni nyingi sawa na",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "utukufu na anasa alizojipatia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "Kwa kuwa moyoni mwake hujivuna, akisema,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "'Mimi ninatawala kama malkia;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "mimi si mjane, wala sitaona huzuni kamwe.'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo mapigo yatampata kwa siku moja:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:8"
      },
      "items": [
        {
          "text": "mauti, maombolezo na njaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:8"
      },
      "items": [
        {
          "text": "Naye atateketezwa kwa moto,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:8"
      },
      "items": [
        {
          "text": "kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "REV.18.8",
                "verseOrgIds": [
                  "REV.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu amhukumuye ana nguvu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wafalme wa dunia waliozini naye na kushiriki anasa zake watakapoona moshi wa kuungua kwake, watamlilia na kumwombolezea.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hofu kubwa ya mateso yake, watasimama mbali na kulia na wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:10"
      },
      "items": [
        {
          "text": "\" 'Ole! Ole, ee mji mkubwa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:10"
      },
      "items": [
        {
          "text": "ee Babeli mji wenye nguvu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:10"
      },
      "items": [
        {
          "text": "Hukumu yako imekuja katika saa moja!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wafanyabiashara wa dunia watalia na kumwomboleza kwa sababu hakuna anunuaye bidhaa zao tena:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bidhaa za dhahabu, za fedha, za vito vya thamani na vya lulu, kitani safi, nguo za rangi ya zambarau, hariri, nguo nyekundu, aina zote za miti ya udi, na vifaa vyote vya pembe za ndovu, vifaa vyote vya miti yenye thamani kuliko yote, shaba, chuma na marmar,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bidhaa za mdalasini, vikolezi, za uvumba, manemane, na uvumba wenye harufu nzuri, za divai, na mafuta ya zeituni, za unga mzuri na ngano; ngʼombe na kondoo; farasi na magari; na miili na roho za wanadamu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Watasema, 'Yale matunda ambayo roho yako iliyatamani yamekoma. Utajiri wako wote na fahari yako vimetoweka, wala haviwezi kupatikana tena kamwe!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wale wafanyabiashara waliotajirika kwa bidhaa hizo kutoka kwake watasimama mbali naye kwa hofu kubwa ya mateso yanayompata. Watalia na kuomboleza wakipiga kelele wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.15",
            "verseOrgIds": [
              "REV.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ole! Ole, ee mji mkubwa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "uliyekuwa umevikwa mavazi ya kitani safi,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "ya rangi ya zambarau na nyekundu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "ukimetameta kwa dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "vito vya thamani na lulu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika muda wa saa moja utajiri wote mkubwa",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:17"
      },
      "items": [
        {
          "text": "kama huu umeangamia!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 18:17"
      },
      "items": [
        {
          "text": "\"Kila nahodha, na wote wasafirio kwa meli, na wote wapatao kipato chao kutokana na bahari, watasimama mbali.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watakapouona moshi wa kuungua kwake watalia wakisema, 'Je, kulipata kuwako mji mkubwa kama huu?'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watajirushia mavumbi vichwani mwao, huku wakilia na kuomboleza, wakisema:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "\" 'Ole! Ole, ee mji mkubwa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "mji ambao wote wenye meli baharini",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "walitajirika kupitia kwa mali zake!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "Katika saa moja tu ameangamizwa!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Furahia kwa ajili yake, ee mbingu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:20"
      },
      "items": [
        {
          "text": "Furahini watakatifu, mitume na manabii!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:20"
      },
      "items": [
        {
          "text": "Mungu amemhukumu",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
