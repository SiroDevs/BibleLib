      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:21"
      },
      "items": [
        {
          "text": "wala hautaonekana tena.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
