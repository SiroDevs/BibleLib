      "attrs": {
        "style": "q2",
        "vid": "REV 18:22"
      },
      "items": [
        {
          "text": "wapiga filimbi na wapiga tarumbeta",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
          }
        }
