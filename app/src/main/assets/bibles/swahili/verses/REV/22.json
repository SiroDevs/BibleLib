  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "REV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mto Wa Maji Ya Uzima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha yule malaika akanionyesha mto wa maji ya uzima, maangavu kama kioo yakitiririka kutoka kwenye kile kiti cha enzi cha Mungu na cha Mwana-Kondoo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kupitia katikati ya barabara kuu ya huo mji. Kwenye kila upande wa huo mto kulikuwa na mti wa uzima utoao matunda ya aina kumi na mbili, ukizaa matunda yake kila mwezi. Nayo majani ya mti huo ni kwa ajili ya uponyaji wa mataifa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mji huo hakutakuwa tena na laana, bali kiti cha enzi cha Mungu na cha Mwana-Kondoo kitakuwamo humo na watumishi wake watamtumikia,",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao watamwona uso wake na Jina lake litakuwa kwenye vipaji vya nyuso zao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku hautakuwako tena, wala hawatahitaji mwanga wa taa au wa jua, kwa maana",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.5",
                "verseOrgIds": [
                  "REV.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Mungu atakuwa nuru yao, nao watatawala milele na milele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha yule malaika akaniambia, \"Maneno haya ni ya kuaminika na kweli.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Bwana",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.6",
                "verseOrgIds": [
                  "REV.22.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Mungu wa roho za manabii, alimtuma malaika wake kuwaonyesha watumishi wake yale ambayo hayana budi kutukia upesi.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bwana Yesu Anakuja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tazama, naja upesi! Amebarikiwa yeye ayashikaye maneno ya unabii wa kitabu hiki.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.7",
                "verseOrgIds": [
                  "REV.22.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi, Yohana, ndiye niliyesikia na kuyaona mambo haya. Nami nilipokwisha kuyasikia na kuyaona, nilianguka chini nikasujudu miguuni pa yule malaika aliyekuwa akinionyesha mambo hayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini yeye akaniambia, \"Usifanye hivyo! Mimi ni mtumishi pamoja nawe na ndugu zako manabii na wote wanaoyashika maneno ya kitabu hiki. Msujudie Mungu!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akaniambia, \"Usiyafunge maneno ya unabii yaliyomo katika kitabu hiki, kwa sababu wakati umekaribia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atendaye mabaya na aendelee kutenda mabaya, aliye mchafu na aendelee kuwa mchafu, yeye atendaye haki na aendelee kutenda haki, na yeye aliye mtakatifu na aendelee kuwa mtakatifu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tazama, naja upesi! Thawabu yangu i mkononi mwangu, nami nitampa kila mtu sawasawa na alivyotenda.",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.12",
                "verseOrgIds": [
                  "REV.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mimi ni Alfa na Omega, wa Kwanza na wa Mwisho, Mwanzo na Mwisho.",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.13",
                "verseOrgIds": [
                  "REV.22.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wamebarikiwa wale wafuao mavazi yao, ili wapate haki ya kuuendea huo mti wa uzima na kuuingia huo mji kupitia kwenye malango yake.",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.14",
                "verseOrgIds": [
                  "REV.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Huko nje wako mbwa, wachawi, wazinzi, wauaji, waabudu sanamu, na kila mtu apendaye udanganyifu na kuufanya.",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.15",
                "verseOrgIds": [
                  "REV.22.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mimi, Yesu, nimemtuma malaika wangu kushuhudia mambo haya kwa ajili ya makanisa. Mimi ndimi Shina na Mzao wa Daudi, ile Nyota ya Asubuhi ingʼaayo.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.16",
                "verseOrgIds": [
                  "REV.22.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho na bibi arusi wanasema, \"Njoo!\" Naye asikiaye na aseme, \"Njoo!\" Yeyote mwenye kiu na aje, na kila anayetaka na anywe maji ya uzima bure.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
              "REV.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwonya kila mtu asikiaye maneno ya unabii wa kitabu hiki: Mtu yeyote akiongeza humo chochote, Mungu atamwongezea mapigo yaliyoandikwa katika kitabu hiki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.18",
            "verseOrgIds": [
              "REV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mtu yeyote akipunguza humo chochote katika maneno ya unabii wa kitabu hiki, Mungu atamwondolea sehemu yake katika ule mti wa uzima na katika ule mji mtakatifu, ambao habari zake zimeandikwa katika kitabu hiki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.19",
            "verseOrgIds": [
              "REV.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye anayeshuhudia mambo haya asema,",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hakika, naja upesi!\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.22.20",
                "verseOrgIds": [
                  "REV.22.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 22:20"
      },
      "items": [
        {
          "text": "Amen. Njoo, Bwana Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neema ya Bwana Yesu iwe na watakatifu wote. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.21",
            "verseOrgIds": [
              "REV.22.21"
            ]
          }
        }
      ]
    }
  ],
  "previous": {
    "id": "REV.21",
    "number": "21",
    "bookId": "REV"
  }
}