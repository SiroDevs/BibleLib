          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The first lot, which was for Asaph, fell to Joseph,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
