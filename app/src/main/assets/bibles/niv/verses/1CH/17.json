                "verseOrgIds": [
                  "1CH.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", are God! You have promised these good things to your servant.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
