                "verseId": "1CH.15.26",
                "verseOrgIds": [
                  "1CH.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", seven bulls and seven rams were sacrificed.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
