{
  "id": "HAB.2",
  "number": "2",
  "bookId": "HAB",
  "reference": "Hab. 2",
  "copyright": "The Holy Bible, New International Version® NIV® Copyright © 1973, 1978, 1984, 2011 by Biblica, Inc.® Used by Permission of Biblica, Inc.® All rights reserved worldwide.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HAB 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will stand at my watch",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "and station myself on the ramparts;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "I will look to see what he will say to me,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "and what answer I am to give to this complaint.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text"
            }
          ]
        },
        {
          "text": "'s Answer",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.2",
                "verseOrgIds": [
                  "HAB.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "replied:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "\"Write down the revelation",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "and make it plain on tablets",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "so that a herald",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
          "text": "may run with it.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the revelation awaits an appointed time;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "it speaks of the end",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "and will not prove false.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "Though it linger, wait for it;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "it",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        },
        {
          "text": "will certainly come",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "and will not delay.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"See, the enemy is puffed up;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "his desires are not upright—",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "but the righteous person will live by his faithfulness",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        },
        {
          "text": "—",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "indeed, wine betrays him;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "he is arrogant and never at rest.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "Because he is as greedy as the grave",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "and like death is never satisfied,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "he gathers to himself all the nations",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "and takes captive all the peoples.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Will not all of them taunt him with ridicule and scorn, saying,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "\" 'Woe to him who piles up stolen goods",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "and makes himself wealthy by extortion!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "How long must this go on?'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will not your creditors suddenly arise?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Will they not wake up and make you tremble?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Then you will become their prey.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Because you have plundered many nations,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "the peoples who are left will plunder you.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "For you have shed human blood;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "you have destroyed lands and cities and everyone in them.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Woe to him who builds his house by unjust gain,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "setting his nest on high",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "to escape the clutches of ruin!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have plotted the ruin of many peoples,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:10"
      },
      "items": [
        {
          "text": "shaming your own house and forfeiting your life.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The stones of the wall will cry out,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
