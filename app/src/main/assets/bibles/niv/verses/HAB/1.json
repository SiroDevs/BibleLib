      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:14"
      },
      "items": [
        {
          "text": "like the sea creatures that have no ruler.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.14",
            "verseOrgIds": [
              "HAB.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
