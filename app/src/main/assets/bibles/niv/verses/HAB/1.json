      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:15"
      },
      "items": [
        {
          "text": "he catches them in his net,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        }
      ]
    },
