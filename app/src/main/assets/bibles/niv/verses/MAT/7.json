          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "When Jesus had finished saying these things, the crowds were amazed at his teaching,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.28",
            "verseOrgIds": [
              "MAT.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "because he taught as one who had authority, and not as their teachers of the law.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.29",
            "verseOrgIds": [
              "MAT.7.29"
            ]
          }
        }
      ]
