    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The Genealogy of Jesus the Messiah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is the genealogy",
          "type": "text"
        },
        {
          "text": "of Jesus the Messiah",
          "type": "text"
        },
        {
          "text": "the son of David, the son of Abraham:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abraham was the father of Isaac,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:2"
      },
      "items": [
        {
          "text": "Isaac the father of Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:2"
      },
      "items": [
        {
          "text": "Jacob the father of Judah and his brothers,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judah the father of Perez and Zerah, whose mother was Tamar,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:3"
      },
      "items": [
        {
          "text": "Perez the father of Hezron,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:3"
      },
      "items": [
        {
          "text": "Hezron the father of Ram,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
