  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ZEC 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will Care for Judah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ask the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "for rain in the springtime;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "it is the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "who sends the thunderstorms.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "He gives showers of rain to all people,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "and plants of the field to everyone.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The idols speak deceitfully,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "diviners see visions that lie;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "they tell dreams that are false,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "they give comfort in vain.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "Therefore the people wander like sheep",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "oppressed for lack of a shepherd.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"My anger burns against the shepherds,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "and I will punish the leaders;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "for the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.3",
                "verseOrgIds": [
                  "ZEC.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty will care",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "for his flock, the people of Judah,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "and make them like a proud horse in battle.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "From Judah will come the cornerstone,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "from him the tent peg,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "from him the battle bow,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "from him every ruler.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Together they",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "text": "will be like warriors in battle",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "trampling their enemy into the mud of the streets.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "They will fight because the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.5",
                "verseOrgIds": [
                  "ZEC.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "is with them,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "and they will put the enemy horsemen to shame.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I will strengthen Judah",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "and save the tribes of Joseph.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "I will restore them",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "because I have compassion on them.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "They will be as though",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "I had not rejected them,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "for I am the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.6",
                "verseOrgIds": [
                  "ZEC.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "their God",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "and I will answer them.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Ephraimites will become like warriors,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "and their hearts will be glad as with wine.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "Their children will see it and be joyful;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "their hearts will rejoice in the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.7",
                "verseOrgIds": [
                  "ZEC.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will signal for them",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.8",
            "verseOrgIds": [
              "ZEC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:8"
      },
      "items": [
        {
          "text": "and gather them in.",
          "type": "text",
