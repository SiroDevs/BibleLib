          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
