            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he showed me Joshua the high priest standing before the angel of the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.1",
                "verseOrgIds": [
                  "ZEC.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", and Satan",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "text": "standing at his right side to accuse him.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
