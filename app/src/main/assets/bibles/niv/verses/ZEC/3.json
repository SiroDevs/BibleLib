                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "said to Satan, \"The",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
