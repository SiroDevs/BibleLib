          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "I asked, \"What are these coming to do?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
