            "style": "v",
            "sid": "ZEC 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
