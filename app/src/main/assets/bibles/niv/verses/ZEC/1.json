          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "I asked the angel who was speaking to me, \"What are these?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
