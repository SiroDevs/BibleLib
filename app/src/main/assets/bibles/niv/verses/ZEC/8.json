              "type": "text"
            }
          ]
        },
        {
          "text": "The word of the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.18",
                "verseOrgIds": [
                  "ZEC.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty came to me.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
