            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.1",
                "verseOrgIds": [
                  "ZEC.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty came to me.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
              "ZEC.8.1"
            ]
          }
        }
