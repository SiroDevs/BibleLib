            "number": "4",
            "style": "v",
            "sid": "ZEC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.4",
                "verseOrgIds": [
                  "ZEC.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty says: \"Once again men and women of ripe old age will sit in the streets of Jerusalem, each of them with cane in hand because of their age.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The city streets will be filled with boys and girls playing there.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.6",
                "verseOrgIds": [
                  "ZEC.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty says: \"It may seem marvelous to the remnant of this people at that time, but will it seem marvelous to me?\" declares the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.6",
                "verseOrgIds": [
                  "ZEC.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
