          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.2",
                "verseOrgIds": [
                  "ZEC.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty says: \"I am very jealous for Zion; I am burning with jealousy for her.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        }
      ]
    },
    {
