            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The word of the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
              "ZEC.8.1"
            ]
          }
        },
        {
