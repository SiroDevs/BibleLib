        "sid": "AMO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel Has Not Returned to God",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear this word, you cows of Bashan on Mount Samaria,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "you women who oppress the poor and crush the needy",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "and say to your husbands, \"Bring us some drinks!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.2",
                "verseOrgIds": [
                  "AMO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "has sworn by his holiness:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "\"The time will surely come",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "when you will be taken away with hooks,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "the last of you with fishhooks.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "You will each go straight out",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "through breaches in the wall.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "You will be cast out toward Harmon,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "declares the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.3",
                "verseOrgIds": [
                  "AMO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Go to Bethel and sin;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "go to Gilgal and sin yet more.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "Bring your sacrifices every morning,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "your tithes every three years.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burn leavened bread as a thank offering",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "and brag about your freewill offerings—",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "boast about them, you Israelites,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "for this is what you love to do,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "declares the Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.5",
                "verseOrgIds": [
                  "AMO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I gave you empty stomachs in every city",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "and lack of bread in every town,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "yet you have not returned to me,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "declares the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.6",
                "verseOrgIds": [
                  "AMO.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I also withheld rain from you",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "when the harvest was still three months away.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "I sent rain on one town,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "but withheld it from another.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "One field had rain;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "another had none and dried up.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "People staggered from town to town for water",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "but did not get enough to drink,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "yet you have not returned to me,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "declares the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.8",
                "verseOrgIds": [
                  "AMO.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Many times I struck your gardens and vineyards,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:9"
      },
      "items": [
        {
          "text": "destroying them with blight and mildew.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:9"
      },
      "items": [
        {
          "text": "Locusts devoured your fig and olive trees,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:9"
      },
