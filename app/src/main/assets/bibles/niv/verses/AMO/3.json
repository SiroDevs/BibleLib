      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "when no bait is there?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
