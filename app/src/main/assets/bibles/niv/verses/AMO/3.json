          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:9"
      },
      "items": [
