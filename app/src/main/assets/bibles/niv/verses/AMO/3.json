          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "when it has no prey?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "Does it growl in its den",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
