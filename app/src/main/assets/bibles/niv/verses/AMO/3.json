      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "for all your sins.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
