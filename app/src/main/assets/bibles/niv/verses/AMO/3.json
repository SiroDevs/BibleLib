          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.1",
                "verseOrgIds": [
                  "AMO.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "has spoken against you—against the whole family I brought up out of Egypt:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
