          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:6"
      },
      "items": [
        {
