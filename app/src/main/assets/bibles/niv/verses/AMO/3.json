          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.10",
                "verseOrgIds": [
                  "AMO.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
