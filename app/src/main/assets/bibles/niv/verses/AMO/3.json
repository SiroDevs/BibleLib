          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.7",
                "verseOrgIds": [
                  "AMO.3.7"
