          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "see the great unrest within her",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
