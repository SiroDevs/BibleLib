      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:3"
      },
      "items": [
        {
          "text": "unless they have agreed to do so?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        }
      ]
    },
    {
