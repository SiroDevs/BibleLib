          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:1"
      },
