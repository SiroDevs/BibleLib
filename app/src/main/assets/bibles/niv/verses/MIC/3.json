          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Leaders and Prophets Rebuked",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I said,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "\"Listen, you leaders of Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "you rulers of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "Should you not embrace justice,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "you who hate good and love evil;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "who tear the skin from my people",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "and the flesh from their bones;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "who eat my people's flesh,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "strip off their skin",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "and break their bones in pieces;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "who chop them up like meat for the pan,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "like flesh for the pot?\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then they will cry out to the",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "MIC.3.4",
                "verseOrgIds": [
                  "MIC.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "but he will not answer them.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "At that time he will hide his face from them",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "because of the evil they have done.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "MIC.3.5",
                "verseOrgIds": [
                  "MIC.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "says:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "\"As for the prophets",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "who lead my people astray,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "they proclaim 'peace'",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "if they have something to eat,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "but prepare to wage war against anyone",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "who refuses to feed them.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore night will come over you, without visions,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "and darkness, without divination.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "The sun will set for the prophets,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "and the day will go dark for them.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The seers will be ashamed",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "and the diviners disgraced.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "They will all cover their faces",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "because there is no answer from God.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "But as for me, I am filled with power,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "with the Spirit of the",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "MIC.3.8",
                "verseOrgIds": [
                  "MIC.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "and with justice and might,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "to declare to Jacob his transgression,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "to Israel his sin.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear this, you leaders of Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "you rulers of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "who despise justice",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "and distort all that is right;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "who build Zion with bloodshed,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:10"
      },
      "items": [
        {
          "text": "and Jerusalem with wickedness.",
          "type": "text",
