  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MIC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel's Misery",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "What misery is mine!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "I am like one who gathers summer fruit",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "at the gleaning of the vineyard;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "there is no cluster of grapes to eat,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "none of the early figs that I crave.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The faithful have been swept from the land;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "not one upright person remains.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "Everyone lies in wait to shed blood;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "they hunt each other with nets.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Both hands are skilled in doing evil;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "the ruler demands gifts,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "the judge accepts bribes,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "the powerful dictate what they desire—",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "they all conspire together.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The best of them is like a brier,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "the most upright worse than a thorn hedge.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "The day God visits you has come,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "the day your watchmen sound the alarm.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Now is the time of your confusion.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not trust a neighbor;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "put no confidence in a friend.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "Even with the woman who lies in your embrace",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "guard the words of your lips.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "For a son dishonors his father,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "a daughter rises up against her mother,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "a daughter-in-law against her mother-in-law—",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "a man's enemies are the members of his own household.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "But as for me, I watch in hope for the",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.7",
                "verseOrgIds": [
                  "MIC.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "I wait for God my Savior;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "my God will hear me.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel Will Rise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not gloat over me, my enemy!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Though I have fallen, I will rise.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Though I sit in darkness,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.8",
                "verseOrgIds": [
                  "MIC.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "will be my light.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Because I have sinned against him,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "I will bear the",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.9",
                "verseOrgIds": [
                  "MIC.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "'s wrath,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "until he pleads my case",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "and upholds my cause.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "He will bring me out into the light;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "I will see his righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then my enemy will see it",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
