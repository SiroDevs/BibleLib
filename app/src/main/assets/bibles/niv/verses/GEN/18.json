      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:30"
      },
      "items": [
        {
          "text": "He answered, \"I will not do it if I find thirty there.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
    },
