      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 4:23"
      },
      "items": [
        {
          "text": "\"Adah and Zillah, listen to me;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
