            "sid": "OBA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The vision of Obadiah.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "This is what the Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.1",
                "verseOrgIds": [
                  "OBA.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "says about Edom—",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "We have heard a message from the",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.1",
                "verseOrgIds": [
                  "OBA.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "An envoy was sent to the nations to say,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "\"Rise, let us go against her for battle\"—",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "OBA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"See, I will make you small among the nations;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:2"
      },
      "items": [
        {
          "text": "you will be utterly despised.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "OBA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The pride of your heart has deceived you,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "you who live in the clefts of the rocks",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "and make your home on the heights,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "you who say to yourself,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "'Who can bring me down to the ground?'",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "OBA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though you soar like the eagle",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "and make your nest among the stars,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "from there I will bring you down,\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "declares the",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.4",
                "verseOrgIds": [
                  "OBA.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "OBA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"If thieves came to you,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "if robbers in the night—",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "oh, what a disaster awaits you!—",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "would they not steal only as much as they wanted?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "If grape pickers came to you,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "would they not leave a few grapes?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "OBA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "But how Esau will be ransacked,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:6"
      },
      "items": [
        {
          "text": "his hidden treasures pillaged!",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "OBA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "All your allies will force you to the border;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "your friends will deceive and overpower you;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "those who eat your bread will set a trap for you,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "but you will not detect it.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "OBA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"In that day,\" declares the",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.8",
                "verseOrgIds": [
                  "OBA.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "\"will I not destroy the wise men of Edom,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "those of understanding in the mountains of Esau?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "OBA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your warriors, Teman, will be terrified,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "and everyone in Esau's mountains",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "will be cut down in the slaughter.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "OBA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Because of the violence against your brother Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:10"
      },
      "items": [
        {
          "text": "you will be covered with shame;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:10"
      },
      "items": [
        {
          "text": "you will be destroyed forever.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "OBA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "On the day you stood aloof",
