          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "Your merchants were the world's important people.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
