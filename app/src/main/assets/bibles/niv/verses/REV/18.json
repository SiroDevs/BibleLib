          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:20"
      },
      "items": [
        {
          "text": "For God has judged her",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
