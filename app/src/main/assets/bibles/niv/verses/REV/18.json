      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:20"
      },
      "items": [
        {
          "text": "Rejoice, you people of God!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:20"
      },
      "items": [
        {
