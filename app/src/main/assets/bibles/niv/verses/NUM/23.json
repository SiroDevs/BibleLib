      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "Does he speak and then not act?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
