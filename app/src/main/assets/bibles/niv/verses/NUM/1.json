      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:10"
      },
      "items": [
        {
          "text": "from Ephraim, Elishama son of Ammihud;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.10",
            "verseOrgIds": [
              "NUM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:10"
      },
      "items": [
