          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "from Zebulun, Eliab son of Helon;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.9",
            "verseOrgIds": [
              "NUM.1.9"
            ]
          }
        }
      ]
