          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "The next morning Balak took Balaam up to Bamoth Baal, and from there he could see the outskirts of the Israelite camp.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
