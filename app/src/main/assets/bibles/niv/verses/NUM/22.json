      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 22:30"
      },
      "items": [
        {
          "text": "\"No,\" he said.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        }
      ]
