              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.12",
                "verseOrgIds": [
                  "NUM.29.12"
                ]
              }
            }
          ]
        },
        {
          "text": "for seven days.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
