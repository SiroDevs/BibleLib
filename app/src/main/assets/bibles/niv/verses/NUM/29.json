          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
