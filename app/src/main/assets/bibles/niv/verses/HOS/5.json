          "text": "\"Sound the trumpet in Gibeah,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "the horn in Ramah.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "Raise the battle cry in Beth Aven",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:8"
      },
      "items": [
        {
          "text": "lead on, Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ephraim will be laid waste",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "on the day of reckoning.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "Among the tribes of Israel",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "I proclaim what is certain.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judah's leaders are like those",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "who move boundary stones.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "I will pour out my wrath on them",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:10"
      },
      "items": [
        {
          "text": "like a flood of water.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
