        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Judgment Against Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hear this, you priests!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Pay attention, you Israelites!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "Listen, royal house!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "This judgment is against you:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "You have been a snare at Mizpah,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:1"
      },
      "items": [
        {
          "text": "a net spread out on Tabor.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.1",
            "verseOrgIds": [
              "HOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The rebels are knee-deep in slaughter.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:2"
      },
      "items": [
        {
          "text": "I will discipline all of them.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.2",
            "verseOrgIds": [
              "HOS.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I know all about Ephraim;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israel is not hidden from me.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Ephraim, you have now turned to prostitution;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:3"
      },
      "items": [
        {
          "text": "Israel is corrupt.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.3",
            "verseOrgIds": [
              "HOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Their deeds do not permit them",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "to return to their God.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "A spirit of prostitution is in their heart;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:4"
      },
      "items": [
        {
          "text": "they do not acknowledge the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.5.4",
                "verseOrgIds": [
                  "HOS.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.4",
            "verseOrgIds": [
              "HOS.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israel's arrogance testifies against them;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "the Israelites, even Ephraim, stumble in their sin;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:5"
      },
      "items": [
        {
          "text": "Judah also stumbles with them.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.5",
            "verseOrgIds": [
              "HOS.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "When they go with their flocks and herds",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "to seek the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.5.6",
                "verseOrgIds": [
                  "HOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "they will not find him;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:6"
      },
      "items": [
        {
          "text": "he has withdrawn himself from them.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.6",
            "verseOrgIds": [
              "HOS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are unfaithful to the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.5.7",
                "verseOrgIds": [
                  "HOS.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "they give birth to illegitimate children.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "When they celebrate their New Moon feasts,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:7"
      },
      "items": [
        {
          "text": "he will devour",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        },
        {
          "text": "their fields.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.7",
            "verseOrgIds": [
              "HOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
