        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel Unrepentant",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Come, let us return to the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.6.1",
                "verseOrgIds": [
                  "HOS.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "He has torn us to pieces",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "but he will heal us;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "he has injured us",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:1"
      },
      "items": [
        {
          "text": "but he will bind up our wounds.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "After two days he will revive us;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:2"
      },
      "items": [
        {
          "text": "on the third day he will restore us,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:2"
      },
      "items": [
        {
          "text": "that we may live in his presence.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let us acknowledge the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.6.3",
                "verseOrgIds": [
                  "HOS.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "let us press on to acknowledge him.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "As surely as the sun rises,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "he will appear;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "he will come to us like the winter rains,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "like the spring rains that water the earth.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"What can I do with you, Ephraim?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:4"
      },
      "items": [
        {
          "text": "What can I do with you, Judah?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:4"
      },
      "items": [
        {
          "text": "Your love is like the morning mist,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:4"
      },
      "items": [
        {
          "text": "like the early dew that disappears.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore I cut you in pieces with my prophets,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:5"
      },
      "items": [
        {
          "text": "I killed you with the words of my mouth—",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:5"
      },
      "items": [
        {
          "text": "then my judgments go forth like the sun.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "For I desire mercy, not sacrifice,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:6"
      },
      "items": [
        {
          "text": "and acknowledgment of God rather than burnt offerings.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "As at Adam,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        },
        {
          "text": "they have broken the covenant;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:7"
      },
      "items": [
        {
          "text": "they were unfaithful to me there.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilead is a city of evildoers,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:8"
      },
      "items": [
        {
          "text": "stained with footprints of blood.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "As marauders lie in ambush for a victim,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:9"
      },
      "items": [
        {
          "text": "so do bands of priests;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:9"
      },
      "items": [
        {
          "text": "they murder on the road to Shechem,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:9"
      },
      "items": [
        {
          "text": "carrying out their wicked schemes.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I have seen a horrible thing in Israel:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:10"
      },
      "items": [
        {
          "text": "There Ephraim is given to prostitution,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:10"
      },
      "items": [
        {
          "text": "Israel is defiled.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Also for you, Judah,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.11",
            "verseOrgIds": [
              "HOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:11"
      },
      "items": [
        {
          "text": "a harvest is appointed.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.11",
            "verseOrgIds": [
              "HOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HOS 6:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:11"
      },
      "items": [
        {
          "text": "\"Whenever I would restore the fortunes of my people,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.11",
            "verseOrgIds": [
              "HOS.6.11"
            ]
          }
        }
      ]
    }
  ],
