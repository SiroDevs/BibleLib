          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The Charge Against Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear the word of the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.4.1",
                "verseOrgIds": [
                  "HOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", you Israelites,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "because the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.4.1",
                "verseOrgIds": [
                  "HOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "has a charge to bring",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "against you who live in the land:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "\"There is no faithfulness, no love,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "no acknowledgment of God in the land.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "There is only cursing,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        },
        {
          "text": "lying and murder,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "stealing and adultery;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "they break all bounds,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "and bloodshed follows bloodshed.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Because of this the land dries up,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "and all who live in it waste away;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "the beasts of the field, the birds in the sky",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "and the fish in the sea are swept away.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But let no one bring a charge,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "let no one accuse another,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "for your people are like those",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "who bring charges against a priest.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "You stumble day and night,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "and the prophets stumble with you.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "So I will destroy your mother—",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "my people are destroyed from lack of knowledge.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HOS 4:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "\"Because you have rejected knowledge,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "I also reject you as my priests;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "because you have ignored the law of your God,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "I also will ignore your children.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The more priests there were,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "the more they sinned against me;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "they exchanged their glorious God",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        },
        {
          "text": "for something disgraceful.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "They feed on the sins of my people",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:8"
      },
      "items": [
        {
          "text": "and relish their wickedness.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "And it will be: Like people, like priests.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "I will punish both of them for their ways",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "and repay them for their deeds.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"They will eat but not have enough;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "they will engage in prostitution but not flourish,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "because they have deserted the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.4.10",
                "verseOrgIds": [
                  "HOS.4.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "to give themselves",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "to prostitution;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:11"
      },
      "items": [
        {
          "text": "old wine and new wine",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:11"
      },
