  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israel was a spreading vine;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "he brought forth fruit for himself.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "As his fruit increased,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "he built more altars;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "as his land prospered,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "he adorned his sacred stones.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their heart is deceitful,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "and now they must bear their guilt.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.2",
                "verseOrgIds": [
                  "HOS.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "will demolish their altars",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "and destroy their sacred stones.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then they will say, \"We have no king",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "because we did not revere the",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "HOS.10.3",
                "verseOrgIds": [
                  "HOS.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "But even if we had a king,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "what could he do for us?\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "They make many promises,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "take false oaths",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "and make agreements;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "therefore lawsuits spring up",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "like poisonous weeds in a plowed field.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The people who live in Samaria fear",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "for the calf-idol of Beth Aven.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "Its people will mourn over it,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "and so will its idolatrous priests,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "those who had rejoiced over its splendor,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "because it is taken from them into exile.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "It will be carried to Assyria",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "as tribute for the great king.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Ephraim will be disgraced;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Israel will be ashamed of its foreign alliances.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samaria's king will be destroyed,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:7"
      },
      "items": [
        {
          "text": "swept away like a twig on the surface of the waters.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The high places of wickedness",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        },
        {
          "text": "will be destroyed—",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "it is the sin of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Thorns and thistles will grow up",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "and cover their altars.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Then they will say to the mountains, \"Cover us!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "and to the hills, \"Fall on us!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Since the days of Gibeah, you have sinned, Israel,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "and there you have remained.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "Will not war again overtake",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "the evildoers in Gibeah?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I please, I will punish them;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
