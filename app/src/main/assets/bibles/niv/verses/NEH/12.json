      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:1"
      },
      "items": [
        {
          "text": "Seraiah, Jeremiah, Ezra,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        }
      ]
    },
    {
