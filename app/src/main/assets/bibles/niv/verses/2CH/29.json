              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Joah son of Zimmah and Eden son of Joah;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
