      "attrs": {
        "style": "li1",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "from the descendants of Asaph:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
