          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOL.1.9",
                "verseOrgIds": [
                  "JOL.1.9"
                ]
              }
            }
          ]
        },
