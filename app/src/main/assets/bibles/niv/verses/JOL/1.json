            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOL.1.1",
                "verseOrgIds": [
                  "JOL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "that came to Joel son of Pethuel.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.1",
            "verseOrgIds": [
              "JOL.1.1"
            ]
          }
        }
      ]
