      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fields are ruined,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
