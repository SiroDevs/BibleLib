    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wake up, you drunkards, and weep!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "Wail, all you drinkers of wine;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "wail because of the new wine,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "for it has been snatched from your lips.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A nation has invaded my land,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "a mighty army without number;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "it has the teeth of a lion,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "the fangs of a lioness.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "It has laid waste my vines",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "and ruined my fig trees.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "It has stripped off their bark",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "and thrown it away,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "leaving their branches white.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
