      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "other locusts",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
