  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PRO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not boast about tomorrow,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:1"
      },
      "items": [
        {
          "text": "for you do not know what a day may bring.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let someone else praise you, and not your own mouth;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "an outsider, and not your own lips.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Stone is heavy and sand a burden,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:3"
      },
      "items": [
        {
          "text": "but a fool's provocation is heavier than both.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anger is cruel and fury overwhelming,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:4"
      },
      "items": [
        {
          "text": "but who can stand before jealousy?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better is open rebuke",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:5"
      },
      "items": [
        {
          "text": "than hidden love.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wounds from a friend can be trusted,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:6"
      },
      "items": [
        {
          "text": "but an enemy multiplies kisses.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "One who is full loathes honey from the comb,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:7"
      },
      "items": [
        {
          "text": "but to the hungry even what is bitter tastes sweet.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like a bird that flees its nest",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:8"
      },
      "items": [
        {
          "text": "is anyone who flees from home.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perfume and incense bring joy to the heart,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "and the pleasantness of a friend",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "springs from their heartfelt advice.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not forsake your friend or a friend of your family,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "and do not go to your relative's house when disaster strikes you—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "better a neighbor nearby than a relative far away.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be wise, my son, and bring joy to my heart;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "then I can answer anyone who treats me with contempt.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The prudent see danger and take refuge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "but the simple keep going and pay the penalty.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take the garment of one who puts up security for a stranger;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "hold it in pledge if it is done for an outsider.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "If anyone loudly blesses their neighbor early in the morning,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:14"
      },
      "items": [
        {
          "text": "it will be taken as a curse.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A quarrelsome wife is like the dripping",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:15"
      },
      "items": [
        {
          "text": "of a leaky roof in a rainstorm;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "restraining her is like restraining the wind",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:16"
      },
      "items": [
        {
          "text": "or grasping oil with the hand.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "As iron sharpens iron,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:17"
      },
      "items": [
        {
          "text": "so one person sharpens another.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
