  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PRO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Get Wisdom at Any Cost",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen, my sons, to a father's instruction;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:1"
      },
      "items": [
        {
          "text": "pay attention and gain understanding.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I give you sound learning,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:2"
      },
      "items": [
        {
          "text": "so do not forsake my teaching.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For I too was a son to my father,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:3"
      },
      "items": [
        {
          "text": "still tender, and cherished by my mother.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he taught me, and he said to me,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "\"Take hold of my words with all your heart;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "keep my commands, and you will live.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Get wisdom, get understanding;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:5"
      },
      "items": [
        {
          "text": "do not forget my words or turn away from them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not forsake wisdom, and she will protect you;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:6"
      },
      "items": [
        {
          "text": "love her, and she will watch over you.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The beginning of wisdom is this: Get",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        },
        {
          "text": "wisdom.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:7"
      },
      "items": [
        {
          "text": "Though it cost all you have,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        },
        {
          "text": "get understanding.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cherish her, and she will exalt you;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:8"
      },
      "items": [
        {
          "text": "embrace her, and she will honor you.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "She will give you a garland to grace your head",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:9"
      },
      "items": [
        {
          "text": "and present you with a glorious crown.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen, my son, accept what I say,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:10"
      },
      "items": [
        {
          "text": "and the years of your life will be many.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I instruct you in the way of wisdom",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:11"
      },
      "items": [
        {
          "text": "and lead you along straight paths.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "When you walk, your steps will not be hampered;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:12"
      },
      "items": [
        {
          "text": "when you run, you will not stumble.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hold on to instruction, do not let it go;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:13"
      },
      "items": [
        {
          "text": "guard it well, for it is your life.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not set foot on the path of the wicked",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:14"
      },
      "items": [
        {
          "text": "or walk in the way of evildoers.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avoid it, do not travel on it;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:15"
      },
      "items": [
        {
          "text": "turn from it and go on your way.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "For they cannot rest until they do evil;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:16"
      },
      "items": [
        {
          "text": "they are robbed of sleep till they make someone stumble.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "They eat the bread of wickedness",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:17"
      },
      "items": [
        {
          "text": "and drink the wine of violence.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "The path of the righteous is like the morning sun,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:18"
      },
      "items": [
        {
          "text": "shining ever brighter till the full light of day.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "But the way of the wicked is like deep darkness;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.19",
            "verseOrgIds": [
              "PRO.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:19"
      },
      "items": [
        {
          "text": "they do not know what makes them stumble.",
          "type": "text",
          "attrs": {
