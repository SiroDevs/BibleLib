          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "The accomplices of thieves are their own enemies;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.24",
            "verseOrgIds": [
              "PRO.29.24"
            ]
          }
        }
      ]
    },
