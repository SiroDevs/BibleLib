      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:22"
      },
      "items": [
        {
          "text": "and a hot-tempered person commits many sins.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.22",
            "verseOrgIds": [
              "PRO.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
