      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:24"
      },
      "items": [
        {
          "text": "they are put under oath and dare not testify.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.24",
            "verseOrgIds": [
              "PRO.29.24"
            ]
          }
        }
      ]
    },
    {
