      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:23"
      },
      "items": [
        {
          "text": "but the lowly in spirit gain honor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.23",
            "verseOrgIds": [
              "PRO.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
