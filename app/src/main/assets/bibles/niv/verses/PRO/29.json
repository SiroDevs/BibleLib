            "number": "22",
            "style": "v",
            "sid": "PRO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "An angry person stirs up conflict,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.22",
            "verseOrgIds": [
              "PRO.29.22"
            ]
          }
        }
      ]
    },
