          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A servant pampered from youth",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.21",
            "verseOrgIds": [
              "PRO.29.21"
            ]
          }
        }
      ]
    },
