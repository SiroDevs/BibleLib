  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PRO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Purpose and Theme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The proverbs of Solomon son of David, king of Israel:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.1",
            "verseOrgIds": [
              "PRO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "for gaining wisdom and instruction;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:2"
      },
      "items": [
        {
          "text": "for understanding words of insight;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "for receiving instruction in prudent behavior,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:3"
      },
      "items": [
        {
          "text": "doing what is right and just and fair;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "for giving prudence to those who are simple,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:4"
      },
      "items": [
        {
          "text": "knowledge and discretion to the young—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "let the wise listen and add to their learning,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "and let the discerning get guidance—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "for understanding proverbs and parables,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:6"
      },
      "items": [
        {
          "text": "the sayings and riddles of the wise.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fear of the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.1.7",
                "verseOrgIds": [
                  "PRO.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "is the beginning of knowledge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:7"
      },
      "items": [
        {
          "text": "but fools",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        },
        {
          "text": "despise wisdom and instruction.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Prologue: Exhortations to Embrace Wisdom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Warning Against the Invitation of Sinful Men",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen, my son, to your father's instruction",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:8"
      },
      "items": [
        {
          "text": "and do not forsake your mother's teaching.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are a garland to grace your head",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:9"
      },
      "items": [
        {
          "text": "and a chain to adorn your neck.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "My son, if sinful men entice you,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:10"
      },
      "items": [
        {
          "text": "do not give in to them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "If they say, \"Come along with us;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "let's lie in wait for innocent blood,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "let's ambush some harmless soul;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "let's swallow them alive, like the grave,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "and whole, like those who go down to the pit;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "we will get all sorts of valuable things",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:13"
      },
      "items": [
        {
          "text": "and fill our houses with plunder;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "cast lots with us;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:14"
      },
      "items": [
        {
          "text": "we will all share the loot\"—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "my son, do not go along with them,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:15"
      },
      "items": [
        {
          "text": "do not set foot on their paths;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "for their feet rush into evil,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:16"
      },
      "items": [
        {
          "text": "they are swift to shed blood.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "How useless to spread a net",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:17"
      },
      "items": [
        {
          "text": "where every bird can see it!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "These men lie in wait for their own blood;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.18",
            "verseOrgIds": [
              "PRO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:18"
      },
      "items": [
        {
          "text": "they ambush only themselves!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.18",
            "verseOrgIds": [
              "PRO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Such are the paths of all who go after ill-gotten gain;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.19",
            "verseOrgIds": [
              "PRO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:19"
      },
      "items": [
        {
          "text": "it takes away the life of those who get it.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.19",
            "verseOrgIds": [
              "PRO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wisdom's Rebuke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Out in the open wisdom calls aloud,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.20",
            "verseOrgIds": [
              "PRO.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:20"
      },
      "items": [
        {
          "text": "she raises her voice in the public square;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.20",
            "verseOrgIds": [
              "PRO.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "on top of the wall",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.21",
            "verseOrgIds": [
              "PRO.1.21"
            ]
          }
        },
        {
          "text": "she cries out,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.21",
            "verseOrgIds": [
              "PRO.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:21"
      },
      "items": [
        {
          "text": "at the city gate she makes her speech:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.21",
            "verseOrgIds": [
              "PRO.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"How long will you who are simple love your simple ways?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.22",
            "verseOrgIds": [
              "PRO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:22"
      },
      "items": [
        {
          "text": "How long will mockers delight in mockery",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.22",
            "verseOrgIds": [
              "PRO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:22"
      },
      "items": [
        {
          "text": "and fools hate knowledge?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.22",
            "verseOrgIds": [
              "PRO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Repent at my rebuke!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.23",
            "verseOrgIds": [
              "PRO.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:23"
      },
      "items": [
        {
          "text": "Then I will pour out my thoughts to you,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.23",
            "verseOrgIds": [
              "PRO.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:23"
      },
      "items": [
        {
          "text": "I will make known to you my teachings.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.23",
            "verseOrgIds": [
              "PRO.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "But since you refuse to listen when I call",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.24",
            "verseOrgIds": [
              "PRO.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:24"
      },
      "items": [
        {
          "text": "and no one pays attention when I stretch out my hand,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.24",
            "verseOrgIds": [
              "PRO.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "since you disregard all my advice",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.25",
            "verseOrgIds": [
              "PRO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:25"
      },
      "items": [
        {
          "text": "and do not accept my rebuke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.25",
            "verseOrgIds": [
              "PRO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "I in turn will laugh when disaster strikes you;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.26",
            "verseOrgIds": [
              "PRO.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:26"
      },
      "items": [
        {
          "text": "I will mock when calamity overtakes you—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.26",
            "verseOrgIds": [
              "PRO.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "when calamity overtakes you like a storm,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.27",
            "verseOrgIds": [
              "PRO.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:27"
      },
      "items": [
        {
          "text": "when disaster sweeps over you like a whirlwind,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.27",
            "verseOrgIds": [
              "PRO.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:27"
      },
      "items": [
        {
          "text": "when distress and trouble overwhelm you.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.27",
            "verseOrgIds": [
              "PRO.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Then they will call to me but I will not answer;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.28",
            "verseOrgIds": [
              "PRO.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:28"
      },
      "items": [
        {
          "text": "they will look for me but will not find me,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.28",
            "verseOrgIds": [
              "PRO.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "since they hated knowledge",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.29",
            "verseOrgIds": [
              "PRO.1.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:29"
      },
      "items": [
        {
          "text": "and did not choose to fear the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.29",
            "verseOrgIds": [
              "PRO.1.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.1.29",
                "verseOrgIds": [
                  "PRO.1.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.29",
            "verseOrgIds": [
              "PRO.1.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Since they would not accept my advice",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.30",
            "verseOrgIds": [
              "PRO.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:30"
      },
      "items": [
        {
          "text": "and spurned my rebuke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.30",
            "verseOrgIds": [
              "PRO.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "they will eat the fruit of their ways",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.31",
            "verseOrgIds": [
              "PRO.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:31"
      },
      "items": [
        {
          "text": "and be filled with the fruit of their schemes.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.31",
            "verseOrgIds": [
              "PRO.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the waywardness of the simple will kill them,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.32",
            "verseOrgIds": [
              "PRO.1.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:32"
      },
      "items": [
        {
          "text": "and the complacency of fools will destroy them;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.32",
            "verseOrgIds": [
              "PRO.1.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "but whoever listens to me will live in safety",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.33",
            "verseOrgIds": [
              "PRO.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:33"
      },
      "items": [
        {
          "text": "and be at ease, without fear of harm.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.33",
            "verseOrgIds": [
              "PRO.1.33"
            ]
          }
        }
      ]
    }
  ],
