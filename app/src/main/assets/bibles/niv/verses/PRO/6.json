      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:30"
      },
      "items": [
        {
          "text": "to satisfy his hunger when he is starving.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.30",
            "verseOrgIds": [
              "PRO.6.30"
            ]
          }
        }
      ]
    },
