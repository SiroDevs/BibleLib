{
  "id": "PRO.6",
  "number": "6",
  "bookId": "PRO",
  "reference": "Prov. 6",
  "copyright": "The Holy Bible, New International Version® NIV® Copyright © 1973, 1978, 1984, 2011 by Biblica, Inc.® Used by Permission of Biblica, Inc.® All rights reserved worldwide.",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PRO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Warnings Against Folly",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "My son, if you have put up security for your neighbor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:1"
      },
      "items": [
        {
          "text": "if you have shaken hands in pledge for a stranger,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.1",
            "verseOrgIds": [
              "PRO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "you have been trapped by what you said,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:2"
      },
      "items": [
        {
          "text": "ensnared by the words of your mouth.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.2",
            "verseOrgIds": [
              "PRO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "So do this, my son, to free yourself,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "since you have fallen into your neighbor's hands:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "Go—to the point of exhaustion—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:3"
      },
      "items": [
        {
          "text": "and give your neighbor no rest!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.3",
            "verseOrgIds": [
              "PRO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allow no sleep to your eyes,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:4"
      },
      "items": [
        {
          "text": "no slumber to your eyelids.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.4",
            "verseOrgIds": [
              "PRO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Free yourself, like a gazelle from the hand of the hunter,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:5"
      },
      "items": [
        {
          "text": "like a bird from the snare of the fowler.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.5",
            "verseOrgIds": [
              "PRO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go to the ant, you sluggard;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:6"
      },
      "items": [
        {
          "text": "consider its ways and be wise!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.6",
            "verseOrgIds": [
              "PRO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "It has no commander,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:7"
      },
      "items": [
        {
          "text": "no overseer or ruler,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.7",
            "verseOrgIds": [
              "PRO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yet it stores its provisions in summer",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:8"
      },
      "items": [
        {
          "text": "and gathers its food at harvest.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.8",
            "verseOrgIds": [
              "PRO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "How long will you lie there, you sluggard?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:9"
      },
      "items": [
        {
          "text": "When will you get up from your sleep?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.9",
            "verseOrgIds": [
              "PRO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A little sleep, a little slumber,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:10"
      },
      "items": [
        {
          "text": "a little folding of the hands to rest—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.10",
            "verseOrgIds": [
              "PRO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "and poverty will come on you like a thief",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:11"
      },
      "items": [
        {
          "text": "and scarcity like an armed man.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.11",
            "verseOrgIds": [
              "PRO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A troublemaker and a villain,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:12"
      },
      "items": [
        {
          "text": "who goes about with a corrupt mouth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.12",
            "verseOrgIds": [
              "PRO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "who winks maliciously with his eye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "signals with his feet",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:13"
      },
      "items": [
        {
          "text": "and motions with his fingers,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.13",
            "verseOrgIds": [
              "PRO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "who plots evil with deceit in his heart—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:14"
      },
      "items": [
        {
          "text": "he always stirs up conflict.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.14",
            "verseOrgIds": [
              "PRO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore disaster will overtake him in an instant;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 6:15"
      },
      "items": [
        {
          "text": "he will suddenly be destroyed—without remedy.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.15",
            "verseOrgIds": [
              "PRO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "There are six things the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.6.16",
                "verseOrgIds": [
                  "PRO.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "hates,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 6:16"
      },
      "items": [
        {
          "text": "seven that are detestable to him:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.16",
            "verseOrgIds": [
              "PRO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "haughty eyes,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:17"
      },
      "items": [
        {
          "text": "a lying tongue,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:17"
      },
      "items": [
        {
          "text": "hands that shed innocent blood,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "a heart that devises wicked schemes,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 6:18"
      },
      "items": [
        {
          "text": "feet that are quick to rush into evil,",
          "type": "text"
        }
      ]
    },
    {
