      "attrs": {
        "style": "q2",
        "vid": "PRO 6:29"
      },
      "items": [
        {
          "text": "no one who touches her will go unpunished.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.29",
            "verseOrgIds": [
              "PRO.6.29"
            ]
          }
        }
      ]
    },
