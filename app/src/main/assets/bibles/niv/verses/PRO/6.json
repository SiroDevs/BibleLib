          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "But a man who commits adultery has no sense;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.32",
            "verseOrgIds": [
              "PRO.6.32"
            ]
          }
        }
