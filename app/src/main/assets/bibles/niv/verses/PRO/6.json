          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet if he is caught, he must pay sevenfold,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.31",
            "verseOrgIds": [
              "PRO.6.31"
            ]
          }
        }
      ]
    },
