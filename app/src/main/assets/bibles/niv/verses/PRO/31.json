                "verseId": "PRO.31.30",
                "verseOrgIds": [
                  "PRO.31.30"
                ]
              }
            }
          ]
        },
        {
          "text": "is to be praised.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
          }
        }
      ]
