        "style": "q2",
        "vid": "PRO 31:30"
      },
      "items": [
        {
          "text": "but a woman who fears the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
          }
        },
