              "attrs": {
                "verseId": "PRO.3.9",
                "verseOrgIds": [
                  "PRO.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "with your wealth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
