          "text": "This will bring health to your body",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:8"
      },
      "items": [
        {
          "text": "and nourishment to your bones.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
