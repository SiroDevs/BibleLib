      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "in all your ways submit to him,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:6"
      },
      "items": [
        {
          "text": "and he will make your paths straight.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
