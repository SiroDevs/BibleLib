                "verseId": "PRO.3.12",
                "verseOrgIds": [
                  "PRO.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "disciplines those he loves,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
