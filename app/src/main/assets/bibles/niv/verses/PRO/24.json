          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "or the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.18",
                "verseOrgIds": [
                  "PRO.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "will see and disapprove",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:18"
      },
      "items": [
        {
          "text": "and turn his wrath away from them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Saying 29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not fret because of evildoers",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:19"
      },
      "items": [
        {
          "text": "or be envious of the wicked,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "for the evildoer has no future hope,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:20"
      },
      "items": [
        {
          "text": "and the lamp of the wicked will be snuffed out.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Saying 30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fear the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.21",
                "verseOrgIds": [
                  "PRO.24.21"
                ]
              }
            }
          ]
        },
        {
          "text": "and the king, my son,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:21"
      },
      "items": [
        {
          "text": "and do not join with rebellious officials,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "for those two will send sudden destruction on them,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:22"
      },
      "items": [
        {
          "text": "and who knows what calamities they can bring?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Further Sayings of the Wise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "These also are sayings of the wise:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:23"
      },
      "items": [
        {
          "text": "To show partiality in judging is not good:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoever says to the guilty, \"You are innocent,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:24"
      },
      "items": [
        {
          "text": "will be cursed by peoples and denounced by nations.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "But it will go well with those who convict the guilty,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:25"
      },
      "items": [
        {
          "text": "and rich blessing will come on them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "An honest answer",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:26"
      },
      "items": [
        {
          "text": "is like a kiss on the lips.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Put your outdoor work in order",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:27"
      },
      "items": [
        {
          "text": "and get your fields ready;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:27"
      },
      "items": [
        {
          "text": "after that, build your house.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not testify against your neighbor without cause—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.28",
            "verseOrgIds": [
              "PRO.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:28"
      },
      "items": [
        {
          "text": "would you use your lips to mislead?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.28",
            "verseOrgIds": [
              "PRO.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not say, \"I'll do to them as they have done to me;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.29",
            "verseOrgIds": [
              "PRO.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:29"
      },
      "items": [
        {
          "text": "I'll pay them back for what they did.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.29",
            "verseOrgIds": [
              "PRO.24.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "I went past the field of a sluggard,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.30",
            "verseOrgIds": [
              "PRO.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:30"
      },
      "items": [
        {
          "text": "past the vineyard of someone who has no sense;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.30",
            "verseOrgIds": [
              "PRO.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "thorns had come up everywhere,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:31"
      },
      "items": [
        {
          "text": "the ground was covered with weeds,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:31"
      },
      "items": [
        {
          "text": "and the stone wall was in ruins.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "I applied my heart to what I observed",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:32"
      },
      "items": [
        {
          "text": "and learned a lesson from what I saw:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "A little sleep, a little slumber,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.33",
            "verseOrgIds": [
              "PRO.24.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:33"
      },
      "items": [
        {
          "text": "a little folding of the hands to rest—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.33",
            "verseOrgIds": [
              "PRO.24.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "and poverty will come on you like a thief",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.34",
            "verseOrgIds": [
              "PRO.24.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:34"
      },
      "items": [
        {
          "text": "and scarcity like an armed man.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.34",
            "verseOrgIds": [
              "PRO.24.34"
            ]
          }
        }
      ]
    }
  ],
