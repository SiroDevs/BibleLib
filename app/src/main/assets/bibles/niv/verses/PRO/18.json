          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A brother wronged is more unyielding than a fortified city;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.19",
            "verseOrgIds": [
              "PRO.18.19"
            ]
          }
        }
      ]
    },
