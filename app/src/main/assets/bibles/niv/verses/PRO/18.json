      "attrs": {
        "style": "q2",
        "vid": "PRO 18:20"
      },
      "items": [
        {
          "text": "with the harvest of their lips they are satisfied.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.20",
            "verseOrgIds": [
              "PRO.18.20"
            ]
          }
        }
      ]
    },
