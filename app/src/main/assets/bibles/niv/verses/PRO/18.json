      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:19"
      },
      "items": [
        {
          "text": "disputes are like the barred gates of a citadel.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.19",
            "verseOrgIds": [
              "PRO.18.19"
            ]
          }
        }
      ]
    },
