          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "From the fruit of their mouth a person's stomach is filled;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.20",
            "verseOrgIds": [
              "PRO.18.20"
            ]
          }
        }
      ]
