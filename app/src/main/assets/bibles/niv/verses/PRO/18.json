      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:18"
      },
      "items": [
        {
          "text": "and keeps strong opponents apart.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.18",
            "verseOrgIds": [
              "PRO.18.18"
            ]
          }
        }
