          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "One who has no sense shakes hands in pledge",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.18",
            "verseOrgIds": [
              "PRO.17.18"
            ]
          }
        }
