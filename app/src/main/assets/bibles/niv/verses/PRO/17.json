          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "If imposing a fine on the innocent is not good,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.26",
            "verseOrgIds": [
              "PRO.17.26"
            ]
          }
        }
