          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wicked accept bribes in secret",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.23",
            "verseOrgIds": [
              "PRO.17.23"
            ]
          }
        }
