      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:20"
      },
      "items": [
        {
          "text": "one whose tongue is perverse falls into trouble.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.20",
            "verseOrgIds": [
              "PRO.17.20"
            ]
          }
        }
      ]
    },
    {
