          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A foolish son brings grief to his father",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.25",
            "verseOrgIds": [
              "PRO.17.25"
            ]
