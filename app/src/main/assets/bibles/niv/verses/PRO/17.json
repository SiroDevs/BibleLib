          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A cheerful heart is good medicine,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.22",
            "verseOrgIds": [
              "PRO.17.22"
            ]
          }
        }
      ]
