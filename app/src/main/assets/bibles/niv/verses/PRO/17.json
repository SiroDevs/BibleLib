          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "One whose heart is corrupt does not prosper;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.20",
            "verseOrgIds": [
              "PRO.17.20"
            ]
          }
        }
      ]
