      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:22"
      },
      "items": [
        {
          "text": "but a crushed spirit dries up the bones.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.22",
            "verseOrgIds": [
              "PRO.17.22"
            ]
          }
        }
      ]
    },
    {
