          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoever loves a quarrel loves sin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.19",
            "verseOrgIds": [
              "PRO.17.19"
            ]
          }
        }
      ]
    },
