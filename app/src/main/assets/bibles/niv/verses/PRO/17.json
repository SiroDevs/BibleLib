          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A discerning person keeps wisdom in view,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.24",
            "verseOrgIds": [
              "PRO.17.24"
            ]
          }
        }
