  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "PRO 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better a dry crust with peace and quiet",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:1"
      },
      "items": [
        {
          "text": "than a house full of feasting, with strife.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A prudent servant will rule over a disgraceful son",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:2"
      },
      "items": [
        {
          "text": "and will share the inheritance as one of the family.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The crucible for silver and the furnace for gold,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:3"
      },
      "items": [
        {
          "text": "but the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.3",
                "verseOrgIds": [
                  "PRO.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "tests the heart.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wicked person listens to deceitful lips;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:4"
      },
      "items": [
        {
          "text": "a liar pays attention to a destructive tongue.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoever mocks the poor shows contempt for their Maker;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:5"
      },
      "items": [
        {
          "text": "whoever gloats over disaster will not go unpunished.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Children's children are a crown to the aged,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:6"
      },
      "items": [
        {
          "text": "and parents are the pride of their children.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloquent lips are unsuited to a godless fool—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:7"
      },
      "items": [
        {
          "text": "how much worse lying lips to a ruler!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bribe is seen as a charm by the one who gives it;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:8"
      },
      "items": [
        {
          "text": "they think success will come at every turn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoever would foster love covers over an offense,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:9"
      },
      "items": [
        {
          "text": "but whoever repeats the matter separates close friends.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A rebuke impresses a discerning person",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:10"
      },
      "items": [
        {
          "text": "more than a hundred lashes a fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evildoers foster rebellion against God;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:11"
      },
      "items": [
        {
          "text": "the messenger of death will be sent against them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better to meet a bear robbed of her cubs",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:12"
      },
      "items": [
        {
          "text": "than a fool bent on folly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evil will never leave the house",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:13"
      },
      "items": [
        {
          "text": "of one who pays back evil for good.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Starting a quarrel is like breaching a dam;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:14"
      },
      "items": [
        {
          "text": "so drop the matter before a dispute breaks out.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acquitting the guilty and condemning the innocent—",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:15"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.15",
                "verseOrgIds": [
                  "PRO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "detests them both.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why should fools have money in hand to buy wisdom,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:16"
      },
      "items": [
        {
          "text": "when they are not able to understand it?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A friend loves at all times,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
              "PRO.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:17"
      },
      "items": [
        {
          "text": "and a brother is born for a time of adversity.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
