          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "To have a fool for a child brings grief;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.21",
            "verseOrgIds": [
              "PRO.17.21"
            ]
          }
        }
      ]
    },
