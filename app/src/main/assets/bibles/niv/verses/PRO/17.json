      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:18"
      },
      "items": [
        {
          "text": "and puts up security for a neighbor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.18",
            "verseOrgIds": [
              "PRO.17.18"
            ]
          }
        }
      ]
