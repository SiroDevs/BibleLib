      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:19"
      },
      "items": [
        {
          "text": "whoever builds a high gate invites destruction.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.19",
            "verseOrgIds": [
              "PRO.17.19"
            ]
          }
        }
      ]
    },
    {
