      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:21"
      },
      "items": [
        {
          "text": "there is no joy for the parent of a godless fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.21",
            "verseOrgIds": [
              "PRO.17.21"
            ]
          }
        }
      ]
    },
    {
