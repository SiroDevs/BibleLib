      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 17:23"
      },
      "items": [
        {
          "text": "to pervert the course of justice.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.23",
            "verseOrgIds": [
              "PRO.17.23"
            ]
          }
        }
      ]
    },
