  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "PRO 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like snow in summer or rain in harvest,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:1"
      },
      "items": [
        {
          "text": "honor is not fitting for a fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like a fluttering sparrow or a darting swallow,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:2"
      },
      "items": [
        {
          "text": "an undeserved curse does not come to rest.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A whip for the horse, a bridle for the donkey,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:3"
      },
      "items": [
        {
          "text": "and a rod for the backs of fools!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not answer a fool according to his folly,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:4"
      },
      "items": [
        {
          "text": "or you yourself will be just like him.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Answer a fool according to his folly,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:5"
      },
      "items": [
        {
          "text": "or he will be wise in his own eyes.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sending a message by the hands of a fool",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:6"
      },
      "items": [
        {
          "text": "is like cutting off one's feet or drinking poison.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like the useless legs of one who is lame",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:7"
      },
      "items": [
        {
          "text": "is a proverb in the mouth of a fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like tying a stone in a sling",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:8"
      },
      "items": [
        {
          "text": "is the giving of honor to a fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like a thornbush in a drunkard's hand",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:9"
      },
      "items": [
        {
          "text": "is a proverb in the mouth of a fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like an archer who wounds at random",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:10"
      },
      "items": [
        {
          "text": "is one who hires a fool or any passer-by.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "As a dog returns to its vomit,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:11"
      },
      "items": [
        {
          "text": "so fools repeat their folly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do you see a person wise in their own eyes?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:12"
      },
      "items": [
        {
          "text": "There is more hope for a fool than for them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sluggard says, \"There's a lion in the road,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:13"
      },
      "items": [
        {
          "text": "a fierce lion roaming the streets!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "As a door turns on its hinges,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:14"
      },
      "items": [
        {
          "text": "so a sluggard turns on his bed.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sluggard buries his hand in the dish;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:15"
      },
      "items": [
        {
          "text": "he is too lazy to bring it back to his mouth.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sluggard is wiser in his own eyes",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:16"
      },
      "items": [
        {
          "text": "than seven people who answer discreetly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like one who grabs a stray dog by the ears",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.17",
            "verseOrgIds": [
              "PRO.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:17"
      },
      "items": [
        {
          "text": "is someone who rushes into a quarrel not their own.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.17",
            "verseOrgIds": [
              "PRO.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like a maniac shooting",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.18",
            "verseOrgIds": [
              "PRO.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:18"
      },
      "items": [
        {
          "text": "flaming arrows of death",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.18",
            "verseOrgIds": [
              "PRO.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "is one who deceives their neighbor",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.19",
            "verseOrgIds": [
              "PRO.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:19"
      },
      "items": [
        {
          "text": "and says, \"I was only joking!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.19",
            "verseOrgIds": [
              "PRO.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Without wood a fire goes out;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.20",
            "verseOrgIds": [
              "PRO.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:20"
      },
      "items": [
        {
          "text": "without a gossip a quarrel dies down.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.20",
            "verseOrgIds": [
              "PRO.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "As charcoal to embers and as wood to fire,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:21"
      },
      "items": [
        {
          "text": "so is a quarrelsome person for kindling strife.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "The words of a gossip are like choice morsels;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.22",
            "verseOrgIds": [
              "PRO.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:22"
      },
      "items": [
        {
          "text": "they go down to the inmost parts.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.22",
            "verseOrgIds": [
              "PRO.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like a coating of silver dross on earthenware",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:23"
      },
      "items": [
        {
          "text": "are fervent",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        },
        {
          "text": "lips with an evil heart.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enemies disguise themselves with their lips,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:24"
      },
      "items": [
        {
          "text": "but in their hearts they harbor deceit.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though their speech is charming, do not believe them,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:25"
      },
      "items": [
        {
          "text": "for seven abominations fill their hearts.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their malice may be concealed by deception,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.26",
            "verseOrgIds": [
              "PRO.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:26"
      },
      "items": [
        {
          "text": "but their wickedness will be exposed in the assembly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.26",
            "verseOrgIds": [
              "PRO.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoever digs a pit will fall into it;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
              "PRO.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:27"
      },
      "items": [
        {
          "text": "if someone rolls a stone, it will roll back on them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
              "PRO.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lying tongue hates those it hurts,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.28",
            "verseOrgIds": [
              "PRO.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:28"
      },
      "items": [
        {
          "text": "and a flattering mouth works ruin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.28",
            "verseOrgIds": [
              "PRO.26.28"
            ]
          }
        }
      ]
    }
