        "style": "s1"
      },
      "items": [
        {
          "text": "Jerusalem as a Useless Vine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
