      },
      "items": [
        {
          "text": "the cup of ruin and desolation,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "the cup of your sister Samaria.",
