          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "You will be filled with drunkenness and sorrow,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
