          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "You will drink it and drain it dry",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "and chew on its pieces—",
