          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EZK.30.10",
                "verseOrgIds": [
                  "EZK.30.10"
                ]
              }
            }
          ]
        },
        {
          "text": "says:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:10"
      },
      "items": [
        {
          "text": "\" 'I will put an end to the hordes of Egypt",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
