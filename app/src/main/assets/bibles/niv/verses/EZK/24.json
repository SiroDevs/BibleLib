          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Now your impurity is lewdness. Because I tried to cleanse you but you would not be cleansed from your impurity, you will not be clean again until my wrath against you has subsided.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        }
      ]
    },
