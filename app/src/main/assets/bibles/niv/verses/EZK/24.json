        "style": "s1"
      },
      "items": [
        {
          "text": "Ezekiel's Wife Dies",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
