            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.14",
                "verseOrgIds": [
                  "EZK.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "have spoken. The time has come for me to act. I will not hold back; I will not have pity, nor will I relent. You will be judged according to your conduct and your actions, declares the Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.14",
                "verseOrgIds": [
                  "EZK.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
