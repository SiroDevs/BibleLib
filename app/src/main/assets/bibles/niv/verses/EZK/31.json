    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "In the eleventh year, in the third month on the first day, the word of the",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.1",
                "verseOrgIds": [
                  "EZK.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": "came to me:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Son of man, say to Pharaoh king of Egypt and to his hordes:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:2"
      },
      "items": [
        {
          "text": "\" 'Who can be compared with you in majesty?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Consider Assyria, once a cedar in Lebanon,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "with beautiful branches overshadowing the forest;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "it towered on high,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "its top above the thick foliage.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The waters nourished it,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "deep springs made it grow tall;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:4"
      },
      "items": [
        {
