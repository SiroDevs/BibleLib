  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOB 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "My spirit is broken,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "my days are cut short,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "the grave awaits me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely mockers surround me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:2"
      },
      "items": [
        {
          "text": "my eyes must dwell on their hostility.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Give me, O God, the pledge you demand.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:3"
      },
      "items": [
        {
          "text": "Who else will put up security for me?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have closed their minds to understanding;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:4"
      },
      "items": [
        {
          "text": "therefore you will not let them triumph.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "If anyone denounces their friends for reward,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:5"
      },
      "items": [
        {
          "text": "the eyes of their children will fail.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"God has made me a byword to everyone,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:6"
      },
      "items": [
        {
          "text": "a man in whose face people spit.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "My eyes have grown dim with grief;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:7"
      },
      "items": [
        {
          "text": "my whole frame is but a shadow.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The upright are appalled at this;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:8"
      },
      "items": [
        {
          "text": "the innocent are aroused against the ungodly.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nevertheless, the righteous will hold to their ways,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:9"
      },
      "items": [
        {
          "text": "and those with clean hands will grow stronger.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But come on, all of you, try again!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:10"
      },
      "items": [
        {
          "text": "I will not find a wise man among you.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "My days have passed, my plans are shattered.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:11"
      },
      "items": [
        {
          "text": "Yet the desires of my heart",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "turn night into day;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:12"
      },
      "items": [
        {
          "text": "in the face of the darkness light is near.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "If the only home I hope for is the grave,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:13"
      },
      "items": [
        {
          "text": "if I spread out my bed in the realm of darkness,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "if I say to corruption, 'You are my father,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:14"
      },
      "items": [
        {
          "text": "and to the worm, 'My mother' or 'My sister,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "where then is my hope—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:15"
      },
      "items": [
        {
          "text": "who can see any hope for me?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will it go down to the gates of death?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:16"
      },
      "items": [
        {
          "text": "Will we descend together into the dust?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    }
  ],
