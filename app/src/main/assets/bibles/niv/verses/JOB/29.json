  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JOB 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Job's Final Defense",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Job continued his discourse:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.1",
            "verseOrgIds": [
              "JOB.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"How I long for the months gone by,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:2"
      },
      "items": [
        {
          "text": "for the days when God watched over me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "when his lamp shone on my head",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:3"
      },
      "items": [
        {
          "text": "and by his light I walked through darkness!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh, for the days when I was in my prime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:4"
      },
      "items": [
        {
          "text": "when God's intimate friendship blessed my house,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "when the Almighty was still with me",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:5"
      },
      "items": [
        {
          "text": "and my children were around me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "when my path was drenched with cream",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:6"
      },
      "items": [
        {
          "text": "and the rock poured out for me streams of olive oil.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"When I went to the gate of the city",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:7"
      },
      "items": [
        {
          "text": "and took my seat in the public square,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "the young men saw me and stepped aside",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:8"
      },
      "items": [
        {
          "text": "and the old men rose to their feet;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "the chief men refrained from speaking",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:9"
      },
      "items": [
        {
          "text": "and covered their mouths with their hands;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "the voices of the nobles were hushed,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:10"
      },
      "items": [
        {
          "text": "and their tongues stuck to the roof of their mouths.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoever heard me spoke well of me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:11"
      },
      "items": [
        {
          "text": "and those who saw me commended me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "because I rescued the poor who cried for help,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:12"
      },
      "items": [
        {
          "text": "and the fatherless who had none to assist them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The one who was dying blessed me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:13"
      },
      "items": [
        {
          "text": "I made the widow's heart sing.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I put on righteousness as my clothing;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:14"
      },
      "items": [
        {
          "text": "justice was my robe and my turban.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I was eyes to the blind",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:15"
      },
      "items": [
        {
          "text": "and feet to the lame.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I was a father to the needy;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:16"
      },
      "items": [
        {
          "text": "I took up the case of the stranger.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I broke the fangs of the wicked",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:17"
      },
      "items": [
        {
          "text": "and snatched the victims from their teeth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I thought, 'I will die in my own house,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:18"
      },
      "items": [
        {
          "text": "my days as numerous as the grains of sand.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "My roots will reach to the water,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.19",
            "verseOrgIds": [
              "JOB.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:19"
      },
      "items": [
        {
          "text": "and the dew will lie all night on my branches.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.19",
            "verseOrgIds": [
              "JOB.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "My glory will not fade;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.20",
            "verseOrgIds": [
              "JOB.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:20"
      },
      "items": [
        {
          "text": "the bow will be ever new in my hand.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.20",
            "verseOrgIds": [
              "JOB.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"People listened to me expectantly,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.21",
            "verseOrgIds": [
              "JOB.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:21"
      },
      "items": [
        {
          "text": "waiting in silence for my counsel.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.21",
            "verseOrgIds": [
              "JOB.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "After I had spoken, they spoke no more;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:22"
      },
      "items": [
        {
          "text": "my words fell gently on their ears.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.22",
            "verseOrgIds": [
              "JOB.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "They waited for me as for showers",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:23"
      },
      "items": [
        {
          "text": "and drank in my words as the spring rain.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.23",
            "verseOrgIds": [
              "JOB.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I smiled at them, they scarcely believed it;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.24",
            "verseOrgIds": [
              "JOB.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:24"
      },
      "items": [
        {
          "text": "the light of my face was precious to them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.24",
            "verseOrgIds": [
              "JOB.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "I chose the way for them and sat as their chief;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:25"
      },
      "items": [
        {
          "text": "I dwelt as a king among his troops;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 29:25"
      },
      "items": [
        {
          "text": "I was like one who comforts mourners.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.25",
            "verseOrgIds": [
              "JOB.29.25"
            ]
          }
        }
      ]
    }
  ],
