  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "JOB 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Job replied:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.1",
            "verseOrgIds": [
              "JOB.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"How you have helped the powerless!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:2"
      },
      "items": [
        {
          "text": "How you have saved the arm that is feeble!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "What advice you have offered to one without wisdom!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:3"
      },
      "items": [
        {
          "text": "And what great insight you have displayed!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who has helped you utter these words?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:4"
      },
      "items": [
        {
          "text": "And whose spirit spoke from your mouth?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"The dead are in deep anguish,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:5"
      },
      "items": [
        {
          "text": "those beneath the waters and all that live in them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The realm of the dead is naked before God;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:6"
      },
      "items": [
        {
          "text": "Destruction",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        },
        {
          "text": "lies uncovered.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "He spreads out the northern skies over empty space;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:7"
      },
      "items": [
        {
          "text": "he suspends the earth over nothing.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He wraps up the waters in his clouds,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:8"
      },
      "items": [
        {
          "text": "yet the clouds do not burst under their weight.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He covers the face of the full moon,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:9"
      },
      "items": [
        {
          "text": "spreading his clouds over it.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He marks out the horizon on the face of the waters",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:10"
      },
      "items": [
        {
          "text": "for a boundary between light and darkness.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The pillars of the heavens quake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:11"
      },
      "items": [
        {
          "text": "aghast at his rebuke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "By his power he churned up the sea;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:12"
      },
      "items": [
        {
          "text": "by his wisdom he cut Rahab to pieces.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "By his breath the skies became fair;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:13"
      },
      "items": [
        {
          "text": "his hand pierced the gliding serpent.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "And these are but the outer fringe of his works;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "how faint the whisper we hear of him!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "Who then can understand the thunder of his power?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    }
  ],
