  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JOB 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bildad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Bildad the Shuhite replied:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.1",
            "verseOrgIds": [
              "JOB.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"How long will you say such things?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:2"
      },
      "items": [
        {
          "text": "Your words are a blustering wind.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Does God pervert justice?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:3"
      },
      "items": [
        {
          "text": "Does the Almighty pervert what is right?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "When your children sinned against him,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:4"
      },
      "items": [
        {
          "text": "he gave them over to the penalty of their sin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if you will seek God earnestly",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:5"
      },
      "items": [
        {
          "text": "and plead with the Almighty,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "if you are pure and upright,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "even now he will rouse himself on your behalf",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "and restore you to your prosperous state.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your beginnings will seem humble,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:7"
      },
      "items": [
        {
          "text": "so prosperous will your future be.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ask the former generation",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:8"
      },
      "items": [
        {
          "text": "and find out what their ancestors learned,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "for we were born only yesterday and know nothing,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:9"
      },
      "items": [
        {
          "text": "and our days on earth are but a shadow.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will they not instruct you and tell you?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:10"
      },
      "items": [
        {
          "text": "Will they not bring forth words from their understanding?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can papyrus grow tall where there is no marsh?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:11"
      },
      "items": [
        {
          "text": "Can reeds thrive without water?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "While still growing and uncut,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:12"
      },
      "items": [
        {
          "text": "they wither more quickly than grass.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Such is the destiny of all who forget God;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:13"
      },
      "items": [
        {
          "text": "so perishes the hope of the godless.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "What they trust in is fragile",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:14"
      },
      "items": [
        {
          "text": "what they rely on is a spider's web.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "They lean on the web, but it gives way;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:15"
      },
      "items": [
        {
          "text": "they cling to it, but it does not hold.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are like a well-watered plant in the sunshine,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:16"
      },
      "items": [
        {
          "text": "spreading its shoots over the garden;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "it entwines its roots around a pile of rocks",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:17"
      },
      "items": [
        {
          "text": "and looks for a place among the stones.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "But when it is torn from its spot,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:18"
      },
      "items": [
        {
          "text": "that place disowns it and says, 'I never saw you.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.18",
            "verseOrgIds": [
              "JOB.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely its life withers away,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.19",
            "verseOrgIds": [
              "JOB.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:19"
      },
      "items": [
        {
          "text": "and",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.19",
            "verseOrgIds": [
              "JOB.8.19"
            ]
          }
        },
        {
          "text": "from the soil other plants grow.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.19",
            "verseOrgIds": [
              "JOB.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
