  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "JOB 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text"
            }
          ]
        },
        {
          "text": "Speaks",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOB.38.1",
                "verseOrgIds": [
                  "JOB.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": "spoke to Job out of the storm. He said:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Who is this that obscures my plans",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:2"
      },
      "items": [
        {
          "text": "with words without knowledge?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Brace yourself like a man;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "I will question you,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "and you shall answer me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Where were you when I laid the earth's foundation?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:4"
      },
      "items": [
        {
          "text": "Tell me, if you understand.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who marked off its dimensions? Surely you know!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:5"
      },
      "items": [
        {
          "text": "Who stretched a measuring line across it?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "On what were its footings set,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:6"
      },
      "items": [
        {
          "text": "or who laid its cornerstone—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "while the morning stars sang together",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:7"
      },
      "items": [
        {
          "text": "and all the angels",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        },
        {
          "text": "shouted for joy?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Who shut up the sea behind doors",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:8"
      },
      "items": [
        {
          "text": "when it burst forth from the womb,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "when I made the clouds its garment",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:9"
      },
      "items": [
        {
          "text": "and wrapped it in thick darkness,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "when I fixed limits for it",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:10"
      },
      "items": [
        {
          "text": "and set its doors and bars in place,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "when I said, 'This far you may come and no farther;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:11"
      },
      "items": [
        {
          "text": "here is where your proud waves halt'?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Have you ever given orders to the morning,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:12"
      },
      "items": [
        {
          "text": "or shown the dawn its place,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "that it might take the earth by the edges",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:13"
      },
      "items": [
        {
          "text": "and shake the wicked out of it?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "The earth takes shape like clay under a seal;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:14"
      },
      "items": [
        {
          "text": "its features stand out like those of a garment.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wicked are denied their light,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:15"
      },
      "items": [
        {
          "text": "and their upraised arm is broken.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Have you journeyed to the springs of the sea",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:16"
      },
      "items": [
        {
          "text": "or walked in the recesses of the deep?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Have the gates of death been shown to you?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:17"
      },
      "items": [
        {
          "text": "Have you seen the gates of the deepest darkness?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Have you comprehended the vast expanses of the earth?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:18"
      },
      "items": [
        {
          "text": "Tell me, if you know all this.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
