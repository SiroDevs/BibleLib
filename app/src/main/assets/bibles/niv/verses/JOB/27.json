  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "JOB 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Job's Final Word to His Friends",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Job continued his discourse:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.1",
            "verseOrgIds": [
              "JOB.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"As surely as God lives, who has denied me justice,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:2"
      },
      "items": [
        {
          "text": "the Almighty, who has made my life bitter,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "as long as I have life within me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:3"
      },
      "items": [
        {
          "text": "the breath of God in my nostrils,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "my lips will not say anything wicked,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:4"
      },
      "items": [
        {
          "text": "and my tongue will not utter lies.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will never admit you are in the right;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:5"
      },
      "items": [
        {
          "text": "till I die, I will not deny my integrity.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will maintain my innocence and never let go of it;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:6"
      },
      "items": [
        {
          "text": "my conscience will not reproach me as long as I live.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"May my enemy be like the wicked,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:7"
      },
      "items": [
        {
          "text": "my adversary like the unjust!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "For what hope have the godless when they are cut off,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:8"
      },
      "items": [
        {
          "text": "when God takes away their life?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Does God listen to their cry",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:9"
      },
      "items": [
        {
          "text": "when distress comes upon them?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will they find delight in the Almighty?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:10"
      },
      "items": [
        {
          "text": "Will they call on God at all times?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I will teach you about the power of God;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:11"
      },
      "items": [
        {
          "text": "the ways of the Almighty I will not conceal.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have all seen this yourselves.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:12"
      },
      "items": [
        {
          "text": "Why then this meaningless talk?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Here is the fate God allots to the wicked,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:13"
      },
      "items": [
        {
          "text": "the heritage a ruthless man receives from the Almighty:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "However many his children, their fate is the sword;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:14"
      },
      "items": [
        {
          "text": "his offspring will never have enough to eat.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The plague will bury those who survive him,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:15"
      },
      "items": [
        {
          "text": "and their widows will not weep for them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though he heaps up silver like dust",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:16"
      },
      "items": [
        {
          "text": "and clothes like piles of clay,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "what he lays up the righteous will wear,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:17"
      },
      "items": [
        {
          "text": "and the innocent will divide his silver.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "The house he builds is like a moth's cocoon,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:18"
      },
      "items": [
        {
          "text": "like a hut made by a watchman.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "He lies down wealthy, but will do so no more;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:19"
      },
      "items": [
        {
          "text": "when he opens his eyes, all is gone.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Terrors overtake him like a flood;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.20",
            "verseOrgIds": [
              "JOB.27.20"
            ]
          }
        }
      ]
