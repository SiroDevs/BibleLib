  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "JOB 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But now, Job, listen to my words;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:1"
      },
      "items": [
        {
          "text": "pay attention to everything I say.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am about to open my mouth;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:2"
      },
      "items": [
        {
          "text": "my words are on the tip of my tongue.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "My words come from an upright heart;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:3"
      },
      "items": [
        {
          "text": "my lips sincerely speak what I know.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Spirit of God has made me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:4"
      },
      "items": [
        {
          "text": "the breath of the Almighty gives me life.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Answer me then, if you can;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:5"
      },
      "items": [
        {
          "text": "stand up and argue your case before me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am the same as you in God's sight;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:6"
      },
      "items": [
        {
          "text": "I too am a piece of clay.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No fear of me should alarm you,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:7"
      },
      "items": [
        {
          "text": "nor should my hand be heavy on you.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But you have said in my hearing—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:8"
      },
      "items": [
        {
          "text": "I heard the very words—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'I am pure, I have done no wrong;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:9"
      },
      "items": [
        {
          "text": "I am clean and free from sin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet God has found fault with me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:10"
      },
      "items": [
        {
          "text": "he considers me his enemy.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "He fastens my feet in shackles;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:11"
      },
      "items": [
        {
          "text": "he keeps close watch on all my paths.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But I tell you, in this you are not right,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:12"
      },
      "items": [
        {
          "text": "for God is greater than any mortal.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why do you complain to him",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:13"
      },
      "items": [
        {
          "text": "that he responds to no one's words",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "For God does speak—now one way, now another—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:14"
      },
      "items": [
        {
          "text": "though no one perceives it.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "In a dream, in a vision of the night,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "when deep sleep falls on people",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "as they slumber in their beds,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "he may speak in their ears",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:16"
      },
      "items": [
        {
          "text": "and terrify them with warnings,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "to turn them from wrongdoing",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:17"
      },
      "items": [
        {
          "text": "and keep them from pride,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "to preserve them from the pit,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:18"
      },
      "items": [
        {
          "text": "their lives from perishing by the sword.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Or someone may be chastened on a bed of pain",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:19"
      },
      "items": [
        {
          "text": "with constant distress in their bones,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "so that their body finds food repulsive",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:20"
      },
      "items": [
        {
          "text": "and their soul loathes the choicest meal.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their flesh wastes away to nothing,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:21"
      },
      "items": [
        {
          "text": "and their bones, once hidden, now stick out.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "They draw near to the pit,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:22"
      },
      "items": [
        {
          "text": "and their life to the messengers of death.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet if there is an angel at their side,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "text": "a messenger, one out of a thousand,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "text": "sent to tell them how to be upright,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "and he is gracious to that person and says to God,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:24"
      },
      "items": [
        {
          "text": "'Spare them from going down to the pit;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:24"
      },
      "items": [
        {
          "text": "I have found a ransom for them—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "let their flesh be renewed like a child's;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:25"
      },
      "items": [
        {
          "text": "let them be restored as in the days of their youth'—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "then that person can pray to God and find favor with him,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:26"
      },
      "items": [
        {
          "text": "they will see God's face and shout for joy;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:26"
      },
      "items": [
        {
          "text": "he will restore them to full well-being.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "And they will go to others and say,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:27"
      },
      "items": [
        {
          "text": "'I have sinned, I have perverted what is right,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:27"
      },
      "items": [
        {
          "text": "but I did not get what I deserved.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "God has delivered me from going down to the pit,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:28"
      },
      "items": [
        {
          "text": "and I shall live to enjoy the light of life.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"God does all these things to a person—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:29"
      },
      "items": [
        {
          "text": "twice, even three times—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "to turn them back from the pit,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:30"
      },
      "items": [
        {
          "text": "that the light of life may shine on them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pay attention, Job, and listen to me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:31"
      },
      "items": [
        {
          "text": "be silent, and I will speak.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "If you have anything to say, answer me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:32"
      },
      "items": [
        {
          "text": "speak up, for I want to vindicate you.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if not, then listen to me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.33",
            "verseOrgIds": [
              "JOB.33.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:33"
      },
      "items": [
        {
          "text": "be silent, and I will teach you wisdom.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.33",
            "verseOrgIds": [
              "JOB.33.33"
            ]
          }
        }
      ]
    }
