          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But as a mountain erodes and crumbles",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.18",
            "verseOrgIds": [
              "JOB.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:18"
      },
      "items": [
        {
          "text": "and as a rock is moved from its place,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.18",
            "verseOrgIds": [
              "JOB.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
