          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "as water wears away stones",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        }
      ]
    },
