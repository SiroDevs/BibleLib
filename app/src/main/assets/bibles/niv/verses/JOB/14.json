      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:21"
      },
      "items": [
        {
          "text": "if their offspring are brought low, they do not see it.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        }
      ]
    },
    {
