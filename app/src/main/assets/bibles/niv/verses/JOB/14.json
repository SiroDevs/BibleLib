      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:19"
      },
      "items": [
        {
          "text": "and torrents wash away the soil,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:19"
      },
      "items": [
        {
          "text": "so you destroy a person's hope.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "You overpower them once for all, and they are gone;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.20",
            "verseOrgIds": [
              "JOB.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:20"
      },
      "items": [
        {
          "text": "you change their countenance and send them away.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.20",
            "verseOrgIds": [
              "JOB.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "If their children are honored, they do not know it;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        }
      ]
    },
