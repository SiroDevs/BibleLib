              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "They feel but the pain of their own bodies",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.22",
            "verseOrgIds": [
              "JOB.14.22"
            ]
          }
