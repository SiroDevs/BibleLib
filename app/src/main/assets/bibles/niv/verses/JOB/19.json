          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        },
        {
          "text": "in",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        },
