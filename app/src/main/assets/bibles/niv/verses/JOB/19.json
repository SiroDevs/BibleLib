      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:28"
      },
      "items": [
        {
          "text": "since the root of the trouble lies in him,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        },
        {
          "text": "'",
