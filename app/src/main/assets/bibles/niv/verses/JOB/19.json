      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:23"
      },
      "items": [
        {
          "text": "that they were written on a scroll,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
