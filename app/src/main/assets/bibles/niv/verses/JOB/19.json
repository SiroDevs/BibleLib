  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOB 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Job replied:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.1",
            "verseOrgIds": [
              "JOB.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"How long will you torment me",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:2"
      },
      "items": [
        {
          "text": "and crush me with words?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ten times now you have reproached me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:3"
      },
      "items": [
        {
          "text": "shamelessly you attack me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "If it is true that I have gone astray,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:4"
      },
      "items": [
        {
          "text": "my error remains my concern alone.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "If indeed you would exalt yourselves above me",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:5"
      },
      "items": [
        {
          "text": "and use my humiliation against me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "then know that God has wronged me",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:6"
      },
      "items": [
        {
          "text": "and drawn his net around me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Though I cry, 'Violence!' I get no response;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:7"
      },
      "items": [
        {
          "text": "though I call for help, there is no justice.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He has blocked my way so I cannot pass;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:8"
      },
      "items": [
        {
          "text": "he has shrouded my paths in darkness.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He has stripped me of my honor",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:9"
      },
      "items": [
        {
          "text": "and removed the crown from my head.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He tears me down on every side till I am gone;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:10"
      },
      "items": [
        {
          "text": "he uproots my hope like a tree.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "His anger burns against me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:11"
      },
      "items": [
        {
          "text": "he counts me among his enemies.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "His troops advance in force;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "they build a siege ramp against me",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "and encamp around my tent.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"He has alienated my family from me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:13"
      },
      "items": [
        {
          "text": "my acquaintances are completely estranged from me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "My relatives have gone away;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:14"
      },
      "items": [
        {
          "text": "my closest friends have forgotten me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "My guests and my female servants count me a foreigner;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:15"
      },
      "items": [
        {
          "text": "they look on me as on a stranger.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I summon my servant, but he does not answer,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:16"
      },
      "items": [
        {
          "text": "though I beg him with my own mouth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "My breath is offensive to my wife;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:17"
      },
      "items": [
        {
          "text": "I am loathsome to my own family.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Even the little boys scorn me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:18"
      },
      "items": [
        {
          "text": "when I appear, they ridicule me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "All my intimate friends detest me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:19"
      },
      "items": [
        {
          "text": "those I love have turned against me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am nothing but skin and bones;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
    },
