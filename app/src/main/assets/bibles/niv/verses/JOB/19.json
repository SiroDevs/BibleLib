      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:20"
      },
      "items": [
        {
          "text": "I have escaped only by the skin of my teeth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
    },
    {
