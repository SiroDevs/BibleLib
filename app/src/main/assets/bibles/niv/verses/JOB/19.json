      "attrs": {
        "style": "q2",
        "vid": "JOB 19:24"
      },
      "items": [
        {
          "text": "or engraved in rock forever!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
      ]
