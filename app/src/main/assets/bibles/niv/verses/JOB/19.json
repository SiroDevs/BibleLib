          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why do you pursue me as God does?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:22"
      },
      "items": [
        {
          "text": "Will you never get enough of my flesh?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
    {
