      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:25"
      },
      "items": [
        {
          "text": "and that in the end he will stand on the earth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
