          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oh, that my words were recorded,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
