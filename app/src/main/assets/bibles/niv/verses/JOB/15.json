      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:30"
      },
      "items": [
        {
          "text": "a flame will wither his shoots,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.30",
            "verseOrgIds": [
              "JOB.15.30"
            ]
          }
        }
      ]
    },
