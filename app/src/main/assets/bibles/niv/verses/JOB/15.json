      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:21"
      },
      "items": [
        {
          "text": "when all seems well, marauders attack him.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.21",
            "verseOrgIds": [
              "JOB.15.21"
            ]
          }
        }
      ]
    },
    {
