          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let him not deceive himself by trusting what is worthless,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.31",
            "verseOrgIds": [
              "JOB.15.31"
            ]
          }
        }
