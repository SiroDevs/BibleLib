          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "He despairs of escaping the realm of darkness;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.22",
            "verseOrgIds": [
              "JOB.15.22"
            ]
