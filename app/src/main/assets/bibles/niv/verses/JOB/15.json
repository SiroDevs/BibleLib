          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Terrifying sounds fill his ears;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.21",
            "verseOrgIds": [
              "JOB.15.21"
            ]
          }
        }
