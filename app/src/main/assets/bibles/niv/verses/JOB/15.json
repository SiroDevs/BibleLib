          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will be like a vine stripped of its unripe grapes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.33",
            "verseOrgIds": [
              "JOB.15.33"
            ]
          }
