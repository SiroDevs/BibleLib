          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Before his time he will wither,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.32",
            "verseOrgIds": [
              "JOB.15.32"
            ]
          }
