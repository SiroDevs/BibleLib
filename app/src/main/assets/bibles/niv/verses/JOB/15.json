      "attrs": {
        "style": "q2",
        "vid": "JOB 15:29"
      },
      "items": [
        {
          "text": "nor will his possessions spread over the land.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.29",
            "verseOrgIds": [
              "JOB.15.29"
            ]
          }
        }
      ]
    },
