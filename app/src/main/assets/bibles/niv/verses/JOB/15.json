      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:24"
      },
      "items": [
        {
          "text": "troubles overwhelm him, like a king poised to attack,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.24",
            "verseOrgIds": [
              "JOB.15.24"
            ]
          }
        }
      ]
    },
