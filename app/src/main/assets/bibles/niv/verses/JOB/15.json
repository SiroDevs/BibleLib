      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:31"
      },
      "items": [
        {
          "text": "for he will get nothing in return.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.31",
            "verseOrgIds": [
              "JOB.15.31"
            ]
          }
        }
      ]
    },
