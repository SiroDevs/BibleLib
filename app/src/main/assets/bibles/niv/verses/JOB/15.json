          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "He wanders about for food like a vulture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.23",
            "verseOrgIds": [
              "JOB.15.23"
            ]
          }
        }
