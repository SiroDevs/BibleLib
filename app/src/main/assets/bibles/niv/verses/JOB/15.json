      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:23"
      },
      "items": [
        {
          "text": "he knows the day of darkness is at hand.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.23",
            "verseOrgIds": [
              "JOB.15.23"
            ]
          }
        }
      ]
    },
    {
