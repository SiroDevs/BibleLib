      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "If only I had never come into being,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.19",
            "verseOrgIds": [
              "JOB.10.19"
            ]
          }
        }
      ]
    },
