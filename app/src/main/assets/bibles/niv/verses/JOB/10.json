      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:21"
      },
      "items": [
        {
          "text": "to the land of gloom and utter darkness,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.21",
            "verseOrgIds": [
              "JOB.10.21"
            ]
          }
