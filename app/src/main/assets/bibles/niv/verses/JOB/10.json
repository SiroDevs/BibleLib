      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:19"
      },
      "items": [
        {
          "text": "or had been carried straight from the womb to the grave!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.19",
            "verseOrgIds": [
              "JOB.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Are not my few days almost over?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:20"
      },
      "items": [
        {
          "text": "Turn away from me so I can have a moment's joy",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
