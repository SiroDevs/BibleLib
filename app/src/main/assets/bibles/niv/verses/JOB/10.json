          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "before I go to the place of no return,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.21",
            "verseOrgIds": [
              "JOB.10.21"
            ]
          }
        }
