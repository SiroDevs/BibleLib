      "attrs": {
        "style": "q2",
        "vid": "JOB 25:2"
      },
      "items": [
        {
          "text": "he establishes order in the heights of heaven.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
