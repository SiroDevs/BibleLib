          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "how much less a mortal, who is but a maggot—",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.6",
            "verseOrgIds": [
              "JOB.25.6"
            ]
          }
        }
      ]
    },
