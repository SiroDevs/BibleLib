          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dominion and awe belong to God;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.2",
            "verseOrgIds": [
              "JOB.25.2"
            ]
