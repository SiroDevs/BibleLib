  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JOB 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Job replied:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.1",
            "verseOrgIds": [
              "JOB.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I have heard many things like these;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:2"
      },
      "items": [
        {
          "text": "you are miserable comforters, all of you!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will your long-winded speeches never end?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:3"
      },
      "items": [
        {
          "text": "What ails you that you keep on arguing?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I also could speak like you,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "if you were in my place;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "I could make fine speeches against you",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "and shake my head at you.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But my mouth would encourage you;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:5"
      },
      "items": [
        {
          "text": "comfort from my lips would bring you relief.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yet if I speak, my pain is not relieved;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:6"
      },
      "items": [
        {
          "text": "and if I refrain, it does not go away.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely, God, you have worn me out;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:7"
      },
      "items": [
        {
          "text": "you have devastated my entire household.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have shriveled me up—and it has become a witness;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:8"
      },
      "items": [
        {
          "text": "my gauntness rises up and testifies against me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "God assails me and tears me in his anger",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "and gnashes his teeth at me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "my opponent fastens on me his piercing eyes.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "People open their mouths to jeer at me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "they strike my cheek in scorn",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "and unite together against me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "God has turned me over to the ungodly",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:11"
      },
      "items": [
        {
          "text": "and thrown me into the clutches of the wicked.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "All was well with me, but he shattered me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "he seized me by the neck and crushed me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "He has made me his target;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "his archers surround me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "Without pity, he pierces my kidneys",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "and spills my gall on the ground.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Again and again he bursts upon me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:14"
      },
      "items": [
        {
          "text": "he rushes at me like a warrior.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I have sewed sackcloth over my skin",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:15"
      },
      "items": [
        {
          "text": "and buried my brow in the dust.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "My face is red with weeping,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:16"
      },
      "items": [
        {
          "text": "dark shadows ring my eyes;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "yet my hands have been free of violence",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.17",
            "verseOrgIds": [
              "JOB.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:17"
      },
      "items": [
        {
          "text": "and my prayer is pure.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.17",
            "verseOrgIds": [
              "JOB.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
