          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Almighty is beyond our reach and exalted in power;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
