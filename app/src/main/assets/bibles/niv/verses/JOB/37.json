          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore, people revere him,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.24",
            "verseOrgIds": [
              "JOB.37.24"
            ]
          }
