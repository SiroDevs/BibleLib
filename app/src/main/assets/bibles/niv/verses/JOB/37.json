      "attrs": {
        "style": "q2",
        "vid": "JOB 37:19"
      },
      "items": [
        {
          "text": "we cannot draw up our case because of our darkness.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
