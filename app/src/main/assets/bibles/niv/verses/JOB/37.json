      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:23"
      },
      "items": [
        {
          "text": "in his justice and great righteousness, he does not oppress.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
