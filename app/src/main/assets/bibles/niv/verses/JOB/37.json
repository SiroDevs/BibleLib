          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Out of the north he comes in golden splendor;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:22"
      },
      "items": [
        {
          "text": "God comes in awesome majesty.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
    },
    {
