            "sid": "JOB 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is hidden from the eyes of every living thing,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
