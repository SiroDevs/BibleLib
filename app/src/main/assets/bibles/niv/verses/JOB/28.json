      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:21"
      },
      "items": [
        {
          "text": "concealed even from the birds in the sky.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
    },
