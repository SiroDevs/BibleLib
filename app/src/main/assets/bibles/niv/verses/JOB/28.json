      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:22"
      },
      "items": [
        {
          "text": "\"Only a rumor of it has reached our ears.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
