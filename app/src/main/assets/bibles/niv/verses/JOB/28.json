          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "for he views the ends of the earth",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
