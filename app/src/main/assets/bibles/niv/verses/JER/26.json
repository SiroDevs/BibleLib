            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.19",
                "verseOrgIds": [
                  "JER.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "and seek his favor? And did not the",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
