        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "Jerusalem will become a heap of rubble,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
