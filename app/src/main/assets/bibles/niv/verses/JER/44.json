          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'This will be the sign to you that I will punish you in this place,' declares the",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.29",
            "verseOrgIds": [
              "JER.44.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JER.44.29",
                "verseOrgIds": [
                  "JER.44.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'so that you will know that my threats of harm against you will surely stand.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.29",
            "verseOrgIds": [
              "JER.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
