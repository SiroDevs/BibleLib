            "sid": "JER 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.30",
            "verseOrgIds": [
              "JER.44.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JER.44.30",
                "verseOrgIds": [
                  "JER.44.30"
                ]
              }
            }
          ]
        },
        {
          "text": "says: 'I am going to deliver Pharaoh Hophra king of Egypt into the hands of his enemies who want to kill him, just as I gave Zedekiah king of Judah into the hands of Nebuchadnezzar king of Babylon, the enemy who wanted to kill him.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.30",
            "verseOrgIds": [
              "JER.44.30"
            ]
