      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 52:28"
      },
      "items": [
        {
          "text": "in the seventh year,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
