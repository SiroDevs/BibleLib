          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "So give their children over to famine;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        }
