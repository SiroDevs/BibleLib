      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:22"
      },
      "items": [
        {
          "text": "when you suddenly bring invaders against them,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:22"
      },
      "items": [
        {
          "text": "for they have dug a pit to capture me",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:22"
      },
      "items": [
        {
