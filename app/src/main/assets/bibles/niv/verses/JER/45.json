                "verseOrgIds": [
                  "JER.45.4"
                ]
              }
            }
          ]
        },
        {
          "text": "has told me to say to you, 'This is what the",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
