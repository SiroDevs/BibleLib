              "attrs": {
                "verseId": "JER.17.5",
                "verseOrgIds": [
                  "JER.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "says:",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "\"Cursed is the one who trusts in man,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "who draws strength from mere flesh",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "and whose heart turns away from the",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.5",
                "verseOrgIds": [
                  "JER.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "That person will be like a bush in the wastelands;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "they will not see prosperity when it comes.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "They will dwell in the parched places of the desert,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "in a salt land where no one lives.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
