            "style": "v",
            "sid": "JER 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Even their children remember",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
