          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "and your",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        },
        {
