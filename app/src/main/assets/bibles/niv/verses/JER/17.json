      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "their altars and Asherah poles",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "beside the spreading trees",
