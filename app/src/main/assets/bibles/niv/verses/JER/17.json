        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.10",
                "verseOrgIds": [
                  "JER.17.10"
                ]
              }
            }
          ]
        },
