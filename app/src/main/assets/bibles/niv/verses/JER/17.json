        {
          "text": "\"Judah's sin is engraved with an iron tool,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "inscribed with a flint point,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "on the tablets of their hearts",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "and on the horns of their altars.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
