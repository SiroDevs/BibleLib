            "number": "4",
            "style": "v",
            "sid": "JER 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Through your own fault you will lose",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "the inheritance I gave you.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "I will enslave you to your enemies",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "in a land you do not know,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "for you have kindled my anger,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "and it will burn forever.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
