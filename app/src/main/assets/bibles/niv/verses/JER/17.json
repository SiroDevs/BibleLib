          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "They will be like a tree planted by the water",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "that sends out its roots by the stream.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "It does not fear when heat comes;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "its leaves are always green.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "It has no worries in a year of drought",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "and never fails to bear fruit.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
