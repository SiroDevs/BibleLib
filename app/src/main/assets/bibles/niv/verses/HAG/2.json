                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'and I will make you like my signet ring, for I have chosen you,' declares the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
