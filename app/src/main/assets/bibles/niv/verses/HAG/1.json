          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now this is what the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
