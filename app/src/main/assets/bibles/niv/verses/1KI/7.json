      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "the two bowl-shaped capitals on top of the pillars;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "the two sets of network decorating the two bowl-shaped capitals on top of the pillars;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
