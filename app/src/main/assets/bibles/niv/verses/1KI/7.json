      "attrs": {
        "style": "li1",
        "vid": "1KI 7:49"
      },
      "items": [
        {
          "text": "the gold floral work and lamps and tongs;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "the pure gold basins, wick trimmers, sprinkling bowls, dishes and censers;",
          "type": "text",
          "attrs": {
