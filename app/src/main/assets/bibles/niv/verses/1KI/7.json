          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "When all the work King Solomon had done for the temple of the",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.51",
            "verseOrgIds": [
              "1KI.7.51"
            ]
          }
        },
        {
          "name": "char",
