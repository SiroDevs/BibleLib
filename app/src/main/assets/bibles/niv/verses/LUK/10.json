{
  "id": "LUK.10",
  "number": "10",
  "bookId": "LUK",
  "reference": "Luke 10",
  "copyright": "The Holy Bible, New International Version® NIV® Copyright © 1973, 1978, 1984, 2011 by Biblica, Inc.® Used by Permission of Biblica, Inc.® All rights reserved worldwide.",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "LUK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesus Sends Out the Seventy-Two",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "After this the Lord appointed seventy-two",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "text": "others and sent them two by two ahead of him to every town and place where he was about to go.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "He told them,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"The harvest is plentiful, but the workers are few. Ask the Lord of the harvest, therefore, to send out workers into his harvest field.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.2",
                "verseOrgIds": [
                  "LUK.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Go! I am sending you out like lambs among wolves.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.3",
                "verseOrgIds": [
                  "LUK.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.3",
            "verseOrgIds": [
              "LUK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Do not take a purse or bag or sandals; and do not greet anyone on the road.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.4",
                "verseOrgIds": [
                  "LUK.10.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"When you enter a house, first say, 'Peace to this house.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.5",
                "verseOrgIds": [
                  "LUK.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.5",
            "verseOrgIds": [
              "LUK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "If someone who promotes peace is there, your peace will rest on them; if not, it will return to you.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.6",
                "verseOrgIds": [
                  "LUK.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.6",
            "verseOrgIds": [
              "LUK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Stay there, eating and drinking whatever they give you, for the worker deserves his wages. Do not move around from house to house.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.7",
                "verseOrgIds": [
                  "LUK.10.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"When you enter a town and are welcomed, eat what is offered to you.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.8",
                "verseOrgIds": [
                  "LUK.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.8",
            "verseOrgIds": [
              "LUK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Heal the sick who are there and tell them, 'The kingdom of God has come near to you.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.9",
                "verseOrgIds": [
                  "LUK.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.9",
            "verseOrgIds": [
              "LUK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "But when you enter a town and are not welcomed, go into its streets and say,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.10",
                "verseOrgIds": [
                  "LUK.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.10",
            "verseOrgIds": [
              "LUK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Even the dust of your town we wipe from our feet as a warning to you. Yet be sure of this: The kingdom of God has come near.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.11",
                "verseOrgIds": [
                  "LUK.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.11",
            "verseOrgIds": [
              "LUK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "I tell you, it will be more bearable on that day for Sodom than for that town.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.12",
                "verseOrgIds": [
                  "LUK.10.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Woe to you, Chorazin! Woe to you, Bethsaida! For if the miracles that were performed in you had been performed in Tyre and Sidon, they would have repented long ago, sitting in sackcloth and ashes.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.13",
                "verseOrgIds": [
                  "LUK.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "But it will be more bearable for Tyre and Sidon at the judgment than for you.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.14",
                "verseOrgIds": [
                  "LUK.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "And you, Capernaum, will you be lifted to the heavens? No, you will go down to Hades.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.15",
                "verseOrgIds": [
                  "LUK.10.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Whoever listens to you listens to me; whoever rejects you rejects me; but whoever rejects me rejects him who sent me.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.16",
                "verseOrgIds": [
                  "LUK.10.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "The seventy-two returned with joy and said, \"Lord, even the demons submit to us in your name.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "He replied,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"I saw Satan fall like lightning from heaven.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.18",
                "verseOrgIds": [
                  "LUK.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "I have given you authority to trample on snakes and scorpions and to overcome all the power of the enemy; nothing will harm you.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.19",
                "verseOrgIds": [
                  "LUK.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "However, do not rejoice that the spirits submit to you, but rejoice that your names are written in heaven.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.20",
                "verseOrgIds": [
                  "LUK.10.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "At that time Jesus, full of joy through the Holy Spirit, said,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"I praise you, Father, Lord of heaven and earth, because you have hidden these things from the wise and learned, and revealed them to little children. Yes, Father, for this is what you were pleased to do.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.21",
                "verseOrgIds": [
                  "LUK.10.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"All things have been committed to me by my Father. No one knows who the Son is except the Father, and no one knows who the Father is except the Son and those to whom the Son chooses to reveal him.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.22",
                "verseOrgIds": [
                  "LUK.10.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he turned to his disciples and said privately,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Blessed are the eyes that see what you see.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.23",
                "verseOrgIds": [
                  "LUK.10.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "For I tell you that many prophets and kings wanted to see what you see but did not see it, and to hear what you hear but did not hear it.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.24",
                "verseOrgIds": [
                  "LUK.10.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The Parable of the Good Samaritan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "On one occasion an expert in the law stood up to test Jesus. \"Teacher,\" he asked, \"what must I do to inherit eternal life?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.25",
            "verseOrgIds": [
              "LUK.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"What is written in the Law?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.26",
                "verseOrgIds": [
                  "LUK.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "he replied.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.26",
            "verseOrgIds": [
              "LUK.10.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"How do you read it?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.26",
                "verseOrgIds": [
                  "LUK.10.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "He answered, \" 'Love the Lord your God with all your heart and with all your soul and with all your strength and with all your mind'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.27",
            "verseOrgIds": [
              "LUK.10.27"
            ]
          }
        },
        {
          "text": "; and, 'Love your neighbor as yourself.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.27",
            "verseOrgIds": [
              "LUK.10.27"
            ]
          }
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.27",
            "verseOrgIds": [
              "LUK.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"You have answered correctly,\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.28",
                "verseOrgIds": [
                  "LUK.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Jesus replied.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.28",
            "verseOrgIds": [
              "LUK.10.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Do this and you will live.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.28",
                "verseOrgIds": [
                  "LUK.10.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "But he wanted to justify himself, so he asked Jesus, \"And who is my neighbor?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.29",
            "verseOrgIds": [
              "LUK.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "In reply Jesus said:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A man was going down from Jerusalem to Jericho, when he was attacked by robbers. They stripped him of his clothes, beat him and went away, leaving him half dead.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.30",
                "verseOrgIds": [
                  "LUK.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A priest happened to be going down the same road, and when he saw the man, he passed by on the other side.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.31",
                "verseOrgIds": [
                  "LUK.10.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.31",
            "verseOrgIds": [
              "LUK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "So too, a Levite, when he came to the place and saw him, passed by on the other side.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.32",
                "verseOrgIds": [
                  "LUK.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.32",
            "verseOrgIds": [
              "LUK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "But a Samaritan, as he traveled, came where the man was; and when he saw him, he took pity on him.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.33",
                "verseOrgIds": [
                  "LUK.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.33",
            "verseOrgIds": [
              "LUK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "He went to him and bandaged his wounds, pouring on oil and wine. Then he put the man on his own donkey, brought him to an inn and took care of him.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.34",
                "verseOrgIds": [
                  "LUK.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.34",
            "verseOrgIds": [
              "LUK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "The next day he took out two denarii",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.35",
                "verseOrgIds": [
                  "LUK.10.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.35",
            "verseOrgIds": [
              "LUK.10.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "and gave them to the innkeeper. 'Look after him,' he said, 'and when I return, I will reimburse you for any extra expense you may have.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.35",
                "verseOrgIds": [
                  "LUK.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Which of these three do you think was a neighbor to the man who fell into the hands of robbers?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.36",
                "verseOrgIds": [
                  "LUK.10.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "The expert in the law replied, \"The one who had mercy on him.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 10:37"
      },
      "items": [
        {
          "text": "Jesus told him,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Go and do likewise.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.37",
                "verseOrgIds": [
                  "LUK.10.37"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "At the Home of Martha and Mary",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "As Jesus and his disciples were on their way, he came to a village where a woman named Martha opened her home to him.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.38",
            "verseOrgIds": [
              "LUK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "She had a sister called Mary, who sat at the Lord's feet listening to what he said.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.39",
            "verseOrgIds": [
              "LUK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "But Martha was distracted by all the preparations that had to be made. She came to him and asked, \"Lord, don't you care that my sister has left me to do the work by myself? Tell her to help me!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.40",
            "verseOrgIds": [
              "LUK.10.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Martha, Martha,\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.41",
                "verseOrgIds": [
                  "LUK.10.41"
                ]
              }
            }
          ]
        },
        {
          "text": "the Lord answered,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"you are worried and upset about many things,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.41",
                "verseOrgIds": [
                  "LUK.10.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "but few things are needed—or indeed only one.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.42",
                "verseOrgIds": [
                  "LUK.10.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.42",
            "verseOrgIds": [
              "LUK.10.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mary has chosen what is better, and it will not be taken away from her.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.10.42",
                "verseOrgIds": [
                  "LUK.10.42"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "next": {
    "id": "LUK.11",
