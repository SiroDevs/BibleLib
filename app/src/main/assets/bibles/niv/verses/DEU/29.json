                "verseOrgIds": [
                  "DEU.29.23"
                ]
              }
            }
          ]
        },
        {
          "text": "done this to this land? Why this fierce, burning anger?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.23"
            ]
