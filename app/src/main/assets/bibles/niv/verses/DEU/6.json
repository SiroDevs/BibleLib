            "number": "6",
            "style": "v",
            "sid": "DEU 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "These commandments that I give you today are to be on your hearts.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
              "DEU.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impress them on your children. Talk about them when you sit at home and when you walk along the road, when you lie down and when you get up.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tie them as symbols on your hands and bind them on your foreheads.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Write them on the doorframes of your houses and on your gates.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.9",
            "verseOrgIds": [
              "DEU.6.9"
            ]
          }
        }
      ]
    },
    {
