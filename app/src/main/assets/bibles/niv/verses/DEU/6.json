              "type": "text",
              "attrs": {
                "verseId": "DEU.6.19",
                "verseOrgIds": [
                  "DEU.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "said.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
