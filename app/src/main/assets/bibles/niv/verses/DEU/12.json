                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "your God, but you may eat the meat.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
