                "verseId": "DEU.10.20",
                "verseOrgIds": [
                  "DEU.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "your God and serve him. Hold fast to him and take your oaths in his name.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "He is the one you praise; he is your God, who performed for you those great and awesome wonders you saw with your own eyes.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your ancestors who went down into Egypt were seventy in all, and now the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
            "verseOrgIds": [
              "DEU.10.22"
            ]
          }
        },
