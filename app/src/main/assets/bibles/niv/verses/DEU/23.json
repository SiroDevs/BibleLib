              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if you refrain from making a vow, you will not be guilty.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        },
