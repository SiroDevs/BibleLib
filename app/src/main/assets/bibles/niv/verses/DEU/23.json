                "verseOrgIds": [
                  "DEU.23.24"
                ]
              }
            }
          ]
        },
        {
          "text": "your God with your own mouth.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        }
