        "sid": "PSA 80"
      },
      "items": [
        {
          "text": "80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. To the tune of \"The Lilies of the Covenant.\" Of Asaph. A psalm.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 80:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear us, Shepherd of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "you who lead Joseph like a flock.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "You who sit enthroned between the cherubim,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "shine forth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 80:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "before Ephraim, Benjamin and Manasseh.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "Awaken your might;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "come and save us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 80:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Restore us, O God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "make your face shine on us,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "that we may be saved.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 80:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "How long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.80.4",
                "verseOrgIds": [
                  "PSA.80.5"
                ]
              }
            }
          ]
        },
        {
          "text": "God Almighty,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "will your anger smolder",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "against the prayers of your people?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 80:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have fed them with the bread of tears;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:5"
      },
      "items": [
        {
          "text": "you have made them drink tears by the bowlful.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 80:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have made us an object of derision",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        },
        {
          "text": "to our neighbors,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:6"
      },
      "items": [
        {
          "text": "and our enemies mock us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 80:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Restore us, God Almighty;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "make your face shine on us,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "that we may be saved.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 80:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "You transplanted a vine from Egypt;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:8"
      },
      "items": [
        {
          "text": "you drove out the nations and planted it.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 80:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "You cleared the ground for it,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:9"
      },
      "items": [
        {
          "text": "and it took root and filled the land.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 80:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The mountains were covered with its shade,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:10"
      },
      "items": [
        {
          "text": "the mighty cedars with its branches.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 80:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Its branches reached as far as the Sea,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:11"
      },
      "items": [
        {
          "text": "its shoots as far as the River.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 80:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why have you broken down its walls",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:12"
      },
      "items": [
        {
          "text": "so that all who pass by pick its grapes?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 80:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boars from the forest ravage it,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:13"
      },
      "items": [
        {
          "text": "and insects from the fields feed on it.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 80:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Return to us, God Almighty!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Look down from heaven and see!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Watch over this vine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 80:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "the root your right hand has planted,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:15"
      },
      "items": [
        {
          "text": "the son",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        },
        {
          "text": "you have raised up for yourself.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
