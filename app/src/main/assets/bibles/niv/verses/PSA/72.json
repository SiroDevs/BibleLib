  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "72",
        "style": "c",
        "sid": "PSA 72"
      },
      "items": [
        {
          "text": "72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Of Solomon.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 72:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endow the king with your justice, O God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:1"
      },
      "items": [
        {
          "text": "the royal son with your righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 72:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he judge your people in righteousness,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:2"
      },
      "items": [
        {
          "text": "your afflicted ones with justice.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 72:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "May the mountains bring prosperity to the people,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:3"
      },
      "items": [
        {
          "text": "the hills the fruit of righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 72:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he defend the afflicted among the people",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "and save the children of the needy;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "may he crush the oppressor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 72:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he endure",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        },
        {
          "text": "as long as the sun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:5"
      },
      "items": [
        {
          "text": "as long as the moon, through all generations.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 72:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he be like rain falling on a mown field,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:6"
      },
      "items": [
        {
          "text": "like showers watering the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 72:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "In his days may the righteous flourish",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:7"
      },
      "items": [
        {
          "text": "and prosperity abound till the moon is no more.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 72:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he rule from sea to sea",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:8"
      },
      "items": [
        {
          "text": "and from the River",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        },
        {
          "text": "to the ends of the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 72:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "May the desert tribes bow before him",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:9"
      },
      "items": [
        {
          "text": "and his enemies lick the dust.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 72:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "May the kings of Tarshish and of distant shores",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "bring tribute to him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "May the kings of Sheba and Seba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "present him gifts.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 72:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "May all kings bow down to him",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:11"
      },
      "items": [
        {
          "text": "and all nations serve him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 72:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "For he will deliver the needy who cry out,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "the afflicted who have no one to help.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 72:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will take pity on the weak and the needy",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:13"
      },
      "items": [
        {
          "text": "and save the needy from death.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 72:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will rescue them from oppression and violence,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:14"
      },
      "items": [
        {
          "text": "for precious is their blood in his sight.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 72:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Long may he live!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "May gold from Sheba be given him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "May people ever pray for him",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "and bless him all day long.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 72:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "May grain abound throughout the land;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:16"
      },
      "items": [
        {
          "text": "on the tops of the hills may it sway.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:16"
      },
      "items": [
        {
          "text": "May the crops flourish like Lebanon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:16"
      },
      "items": [
        {
          "text": "and thrive",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
