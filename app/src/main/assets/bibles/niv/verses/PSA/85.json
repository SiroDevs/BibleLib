  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "85",
        "style": "c",
        "sid": "PSA 85"
      },
      "items": [
        {
          "text": "85",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 85",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. Of the Sons of Korah. A psalm.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 85:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "You,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.1",
                "verseOrgIds": [
                  "PSA.85.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", showed favor to your land;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:1"
      },
      "items": [
        {
          "text": "you restored the fortunes of Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.1",
            "verseOrgIds": [
              "PSA.85.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 85:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "You forgave the iniquity of your people",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.2",
            "verseOrgIds": [
              "PSA.85.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:2"
      },
      "items": [
        {
          "text": "and covered all their sins.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.2",
            "verseOrgIds": [
              "PSA.85.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 85:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "You set aside all your wrath",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.3",
            "verseOrgIds": [
              "PSA.85.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:3"
      },
      "items": [
        {
          "text": "and turned from your fierce anger.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.3",
            "verseOrgIds": [
              "PSA.85.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 85:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Restore us again, God our Savior,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.4",
            "verseOrgIds": [
              "PSA.85.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:4"
      },
      "items": [
        {
          "text": "and put away your displeasure toward us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.4",
            "verseOrgIds": [
              "PSA.85.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 85:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will you be angry with us forever?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.5",
            "verseOrgIds": [
              "PSA.85.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:5"
      },
      "items": [
        {
          "text": "Will you prolong your anger through all generations?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.5",
            "verseOrgIds": [
              "PSA.85.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 85:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will you not revive us again,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.6",
            "verseOrgIds": [
              "PSA.85.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:6"
      },
      "items": [
        {
          "text": "that your people may rejoice in you?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.6",
            "verseOrgIds": [
              "PSA.85.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 85:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Show us your unfailing love,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.7",
                "verseOrgIds": [
                  "PSA.85.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:7"
      },
      "items": [
        {
          "text": "and grant us your salvation.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.7",
            "verseOrgIds": [
              "PSA.85.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 85:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will listen to what God the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.8",
                "verseOrgIds": [
                  "PSA.85.9"
                ]
              }
            }
          ]
        },
        {
          "text": "says;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "he promises peace to his people, his faithful servants—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "but let them not turn to folly.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 85:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely his salvation is near those who fear him,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:9"
      },
      "items": [
        {
          "text": "that his glory may dwell in our land.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 85:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Love and faithfulness meet together;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:10"
      },
      "items": [
        {
          "text": "righteousness and peace kiss each other.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 85:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faithfulness springs forth from the earth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:11"
      },
      "items": [
        {
          "text": "and righteousness looks down from heaven.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 85:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.12",
                "verseOrgIds": [
                  "PSA.85.13"
                ]
              }
            }
          ]
        },
        {
          "text": "will indeed give what is good,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:12"
      },
      "items": [
        {
          "text": "and our land will yield its harvest.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 85:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Righteousness goes before him",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:13"
      },
      "items": [
        {
          "text": "and prepares the way for his steps.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    }
  ],
