          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "of the Sons of Korah.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "As the deer pants for streams of water,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:1"
      },
      "items": [
        {
          "text": "so my soul pants for you, my God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "My soul thirsts for God, for the living God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:2"
      },
      "items": [
        {
          "text": "When can I go and meet with God?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "My tears have been my food",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "day and night,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "while people say to me all day long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "\"Where is your God?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "These things I remember",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "as I pour out my soul:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "how I used to go to the house of God",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "under the protection of the Mighty One",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "with shouts of joy and praise",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "among the festive throng.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why, my soul, are you downcast?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Why so disturbed within me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Put your hope in God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "for I will yet praise him,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "my Savior and my God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "My soul is downcast within me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "therefore I will remember you",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "from the land of the Jordan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "the heights of Hermon—from Mount Mizar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deep calls to deep",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "in the roar of your waterfalls;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "all your waves and breakers",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "have swept over me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "By day the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.42.8",
                "verseOrgIds": [
                  "PSA.42.9"
                ]
              }
            }
          ]
        },
        {
          "text": "directs his love,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "at night his song is with me—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "a prayer to the God of my life.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I say to God my Rock,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "\"Why have you forgotten me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "Why must I go about mourning,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "oppressed by the enemy?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "My bones suffer mortal agony",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "as my foes taunt me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "saying to me all day long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
      "items": [
        {
          "text": "\"Where is your God?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
