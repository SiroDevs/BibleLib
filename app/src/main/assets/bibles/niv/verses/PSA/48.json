      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:1"
      },
      "items": [
        {
          "text": "in the city of our God, his holy mountain.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
