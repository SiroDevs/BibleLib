      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "so we have seen",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
