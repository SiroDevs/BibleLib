          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:7"
      },
      "items": [
        {
          "text": "shattered by an east wind.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
