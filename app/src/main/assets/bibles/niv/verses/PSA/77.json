  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "77",
        "style": "c",
        "sid": "PSA 77"
      },
      "items": [
        {
          "text": "77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. For Jeduthun. Of Asaph. A psalm.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 77:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cried out to God for help;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:1"
      },
      "items": [
        {
          "text": "I cried out to God to hear me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 77:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I was in distress, I sought the Lord;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "at night I stretched out untiring hands,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "and I would not be comforted.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 77:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I remembered you, God, and I groaned;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "text": "I meditated, and my spirit grew faint.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 77:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "You kept my eyes from closing;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:4"
      },
      "items": [
        {
          "text": "I was too troubled to speak.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 77:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I thought about the former days,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:5"
      },
      "items": [
        {
          "text": "the years of long ago;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 77:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I remembered my songs in the night.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:6"
      },
      "items": [
        {
          "text": "My heart meditated and my spirit asked:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 77:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Will the Lord reject forever?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:7"
      },
      "items": [
        {
          "text": "Will he never show his favor again?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 77:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Has his unfailing love vanished forever?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:8"
      },
      "items": [
        {
          "text": "Has his promise failed for all time?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 77:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Has God forgotten to be merciful?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:9"
      },
      "items": [
        {
          "text": "Has he in anger withheld his compassion?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 77:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I thought, \"To this I will appeal:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:10"
      },
      "items": [
        {
          "text": "the years when the Most High stretched out his right hand.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 77:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will remember the deeds of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.11",
                "verseOrgIds": [
                  "PSA.77.12"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:11"
      },
      "items": [
        {
          "text": "yes, I will remember your miracles of long ago.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 77:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will consider all your works",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:12"
      },
      "items": [
        {
          "text": "and meditate on all your mighty deeds.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 77:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your ways, God, are holy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:13"
      },
      "items": [
        {
          "text": "What god is as great as our God?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 77:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "You are the God who performs miracles;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:14"
      },
      "items": [
        {
          "text": "you display your power among the peoples.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 77:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "With your mighty arm you redeemed your people,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:15"
      },
      "items": [
        {
          "text": "the descendants of Jacob and Joseph.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 77:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "The waters saw you, God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:16"
      },
      "items": [
        {
          "text": "the waters saw you and writhed;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:16"
      },
      "items": [
        {
          "text": "the very depths were convulsed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 77:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "The clouds poured down water,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.17",
            "verseOrgIds": [
              "PSA.77.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:17"
      },
      "items": [
        {
          "text": "the heavens resounded with thunder;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.17",
            "verseOrgIds": [
              "PSA.77.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:17"
      },
      "items": [
        {
          "text": "your arrows flashed back and forth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.17",
            "verseOrgIds": [
              "PSA.77.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
