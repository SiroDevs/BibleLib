    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. Of David. A psalm.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I waited patiently for the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.40.1",
                "verseOrgIds": [
                  "PSA.40.2"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:1"
      },
      "items": [
        {
          "text": "he turned to me and heard my cry.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "He lifted me out of the slimy pit,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "out of the mud and mire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "he set my feet on a rock",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "and gave me a firm place to stand.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "He put a new song in my mouth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "a hymn of praise to our God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "Many will see and fear the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.40.3",
                "verseOrgIds": [
                  "PSA.40.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "and put their trust in him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Blessed is the one",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "who trusts in the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.40.4",
                "verseOrgIds": [
                  "PSA.40.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "who does not look to the proud,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "to those who turn aside to false gods.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Many,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.40.5",
                "verseOrgIds": [
                  "PSA.40.6"
                ]
              }
            }
          ]
        },
        {
          "text": "my God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "are the wonders you have done,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "the things you planned for us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "None can compare with you;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "were I to speak and tell of your deeds,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "they would be too many to declare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sacrifice and offering you did not desire—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "but my ears you have opened",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        },
        {
          "text": "—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "burnt offerings and sin offerings",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        },
        {
          "text": "you did not require.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I said, \"Here I am, I have come—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:7"
      },
      "items": [
        {
          "text": "it is written about me in the scroll.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I desire to do your will, my God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:8"
      },
      "items": [
        {
          "text": "your law is within my heart.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I proclaim your saving acts in the great assembly;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "I do not seal my lips,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.40.9",
                "verseOrgIds": [
                  "PSA.40.10"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "as you know.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I do not hide your righteousness in my heart;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "I speak of your faithfulness and your saving help.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "I do not conceal your love and your faithfulness",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "from the great assembly.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not withhold your mercy from me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
