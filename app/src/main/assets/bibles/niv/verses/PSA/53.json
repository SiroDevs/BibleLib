  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "53",
        "style": "c",
        "sid": "PSA 53"
      },
      "items": [
        {
          "text": "53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. According to",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "mahalath.",
              "type": "text"
            }
          ]
        },
        {
          "text": "A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fool says in his heart,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "\"There is no God.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "They are corrupt, and their ways are vile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "there is no one who does good.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "God looks down from heaven",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "on all mankind",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "to see if there are any who understand,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "any who seek God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Everyone has turned away, all have become corrupt;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "there is no one who does good,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "not even one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do all these evildoers know nothing?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 53:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "They devour my people as though eating bread;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "they never call on God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But there they are, overwhelmed with dread,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "where there was nothing to dread.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "God scattered the bones of those who attacked you;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "you put them to shame, for God despised them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh, that salvation for Israel would come out of Zion!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "When God restores his people,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "let Jacob rejoice and Israel be glad!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    }
  ],
