        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "of David. When he was in the cave. A prayer.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 142:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cry aloud to the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.1",
                "verseOrgIds": [
                  "PSA.142.2"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:1"
      },
      "items": [
        {
          "text": "I lift up my voice to the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.1",
                "verseOrgIds": [
                  "PSA.142.2"
                ]
              }
            }
          ]
        },
        {
          "text": "for mercy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 142:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I pour out before him my complaint;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:2"
      },
      "items": [
        {
          "text": "before him I tell my trouble.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 142:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "When my spirit grows faint within me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "it is you who watch over my way.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "In the path where I walk",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "people have hidden a snare for me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 142:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Look and see, there is no one at my right hand;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "no one is concerned for me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "I have no refuge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "no one cares for my life.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 142:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cry to you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.142.5",
                "verseOrgIds": [
                  "PSA.142.6"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "I say, \"You are my refuge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "my portion in the land of the living.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 142:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen to my cry,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "for I am in desperate need;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "rescue me from those who pursue me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "for they are too strong for me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 142:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Set me free from my prison,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "that I may praise your name.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "Then the righteous will gather about me",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "because of your goodness to me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    }
  ],
