  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "PSA 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. Of the Sons of Korah. A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "We have heard it with our ears, O God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "our ancestors have told us",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "what you did in their days,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "in days long ago.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "With your hand you drove out the nations",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "and planted our ancestors;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "you crushed the peoples",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "and made our ancestors flourish.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "It was not by their sword that they won the land,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "nor did their arm bring them victory;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "it was your right hand, your arm,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "and the light of your face, for you loved them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "You are my King and my God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "who decrees",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        },
        {
          "text": "victories for Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Through you we push back our enemies;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:5"
      },
      "items": [
        {
          "text": "through your name we trample our foes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I put no trust in my bow,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:6"
      },
      "items": [
        {
          "text": "my sword does not bring me victory;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "but you give us victory over our enemies,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:7"
      },
      "items": [
        {
          "text": "you put our adversaries to shame.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "In God we make our boast all day long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:8"
      },
      "items": [
        {
          "text": "and we will praise your name forever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "But now you have rejected and humbled us;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:9"
      },
      "items": [
        {
          "text": "you no longer go out with our armies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "You made us retreat before the enemy,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:10"
      },
      "items": [
        {
          "text": "and our adversaries have plundered us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "You gave us up to be devoured like sheep",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:11"
      },
      "items": [
        {
          "text": "and have scattered us among the nations.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "You sold your people for a pittance,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:12"
      },
      "items": [
        {
          "text": "gaining nothing from their sale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have made us a reproach to our neighbors,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:13"
      },
      "items": [
        {
          "text": "the scorn and derision of those around us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have made us a byword among the nations;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:14"
      },
      "items": [
        {
          "text": "the peoples shake their heads at us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I live in disgrace all day long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:15"
      },
      "items": [
        {
          "text": "and my face is covered with shame",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "at the taunts of those who reproach and revile me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:16"
      },
      "items": [
        {
          "text": "because of the enemy, who is bent on revenge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "All this came upon us,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:17"
      },
      "items": [
        {
          "text": "though we had not forgotten you;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:17"
      },
      "items": [
        {
          "text": "we had not been false to your covenant.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Our hearts had not turned back;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:18"
      },
      "items": [
        {
          "text": "our feet had not strayed from your path.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "But you crushed us and made us a haunt for jackals;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:19"
      },
      "items": [
        {
          "text": "you covered us over with deep darkness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "If we had forgotten the name of our God",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:20"
      },
      "items": [
        {
          "text": "or spread out our hands to a foreign god,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "would not God have discovered it,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.21",
            "verseOrgIds": [
              "PSA.44.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:21"
      },
      "items": [
        {
          "text": "since he knows the secrets of the heart?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.21",
            "verseOrgIds": [
              "PSA.44.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet for your sake we face death all day long;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:22"
      },
      "items": [
        {
          "text": "we are considered as sheep to be slaughtered.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awake, Lord! Why do you sleep?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.23",
            "verseOrgIds": [
              "PSA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:23"
      },
      "items": [
        {
          "text": "Rouse yourself! Do not reject us forever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.23",
            "verseOrgIds": [
              "PSA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why do you hide your face",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.24",
            "verseOrgIds": [
              "PSA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:24"
      },
      "items": [
        {
          "text": "and forget our misery and oppression?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.24",
            "verseOrgIds": [
              "PSA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "We are brought down to the dust;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.25",
            "verseOrgIds": [
              "PSA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:25"
      },
      "items": [
        {
          "text": "our bodies cling to the ground.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.25",
            "verseOrgIds": [
              "PSA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rise up and help us;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.26",
            "verseOrgIds": [
              "PSA.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:26"
      },
      "items": [
        {
          "text": "rescue us because of your unfailing love.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.26",
            "verseOrgIds": [
              "PSA.44.27"
            ]
          }
        }
      ]
    }
