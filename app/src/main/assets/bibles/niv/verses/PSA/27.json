      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "whom shall I fear?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.1",
                "verseOrgIds": [
                  "PSA.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "is the stronghold of my life—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "of whom shall I be afraid?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the wicked advance against me",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "to devour",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        },
        {
          "text": "me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "it is my enemies and my foes",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "who will stumble and fall.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though an army besiege me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "my heart will not fear;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "though war break out against me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "even then I will be confident.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
