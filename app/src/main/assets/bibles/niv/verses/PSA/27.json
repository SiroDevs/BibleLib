          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "One thing I ask from the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
