            "number": "6",
            "style": "v",
            "sid": "PSA 112:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely the righteous will never be shaken;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:6"
      },
      "items": [
        {
          "text": "they will be remembered forever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 112:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "They will have no fear of bad news;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:7"
      },
      "items": [
        {
          "text": "their hearts are steadfast, trusting in the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.112.7",
                "verseOrgIds": [
                  "PSA.112.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 112:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their hearts are secure, they will have no fear;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:8"
      },
      "items": [
        {
          "text": "in the end they will look in triumph on their foes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 112:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have freely scattered their gifts to the poor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "their righteousness endures forever;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:9"
      },
      "items": [
        {
          "text": "their horn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        },
        {
          "text": "will be lifted high in honor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 112:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wicked will see and be vexed,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "they will gnash their teeth and waste away;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:10"
      },
      "items": [
        {
          "text": "the longings of the wicked will come to nothing.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    }
