  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "PSA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A prayer of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.1",
                "verseOrgIds": [
                  "PSA.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", my plea is just;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "listen to my cry.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Hear my prayer—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "it does not rise from deceitful lips.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let my vindication come from you;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:2"
      },
      "items": [
        {
          "text": "may your eyes see what is right.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though you probe my heart,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "though you examine me at night and test me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "you will find that I have planned no evil;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "my mouth has not transgressed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though people tried to bribe me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "I have kept myself from the ways of the violent",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "through what your lips have commanded.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "My steps have held to your paths;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:5"
      },
      "items": [
        {
          "text": "my feet have not stumbled.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I call on you, my God, for you will answer me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:6"
      },
      "items": [
        {
          "text": "turn your ear to me and hear my prayer.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Show me the wonders of your great love,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "you who save by your right hand",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "those who take refuge in you from their foes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keep me as the apple of your eye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:8"
      },
      "items": [
        {
          "text": "hide me in the shadow of your wings",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "from the wicked who are out to destroy me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:9"
      },
      "items": [
        {
          "text": "from my mortal enemies who surround me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "They close up their callous hearts,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:10"
      },
      "items": [
        {
          "text": "and their mouths speak with arrogance.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have tracked me down, they now surround me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:11"
      },
      "items": [
        {
          "text": "with eyes alert, to throw me to the ground.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are like a lion hungry for prey,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:12"
      },
      "items": [
        {
          "text": "like a fierce lion crouching in cover.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rise up,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.13",
                "verseOrgIds": [
                  "PSA.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", confront them, bring them down;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:13"
      },
      "items": [
        {
          "text": "with your sword rescue me from the wicked.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "By your hand save me from such people,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.14",
                "verseOrgIds": [
                  "PSA.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "from those of this world whose reward is in this life.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "May what you have stored up for the wicked fill their bellies;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "may their children gorge themselves on it,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "and may there be leftovers for their little ones.",
