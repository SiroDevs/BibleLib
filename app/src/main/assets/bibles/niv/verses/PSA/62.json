      },
      "items": [
        {
          "text": "62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. For Jeduthun. A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Truly my soul finds rest in God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:1"
      },
      "items": [
        {
          "text": "my salvation comes from him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Truly he is my rock and my salvation;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:2"
      },
      "items": [
        {
          "text": "he is my fortress, I will never be shaken.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "How long will you assault me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "Would all of you throw me down—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "this leaning wall, this tottering fence?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely they intend to topple me",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "from my lofty place;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "they take delight in lies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "With their mouths they bless,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "but in their hearts they curse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yes, my soul, find rest in God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:5"
      },
      "items": [
        {
          "text": "my hope comes from him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Truly he is my rock and my salvation;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:6"
      },
      "items": [
        {
          "text": "he is my fortress, I will not be shaken.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "My salvation and my honor depend on God",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:7"
      },
      "items": [
        {
          "text": "he is my mighty rock, my refuge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Trust in him at all times, you people;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "pour out your hearts to him,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "for God is our refuge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely the lowborn are but a breath,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "the highborn are but a lie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "If weighed on a balance, they are nothing;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "together they are only a breath.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not trust in extortion",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "or put vain hope in stolen goods;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "though your riches increase,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "do not set your heart on them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "One thing God has spoken,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "two things I have heard:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "\"Power belongs to you, God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "and with you, Lord, is unfailing love\";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "and, \"You reward everyone",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "according to what they have done.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    }
  ],
