  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "PSA 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. Of the Sons of Korah. A psalm.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear this, all you peoples;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:1"
      },
      "items": [
        {
          "text": "listen, all who live in this world,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "both low and high,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:2"
      },
      "items": [
        {
          "text": "rich and poor alike:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "My mouth will speak words of wisdom;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:3"
      },
      "items": [
        {
          "text": "the meditation of my heart will give you understanding.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will turn my ear to a proverb;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:4"
      },
      "items": [
        {
          "text": "with the harp I will expound my riddle:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why should I fear when evil days come,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:5"
      },
      "items": [
        {
          "text": "when wicked deceivers surround me—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "those who trust in their wealth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:6"
      },
      "items": [
        {
          "text": "and boast of their great riches?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No one can redeem the life of another",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "or give to God a ransom for them—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "the ransom for a life is costly,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:8"
      },
      "items": [
        {
          "text": "no payment is ever enough—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "so that they should live on forever",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:9"
      },
      "items": [
        {
          "text": "and not see decay.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "For all can see that the wise die,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "that the foolish and the senseless also perish,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "leaving their wealth to others.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their tombs will remain their houses",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        },
        {
          "text": "forever,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "their dwellings for endless generations,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "though they had",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        },
        {
          "text": "named lands after themselves.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "People, despite their wealth, do not endure;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:12"
      },
      "items": [
        {
          "text": "they are like the beasts that perish.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is the fate of those who trust in themselves,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "and of their followers, who approve their sayings.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are like sheep and are destined to die;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "death will be their shepherd",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "(but the upright will prevail over them in the morning).",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "Their forms will decay in the grave,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "far from their princely mansions.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "But God will redeem me from the realm of the dead;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:15"
      },
      "items": [
        {
          "text": "he will surely take me to himself.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not be overawed when others grow rich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.16",
            "verseOrgIds": [
              "PSA.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:16"
      },
      "items": [
        {
          "text": "when the splendor of their houses increases;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.16",
            "verseOrgIds": [
              "PSA.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "for they will take nothing with them when they die,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.17",
            "verseOrgIds": [
              "PSA.49.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:17"
      },
