      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "May the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.1",
                "verseOrgIds": [
                  "PSA.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "answer you when you are in distress;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:1"
      },
      "items": [
        {
          "text": "may the name of the God of Jacob protect you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he send you help from the sanctuary",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:2"
      },
      "items": [
        {
          "text": "and grant you support from Zion.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he remember all your sacrifices",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:3"
      },
      "items": [
        {
          "text": "and accept your burnt offerings.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he give you the desire of your heart",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:4"
      },
      "items": [
        {
          "text": "and make all your plans succeed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "May we shout for joy over your victory",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "and lift up our banners in the name of our God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 20:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "May the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.5",
                "verseOrgIds": [
                  "PSA.20.6"
                ]
              }
            }
          ]
        },
        {
          "text": "grant all your requests.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now this I know:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.6",
                "verseOrgIds": [
                  "PSA.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gives victory to his anointed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "He answers him from his heavenly sanctuary",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "with the victorious power of his right hand.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Some trust in chariots and some in horses,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:7"
      },
      "items": [
        {
          "text": "but we trust in the name of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.7",
                "verseOrgIds": [
                  "PSA.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "our God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are brought to their knees and fall,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:8"
      },
      "items": [
        {
          "text": "but we rise up and stand firm.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.9",
                "verseOrgIds": [
                  "PSA.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", give victory to the king!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 20:9"
      },
      "items": [
        {
          "text": "Answer us when we call!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    }
  ],
