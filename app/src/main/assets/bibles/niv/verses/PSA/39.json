  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "PSA 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. For Jeduthun. A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I said, \"I will watch my ways",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "and keep my tongue from sin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "I will put a muzzle on my mouth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "while in the presence of the wicked.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "So I remained utterly silent,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:2"
      },
      "items": [
        {
          "text": "not even saying anything good.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:2"
      },
      "items": [
        {
          "text": "But my anguish increased;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "my heart grew hot within me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:3"
      },
      "items": [
        {
          "text": "While I meditated, the fire burned;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:3"
      },
      "items": [
        {
          "text": "then I spoke with my tongue:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Show me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.39.4",
                "verseOrgIds": [
                  "PSA.39.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", my life's end",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:4"
      },
      "items": [
        {
          "text": "and the number of my days;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:4"
      },
      "items": [
        {
          "text": "let me know how fleeting my life is.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have made my days a mere handbreadth;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "the span of my years is as nothing before you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "Everyone is but a breath,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "even those who seem secure.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Surely everyone goes around like a mere phantom;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:6"
      },
      "items": [
        {
          "text": "in vain they rush about, heaping up wealth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:6"
      },
      "items": [
        {
          "text": "without knowing whose it will finally be.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"But now, Lord, what do I look for?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:7"
      },
      "items": [
        {
          "text": "My hope is in you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Save me from all my transgressions;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:8"
      },
      "items": [
        {
          "text": "do not make me the scorn of fools.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I was silent; I would not open my mouth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:9"
      },
      "items": [
        {
          "text": "for you are the one who has done this.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remove your scourge from me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:10"
      },
      "items": [
        {
          "text": "I am overcome by the blow of your hand.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "When you rebuke and discipline anyone for their sin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "text": "you consume their wealth like a moth—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "text": "surely everyone is but a breath.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hear my prayer,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.39.12",
                "verseOrgIds": [
                  "PSA.39.13"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "listen to my cry for help;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "do not be deaf to my weeping.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "I dwell with you as a foreigner,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "a stranger, as all my ancestors were.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Look away from me, that I may enjoy life again",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.13",
            "verseOrgIds": [
              "PSA.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:13"
      },
      "items": [
        {
          "text": "before I depart and am no more.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.13",
            "verseOrgIds": [
              "PSA.39.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.40",
    "number": "40",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.38",
    "number": "38",
    "bookId": "PSA"
  }
}