  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "88",
        "style": "c",
        "sid": "PSA 88"
      },
      "items": [
        {
          "text": "88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A song. A psalm of the Sons of Korah. For the director of music. According to",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "mahalath leannoth.",
              "type": "text"
            }
          ]
        },
        {
          "text": "A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "of Heman the Ezrahite.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 88:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.1",
                "verseOrgIds": [
                  "PSA.88.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", you are the God who saves me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:1"
      },
      "items": [
        {
          "text": "day and night I cry out to you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 88:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "May my prayer come before you;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:2"
      },
      "items": [
        {
          "text": "turn your ear to my cry.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 88:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am overwhelmed with troubles",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:3"
      },
      "items": [
        {
          "text": "and my life draws near to death.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 88:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am counted among those who go down to the pit;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:4"
      },
      "items": [
        {
          "text": "I am like one without strength.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 88:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am set apart with the dead,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "like the slain who lie in the grave,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "whom you remember no more,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "who are cut off from your care.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 88:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have put me in the lowest pit,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:6"
      },
      "items": [
        {
          "text": "in the darkest depths.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 88:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your wrath lies heavily on me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:7"
      },
      "items": [
        {
          "text": "you have overwhelmed me with all your waves.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 88:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have taken from me my closest friends",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:8"
      },
      "items": [
        {
          "text": "and have made me repulsive to them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:8"
      },
      "items": [
        {
          "text": "I am confined and cannot escape;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 88:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "my eyes are dim with grief.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 88:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:9"
      },
      "items": [
        {
          "text": "I call to you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.9",
                "verseOrgIds": [
                  "PSA.88.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", every day;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:9"
      },
      "items": [
        {
          "text": "I spread out my hands to you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 88:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do you show your wonders to the dead?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:10"
      },
      "items": [
        {
          "text": "Do their spirits rise up and praise you?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 88:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Is your love declared in the grave,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:11"
      },
      "items": [
        {
          "text": "your faithfulness in Destruction",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 88:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Are your wonders known in the place of darkness,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:12"
      },
      "items": [
        {
          "text": "or your righteous deeds in the land of oblivion?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 88:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "But I cry to you for help,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.13",
                "verseOrgIds": [
                  "PSA.88.14"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:13"
      },
      "items": [
        {
          "text": "in the morning my prayer comes before you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 88:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.14",
                "verseOrgIds": [
                  "PSA.88.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", do you reject me",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:14"
      },
      "items": [
        {
          "text": "and hide your face from me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 88:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "From my youth I have suffered and been close to death;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
      ]
