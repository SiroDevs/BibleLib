          "text": "For the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.11",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "God is a sun and shield;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.11",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bestows favor and honor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "no good thing does he withhold",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "from those whose walk is blameless.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
