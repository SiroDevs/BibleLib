          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": "will vindicate me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:8"
      },
      "items": [
        {
          "text": "your love,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", endures forever—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:8"
      },
      "items": [
        {
          "text": "do not abandon the works of your hands.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
