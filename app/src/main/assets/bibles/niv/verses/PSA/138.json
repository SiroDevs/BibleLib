            "style": "v",
            "sid": "PSA 138:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I called, you answered me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:3"
      },
      "items": [
        {
          "text": "you greatly emboldened me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
