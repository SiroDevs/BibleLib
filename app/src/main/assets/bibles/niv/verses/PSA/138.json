          "text": "Though I walk in the midst of trouble,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:7"
      },
      "items": [
        {
          "text": "you preserve my life.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 138:7"
      },
      "items": [
        {
          "text": "You stretch out your hand against the anger of my foes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:7"
      },
      "items": [
        {
          "text": "with your right hand you save me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
