          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
