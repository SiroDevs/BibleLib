      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
