            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.4",
                "verseOrgIds": [
                  "PSA.138.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
      ]
    },
    {
