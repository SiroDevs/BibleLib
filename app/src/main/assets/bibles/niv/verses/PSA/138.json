          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.6",
                "verseOrgIds": [
                  "PSA.138.6"
                ]
              }
            }
          ]
        },
        {
          "text": "is exalted, he looks kindly on the lowly;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:6"
      },
      "items": [
        {
          "text": "though lofty, he sees them from afar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 138:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
