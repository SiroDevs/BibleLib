  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "PSA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. To the tune of \"Do Not Destroy.\" Of David. A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "miktam.",
              "type": "text"
            }
          ]
        },
        {
          "text": "When he had fled from Saul into the cave.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Have mercy on me, my God, have mercy on me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "for in you I take refuge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "I will take refuge in the shadow of your wings",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "until the disaster has passed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I cry out to God Most High,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:2"
      },
      "items": [
        {
          "text": "to God, who vindicates me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "He sends from heaven and saves me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "rebuking those who hotly pursue me—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "God sends forth his love and his faithfulness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am in the midst of lions;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "I am forced to dwell among ravenous beasts—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "men whose teeth are spears and arrows,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "whose tongues are sharp swords.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be exalted, O God, above the heavens;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:5"
      },
      "items": [
        {
          "text": "let your glory be over all the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "They spread a net for my feet—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "I was bowed down in distress.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "They dug a pit in my path—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "but they have fallen into it themselves.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "My heart, O God, is steadfast,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "my heart is steadfast;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "I will sing and make music.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awake, my soul!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "Awake, harp and lyre!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "I will awaken the dawn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will praise you, Lord, among the nations;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:9"
      },
      "items": [
        {
          "text": "I will sing of you among the peoples.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "For great is your love, reaching to the heavens;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:10"
      },
      "items": [
        {
          "text": "your faithfulness reaches to the skies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be exalted, O God, above the heavens;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.11",
            "verseOrgIds": [
              "PSA.57.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:11"
      },
      "items": [
        {
          "text": "let your glory be over all the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.11",
            "verseOrgIds": [
              "PSA.57.12"
            ]
          }
        }
      ]
    }
  ],
