          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "to silence the foe and the avenger.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
