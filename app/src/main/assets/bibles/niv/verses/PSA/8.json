          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "the work of your fingers,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:3"
      },
      "items": [
        {
