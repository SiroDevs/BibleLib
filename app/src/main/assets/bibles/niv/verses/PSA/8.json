          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.8.1",
                "verseOrgIds": [
                  "PSA.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", our Lord,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "how majestic is your name in all the earth!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 8:1"
      },
      "items": []
    },
    {
