      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "You have set your glory",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
