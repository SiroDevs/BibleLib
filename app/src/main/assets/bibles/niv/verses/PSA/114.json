            "number": "3",
            "style": "v",
            "sid": "PSA 114:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sea looked and fled,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:3"
      },
      "items": [
        {
          "text": "the Jordan turned back;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 114:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "the mountains leaped like rams,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:4"
      },
      "items": [
        {
          "text": "the hills like lambs.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 114:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why was it, sea, that you fled?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:5"
      },
      "items": [
        {
          "text": "Why, Jordan, did you turn back?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 114:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why, mountains, did you leap like rams,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:6"
      },
      "items": [
        {
          "text": "you hills, like lambs?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 114:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
