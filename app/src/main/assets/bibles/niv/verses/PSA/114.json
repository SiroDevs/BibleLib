          "text": "Tremble, earth, at the presence of the Lord,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:7"
      },
      "items": [
        {
          "text": "at the presence of the God of Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 114:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "who turned the rock into a pool,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:8"
      },
      "items": [
        {
          "text": "the hard rock into springs of water.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
