      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 103:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.6",
                "verseOrgIds": [
                  "PSA.103.6"
                ]
              }
            }
          ]
        },
        {
          "text": "works righteousness",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:6"
      },
      "items": [
        {
          "text": "and justice for all the oppressed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 103:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "He made known his ways to Moses,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:7"
      },
      "items": [
        {
          "text": "his deeds to the people of Israel:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 103:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.8",
                "verseOrgIds": [
                  "PSA.103.8"
                ]
              }
            }
          ]
        },
        {
          "text": "is compassionate and gracious,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:8"
      },
      "items": [
        {
          "text": "slow to anger, abounding in love.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 103:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will not always accuse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:9"
      },
      "items": [
        {
          "text": "nor will he harbor his anger forever;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 103:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "he does not treat us as our sins deserve",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:10"
      },
      "items": [
        {
          "text": "or repay us according to our iniquities.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 103:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "For as high as the heavens are above the earth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:11"
      },
      "items": [
        {
          "text": "so great is his love for those who fear him;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 103:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "as far as the east is from the west,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:12"
      },
      "items": [
        {
          "text": "so far has he removed our transgressions from us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 103:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "As a father has compassion on his children,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:13"
      },
      "items": [
        {
          "text": "so the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.13",
                "verseOrgIds": [
                  "PSA.103.13"
                ]
              }
            }
          ]
        },
        {
          "text": "has compassion on those who fear him;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 103:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "for he knows how we are formed,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:14"
      },
      "items": [
        {
          "text": "he remembers that we are dust.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 103:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The life of mortals is like grass,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:15"
      },
      "items": [
        {
          "text": "they flourish like a flower of the field;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 103:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "the wind blows over it and it is gone,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.16",
            "verseOrgIds": [
              "PSA.103.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:16"
      },
      "items": [
        {
          "text": "and its place remembers it no more.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.16",
            "verseOrgIds": [
              "PSA.103.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 103:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "But from everlasting to everlasting",
          "type": "text",
