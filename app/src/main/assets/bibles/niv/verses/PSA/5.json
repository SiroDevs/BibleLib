  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PSA 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. For pipes. A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen to my words,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.1",
                "verseOrgIds": [
                  "PSA.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:1"
      },
      "items": [
        {
          "text": "consider my lament.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear my cry for help,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "my King and my God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "for to you I pray.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "In the morning,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.3",
                "verseOrgIds": [
                  "PSA.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", you hear my voice;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "in the morning I lay my requests before you",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "and wait expectantly.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For you are not a God who is pleased with wickedness;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:4"
      },
      "items": [
        {
          "text": "with you, evil people are not welcome.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The arrogant cannot stand",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:5"
      },
      "items": [
        {
          "text": "in your presence.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:5"
      },
      "items": [
        {
          "text": "You hate all who do wrong;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "you destroy those who tell lies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "The bloodthirsty and deceitful",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.6",
                "verseOrgIds": [
                  "PSA.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", detest.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "But I, by your great love,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "can come into your house;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "in reverence I bow down",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "toward your holy temple.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lead me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.8",
                "verseOrgIds": [
                  "PSA.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", in your righteousness",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "because of my enemies—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "make your way straight before me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Not a word from their mouth can be trusted;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "their heart is filled with malice.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "Their throat is an open grave;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "with their tongues they tell lies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Declare them guilty, O God!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Let their intrigues be their downfall.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Banish them for their many sins,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "for they have rebelled against you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "But let all who take refuge in you be glad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "let them ever sing for joy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "Spread your protection over them,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "that those who love your name may rejoice in you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.12",
                "verseOrgIds": [
                  "PSA.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", you bless the righteous;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
