              "type": "text",
              "attrs": {
                "verseId": "PSA.144.1",
                "verseOrgIds": [
                  "PSA.144.1"
                ]
              }
            }
          ]
        },
        {
          "text": "my Rock,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
