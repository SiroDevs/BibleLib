                "verseId": "PSA.144.5",
                "verseOrgIds": [
                  "PSA.144.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", and come down;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
