  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "108",
        "style": "c",
        "sid": "PSA 108"
      },
      "items": [
        {
          "text": "108",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 108",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A song. A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 108:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "My heart, O God, is steadfast;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:1"
      },
      "items": [
        {
          "text": "I will sing and make music with all my soul.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 108:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awake, harp and lyre!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:2"
      },
      "items": [
        {
          "text": "I will awaken the dawn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 108:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will praise you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.3",
                "verseOrgIds": [
                  "PSA.108.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", among the nations;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:3"
      },
      "items": [
        {
          "text": "I will sing of you among the peoples.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 108:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For great is your love, higher than the heavens;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:4"
      },
      "items": [
        {
          "text": "your faithfulness reaches to the skies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 108:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be exalted, O God, above the heavens;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:5"
      },
      "items": [
        {
          "text": "let your glory be over all the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 108:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Save us and help us with your right hand,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:6"
      },
      "items": [
        {
          "text": "that those you love may be delivered.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 108:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "God has spoken from his sanctuary:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:7"
      },
      "items": [
        {
          "text": "\"In triumph I will parcel out Shechem",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:7"
      },
      "items": [
        {
          "text": "and measure off the Valley of Sukkoth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 108:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilead is mine, Manasseh is mine;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:8"
      },
      "items": [
        {
          "text": "Ephraim is my helmet,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:8"
      },
      "items": [
        {
          "text": "Judah is my scepter.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 108:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moab is my washbasin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:9"
      },
      "items": [
        {
          "text": "on Edom I toss my sandal;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:9"
      },
      "items": [
        {
          "text": "over Philistia I shout in triumph.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 108:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who will bring me to the fortified city?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:10"
      },
      "items": [
        {
          "text": "Who will lead me to Edom?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 108:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Is it not you, God, you who have rejected us",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:11"
      },
      "items": [
        {
          "text": "and no longer go out with our armies?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 108:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Give us aid against the enemy,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:12"
      },
      "items": [
        {
          "text": "for human help is worthless.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 108:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "With God we will gain the victory,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:13"
      },
      "items": [
        {
          "text": "and he will trample down our enemies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.109",
    "number": "109",
    "bookId": "PSA"
  },
