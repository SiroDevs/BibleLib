  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "79",
        "style": "c",
        "sid": "PSA 79"
      },
      "items": [
        {
          "text": "79",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 79",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A psalm of Asaph.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 79:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O God, the nations have invaded your inheritance;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "they have defiled your holy temple,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "they have reduced Jerusalem to rubble.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 79:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have left the dead bodies of your servants",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "as food for the birds of the sky,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "the flesh of your own people for the animals of the wild.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 79:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have poured out blood like water",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "all around Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "and there is no one to bury the dead.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 79:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "We are objects of contempt to our neighbors,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "of scorn and derision to those around us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 79:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "How long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.79.5",
                "verseOrgIds": [
                  "PSA.79.5"
                ]
              }
            }
          ]
        },
        {
          "text": "? Will you be angry forever?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:5"
      },
      "items": [
        {
          "text": "How long will your jealousy burn like fire?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 79:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pour out your wrath on the nations",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "that do not acknowledge you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "on the kingdoms",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "that do not call on your name;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 79:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "for they have devoured Jacob",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:7"
      },
      "items": [
        {
          "text": "and devastated his homeland.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 79:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not hold against us the sins of past generations;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "may your mercy come quickly to meet us,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "for we are in desperate need.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 79:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Help us, God our Savior,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "for the glory of your name;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "deliver us and forgive our sins",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "for your name's sake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 79:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why should the nations say,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "\"Where is their God?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 79:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "Before our eyes, make known among the nations",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "that you avenge the outpoured blood of your servants.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 79:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "May the groans of the prisoners come before you;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "with your strong arm preserve those condemned to die.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 79:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pay back into the laps of our neighbors seven times",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:12"
      },
      "items": [
        {
          "text": "the contempt they have hurled at you, Lord.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.12",
            "verseOrgIds": [
              "PSA.79.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 79:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then we your people, the sheep of your pasture,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:13"
      },
      "items": [
        {
          "text": "will praise you forever;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:13"
      },
      "items": [
        {
          "text": "from generation to generation",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:13"
      },
      "items": [
        {
          "text": "we will proclaim your praise.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.13",
            "verseOrgIds": [
              "PSA.79.13"
            ]
          }
        }
      ]
    }
  ],
