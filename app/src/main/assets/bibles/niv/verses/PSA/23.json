                "verseOrgIds": [
                  "PSA.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "is my shepherd, I lack nothing.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
