          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:5"
