          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "He makes me lie down in green pastures,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
