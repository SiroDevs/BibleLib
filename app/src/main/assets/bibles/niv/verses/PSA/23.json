          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:4"
      },
