{
  "id": "PSA.58",
  "number": "58",
  "bookId": "PSA",
  "reference": "Psalm 58",
  "copyright": "The Holy Bible, New International Version® NIV® Copyright © 1973, 1978, 1984, 2011 by Biblica, Inc.® Used by Permission of Biblica, Inc.® All rights reserved worldwide.",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "PSA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. To the tune of \"Do Not Destroy.\" Of David. A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "miktam.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do you rulers indeed speak justly?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:1"
      },
      "items": [
        {
          "text": "Do you judge people with equity?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "No, in your heart you devise injustice,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:2"
      },
      "items": [
        {
          "text": "and your hands mete out violence on the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Even from birth the wicked go astray;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:3"
      },
      "items": [
        {
          "text": "from the womb they are wayward, spreading lies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their venom is like the venom of a snake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:4"
      },
      "items": [
        {
          "text": "like that of a cobra that has stopped its ears,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "that will not heed the tune of the charmer,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:5"
      },
      "items": [
        {
          "text": "however skillful the enchanter may be.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Break the teeth in their mouths, O God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.58.6",
                "verseOrgIds": [
                  "PSA.58.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", tear out the fangs of those lions!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let them vanish like water that flows away;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:7"
      },
      "items": [
        {
          "text": "when they draw the bow, let their arrows fall short.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "May they be like a slug that melts away as it moves along,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:8"
      },
      "items": [
        {
          "text": "like a stillborn child that never sees the sun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Before your pots can feel the heat of the thorns—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:9"
      },
      "items": [
        {
          "text": "whether they be green or dry—the wicked will be swept away.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 58:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The righteous will be glad when they are avenged,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:10"
      },
      "items": [
        {
          "text": "when they dip their feet in the blood of the wicked.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 58:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then people will say,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "\"Surely the righteous still are rewarded;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "surely there is a God who judges the earth.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.59",
    "number": "59",
