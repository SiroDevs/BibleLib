          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:2"
      },
      "items": [
