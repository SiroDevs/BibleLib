          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.130.5",
                "verseOrgIds": [
                  "PSA.130.5"
                ]
              }
            }
          ]
