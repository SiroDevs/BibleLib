      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A song of ascents.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
