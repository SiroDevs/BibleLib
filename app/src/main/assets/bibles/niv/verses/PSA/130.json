            "style": "v",
            "sid": "PSA 130:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "But with you there is forgiveness,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:4"
      },
      "items": [
        {
          "text": "so that we can, with reverence, serve you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
