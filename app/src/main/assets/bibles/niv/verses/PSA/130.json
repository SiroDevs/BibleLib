          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Out of the depths I cry to you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.130.1",
                "verseOrgIds": [
                  "PSA.130.1"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
