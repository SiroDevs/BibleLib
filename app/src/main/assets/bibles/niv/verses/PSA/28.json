            "sid": "PSA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear my cry for mercy",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:2"
      },
      "items": [
        {
