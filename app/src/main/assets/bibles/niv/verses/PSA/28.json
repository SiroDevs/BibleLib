      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "toward your Most Holy Place.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
