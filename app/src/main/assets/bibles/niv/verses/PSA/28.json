          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:3"
      },
