  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "76",
        "style": "c",
        "sid": "PSA 76"
      },
      "items": [
        {
          "text": "76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. With stringed instruments. A psalm of Asaph. A song.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 76:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "God is renowned in Judah;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:1"
      },
      "items": [
        {
          "text": "in Israel his name is great.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 76:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "His tent is in Salem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:2"
      },
      "items": [
        {
          "text": "his dwelling place in Zion.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 76:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "There he broke the flashing arrows,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:3"
      },
      "items": [
        {
          "text": "the shields and the swords, the weapons of war.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 76:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "You are radiant with light,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:4"
      },
      "items": [
        {
          "text": "more majestic than mountains rich with game.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 76:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The valiant lie plundered,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "they sleep their last sleep;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "not one of the warriors",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "can lift his hands.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 76:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "At your rebuke, God of Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:6"
      },
      "items": [
        {
          "text": "both horse and chariot lie still.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 76:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is you alone who are to be feared.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:7"
      },
      "items": [
        {
          "text": "Who can stand before you when you are angry?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 76:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "From heaven you pronounced judgment,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:8"
      },
      "items": [
        {
          "text": "and the land feared and was quiet—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 76:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "when you, God, rose up to judge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:9"
      },
      "items": [
        {
          "text": "to save all the afflicted of the land.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 76:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely your wrath against mankind brings you praise,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:10"
      },
      "items": [
        {
          "text": "and the survivors of your wrath are restrained.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 76:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Make vows to the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.11",
                "verseOrgIds": [
                  "PSA.76.12"
                ]
              }
            }
          ]
        },
        {
          "text": "your God and fulfill them;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:11"
      },
      "items": [
        {
          "text": "let all the neighboring lands",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:11"
      },
      "items": [
        {
          "text": "bring gifts to the One to be feared.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 76:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "He breaks the spirit of rulers;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:12"
      },
      "items": [
        {
          "text": "he is feared by the kings of the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    }
  ],
