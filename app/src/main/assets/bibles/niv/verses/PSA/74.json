          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not hand over the life of your dove to wild beasts;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
