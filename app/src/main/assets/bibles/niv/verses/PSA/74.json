      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:19"
      },
      "items": [
        {
          "text": "do not forget the lives of your afflicted people forever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
      ]
    },
