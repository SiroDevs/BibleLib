          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not let the oppressed retreat in disgrace;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
