        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "How long,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.1",
                "verseOrgIds": [
                  "PSA.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "? Will you forget me forever?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:1"
      },
      "items": [
        {
          "text": "How long will you hide your face from me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "How long must I wrestle with my thoughts",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "and day after day have sorrow in my heart?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "How long will my enemy triumph over me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Look on me and answer,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.3",
                "verseOrgIds": [
                  "PSA.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "my God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:3"
      },
      "items": [
        {
          "text": "Give light to my eyes, or I will sleep in death,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "and my enemy will say, \"I have overcome him,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:4"
      },
      "items": [
        {
          "text": "and my foes will rejoice when I fall.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But I trust in your unfailing love;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:5"
      },
      "items": [
        {
          "text": "my heart rejoices in your salvation.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will sing the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.6",
                "verseOrgIds": [
                  "PSA.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "'s praise,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:6"
      },
      "items": [
        {
          "text": "for he has been good to me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    }
  ],
