      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "I will praise your name for ever and ever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
