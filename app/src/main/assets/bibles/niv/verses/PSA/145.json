                "verseOrgIds": [
                  "PSA.145.3"
                ]
              }
            }
          ]
        },
        {
          "text": "and most worthy of praise;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
