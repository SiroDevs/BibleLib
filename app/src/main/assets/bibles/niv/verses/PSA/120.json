        {
          "text": "and he answers me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
