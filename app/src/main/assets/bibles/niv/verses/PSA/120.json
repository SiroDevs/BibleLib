          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.120.2",
                "verseOrgIds": [
                  "PSA.120.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
