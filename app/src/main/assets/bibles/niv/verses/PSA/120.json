              "type": "text",
              "attrs": {
                "verseId": "PSA.120.1",
                "verseOrgIds": [
                  "PSA.120.1"
                ]
              }
            }
          ]
        },
        {
          "text": "in my distress,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
