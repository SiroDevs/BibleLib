        {
          "text": "I am for peace;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:7"
      },
      "items": [
        {
          "text": "but when I speak, they are for war.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
