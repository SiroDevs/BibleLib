      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. With stringed instruments. Of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear my cry, O God;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:1"
      },
      "items": [
        {
          "text": "listen to my prayer.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "From the ends of the earth I call to you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "I call as my heart grows faint;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "lead me to the rock that is higher than I.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For you have been my refuge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:3"
      },
      "items": [
        {
          "text": "a strong tower against the foe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I long to dwell in your tent forever",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:4"
      },
      "items": [
        {
          "text": "and take refuge in the shelter of your wings.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "For you, God, have heard my vows;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:5"
      },
      "items": [
        {
          "text": "you have given me the heritage of those who fear your name.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Increase the days of the king's life,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:6"
      },
      "items": [
        {
          "text": "his years for many generations.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "May he be enthroned in God's presence forever;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:7"
      },
      "items": [
        {
          "text": "appoint your love and faithfulness to protect him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I will ever sing in praise of your name",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:8"
      },
      "items": [
        {
          "text": "and fulfill my vows day after day.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    }
  ],
