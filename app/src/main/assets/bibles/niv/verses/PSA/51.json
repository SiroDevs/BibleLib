  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "PSA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. A psalm of David. When the prophet Nathan came to him after David had committed adultery with Bathsheba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Have mercy on me, O God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "according to your unfailing love;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "according to your great compassion",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:1"
      },
      "items": [
        {
          "text": "blot out my transgressions.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wash away all my iniquity",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:2"
      },
      "items": [
        {
          "text": "and cleanse me from my sin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For I know my transgressions,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:3"
      },
      "items": [
        {
          "text": "and my sin is always before me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Against you, you only, have I sinned",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "and done what is evil in your sight;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "so you are right in your verdict",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:4"
      },
      "items": [
        {
          "text": "and justified when you judge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely I was sinful at birth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:5"
      },
      "items": [
        {
          "text": "sinful from the time my mother conceived me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet you desired faithfulness even in the womb;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:6"
      },
      "items": [
        {
          "text": "you taught me wisdom in that secret place.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cleanse me with hyssop, and I will be clean;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:7"
      },
      "items": [
        {
          "text": "wash me, and I will be whiter than snow.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let me hear joy and gladness;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:8"
      },
      "items": [
        {
          "text": "let the bones you have crushed rejoice.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hide your face from my sins",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:9"
      },
      "items": [
        {
          "text": "and blot out all my iniquity.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Create in me a pure heart, O God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:10"
      },
      "items": [
        {
          "text": "and renew a steadfast spirit within me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not cast me from your presence",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:11"
      },
      "items": [
        {
          "text": "or take your Holy Spirit from me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Restore to me the joy of your salvation",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:12"
      },
      "items": [
        {
          "text": "and grant me a willing spirit, to sustain me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I will teach transgressors your ways,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:13"
      },
      "items": [
        {
          "text": "so that sinners will turn back to you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deliver me from the guilt of bloodshed, O God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "you who are God my Savior,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:14"
      },
      "items": [
        {
          "text": "and my tongue will sing of your righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Open my lips, Lord,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:15"
      },
      "items": [
        {
          "text": "and my mouth will declare your praise.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 51:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "You do not delight in sacrifice, or I would bring it;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:16"
      },
      "items": [
        {
          "text": "you do not take pleasure in burnt offerings.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 51:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "My sacrifice, O God, is",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.19"
            ]
          }
        },
        {
          "text": "a broken spirit;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:17"
      },
