      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:23"
      },
      "items": [
        {
          "text": "test me and know my anxious thoughts.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.23",
            "verseOrgIds": [
              "PSA.139.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
