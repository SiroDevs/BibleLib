          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "See if there is any offensive way in me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.24",
            "verseOrgIds": [
              "PSA.139.24"
            ]
