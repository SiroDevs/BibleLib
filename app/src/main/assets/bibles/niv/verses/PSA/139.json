      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:21"
      },
      "items": [
        {
          "text": "and abhor those who are in rebellion against you?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.21",
            "verseOrgIds": [
              "PSA.139.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 139:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I have nothing but hatred for them;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:22"
      },
      "items": [
        {
          "text": "I count them my enemies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 139:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Search me, God, and know my heart;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.23",
            "verseOrgIds": [
              "PSA.139.23"
            ]
          }
        }
      ]
    },
