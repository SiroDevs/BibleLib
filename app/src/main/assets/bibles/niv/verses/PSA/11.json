    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:6"
      },
      "items": [
        {
          "text": "fiery coals and burning sulfur;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:6"
