      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "\"Flee like a bird to your mountain.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
