      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:3"
      },
      "items": [
        {
          "text": "what can the righteous do?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
