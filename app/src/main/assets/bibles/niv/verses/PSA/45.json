  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "PSA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "For the director of music. To the tune of \"Lilies.\" Of the Sons of Korah. A",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil.",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wedding song.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "My heart is stirred by a noble theme",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "as I recite my verses for the king;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "my tongue is the pen of a skillful writer.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "You are the most excellent of men",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "and your lips have been anointed with grace,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "since God has blessed you forever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gird your sword on your side, you mighty one;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:3"
      },
      "items": [
        {
          "text": "clothe yourself with splendor and majesty.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "In your majesty ride forth victoriously",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "in the cause of truth, humility and justice;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "let your right hand achieve awesome deeds.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let your sharp arrows pierce the hearts of the king's enemies;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "text": "let the nations fall beneath your feet.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your throne, O God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        },
        {
          "text": "will last for ever and ever;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:6"
      },
      "items": [
        {
          "text": "a scepter of justice will be the scepter of your kingdom.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "You love righteousness and hate wickedness;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "therefore God, your God, has set you above your companions",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "by anointing you with the oil of joy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "All your robes are fragrant with myrrh and aloes and cassia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "from palaces adorned with ivory",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "the music of the strings makes you glad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daughters of kings are among your honored women;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "at your right hand is the royal bride in gold of Ophir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen, daughter, and pay careful attention:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:10"
      },
      "items": [
        {
          "text": "Forget your people and your father's house.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let the king be enthralled by your beauty;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:11"
      },
      "items": [
        {
          "text": "honor him, for he is your lord.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The city of Tyre will come with a gift,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:12"
      },
      "items": [
        {
          "text": "people of wealth will seek your favor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "All glorious is the princess within her chamber;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:13"
      },
      "items": [
        {
          "text": "her gown is interwoven with gold.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "In embroidered garments she is led to the king;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "her virgin companions follow her—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "those brought to be with her.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Led in with joy and gladness,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.15",
            "verseOrgIds": [
              "PSA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:15"
      },
      "items": [
        {
          "text": "they enter the palace of the king.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.15",
            "verseOrgIds": [
              "PSA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your sons will take the place of your fathers;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.16",
            "verseOrgIds": [
              "PSA.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:16"
      },
      "items": [
        {
          "text": "you will make them princes throughout the land.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.16",
            "verseOrgIds": [
              "PSA.45.17"
            ]
          }
        }
      ]
