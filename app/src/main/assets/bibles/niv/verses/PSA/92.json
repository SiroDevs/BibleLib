                "verseId": "PSA.92.8",
                "verseOrgIds": [
                  "PSA.92.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", are forever exalted.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.8",
            "verseOrgIds": [
              "PSA.92.9"
            ]
          }
        }
