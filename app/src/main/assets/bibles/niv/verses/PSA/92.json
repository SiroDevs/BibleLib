      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:12"
      },
      "items": [
        {
          "text": "they will grow like a cedar of Lebanon;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
