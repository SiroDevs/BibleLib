          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.13",
                "verseOrgIds": [
                  "PSA.92.14"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
