    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:5"
      },
      "items": [
        {
          "text": "how profound your thoughts!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
