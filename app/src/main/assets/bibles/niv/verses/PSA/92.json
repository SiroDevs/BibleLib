          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.92.15",
                "verseOrgIds": [
                  "PSA.92.16"
                ]
              }
            }
          ]
        },
        {
          "text": "is upright;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.16"
            ]
          }
        }
      ]
    },
