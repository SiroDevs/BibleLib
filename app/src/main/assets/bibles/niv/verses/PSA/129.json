      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:1"
      },
      "items": [
        {
          "text": "let Israel say;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
