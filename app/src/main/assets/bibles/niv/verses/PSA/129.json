      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:2"
      },
      "items": [
        {
          "text": "but they have not gained the victory over me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
