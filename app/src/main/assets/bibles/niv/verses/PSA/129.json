          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 129:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
