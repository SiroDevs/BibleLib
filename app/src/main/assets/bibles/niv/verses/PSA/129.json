      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:8"
      },
      "items": [
        {
          "text": "we bless you in the name of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.129.8",
                "verseOrgIds": [
                  "PSA.129.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
