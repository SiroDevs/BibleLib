                "verseId": "PSA.129.4",
                "verseOrgIds": [
                  "PSA.129.4"
                ]
              }
            }
          ]
        },
        {
          "text": "is righteous;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
