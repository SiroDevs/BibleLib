          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "May all who hate Zion",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
