        "sid": "PSA 82"
      },
      "items": [
        {
          "text": "82",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 82",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A psalm of Asaph.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 82:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "God presides in the great assembly;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:1"
      },
      "items": [
        {
          "text": "he renders judgment among the \"gods\":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 82:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"How long will you",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        },
        {
          "text": "defend the unjust",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:2"
      },
      "items": [
        {
          "text": "and show partiality to the wicked?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 82:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Defend the weak and the fatherless;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:3"
      },
      "items": [
        {
          "text": "uphold the cause of the poor and the oppressed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 82:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rescue the weak and the needy;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:4"
      },
      "items": [
        {
          "text": "deliver them from the hand of the wicked.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 82:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"The 'gods' know nothing, they understand nothing.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "They walk about in darkness;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "all the foundations of the earth are shaken.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 82:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I said, 'You are \"gods\";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:6"
      },
      "items": [
        {
          "text": "you are all sons of the Most High.'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 82:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "But you will die like mere mortals;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:7"
      },
      "items": [
        {
          "text": "you will fall like every other ruler.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 82:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rise up, O God, judge the earth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:8"
      },
      "items": [
        {
          "text": "for all the nations are your inheritance.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    }
  ],
