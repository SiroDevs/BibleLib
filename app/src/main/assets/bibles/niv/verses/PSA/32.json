      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Blessed is the one",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:1"
      },
      "items": [
        {
          "text": "whose transgressions are forgiven,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:1"
      },
      "items": [
        {
          "text": "whose sins are covered.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Blessed is the one",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:2"
      },
      "items": [
        {
          "text": "whose sin the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.2",
                "verseOrgIds": [
                  "PSA.32.2"
                ]
              }
            }
          ]
        },
        {
          "text": "does not count against them",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:2"
      },
      "items": [
        {
          "text": "and in whose spirit is no deceit.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I kept silent,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:3"
      },
      "items": [
        {
          "text": "my bones wasted away",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:3"
      },
      "items": [
        {
          "text": "through my groaning all day long.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For day and night",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:4"
      },
      "items": [
        {
          "text": "your hand was heavy on me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:4"
      },
      "items": [
        {
          "text": "my strength was sapped",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:4"
      },
      "items": [
        {
          "text": "as in the heat of summer.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I acknowledged my sin to you",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "and did not cover up my iniquity.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "I said, \"I will confess",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "my transgressions to the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.5",
                "verseOrgIds": [
                  "PSA.32.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "And you forgave",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "the guilt of my sin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore let all the faithful pray to you",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "while you may be found;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "surely the rising of the mighty waters",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "will not reach them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "You are my hiding place;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:7"
      },
      "items": [
        {
          "text": "you will protect me from trouble",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:7"
      },
      "items": [
        {
          "text": "and surround me with songs of deliverance.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will instruct you and teach you in the way you should go;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:8"
      },
      "items": [
        {
          "text": "I will counsel you with my loving eye on you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not be like the horse or the mule,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "which have no understanding",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "but must be controlled by bit and bridle",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "or they will not come to you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Many are the woes of the wicked,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:10"
      },
      "items": [
        {
          "text": "but the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.10",
                "verseOrgIds": [
                  "PSA.32.10"
                ]
              }
            }
          ]
        },
        {
          "text": "'s unfailing love",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:10"
      },
      "items": [
        {
          "text": "surrounds the one who trusts in him.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rejoice in the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.11",
                "verseOrgIds": [
                  "PSA.32.11"
                ]
              }
            }
          ]
        },
        {
          "text": "and be glad, you righteous;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:11"
      },
      "items": [
        {
          "text": "sing, all you who are upright in heart!",
