  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "141",
        "style": "c",
        "sid": "PSA 141"
      },
      "items": [
        {
          "text": "141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 141:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I call to you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.1",
                "verseOrgIds": [
                  "PSA.141.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", come quickly to me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:1"
      },
      "items": [
        {
          "text": "hear me when I call to you.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 141:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "May my prayer be set before you like incense;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:2"
      },
      "items": [
        {
          "text": "may the lifting up of my hands be like the evening sacrifice.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 141:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Set a guard over my mouth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.3",
                "verseOrgIds": [
                  "PSA.141.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:3"
      },
      "items": [
        {
          "text": "keep watch over the door of my lips.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 141:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not let my heart be drawn to what is evil",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "so that I take part in wicked deeds",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "along with those who are evildoers;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "do not let me eat their delicacies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 141:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let a righteous man strike me—that is a kindness;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "let him rebuke me—that is oil on my head.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "My head will not refuse it,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "for my prayer will still be against the deeds of evildoers.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 141:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their rulers will be thrown down from the cliffs,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:6"
      },
      "items": [
        {
          "text": "and the wicked will learn that my words were well spoken.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 141:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "They will say, \"As one plows and breaks up the earth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:7"
      },
      "items": [
        {
          "text": "so our bones have been scattered at the mouth of the grave.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 141:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "But my eyes are fixed on you, Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.141.8",
                "verseOrgIds": [
                  "PSA.141.8"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:8"
      },
      "items": [
        {
          "text": "in you I take refuge—do not give me over to death.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 141:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keep me safe from the traps set by evildoers,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:9"
      },
      "items": [
        {
          "text": "from the snares they have laid for me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 141:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let the wicked fall into their own nets,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:10"
      },
      "items": [
        {
          "text": "while I pass by in safety.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.142",
    "number": "142",
