  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "PSA 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Psalm 35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Contend,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.1",
                "verseOrgIds": [
                  "PSA.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", with those who contend with me;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:1"
      },
      "items": [
        {
          "text": "fight against those who fight against me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take up shield and armor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:2"
      },
      "items": [
        {
          "text": "arise and come to my aid.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Brandish spear and javelin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "against those who pursue me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "Say to me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "\"I am your salvation.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "May those who seek my life",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "be disgraced and put to shame;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "may those who plot my ruin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "be turned back in dismay.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "May they be like chaff before the wind,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:5"
      },
      "items": [
        {
          "text": "with the angel of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.5",
                "verseOrgIds": [
                  "PSA.35.5"
                ]
              }
            }
          ]
        },
        {
          "text": "driving them away;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "may their path be dark and slippery,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:6"
      },
      "items": [
        {
          "text": "with the angel of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.6",
                "verseOrgIds": [
                  "PSA.35.6"
                ]
              }
            }
          ]
        },
        {
          "text": "pursuing them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Since they hid their net for me without cause",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:7"
      },
      "items": [
        {
          "text": "and without cause dug a pit for me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "may ruin overtake them by surprise—",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "may the net they hid entangle them,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "may they fall into the pit, to their ruin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then my soul will rejoice in the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.9",
                "verseOrgIds": [
                  "PSA.35.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:9"
      },
      "items": [
        {
          "text": "and delight in his salvation.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "My whole being will exclaim,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "\"Who is like you,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.10",
                "verseOrgIds": [
                  "PSA.35.10"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "You rescue the poor from those too strong for them,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "the poor and needy from those who rob them.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruthless witnesses come forward;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:11"
      },
      "items": [
        {
          "text": "they question me on things I know nothing about.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "They repay me evil for good",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:12"
      },
      "items": [
        {
          "text": "and leave me like one bereaved.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet when they were ill, I put on sackcloth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:13"
      },
      "items": [
        {
          "text": "and humbled myself with fasting.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:13"
      },
      "items": [
        {
          "text": "When my prayers returned to me unanswered,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I went about mourning",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
