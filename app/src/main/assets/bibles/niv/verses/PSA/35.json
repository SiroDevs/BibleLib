      "attrs": {
        "style": "q2",
        "vid": "PSA 35:15"
      },
      "items": [
        {
          "text": "assailants gathered against me without my knowledge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
