  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ECC 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember your Creator",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "in the days of your youth,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "before the days of trouble come",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "and the years approach when you will say,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "\"I find no pleasure in them\"—",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "before the sun and the light",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:2"
      },
      "items": [
        {
          "text": "and the moon and the stars grow dark,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:2"
      },
      "items": [
        {
          "text": "and the clouds return after the rain;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "when the keepers of the house tremble,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "and the strong men stoop,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "when the grinders cease because they are few,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "and those looking through the windows grow dim;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "when the doors to the street are closed",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:4"
      },
      "items": [
        {
          "text": "and the sound of grinding fades;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:4"
      },
      "items": [
        {
          "text": "when people rise up at the sound of birds,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:4"
      },
      "items": [
        {
          "text": "but all their songs grow faint;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "when people are afraid of heights",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "and of dangers in the streets;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "when the almond tree blossoms",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "and the grasshopper drags itself along",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "and desire no longer is stirred.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "Then people go to their eternal home",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "and mourners go about the streets.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember him—before the silver cord is severed,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:6"
      },
      "items": [
        {
          "text": "and the golden bowl is broken;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:6"
      },
      "items": [
        {
          "text": "before the pitcher is shattered at the spring,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:6"
      },
      "items": [
        {
          "text": "and the wheel broken at the well,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "and the dust returns to the ground it came from,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:7"
      },
      "items": [
        {
          "text": "and the spirit returns to God who gave it.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meaningless! Meaningless!\" says the Teacher.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:8"
      },
      "items": [
        {
          "text": "\"Everything is meaningless!\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The Conclusion of the Matter",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Not only was the Teacher wise, but he also imparted knowledge to the people. He pondered and searched out and set in order many proverbs.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Teacher searched to find just the right words, and what he wrote was upright and true.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The words of the wise are like goads, their collected sayings like firmly embedded nails—given by one shepherd.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be warned, my son, of anything in addition to them.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ECC 12:12"
      },
      "items": [
        {
          "text": "Of making many books there is no end, and much study wearies the body.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now all has been heard;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:13"
      },
      "items": [
        {
          "text": "here is the conclusion of the matter:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:13"
      },
      "items": [
        {
          "text": "Fear God and keep his commandments,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:13"
      },
      "items": [
        {
          "text": "for this is the duty of all mankind.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "For God will bring every deed into judgment,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
            "verseOrgIds": [
              "ECC.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:14"
      },
      "items": [
        {
          "text": "including every hidden thing,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
            "verseOrgIds": [
              "ECC.12.14"
            ]
          }
        }
      ]
    },
