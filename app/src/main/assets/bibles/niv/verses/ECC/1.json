  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ECC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Everything Is Meaningless",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The words of the Teacher,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        },
        {
          "text": "son of David, king in Jerusalem:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meaningless! Meaningless!\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "says the Teacher.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "\"Utterly meaningless!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Everything is meaningless.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "What do people gain from all their labors",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:3"
      },
      "items": [
        {
          "text": "at which they toil under the sun?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Generations come and generations go,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:4"
      },
      "items": [
        {
          "text": "but the earth remains forever.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sun rises and the sun sets,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:5"
      },
      "items": [
        {
          "text": "and hurries back to where it rises.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wind blows to the south",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "and turns to the north;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "round and round it goes,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "ever returning on its course.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "All streams flow into the sea,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "yet the sea is never full.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "To the place the streams come from,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "there they return again.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "All things are wearisome,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "more than one can say.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "The eye never has enough of seeing,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "nor the ear its fill of hearing.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "What has been will be again,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "what has been done will be done again;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "there is nothing new under the sun.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Is there anything of which one can say,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "\"Look! This is something new\"?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "It was here already, long ago;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "it was here before our time.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "No one remembers the former generations,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "and even those yet to come",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "will not be remembered",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "by those who follow them.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wisdom Is Meaningless",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I, the Teacher, was king over Israel in Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I applied my mind to study and to explore by wisdom all that is done under the heavens. What a heavy burden God has laid on mankind!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I have seen all the things that are done under the sun; all of them are meaningless, a chasing after the wind.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "What is crooked cannot be straightened;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:15"
      },
      "items": [
        {
          "text": "what is lacking cannot be counted.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I said to myself, \"Look, I have increased in wisdom more than anyone who has ruled over Jerusalem before me; I have experienced much of wisdom and knowledge.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
