                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "'s people Israel—I will celebrate before the",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
