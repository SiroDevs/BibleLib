              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.27",
                "verseOrgIds": [
                  "2SA.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty, God of Israel, you have revealed this to your servant, saying, 'I will build a house for you.' So your servant has found courage to pray this prayer to you.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.28",
                "verseOrgIds": [
                  "2SA.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", you are God! Your covenant is trustworthy, and you have promised these good things to your servant.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now be pleased to bless the house of your servant, that it may continue forever in your sight; for you, Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.29",
                "verseOrgIds": [
                  "2SA.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", have spoken, and with your blessing the house of your servant will be blessed forever.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
