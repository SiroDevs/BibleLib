          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"And now,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.25",
                "verseOrgIds": [
                  "2SA.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "God, keep forever the promise you have made concerning your servant and his house. Do as you promised,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "so that your name will be great forever. Then people will say, 'The",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.26",
                "verseOrgIds": [
                  "2SA.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty is God over Israel!' And the house of your servant David will be established in your sight.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        }
      ]
    },
