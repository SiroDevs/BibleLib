          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your navel is a rounded goblet",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "that never lacks blended wine.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "Your waist is a mound of wheat",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "encircled by lilies.",
