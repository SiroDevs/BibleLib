          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like a lily among thorns",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:2"
      },
      "items": [
        {
          "text": "is my darling among the young women.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "She",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like an apple",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        },
        {
          "text": "tree among the trees of the forest",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "is my beloved among the young men.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "I delight to sit in his shade,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "and his fruit is sweet to my taste.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let him lead me to the banquet hall,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:4"
      },
      "items": [
        {
          "text": "and let his banner over me be love.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Strengthen me with raisins,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "refresh me with apples,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "for I am faint with love.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "His left arm is under my head,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:6"
      },
      "items": [
        {
          "text": "and his right arm embraces me.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daughters of Jerusalem, I charge you",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "by the gazelles and by the does of the field:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "Do not arouse or awaken love",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "until it so desires.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen! My beloved!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "Look! Here he comes,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "leaping across the mountains,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "bounding over the hills.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "My beloved is like a gazelle or a young stag.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "Look! There he stands behind our wall,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "gazing through the windows,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "peering through the lattice.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "My beloved spoke and said to me,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:10"
      },
      "items": [
        {
          "text": "\"Arise, my darling,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:10"
      },
      "items": [
        {
          "text": "my beautiful one, come with me.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "See! The winter is past;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:11"
      },
      "items": [
        {
          "text": "the rains are over and gone.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Flowers appear on the earth;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "the season of singing has come,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "the cooing of doves",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "is heard in our land.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fig tree forms its early fruit;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "the blossoming vines spread their fragrance.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "Arise, come, my darling;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "my beautiful one, come with me.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "He",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
