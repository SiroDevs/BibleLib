          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have stolen my heart, my sister, my bride;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "you have stolen my heart",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "with one glance of your eyes,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "with one jewel of your necklace.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "How delightful is your love, my sister, my bride!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "How much more pleasing is your love than wine,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "and the fragrance of your perfume",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "more than any spice!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your lips drop sweetness as the honeycomb, my bride;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "milk and honey are under your tongue.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "The fragrance of your garments",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "is like the fragrance of Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
