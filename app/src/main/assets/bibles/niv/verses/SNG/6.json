  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "SNG 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Friends",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Where has your beloved gone,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "most beautiful of women?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "Which way did your beloved turn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "that we may look for him with you?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "She",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "My beloved has gone down to his garden,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "to the beds of spices,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "to browse in the gardens",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "and to gather lilies.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am my beloved's and my beloved is mine;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:3"
      },
      "items": [
        {
          "text": "he browses among the lilies.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "He",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "You are as beautiful as Tirzah, my darling,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "as lovely as Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "as majestic as troops with banners.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Turn your eyes from me;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "they overwhelm me.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "Your hair is like a flock of goats",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "descending from Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your teeth are like a flock of sheep",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "coming up from the washing.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "Each has its twin,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "not one of them is missing.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your temples behind your veil",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:7"
      },
      "items": [
        {
          "text": "are like the halves of a pomegranate.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sixty queens there may be,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "and eighty concubines,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "and virgins beyond number;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "but my dove, my perfect one, is unique,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "the only daughter of her mother,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "the favorite of the one who bore her.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "The young women saw her and called her blessed;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "the queens and concubines praised her.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Friends",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who is this that appears like the dawn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "fair as the moon, bright as the sun,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "majestic as the stars in procession?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "He",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I went down to the grove of nut trees",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "to look at the new growth in the valley,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "to see if the vines had budded",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "or the pomegranates were in bloom.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Before I realized it,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.12",
            "verseOrgIds": [
              "SNG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:12"
      },
      "items": [
        {
          "text": "my desire set me among the royal chariots of my people.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.12",
            "verseOrgIds": [
              "SNG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Friends",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Come back, come back, O Shulammite;",
          "type": "text",
          "attrs": {
