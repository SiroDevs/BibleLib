        "style": "c",
        "sid": "SNG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon's Song of Songs.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.1",
            "verseOrgIds": [
              "SNG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "She",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let him kiss me with the kisses of his mouth—",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:2"
      },
      "items": [
        {
          "text": "for your love is more delightful than wine.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pleasing is the fragrance of your perfumes;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:3"
      },
      "items": [
        {
          "text": "your name is like perfume poured out.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:3"
      },
      "items": [
        {
          "text": "No wonder the young women love you!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take me away with you—let us hurry!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Let the king bring me into his chambers.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "Friends",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "We rejoice and delight in you",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "we will praise your love more than wine.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "She",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:4"
      },
      "items": [
        {
          "text": "How right they are to adore you!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dark am I, yet lovely,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "daughters of Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "dark like the tents of Kedar,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:5"
      },
      "items": [
        {
          "text": "like the tent curtains of Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not stare at me because I am dark,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "because I am darkened by the sun.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "My mother's sons were angry with me",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "and made me take care of the vineyards;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:6"
      },
      "items": [
        {
          "text": "my own vineyard I had to neglect.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tell me, you whom I love,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "where you graze your flock",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "and where you rest your sheep at midday.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "Why should I be like a veiled woman",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:7"
      },
      "items": [
        {
          "text": "beside the flocks of your friends?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Friends",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "If you do not know, most beautiful of women,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "follow the tracks of the sheep",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "and graze your young goats",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:8"
      },
      "items": [
        {
          "text": "by the tents of the shepherds.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "He",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I liken you, my darling, to a mare",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:9"
      },
      "items": [
        {
          "text": "among Pharaoh's chariot horses.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your cheeks are beautiful with earrings,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:10"
      },
      "items": [
        {
          "text": "your neck with strings of jewels.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "We will make you earrings of gold,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:11"
      },
      "items": [
        {
          "text": "studded with silver.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "She",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "While the king was at his table,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:12"
      },
      "items": [
        {
          "text": "my perfume spread its fragrance.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "My beloved is to me a sachet of myrrh",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.13",
            "verseOrgIds": [
              "SNG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 1:13"
      },
      "items": [
        {
          "text": "resting between my breasts.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.13",
            "verseOrgIds": [
              "SNG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
