            "number": "1",
            "style": "v",
            "sid": "SNG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "All night long on my bed",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "I looked for the one my heart loves;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "I looked for him but did not find him.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will get up now and go about the city,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "through its streets and squares;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "I will search for the one my heart loves.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "So I looked for him but did not find him.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The watchmen found me",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "as they made their rounds in the city.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "\"Have you seen the one my heart loves?\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Scarcely had I passed them",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "when I found the one my heart loves.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "I held him and would not let him go",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "till I had brought him to my mother's house,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "to the room of the one who conceived me.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daughters of Jerusalem, I charge you",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "by the gazelles and by the does of the field:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "Do not arouse or awaken love",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "until it so desires.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who is this coming up from the wilderness",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "like a column of smoke,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "perfumed with myrrh and incense",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "made from all the spices of the merchant?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Look! It is Solomon's carriage,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "escorted by sixty warriors,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "the noblest of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "all of them wearing the sword,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "all experienced in battle,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "each with his sword at his side,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "prepared for the terrors of the night.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "King Solomon made for himself the carriage;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:9"
      },
      "items": [
        {
          "text": "he made it of wood from Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Its posts he made of silver,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "its base of gold.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "Its seat was upholstered with purple,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "its interior inlaid with love.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "Daughters of Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "come out,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "and look, you daughters of Zion.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "Look",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        },
        {
          "text": "on King Solomon wearing a crown,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "the crown with which his mother crowned him",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "on the day of his wedding,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "the day his heart rejoiced.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    }
