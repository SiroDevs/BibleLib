      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "but with an overwhelming flood",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:8"
      },
      "items": [
        {
          "text": "he will make an end of Nineveh;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:8"
      },
      "items": [
        {
          "text": "he will pursue his foes into the realm of darkness.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whatever they plot against the",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.9",
                "verseOrgIds": [
                  "NAM.1.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "he will bring",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        },
        {
          "text": "to an end;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:9"
      },
      "items": [
        {
          "text": "trouble will not come a second time.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "They will be entangled among thorns",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "and drunk from their wine;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "they will be consumed like dry stubble.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
