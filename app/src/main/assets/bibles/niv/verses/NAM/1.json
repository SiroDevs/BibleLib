            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.2",
                "verseOrgIds": [
                  "NAM.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "takes vengeance on his foes",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:2"
      },
      "items": [
        {
          "text": "and vents his wrath against his enemies.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
