              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.3",
                "verseOrgIds": [
                  "NAM.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "is slow to anger but great in power;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "NAM.1.3",
                "verseOrgIds": [
                  "NAM.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "will not leave the guilty unpunished.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "His way is in the whirlwind and the storm,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:3"
      },
      "items": [
        {
          "text": "and clouds are the dust of his feet.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "He rebukes the sea and dries it up;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "he makes all the rivers run dry.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "Bashan and Carmel wither",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:4"
      },
      "items": [
        {
          "text": "and the blossoms of Lebanon fade.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The mountains quake before him",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "and the hills melt away.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "The earth trembles at his presence,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:5"
      },
      "items": [
        {
          "text": "the world and all who live in it.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who can withstand his indignation?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "Who can endure his fierce anger?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "His wrath is poured out like fire;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:6"
      },
      "items": [
        {
          "text": "the rocks are shattered before him.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
