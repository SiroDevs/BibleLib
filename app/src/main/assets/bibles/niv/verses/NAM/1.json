      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:7"
      },
      "items": [
        {
          "text": "a refuge in times of trouble.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:7"
      },
      "items": [
        {
          "text": "He cares for those who trust in him,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        }
      ]
    },
    {
