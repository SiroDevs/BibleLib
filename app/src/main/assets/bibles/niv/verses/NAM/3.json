      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "full of lies,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "full of plunder,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "never without victims!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
