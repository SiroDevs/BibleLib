      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nineveh to Fall",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "An attacker advances against you, Nineveh.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "Guard the fortress,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "watch the road,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "brace yourselves,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "marshal all your strength!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "NAM.2.2",
                "verseOrgIds": [
                  "NAM.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "will restore the splendor of Jacob",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "like the splendor of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "though destroyers have laid them waste",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "and have ruined their vines.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The shields of the soldiers are red;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "the warriors are clad in scarlet.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "The metal on the chariots flashes",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "on the day they are made ready;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "the spears of juniper are brandished.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The chariots storm through the streets,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "rushing back and forth through the squares.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "They look like flaming torches;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "they dart about like lightning.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineveh summons her picked troops,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "yet they stumble on their way.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "They dash to the city wall;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "the protective shield is put in place.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The river gates are thrown open",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:6"
      },
      "items": [
        {
          "text": "and the palace collapses.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is decreed",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        },
        {
          "text": "that Nineveh",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "be exiled and carried away.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "Her female slaves moan like doves",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "and beat on their breasts.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineveh is like a pool",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "whose water is draining away.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "\"Stop! Stop!\" they cry,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "but no one turns back.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Plunder the silver!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Plunder the gold!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "The supply is endless,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "the wealth from all its treasures!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "She is pillaged, plundered, stripped!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "Hearts melt, knees give way,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "bodies tremble, every face grows pale.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Where now is the lions' den,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:11"
      },
      "items": [
        {
          "text": "the place where they fed their young,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:11"
      },
      "items": [
        {
          "text": "where the lion and lioness went,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        }
      ]
    },
    {
