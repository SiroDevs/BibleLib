          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua said, \"Why have you brought this trouble on us? The",
          "type": "text",
