                "verseOrgIds": [
                  "JOS.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "is the one who undertakes to rebuild this city, Jericho:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
