          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Joshua built on Mount Ebal an altar to the",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.30",
                "verseOrgIds": [
                  "JOS.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
