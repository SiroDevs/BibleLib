          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Joshua said, \"You are witnesses against yourselves that you have chosen to serve the",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.22",
                "verseOrgIds": [
                  "JOS.24.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 24:22"
      },
      "items": [
        {
          "text": "\"Yes, we are witnesses,\" they replied.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Now then,\" said Joshua, \"throw away the foreign gods that are among you and yield your hearts to the",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.23",
                "verseOrgIds": [
                  "JOS.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of Israel.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        }
      ]
    },
    {
