            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.24",
                "verseOrgIds": [
                  "JOS.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "our God and obey him.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        }
      ]
