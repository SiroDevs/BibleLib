      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "is greater than that of Sodom,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
