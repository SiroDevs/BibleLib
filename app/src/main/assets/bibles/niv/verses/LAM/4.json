      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "they are not recognized in the streets.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:8"
      },
      "items": [
