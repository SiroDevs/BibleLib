      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "it has become as dry as a stick.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
