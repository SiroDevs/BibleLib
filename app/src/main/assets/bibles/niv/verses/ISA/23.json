      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A Prophecy Against Tyre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A prophecy against Tyre:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Wail, you ships of Tarshish!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "For Tyre is destroyed",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "and left without house or harbor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "From the land of Cyprus",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "word has come to them.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be silent, you people of the island",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "and you merchants of Sidon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "whom the seafarers have enriched.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "On the great waters",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "came the grain of the Shihor;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "the harvest of the Nile",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        },
        {
          "text": "was the revenue of Tyre,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "and she became the marketplace of the nations.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be ashamed, Sidon, and you fortress of the sea,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "for the sea has spoken:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "\"I have neither been in labor nor given birth;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "I have neither reared sons nor brought up daughters.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "When word comes to Egypt,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:5"
      },
      "items": [
        {
          "text": "they will be in anguish at the report from Tyre.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cross over to Tarshish;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:6"
      },
      "items": [
        {
          "text": "wail, you people of the island.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Is this your city of revelry,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "the old, old city,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "whose feet have taken her",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "to settle in far-off lands?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who planned this against Tyre,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "the bestower of crowns,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "whose merchants are princes,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "whose traders are renowned in the earth?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.9",
                "verseOrgIds": [
                  "ISA.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty planned it,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "to bring down her pride in all her splendor",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "and to humble all who are renowned on the earth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Till",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        },
        {
          "text": "your land as they do along the Nile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "Daughter Tarshish,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "for you no longer have a harbor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.11",
                "verseOrgIds": [
                  "ISA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "has stretched out his hand over the sea",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "and made its kingdoms tremble.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "He has given an order concerning Phoenicia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "that her fortresses be destroyed.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said, \"No more of your reveling,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
