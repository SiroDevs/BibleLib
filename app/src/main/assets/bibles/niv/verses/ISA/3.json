    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Judgment on Jerusalem and Judah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "See now, the Lord,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.3.1",
                "verseOrgIds": [
                  "ISA.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "is about to take from Jerusalem and Judah",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "both supply and support:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "all supplies of food and all supplies of water,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "the hero and the warrior,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "the judge and the prophet,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "the diviner and the elder,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "the captain of fifty and the man of rank,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:3"
      },
      "items": [
        {
          "text": "the counselor, skilled craftsman and clever enchanter.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I will make mere youths their officials;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:4"
      },
      "items": [
        {
          "text": "children will rule over them.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "People will oppress each other—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "man against man, neighbor against neighbor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "The young will rise up against the old,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "the nobody against the honored.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A man will seize one of his brothers",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "in his father's house, and say,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "\"You have a cloak, you be our leader;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "take charge of this heap of ruins!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "But in that day he will cry out,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "\"I have no remedy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "I have no food or clothing in my house;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "do not make me the leader of the people.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusalem staggers,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "Judah is falling;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "their words and deeds are against the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.3.8",
                "verseOrgIds": [
                  "ISA.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "defying his glorious presence.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The look on their faces testifies against them;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "they parade their sin like Sodom;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "they do not hide it.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "Woe to them!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "They have brought disaster upon themselves.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tell the righteous it will be well with them,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:10"
      },
      "items": [
        {
          "text": "for they will enjoy the fruit of their deeds.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woe to the wicked!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "Disaster is upon them!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "They will be paid back",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "for what their hands have done.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Youths oppress my people,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
