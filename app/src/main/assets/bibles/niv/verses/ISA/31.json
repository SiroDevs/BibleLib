  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "ISA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Woe to Those Who Rely on Egypt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woe to those who go down to Egypt for help,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "who rely on horses,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "who trust in the multitude of their chariots",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "and in the great strength of their horsemen,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "but do not look to the Holy One of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "or seek help from the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.1",
                "verseOrgIds": [
                  "ISA.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet he too is wise and can bring disaster;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "he does not take back his words.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "He will rise up against that wicked nation,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "against those who help evildoers.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "But the Egyptians are mere mortals and not God;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "their horses are flesh and not spirit.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "When the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.3",
                "verseOrgIds": [
                  "ISA.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "stretches out his hand,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "those who help will stumble,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "those who are helped will fall;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "all will perish together.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.4",
                "verseOrgIds": [
                  "ISA.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "says to me:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "\"As a lion growls,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "a great lion over its prey—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "and though a whole band of shepherds",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "is called together against it,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "it is not frightened by their shouts",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "or disturbed by their clamor—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "so the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.4",
                "verseOrgIds": [
                  "ISA.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty will come down",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "to do battle on Mount Zion and on its heights.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like birds hovering overhead,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.5",
                "verseOrgIds": [
                  "ISA.31.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty will shield Jerusalem;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "he will shield it and deliver it,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "he will 'pass over' it and will rescue it.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Return, you Israelites, to the One you have so greatly revolted against.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "For in that day every one of you will reject the idols of silver and gold your sinful hands have made.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Assyria will fall by no human sword;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "a sword, not of mortals, will devour them.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "They will flee before the sword",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "and their young men will be put to forced labor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their stronghold will fall because of terror;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "at the sight of the battle standard their commanders will panic,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "declares the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.9",
                "verseOrgIds": [
                  "ISA.31.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "whose fire is in Zion,",
          "type": "text",
          "attrs": {
