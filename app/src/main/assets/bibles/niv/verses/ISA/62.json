        {
          "text": "For Zion's sake I will not keep silent,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "for Jerusalem's sake I will not remain quiet,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:1"
