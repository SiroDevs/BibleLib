  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "ISA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Stubborn Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Listen to this, you descendants of Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "you who are called by the name of Israel",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "and come from the line of Judah,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "you who take oaths in the name of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.1",
                "verseOrgIds": [
                  "ISA.48.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "and invoke the God of Israel—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "but not in truth or righteousness—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "you who call yourselves citizens of the holy city",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "and claim to rely on the God of Israel—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.2",
                "verseOrgIds": [
                  "ISA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty is his name:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I foretold the former things long ago,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "my mouth announced them and I made them known;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "then suddenly I acted, and they came to pass.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For I knew how stubborn you were;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "your neck muscles were iron,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "your forehead was bronze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore I told you these things long ago;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "before they happened I announced them to you",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "so that you could not say,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "'My images brought them about;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "my wooden image and metal god ordained them.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have heard these things; look at them all.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "Will you not admit them?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "\"From now on I will tell you of new things,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "of hidden things unknown to you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are created now, and not long ago;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "you have not heard of them before today.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "So you cannot say,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "'Yes, I knew of them.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have neither heard nor understood;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "from of old your ears have not been open.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "Well do I know how treacherous you are;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "you were called a rebel from birth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "For my own name's sake I delay my wrath;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "for the sake of my praise I hold it back from you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "so as not to destroy you completely.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "See, I have refined you, though not as silver;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:10"
      },
      "items": [
        {
          "text": "I have tested you in the furnace of affliction.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "For my own sake, for my own sake, I do this.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "How can I let myself be defamed?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "I will not yield my glory to another.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel Freed",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Listen to me, Jacob,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.12",
            "verseOrgIds": [
              "ISA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:12"
      },
      "items": [
        {
          "text": "Israel, whom I have called:",
          "type": "text",
