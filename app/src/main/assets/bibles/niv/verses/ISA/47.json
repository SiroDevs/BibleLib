  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "ISA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The Fall of Babylon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Go down, sit in the dust,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "Virgin Daughter Babylon;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "sit on the ground without a throne,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "queen city of the Babylonians.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "No more will you be called",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "tender or delicate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take millstones and grind flour;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "take off your veil.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "Lift up your skirts, bare your legs,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "and wade through the streams.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your nakedness will be exposed",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "and your shame uncovered.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "I will take vengeance;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "I will spare no one.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Our Redeemer—the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty is his name—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:4"
      },
      "items": [
        {
          "text": "is the Holy One of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sit in silence, go into darkness,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "queen city of the Babylonians;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "no more will you be called",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "queen of kingdoms.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I was angry with my people",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "and desecrated my inheritance;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "I gave them into your hand,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "and you showed them no mercy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "Even on the aged",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "you laid a very heavy yoke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "You said, 'I am forever—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "the eternal queen!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "But you did not consider these things",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "or reflect on what might happen.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Now then, listen, you lover of pleasure,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "lounging in your security",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "and saying to yourself,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "'I am, and there is none besides me.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "I will never be a widow",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "or suffer the loss of children.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Both of these will overtake you",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "in a moment, on a single day:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "loss of children and widowhood.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "They will come upon you in full measure,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "in spite of your many sorceries",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "and all your potent spells.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have trusted in your wickedness",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "and have said, 'No one sees me.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "Your wisdom and knowledge mislead you",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "when you say to yourself,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "'I am, and there is none besides me.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Disaster will come upon you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "and you will not know how to conjure it away.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "A calamity will fall upon you",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "that you cannot ward off with a ransom;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "a catastrophe you cannot foresee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "will suddenly come upon you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Keep on, then, with your magic spells",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "and with your many sorceries,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "which you have labored at since childhood.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "Perhaps you will succeed,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:12"
      },
      "items": [
        {
          "text": "perhaps you will cause terror.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "All the counsel you have received has only worn you out!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "Let your astrologers come forward,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "those stargazers who make predictions month by month,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:13"
      },
      "items": [
        {
          "text": "let them save you from what is coming upon you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely they are like stubble;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "the fire will burn them up.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "They cannot even save themselves",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "from the power of the flame.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "These are not coals for warmth;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:14"
      },
      "items": [
        {
          "text": "this is not a fire to sit by.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "That is all they are to you—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    },
