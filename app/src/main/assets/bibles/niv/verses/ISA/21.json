          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "The survivors of the archers, the warriors of Kedar, will be few.\" The",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
            "verseOrgIds": [
              "ISA.21.17"
            ]
