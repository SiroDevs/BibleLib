      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:12"
      },
      "items": [
        {
          "text": "\"Morning is coming, but also the night.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.12",
            "verseOrgIds": [
              "ISA.21.12"
            ]
          }
        }
      ]
