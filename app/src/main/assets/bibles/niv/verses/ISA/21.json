                "verseOrgIds": [
                  "ISA.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of Israel, has spoken.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
            "verseOrgIds": [
              "ISA.21.17"
            ]
          }
