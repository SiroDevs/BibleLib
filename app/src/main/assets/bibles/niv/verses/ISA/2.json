          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
