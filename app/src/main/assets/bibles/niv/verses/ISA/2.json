          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.6",
                "verseOrgIds": [
                  "ISA.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", have abandoned your people,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
