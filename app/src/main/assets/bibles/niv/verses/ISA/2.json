      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "and everyone humbled—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
