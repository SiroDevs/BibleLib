          "text": "Their land is full of idols;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "they bow down to the work of their hands,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "to what their fingers have made.",
