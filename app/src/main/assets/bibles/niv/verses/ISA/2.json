          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "there is no end to their chariots.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
