    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "The Glory of Zion",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Arise, shine, for your light has come,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:1"
      },
      "items": [
        {
          "text": "and the glory of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.1",
                "verseOrgIds": [
                  "ISA.60.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rises upon you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "See, darkness covers the earth",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "and thick darkness is over the peoples,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "but the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.2",
                "verseOrgIds": [
                  "ISA.60.2"
                ]
              }
            }
          ]
        },
        {
          "text": "rises upon you",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "and his glory appears over you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nations will come to your light,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:3"
      },
      "items": [
        {
          "text": "and kings to the brightness of your dawn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lift up your eyes and look about you:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "All assemble and come to you;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "your sons come from afar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "and your daughters are carried on the hip.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then you will look and be radiant,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "your heart will throb and swell with joy;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "the wealth on the seas will be brought to you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "to you the riches of the nations will come.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herds of camels will cover your land,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "young camels of Midian and Ephah.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "And all from Sheba will come,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "bearing gold and incense",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "and proclaiming the praise of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.6",
                "verseOrgIds": [
                  "ISA.60.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "All Kedar's flocks will be gathered to you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "the rams of Nebaioth will serve you;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "they will be accepted as offerings on my altar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "and I will adorn my glorious temple.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Who are these that fly along like clouds,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:8"
      },
      "items": [
        {
          "text": "like doves to their nests?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely the islands look to me;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "in the lead are the ships of Tarshish,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "bringing your children from afar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "with their silver and gold,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "to the honor of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.60.9",
                "verseOrgIds": [
                  "ISA.60.9"
                ]
              }
            }
          ]
        },
        {
          "text": "your God,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "the Holy One of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:9"
      },
      "items": [
        {
          "text": "for he has endowed you with splendor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Foreigners will rebuild your walls,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "and their kings will serve you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "Though in anger I struck you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "in favor I will show you compassion.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your gates will always stand open,",
          "type": "text",
