    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Praise to the",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.25.1",
                "verseOrgIds": [
                  "ISA.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", you are my God;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "I will exalt you and praise your name,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "for in perfect faithfulness",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "you have done wonderful things,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "things planned long ago.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have made the city a heap of rubble,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "the fortified town a ruin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "the foreigners' stronghold a city no more;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:2"
      },
      "items": [
        {
          "text": "it will never be rebuilt.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.2",
            "verseOrgIds": [
              "ISA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore strong peoples will honor you;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.3",
            "verseOrgIds": [
              "ISA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:3"
      },
      "items": [
        {
          "text": "cities of ruthless nations will revere you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.3",
            "verseOrgIds": [
              "ISA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "You have been a refuge for the poor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "a refuge for the needy in their distress,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "a shelter from the storm",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "and a shade from the heat.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "For the breath of the ruthless",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:4"
      },
      "items": [
        {
          "text": "is like a storm driving against a wall",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.4",
            "verseOrgIds": [
              "ISA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "and like the heat of the desert.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:5"
      },
      "items": [
        {
          "text": "You silence the uproar of foreigners;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:5"
      },
      "items": [
        {
          "text": "as heat is reduced by the shadow of a cloud,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:5"
      },
      "items": [
        {
          "text": "so the song of the ruthless is stilled.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "On this mountain the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.25.6",
                "verseOrgIds": [
                  "ISA.25.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty will prepare",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "a feast of rich food for all peoples,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "a banquet of aged wine—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "the best of meats and the finest of wines.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "On this mountain he will destroy",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:7"
      },
      "items": [
        {
          "text": "the shroud that enfolds all peoples,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:7"
      },
      "items": [
        {
          "text": "the sheet that covers all nations;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "he will swallow up death forever.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "The Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.25.8",
                "verseOrgIds": [
                  "ISA.25.8"
                ]
              }
            }
          ]
        },
        {
          "text": "will wipe away the tears",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "from all faces;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "he will remove his people's disgrace",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "from all the earth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:8"
      },
      "items": [
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.25.8",
                "verseOrgIds": [
                  "ISA.25.8"
                ]
              }
            }
          ]
        },
        {
          "text": "has spoken.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "In that day they will say,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "\"Surely this is our God;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "we trusted in him, and he saved us.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "This is the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.25.9",
                "verseOrgIds": [
                  "ISA.25.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", we trusted in him;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:9"
      },
      "items": [
        {
          "text": "let us rejoice and be glad in his salvation.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
