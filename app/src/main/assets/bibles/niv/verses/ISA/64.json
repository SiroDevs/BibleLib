  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "ISA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.63.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh, that you would rend the heavens and come down,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.63.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:1"
      },
      "items": [
        {
          "text": "that the mountains would tremble before you!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.63.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "As when fire sets twigs ablaze",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "and causes water to boil,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "come down to make your name known to your enemies",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "and cause the nations to quake before you!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For when you did awesome things that we did not expect,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:3"
      },
      "items": [
        {
          "text": "you came down, and the mountains trembled before you.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Since ancient times no one has heard,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "no ear has perceived,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "no eye has seen any God besides you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "who acts on behalf of those who wait for him.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "You come to the help of those who gladly do right,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "who remember your ways.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "But when we continued to sin against them,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "you were angry.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "How then can we be saved?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "All of us have become like one who is unclean,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "and all our righteous acts are like filthy rags;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "we all shrivel up like a leaf,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "and like the wind our sins sweep us away.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No one calls on your name",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "or strives to lay hold of you;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "for you have hidden your face from us",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "and have given us over to",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        },
        {
          "text": "our sins.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.8",
                "verseOrgIds": [
                  "ISA.64.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", are our Father.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "We are the clay, you are the potter;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "we are all the work of your hand.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not be angry beyond measure,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.9",
                "verseOrgIds": [
                  "ISA.64.8"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "do not remember our sins forever.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "Oh, look on us, we pray,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "for we are all your people.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your sacred cities have become a wasteland;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:10"
      },
      "items": [
        {
          "text": "even Zion is a wasteland, Jerusalem a desolation.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Our holy and glorious temple, where our ancestors praised you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "has been burned with fire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "and all that we treasured lies in ruins.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "After all this,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.12",
                "verseOrgIds": [
                  "ISA.64.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", will you hold yourself back?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:12"
      },
      "items": [
        {
          "text": "Will you keep silent and punish us beyond measure?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        }
      ]
    }
  ],
