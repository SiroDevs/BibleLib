        },
        {
          "text": "How beautiful on the mountains",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "are the feet of those who bring good news,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "who proclaim peace,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "who bring good tidings,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "who proclaim salvation,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "who say to Zion,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "\"Your God reigns!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Listen! Your watchmen lift up their voices;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "together they shout for joy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "When the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.52.8",
                "verseOrgIds": [
                  "ISA.52.8"
                ]
              }
            }
          ]
        },
        {
          "text": "returns to Zion,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "they will see it with their own eyes.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burst into songs of joy together,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:9"
      },
      "items": [
        {
          "text": "you ruins of Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:9"
      },
      "items": [
        {
          "text": "for the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
