            "number": "1",
            "style": "v",
            "sid": "ISA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awake, awake, Zion,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "clothe yourself with strength!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "Put on your garments of splendor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "Jerusalem, the holy city.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "The uncircumcised and defiled",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "will not enter you again.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shake off your dust;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:2"
      },
      "items": [
        {
          "text": "rise up, sit enthroned, Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:2"
      },
      "items": [
        {
          "text": "Free yourself from the chains on your neck,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:2"
      },
      "items": [
        {
          "text": "Daughter Zion, now a captive.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For this is what the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.52.3",
                "verseOrgIds": [
                  "ISA.52.3"
                ]
              }
            }
          ]
        },
        {
          "text": "says:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:3"
      },
      "items": [
        {
          "text": "\"You were sold for nothing,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:3"
      },
      "items": [
        {
          "text": "and without money you will be redeemed.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For this is what the Sovereign",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.52.4",
                "verseOrgIds": [
                  "ISA.52.4"
                ]
              }
            }
          ]
        },
        {
          "text": "says:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:4"
      },
      "items": [
        {
          "text": "\"At first my people went down to Egypt to live;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:4"
      },
      "items": [
        {
          "text": "lately, Assyria has oppressed them.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"And now what do I have here?\" declares the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.52.5",
                "verseOrgIds": [
                  "ISA.52.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "\"For my people have been taken away for nothing,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "and those who rule them mock,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "declares the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.52.5",
                "verseOrgIds": [
                  "ISA.52.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "\"And all day long",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "my name is constantly blasphemed.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore my people will know my name;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:6"
      },
      "items": [
        {
          "text": "therefore in that day they will know",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:6"
      },
      "items": [
        {
          "text": "that it is I who foretold it.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:6"
      },
      "items": [
        {
          "text": "Yes, it is I.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
