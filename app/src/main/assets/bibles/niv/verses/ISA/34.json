          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "Their land will be drenched with blood,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
