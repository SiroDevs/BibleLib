            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.34.8",
                "verseOrgIds": [
                  "ISA.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "has a day of vengeance,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
