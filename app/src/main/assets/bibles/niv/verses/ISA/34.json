      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "its smoke will rise forever.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "From generation to generation it will lie desolate;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "no one will ever pass through it again.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
