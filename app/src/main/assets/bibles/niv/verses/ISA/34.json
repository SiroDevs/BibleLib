                "verseId": "ISA.34.6",
                "verseOrgIds": [
                  "ISA.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": "is bathed in blood,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
