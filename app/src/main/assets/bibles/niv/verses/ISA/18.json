          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
