  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "63",
        "style": "c",
        "sid": "ISA 63"
      },
      "items": [
        {
          "text": "63",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "God's Day of Vengeance and Redemption",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who is this coming from Edom,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "from Bozrah, with his garments stained crimson?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "Who is this, robed in splendor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "striding forward in the greatness of his strength?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 63:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "\"It is I, proclaiming victory,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:1"
      },
      "items": [
        {
          "text": "mighty to save.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why are your garments red,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:2"
      },
      "items": [
        {
          "text": "like those of one treading the winepress?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I have trodden the winepress alone;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "from the nations no one was with me.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "I trampled them in my anger",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "and trod them down in my wrath;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "their blood spattered my garments,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:3"
      },
      "items": [
        {
          "text": "and I stained all my clothing.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "It was for me the day of vengeance;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:4"
      },
      "items": [
        {
          "text": "the year for me to redeem had come.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I looked, but there was no one to help,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:5"
      },
      "items": [
        {
          "text": "I was appalled that no one gave support;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:5"
      },
      "items": [
        {
          "text": "so my own arm achieved salvation for me,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:5"
      },
      "items": [
        {
          "text": "and my own wrath sustained me.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I trampled the nations in my anger;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:6"
      },
      "items": [
        {
          "text": "in my wrath I made them drunk",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:6"
      },
      "items": [
        {
          "text": "and poured their blood on the ground.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Praise and Prayer",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will tell of the kindnesses of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.63.7",
                "verseOrgIds": [
                  "ISA.63.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "the deeds for which he is to be praised,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "according to all the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.63.7",
                "verseOrgIds": [
                  "ISA.63.7"
                ]
              }
            }
          ]
        },
        {
          "text": "has done for us—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "yes, the many good things",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "he has done for Israel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:7"
      },
      "items": [
        {
          "text": "according to his compassion and many kindnesses.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said, \"Surely they are my people,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:8"
      },
      "items": [
        {
          "text": "children who will be true to me\";",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:8"
      },
      "items": [
        {
          "text": "and so he became their Savior.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "In all their distress he too was distressed,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "and the angel of his presence saved them.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "In his love and mercy he redeemed them;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "he lifted them up and carried them",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "all the days of old.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet they rebelled",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:10"
      },
      "items": [
        {
          "text": "and grieved his Holy Spirit.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:10"
      },
      "items": [
        {
          "text": "So he turned and became their enemy",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:10"
      },
      "items": [
        {
          "text": "and he himself fought against them.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
