          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Beware, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.17",
                "verseOrgIds": [
                  "ISA.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "is about to take firm hold of you",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
