  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "ISA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A Prophecy About Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A prophecy against the Valley of Vision:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "What troubles you now,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "that you have all gone up on the roofs,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "you town so full of commotion,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "you city of tumult and revelry?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "Your slain were not killed by the sword,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "nor did they die in battle.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "All your leaders have fled together;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "they have been captured without using the bow.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "All you who were caught were taken prisoner together,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "having fled while the enemy was still far away.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore I said, \"Turn away from me;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "let me weep bitterly.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "Do not try to console me",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "over the destruction of my people.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Lord, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.5",
                "verseOrgIds": [
                  "ISA.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty, has a day",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "of tumult and trampling and terror",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "in the Valley of Vision,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "a day of battering down walls",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "and of crying out to the mountains.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elam takes up the quiver,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "with her charioteers and horses;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "Kir uncovers the shield.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Your choicest valleys are full of chariots,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:7"
      },
      "items": [
        {
          "text": "and horsemen are posted at the city gates.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Lord stripped away the defenses of Judah,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "and you looked in that day",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "to the weapons in the Palace of the Forest.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "You saw that the walls of the City of David",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "were broken through in many places;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "you stored up water",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "in the Lower Pool.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "You counted the buildings in Jerusalem",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:10"
      },
      "items": [
        {
          "text": "and tore down houses to strengthen the wall.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "You built a reservoir between the two walls",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "for the water of the Old Pool,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "but you did not look to the One who made it,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "or have regard for the One who planned it long ago.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Lord, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.12",
                "verseOrgIds": [
                  "ISA.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "called you on that day",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "to weep and to wail,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:12"
      },
      "items": [
        {
