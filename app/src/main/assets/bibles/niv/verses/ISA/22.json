      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "\"for tomorrow we die!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
