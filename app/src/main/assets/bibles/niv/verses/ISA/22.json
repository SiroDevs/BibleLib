      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "to cut out a grave for yourself here,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "hewing your grave on the height",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
