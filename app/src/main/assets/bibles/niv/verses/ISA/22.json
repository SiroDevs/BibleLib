      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:15"
      },
      "items": [
        {
          "text": "\"Go, say to this steward,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:15"
      },
      "items": [
        {
          "text": "to Shebna the palace administrator:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "What are you doing here and who gave you permission",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
