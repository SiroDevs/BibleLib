          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"In that day,\" declares the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.25",
                "verseOrgIds": [
                  "ISA.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty, \"the peg driven into the firm place will give way; it will be sheared off and will fall, and the load hanging on it will be cut down.\" The",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.25",
                "verseOrgIds": [
                  "ISA.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "has spoken.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
