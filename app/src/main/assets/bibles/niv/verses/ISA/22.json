      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "slaughtering of cattle and killing of sheep,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
