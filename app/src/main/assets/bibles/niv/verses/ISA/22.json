          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "But see, there is joy and revelry,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
