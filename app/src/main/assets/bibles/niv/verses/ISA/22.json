      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:17"
      },
      "items": [
        {
          "text": "and hurl you away, you mighty man.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
