  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "ISA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A Prophecy Against Egypt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A prophecy against Egypt:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "See, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.1",
                "verseOrgIds": [
                  "ISA.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rides on a swift cloud",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "and is coming to Egypt.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "The idols of Egypt tremble before him,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "and the hearts of the Egyptians melt with fear.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I will stir up Egyptian against Egyptian—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "brother will fight against brother,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "neighbor against neighbor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "city against city,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "kingdom against kingdom.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Egyptians will lose heart,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "and I will bring their plans to nothing;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "they will consult the idols and the spirits of the dead,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "the mediums and the spiritists.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will hand the Egyptians over",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "to the power of a cruel master,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "and a fierce king will rule over them,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "declares the Lord, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.4",
                "verseOrgIds": [
                  "ISA.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The waters of the river will dry up,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:5"
      },
      "items": [
        {
          "text": "and the riverbed will be parched and dry.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The canals will stink;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:6"
      },
      "items": [
        {
          "text": "the streams of Egypt will dwindle and dry up.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:6"
      },
      "items": [
        {
          "text": "The reeds and rushes will wither,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "also the plants along the Nile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "at the mouth of the river.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "Every sown field along the Nile",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "will become parched, will blow away and be no more.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fishermen will groan and lament,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "all who cast hooks into the Nile;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "those who throw nets on the water",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "will pine away.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Those who work with combed flax will despair,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:9"
      },
      "items": [
        {
          "text": "the weavers of fine linen will lose hope.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The workers in cloth will be dejected,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:10"
      },
      "items": [
        {
          "text": "and all the wage earners will be sick at heart.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The officials of Zoan are nothing but fools;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "the wise counselors of Pharaoh give senseless advice.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "How can you say to Pharaoh,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "\"I am one of the wise men,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "a disciple of the ancient kings\"?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Where are your wise men now?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.12",
            "verseOrgIds": [
