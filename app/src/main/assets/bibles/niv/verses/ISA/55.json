          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.7",
                "verseOrgIds": [
                  "ISA.55.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", and he will have mercy on them,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
