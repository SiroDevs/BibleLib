      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "Let them turn to the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
