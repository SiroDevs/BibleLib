            "sid": "ISA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "See, I have made him a witness to the peoples,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:4"
      },
      "items": [
        {
          "text": "a ruler and commander of the peoples.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
