      "items": [
        {
          "text": "so are my ways higher than your ways",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "and my thoughts than your thoughts.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
