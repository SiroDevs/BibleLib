            "number": "1",
            "style": "v",
            "sid": "ISA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Come, all you who are thirsty,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "come to the waters;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "and you who have no money,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "come, buy and eat!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "Come, buy wine and milk",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "without money and without cost.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why spend money on what is not bread,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "and your labor on what does not satisfy?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "Listen, listen to me, and eat what is good,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "and you will delight in the richest of fare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Give ear and come to me;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "listen, that you may live.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "I will make an everlasting covenant with you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "my faithful love promised to David.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
