          "text": "Surely you will summon nations you know not,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "and nations you do not know will come running to you,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "because of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
