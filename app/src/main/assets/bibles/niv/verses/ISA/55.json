                "verseId": "ISA.55.5",
                "verseOrgIds": [
                  "ISA.55.5"
                ]
              }
            }
          ]
        },
        {
          "text": "your God,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
