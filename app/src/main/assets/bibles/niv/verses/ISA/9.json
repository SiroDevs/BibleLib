      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "and over his kingdom,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
