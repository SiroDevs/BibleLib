          "text": "All the people will know it—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "Ephraim and the inhabitants of Samaria—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "who say with pride",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "and arrogance of heart,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"The bricks have fallen down,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:10"
      },
      "items": [
        {
          "text": "but we will rebuild with dressed stone;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:10"
      },
      "items": [
        {
          "text": "the fig trees have been felled,",
