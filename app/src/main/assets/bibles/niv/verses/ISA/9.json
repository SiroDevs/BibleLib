      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "there will be no end.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:7"
