      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "to us a son is given,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "and the government will be on his shoulders.",
