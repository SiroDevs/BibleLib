            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.9.7",
                "verseOrgIds": [
                  "ISA.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Almighty",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
