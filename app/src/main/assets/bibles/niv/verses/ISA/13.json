          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "See, the day of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "ISA.13.9",
                "verseOrgIds": [
                  "ISA.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "is coming",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "—a cruel day, with wrath and fierce anger—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "to make the land desolate",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "and destroy the sinners within it.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The stars of heaven and their constellations",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "will not show their light.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "The rising sun will be darkened",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "and the moon will not give its light.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will punish the world for its evil,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "the wicked for their sins.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "I will put an end to the arrogance of the haughty",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "and will humble the pride of the ruthless.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
