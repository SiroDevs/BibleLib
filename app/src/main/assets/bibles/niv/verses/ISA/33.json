      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "and speak what is right,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "who reject gain from extortion",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "and keep their hands from accepting bribes,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "who stop their ears against plots of murder",
