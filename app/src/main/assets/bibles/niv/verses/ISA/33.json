      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:14"
      },
      "items": [
        {
          "text": "Who of us can dwell with everlasting burning?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
    {
