      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "\"Now will I be exalted;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "now will I be lifted up.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
