      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "Where is the one who took the revenue?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "Where is the officer in charge of the towers?\"",
