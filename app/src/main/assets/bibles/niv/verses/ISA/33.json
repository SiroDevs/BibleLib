          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:15"
      },
      "items": [
        {
          "text": "and shut their eyes against contemplating evil—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        }
      ]
    },
    {
