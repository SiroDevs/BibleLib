      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:14"
      },
      "items": [
        {
          "text": "\"Who of us can dwell with the consuming fire?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        }
      ]
    },
