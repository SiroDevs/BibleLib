              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The peoples will be burned to ashes;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
