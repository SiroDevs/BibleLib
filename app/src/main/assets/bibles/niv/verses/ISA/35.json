          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "the thirsty ground bubbling springs.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "In the haunts where jackals once lay,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "grass and reeds and papyrus will grow.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
