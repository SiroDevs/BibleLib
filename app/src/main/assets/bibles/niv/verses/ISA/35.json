            "number": "1",
            "style": "v",
            "sid": "ISA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The desert and the parched land will be glad;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "the wilderness will rejoice and blossom.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "Like the crocus,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "it will burst into bloom;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "it will rejoice greatly and shout for joy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "The glory of Lebanon will be given to it,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "the splendor of Carmel and Sharon;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
