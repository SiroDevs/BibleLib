          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "\"Be strong, do not fear;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "your God will come,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "he will come with vengeance;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "with divine retribution",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "he will come to save you.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then will the eyes of the blind be opened",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:5"
      },
      "items": [
        {
          "text": "and the ears of the deaf unstopped.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
