          "text": "Then will the lame leap like a deer,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "and the mute tongue shout for joy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "Water will gush forth in the wilderness",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "and streams in the desert.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
