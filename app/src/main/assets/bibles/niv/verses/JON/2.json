          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "all your waves and breakers",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
