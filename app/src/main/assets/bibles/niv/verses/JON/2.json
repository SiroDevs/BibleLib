            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.9",
                "verseOrgIds": [
                  "JON.2.10"
                ]
              }
            }
          ]
        },
