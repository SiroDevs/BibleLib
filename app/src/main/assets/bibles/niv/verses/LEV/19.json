          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.30",
                "verseOrgIds": [
                  "LEV.19.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Do not turn to mediums or seek out spiritists, for you will be defiled by them. I am the",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.31",
                "verseOrgIds": [
                  "LEV.19.31"
                ]
              }
            }
          ]
        },
        {
          "text": "your God.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
