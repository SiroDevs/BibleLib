          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "LEV.4.24",
                "verseOrgIds": [
                  "LEV.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": ". It is a sin offering.",
          "type": "text",
          "attrs": {
