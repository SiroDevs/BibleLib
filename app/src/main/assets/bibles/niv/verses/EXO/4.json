          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Signs for Moses",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses answered, \"What if they do not believe me or listen to me and say, 'The",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.1",
                "verseOrgIds": [
                  "EXO.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "did not appear to you'?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.2",
                "verseOrgIds": [
                  "EXO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "said to him, \"What is that in your hand?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:2"
      },
      "items": [
        {
          "text": "\"A staff,\" he replied.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.3",
                "verseOrgIds": [
                  "EXO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "said, \"Throw it on the ground.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:3"
      },
      "items": [
        {
          "text": "Moses threw it on the ground and it became a snake, and he ran from it.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.4",
                "verseOrgIds": [
                  "EXO.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "said to him, \"Reach out your hand and take it by the tail.\" So Moses reached out and took hold of the snake and it turned back into a staff in his hand.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"This,\" said the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"is so that they may believe that the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of their fathers—the God of Abraham, the God of Isaac and the God of Jacob—has appeared to you.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.6",
                "verseOrgIds": [
                  "EXO.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "said, \"Put your hand inside your cloak.\" So Moses put his hand into his cloak, and when he took it out, the skin was leprous",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        },
        {
          "text": "—it had become as white as snow.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Now put it back into your cloak,\" he said. So Moses put his hand back into his cloak, and when he took it out, it was restored, like the rest of his flesh.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.8",
                "verseOrgIds": [
                  "EXO.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "said, \"If they do not believe you or pay attention to the first sign, they may believe the second.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if they do not believe these two signs or listen to you, take some water from the Nile and pour it on the dry ground. The water you take from the river will become blood on the ground.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses said to the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.10",
                "verseOrgIds": [
                  "EXO.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Pardon your servant, Lord. I have never been eloquent, neither in the past nor since you have spoken to your servant. I am slow of speech and tongue.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "said to him, \"Who gave human beings their mouths? Who makes them deaf or mute? Who gives them sight or makes them blind? Is it not I, the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now go; I will help you speak and will teach you what to say.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "But Moses said, \"Pardon your servant, Lord. Please send someone else.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.14",
                "verseOrgIds": [
                  "EXO.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "'s anger burned against Moses and he said, \"What about your brother, Aaron the Levite? I know he can speak well. He is already on his way to meet you, and he will be glad to see you.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall speak to him and put words in his mouth; I will help both of you speak and will teach you what to do.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will speak to the people for you, and it will be as if he were your mouth and as if you were God to him.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "But take this staff in your hand so you can perform the signs with it.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moses Returns to Egypt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Moses went back to Jethro his father-in-law and said to him, \"Let me return to my own people in Egypt to see if any of them are still alive.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:18"
      },
      "items": [
        {
          "text": "Jethro said, \"Go, and I wish you well.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.19",
                "verseOrgIds": [
