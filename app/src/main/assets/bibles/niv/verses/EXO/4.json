                "verseOrgIds": [
                  "EXO.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "says: Israel is my firstborn son,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
