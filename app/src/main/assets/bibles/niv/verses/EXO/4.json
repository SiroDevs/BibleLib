              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then say to Pharaoh, 'This is what the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
