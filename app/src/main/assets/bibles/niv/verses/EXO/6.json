          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
              "EXO.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "EXO 6:18"
      },
