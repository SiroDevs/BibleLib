          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Lord",
              "type": "text",
              "attrs": {
                "verseId": "EXO.32.30",
                "verseOrgIds": [
                  "EXO.32.30"
                ]
              }
            }
          ]
        },
        {
          "text": "; perhaps I can make atonement for your sin.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
