          ]
        },
        {
          "text": "So the cloud of the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
            "verseOrgIds": [
              "EXO.40.38"
            ]
          }
        },
        {
          "name": "char",
