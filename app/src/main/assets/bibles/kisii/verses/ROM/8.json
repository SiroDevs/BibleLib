  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ROM 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obogima ase Omoika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bono kogaambigwa tikori ase abwo bare ime ase Kristo Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.1",
            "verseOrgIds": [
              "ROM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki ogochika kw’Omoika bw’obogima boria bore ime ase Kristo Yeso gwansiboire korwa ase ogochika kw’ebibe na amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.2",
            "verseOrgIds": [
              "ROM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki aria amachiiko atare konyara gokora, ekiagera nigo arenge amareu ase engencho y’ebibe bi’emebere ya Mwanyabaanto, Nyasae agakora ase ogotoma Omwana oye omonyene ase omogwekano bw’engencho yaito y’ebibe, na ase engencho y’ebibe, akagaambia ebibe ase omobere oye o Mwanyabaanto,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.3",
            "verseOrgIds": [
              "ROM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde ekerigirie ime ase amachiiko geikeranigwe ime yaito, aba totari gotunyana chingencho chiaito chi’ebibe, korende chingencho chi’Omoika.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.4",
            "verseOrgIds": [
              "ROM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baria bagotunyana chingencho chiabo chi’ebibe nigo barengereretie chingencho chi’ebibe, korende baria bagotunyana chingencho chi’Omoika nigo barengereretie chingencho chi’Omoika.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.5",
            "verseOrgIds": [
              "ROM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki okorengereria kw’engencho y’ebibe n’amakweri, korende okorengereria kw’engencho y’Omoika nobogima na omorembe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.6",
            "verseOrgIds": [
              "ROM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki okorengereria koria kw’engencho y’ebibe nobobisa igoro ase Nyasae, ekiagera tikori gwancha koigwera amachiiko a Nyasae, gose tikori koyaigwera nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.7",
            "verseOrgIds": [
              "ROM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagotunyana chingencho chi’ebibe tibakonyara kogwenera Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.8",
            "verseOrgIds": [
              "ROM.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Omoika o Nyasae kamenyete ime yaino, rirorio timori gotunyana chingencho chi’ebibe, korende chingencho chi’Omoika. Onde bwensi otari n’Omoika o Kristo, oyio tari omonto oye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.9",
            "verseOrgIds": [
              "ROM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Kristo kar’abe ime yaino, nonya emebere yaino ekwete ase engencho y’ebibe, emeika yaino moyo ere ase engencho y’oboronge obo mwanyorete.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.10",
            "verseOrgIds": [
              "ROM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende onye Omoika oye ere oyobogetie Yeso korwa ase abakuure omenyete ime yaino, ere oyobogetie Kristo Yeso korwa ase abakuure nabookie na emebere yaino eranyorekane n’amakweri, ase engencho y’Omoika oy’omenyete ime yaino.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.11",
            "verseOrgIds": [
              "ROM.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo baminto, igo tore abasiira, korende tari ase chingencho chiaito chi’ebibe, ase ogotunyana chingencho chi’ebibe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.12",
            "verseOrgIds": [
              "ROM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "inaki komoratunyane chingencho chi’ebibe, nigo morakwe, korende komoraite ogokora kw’omobere ase chinguru chi’Omoika, inamobe moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.13",
            "verseOrgIds": [
              "ROM.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abana ba Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki bonsi abakoraagwa n’Omoika o Nyasae, abwo nabwo abana ba Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.14",
            "verseOrgIds": [
              "ROM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki timwanyorete omoika oyo obakorire koba abasomba na korenta obwoba, korende nigo mwanyorete Omoika oyo obakorire koba abana ba Nyasae. Igo torera, “Abba!” Engencho yaye “Tata!”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.15",
            "verseOrgIds": [
              "ROM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoika omonyene obeire kirori amo n’emeika yaito, ng’a intwe nabana ba Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.16",
            "verseOrgIds": [
              "ROM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye tore abana, naboigo tore abanyamwando, abanyamwando ba Nyasae, abaraire omwando amo na Kristo, gatorachandwe amo nere, erinde tonyore obonene amo nere.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.17",
            "verseOrgIds": [
              "ROM.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obonene bogochi‐gocha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabarire emechando y’ekero kia bono, ng’a teri gento onye ekoreng’anigwa nobonene boria bogocha koorokigwa ase tore.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ebitongwa bionsi nigo biganyete n’okogania okonene mono ase rituko riria Abana ba Nyasae bagocha koorokigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.19",
            "verseOrgIds": [
              "ROM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki ebitongwa bionsi nigo biabegetwe inse y’engencho ya bosa, tari ase ogwancha kwabo, korende ase ogwancha kwaye ere oyobibegete ase ogosemeria,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.20",
            "verseOrgIds": [
              "ROM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera ebitongwa ebinyene nabisiborwe korwa ase obosibwa bwabo bw’ogosareka, bisoe ime ase ogosiborwa kw’obonene bw’abaana ba Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.21",
            "verseOrgIds": [
              "ROM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki twamanyire ng’a ebitongwa bionsi nigo bire n’ogwechanda, naende nigo bire n’obororo nonya ngoika bono,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.22",
            "verseOrgIds": [
              "ROM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "gose tari igo rioka, korende nonya nintwe abanyene abatore nogotongorwa kw’Omoika, nigo togwechaanda ase emioyo yaito, gatoganyete gokorwa koba abana ba Nyasae, engencho yaye okoboorigwa kw’emebere yaito.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.23",
            "verseOrgIds": [
              "ROM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki nigo twatooretigwe ase ogosemeria. Korende egento keria gesemeirie gokiarorekanire, rirorio gosemeria tikori. Inaki ning’o orasemerie eki aroche?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.24",
            "verseOrgIds": [
              "ROM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende gatorasemerie egento totarakerora, nigo togokeganya ase oboremereria.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo n’Omoika nere nigo ogotokoonya ase oboreu bwaito. Inaki titomanyeti gosaba buna etogwenerete, korende Omoika omonyene nigo agotosabera ase ogwechanda gotanyare gokwanwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.26",
            "verseOrgIds": [
              "ROM.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ere oyokoriga‐rigia chinkoro chi’ abanto, namanyete okorengereria kw’Omoika, ekiagera Omoika oyo nigo ogosabera abachenu buna Nyasae anchete.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na twamanyire ng’a Nyasae nigo agokora amang’ana onsi amo na baria bamwanchete, erio abanyorere amaya, baria barangerigwe ase omooroberio oye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki baria amanyete korwa kare akabachoora korwa kare, bareng’anigwe n’omogwekano bw’Omwana oye, erinde ere abe omotangi bw’abamwabo abange.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na baria achorete korwa kare, abwo akabarangeria boigo; na baria arangeretie, abwo akabaa oboronge boigo; na baria aete oboronge akabaa obonene boigo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obwanchani bwa Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninki rende torateebe ase ayio? Onye Nyasae ore ensemo yaito, ning’o oranyare gotobua?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.31",
            "verseOrgIds": [
              "ROM.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere otarorerete Omwana oye amaabera, korende akamorua ase engencho yaito intwe twensi, inaki aramoche gotoa ebinto bionsi amo nere?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.32",
            "verseOrgIds": [
              "ROM.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oranyare gosoera abachoore ba Nyasae? Nyasae nere okobaa oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.33",
            "verseOrgIds": [
              "ROM.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oranyare kobanachera ekiina? Kristo Yeso nere okwete, ee, na kobua ase aya obokiigwe korwa ase abakuure; ere nigo are ensemo y’okoboko gw’okorio kwa Nyasae, naende nere ogotosabera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.34",
            "verseOrgIds": [
              "ROM.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oratwatanane korwa ase obwanchani bwa Kristo? Inee! Nogochandwa, gose nobororo, gose nokorosigwa, gose nenchara, gose ngesobono, gose n’obobe, gose n’omoro?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.35",
            "verseOrgIds": [
              "ROM.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna eriikire,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ase engencho yao nigo togoitwa omobaso boira;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "twabarirwe koba buna ching’ondi chigocha konyenywa.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ROM 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ase amang’ana aya onsi twabeire ababui, na goetania ababui, goetera ase are oyotwanchete.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.37",
            "verseOrgIds": [
              "ROM.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ROM 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninde nobomaene bw’okomanya, ng’a nonya namakweri, nonya nobogima, nonya nabamalaika, nonya nabare ne chinguru, nonya n’ebinto ebireo, nonya nebi gochi‐gocha, nonya n’okobua,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.38",
            "verseOrgIds": [
              "ROM.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ROM 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nonya nayare igoro, nonya nayare inse, nonya negetongwa kende gionsi, tibikonyara gotwatanana korwa ase obwanchani bwa Nyasae obore ime ase Kristo Yeso Omonene oito.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.39",
            "verseOrgIds": [
              "ROM.8.39"
            ]
          }
        }
      ]
    }
  ],
