  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ROM 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Eke tokonyora ase okwegena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo ekero twaeirwe oboronge ase okwegena, ntore nomorembe na Nyasae goetera ase Omonene oito Yeso Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goetera ase are twaigoreirwe enchera ase okwegena goikera ase obuya obo toteneine ime yaye, naende nigo tokogoka ase ogosemeria kw’obonene bwa Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gose tari igo rioka, korende nigo tokogoka nonya nase emechando yaito, ekiagera ntomanyete ng’a emechando nigo ekorenta oboremereria;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.3",
            "verseOrgIds": [
              "ROM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na oboremereria nigo bokorenta oboremu bw’omoyo, na oboremu bw’omoyo nigo bokorenta ogosemeria.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.4",
            "verseOrgIds": [
              "ROM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ogosemeria tikori gotorentera obosooku, ekiagera obwanchani bwa Nyasae bwaichorigwe ase chinkoro chiaito n’Omoika Omochenu, oyo twaetwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obwanchani bwa Nyasae bwaorokigwe ase ogokwa gwa Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaene ekero totarenge ne chinguru, ekero engaki yaigete, Kristo agakwa ase engencho y’abanyabibe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.6",
            "verseOrgIds": [
              "ROM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki naakong’u omonto gokwa ribaga ri’omonto omonyene oboronge, korende nenyarekane omonto koremereria gokwa ribaga ri’omonto omuya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.7",
            "verseOrgIds": [
              "ROM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Nyasae oorokirie obwanchani bwaye ase tore ase ogotoma Kristo gokwa ase engencho yaito, ekero twarenge abanyene ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.8",
            "verseOrgIds": [
              "ROM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo kobua mono, gatwaeirwe oboronge ase amanyinga aye, ere natotoorie korwa ase endamwamu ya Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.9",
            "verseOrgIds": [
              "ROM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki ekero twarenge ababisa ba Nyasae, tokabwatanigwa nere ase amakweri y’Omwana oye. Kobua mono, magega gatwabwatanigwe natotoorigwe ase obogima bwaye;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.10",
            "verseOrgIds": [
              "ROM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "gose tari igo rioka, korende nigo tokogoka ase Omonene oito Yeso Kristo ere ase are twanyorire okobwatanigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amakweri goetera ase Adamu, obogima goetera ase Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, buna ase engencho y’omonto oyomo ebibe bigasoa ase ense, na ase engencho y’ebibe amakweri, naboigo amakweri agaikera abanto bonsi, ekiagera bonsi bakorire ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki ebibe nao biarenge ase ense amachiiko atarabekwa, korende ebibe tibikobarwa amachiiko ataiyo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende amakweri nigo agaambete korwa Adamu goika Musa, nonya niigoro y’abwo batakorete ebibe koreng’ana nogosaria kw’Adamu, oyorenge omogwekano bw’oyio ogochi‐gocha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekeegwa keria ki’amaabera tikeri buna ogosaria koria. Inaki ase ogosaria kw’omonto oyomo abange bagakwa, korende amaabera a Nyasae na ekeegwa eke ki’amaabera biamentekire kobua mono ase abange ase omonto oyomo Yeso Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.15",
            "verseOrgIds": [
              "ROM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeegwa keria ki’amaabera tikeri buna ogosaria kw’omonto oyomo, ekiagera ekiina keria nigo giachete ase enchera y’ogosaria okomo, gekarenta okogambigwa, korende ekeegwa keria ki’amaabera kegaacha ase engencho y’ogosaria okonge, gekarenta oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.16",
            "verseOrgIds": [
              "ROM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ase ogosaria kw’omonto oyomo amakweri agaambete ase engencho y’omonto oria oyomo, kobua mono abwo banyorire amaabera amange na ekeegwa ki’oboronge nabagaambe ase obogima goetera ase omonto oyomo, Yeso Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo, buna ase ogosaria kw’omonto oyomo abanto bonsi bakanacherwa ekiina, ee, naboigo ase ogokora kw’oboronge kw’omonto oyomo, abanto bonsi bakaegwa oboronge na obogima.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.18",
            "verseOrgIds": [
              "ROM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki buna ase ogotaigwera kw’omonto oyomo abange bagakorwa koba abanyene ebibe, naboigo ase okogwa kw’omonto oyomo abange nabakorwe koba abanyene oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.19",
            "verseOrgIds": [
              "ROM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amachiiko agasoa, erinde ogosaria kobe okonene mono. Korende aase ebibe biamentegete, amaabera akamenteka akaba amange kobua,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.20",
            "verseOrgIds": [
              "ROM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde, buna ebibe biagaambete ase amakweri, naboigo ase enchera y’oboronge amaabera agaambe goika obogima bwa kare na kare goetera ase Yeso Kristo, Omonene oito.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.21",
            "verseOrgIds": [
              "ROM.5.21"
            ]
          }
        }
      ]
    }
  ],
