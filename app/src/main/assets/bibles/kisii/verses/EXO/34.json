  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "EXO 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Chibao chi’amagena chia kabere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Okoir 10:1-15)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene agateebia Musa, “Baacha chibao chi’amagena ibere chire buna chiria chi’eritang’ani, na inche nindiike ase chibao echio amang’ana aria arenge ase chiria chi’eritang’ani, echio gwatete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.1",
            "verseOrgIds": [
              "EXO.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oche bwebeeke ang’e mambia, otiire gocha ase egetunwa gia Sinai maambia, bweorokie aroro ase inde ase egechuria ki’egetunwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.2",
            "verseOrgIds": [
              "EXO.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monto onde tatiira amo naye, gose monto onde tarorekana aande onsi ase egetunwa eke, gose ching’ondi ne chiombe tichiba chikorisia ang’e negetunwa eke.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.3",
            "verseOrgIds": [
              "EXO.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Musa akabaacha chibao ibere chi’amagena chire buna chiria chi’eritang’ani, akaimoka mambia chuni, agatiira gochia ase egetunwa gia Sinai, buna Omonene konya amochikiire, obogoretie chibao chiria ibere chi’amagena koboko kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene agaika ore riire ime, agatenena amo nere, akararia erieta NYASAE OMOBUI.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene agaeta ase obosio bwa Musa, akeraria, “Omonene Nyasae, nere Nyasae omonyene amaabera na obuya, tari omwango bw’okoba nendamwamu; nigo are nobwanchani botari koera, na obwegenwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo agokorera ebiare chilifu obwanchani botari koera; ere nigo akwabera amamocho, na ogosaria, na ebibe, korende tagotiga koa abana na abachokoro egesusuro goika ekiaare kia gatato na egia kane ase engencho y’amabe ’abaibori babo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.7",
            "verseOrgIds": [
              "EXO.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bwango Musa agatung’ama inse agatureka omotwe, agasasiima,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.8",
            "verseOrgIds": [
              "EXO.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabora, “Omonene, onye bono nanyorire ogwancherwa ase obosio bwao, nagosabire ogende amo naintwe. Naki abanto aba nabanyabigoti bikong’u, korende otwabere ogosaria gwaito na ebibe biaito, otwanchere tobe abanto bao.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.9",
            "verseOrgIds": [
              "EXO.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okobwatana kw’ogotianania kogokorwa naende",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Okong’ 23:14-19; Okoir 7:1-5; 16:1-17)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene akabora, “Rora, bono ngokora inde nainwe okobwatana kw’ogotianania. Ase amasio ’abaanto bao bonsi ninkore ebikone ebio bitana gokoreka ase ense yonsi, gose ase egesaku kende gionsi. Na abanto bonsi abagoetanaine inabarore ogokora kw’Omonene, naki ayio ndagokorere namang’ana ay’okoondokia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwate amachiiko ayio ndakoe reero. Norore ase obosio bwao ngoseria Abaamori, na Abakanaani, na Abahiti, na Abaperisi, na Abahivi, na Abayebusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.11",
            "verseOrgIds": [
              "EXO.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwerende, tobaisa gokora okobwatana nabanyene ense eria ase okogenda, baabaise kobatega mogwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.12",
            "verseOrgIds": [
              "EXO.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe motagore ebisasimero biabo, mobiiyerie inse, na gosenyenta chisiiro chi’amagena ase bagosasimera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.13",
            "verseOrgIds": [
              "EXO.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tobaisa gosasiima enyasae ende eng’ao, ekiagera Omonene nigo akorokwa Omonyaisemi, nere Nyasae bwe risemi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobaisa gokora okobwatana nabanyene ense eria, ekiagera ekero bagokora obotomani ase ogosasiima chinyasae chiabo na gochiruera ebing’wanso, mbaabaise kobarangeria inwe morie ebing’wanso biabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inamoire abakungu korwa ase abasubati babo abwo bagokora obotomani ase ogosasiima chinyasae chiabo, barabwo bakore abamura baino basasime chinyasae chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tibwekorera chinyasae korwa ase ebioma binyititoire na kobombwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Orende rituko rinene ri’Emegati etabekiri memera; na buna nagochigeete, orie emegati etabekiri memera ase amatuko atano na abere, ase engaki yachigetwe, y’omotienyi bw’Abibu, naki ase omotienyi oyio oyio noro kwaruete ense ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kera omwana omoisia omotangi nabe oyone, ne ching’iti chintangi boigo, chibe chieri gose chimingichi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende emori entangi y’etigere goika oyeboorie ase okorua eng’ondi ebe ekeng’wanso. Onye tibwancheti koyebooria, goika oyebune ebigoti. Abana bao abaisia abatangi goika obaboorie. Onde tari orabe ogocha ase obosio bwane, inche Omonene, namaboko amasa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okore emeremo ase amatuko atano na rimo, korende rituko ria gatano na kabere otimoke, nonya nengaki y’okorema na eye rigesa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.21",
            "verseOrgIds": [
              "EXO.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Orende Rituko Rinene rie Chichuma, ase engencho y’ogotongora kw’engano, ne Rituko Rinene ri’Ogosangereria Rigesa, omoerio bw’omwaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ara gatato kera omwaka abanto bao bonsi abasacha babe bagocha ase obosio bwane, inche Omonene Nyasae, Nyasae bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninserie abanto b’ebisaku korwa asore na kogareyia orogongo rwao, onde tari orakoroure ase chingaki echi isato kera omwaka, ekero orabe kogocha ase obosio bwane, inche Omonene, Nyasae oo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekero okondetera amanyinga ’ekeng’wanso, tobaisa koyandetera amo nomogati obekire ememera. Tobaisa gotigaria chinyama chinde chi’ekeng’wanso kie rituko rinene ri’Epasaka goika mambia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Goika orente ase enyomba yane, inche Omonene oo, ogotongora kwao okore okuya korwa ase omogondo oo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "“Tobaisa koiyekera emanwa y’embori, gose yeng’ondi ime y’amabeere ’eng’ina.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene agateebia Musa, “Riika amang’ana aya, ekiagera ase amang’ana ayio nakorire okobwatana kw’ogotianania naye amo n’Abaisraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akabeera n’Omonene ase engaki y’amatuko emerongo ene, omobaso na obotuko, tare koria kende, gose konywa, akarika ase chibao echi ibere amang’ana ’okobwatana koria, Amachiiko ayio ikomi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Musa ogotirimboka korwa ase egetunwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa agatirimboka korwa ase egetunwa gia Sinai, obwate ase okoboko kwaye chibao chiriikire oborori, ere tamanya ng’a risankwa ri’obosio bwaye nigo riare komeka‐meka, ekiagera konya okwanire n’Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni na abanto bonsi, ekero baroche buna risankwa ri’obosio bwa Musa riare komeka‐meka, bakoboa komoika ang’e.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Musa akabarangeria, erio Aroni amo nabatang’ani bonsi b’omosangererekano bakairana asare, na Musa agakwana nabarabwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega y’ayio Abaisraeli bonsi bagacha ase Musa, na ere akabaa amachiiko onsi ay’Omonene konya amoeire ase egetunwa gia Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Musa akoorire gokwana nabarabwo, akabeeka egietubo ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero kende gionsi Musa are gosoa eema ase obosio bw’Omonene gokwana nere, nigo are korusia egietubo goika osoka korwa aroro. Ekero asokire aba ogoteebia Abaisraeli amang’ana onsi aya achikirwe gokwana,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na barabwo baba bakorora risankwa ri’obosio bwaye rikomeka‐meka. Erio Musa abeeka egietubo ase obosio bwaye goika airana naende gokwana n’Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        }
      ]
    }
