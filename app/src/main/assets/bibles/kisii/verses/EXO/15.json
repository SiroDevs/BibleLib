{
  "id": "EXO.15",
  "number": "15",
  "bookId": "EXO",
  "reference": "Okong’anya 15",
  "copyright": "© 2021 KENBS",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "EXO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera kwa Musa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Musa na Abaisraeli bakamoterera Omonene ogoteera oko, bagoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimoterere Omonene, ekiagera ere obuire ase okobua okonene;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chibarasi amo nabachiriinete obarimeirie ase enyancha ime.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nere chinguru chiane, nimoterere ere, ere nogotooreka kwane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere Nyasae one, nimotogie; ere Nyasae o tata, ninterere obonene bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nomorwani bwe chiseegi, Omonene nario erieta riaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orutire chigari chia Farao amo nomoganda oye ase enyancha ime;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abarwani baye abachore obarimeirie ase enyancha embariri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amache abatubire, barimeire chindiba ime buna rigena rikorutwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, okoboko kwao gw’okorio nkore nokobua okonene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, okoboko kwao gw’okorio ngosenyente ababisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase okobua kwao okonene nigo okobaiyeria inse abagokoimokera;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "endamwamu yao ekobera, nigo ekobasamba buna chimboba chinyomo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omoika korwa ase chimioro chiao amaache akaimoka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agatenena buna orwaki,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "enyancha egakamoka goika inse kegima.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobisa agateeba, “Nimbabwatie, mbaikeere,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbiatanane ebi ndasakore, omoyo one oisaneke;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninsomore omoyio one o birende, nimbasirie nokoboko kwane.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo ekero aye kwagusete buna omwaga, amaache akabamera;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakamerwa buna embunde ekorimera ase amaache amange ime, yarika inse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, ning’o onga buna aye ase egati ye chinyasae?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o onga buna aye ore nobonene na obochenu?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naye ogwenerete koirokwa na gotogigwa, aye naye oyogokora amakumia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero kwaramborete okoboko kwao gw’okorio, ense ekabamera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.12",
            "verseOrgIds": [
              "EXO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase chiira chiao chi’obwanchani chiria kwabarierete okaraa abanto aba kwabooretie,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase chinguru chiao okabaikia ase obomenyo bwao obochenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’ebisaku bakayaigwa, bagatengechigwa ase omoondoko,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.14",
            "verseOrgIds": [
              "EXO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoichano na obororo bikabwata abamenyete Bofilisti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.14",
            "verseOrgIds": [
              "EXO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaambi b’Edomu bakaondoka, abanto abanene ba Moabu bakabwatwa nomotengecho,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.15",
            "verseOrgIds": [
              "EXO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto bonsi ba Kaanani bakerusia moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.15",
            "verseOrgIds": [
              "EXO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoondoko na obwoba bikababwata;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’okobua gw’okoboko kwao bagatenena,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagakira‐kiri buna amagena,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika abanto bao baetire, ee, Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika abanto bao kwabooretie baetire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobasoyie na kobabeeka ase egetunwa kiao aye omonyene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aase aria kweroiseretie, aye Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obomenyo obochenu kwaagachete namaboko ao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.17",
            "verseOrgIds": [
              "EXO.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nagaambe kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.18",
            "verseOrgIds": [
              "EXO.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero chibarasi chia Farao, amo ne chigari na abariini basoete nyancha ime, Omonene akairania amaache igoro yabo, akabatuba; korende Abaisraeli bagaeta egati y’enyancha ase ense enkamoku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera kwa Miriamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Miriamu omobani, omoiseke omwabo Aroni, akaimokia ekebangarara",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "text": "kiaye, na abakungu bonsi bakamobwatia bakobugia ebibangarara biabo na goteenga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriamu akabaterera ogoteera kogoteeba,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Moterere Omonene, ekiagera ere obuire ase okobua okonene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chibarasi amo nabachiriinete obarimeirie ase enyancha ime.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Chinsoko chire namaache amaroro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Musa agatang’ana Abaisraeli kogenda orogendo korwa ase Enyancha Embariri gochia erooro ya Suri. Bagataara ase engaki y’amatuko atato ase erooro, na tibanyora maache.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bagaika aase are korokwa Mara,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "text": "tibanyara konywa amaache arengeo, ekiagera arenge amaroro mono. Nakio kiagerete aase aria akarokwa Mara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo abanto bakemurunganeria Musa, bakamobooria, “Ninki tokonywa?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akarera ase Omonene, n’Omonene akamworokia ekeng’ese kio omote. Omote oyio Musa akayoruta amaache ime, na amaache aria akaba amaansu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Agw’Omonene akabeekera abanto amaachiko akobaraa, na agwo akaba okobateema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabora, “Oise koigwera aya inche Omonene oo ngokwana, na koyakora ayare boronge ase amaiso aane, na gotegerera amaachiko aane, na kobwata emeroberio yane yonsi, rirorio inche tingokobekera amarwaire ande onsi buna aria nabeekerete Abamisiri; naki ninche Omonene oo, oyogokogwenia.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio abanto bagaika Elimu; agwo chinsoko nchiarengeo ikomi na ibere, na emekendo emerongo etan’abere (70). Bagatoora agwo ang’e namaache.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
        }
      ]
    }
  ],
