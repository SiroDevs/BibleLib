      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Sulemani ogoikerania onsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(1 Abar 9:10-28)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omoerio bw’emiaka emerongo ebere, eria Sulemani airete ase okoagacha enyomba y’Omonene na enyomba yaye omonyene,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaagacha naende emechie eria Huramu amoete, erio akabeeka Abaisraeli aroro bayemenye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Sulemani akagenda koira orogongo rwa Hamati na Soba,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaagacha Tadimori agwo ase erooro, amo nemechie yonsi ase baare koagacha ebinto agwo Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo naende akaagacha Beti‐Horoni ya rogoro, na Beti‐Horoni ya maate, akayegitera chindwaki na koyeroiseria ebiita amo nemekorogoto,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaagacha na Baalati na emechie yaye yonsi ase ebinto biarenge kogachwa, na emechie yonsi ye chigari chiaye, na eye chibarasi chiaye chikoriinwa, na amaagacho ande onsi Sulemani aganetie koagacha agwo Yerusalemu na Lebanoni, na aande onsi ase obogambi bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto Sulemani abetereretie gokora emeremo nigo barenge abe chinderia chi’abaanto b’Abaisraeli inse ya Kaanani, abwo Abaisraeli batanyarete kobua na gosiria. Abanto abwo tibarenge. Nigo barenge Abahiti, na Abaamori, na Abaperisi, na Abahivi, na Abayebusi. Abanto abwo bakagenderera koba abasomba, nabo bare goika reero iga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Sulemani takorete Abaisraeli babe abasomba ase okomokorera emeremo. Barabwo nigo babete abasikari, na abanene b’oborwoti, na abachiki baye be chigari ne chibarasi chikoriinwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abateneneri abanene b’omorwoti Sulemani nigo barenge abanto amagana abere na emerongo etano; abwo nigo barenge kogambera abakori emeremo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani akang’anyia mokaye, mosubati o Farao, korwa ase Omochie o Daudi gochia ase enyomba eria amoagacherete, ekiagera nigo ateebete, “Omokungu oyo takomenya ase enyomba ya Daudi, omorwoti bw’Abaisraeli, ekiagera aase agwo ase Esanduki y’Omonene yarentirwe naachenu.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Sulemani akarua ebing’wanso bi’ogosambwa ase Omonene igoro ase egesasiimero ki’Omonene, keria aagachete agwo ang’e nenyomba yaagachetwe bosio bwe Hekalu ekabwateranigwa nero.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabirua buna Musa achigete biruegwe ase kera Rituko Richenu: Chisabato, na Emetienyi Emeyia, na Amatuko Amanene ara gatato ase omwaka: Amatuko Amanene ay’Emegati etabekiri memera, na Amatuko Amanene e Chichuma, na Amatuko Amanene ay’Ebigutu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabwatia omooroberio o Daudi ise, akabeeka ebiombe bi’abakuani ase ogokora emeremo yabo, na Abalawi ase emeremo yabo y’ogokonya abakuani na ase ogoteera amatera ’ogotogia, na emeremo ende buna yaganeirie kera rituko. Boigo akabeeka ebiombe bi’abarendi b’ebiita gokora emeremo yabo ase kera egeita buna yaganeirie kera rituko, buna Daudi, omonto oria o Nyasae, achigete ekorwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana onsi omorwoti achigete abakuani na Abalawi nigo aikeranetigwe kegima ase kera ring’ana rinde rionsi amo nerie chimonga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono emeremo yonsi Sulemani akorete ase enyomba y’Omonene, korwa okobekwa kw’oboroso goika ogoikeranigwa kw’oboagacho, ekaera. Igo enyomba y’Omonene ekaba eikeranete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega y’ayio Sulemani akagenda agwo Esioni‐Geberi na Eloti ase engegu y’enyancha, ase ense ya Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramu akamotomera chimeeri chiarenge kogendigwa nabagendia baye, amo nabaanto bande bamanyete emeremo y’enyancha. Barabwo bakagenda goika Ofiri amo nabasomba ba Sulemani, bakarenta korwa aroro chitaabu chitalanta amagana ane, na emerongo etano, bakayeirera Sulemani omorwoti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
  ],
