  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2CH 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobani Mikaya ogokuurera Ahabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(1 Abar 22:1-8)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yehosafati abeete omonda mono naende asikire, akanyuoma omokungu korwa ase enyomba y’Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.1",
            "verseOrgIds": [
              "2CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega y’emiaka emeke akagenda ase Ahabu agwo Samaria. Nere akanyenyera Yehosafati, amo nabaanto barenge amo nere, ching’ondi chinyinge ne chiombe; erio akamoebereria agende amo nere korwania Ramoti o Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.2",
            "verseOrgIds": [
              "2CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu, omorwoti bw’Abaisraeli, agakwana na Yehosafati, omorwoti bw’Abayuda, akamobooria, “Nogende amo nainche korwania Ramoti o Gileadi?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yehosafati akamoiraneria, “Inche nigo inde buna aye, na abanto baane nigo bare buna abanto bao. Intwe ntobe amo naye ase okorwana esegi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende Yehosafati agateebia omorwoti bw’Abaisraeli, “Ritang’ani toborie Omonene igoro y’amang’ana aya.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.4",
            "verseOrgIds": [
              "2CH.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio omorwoti bw’Abaisraeli agasangereria ababani, abanto amagana ane, amo, akababoria, “Nkogenda tore korwania Ramoti o Gileadi, gose yaya?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Barabwo bakamoiraneria, “Genda, ekiagera Nyasae nabeeke omochie oyio ase okoboko kwao, aye omorwoti.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yehosafati akaboria, “Inee! Omobani onde bw’Omonene tari aiga, tonyare koboria goetera asare?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti bw’Abaisraeli akairaneria Yehosafati, “Omonto oyomo natigarete, toraborie Omonene goetera asare, nere Mikaya, mosinto o Imula, korende nigo imogechete, ekiagera ere tari kobana amang’ana amaya igoro yane, korende botambe namabe oka.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yehosafati akamoteebia, “Aye omorwoti, tobaisa gokwana igo.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio omorwoti bw’Abaisraeli akarangeria omosomba oyomo, akamochika, “Genda bwango orente Mikaya, mosinto o Imula.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.8",
            "verseOrgIds": [
              "2CH.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono omorwoti bw’Abaisraeli na Yehosafati, omorwoti bw’Abayuda, nigo baikaransete ase ebirogo biabo bi’oborwoti, baikaransete agwo ase ekeooreri ang’e negeita gia Samaria, babegete chianga chiabo chi’obonene, na ababani baria bonsi nigo barenge korua obobani bwabo ase amaiso ’abarwoti baria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.9",
            "verseOrgIds": [
              "2CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekia, mosinto o Kenaana, akeroiseria ching’unchara chi’ebioma, agakwana, “Aya nar’Omonene atebiire: Ase ching’unchara echi nobetere Abasiiria goika basirigwe kegima.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.10",
            "verseOrgIds": [
              "2CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabani baria bonsi bakabana amang’ana ayio ayio, bagateeba, “Genda Ramoti o Gileadi, noyobue. Omonene nayobeke ase okoboko kwao, aye omorwoti.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oria otometwe gochia korangeria Mikaya akagenda, akamoteebia, “Rora, amang’ana ’ababani bande nigo are ayamo, okoria eira y’egesio ekiya ase omorwoti; tiga ring’ana riao ribe erimo namang’ana abo; naye boigo okwane amang’ana okoria eira y’egesio ekiya ase omorwoti.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.12",
            "verseOrgIds": [
              "2CH.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Mikaya agateeba, “Ekeene, buna Omonene are moyo, ring’ana Nyasae arantebie, nario ndakwane.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero achete ase omorwoti, omorwoti akamobooria, “Inee! Mikaya, nkogenda tore korwania Ramoti o Gileadi, gose totige?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Ere akamoiraneria, “Genda, obue! Abanto baria nababekwe ase amaboko aino.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti akamobooria, “Ng’ara karenga nkogotiania ng’a onteebie ekeene gioka ase erieta ri’Omonene?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akairaneria, “Naroche Abaisraeli bonsi besiarerete igoro y’ebigoro buna ching’ondi chitabwati omorisia, n’Omonene aganteebia: Abanto aba tibabwati omoraai obo, tiga kera oyomo airane agende nka ore nomorembe!”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na omorwoti bw’Abaisraeli agateebia Yehosafati, “Tinagoteebia ng’a ere takobana amang’ana amaya igoro yane, korende namabe oka?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
              "2CH.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende Mikaya akagenderera gokwana, agateeba, “Ase ayio, igwa ring’ana ri’Omonene. Inarora Omonene oikaransete aaria igoro ase ekerogo kiaye ki’obonene, na emeganda yonsi y’abamalaika eteneine ensemo yaye y’okorio na ey’okobee.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Omonene akaboria: Ning’o ogochia koebereria Ahabu, omorwoti bw’Abaisraeli, erinde agende Ramoti o Gileadi abugwe? Oyomo agakwana egento ekemo, na oyonde egento kende.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio omoika ogaacha ogatenena bosio bw’Omonene ogateba: Ninche ndamoebererie. Omonene akaboria omoika oria: Nase enchera ere naki oramoebererie?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoika oria okairaneria: Nigo nkoimoka ngende, imbe omoika bw’obong’ainereria ase emenwa y’ababani baria bonsi b’Ahabu. Omonene akayoteebia: Genda omoebererie ase enchera eyio. Nobue.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ase ayio rora bono, Omonene obaeire omoika bw’obong’ainereria ase emenwa y’ababani aba bao bonsi, ekiagera ochikiire ng’a nonyore egesio ekebe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Zedekia, mosinto o Kenaana, agaika ang’e ase Mikaya, akamoaka oroe ase orosea, akamobooria, “Nase nchera ki omoika bw’Omonene orua ase ’nde, erinde ogakwana naye?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akamoiraneria, “Aye norore ayio rituko riria oratame na gosoa ase ekenunchi bwebise.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti bw’Abaisraeli agateeba, “Bwata Mikaya momoiranie ase Amoni, omogabana bw’omochie, na ase Yoashi, omomura bw’omorwoti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mobateebie ng’a aya naro omorwoti atebiire: Beka omonto oyio ime ase echela, momong’ate endagera na amaache goika ing’irane inde nomorembe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.26",
            "verseOrgIds": [
              "2CH.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akamoiraneria, “Onye kogochia koirana kore nomorembe, rirori’Omonene takwaneti goetera ase ’nde.” Naende agateeba, “Inwe abanto bonsi, igwa amang’ana ayio.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokwa kw’Ahabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(1 Abar 22:29-35)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono omorwoti bw’Abaisraeli na Yehosafati, omorwoti bw’Abayuda, bakagenda korwania Ramoti o Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na omorwoti bw’Abaisraeli agateebia Yehosafati, “Inche nigo ngwekona ase ogwetuba timanyekana, erio ngende ase esegi, korende aye obeke chianga chiao chi’oborwoti.” Omorwoti bw’Abaisraeli agekona ase ogwetuba tamanyekana; erio bakagenda ase esegi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono omorwoti bw’Abasiiria konya ochikiire abateneneri baye be chigari, obatebirie, “Timobaisa korwana na monto onde bwensi, abe omoke gose omonene, korende morwane nomorwoti bw’Abaisraeli bweka.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abateneneri be chigari baroche Yehosafati, bagateeba, “Nere omorwoti bw’Abaisraeli.” Ase ayio bagaonchoka bakarwana nere, na Yehosafati akarera mono, n’Omonene akamokonya. Nyasae akabang’usa bakarua asare,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera ekero abateneneri be chigari baroche ng’a ere tarenge omorwoti bw’Abaisraeli, bakaonchoka, bagatiga komobwatia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende omonto oyomo akaruta omogwe ase okorengia bosa igo, akabeta omorwoti bw’Abaisraeli ase ribaga riarenge gati y’engobo y’ekioma, ase egekuba kiaye. Erio omorwoti agateebia omogendia bw’egari yaye, “Onchora egari ondusie ase esegi, ekiagera nabetirwe mono.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esegi eria ekaba entindi mono ase rituko riria, na omorwoti agatenena ase egari yaye, origereretie Abasiiria, goika mogoroba; erio ekero erioba riabeire ang’e kogwa agakwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
      ]
    }
