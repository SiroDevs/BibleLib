  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okobokigwa gwa Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono baminto, nkobainyoria nde enchiri eyio nabaranderetie; nero mwanyorete, na ase eyio nao moteneine,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.1",
            "verseOrgIds": [
              "1CO.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ase eyio mwatoorigwe, onye mwabwatire mono amang’ana nabaranderetie. Onye taibo, rirorio nigo mwegenete bosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.2",
            "verseOrgIds": [
              "1CO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki ritang’ani nabarenterete amang’ana aya nanyorete inche omonyene, ng’a Kristo nigo akwete ase engencho y’ebibe biaito, buna amariiko agoteeba;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende agatindekwa, erio akaboka rituko ria gatato, buna amariiko agoteeba;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende akaorokera Kefa; naende na baria ikomi na babere.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.5",
            "verseOrgIds": [
              "1CO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega akaorokera abaminto goetania amagana atano amo. Abange ase abwo moyo bare nonya mbono, abande bakuure.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.6",
            "verseOrgIds": [
              "1CO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega y’ayio akaorokera Yakobo, erio abatomwa bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.7",
            "verseOrgIds": [
              "1CO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na omoerio akang’orokera nainche. Inche nigo inde buna oyoiboretwe ase ekero getare boronge.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki inche nomoke ase abatomwa, ntagwenereti korokwa omotomwa, ekiagera nachandete ekanisa ya Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ase obuya bwa Nyasae nabeire buna inde; na obuya bwaye bore ase ’nde tibwarenge bosa. Korende kobua mono nakorire emeremo goetania bonsi, gose tari inche, korende obuya bwa Nyasae obore amo nainche.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.10",
            "verseOrgIds": [
              "1CO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki onye ninche, gose mbaria, naboigo tokorandia, naboigo mwegenete.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okobokigwa kw’abakuure",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono onye Kristo orandiigwe ase more buna nabogetigwe korwa ase abakuure, naki rende abande ase more bagoteeba ng’a kobokigwa kw’abakuure tikori?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.12",
            "verseOrgIds": [
              "1CO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende onye okobokigwa kw’abakuure tikori, rirorio Kristo nere tabogetigwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.13",
            "verseOrgIds": [
              "1CO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende onye Kristo tabogetigwe, rirorio okorandia gwaito nokwa bosa, na okwegena kwaino nokwa bosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.14",
            "verseOrgIds": [
              "1CO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, naintwe rirorio twarorekanire koba birori b’oborimo ba Nyasae, ekiagera twateebete ng’a Nyasae nigo abogetie Kristo, oyo rirorio tamobogetie, onye abakuure tibakobokigwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.15",
            "verseOrgIds": [
              "1CO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki onye abakuure tibakobokigwa, rirorio Kristo nere tabogetigwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.16",
            "verseOrgIds": [
              "1CO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na onye Kristo tabogetigwe, okwegena kwaino nokwa bosa; nigo more nonya mbono ase ebibe biaino.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.17",
            "verseOrgIds": [
              "1CO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende nabwo bakwete ase Kristo basirire.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.18",
            "verseOrgIds": [
              "1CO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nase obogima obo bwoka tosemeretie Kristo, rirorio intwe nabataka tore kobua abanto bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende bono nekeene ng’a Kristo obokiigwe korwa ase abakuure buna ogotongorwa kw’abakuure.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.20",
            "verseOrgIds": [
              "1CO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki buna amakweri arentetwe nomonto, naboigo nokobokigwa kw’abakuure kwarentirwe nomonto.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.21",
            "verseOrgIds": [
              "1CO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera buna ase Adamu bonsi bagokwa, naboigo nase Kristo bonsi nababe moyo,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.22",
            "verseOrgIds": [
              "1CO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende kera oyomo aase aye; Kristo agatongora, naende ekero arachiche, abare abaye nababe moyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.23",
            "verseOrgIds": [
              "1CO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio agwo omoerio ochiche, ekero arae Nyasae Tata oborwoti, magega gasaririe kera obogambi na kera okobua ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.24",
            "verseOrgIds": [
              "1CO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki negwenerete ere agambe, goika abeeke ababisa bonsi inse ase amagoro aye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.25",
            "verseOrgIds": [
              "1CO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobisa bw’omoerio orasirigwe namakweri.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.26",
            "verseOrgIds": [
              "1CO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naki Nyasae obekire ebinto bionsi inse ase amagoro aye.” Korende ekero agoteeba, “Bionsi biabekirwe inse asare”, nigo amanyekanete ng’a Nyasae, oyobegete ebinto bionsi inse asare, tabariri ase ebinto ebio.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.27",
            "verseOrgIds": [
              "1CO.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki ebinto bionsi kobiabekirwe inse asare, erio agwo Omwana omonyene nere nabekwe inse ase Nyasae, oyo obegete ebinto bionsi inse asare, erinde Nyasae abe nokobua ase bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Aba bakobatiswa ase engencho y’abakuure, naki rende bagokora? Onye abakuure tibakoboka nonya ng’ake, nase ki bakobatiswa ase engencho yabo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.29",
            "verseOrgIds": [
              "1CO.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki tore nemechando kera engaki?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.30",
            "verseOrgIds": [
              "1CO.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene baminto, ase ogwetogia kwane inde nakwo ase more ase Kristo Yeso Omonene oito, nigo ngokwa kera rituko.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.31",
            "verseOrgIds": [
              "1CO.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye, nase engencho ya Mwanyabaanto, nkarwana ne ching’iti chintindi aaria Efeso, inki erangwenere? Onye abakuure tibakoboka, “Tiga torie na konywa, ekiagera ankio natokwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timong’aineka! Egosori embe nigo egosaria chingencho chingiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.33",
            "verseOrgIds": [
              "1CO.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka buna egwenerete ase oboronge, timokora ebibe naende. Naki abande tibamomanyeti Nyasae. Natebiire aya ase okobasookia.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobere bwo’kobokigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende omonto naborie, “Naki abakuure baraboke? Naende mobere ki barache noro?”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.35",
            "verseOrgIds": [
              "1CO.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoriri oyo, eke ogosimeka aye, tikeri komera getakweti.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.36",
            "verseOrgIds": [
              "1CO.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neke ogosimeka, tori gosimeka egento keria kegocha koba, korende embusuro yoka; onye nengano gose mbusuro ende yonsi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.37",
            "verseOrgIds": [
              "1CO.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Nyasae ayea ekieni buna anchete, na kera embusuro ayea ekieni kiaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.38",
            "verseOrgIds": [
              "1CO.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinyama chionsi tichiri echimo; korende echinde nechia Mwanyabaanto, echinde nechie ching’iti, echinde nechie chinyoni, na echinde nechie chinswe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.39",
            "verseOrgIds": [
              "1CO.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende mbire igoro ebitongwa bitongire, na mbire ase ense ebitongwa bitongire, korende obonene bw’ebia igoro nigo bore ao, na obonene bw’ebia nse nigo bore ao.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.40",
            "verseOrgIds": [
              "1CO.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CO 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obonene bw’erioba nigo bore ao, na obonene bw’omotienyi nigo bore ao, na obonene bwe ching’enang’eni nigo bore ao, naende ogwatananekana nkore ase egati ye ching’enang’eni chinyene ase obonene.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.41",
            "verseOrgIds": [
              "1CO.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CO 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo nokobokigwa kw’abakuure. Osimekwa ase ogosareka, obokigwa ase ogotasareka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.42",
            "verseOrgIds": [
              "1CO.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CO 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osimekwa ase obosooku, obokigwa ase obonene; osimekwa ase oboreu, obokigwa ase chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.43",
            "verseOrgIds": [
              "1CO.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CO 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobere o Mwanyabaanto osimekwa, korende omobere bw’omoika obokigwa. Onye omobere o Mwanyabaanto oreo, naboigo noyo bw’omoika noreo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CO 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo eriikire, “Omonto bw’eritang’ani Adamu akaba omonto ore moyo”, Adamu bw’omoerio akaba omoika bw’okoa obogima.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.45",
            "verseOrgIds": [
              "1CO.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CO 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende oria orenge bw’omoika, tari oro orenge bw’eritang’ani, korende noria bw’omobere o Mwanyabaanto orenge bw’eritang’ani; magega y’ayio oria bw’omoika.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.46",
            "verseOrgIds": [
              "1CO.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CO 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto bw’eritang’ani akarwa inse, agatongwa korwa ase amaroba; omonto o kabere akarwa igoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.47",
            "verseOrgIds": [
              "1CO.15.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CO 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna omonto oyo bw’amaroba arenge, naboigo nab’amaroba bare; na buna omonto o igoro are, naboigo naba igoro bare.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.48",
            "verseOrgIds": [
              "1CO.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na buna tobogoretie ekieni ki’oria bw’amaroba, naboigo torabogorie ekieni ki’oria o igoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CO 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaminto, aya nkobateebia naya, ng’a omobere na amanyinga tibikonyora omwando bw’oborwoti bwa Nyasae; gose ogosareka tigokonyora omwando bw’ogotasareka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.50",
            "verseOrgIds": [
              "1CO.15.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CO 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rigereria, aya nkobateebia nobobisi. Titogokwa intwe twensi, korende twensi natoonchorwe,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.51",
            "verseOrgIds": [
              "1CO.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CO 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "ase ekero egesinini, okomiamia na okoramokia, ekero ki’egetureeri ki’omoerio. Naki egetureeri nakebuge, na abakuure nababokigwe, tibaaba nogosareka, na intwe natoonchorwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.52",
            "verseOrgIds": [
              "1CO.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CO 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki ogosareka kwagweneire koboigwe ogotasareka, na ogokwa koboigwe ogotakwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.53",
            "verseOrgIds": [
              "1CO.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CO 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero oyo bw’ogosareka oranyore ogotasareka, na oyo bw’ogokwa oranyore ogotakwa; erio naribe ring’ana riria ririikire,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.54",
            "verseOrgIds": [
              "1CO.15.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Amakweri amerirwe ase okobua.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.54",
            "verseOrgIds": [
              "1CO.15.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CO 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amakweri, ng’ai okobua kwao kore?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amakweri, ng’ai obororo bwao bore?”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1CO 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obororo bw’amakweri nebibe, ne chinguru chi’ebibe namachiiko.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.56",
            "verseOrgIds": [
              "1CO.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1CO 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende mbuya mono ase Nyasae, ere oyogotoa okobua goetera ase Omonene oito Yeso Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.57",
            "verseOrgIds": [
              "1CO.15.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1CO 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki baminto, abanchwa, mobe ne chinguru, motari gotengechigwa, momente mono gokora emeremo y’Omonene ase amatuko onsi, momanye ng’a emeremo yaino ase Omonene teri bosa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.58",
            "verseOrgIds": [
              "1CO.15.58"
            ]
          }
        }
      ]
    }
  ],
