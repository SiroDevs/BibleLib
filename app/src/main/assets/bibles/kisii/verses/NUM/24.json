          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Baalamu akaimoka, akairana bwoye, na Balaki nere akabwatia enchera, akageenda bwoye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
            "verseOrgIds": [
              "NUM.24.25"
            ]
          }
        }
