  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "NUM 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amachiiko Ase Abanaziri, Abanto Aberuete Ase Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene agakwana na Musa, akamoteebia,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.1",
            "verseOrgIds": [
              "NUM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bateebie Abaisraeli ng’a ekero omonto, omosacha gose omokungu, akoria eira abe oyo bweatananire ase Omonene abe Omwerwa oye,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika eatanane korwa ase edivai amo nebinyugwa bigotindia. Tabaisa konywa ebinyugwa binde bionsi bikoroisigwa korwa ase amasabibu, gose taria amasabibu, amabese gose amomo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase amatuko aye onsi eatananete koba Omwerwa taria gento kende gionsi gekoroisigwa korwa ase emesabibu. Taria nonya ne chimbusururo gose amasabo y’amasabibu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tabaisa konacha etukia yaye gose gwekigita goika okoorire amatuko aye onsi ariete eira gweatanana koba Omwerwa Omonene. Ere nabe oyo bweatananire, na atige etukia y’omotwe oye ekiine.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tageenda aike ang’e negetondo ase amatuko ayio onsi eatananete koba Omwerwa Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ise nakwa, gose ng’ina, gose momura omwabo, gose omoiseke omwabo, tageenda ang’e negetondo na gwesoyia ase ogotacheneka. Ere nigo abwate ase omotwe oye ekemanyererio ng’a bweatananire koba Omwerwa o Nyasae oye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo arabe omochenu aase Omonene ase amatuko aye onsi eatananete.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende omonto karakwe mobosokano ang’e nere, na akore omotwe oye ore nekemanyererio gi’okwerwa kwaye abe otachenegeti, rirorio Omwerwa oyio aganye amatuko atan’abere erio akigite etukia yaye, na abe oyo’chenekire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko ria gatano na gatato, arente amaruma abere, gose amage y’amaruma abere, ase Omokuani agwo ase egesoero ki’Eema y’Omosangererekano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokuani arue riruma erimo ribe ekeng’wanso ki’ebibe, na erinde eki’ogosambwa ase ogokora okobwatanigwa ase Omwerwa oria, ekiagera okorire ebibe ase ogoika ang’e negetondo. Ase rituko erio erio omonto oria achene omotwe oye,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na eatanane ase Omonene naende, ase engaki eng’ana buna eria ariete eira koba Omwerwa agwo ritang’ani. Erio arente emanwa emingichi yakoorire omwaka oyomo ebe ekeng’wanso gi’okorongeyia okomocha kwaye ekiagera amatuko aria aye amatang’ani eatananete ase Omonene buna Omwerwa oye takobarwa korende nigo arabe bosa, ekiagera okwerwa kwaye gwakorirwe ogotachenegeti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oko nakwo ogochika ase Omwerwa: Ekero engaki yaye y’ogweatanana yaerire, arentwe ase egesoero ki’Eema y’Omosangerekano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere arue ekeng’wanso kiaye ase Omonene: emanwa emingichi yakoorire omwaka oyomo ebe ekeng’wanso ki’ogosambwa, na emanwa esigiti yakoorire omwaka oyomo ebe ekeng’wanso ki’ebibe, na emingichi eyemo ebe ekeng’wanso ki’omorembe; chionsi chibe chitari na bimocho ase emebere yabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo arente egetonga kere n’emagaati etabekiri memera, na arue amaandasi aroisirie n’obosie obonuke bwochoganirie n’amaguta, na emagaati emeoo eakire amaguta, amo n’okoruegwa kw’endagera na okw’ebinyugwa gochiikire amo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omokuani arente ebinto ebio ase obosio bw’Omonene na arue ekeng’wanso ki’ebibe na eki’ogosambwa ase engencho y’omonto oria.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo arue emingichi eria ebe ekeng’wanso ki’omorembe ase Omonene, ayerue amo n’emagaati etabekiri memera ere egetonga ime, na okoruegwa kw’endagera na ogw’ekenyugwa gochiikire amo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo ase egesoero ki’Eema y’Omosangererekano, Omwerwa oria akigite etukia y’omotwe oye ere ekemanyererio ng’a neatananete ase Omonene. Erio aire etukia yaye, ayerute ase omorero oria ore inse y’ekeng’wanso ki’omorembe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Magega, ekero Omwerwa oria akoorire gokigita etukia yaye, Omokuani aimokie rireko ri’emingichi riaiyekirwe, na korwa ase egetonga arusie omogati oyomo otabekiri memera, na omogati oyomo otabekiri memera, ayebeke ase amaboko y’Omwerwa oria.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokuani arente ebinto ebio amo ne ritaana na ekenama bi’emingichi, abisungusie bibe ekeng’wanso ki’ogosungusigwa ase Omonene. Ebinto ebio nigo biatananetwe ase Omokuani. Erio nario Omwerwa oria arabe ne ribaga konywa edivai.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko nakwo ogochika ase oyoriete eira ng’a abe Omwerwa Omonene, goika arue ase Omonene aya amorierete eira akorua ore Omwerwa oye, korende onye oriire eira arue goetania, goika ayeikeranie kegima koreng’ana nogochika gw’okwerwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosesenia Kw’Omonene Kogokwanwa N’abakuani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene agakwana na Musa, akamoteebia,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moteebie Aroni amo nabamura baye ng’a, ekero barabe bagosesenia Abaisraeli, bakwane amang’ana aya:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene abasesenie, abareende;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.24",
            "verseOrgIds": [
              "NUM.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene abaraberie obosio bwaye, abaabere;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.25",
            "verseOrgIds": [
              "NUM.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene abaonchorere obosio bwaye, abae omorembe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.26",
            "verseOrgIds": [
              "NUM.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naboigo bararangerie erieta riane ribe igoro y’Abaisraeli ase okobasesenia, erio inche omonyene nimbasesenie.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.27",
            "verseOrgIds": [
              "NUM.6.27"
            ]
          }
        }
      ]
    }
  ],
