              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto baria bagendete amo nere bagateeba, “Intwe titokonyara korwania abanto baria tobabue; nigo bare ne chinguru gotobua.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
            "verseOrgIds": [
              "NUM.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio bakarentera Abaisraeli amang’ana amabe igoro y’ense eria bagendete koroota, bagateeba, “Ense eria twataara ime yaye koyeroota, nigo ere ense egoita abanto bamenyeteo. Abanto bonsi twarora nabatambe mono.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.32",
            "verseOrgIds": [
              "NUM.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
