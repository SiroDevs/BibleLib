          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mochirue amo n’okoruegwa kw’endagera, na okw’ebinyugwa gochiikire koruerwa amo ne chieri chiria, ne chimingichi chiria, ne chimanwa chimingichi chiria, koreng’ana nomobaro obo. Boigo mochirue koreng’ana nomoroberio ochiikire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
