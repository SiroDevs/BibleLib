    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko ria ikomi na gatano ri’omotienyi o gatano na kabere mobe nomosangererekano bwatananire ase ogosasiima. Timokora emeremo ende yonsi, korende morende Rituko Rinene ri’Omonene ase engaki y’amatuko atano na abere.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Morue chieri ikomi na isato, ne chimingichi ibere, ne chimanwa chimingichi ikomi na inye, echiakoorire omwaka oyomo, chionsi chibe chitari ne kemocho ase emebere yabo. Echio nchibe ekengwanso kegosambwa nomorero, kere ne rimisu rigiya rikogwenera Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amo nechio morue okoruegwa kw’endagera, obosie obonuke bwochoganirie n’amaguta. Amo na kera eyemo ye chieri chiria ikomi na isato morue obosie ebimunu bitan’akemo, na amo na kera eyemo ye chimingichi chiria ibere obosie ebimunu bine,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amo na kera eyemo ye chimanwa chimingichi chiria ikomi na inye obosie ebimunu bibere.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende morue egoree eyemo ebe ekeng’wanso ki’ebibe. Ebing’wanso ebio bimentwe ase ekeng’wanso ki’ogosambwa gia kera rituko, na okoruegwa kw’endagera, na okw’ebinyugwa gochiikire amo nabirobio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        }
      ]
