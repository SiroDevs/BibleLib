      },
      "items": [
        {
          "text": "Ebing’wanso Bi’Omwaka Omoyia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Abal 23:23-25)",
