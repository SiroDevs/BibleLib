          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rituko ria kabere morue chieri chinsae ikomi na ibere, ne chimingichi ibere, ne chimanwa chimingichi ikomi na inye, echiakoorire omwaka oyomo, chionsi chibe chitari na kemocho ase emebere yabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
