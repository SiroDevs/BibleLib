              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli bakarua egetunwa keria kia Hori, bakageenda bagaika Salimona bagatoora aroro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
