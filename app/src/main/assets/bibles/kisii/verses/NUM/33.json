          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakarua Oboti, bakageenda bagaika Iye‐Abarimu, bagatoora aroro ase orobebe rwa Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
