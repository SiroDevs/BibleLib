          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 33:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na omorwoti orenge kogamba Aradi, ensemo ya Irianyi ase ense ya Kaanani, akaigwa ng’a Abaisraeli nigo bare inchera gocha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
