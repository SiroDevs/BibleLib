          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakarua Kadeshi, bakageenda bagaika egetunwa kia Hori, ang’e norobebe rw’ense ya Edomu, bagatoora aroro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
            "verseOrgIds": [
              "NUM.33.37"
