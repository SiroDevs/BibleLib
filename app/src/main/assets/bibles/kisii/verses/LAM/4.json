  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "LAM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yerusalemu magega kogure",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki etaabu yasiririe obomeka‐meku bwaye!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki etaabu echenire yaonchokire!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amagena aya Aase Aachenu asiareirwe",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase amatabekania e chinchera chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamura ba Sayoni abare nengencho enene,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bareng’anirie ne chitaabu chingiya,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naki yabeire ng’a bareng’anigwe ne chinyongo chi’amaroba,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "echire emeremo y’amaboko ’abakori chinyongo?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya ne chisese chi’orosana nkogonkia chire chimanwa chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abakungu b’omochie bw’abaanto bane babeire abatindi,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna chisagero chire ase erooro.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimeme chi’abana bakogonka chiabwatanire namang’ang’ura ase engencho y’erang’o;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abana abake nigo bagosaba endagera,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende monto onde tari okobaa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo baarenge koria endagera engiya mono",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakwereire ase chinchera;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abwo barenge kweboyia chianga chimonyinga,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baraire ase ebinge bi’eribu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nigo abanyorete,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ebibe biakorire ase omochie bw’abaanto bane nigo biarenge ebinene",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kobua ebi’abaanto ba Sodomu,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omochie oyio nigo oonchoranetwe ase etagika eyemo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okoboko kw’onde tikwayokunete.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaambi baye nigo baarenge komeka-meka kobua amagena ’embura,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baarenge abarabu se kobua amabeere,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emebere yabo nigo yarenge emebariri kobua amagena amabariri,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okororekana kwabo nigo kwarenge buna safiro, rigena rie rigori rinene.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono amaiso abo abeire amamwamuti kobua embiro,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibari komanywa agwo ase chinchera;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amasankwa ’emebere yabo abwatanire namauga abo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omire pa buna amasabo amomo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbare negesio abwo bagokwa ase ogoitwa nemioro",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kobua abwo enchara egoita,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera barabwo nigo bakogenderera korea na korea,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase okoborwa gw’okwama kw’emegondo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaboko ’abakuungu abare namayianda",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aiyekire abana babo abanyene;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo nigo babete endagera yabo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero omochie bw’abaanto bane orenge gosirigwa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oumoire okogechigwa kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, oumoire endamwamu yaye entindi;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase Sayoni otongirie omorero,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "osambire amaroso aye.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwoti b’ense, na abanto bonsi bamenyeteo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.12",
            "verseOrgIds": [
              "LAM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibegenete ng’a omochandi, gose omobisa onde bwensi,",
