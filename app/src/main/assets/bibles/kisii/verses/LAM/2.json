              "type": "text"
            }
          ]
        },
        {
          "text": "Buna ase rituko ri’omoyega omonene okarangeria ababisa bane bakanyoboyia korwa chinsemo chionsi;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.22",
