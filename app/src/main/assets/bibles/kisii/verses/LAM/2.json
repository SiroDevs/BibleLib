  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "LAM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene okorua egesusuro ase Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki Omonene atubire omochie o Sayoni nomosunte,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.1",
            "verseOrgIds": [
              "LAM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero arenge n’endamwamu!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.1",
            "verseOrgIds": [
              "LAM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Otugutire obonene bokomeka‐meka bw’Abaisraeli",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.1",
            "verseOrgIds": [
              "LAM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa igoro gocha inse aa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.1",
            "verseOrgIds": [
              "LAM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere tainyoreti egeteni ki’amagoro aye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.1",
            "verseOrgIds": [
              "LAM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase rituko ri’endamwamu yaye.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.1",
            "verseOrgIds": [
              "LAM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oiyeirie inse obomenyo bwonsi bw’abaanto ba Yakobo atari namaabera,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.2",
            "verseOrgIds": [
              "LAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otagoire chiburi chi’ense y’Abayuda, ekero arenge nendamwamu;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.2",
            "verseOrgIds": [
              "LAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "osiririe oborwoti, na ourire abanene baye amasikani.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.2",
            "verseOrgIds": [
              "LAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutoire ching’unchara chionsi chi’Abaisraeli ore nendamwamu yaye entindi,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.3",
            "verseOrgIds": [
              "LAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "orusirie okoboko kwaye gw’okorio korwa ase bare ase amasio ’ababisa babo:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.3",
            "verseOrgIds": [
              "LAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere osambire abanto ba Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.3",
            "verseOrgIds": [
              "LAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna omorero ekebemberi ogosamba ase chinsemo chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.3",
            "verseOrgIds": [
              "LAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere otingire obota bwaye buna omobisa agotinga,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.4",
            "verseOrgIds": [
              "LAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otenenire na kobong’usa nokoboko kwaye gw’okorio buna omochandi;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.4",
            "verseOrgIds": [
              "LAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agaita bonsi aba twetogeretie.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.4",
            "verseOrgIds": [
              "LAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Igoro y’obomenyo bw’abaanto ba Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.4",
            "verseOrgIds": [
              "LAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oumoire ekeririanda kiaye kere buna omorero.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.4",
            "verseOrgIds": [
              "LAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene obeire buna omobisa, osiririe Abaisraeli;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.5",
            "verseOrgIds": [
              "LAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "osiririe chinyomba chiaye chionsi chi’oborwoti,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.5",
            "verseOrgIds": [
              "LAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otagoire chiburi chiaye chinkong’u;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.5",
            "verseOrgIds": [
              "LAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende omenteire abanto ba Yuda okorera na okweumia.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.5",
            "verseOrgIds": [
              "LAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere oiyeirie inse orobago rwaye rore buna orw’omogondo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.6",
            "verseOrgIds": [
              "LAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, osaririe aase emesangererekano y’ogosasiima ekobeera.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.6",
            "verseOrgIds": [
              "LAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene otigire abanto bebire Amatuko Amanene ne Chisabato agwo Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.6",
            "verseOrgIds": [
              "LAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase okogechigwa kwaye okonene bwangire omorwoti na Omokuani.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.6",
            "verseOrgIds": [
              "LAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene bwangire egesasiimero kiaye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.7",
            "verseOrgIds": [
              "LAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otigire Aase aye Aachenu asarigwe;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.7",
            "verseOrgIds": [
              "LAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otigire chindwaki chiaye ase amaboko ’ababisa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.7",
            "verseOrgIds": [
              "LAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto bakuurire ime ase enyomba y’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.7",
            "verseOrgIds": [
              "LAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna nase rituko ri’omosangererekano bw’ogosasiima.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.7",
            "verseOrgIds": [
              "LAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene onachire ase ebirengererio biaye gosaria chindwaki chi’omochie o Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.8",
            "verseOrgIds": [
              "LAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oramboire engori y’okorengera.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.8",
            "verseOrgIds": [
              "LAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tagotanga okoboko kwaye tayosaria;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.8",
            "verseOrgIds": [
              "LAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otigire chiburi ne chindwaki chikweumia,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.8",
            "verseOrgIds": [
              "LAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chionsi amo nigo chiumatete.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.8",
            "verseOrgIds": [
              "LAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiita biaye biarimeire ase riroba,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.9",
            "verseOrgIds": [
              "LAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emekorogoto yaye yabunirwe na gosarigwa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.9",
            "verseOrgIds": [
              "LAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omorwoti oye, na abagaambi baye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.9",
            "verseOrgIds": [
              "LAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bamenyete ase egati y’abanto b’ebisaku bitabwati amachiiko,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.9",
            "verseOrgIds": [
              "LAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ababani baye tibari konyora amaroro korwa ase Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.9",
            "verseOrgIds": [
              "LAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaaka b’omochie o Sayoni nigo",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.10",
            "verseOrgIds": [
              "LAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baikaransete inse bakirete‐kiri,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.10",
            "verseOrgIds": [
              "LAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "besiarerete ebuse ase emetwe yabo",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.10",
            "verseOrgIds": [
              "LAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kweboyia chigunia,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.10",
            "verseOrgIds": [
              "LAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abaiseke abekungi ba Yerusalemu nigo baturegete emetwe yabo gochia inse.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.10",
            "verseOrgIds": [
              "LAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso aane arosire ase okoiyeria amariga,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.11",
            "verseOrgIds": [
              "LAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoyo one oonchokanire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.11",
            "verseOrgIds": [
              "LAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enkoro yane yachandekire",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.11",
            "verseOrgIds": [
              "LAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’ogosaria kw’omochie bw’abaanto bane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.11",
            "verseOrgIds": [
              "LAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera abana, nonya nabakogonka, nigo bakona‐kogireka ase chinchera chi’omochie.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.11",
            "verseOrgIds": [
              "LAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bakoboria abang’ina:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.12",
            "verseOrgIds": [
              "LAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ng’ai endagera ere, na edivai?”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.12",
            "verseOrgIds": [
              "LAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bakona‐kogireka na korara ase chinchera chi’omochie buna abaakirwe chingoma,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.12",
            "verseOrgIds": [
              "LAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batweka mo ase amaboko ’abang’ina.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.12",
            "verseOrgIds": [
              "LAM.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omochie o Yerusalemu, ninki ndagoteebie?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.13",
            "verseOrgIds": [
              "LAM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninki ndakoreng’anie?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.13",
            "verseOrgIds": [
              "LAM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Mang’ana ki anga buna ayao ndagoteebie, erinde nkoremie,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.13",
            "verseOrgIds": [
              "LAM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Sayoni ore buna omoiseke omwekuungi?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.13",
            "verseOrgIds": [
              "LAM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ogosarigwa kwao nokonene buna enyancha ere enene,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.13",
            "verseOrgIds": [
              "LAM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ning’o oranyare gokogwenia?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.13",
            "verseOrgIds": [
              "LAM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabani bao nigo bakobarorera amaroro ’obong’ainereria are bosa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.14",
            "verseOrgIds": [
              "LAM.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibakoorokeretie obobe bwao, erinde nario orairanerigwe amaya",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.14",
            "verseOrgIds": [
              "LAM.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ao; korende aya amaroro abo ayakworogetie,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.14",
            "verseOrgIds": [
              "LAM.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo arenge ay’oborimo, agerete ogatantanigwa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.14",
            "verseOrgIds": [
              "LAM.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bonsi abagoeta inchera nigo bagoaka chinkobi ase okogochaaya,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.15",
            "verseOrgIds": [
              "LAM.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakobugia emeroria na gosingiseria omochie o Yerusalemu emetwe, bakobora:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.15",
            "verseOrgIds": [
              "LAM.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Inee! Omochie oyio noro orenge korokwa omoikeranu bw’obosiani, na omogooko bw’ense yonsi?”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.15",
            "verseOrgIds": [
              "LAM.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa bao bonsi baasamirie emenwa yabo",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.16",
            "verseOrgIds": [
              "LAM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gokobugeria emeroria na gokoriananeria amaino, bakobora:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.16",
            "verseOrgIds": [
              "LAM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Twayosaririe!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.16",
            "verseOrgIds": [
              "LAM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, rituko eri nario twaganetie,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.16",
            "verseOrgIds": [
              "LAM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono twariikeire, twarirorire!”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.16",
            "verseOrgIds": [
              "LAM.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene okorire aya achiigete ng’a ayakore,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.17",
            "verseOrgIds": [
              "LAM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oikeranirie ring’ana riaye aroberetie agwo kare,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.17",
            "verseOrgIds": [
              "LAM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otagoire atari namaabera,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.17",
            "verseOrgIds": [
              "LAM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otigire ababisa bao bagochenga igoro yao,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.17",
            "verseOrgIds": [
              "LAM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere okinirie ching’unchara chi’ababisa bao.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.17",
            "verseOrgIds": [
              "LAM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LAM 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinkoro chiabo nigo chikorera ase Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.18",
            "verseOrgIds": [
              "LAM.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, aye orwaki rw’omochie o Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.18",
            "verseOrgIds": [
              "LAM.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga amariga ao aiteke buna orooche, omobaso na obotuko!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.18",
            "verseOrgIds": [
              "LAM.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tobaisa korosa, gose gotimokia amaiso ao.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.18",
            "verseOrgIds": [
              "LAM.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LAM 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imoka, orere botuko bokie!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.19",
            "verseOrgIds": [
              "LAM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero oborendi bw’obotuko bogochaka,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.19",
            "verseOrgIds": [
              "LAM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oumore ayare ase enkoro yao ime ase obosio bw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.19",
            "verseOrgIds": [
              "LAM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "text": "buna okoumora amaache!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.19",
            "verseOrgIds": [
              "LAM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rambora amaboko ao asare osabere obogima bw’abana bao,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.19",
            "verseOrgIds": [
              "LAM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bagoyire nenchara ase amatabekania e chinchera chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.19",
            "verseOrgIds": [
              "LAM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LAM 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, rigereria orore!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.20",
            "verseOrgIds": [
              "LAM.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o gwakorerete buna ayio?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.20",
            "verseOrgIds": [
              "LAM.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Abakungu mbarie oroiboro rwabo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.20",
            "verseOrgIds": [
              "LAM.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abana abwo barerete ase amaboko abo?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.20",
            "verseOrgIds": [
              "LAM.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Abakuani na ababani mbaiterwe agwo Aase Aachenu a Omonene?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.20",
            "verseOrgIds": [
              "LAM.2.20"
            ]
