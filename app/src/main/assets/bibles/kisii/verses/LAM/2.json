              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamura na abagaaka nigo baraire ase chinchera inse,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.21",
            "verseOrgIds": [
              "LAM.2.21"
            ]
