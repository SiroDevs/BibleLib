      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abaiseke bane, na abamura bane, baitirwe nemioro;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.2.21",
            "verseOrgIds": [
              "LAM.2.21"
            ]
          }
        }
