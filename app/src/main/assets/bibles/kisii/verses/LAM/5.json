        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora amaabera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, inyora aya atonyorire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "origererie orore ogochaywa gwaito.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwando oito oeirwe abanto abaao,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinyomba chiaito chiaeirwe abamenyi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twabeire buna chintakana, chitari nabaise,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abaababa nigo banga buna ababoraka.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaache tokonywa goika toakane chitaabu,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinko togwota nigo tokogora.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abachandi baito nigo batobwatete amogoti,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo tokorosa mono, titori konyora ogotimoka.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twaramboreire Abamisiri na Abaasuri amaboko",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batoe endagera egotoisana.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisokoro chiaito nigo chiakorete ebibe, bono tichiyo;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika tobogorie egesusuro ki’ebibe biabo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasomba nabwo bagotogaambera,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onde tari ogototooria korwa ase amaboko abo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo tokonyora endagera yaito ase okobeeka obogima bwaito ase emechando,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera emioro nere ase erooro.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasankwa ’emebere yaito nigo are ne riberera buna erie riko,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera enchara nigo egotosamba buna omorero.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakungu baito bare Sayoni bakoreirwe amabe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nabaiseke abekungi abare ase emechi y’Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaambi baito babwatirwe na gosungwa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abagaaka baito tibasikiri.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamura baito nabwo bakobogoria chingena chigoserwa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abana abake nigo bakoritoerwa ase okobogoria chinko, bagwa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagaaka tibari goikaransa geita ki’omochie,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abamura batigire kobugia amakano abo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omogoko bwe chinkoro chiaito osirire;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogotenga gwaito kwaonchokire kwabeire ebirero.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigutwa chiarenge ase emetwe yaito chiagure inse.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obobe nobwaito, ekiagera twakorire ebibe!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho y’ayio chinkoro chiaito chiarwarire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.17",
            "verseOrgIds": [
              "LAM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase engencho y’ayio amaiso aito abeire orotutu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.17",
            "verseOrgIds": [
              "LAM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LAM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera egetunwa gia Sayoni giatigaire kere bosa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.18",
            "verseOrgIds": [
              "LAM.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chisese chi’orosana nao chigotaara.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.18",
            "verseOrgIds": [
              "LAM.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LAM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende aye Omonene nigo oragaambe kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.19",
            "verseOrgIds": [
              "LAM.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekerogo kiao ki’obogaambi nigo kerabeo ebiaare ase ebiaare.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.19",
            "verseOrgIds": [
              "LAM.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LAM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki gwatwebire kogenderera botambe?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.20",
            "verseOrgIds": [
              "LAM.5.20"
            ]
