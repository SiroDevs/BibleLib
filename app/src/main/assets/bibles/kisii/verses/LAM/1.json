    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, omochie oyio ororire abanto b’ebisaku bagosoa Aase aye Aachenu,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.10",
            "verseOrgIds": [
              "LAM.1.10"
            ]
