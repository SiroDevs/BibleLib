          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ba Sayoni basamunsire amaboko abo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.17",
            "verseOrgIds": [
              "LAM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende onde tari okobaremia.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.17",
            "verseOrgIds": [
              "LAM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene ochikiire igoro y’abanto ba Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.17",
            "verseOrgIds": [
              "LAM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a abanto abwo baabaetananire babe ababisa babo;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.17",
            "verseOrgIds": [
              "LAM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Yerusalemu obeire okogechia ase bare.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.17",
            "verseOrgIds": [
              "LAM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LAM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nomonyene oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.18",
            "verseOrgIds": [
              "LAM.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya naboigo inche tinyigwereti amachiiko aye.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.18",
            "verseOrgIds": [
              "LAM.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abanto bonsi, tegerera moigwe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.18",
            "verseOrgIds": [
              "LAM.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "morigererie emechando yane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.18",
            "verseOrgIds": [
              "LAM.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abaiseke bane abekungi, na abamura bane, boosirwe na koirwa ase obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.18",
            "verseOrgIds": [
              "LAM.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LAM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche nkarangeria abanchi bane ng’a bankonye, korende bakang’aina;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.19",
            "verseOrgIds": [
              "LAM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abakuani bane na abagaaka bagakwera ase omochie ime,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.19",
            "verseOrgIds": [
              "LAM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero baarenge korigia endagera barie banyore chinguru chinyia.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.19",
            "verseOrgIds": [
              "LAM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LAM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye Omonene, rigereria buna inde ase emechando,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoyo one oonchokanire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enkoro yane yaonchoranirwe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nabeire oyo otari omoigweri.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abana bane baitirwe nemioro ase chinchera,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amakweri abeire ase enka yane.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LAM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abanto baigure buna ng’umatete,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onde tari nonya noyomo okondemia.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ababisa bane bonsi baigure igoro y’emechando yane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagokire ng’a naye gwakorire aya.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Renta rituko riria gwateebete ng’a orarente,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na barabwo babe buna inche.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LAM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiga obobe bwabo bwonsi bororekane ase obosio bwao,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obae egesusuro;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna kwang’ete inche ase engencho y’ogosaria kwane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo ng’umatete mono,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enkoro yane yanyarekire.”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        }
      ]
    }
