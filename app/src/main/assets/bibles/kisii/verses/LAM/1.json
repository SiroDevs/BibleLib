      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde banyore chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.11",
            "verseOrgIds": [
              "LAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Aye Omonene, koranche ondigererie, ekiagera nachayirwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.11",
            "verseOrgIds": [
              "LAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Inwe mwensi aba mogoeta inchera aa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.12",
            "verseOrgIds": [
              "LAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aya nigo are amang’ana abosa ase more?",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.12",
            "verseOrgIds": [
              "LAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigereria morore gose emechando ende ere buna eyane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.12",
            "verseOrgIds": [
              "LAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eyio yarentetwe ase ’nde,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.12",
            "verseOrgIds": [
              "LAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eyi’Omonene andeterete,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.12",
            "verseOrgIds": [
              "LAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero arenge n’endamwamu ekobera.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.12",
            "verseOrgIds": [
              "LAM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otomire omorero korwa igoro osambire amauga aane oyabuire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.13",
            "verseOrgIds": [
              "LAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otegire oboreba",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.13",
            "verseOrgIds": [
              "LAM.1.13"
            ]
          }
        },
        {
          "text": "ase amagoro aane;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.13",
            "verseOrgIds": [
              "LAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ong’iranirie magega;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.13",
            "verseOrgIds": [
              "LAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ontigire inde bosa, ntari ne chinguru nde n’obororo omobaso boira.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.13",
            "verseOrgIds": [
              "LAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nigo abarete amamocho aane onsi akayasangereria amo akayasiba ase ebigoti biane buna rikorogoto,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.14",
            "verseOrgIds": [
              "LAM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase enchera eyio akang’uura chinguru ase oborito bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.14",
            "verseOrgIds": [
              "LAM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo ambegete ase amaboko ay’abwo ntanyare kobua.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.14",
            "verseOrgIds": [
              "LAM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omonene bwangire abanto bonsi chituoni, abamenyete ime yane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "orangeirie omosangererekano bw’abaanto,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde osenyente abamura bane.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abayuda abwo banga buna omoiseke omwekuungi,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene obatiringeire inse,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babeire buna amasabibu agotiringwa ase ekemitero.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ase engencho y’amang’ana aya nigo nkorera,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaiso aane nigo akoiyeria amariga,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio okondemia nigo are aare korwa ase ’nde,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio okong’a chinguru chinyia;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abana bane batigaire bare boka,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ababisa bane bambuire.”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
