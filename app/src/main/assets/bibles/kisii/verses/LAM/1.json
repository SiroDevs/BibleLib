          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bonsi b’omochie nigo baumatete,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.11",
            "verseOrgIds": [
              "LAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero barigereretie endagera;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.11",
            "verseOrgIds": [
              "LAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "barabwo baoonirie chinibo chiabo bagore endagera barie,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.11",
            "verseOrgIds": [
              "LAM.1.11"
            ]
          }
        }
