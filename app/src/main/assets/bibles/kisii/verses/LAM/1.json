  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "LAM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Emechando ya Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki omochie oyo otigaire bosa, oyio orenge oichire n’abanto!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.1",
            "verseOrgIds": [
              "LAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki otigaire buna omokungu omotakanwa",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.1",
            "verseOrgIds": [
              "LAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio orenge omonene ase egati y’ebisaku!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.1",
            "verseOrgIds": [
              "LAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oyio orenge buna eting’ana ase egati-gati y’emechie,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.1",
            "verseOrgIds": [
              "LAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono obeire omosomba ase emechie ende.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.1",
            "verseOrgIds": [
              "LAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo okorera nobororo botuko bokia,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.2",
            "verseOrgIds": [
              "LAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amariga nigo agoiteka ase chimboto chiaye;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.2",
            "verseOrgIds": [
              "LAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase abanchi baye bonsi onde tari okomoremia;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.2",
            "verseOrgIds": [
              "LAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abasani baye bamong’ainire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.2",
            "verseOrgIds": [
              "LAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babeire ababisa baye.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.2",
            "verseOrgIds": [
              "LAM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda bairirwe ase obosomba,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.3",
            "verseOrgIds": [
              "LAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babeire nemechando na obokong’u batari gotimoka.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.3",
            "verseOrgIds": [
              "LAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bamenyete ase egati y’abanto b’ebisaku;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.3",
            "verseOrgIds": [
              "LAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abakobabwatia baabaikereire kobare nemechando.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.3",
            "verseOrgIds": [
              "LAM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinchera chikogenda Sayoni nigo chiichanete,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.4",
            "verseOrgIds": [
              "LAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera onde tari ogocha ase Amatuko Amanene achiikire;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.4",
            "verseOrgIds": [
              "LAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebiita biaye bionsi nigo bitigarete bosa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.4",
            "verseOrgIds": [
              "LAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abakuani baye bonsi nigo baichanete.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.4",
            "verseOrgIds": [
              "LAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abaiseke baye abekungi nigo baumatete,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.4",
            "verseOrgIds": [
              "LAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omochie omonyene nigo ore nobororo obonge.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.4",
            "verseOrgIds": [
              "LAM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa baye babeire abanene baye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.5",
            "verseOrgIds": [
              "LAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ababisa baye nigo bagendererete goseseneka.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.5",
            "verseOrgIds": [
              "LAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene oyotomeire emechando ase engencho y’ogosaria kwaye okonge,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.5",
            "verseOrgIds": [
              "LAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ababisa baye bairire abana baye ase obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.5",
            "verseOrgIds": [
              "LAM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosikwa gwonsi kwarure ase abanto ba Sayoni;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.6",
            "verseOrgIds": [
              "LAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abagaambi baye babeire buna chingabi chitabwati ase chikorisia;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.6",
            "verseOrgIds": [
              "LAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batamire korwa ase abakobabwatia, tibari ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.6",
            "verseOrgIds": [
              "LAM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanto ba Yerusalemu baarenge nemechando na obokong’u,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.7",
            "verseOrgIds": [
              "LAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakaba bakoinyora ebinto ebiya mono baarenge nabio ase amatuko a kare.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.7",
            "verseOrgIds": [
              "LAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Agwo ekero bagwete ase amaboko y’abachandi,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.7",
            "verseOrgIds": [
              "LAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onde tarenge ore kobakonya,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.7",
            "verseOrgIds": [
              "LAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abachandi babo bakobachecheria ase engencho y’okogwa kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.7",
            "verseOrgIds": [
              "LAM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ba Yerusalemu bakorire ebibe ebinene;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.8",
            "verseOrgIds": [
              "LAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio babeire okogechia,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.8",
            "verseOrgIds": [
              "LAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bonsi abaabasigete baabachayire,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.8",
            "verseOrgIds": [
              "LAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera barorire obogetirianda bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.8",
            "verseOrgIds": [
              "LAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, omochie omonyene nkweumia ore,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.8",
            "verseOrgIds": [
              "LAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bweonchoire gochia magega.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.8",
            "verseOrgIds": [
              "LAM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riko riaye nigo riarenge ase chianga chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.9",
            "verseOrgIds": [
              "LAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tarengereretie igoro y’omoerio oye.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.9",
            "verseOrgIds": [
              "LAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio okogwa kwaye gokaba ogw’okoondokia,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.9",
            "verseOrgIds": [
              "LAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tarenge nonde okomoremia.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.9",
            "verseOrgIds": [
              "LAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Aye Omonene, rigereria emechando yane,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.9",
            "verseOrgIds": [
              "LAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera omobisa one ngwetogia are!”",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.9",
            "verseOrgIds": [
              "LAM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobisa oyio oramboire amaboko aye",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.10",
            "verseOrgIds": [
              "LAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gochia gosakora ebinto bionsi bi’erigori rinene bire ase omochie ime;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.10",
            "verseOrgIds": [
              "LAM.1.10"
            ]
          }
