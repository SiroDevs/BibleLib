      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo aye Omonene gwakanete ng’a tibasoa ase omosangererekano oo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.10",
            "verseOrgIds": [
              "LAM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
