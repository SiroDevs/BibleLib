              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nkaroberia ng’a chinko chi’ogosambera ebing’wanso chirentwe ase chingaki chichikiire, na amatunda ’okwama kw’eritang’ani arentwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
