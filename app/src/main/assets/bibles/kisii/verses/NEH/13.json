          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase enchera eyio nkabachena korwa ase kera egento kiarenge ekegeni, nkaroberia emeremo y’abakuani, na ey’Abalawi ekorwe boronge, erinde kera omonto amanye omoremo oye.",
          "type": "text",
          "attrs": {
