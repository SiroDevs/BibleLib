          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiombe binde bi’Abalawi ebiamenyete ase ense y’Abayuda bikaba bikobarwa amo nabaanto ba Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
              "NEH.11.36"
            ]
