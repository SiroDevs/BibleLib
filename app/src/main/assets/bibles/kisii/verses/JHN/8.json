{
  "id": "JHN.8",
  "number": "8",
  "bookId": "JHN",
  "reference": "Yohana 8",
  "copyright": "© 2021 KENBS",
  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JHN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omokungu obwatetwe ase obotomani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yeso akagenda ase egetunwa ki’Emezeituni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambia chuni agasoa naende Hekalu ime. Abanto bonsi bakamochiera, na ere agaikaransa, akaborokereria.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.2",
            "verseOrgIds": [
              "JHN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aborokia b’amariiko na Abafarisai bakarenta omokungu obwatetwe ase obotomani. Kabamobekire gati‐gati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.3",
            "verseOrgIds": [
              "JHN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakamoteebia, “Omworokia, omokungu oyo nigo abwatwa kagokora obotomani.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.4",
            "verseOrgIds": [
              "JHN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ase amachiiko Musa atochigeete kobaaka amagena abakungu banga buna oyo, naki aye ogoteeba igoro asare?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.5",
            "verseOrgIds": [
              "JHN.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagateeba ring’ana eri ase okomoteema, banyore enchera bakomosoera. Korende Yeso agekumba, akarika nekiara kiaye inse.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo kobamentire komoboria, akagororoka, akabateebia, “Ere oyotari nebibe ase egati yaino abe oyo bw’eritang’ani komoruta rigena.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.7",
            "verseOrgIds": [
              "JHN.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agekumba naende, akarika nekiara kiaye inse.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.8",
            "verseOrgIds": [
              "JHN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bagachia koyaigwa, bagasoka oyomo ase oyomo, abagaaka nabwo bachaagete. Yeso bweka agatigara, na omokungu oria oteneine gati‐gati.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.9",
            "verseOrgIds": [
              "JHN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akagororoka tarora monto onde otatiga omokungu oria, akamobooria, “Omokungu, ng’ai abasoeri bao bare? Onde tari ogokogambia?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.10",
            "verseOrgIds": [
              "JHN.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamoiraneria, “Onde tari, Omonene.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yeso akamoteebia, “Na inche tingokogambia. Genda, korende tokora ebibe naende.”]",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobaso bw’ense",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso agakwana nabarabwo naende, akabora, “Inche nomobaso bw’ense; oyogontunyana takogenda ase omosunte, korende nabe nomobaso bw’obogima.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.12",
            "verseOrgIds": [
              "JHN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Abafarisai bakamoteebia, “Aye nigo okwebera kirori omonyene, na oborori bwao tibori obw’ekeene.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.13",
            "verseOrgIds": [
              "JHN.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akairaneria, “Nonya ngwekwana inche omonyene, oborori bwane nobw’ekeene, ekiagera namanyire aase narure, na aase nkogenda; korende inwe timomanyeti aase narure, gose aase ngochia.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.14",
            "verseOrgIds": [
              "JHN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe nigo mokogambia ase okobwatia amang’ana a Mwanyabaanto; inche tindi kogambia omonto.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.15",
            "verseOrgIds": [
              "JHN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende ninsa kogamba, okogamba kwane nogw’ekeene, ekiagera tari inche bweka nkogamba, korende ninche na Tata oyontomete.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.16",
            "verseOrgIds": [
              "JHN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende ase amachiiko aino nigo ariikire ng’a oborori bw’abaanto babere nobw’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.17",
            "verseOrgIds": [
              "JHN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ninche nkweorokia omonyene, nere Tata oyontomete nigo akong’orokia.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.18",
            "verseOrgIds": [
              "JHN.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bakamobooria, “Ng’ai Iso are?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yeso akairaneria, “Timokomanya inche, nonya n’Tata timokomomanya, onye momanyete inche, anga mwamomanyire na Tata one.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana aya Yeso nigo ayakwanete, gakworokereria ase Hekalu, ase enyomba y’ekebekerero gi’esadaka; omonto tari omobwatete, ekiagera ensa yaye konya teraika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ekiina kegochia komonyoora Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabateebia naende, “Inche nkogenda nde, na inwe namondigie, namokwe ase ebibe biaino; aase nkogenda inche, timokonyara gochao.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.21",
            "verseOrgIds": [
              "JHN.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayahudi bakaboora, “Inee! Nigo areite, ekiagera akobora: Aase nkogenda inche, timokonyara gochao?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.22",
            "verseOrgIds": [
              "JHN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Inwe naba inse; inche noyo o igoro; inwe nab’ense eye; inche tindi oyo bw’ense eye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.23",
            "verseOrgIds": [
              "JHN.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio nabateebia ng’a namokwe ase ebibe biaino. Onye timokwegena ng’a inche nere, namokwe ase ebibe biaino.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.24",
            "verseOrgIds": [
              "JHN.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bakamobooria, “Naye ng’o?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yeso akabairaneria, “Nonya nayio nabateebirie inwe korwa omochakano.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninde namange ngokwana na kogamba ase engencho yaino, korende ere oyontomete noyo bw’ekeene; na inche aya naigwete korwa asare, naro nkoorokia ase ense.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.26",
            "verseOrgIds": [
              "JHN.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibamanya ng’a nigo are gokwana ase bare aya Ise.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.27",
            "verseOrgIds": [
              "JHN.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yeso akabateebia, “Ekero mwakoorire koimokereria igoro Omwana‐o‐mwanya banto, erio namomanye ng’a ninche ere, naende tindi gokora kende ase okobua kwane omonyene, korende buna Tata anyorokereretie, nabo ngokwana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.28",
            "verseOrgIds": [
              "JHN.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere oyontomete nigo are amo nainche, tantigeti inche bweka, ekiagera botambe nigo ngokora ayakomogwenera.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.29",
            "verseOrgIds": [
              "JHN.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakwanire aya, abange bakamwegena.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoengererania n’Abayahudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Yeso agateebia Abayahudi baria bamwegenete, “Komoramenye ase ring’ana riane, nigo more aborokigwa baane b’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.31",
            "verseOrgIds": [
              "JHN.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende namomanye ekeene, na kerokio nakebasibore.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.32",
            "verseOrgIds": [
              "JHN.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoiraneria, “Igo tore oroiboro rwa Aburaamu, na titoraba abasomba b’omonto kero kende gionsi, inaki rende ogoteeba: Namokorwe abasibore?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.33",
            "verseOrgIds": [
              "JHN.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabairaneria, “Ekeene, ekeene, nabateebirie: Onde bwensi ogokora ebibe, oyio nomosomba bw’ebibe,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.34",
            "verseOrgIds": [
              "JHN.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende omosomba tari komenya nyomba botambe, korende omobiare nigo akomenya botambe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.35",
            "verseOrgIds": [
              "JHN.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki Omwana karabasibore, namobe abasibore kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.36",
            "verseOrgIds": [
              "JHN.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namanyire ng’a nigo more oroiboro rwa Aburaamu; korende nigo mokorigia kong’ita, ekiagera ring’ana riane tirinyoreti ibaga ime yaino.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.37",
            "verseOrgIds": [
              "JHN.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya narorire ase Tata naro ngokwana; nainwe naboigo ayamwarorire ase iso oino, naro mogokora.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoiraneria, “Tata oito nere Aburaamu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yeso akabateebia, “Onye nabana ba Aburaamu mware, anga mwakora emeremo ya Aburaamu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende bono morigetie kong’ita, ninche oyo nabateebirie ekeene keria naigure korwa ase Nyasae. Aburaamu takorete igo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.40",
            "verseOrgIds": [
              "JHN.8.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe nigo mogokora emeremo ya iso oino.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Bakamoteebia, “Intwe titoiboiri ase obonyaka; nigo tore na Tata oyomo, nere Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabateebia, “Onye Nyasae n’Iso oino are, anga imonyanchete inche; naki narure ase Nyasae, na igo nachire; gose tinyerenteti inche omonyene, korende nere ontomire.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.42",
            "verseOrgIds": [
              "JHN.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki motamanyeti amang’ana aane aya ngokwana? Nekiagera motancheti koigwa ring’ana riane.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.43",
            "verseOrgIds": [
              "JHN.8.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe n’aba iso oino Saitani, na ogwancha kwaino nogokora okogania gwa iso. Ere nigo arenge omoiti korwa omochakano, gose tatenenete ase ekeene, ekiagera ekeene tikeri ime yaye. Kagokwana oborimo, nigo agokwana ayare ayaye omonyene, ekiagera nomonyaborimo, na ise bw’oborimo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.44",
            "verseOrgIds": [
              "JHN.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera inche ngokwana ekeene, timori konyegena.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.45",
            "verseOrgIds": [
              "JHN.8.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o ase egati yaino okong’orokia ng’a ninde nebibe? Kongokwana ekeene, naki inwe motakonyegena?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.46",
            "verseOrgIds": [
              "JHN.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyore o Nyasae nigo akoigwa amang’ana a Nyasae; nakio gekogera inwe motari koyaigwa: nekiagera motari aba Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayahudi bakamoiraneria, “Titori gokwana boronge ng’a aye nigo ore Omosamaria, naende nigo obwatire nekerecha?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.48",
            "verseOrgIds": [
              "JHN.8.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akairaneria, “Inche timbwatiri nekerecha, korende nigo nsigete Tata one, na inwe timonsigeti.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.49",
            "verseOrgIds": [
              "JHN.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche tindi korigia obonene bwane; nare oyomo oyokoborigia, nere orabe omogambi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.50",
            "verseOrgIds": [
              "JHN.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, ekeene, nabateebirie: Omonto karabwate ring’ana riane, takorora amakweri nonya ng’ake.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.51",
            "verseOrgIds": [
              "JHN.8.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Abayahudi bakamoteebia, “Bono twamanyire ng’a nigo obwatire nekerecha, Aburaamu okuure, na ababani, na aye nigo ogoteeba: Omonto karabwate ring’ana riane, takoigwa amakweri nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.52",
            "verseOrgIds": [
              "JHN.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nomonene kobua sokoro yaito Aburaamu, oyo okuure? Naende nababani bakuure. Naye kogwekora obe ng’o?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akairaneria, “Kondetogie inche omonyene, obonene bwane tibori gento; oyogontogia n’Tata one, oyo mogoteeba ng’a nere Nyasae oino.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.54",
            "verseOrgIds": [
              "JHN.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inwe timomanyeti, korende inche nimomanyete. Kondatebe ng’a timomanyeti nimbe omonyaborimo buna inwe, korende nimomanyete, naende ring’ana riaye nindibwatete.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.55",
            "verseOrgIds": [
              "JHN.8.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburaamu sokoro yaino nigo agogete ng’a nanyare korora rituko riane; akarirora, akagoka.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.56",
            "verseOrgIds": [
              "JHN.8.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Abayahudi bakamoteebia, “Torakoora emiaka emerongo etano, na Aburaamu kwamororire?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.57",
            "verseOrgIds": [
              "JHN.8.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JHN 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabateebia, “Ekeene, ekeene, nabateebirie: Ritang’ani Aburaamu atarabao, inche nao naare.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.58",
            "verseOrgIds": [
              "JHN.8.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JHN 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bakaimokia amagena bamorute, korende Yeso akebisa, agasoka korwa ase Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.59",
            "verseOrgIds": [
              "JHN.8.59"
            ]
          }
        }
      ]
    }
  ],
