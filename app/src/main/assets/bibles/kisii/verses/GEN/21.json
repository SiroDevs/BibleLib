              "type": "text"
            }
          ]
        },
        {
          "text": "Aburaamu agasimeka omote onga buna ekerachuoki aria Beeri‐Seba, na agwo akarangeria erieta ria Nyasae Omonene o kare na kare ase okomosasiima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
