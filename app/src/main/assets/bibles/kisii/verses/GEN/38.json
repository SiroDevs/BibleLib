  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "GEN 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abana ba Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaba ase engaki eria Yuda agatigana n’abamwabo, agatirimboka, agaika ase omonto gete Omoadulamu ore korokwa Hira, bakabwatana nere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroro Yuda akarora moiseke o Sua, omoiseke bw’Omokaanani gete, akamonyuoma. Bakaba bakorara amo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na moiseke o Sua akaba morito, akaibora omwana omoisia, akamoroka Eri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende akaba morito, akaibora omwana omoisia, akamoroka Onani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba morito naende, akaibora omwana omoisia, akamoroka Sela. Yuda nere nao areenge aria Kisibo ekero amoiborerete abana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yuda akanyuomeria Eri, omwana oye omotangi, omokungu ore korokwa Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nere Eri, omomura omotangi o Yuda, nigo areenge omobe ase obosio bw’Omonene; ase ayio Omonene akamoita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yuda agateebia Onani: “Motware moka momura omino, erinde omotenenerie egesaku.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Onani akamanya ng’a abana abwo agochia koibora tibari gochia korokwa abaye. Kera engaki, arekoba na moka momura omwabo, ekero embego y’oroiboro ere nchera gocha, asomora aitera inse, ng’a erio tabaisa goteneneria oyomwabo egesaku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio akorete akaba amabe ase obosio bwa Nyasae Omobui, nere Omonene akamoita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yuda agateebia Tamari, moka momura oye: “Genda omenye buna omoboraka ase omochie o iso goika Sela omwana one akine”; naki nigo oboete ng’a nere nabaise gocha gokwa, buna abamwabo bakwete. Ase igo, Tamari akagenda akamenya o ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okomocha kwa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega ya amatuko make, moiseke o Sua, moka Yuda, agakwa; Yuda gakoorire okomoreera, agatiira gochia Timuna ase abanachi amarionya be ching’ondi chiaye, amo nomosani oye Hira Omoadulamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.12",
            "verseOrgIds": [
              "GEN.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Tamari ateebetigwe ng’a ise biara ’nkogenda akare Timuna konacha ching’ondi chiaye amarionya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.13",
            "verseOrgIds": [
              "GEN.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akarusia chianga chiaye chi’ogokobania, akeboyia chianga na gwetuba obosio bwaye, agaikaransa geita ki’Enaimu, ang’e nenchera ekogenda Timuna; naki nigo arooche ng’a Sela obeire omonto omonene, na tamoeiri amotware.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.14",
            "verseOrgIds": [
              "GEN.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yuda amorooche, agakaga ng’a nomokuungu omotayayi, ekiagera nigo atubete obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.15",
            "verseOrgIds": [
              "GEN.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akagobera gochia asare enchera ensemo, akamoteebia: “Inyanchere ’mbe naye,” naki tamanyete gose moka momura oye orenge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Tamari akamobooria: “Inki orang’e, erinde osoe ase ’nde?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamoiraneria: “Ninche ngotomera emaanwa egoree korwa ase riicho riane.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Omokungu oria akamobooria: “Inee! Inki orang’e kebe intenenera goika kwayentomeire?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamobooria: “Ngento ki origetie nkoe kebe intenenera?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Akamoiraneria: “Ebonyi yao ere nekemanyererio, na orokini rwao, na enyimbo yao obwate koboko.” Erio akamobia, akaraara nere, na ere akaba morito.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio akaimoka akagenda, akarusia egietubo, akabeeka chianga chiaye chi’ogokobania.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akaa omosani oye Omoadulamu emaanwa egoree airere omokungu oria, erinde ere airanie ebinto biria amoete bibe intenenera, korende tamonyora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoadulamu oria akabooria abanto b’aase aria: “Ng’ai are omokungu oria omotayayi, oyorenge aa Enaimu enchera ensemo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Bakamokania: “Omokungu omotayayi tana koba aa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo, akairana gochia ase Yuda, akabateebia: “Timonyoreti; naboigo nonya nabaanto b’aase aria nigo bankania ng’a mokuungu motayayi tana kobao.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akabora: “Tiga atware ebinto ebio namoete bibe intenenera, titobaisa gocha kororekana nobosooku. Rora, namotomerete emaanwa egoree, na aye tikwamonyorete.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaba magega y’emetienyi etato Yuda ateebetigwe ng’a Tamari, moka momura oye, okorire obotomani bw’obotayayi; amo nayio morito are ase obotayayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Erio Yuda akabora: “Mosokie isiko, asambwe nomorero.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gasokiigwe isiko agatoma abanto ase ise biara, bamoteebie: “Omonto omonyene ebinto ebi, nere ong’ete oborito obo.” Naende akabora: “Manya ebonyi eyio ere nekemanyererio, na orokini oro, na enyimbo eye, gose nebiang’o.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yuda akabimanya, akabora: “Ere nomooronge kombua, nigo akora ayio, ekiagera ntamoete Sela, omwana one, amotware.” Erio Yuda tarara nere naende.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero engaki yaye y’okoibora yachia goika, akarorekana ore ne chibarongo enda yaye ime.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero areenge koibora, omwana oyomo agatang’ania okoboko isiko, na omoiboria akamosibera okoboko okwo eusi embariri, agateeba: “Oyo nere otanga gosoka isiko.”",
