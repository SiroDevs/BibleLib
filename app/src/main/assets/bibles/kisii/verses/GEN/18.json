              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburaamu akamobooria naende: “Omonene, tobaisa kombea, bono ndimo rioka ngokoboria, barachia konyorekana rende ikomi boka?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
