      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Nyasae akairaneria: “Tingosaria omochie, inse konyora agwo ikomi boka.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
