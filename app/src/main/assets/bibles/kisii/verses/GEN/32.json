          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo Akaaroka aase aria Penieli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "text": ", naki nigo ateebete: “Naroranire na Nyasae obosio ase obosio, na obogima bwane bwatoorigwe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erioba rikaorokera Yakobo kagoeta Penueli, akaba ogosegora, ekiagera ateng’eretigwe enengo y’ebachwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio Abaisraeli tibari koria omoki bw’enengo y’ebachwa goika reero iga, ekiagera omonto oria namoteng’eretie Yakobo omoki bw’enengo y’ebachwa yaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
