  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "GEN 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Israeli na abana baye bakomenya Goseni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yusufu akagenda agateebia Farao: “Tata na bamura baminto bachire korwa ase ense ya Kaanani, amo ne chitugo chiabo, ching’ondi ne chiombe, na binde bionsi bare nabio; barabwo nao bare ase ensemo ya Goseni.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agachora abamwabo batano, akabaira ase obosio bwa Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akababooria: “Emeremo yaino nereri?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Bakamoiraneria, “Intwe abasomba bao nigo tore abarisia be chitugo, buna nechisokooro chiaito chiareenge.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende bakabateebia: “Nigo twachire tobe abamenyi b’ense eye, ekiagera intwe, abasomba bao, titori nase tokorisia amaicho aito, ekiagera enchara nenene mono ase ense ya Kaanani. Ase igo, koranche otoe intwe, abasomba bao, ribaga tomenye ase ensemo ya Goseni.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.4",
            "verseOrgIds": [
              "GEN.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Farao agakwana na Yusufu, akabateebia: “Narorire ng’a iso na abamino bagocheire.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.5",
            "verseOrgIds": [
              "GEN.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ense ya Misiri nigo ere ase obosio bwao; bae iso na bamura bamino ribaga bamenye aase are aagiya. Tiga bamenye ase ensemo ya Goseni, naende onye komanyete bande ase egati yabo abamanyete mono emeremo y’obotugi, obabeeke babe abateneneri ase chitugo chiane.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yakobo ase obosio bwa Farao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yusufu akarenta Yakobo ise, akamoira ase obosio bwa Farao; na Yakobo agasesenia Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.7",
            "verseOrgIds": [
              "GEN.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akabooria Yakobo: “Inee! Emiaka yao nerenga?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.8",
            "verseOrgIds": [
              "GEN.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akamoiraneria: “Emiaka yane nakoorire ase ense eye nerigana erimo, na emerongo etato (130). Ase obogima bwane nigo nabeire nobokong’u, naende emiaka yane nemeke, teikereti eye chisokoro chiane chiakorete ase obogima bwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.9",
            "verseOrgIds": [
              "GEN.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo agasesenia Farao naende, akarua ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.10",
            "verseOrgIds": [
              "GEN.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu akaa ise amo na bamura bamwabo aase bakomenya, akabaa Ramesesi, orogongo oruya, ensemo engiya mono y’ense eria, buna Farao achiigete.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.11",
            "verseOrgIds": [
              "GEN.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nere Yusufu akaba okorenda ise amo nabamwabo bonsi, akabaa endagera buna kera omonto abwate abanto baye bang’ana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.12",
            "verseOrgIds": [
              "GEN.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Enchara ekomentekana, n’Abamisiri koonigwa ase Farao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ase ense yonsi endagera tiyareengeo; na enchara nigo yareenge endito mono, konya yanyarire abanto ba Misiri na Abakaanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.13",
            "verseOrgIds": [
              "GEN.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu agasangereria chitaabu chionsi echianyorekanete korwa ase ense ya Misiri na eya Kaanani ase okooneria abanto endagera, agachibeeka ase ekungo ya Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.14",
            "verseOrgIds": [
              "GEN.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero chitaabu chionsi chiaerire ase ense ya Misiri na ase ense ya Kaanani, Abamisiri bagachiera Yusufu, bakamosaba, “Toe endagera, titobaisa gokwera ase obosio bwao, ekiagera chitaabu chiaito chiaerire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.15",
            "verseOrgIds": [
              "GEN.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu akabairaneria, “Onye chitaabu chiaino chiaerire, ndetera chitugo chiaino, na inche mbae endagera morie.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.16",
            "verseOrgIds": [
              "GEN.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bakarentera Yusufu chitugo chiabo, na Yusufu akabaa endagera. Bakarentera Yusufu chibarasi chiabo, ne ching’ondi, ne chiombe, ne chitigere. Igo akaba okobarenda na kobaa endagera ase omwaka oyio oyomo, na barabwo bakamoa chitugo chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.17",
            "verseOrgIds": [
              "GEN.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwaka oria oyomo okaera. Naende omwaka o kabere bakamochiera, bakamoteebia: “Titokonyara gokobisa, Omonene oito, ng’a chitaabu chiaito chiaerire, ne chitugo chiaito chiabeire echiao. Titotigareti gento kende togokoa, omonene oito, otatiga emebere yaito na amaremo aito.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.18",
            "verseOrgIds": [
              "GEN.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki torakwere ase obosio bwao, na amaremo aito asareke? Togore intwe, ogore na amaremo aito, na intwe tobe abasomba ba Farao, na amaremo aito abe ayaye. Toe chimbusuro tosimeke, titokwa, na amaremo aito abe bosa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.19",
            "verseOrgIds": [
              "GEN.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yusufu akagorera Farao amaremo onsi areenge Misiri, naki Abamisiri nigo baoonetie kera omonto oboremo bwaye, ekiagera enchara yareenge endito mono. Naboigo ense ekaba eya Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.20",
            "verseOrgIds": [
              "GEN.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akang’anyia abanto abwo bamenye ase emechie, babe abasomba baye, bakore emeremo korwa ensemo eyemo ya Misiri goika eyende.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.21",
            "verseOrgIds": [
              "GEN.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yusufu tagorete amaremo ’abakuani, ekiagera abwo konya bachikeirwe endagera baare konyora korwa ase Farao, nero baare koria. Ase igo, tibagwenerete koonia amaremo abo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.22",
            "verseOrgIds": [
              "GEN.47.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu agateebia abanto: “Igwa! Reero nabagorire inwe amo namaremo aino, mobe enibo ya Farao. Bwata chimbusuro chiaino echi, chiire mochisimeke ase emegondo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.23",
            "verseOrgIds": [
              "GEN.47.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 47:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engaki ye rigesa moruserie Farao ensemo ya isano. Chinsemo inye chintigari inachibe echiaino ase chimbusuro na endagera yaino inwe abanyene, na ey’abare ase chinka chiaino, na ey’abana baino.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.24",
            "verseOrgIds": [
              "GEN.47.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 47:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo bakamoiraneria, “Gwatooririe obogima bwaito. Onye twanyorire ogwancherwa ase obosio bwao, Omonene oito, tiga tobe abasomba ba Farao.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu akabeeka ogochika ase ense ya Misiri, ng’a ensemo ya isano ebe eya Farao; na ogochika okwo ngokora kore emeremo nonya ngoika bono. Korende amaremo ’abakuani oka naro atabeete aya Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okogania kw’omoerio kwa Yakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli na abana baye bakaba bakomenya ase ense ya Misiri, ensemo ya Goseni, bakayeira ekaba eyabo, bakamenteka na kobucha mono.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akamenya ase ense ya Misiri emiaka ikomi, na etano na ebere. Ase igo, agakoora emiaka rigana erimo, na emerongo ene, na etano na ebere (147) ase obogima bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 47:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero engaki y’ogokwa gwa Israeli yabeete ang’e, ere akarangeria Yusufu, omwana oye, akamoteebia, “Onye nkonyora ogwancherwa ase obosio bwao, beeka okoboko kwao inse y’ekebono kiane, na ondiere eira, ng’a nonkorere amaabera na obwanchani. Tontindeka aa ase ense ya Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende ekero ndakwe, tiga ndare ne chisokoro chiane. Ombogorie korwa aa Misiri, ontindeke aase barabwo batindegetwe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yusufu akamoiraneria, “Ninkore buna gwantebirie.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
