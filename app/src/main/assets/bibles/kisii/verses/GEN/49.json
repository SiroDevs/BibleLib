          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dani nabe eng’iti ekweriba inchera,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ring’ere ase oboeto,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rikoroma egetingiro ki’ebarasi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika oyoyeriinete agwe masogota.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ninganyete ogotooreka kwao nogosemeria!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.18",
            "verseOrgIds": [
              "GEN.49.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gadi namigwe nemeganda y’abauri,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.19",
            "verseOrgIds": [
              "GEN.49.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende nere nabamige korwa magega.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.19",
            "verseOrgIds": [
              "GEN.49.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aseri natware endagera y’obonoru,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.20",
            "verseOrgIds": [
              "GEN.49.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "narue endagera engiya eragwenere abarwoti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.20",
            "verseOrgIds": [
              "GEN.49.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nafutali nengabi esiboire ekominyoka mono,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.21",
            "verseOrgIds": [
              "GEN.49.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ekobiara chimanwa chingiya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.21",
            "verseOrgIds": [
              "GEN.49.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yusufu nomote omorere okwama ang’e nensoko;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.22",
            "verseOrgIds": [
              "GEN.49.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinsagia chiaye nigo chikoranda enyasi igoro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.22",
            "verseOrgIds": [
              "GEN.49.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 49:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaruti emegwe bakomoimokera ase okomogwera n’bororo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.23",
            "verseOrgIds": [
              "GEN.49.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakomoruta emegwe na komoorosia,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.23",
            "verseOrgIds": [
              "GEN.49.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 49:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende obota bwaye tibogosukigwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amaboko aye nigo are ne chinguru, naende namaango,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goetera ase amaboko ’Omonyene Chinguru o Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyore Omorisia na Egetare gia Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 49:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae o iso, nere oragokonye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae Omobui, nere oragosesenie",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nogosesenigwa gokorwa igoro,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogosesenigwa gokorwa chindiba inse,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogosesenigwa gokorwa inda na ase chimbeere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 49:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosesenigwa gwa iso nkore ne chinguru",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngoetanetie okw’ebitunwa bia kare,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obonene bw’ebigoro bia kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ogosesenigwa okwo kobe egutwa ase omotwe o Yusufu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igoro y’egiototeri ki’oyore omogambi ase egati y’abamwabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Benjamini n’eseese y’orosana ekoria mono,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "engaki ya mambia yaria ebi’obotwari bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na engaki ya mogoroba bwatanana ebiasakoire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nabio ebisaku bia Israeli ikomi na bibere; naya naro ise abateebetie ekero are kobasesenia na koa kera oyomo ogosesenigwa kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokwa kwa Yakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Israeli akabachiika, akabora: “Inche nkoirwa inde gosangererekana amo nabaanto baane. Montindeke ase chisokoro chiane chiatindegetwe ase rikuruma ri’oboremo bware bw’Efuroni Omohiti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "rikuruma eri rire ase oboremo agwo Makipela, moocha ya Mamure, ase ense ya Kaanani. Oboremo boria Aburaamu agorete korwa ase Efuroni Omohiti bobe aase ogotindeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo nao Aburaamu atindegetwe ase Sara mokaye ensemo; agwo nao Isaka na Rebeka mokaye batindegetwe, na agwo inche omonyene natindegete Lea.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboremo obwo amo ne rikuruma riria nigo biagoretwe korwa ase Abahiti.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yakobo akoorete gochiika abamura baye amang’ana aya, akaimokia amagoro aye, akayabeeka borere igoro; erio agakwa, erio agasangererekana amo nabaanto baye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
          }
        }
      ]
    }
  ],
