{
  "id": "GEN.49",
  "number": "49",
  "bookId": "GEN",
  "reference": "Omochakano 49",
  "copyright": "© 2021 KENBS",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "GEN 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yakobo ogosesenia abana baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yakobo akarangeria abamura baye, akabateebia: “Sangererekana aa ase ’nde, mbateebie amang’ana arabanyore ase amatuko agochi‐gocha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inchuo montegerere, inwe abana ba Yakobo; montegerere inche Israeli iso.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rubeni, aye nomwana one omotangi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nokobua kwane, na ogotongora gwe chinguru chiane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Noetanetie abamino ase okobua,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nobaetanetie ase chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nkwaberete buna amaache;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende togoetania abande,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nkwarinete borere bwa iso, okabosaria, ase igo okarenta obosooku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Simioni na Lawi naba ng’ina omo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebirwanero biabo nebi’obotindi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoyo one tosoa ase obobisi bwabo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose enkoro yane tesanga ase omosangererekano obo;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naki ase endamwamu yabo mbaitete abanto,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase obomwenu bwabo bakanacha chinteng’e chie chintang’ana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endamwamu yabo eragererigwe, ekiagera nigo yareenge entindi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekeririanda kiabo, ekiagera tikiareenge namaabera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimbaatanane ase abana ba Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbasiarere ase abana ba Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye Yuda, abamino inabagotogie;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okoboko kwao inakobwate ebigoti biababisa bao;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abamura ba iso ng’a batugame bosio bwao na amasikani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, aye nendo ensae.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omwana one, gokorwa gotwara, nigo oratiire,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korara, na gotimoka buna endo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna endo eaberi, ning’o orabe noboremu kogotura?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyimbo y’obogaambi tekorua o Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose omobeeki amachiiko ase ororeeria rwaye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika achiche oyo orabogorie obogaambi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo abanto b’ebisaku bionsi baraigwere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo arasibe etigere yaye ase omote bw’omosabibu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na emori y’etigere yaye ase chinsagia chi’omosabibu omuya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo arasibie egetambaa kiaye akwambara nedivai,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chianga chiaye n’amaache amonyinga y’amasabibu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso aye nigo arabe amabariri ase okonywa edivai,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaino aye abe amarabu ase okonywa amabeere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sabuloni nigo aramenye ase enyancha mbarabare,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo ase chimeeri chigotenenigwa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "orobebe rwaye rosinyane norw’Abasidoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Isakaru netigere ere ne chinguru, ekorara obweri bwe chitugo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.14",
            "verseOrgIds": [
              "GEN.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarora ng’a aase agotimokera naagiya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense eria nero ekomogwenera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase igo, agekumba abogorie egurube,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akerua kogenderera nemeremo emekong’u.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
