          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dani nagambere abanto baye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.16",
            "verseOrgIds": [
              "GEN.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna egesaku ekemo ki’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.16",
            "verseOrgIds": [
              "GEN.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
