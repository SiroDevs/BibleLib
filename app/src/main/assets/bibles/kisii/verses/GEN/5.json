              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Enoku amenyire emiaka emerongo etano nomo, na etano (65), akaibora Metusela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.21",
            "verseOrgIds": [
              "GEN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega y’okoiborwa kwa Metusela, Enoku akaba ogotaara amo na Nyasae ase emiaka amagana atato (300), erio akaba ise bw’abana bande, abamura na abaiseke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase oboamo, Enoku akamenya nemiaka amagana atato, na emerongo etano nomo, ne etano (365),",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.23",
            "verseOrgIds": [
              "GEN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba ogotaara amo na Nyasae. Erio tachikororekana naende, ekiagera Nyasae nigo amoirete.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.24",
            "verseOrgIds": [
              "GEN.5.24"
            ]
          }
        }
      ]
