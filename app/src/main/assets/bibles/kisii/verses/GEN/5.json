          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
        {
          "text": "agateeba: “Oyo nere oratoremie intwe ase emeremo yaito, na obokong’u bwaito, ase riroba eri Omonene aragereretie.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
