            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Silpa, omoiseke omosomba o Lea, nabwo Gadi na Aseri. Aba nabwo abana abamura Yakobo aiboreretwe agwo Padan‐Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokwa kwa Isaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo agaika ase omochie o Isaka ise aaria Mamure, ang’e na Kiriati-Ariba, nao Heburoni, agwo ase Aburaamu na Isaka bamenyete buna abamenyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
