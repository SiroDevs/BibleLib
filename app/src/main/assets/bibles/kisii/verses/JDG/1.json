    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’eamate ya Efraimu tibaabang’anyetie Abakaanani abamenyete ase omochie o Geseri. Ase igo Abakaanani bakagenderera komenya ase egati yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’egesaku gia Sabuloni tibaabang’anyetie abanto bamenyete ase emechie ya Kitironi na Nahalali. Ase ayio Abakaanani baria bakagenderera komenya agwo ase egati yabo, korende bakabetererigwa kobakorera emeremo emekong’u.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’egesaku gi’Aseri tibaabang’anyetie abanto bamenyete ase emechie y’Ako, na Sidoni, n’Alabu, n’Akisibu, na Heliba, n’Afeki, na Rehobu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Abaaseri bagendererete komenya ase egati y’Abakaanani, ababiare b’ense eria, ekiagera barabwo tibang’anyetigwe korwao.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’eamate ya Nafutali tibaabang’anyetie abanto bamenyete ase emechie ya Beti‐Semesi na Beti‐Anati. Ase igo bakaba bakomenya ase egati y’ Abakaanani, ababiare b’ense eria, bakabetereria abanto ba Beti‐Semesi na Beti‐Anati kobakorera emeremo emekong’u.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamori bakamiga abanto b’egesaku gia Dani gochia ense y’ebigoro gose tibaabatigerete ribaga batirimboke gochia ase ense omweya,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaamori bakabwaterera ensemo yabo y’egetunwa kia Heresi, n’Ayaloni, na Shaalabimu, korende abanto b’eamate ya Yusufu bakabaengera, bakababetereria babakorere emeremo emekong’u.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo aase ensinyo ya sugusu ya Sera, orobebe rw’Abaamori rokabeekerwa ase egetirimboko gia Akirabimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        }
