        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ense egwaterwa ebisaku bi’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo n’oro omooroberio buna ebisaku bi’Abaisraeli biramenye: Egesaku gia Dani keegwe orogongo rwa sugusu. Ribebe riabo ribwatie enchera ya Heteloni agwo ase egesoero kia Hamati, rigenderere gochia Hasari‐Enoni, omochie ore ase ribebe ria sugusu ria Damesiki. Orogongo orwo rwa Dani nigo rorabe korwa ensinyo ya moocha y’ense eyio goika ensinyo ya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku gi’Aseri keegwe orogongo rw’aye robebekane norwa Dani korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Nafutali keegwe orogongo rw’aye robebekane norw’Aseri korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Manase keegwe orogongo rw’aye robebekane norwa Nafutali korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Efraimu keegwe orogongo rw’aye robebekane norwa Manase korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Rubeni keegwe orogongo rw’aye robebekane norwa Efraimu korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Yuda keegwe orogongo rw’aye robebekane norwa Rubeni korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Orogongo orwatananetwe ase emeremo gete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo robebekaine norwa Yuda korwa moocha goika bosongo, nigo roratigwe robe aase mokoruera okoruegwa ogochenu. Obogare bwaye nigo borabe obwe chimoti chilifu emerongo ebere na isano (25,000), na obotambe bwaye nigo borabe buna obwa kera egesaku korwa moocha goika bosongo. Gati‐gati y’orogongo orwo aase aachenu nao arabe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo orwo morotige robe orwa Omonene; obotambe bwaye nigo borabe chimoti chilifu emerongo ebere na isano (25,000), na obogare chimoti chilifu ikomi (10,000).",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuani mbanyore orogongo rwabo korwa ase orwo oroochenu. Orogongo rwabo nigo rorabe nobotambe bwe chimoti chilifu emerongo ebere na isano (25,000) korwa moocha goika bosongo, na korwa sugusu goika Irianyi robe chimoti chilifu ikomi (10,000). Aase aachenu a Omonene nigo arabe gati‐gati y’oboremo obwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo orwo nigo rorabe orw’abakuani abwo bachenekire, abwo b’ororeria rwa Zadoki. Abwo nigo babete abegenwa ase ’nde, tibantigete buna Abalawi bande bakorete ekero Abaisraeli basaretie bagantiga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo orwo nigo rorabe aase mokoruera okoruegwa ogochenu aatananire korwa ase ensemo eria ere enchenu. Nigo rorabe oroochenu mono robebekane norw’Abalawi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalawi baegwe orogongo robebekane norw’abakuani; nigo rorabe nobotambe bwe chimoti chilifu emerongo ebere na isano (25,000), na obogare chimoti chilifu ikomi (10,000). Obotambe bwe chingongo chionsi nigo borabe chimoti chilifu, emerongo ebere na isano (25,000) na obogare chimoti chilifu ikomi (10,000).",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo orwo tirobaisa koonigwa gose koonchorerigwa; orogongo orwo rore oruya goetania echinde chionsi tiroegwa onde, ekiagera nigo rore oroochenu ase Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo roratigare rore nobogare bwe chimoti chilifu isano (5,000), na obotambe chimoti chilifu emerongo ebere na isano (25,000), nigo rorabe orw’ abanto bande bonsi, baraagache emechie yabo aroro, naende robe orw’oborisia. Agwo nao omochie omonene oraagachwe gati‐gati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekerengo ki’omochie oyio nigo kerabe iga: Ensemo ya sugusu chimoti chilifu inye, na amagana atano (4,500), na ensemo ya Irianyi chilifu inye, na amagana atano (4,500), na ensemo ya moocha chilifu inye, na amagana atano (4,500), na ensemo ya bosongo chilifu inye, na amagana atano (4,500).",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omochie oyio nigo orabe namarisio buna iga: Oborisia bwa sugusu nigo borabe obw’ekerengo gie chimoti amagana abere, na emerongo etano (250), na obwa Irianyi amagana abere, na emerongo etano (250), na obwa moocha amagana abere, na emerongo etano (250), na obwa bosongo amagana abere, na emerongo etano (250).",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo orwo roratigare robebekaine na roria oroochenu, nigo rorabe orw’ekerengo gie chimoti chilifu ikomi (10,000) gochia moocha, na chilifu ikomi (10,000) gochia bosongo. Endagera erame aroro nigo erabe ey’abwo barabe bagokora emeremo ase omochie oyio ime.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori emeremo b’omochie oyio b’ebisaku bi’Abaisraeli mbabe bakorema orogongo orwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo roria rwonsi oroochenu nigo rorabe orw’ekerengo gie chimoti chilifu emerongo ebere na isano (25,000), chinsemo chionsi nigo chirabe chireng’aine. Oro narwo orogongo oroochenu amo norw’omochie oyio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orogongo roratigare robebekaine na roria oroochenu amo norw’omochie ase kera ensemo nigo rorabe orw’omogaambi. Chingongo echio nigo chirachakere iga: Oromo korwa ase orogongo roria oroochenu rw’ekerengo gie chimoti chilifu emerongo ebere, na isano (25,000), rogenderere gochia moocha koreng’ana ne chingongo chiria chi’ebisaku, na oronde gochia bosongo koreng’ana ne chingongo chiria chi’ebisaku. Chingongo echio nigo chirabe echi’omogaambi. Orogongo orwo oroochenu ase Hekalu erabe nigo rorabe gati‐gati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chingongo chi’omogaambi nigo chirabebekane norw’Abalawi na orw’omochie, naende chibe ase egati y’orw’Abayuda na orw’Ababenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ense yaterwe ebisaku binde",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisaku binde biratigare biegwe chingongo chiabo buna iga: Egesaku kia Benjamini keegwe orogongo rw’aye korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku gia Simioni keegwe orogongo rw’aye robebekane norwa Benjamini, korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Isakaru keegwe orogongo rw’aye robebekane norwa Simioni korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku gia Sabuloni keegwe orogongo rw’aye robebekane norwa Isakaru, korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesaku kia Gadi keegwe orogongo rw’aye robebekane norwa Sabuloni korwa ensinyo ya moocha goika eya bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ribebe ria Irianyi nigo rirabebekane norongogo rwa Gadi. Nigo riragenderere korwa Tamari gochia ase amaache a Kadeshi‐Meriba, na korwa aroro ribwatie akarooche ka Misiri ritwomere Enyancha Enene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eye nero ense moraatanane ase ogoaka obomera, ebe emiando y’ebisaku bi’Abaisraeli. Ebio nabio birabe ebitari biabo. Nabo inche Omonene natebiire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ebiita bia Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nabio birabe ebiita bi’omochie oyio orabe nekerengo gie chimoti chilifu inye, na amagana atano (4,500):",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiita bitato nigo birabe ensemo ya sugusu. Ebiita ebio nigo birarokwe iga: Egeita kia Rubeni, na ekia Yuda, na ekia Lawi. Ebiita bionsi nigo birarokwe kobwatekana namarieta y’ebisaku bi’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensemo ya moocha eyerabe nekerengo gie chimoti chilifu inye, na amagana atano (4,500), ebiita bitato mbibeo: Egeita kia Yusufu, na egia Benjamini, na egia Dani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensemo ya Irianyi eyio erabe nekerengo gie chimoti chilifu inye, na amagana atano (4,500), ebiita bitato mbibeo: Egeita gia Simioni, na ekia Isakaru, na egia Sabuloni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensemo ya bosongo eyio erabe nekerengo gie chimoti chilifu inye, na amagana atano (4,500), ebiita bitato mbibeo: Egeita kia Gadi, na egia Aseri, na ekia Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goetanana omochie bwonsi nigo orabe ekerengo gie chimoti chilifu ikomi na isano na isato (18,000). Korwa rituko erio omochie oyio nigo orarokwe “Omonene Nao Are Aa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
  ],
