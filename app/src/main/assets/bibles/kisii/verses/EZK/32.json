            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omonene nigo agoteeba iga: Ekero Farao ararore abwo baitetwe, nigo areremie ase engencho y’emeganda yaye yonsi eyio yaitetwe nemioro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche nigo naete Farao ribaga arente obwoba ase ense y’abare moyo; ase ayio ere amo nomoganda oye bwonsi barare ase egati y’abatarogeti, abwo baitetwe nemioro. Nabo Omonene atebiire.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
