              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamobooria, “Ng’ai Omonene?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
