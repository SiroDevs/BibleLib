{
  "id": "LUK.18",
  "number": "18",
  "bookId": "LUK",
  "reference": "Luka 18",
  "copyright": "© 2021 KENBS",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "LUK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omoreng’anio bw’omoboraka na omogambi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabateebia omoreng’anio ng’a nebagwenerete komosaba Nyasae botambe, tibakwa emioyo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.1",
            "verseOrgIds": [
              "LUK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabora, “Narenge omogambi ase omochie gete, otasigete Nyasae, gose taare koyiera monto.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.2",
            "verseOrgIds": [
              "LUK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ase omochie oyio narengeo omoboraka orenge komochiera botambe, ogoteeba: Ngambera boronge ase omosiira one.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.3",
            "verseOrgIds": [
              "LUK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omogambi oria ase ekero egeke tancha; magega agateeba ase omoyo oye: Nonya inche tinsigeti Nyasae, gose tindi koyiera monto,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.4",
            "verseOrgIds": [
              "LUK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende ekiagera omoboraka oyo andosirie, nimogambere boronge, tacha kondosia ase ogonchichera botambe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.5",
            "verseOrgIds": [
              "LUK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene akabora, “Igwa aya omogambi otari omooronge agoteeba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nyasae takobanyorera oboronge abachore baye, abakomoreera omobaso na obotuko? Na ere takoba omoremereria ase bare?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.7",
            "verseOrgIds": [
              "LUK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabatebirie nabanyorere oboronge ase obwango. Korende Omwana‐o‐Mwanyabaanto kagocha, Inee, nanyore okwegena ase ense?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omoreng’anio bw’Omofarisai na omorusia ebango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia omoreng’anio oyo ase abanto baare gwekaga ng’a nabanyene oboronge, bagochaaya abande bonsi:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.9",
            "verseOrgIds": [
              "LUK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abanto babere bagatiira gochia Hekalu gosaba; oyomo n’Omofarisai na oyonde omorusia ebango.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.10",
            "verseOrgIds": [
              "LUK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oria Omofarisai agatenena, agasaba iga ase omoyo oye: Nyasae, nakoiraneirie ng’a mbuya mono, ekiagera inche tindi buna abanto bande, abauri, abatari boronge, abatomani, gose buna oyo omorusia ebango.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.11",
            "verseOrgIds": [
              "LUK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo nkweng’ata ara kabere ase echuma; ’ndua ensemo ya ikomi y’okonyora kwane gwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.12",
            "verseOrgIds": [
              "LUK.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oria omorusia ebango agatenena are, tarigia nonya nkoimokia amaiso aye igoro, korende ageaka‐aka egekuba kiaye, okobora: Nyasae, indorera amaabera inche omonyene ebibe!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.13",
            "verseOrgIds": [
              "LUK.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabatebirie inwe: Omonto oria nigo aigete bwoye konya obareirwe oboronge kobua oria onde, ekiagera oyokweimokereria igoro nairanigwe inse, na ere oyokweirania inse naimokererigwe igoro.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.14",
            "verseOrgIds": [
              "LUK.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogosesenia abana abake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 19:13-15; Mar 10:13-16)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamorentera abana ebing’werere, erinde abakune; korende aborokigwa baye bagachia kobarora, bakabatanga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yeso akabarangeria bache asare, ogoteeba, “Batige abana bache ase ’nde, timobaisa kobatanga, ekiagera abare buna aba, oborwotinbwa Nyasae nobwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene nabateebirie: Onde bwensi otancheti oborwoti bwa Nyasae buna omwana omoke, takobosoa nonya ng’ake.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obogima bwa kare na kare, na obobe bw’obotenenku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 19:16-30; Mar 10:17-31)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na omogambi gete akamobooria, “Omworokia omuya, ninki ndakore inyare koba nomwando bw’obogima bwa kare na kare?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.18",
            "verseOrgIds": [
              "LUK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoiraneria, “Naki okondoka omuya? Onde tari omuya otatiga Nyasae bweka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamanyire amachiiko; Totomana, Toita, Toiba, Toteba oborimo, sika iso na nyoko.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.20",
            "verseOrgIds": [
              "LUK.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabora, “Ayio onsi ninyabwatete korwa obwana bwane.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.21",
            "verseOrgIds": [
              "LUK.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso achia koigwa aya, akamoteebia, “Egento ekemo ngekoremete; oonie ebio ore nabio bionsi ogabere abataka, na aye nobe nenibo igoro. Erio ochiche ontunyane.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.22",
            "verseOrgIds": [
              "LUK.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekero achia koigwa aya akaba nomoichano, ekiagera arenge omonda mono.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Yeso akamorigereria, akabora, “Nabe aakong’u ase abare abanda gosoa ase oborwoti bwa Nyasae!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki naororo engamia goeta ase ekebao gi’esiindani, kobua omonda gosoa ase oborwoti bwa Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
            "verseOrgIds": [
              "LUK.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abwo abayaigwete bakaboora, “Ning’o rende oranyare gotooreka?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabora, “Aya takonyarekana ase Mwanyabaanto, nigo akonyarekana ase Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero akabora, “Rora, intwe twatigire chinka chiaito, twagotunyanire aye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Ekeene nabateebirie: Monto onde tari otigire enyomba, gose mokaye, gose abamwabo, gose abaibori, gose abana, ase engencho y’oborwoti bwa Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "otanyore kobua ara aange bono, naende ase ense egochi‐gocha obogima bwa kare na kare.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obobani bwa gatato bwa Yeso igoro y’ogokwa kwaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 20:17-19; Mar 10:32-34)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yeso akaira baria ikomi na babere, akabateebia, “Rora, ngotiira tore kogenda Yerusalemu, naende amang’ana onsi ayariikeretwe Omwana‐o‐Mwanyabaanto nababani naikeranigwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki nabekwe ase amaboko y’abanto b’Ebisaku, nakorerwe echeche, na gokorerwa bobe, na gotwerwa amate;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende inabamoake emecharichi na komoita, na ase rituko ria gatato naboke.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende tibamanya nonya nering’ana erimo ase aya. Ring’ana eri rikabiseka ase bare, na tibamanya ayateebetwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia omonto omouko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 20:29-34; Mar 10:46-52)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero achia goika ang’e na Yeriko omonto oyomo omouko naikaransete enchera ensemo ogosaba ebiegwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.35",
            "verseOrgIds": [
              "LUK.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agachia koigwa omoganda ogoeta, akaboria, “Inki ekio?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.36",
            "verseOrgIds": [
              "LUK.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoiraneria, “Yeso o Nazareti ogoeta.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.37",
            "verseOrgIds": [
              "LUK.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaaka eriogi, akabora, “Yeso, omwana o Daudi, indorera amaabera!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.38",
            "verseOrgIds": [
              "LUK.18.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabwo batang’aine bakamokania, bakamoteebia akire, korende ere akamenta mono goaka eriogi, “Omwana o Daudi, indorera amaabera!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso agatenena, agachiika arentwe asare. Agachia komoika ang’e, akamobooria,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.40",
            "verseOrgIds": [
              "LUK.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ninki origetie ngokorere?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
            "verseOrgIds": [
              "LUK.18.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Akamoiraneria, “Omonene, inyare korora.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
            "verseOrgIds": [
              "LUK.18.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoteebia, “Oegwe okorora; okwegena kwao gwakogwenirie.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio kegima akaba nkorora are, akamotunyana, okomotogia Nyasae; na abanto bonsi bagachia korora aya, bakamotogia Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.43",
            "verseOrgIds": [
              "LUK.18.43"
            ]
          }
        }
      ]
    }
  ],
