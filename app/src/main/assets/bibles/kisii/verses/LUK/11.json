  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "LUK 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "“Ogosaba kw’Omonene”",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 6:9-13)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosaba arenge aase gete. Gakoorire, oyomo bw’aborokigwa baye akamoteebia, “Omonene, twegerie ogosaba buna Yohana aegeretie aborokigwa baye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.1",
            "verseOrgIds": [
              "LUK.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, Komogosaba, teba iga:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tata,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erieta riao risikwe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oborwoti bwao boche,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otoe kera rituko endagera yaito.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.3",
            "verseOrgIds": [
              "LUK.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otwabere ebibe biaito, ekiagera intwe tokwabera",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kera oyomo otokorire bobe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Totoira ase ogoteemwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okogenderera, na omoreng’anio bw’omosani ore gosaba omogati botuko gati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 7:7-11)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Ning’o ase more ore nomosani oramochiere botuko gati amoteebie: Mosani, ing’a singo",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.5",
            "verseOrgIds": [
              "LUK.11.5"
            ]
          }
        },
        {
          "text": "emegati etato,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.5",
            "verseOrgIds": [
              "LUK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera omosani one ochire ase ’nde korwa orogendo, na inche tindi na gento nkomoa;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.6",
            "verseOrgIds": [
              "LUK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na oria ore ime namoiranerie, na goteeba: Tondosia, egesieri giasiekirwe, na inche amo nabana baane twararire borere, tinkonyara koimoka nkoe?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.7",
            "verseOrgIds": [
              "LUK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabatebirie, nataimoka amoe ekiagera nomosani oye, korende ekiagera oria tari gotiga ogosaba, naimoke na komoa ebio bionsi arigetie.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.8",
            "verseOrgIds": [
              "LUK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inche nkobateebia nde inwe: Saba, namoegwe; rigia, namonyore; tura, namoigorerwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.9",
            "verseOrgIds": [
              "LUK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera kera oyogosaba, nigo akoegwa, na ere oyokorigia, nigo akonyora, na ere oyogotura, nigo akoigorerwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.10",
            "verseOrgIds": [
              "LUK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki monto onde nare ase more oyore ise, na omwana oye amosabe omogati, Inee, namoe rigena? Gose karamosabe enswe, ase ribaga ri’enswe namoe eng’iti?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.11",
            "verseOrgIds": [
              "LUK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gose karamosabe rigena ri’engoko namoe riagaga?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.12",
            "verseOrgIds": [
              "LUK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye inwe, abamore ababe, momanyete koa abana baino ebiegwa ebiya, Inee, Iso oino ore igoro takomenta mono kobaa bonsi, abakomosaba, Omoika Omochenu?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.13",
            "verseOrgIds": [
              "LUK.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso na Beelizebuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 12:22-30; Mar 3:22-27)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ngoseria arenge ekerecha ekio giakorete omonto oyomo koba rimama. Ekero ekerecha keria giasogete, omonto oria rimama agakwana; abanto bagakumia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.14",
            "verseOrgIds": [
              "LUK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abande babo bagateeba, “Nase Beelizebuli, omonene bw’ebirecha, akorusia ebirecha.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.15",
            "verseOrgIds": [
              "LUK.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abande ase okomoteema bakarigia aborokie egekone buna ekemanyererio korwa igoro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.16",
            "verseOrgIds": [
              "LUK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere konya omanyire ebirengererio biabo, akabateebia, “Kera oborwoti kobwatananekanire borobwo obonyene nigo b’ogosareka, na enyomba yaatananekire ero enyene nigo ekogwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.17",
            "verseOrgIds": [
              "LUK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo Saitani karaatananeke ere omonyene, oborwoti bwaye naki boratenene? Naki inwe iga mogoteeba ng’a nigo ngoseria ebirecha ase Beelizebuli.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.18",
            "verseOrgIds": [
              "LUK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inche onye ngoseria ebirecha ase Beelizebuli, Inee, abana baino nase ng’o bakobiseria? Ase engencho eyio, barabwo nababe abagaambi baino.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.19",
            "verseOrgIds": [
              "LUK.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende kondaserie ebirecha ase ekiara kia Nyasae, nabo oborwoti bwa Nyasae bwabacheire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.20",
            "verseOrgIds": [
              "LUK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto bw’echinguru ore n’ebinto bi’esegi, gakorenda enyomba yaye, enibo yaye nigo ekoba ase omorembe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.21",
            "verseOrgIds": [
              "LUK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende oyore ne chinguru kobua, ere karamochiere na komobua, nigo akomoura ebinto biaye bi’esegi bionsi ebiegenerete, na ebisakorwa biaye obiatanana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.22",
            "verseOrgIds": [
              "LUK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto otari amo nainche nigo are mamincha ase ’nde, na ere oyotari gosangereria amo nainche nigo agoserebania.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.23",
            "verseOrgIds": [
              "LUK.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoirana kw’omoika bw’ebirecha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 12:43-45)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekero ekerecha ki’eubi kiarure ase omonto, nigo kegoeta gati aase atari namaache, gekorigia aase kegotimokera; getanyoreti kiabora: Ning’irane ase enyomba yane ase narwete.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.24",
            "verseOrgIds": [
              "LUK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakegocha, kiayenyora yaabusirwe, yaroisigwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.25",
            "verseOrgIds": [
              "LUK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio kiagenda, kiarentana ebirecha bitano na bibere binde ebire ebibe gokebua kerokio ekenyene. Birobio bigosoa na komenya aroro; okoba kw’omoerio kw’omonto oyio kwaba okobe kobua okwe ritang’ani.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.26",
            "verseOrgIds": [
              "LUK.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosesenigwa gwekeene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero agokwana aya, omokungu oyomo ase omoganda agaaka eriogi, akamoteebia, “Nesesenirie enda yakobogoretie, ne chimbeere kwagongete!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.27",
            "verseOrgIds": [
              "LUK.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yeso akabora, “Mbuya kobua, basesenirie abakoigwa ring’ana ria Nyasae na koribwata!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.28",
            "verseOrgIds": [
              "LUK.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokuurerwa ase ogotarigia ebikone",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 12:38-42; Mar 8:12)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero emeganda yamentekanete, agachaaka gokwana, “Ekegori eke nekegori ekebe, gekorigia egekone buna ekemanyererio, korende tigekoegwa egekone otatiga eki’omobani Yona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.29",
            "verseOrgIds": [
              "LUK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki buna Yona abeete ekemanyererio ase abanto ba Ninawi, naboigo Omwana‐o‐Mwanyabaanto arache koba ase ekegori eke.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enting’ana ya Irianyi netenene ase rituko ri’ekiina amo nabaanto b’ekegori eke; ere nabanachere ekiina, ekiagera nigo arwete ase chinsinyo chi’ense anyare koigwa obong’aini bwa Sulemani; na rora, oyobuete Sulemani naiga are.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.31",
            "verseOrgIds": [
              "LUK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ba Ninawi nabatenene ase rituko ri’ekiina amo nabaanto b’ekegori eke, na barabwo nabakenachere ekiina ekegori eke, ekiagera baonchogete ase okorandia kwa Yona; na rora, oyobuete Yona naiga are.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
            "verseOrgIds": [
              "LUK.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amorokererio korwa ase etaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 5:15; 6:22-23)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omonto gatongirie etaaya tari koyebeeka ase ekenunchi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.33",
            "verseOrgIds": [
              "LUK.11.33"
            ]
          }
        },
        {
          "text": "gose ayemumeke negetonga, korende nigo akoyebeeka igoro ase ekebekerero, erinde abagosoa barore oborabu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.33",
            "verseOrgIds": [
              "LUK.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etaaya y’omobere oo neriiso riao; ekero eriso riao rire rigiya, omobere oo bwonsi nigo oichire noborabu; korende ekero eriiso riao rire riibe, omobere oo bwonsi nigo oichire nomosunte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.34",
            "verseOrgIds": [
              "LUK.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki renda, oborabu obwo bore ime yao tibocha koba omosunte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.35",
            "verseOrgIds": [
              "LUK.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo omobere oo bwonsi korabe noborabu, ensemo ende teba omosunte, omobere oo noichore noborabu kegima, buna etaya ase amasase aye egwoka oborabu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogokwana obobe igoro y’Abafarisai na aborokia b’amachiiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 23:1-36; Mar 12:38-40; Luk 20:45-47)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero arenge gokwana, Omofarisai oyomo akamorangeria aragere amo nere. Agasoa, agaikaransa koragera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.37",
            "verseOrgIds": [
              "LUK.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omofarisai oria agachia korora, agakumia ekiagera ataisabete ritang’ani atararagera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.38",
            "verseOrgIds": [
              "LUK.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene akamoteebia, “Bono inwe Abafarisai iga mogosibia egekombe na esani korwa isiko, korende ime yaino nigo moichire obouri na obobe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.39",
            "verseOrgIds": [
              "LUK.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abariri, ere oyokorete egia isiko, tari ere okorete nekia ime nakerokio?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.40",
            "verseOrgIds": [
              "LUK.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende karue esadaka y’ebire ime; naende rora, ebinto bionsi nebichenu ase more.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.41",
            "verseOrgIds": [
              "LUK.11.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende obobe nobwaino Abafarisai, ekiagera mokorua ensemo ya ikomi ye chiarare, na kera egesaku gie chinyeni, mogotiga oboronge na obwanchani bwa Nyasae. Naro aya nabagwenerete moyakore, motari gotiga ayande.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.42",
            "verseOrgIds": [
              "LUK.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obobe nobwaino, Abafarisai! Ekiagera mwanchete goikaransa ebirogo bia bosio ase chisinagogi, na gokwanigwa namasikani ase chichiiro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.43",
            "verseOrgIds": [
              "LUK.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obobe nobwaino! Ekiagera mogwekaine chimbeera chitari kororekana, na abanto baeta igoro yaye batamanyeti.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.44",
            "verseOrgIds": [
              "LUK.11.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omworokia oyomo bw’amachiiko akairaneria, akamoteebia, “Omworokia, kogoteeba aya, nigo ogotochaaya naintwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.45",
            "verseOrgIds": [
              "LUK.11.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agateeba, “Nainwe aborokia b’amachiiko, obobe nobwaino! Ekiagera mogotweka abanto chigurube chindito, na inwe abanyene timori gokuna chigurube echio nonya nase ekemo ki’ebiara biaino.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.46",
            "verseOrgIds": [
              "LUK.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obobe nobwaino! Ekiagera mokoagacha chimbeera chi’ababani, abwo chisokoro chiaino chiaitete.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.47",
            "verseOrgIds": [
              "LUK.11.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 11:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo inwe mwabeire abarori na gwanchera ogokora gwe chisokoro chiaino, ekiagera nabwo baabaitete, na inwe mokoagacha chimbeera chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.48",
            "verseOrgIds": [
              "LUK.11.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 11:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ayio obong’aini bwa Nyasae nigo bwateebete: Nintome ase bare ababani na abatomwa; baite abande babo na kobachanda,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.49",
            "verseOrgIds": [
              "LUK.11.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 11:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde amanyinga y’ababani bonsi, ayaitegete korwa omochakano bw’ense naganigwe korwa ase ekegori eke,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.50",
            "verseOrgIds": [
              "LUK.11.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 11:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "korwa amanyinga y’Abeli goika amanyinga a Zakaria; oria oiteretwe gati y’egesasiimero ne Hekalu. Ee, nabateebirie, narigigwe korwa ase ekegori eke.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.51",
            "verseOrgIds": [
              "LUK.11.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 11:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obobe nobwaino, inwe aborokia b’amachiiko! Ekiagera mwarusirie ekeigorero gie chisemi; inwe abanyene timwasoa, na baria abaare gosoa mwabatangire.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.52",
            "verseOrgIds": [
              "LUK.11.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 11:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agachia gosoka korwa aroro, aborokia b’amariiko na Abafarisai bagachaaka komomiga namaborio amakong’u, na komochegia akwane igoro y’ebinto ebinge;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.53",
            "verseOrgIds": [
              "LUK.11.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 11:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakomotega, banyore ring’ana korwa ase omonwa oye, erinde banyare komosoera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.54",
            "verseOrgIds": [
              "LUK.11.54"
            ]
          }
        }
      ]
    }
  ],
