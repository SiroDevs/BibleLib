  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LUK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ase obosio bwa Pilato gabana o Rumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 27:1-2,11-14; Mar 15:1-5; Yoh 18:28-38)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaimoka bonsi, bakaira Yeso ase Pilato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.1",
            "verseOrgIds": [
              "LUK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagachaaka komosoera, bakobora, “Twanyorire omonto oyo oonchoire ense yaito, otokanirie titoa Kaisari ebango, okobora ng’a ere omonyene nere Kristo omorwoti.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.2",
            "verseOrgIds": [
              "LUK.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akamobooria, “Naye Omorwoti bw’Abayahudi?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Yeso akaimoiraneria, “Naye gwateebire.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato agateebia abakuani abanene na emeganda, “Inche tindochi komocha konde ase omonto oyo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.4",
            "verseOrgIds": [
              "LUK.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bakamobetereria, bakaboora, “Oburukanirie abanto, goetera ase amorokererio aye ase Boyahudi yonsi, korwa Galili ase achaakerete na goika bono oikire aiga.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ase obosio bwa Herode",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato agachia koigwa ring’ana eri, akaboria, “Omonto oyo n’Omogalili?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.6",
            "verseOrgIds": [
              "LUK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agachia komanya ng’a nigo are inse ase obogambi bwa Herode, akamotoma gochia ase Herode. Na Herode omonyene nigo arenge Yerusalemu ase amatuko aria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Herode achia korora Yeso akagokigwa mono, ekiagera korwa kare nigo arigetie komoorora, ekiagera aigwete chinkuma chiaye, naende nigo asemeretie korora egekone kegokorwa nere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.8",
            "verseOrgIds": [
              "LUK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamoboria amaborio ase engaki entambe, korende Yeso tamoiraneria ing’ana rinde rionsi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.9",
            "verseOrgIds": [
              "LUK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuani abanene na aborokia b’amariiko bagatenena, bakomosoera ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.10",
            "verseOrgIds": [
              "LUK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode na abarwani baye bakamochaya, bakamosekereria, bakamobekera chianga chingiya mono, akamoirania ase Pilato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.11",
            "verseOrgIds": [
              "LUK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Herode na Pilato abwo barenge ababisa agwo ritang’ani bakabwatana korwa rituko riria bakaba abasani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Pilato, na Baraba, na Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 27:15-26; Mar 15:6-15; Yoh 18:39—19:16)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akarangeria amo abakuani abanene, na abagaambi, na abanto,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.13",
            "verseOrgIds": [
              "LUK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabateebia, “Mwandeterete omonto oyo, buna oyo baonchoire abanto; naunirie amang’ana aye ase amasio aino, na tindochi bobe ase omonto oyo ase aria mwamosoerete,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.14",
            "verseOrgIds": [
              "LUK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nonya n’Herode tarochi, ekiagera omoiranirie gocha ase tore. Rora, ere takorete gento kemogwenerete akwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.15",
            "verseOrgIds": [
              "LUK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio konamoakire, nimosibore.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.16",
            "verseOrgIds": [
              "LUK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono igo yamogwenerete kobasiborera omonto oyomo ekero kie rituko rinene.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.17",
            "verseOrgIds": [
              "LUK.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagaaka eriogi bonsi amo, bakaboora, “Morusie oyo, tosiborere Baraba!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.18",
            "verseOrgIds": [
              "LUK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ere nomonto obegetwe ase echela ase engencho y’eriomana riakoregete ase omochie ime, na ase oboiti.)",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo eria kabere Pilato agakwana nabarabwo, akarigia gosibora Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.20",
            "verseOrgIds": [
              "LUK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende barabwo bagaaka eriogi, bakaboora, “Mobambe, mobambe!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.21",
            "verseOrgIds": [
              "LUK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere akabateebia eria gatato, “Nase ki? Mbobe ki akorete oyo? Tindochi nonya ne ring’ana erimo asare rigwenerete akwe. Ase igo, nanchire komoaka na komosibora.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende bakagenderera kobora ase eriogi rinene ng’a goika abambwe. Eriogi riabo rikabua.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.23",
            "verseOrgIds": [
              "LUK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akanacha amang’ana akoreke buna barigetie.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.24",
            "verseOrgIds": [
              "LUK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agasibora ere oyobegetwe echela ase eriomana na oboiti, oyobarigetie; akarua Yeso ase bare buna ogwancha kwabo kwarenge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okobambwa kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 27:32-44; Mar 15:21-32; Yoh 19:17-27)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagachia komoira, bakabwata Simioni Omokurene, oyorenge korwa borabu, bakamotweka omosalaba, ayobogorie magega ya Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoganda bw’abaanto okamotunyana, na abakungu baare kweaka‐aka, na komweng’erereria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.27",
            "verseOrgIds": [
              "LUK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabeonchorera, akabora, “Abaiseke ba Yerusalemu, timondeera inche, korende ereere inwe abanyene, na abana baino.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki amatuko naache ekero abanto barateebe: Mbasesenirie abare abagomba, ne chinda chitaiboreti, ne chimbeere chitana kogonkwa!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.29",
            "verseOrgIds": [
              "LUK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nabachaake goteebia ebitunwa: Togwere, na ebigoro: Totube.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye bagokora aya ekero omote ore omobese, naki eraabe ekero bwomire?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abande babere abasaria bakairwa, baitwe amo nere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagachia goika aase akorokwa Ekeore, bakamobamba aroro, na baria abasaria, oyomo ensemo y’okoboko gw’okorio, na oyonde ensemo y’okoboko gw’okobee.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.33",
            "verseOrgIds": [
              "LUK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabora, “Tata, baabere, ekiagera tibamanyeti eke bagokora.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Bakagabana chianga chiaye, bagachiakera obomera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bagatenena, bakarigereria. Na barabwo abanyene bakamokorera echeche, bakaboora, “Natooretie abande, tiga etoorie ere omonyene, onye oyo nere Kristo o Nyasae, Omochore oye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.35",
            "verseOrgIds": [
              "LUK.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani boigo bakamosekereria, bakamochiera, bakamoa chinkama,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.36",
            "verseOrgIds": [
              "LUK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakaboora, “Onye aye naye Omorwoti bw’Abayahudi, etoorie.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igoro asare nkiarengeo ekemanyererio keriikire ase omonwa bw’Ekegiriki, na Ekerumi, na Ekeiberania “OYO NERE OMORWOTI BW’ABAYAHUDI.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyomo bwa baria abasaria baabambetwe akamorama, akabora, “Inee! Tari aye Kristo? Etoorie aye omonyene, naintwe ototoorie.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.39",
            "verseOrgIds": [
              "LUK.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo o kabere akamokania, akabora, “Aye tori komoiroka nonya Nyasae, aye kore ase ekiina keria keria?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.40",
            "verseOrgIds": [
              "LUK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intwe ekeene mboronge; ekiagera twaeirwe eng’eria ya boronge y’ogokora gwaito, korende oyo takoreti gento kende kebe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.41",
            "verseOrgIds": [
              "LUK.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio agateebia Yeso, “Yeso, ong’inyore ekero ogocha ase oborwoti bwao!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.42",
            "verseOrgIds": [
              "LUK.23.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoteebia, “Ekeene nagotebirie: Reero nobe amo nainche Paradiso.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokwa kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 27:45-56; Mar 15:33-41; Yoh 19:28-30)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono nigo chiarenge ang’e chinsa isano nemo, omosunte okaba igoro ase ense yonsi goika chinsa kianda,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero omobaso orimire. Na egetambaa gi’okonacha Hekalu kegatandoka gati‐gati.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akarera ase eriogi rinene, akabora, “Tata, ase amaboko ao nabekire omoika one!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Magega gakwanire aya agatweka mo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omotang’ani bw’abarwani rigana agachia korora aya, agatogia Nyasae, akabora, “Ekeene, omonto oyo nigo arenge omonyene oboronge.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende emeganda yonsi, abasangererekanete korora aya, kobachia korora ayakoreka, bakairana chinka chiabo, bakweaka ebikuba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasani baye bonsi na abakungu abamotunyanete korwa Galili, bagatenenera are, bakarora ayio.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotindekwa kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 27:57-61; Mar 15:42-47; Yoh 19:38-42)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, narengeo omonto oyomo, erieta riaye Yusufu, omonto bw’Arimathaya, omochie o Boyahudi, ere nomonto bw’ekegambero kiabo, omonto omuya, naende omooronge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere tanchete amang’ana abo, nonya nogokora kwabo, nigo aganyete oborwoti bwa Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyo agachiera Pilato, akamosaba aegwe omobere o Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayoikia, akayoboyia egetambaa ki’egatani, akayobeeka ase oboina bwabaachetwe ase egetare, aase monto onde atana kobekwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo riarenge rituko ri’Okwearigania, na Esabato egachaaka gosoa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 23:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakungu abaachete amo nere korwa Galili, nigo batunyanete korwa magega, bakarigereria oboina na buna omobere oye bwareretigwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
            "verseOrgIds": [
              "LUK.23.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakairana, bakaroisia amanukato na amaguta ye rimisu rigiya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Ne rituko ri’Esabato bagatimoka buna yachiigetwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    }
  ],
