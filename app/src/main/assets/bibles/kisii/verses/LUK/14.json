          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togwenereti riroba gose etui; abanto nigo bakoyotuguta isiko. Oyore namato akoigwera, tiga aigwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
