          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye taibo, nigo agotoma abanto korigia enchera y’omorembe, omonto oria gakare aare.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.32",
            "verseOrgIds": [
              "LUK.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo kera oyomo oino otatigeti ebinto bionsi are nabio, takonyara koba omworokigwa one.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.33",
            "verseOrgIds": [
              "LUK.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
