  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "LUK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yohana Omobatisi na amang’ana aye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 3:1-12; Mar 1:1-8)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o ikomi na gatano bw’okogamba gwa Kaisari Tiberio, Pontio Pilato orenge gabana o Boyahudi, na Herode omorwoti o Galili, na Filipo momura omwabo arenge omorwoti o Iturea na ense ya Tarakoniti, na Lusania omorwoti o Abileni,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero ki’obokuani obonene bw’Anasi na Kayafa, ring’ana ria Nyasae rigaikera Yohana, omwana o Zakaria, ase erooro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagenda chinse chionsi chi’ensemo ya Yorodani, okorandia ebatiso y’okoonchoka ekorenta okwaberwa kw’ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.3",
            "verseOrgIds": [
              "LUK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna eriikire ase egetabu y’amang’ana ’omobani Isaya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Eriogi ri’oyogoaka egeturi ase erooro,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Roisia enchera y’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rongeyia oboeto bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera rigooko nariichorigwe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kera ekegoro na egetunwa nabikeeigwe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aare bogeka inarongeigwe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enchera ere ebitunwa‐tunwa nereng’anigwe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na abanto bonsi nabarore ogotooreka gokorwa ase Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.6",
            "verseOrgIds": [
              "LUK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo agateebia emeganda eyachete, erinde ebatiswe nere, “Inwe oroiboro rwe ching’iti, ning’o obakuureire ng’a motame korwa ase endamwamu egochi‐gocha?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki, ama okwama kogwenerete okoonchoka, gose timochaaka kobora emioyo yaino ime: Ntore na sokoro yaito, nere Aburaamu. Naki nabateebirie ng’a Nyasae nare nokobua ase amagena aya gokorera Aburaamu abana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya mbono egesire kiabekirwe ase emeri y’emete; nabo kera omote otameti okwama okuya nonachwe, otugutwe ase omorero.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeganda eria ekamoboria, “Ninki rende torakore?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabairaneria, “Oyore ne chianga ibere ae ere oyotari nero; na oyore nendagera akore boigo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarusia ebango bagacha erinde babatiswe, bakamobooria, “Omworokia, inki rende naintwe torakore?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabairaneria, “Timorusia kobua ebi mwachigetwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasikari nabarabwo bakamobooria, “Naintwe inki torakore?” Akabairaneria, “Timourereria monto onde ase chinguru gose ase obosoeri bw’oborimo; naende moisaneke neng’eria yaino.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanto baganyete na konakorengereria, bonsi bakeboria ase chinkoro chiabo ime gose Yohana nere Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana akairaneria abwo bonsi, “Inche nigo nkobabatisa ase amaache, korende oyore ne chinguru kombua ngocha are, ting’isaini gosibora chiusi chi’ebikoroto biaye; oyio nere orabaabatise ase Omoika Omochenu na ase omorero.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oroteru rwaye nigo rore koboko kwaye, ere naabuse ekeooreri kiaye, nasangererie engano ase ekiage kiaye, korende omoiriro nayosambe ase omorero otakorimeka.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ase ogokuurera okonge Yohana akaranderia abanto amang’ana amaya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yohana agatogonyera Herode omorwoti, ase engencho y’okonyuoma Herodia, moka momura omwabo, na ase engencho y’amabe onsi Herode akorire,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Herode agakora rinene kobua, ase okoruta ase Yohana echela.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okobatiswa kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 3:13-17; Mar 1:9-11)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egachia koba abanto bonsi kobaabatisirwe, na Yeso boigo kabatisirwe, na ekero agosaba, igoro akamaanoka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoika Omochenu ogaika igoro asare ase omogwekano bwe riruma, eriogi rikarwa igoro, rigoteeba, “Aye naye Omwana one omwanchwa",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        },
        {
          "text": ", ngokirie naye.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Chisokoro ne chisokoororia chia Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 1:1-17)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso nere ekero achagete kworokereria, emiaka yaye igo yarenge ang’e emerongo etato, agakagwa ng’a mosinto o Yusufu, o Eli,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "o Mathati, o Lawi, o Meliki, o Yana, o Yusufu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "o Matathia, o Amos, o Nahum, o Esili, o Nagai,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.25",
            "verseOrgIds": [
              "LUK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "o Maathi, o Matathia, o Semei, o Yoseki, o Yoda,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.26",
            "verseOrgIds": [
              "LUK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
