{
  "id": "LUK.4",
  "number": "4",
  "bookId": "LUK",
  "reference": "Luka 4",
  "copyright": "© 2021 KENBS",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "LUK 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteemwa kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 4:1-11; Mar 1:14-15)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeso oichire n’Omoika Omochenu, akairana korwa Yorodani, agatang’anwa n’Omoika kogenda ase erooro,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
            "verseOrgIds": [
              "LUK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "agateemwa na Saitani ase engaki y’amatuko emerongo ene. Na amatuko aria tariete gento. Goika agachia koera, akaigwa enchara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.2",
            "verseOrgIds": [
              "LUK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saitani akamoteebia, “Onye kore Omwana o Nyasae, teebia rigena eri ribe omogati.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.3",
            "verseOrgIds": [
              "LUK.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoiraneria, “Neriikire. Omonto takoba moyo ase omogati bwoka.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.4",
            "verseOrgIds": [
              "LUK.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saitani akamoira aase aimokererete igoro, akamworokia amarwoti onsi ay’ense ase egeka ekemo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.5",
            "verseOrgIds": [
              "LUK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamoteebia, “Ninkoe okobua oko gwonsi, na obonene bwaye, ekiagera nabieirwe, na inche iga nkoa oyo ngwancha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.6",
            "verseOrgIds": [
              "LUK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo koransasiime, bionsi nabibe ebiao.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.7",
            "verseOrgIds": [
              "LUK.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoiraneria, “Neriikire: Mosasiime Omonene Nyasae oo, omokorere ere bweka.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.8",
            "verseOrgIds": [
              "LUK.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saitani akamoira goika Yerusalemu, akamotenenia igoro ase egechuria gie Hekalu egetambe mono, akamoteebia, Onye kore Omwana o Nyasae, etugute gochia inse korwa aa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.9",
            "verseOrgIds": [
              "LUK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera neriikire:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.10",
            "verseOrgIds": [
              "LUK.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere nagochikere abamalaika baye bakorende,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.10",
            "verseOrgIds": [
              "LUK.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.11",
            "verseOrgIds": [
              "LUK.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabakoimokie ase amaboko abo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.11",
            "verseOrgIds": [
              "LUK.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde tobaisa kogochwa okogoro kwao ne rigena.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.11",
            "verseOrgIds": [
              "LUK.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoiraneria, “Neteebire, Toteema Omonene Nyasae oo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
            "verseOrgIds": [
              "LUK.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saitani agachia gokoora ogoteema kwaye gwonsi, akaimoka korwa asare, akamotiga ase egeka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogochaka emeremo Galili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 4:12-17; Mar 1:14-15)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akairana gochia Galili ne chinguru chi’Omoika, chinkuma chigasarera ase chinsemo chionsi chi’ense eria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere akorokereria ase chisinagogi chiabo, ogotogigwa nabaanto bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okwangwa Nazareti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 13:53-58; Mar 6:1-6)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagenda Nazareti, aria ase arereretwe; na ase rituko ri’Esabato agasoa ase esinagogi yabo, buna engencho yaye yarenge, agatenena gosoma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.16",
            "verseOrgIds": [
              "LUK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaegwa egetabu y’omobani Isaya. Nabo akaigora egetabu eyio, akanyora aase ariikire,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
            "verseOrgIds": [
              "LUK.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoika bw’Omonene nigo ore igoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ong’akire amaguta koranderia abataka amang’ana amaya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ontomire koranderia abasibwa ogosiborwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koa abare emeuko banyare korora naende,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gosibora abasionoirwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na korandia omwakabwo Omonene bwancheretwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.19",
            "verseOrgIds": [
              "LUK.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamumekeria egetabu eria akayea omokori emeremo bw’esinagogi, agaikaransa. Abanto bonsi abarenge ase esinagogi bakamobeta amaiso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.20",
            "verseOrgIds": [
              "LUK.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agachaaka kobateebia, “Reero ririiko eri riaikeranigwe ase more buna mwarigwa rigosomwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.21",
            "verseOrgIds": [
              "LUK.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonsi bakamokwana buya bagakumia amang’ana obuya aruete ase omonwa oye, bagateebania, “Oyo tari ere omwana o Yusufu?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.22",
            "verseOrgIds": [
              "LUK.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Ekeene, namonteebie omoreng’anio oyo: Omogwenia, egwenie aye omonyene; amang’ana onsi twaigure akorekire Kapernaumu, yakore aiga ase ense yao.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.23",
            "verseOrgIds": [
              "LUK.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Ekeene nabateebirie: Omobani tari oranyare gwanchwa ase ense yaye omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.24",
            "verseOrgIds": [
              "LUK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekeene nabateebirie ng’a mbarenge ababoraka abange ase Israeli ase amatuko ’Elija, ekero igoro yasiegetwe emiaka etato na emetienyi etano nomo, ekero enchara enene yasoete ase ense yonsi;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Elija tatometwe ase oyomo obo, otatiga ase omokungu oyorenge omoboraka agwo Sarefata, ase ense ya Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende mbarenge ase Abaisraeli abanto abange abaare noborwaire bwa ukoma ase ekero ki’omobani Elisha; onde tari osibegete otatiga Naamani, omonto o Siiria.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagachia koigwa aya, bonsi ase esinagogi bagaichorwa nendamwamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.28",
            "verseOrgIds": [
              "LUK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaimoka bakamosokia isiko y’omochie, bakamoira goika igoro y’egetunwa keria omochie obo oagachire erio, banyare komoturunkania.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.29",
            "verseOrgIds": [
              "LUK.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ere agaeta egati‐gati yabo, akagenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okogwenigwa kw’omonto obwatire nekerecha ki’eubi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 1:21-28)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatirimboka goika Kapernaumu, omochie o Galili. Akaba nkoborokereria are rituko ri’Esabato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.31",
            "verseOrgIds": [
              "LUK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagakumia mono ase okworokereria kwaye, ekiagera ring’ana riaye riarenge nokobua.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.32",
            "verseOrgIds": [
              "LUK.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende ase esinagogi narengeo omonto obwatire n’Omoika bw’ekerecha ki’eubi. Ere agaaka eriogi ase chinguru, akabora,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.33",
            "verseOrgIds": [
              "LUK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ah! Totige intwe Inki tore naye, Yeso o Nazareti? Ngwachire gotosiria? Nakomanyire aye, Omochenu o Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.34",
            "verseOrgIds": [
              "LUK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akagetogonyera, akabora, “Kira, omorwe!” Ekerecha keria gekamoiyeria agwo gati‐gati, gekamorwa, tikiamokorera gento.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.35",
            "verseOrgIds": [
              "LUK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagakumia bonsi, bagateebania barabwo ase barabwo, “Ing’ana ki eri? Naki ase chinguru na okobua kiagochika ebirecha bi’eubi, na birobio biasoka.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.36",
            "verseOrgIds": [
              "LUK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinkuma chiaye chigasarera ase chinsemo chionsi chi’ense eria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia aaria mwa Simioni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mat 8:14-17; Mar 1:29-39)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaimoka korwa ase esinagogi, agasoa ase enyomba ya Simioni. Nabo ng’ina biara Simioni konya orwarire esosera; bakamosaba ase engencho yaye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatenena ang’e nere, agatogonyera esosera eria; ekamotiga. Bwango ere akaimoka akabakorera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goika erioba rigachia kogwa bakarenta asare abanto bonsi abarenge nabarwaire bare namarwaire ao ao, na ere akabeeka amaboko aye igoro ase kera oyomo, akabagwenia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebirecha bigasoka korwa ase abange, bigaaka eriogi, bikabora, “Aye naye Omwana o Nyasae.” Akabitogonyera, tabitiga bikwane, ekiagera biamanyete ng’a nere Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "Yeso okorandia ase esinagogi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goika ekaba mobaso, agasoka, akagenda aase atari nabaanto. Na abanto bakamoriga‐rigia, bakamoikera, bakarigia komotanga taimoka korwa ase bare.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Nengwenerete korandia amang’ana amaya ay’oborwoti bwa Nyasae ase emechie ende boigo, ekiagera natometwe ase engencho eyio.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba nkorandia are ase chisinagogi chia Boyahudi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.44",
            "verseOrgIds": [
              "LUK.4.44"
            ]
          }
        }
      ]
    }
  ],
