          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abiyamu omorwoti bw’Abayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(2 Amg 13:1—14:1)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o ikomi na gatano na gatato bw’okogaamba kw’omorwoti Yeroboamu, mosinto o Nebati, Abiyamu agachaaka kogaambera Abayuda,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.1",
            "verseOrgIds": [
              "1KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba okogaamba ase engaki y’emiaka etato agwo Yerusalemu. Ng’ina nigo arenge korokwa Maaka, omosubati bw’Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.2",
            "verseOrgIds": [
              "1KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyamu akabwatia chingencho chia ise ase ogokora ebibe, na tarenge nobwegenwa bw’enkoro ase Omonene, Nyasae oye, buna Daudi, sokororia yaye arenge.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.3",
            "verseOrgIds": [
              "1KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende nonya naboigo, ase engencho ya Daudi Omonene, Nyasae oye, akamoa etaya agwo Yerusalemu ase ogotenenia omwana oye agambe, naende agakong’ia Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.4",
            "verseOrgIds": [
              "1KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya igo akoregete, ekiagera Daudi nigo akorete ayare amaronge ase obosio bw’Omonene, na ase obogima bwaye bwonsi, tamochete gokora kende gionsi Omonene amochiigete, otatiga ase amang’ana a Uria Omohiti oka amochete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.5",
            "verseOrgIds": [
              "1KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esegi nigo yagendererete koba egati ya Rehoboamu na Yeroboamu ase obogima bwonsi bwa Rehoboamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.6",
            "verseOrgIds": [
              "1KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana ande onsi igoro y’Abiyamu, na aya onsi akorete, nigo ariikire ase Egetabu ki’ogokora kw’Abarwoti b’Abayuda. Na esegi nigo yarenge ase egati y’Abiyamu na Yeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.7",
            "verseOrgIds": [
              "1KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyamu akaraara ase chisokoro chiaye chiararete agatindekwa ase Omochie o Daudi, na Asa, omwana oye omomura, akaba okogaamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.8",
            "verseOrgIds": [
              "1KI.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Asa omorwoti bw’Abayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(2 Amg 15:16—16:6)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka bw’emerongo ebere bw’okogaamba kwa Yeroboamu, omorwoti bw’Abaisraeli, Asa agachaaka kogaambera Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere akaba okogaamba ase engaki y’emiaka emerongo ene, nomo, agwo Yerusalemu. Ng’ina Asa nigo are korokwa Maaka, mosubati bw’Abisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa agakora ayare amaronge ase amaiso ’Omonene, buna Daudi, sokororia yaye, akorete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agasiria korwa ase ense eria abasacha baria abanyaka baarenge korigania ase obosooku, naende akarusia aroro emegwekano y’ogosasimwa, eria chisokoro chiaye chiaroisetie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo Asa akarusia Maaka ng’ina taba eting’ana, ekiagera nabwate omogwekano orenge okogechia oroiseretigwe Asera, enyasae eria enkuungu, akabutora na akaiyeria inse omogwekano oria ng’ina abwate, akayosambera agwo ase akarooche ga Kidironi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende aase aimokererete igoro tarusetigweo. Nonya naboigo, ase obogima bwaye bwonsi Asa nigo arenge nenkoro y’obwegenwa ase Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarenta ase enyomba y’Omonene ebiegwa ebi ise na ere omonyene baatananete bikaba ebichenu, chifeta, ne chitaabu, na ebikorero.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esegi nigo yagendererete koba egati y’Asa na Baasa, omorwoti bw’Abaisraeli, ase amatuko abo onsi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.16",
            "verseOrgIds": [
              "1KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasa, omorwoti bw’Abaisraeli, akagenda korwania Abayuda, akagitera omochie o Rama chindwaki, ng’a nario ribaga ritabaisa gotoka ase omonto onde bwensi gosoka gose gosoa kogenda ase Asa, omorwoti bw’Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.17",
            "verseOrgIds": [
              "1KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Asa akarusia chifeta chionsi, ne chitaabu chionsi, echio chiatigarete ase chikungo chi’enyomba y’Omonene, na echi’enyomba y’omorwoti, agachibeeka ase amaboko ’abasomba baye. Erio agatoma ebinto ebio gochia ase Damesiki ase Beni‐Hadadi, mosinto o Tabirimoni, o Hesioni, omorwoti o Siiria, amenyete, agateeba,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiga okobwatana kw’ogotianania kobe ase egati yane naye, buna kwarenge ase egati ya tata na iso. Rora nagotomeire ekeegwa gie chifeta ne chitaabu. Genda osarie okobwatana okwo kwao gwakorete na Baasa, omorwoti bw’Abaisraeli, erinde arue ase ense yane antigane.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni‐Hadadi akaigwera Asa omorwoti, agatoma abatang’ani b’abarwani baye, bakagenda bakarwania emechie y’Abaisraeli, bakabua Iyoni na Dani, na Abeli‐Beti‐Maaka, na Galili, yonsi, amo nense yonsi ya Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ekero Baasa aigwete amang’ana ayio, agatiga kogitera omochie o Rama, akagenda komenya agwo Tirisa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio omorwoti Asa akarua okoraria ase Abayuda bonsi, nonya nomonto oyomo tatigetwe otakonye koira amagena a Rama, amo ne chibao chiarengeo, ebinto ebio bionsi Baasa arenge kogitera omochie oria; na ase ebinto ebio omorwoti Asa akagitera Geba ase orogongo rwa Benjamini amo na Misipa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.22",
            "verseOrgIds": [
              "1KI.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono amang’ana ande onsi igoro y’Asa, okobua kwaye na onsi aya akorete na emechie aagachete, nigo ariikire ase Egetabu ki’ogokora kw’Abarwoti b’Abayuda. Korende ekero ki’obogotu bwaye akarwara amagoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa akaraara, ase chisokoro chiaye chiararete, agatindekwa ase Omochie o Daudi, sokororia yaye, na Yehosafati, omwana oye omomura, akaba okogaamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nadabu omorwoti bw’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabu, mosinto o Yeroboamu, agachaaka kogaambera Abaisraeli ase omwaka o kabere bw’okogaamba gw’Asa, omorwoti bw’Abayuda, akagaamba ase engaki y’emiaka ebere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere agakora ayare amabe ase obosio bw’Omonene, akabwatia chinchera chia ise ase ogokora ebibe ebio bikagera Abaisraeli bagakora ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasa, mosinto bw’Ahiya, omonto bw’enyomba ya Isakaru, agakora omooroberio bw’ogoita Nadabu, akamoaka, akamoitera agwo Gibetoni, omochie bw’Abafilisti. Nadabu na Abaisraeli bonsi nigo bebisete baboerete Gibetoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o gatato bw’okogaamba gw’Asa, omorwoti bw’Abayuda, noro Baasa, akamoita, naende akaba okogaamba ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na obwango boria abeete omorwoti, agaita abanto bonsi b’enyomba ya Yeroboamu, tatigaretie nonya nomonto oyomo ore moyo ase abanto baye, korende akabasiria kegima, koreng’ana ne ring’ana riri’Omonene akwanete goetera ase omosomba oye Ahiya, omonto korwa Silo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nigo akoregete ase engencho y’ebibe bia Yeroboamu biria akorete, naende akagera Abaisraeli bagakora ebibe, na ase engencho y’ayi’Omonene, Nyasae bw’Abaisraeli, akaba nendamwamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono amang’ana ande onsi igoro ya Nadabu, na aya onsi akorete, nigo ariikire ase Egetabu ki’ogokora kw’Abarwoti b’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esegi nigo yagendererete koba egati y’Asa na Baasa, omorwoti bw’Abaisraeli, ase obogima bwabo bwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Baasa omorwoti bw’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o gatato bw’okogaamba gw’Asa, omorwoti bw’Abayuda, Baasa, mosinto bw’Ahiya, agachaaka kogaambera Abaisraeli bonsi agwo Tirisa, na akagaamba ase engaki y’emiaka emerongo ebere na ene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora ayare amabe ase obosio bw’Omonene, akabwatia chinchera chia Yeroboamu ase ogokora ebibe ebio bikagera Abaisraeli bagakora ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        }
      ]
    }
