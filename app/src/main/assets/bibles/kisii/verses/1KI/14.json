              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bono amang’ana ande onsi igoro ya Rehoboamu, na aya onsi akorete, nigo ariikire ase Egetabu ki’ogokora kw’Abarwoti b’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
