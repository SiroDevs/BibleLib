          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esegi nigo yagendererete botambe ase egati ya Rehoboamu na Yeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
