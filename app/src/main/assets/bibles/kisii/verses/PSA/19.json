{
  "id": "PSA.19",
  "number": "19",
  "bookId": "PSA",
  "reference": "Zaburi 19",
  "copyright": "© 2021 KENBS",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "PSA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obonene bwa Nyasae ase Obotongi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igoro nigo chikoorokia obonene bwa Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na eaanga ya igoro eraria emeremo y’amaboko aye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rituko erimo riatebia erinde obonene obo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obotuko obomo bwarareria obotuko bonde ayio ayio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinkwana chinde tichiri aroro, gose omonwa onde ogokwanwa tori,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na eriogi riabo tiriri koigugwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriogi riabo riagendire, riesiareire ase ense engima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amang’ana abo aikire chinsinyo chi’ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae okorire igoro koba obomenyo bw’erioba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erioba nigo rigosoka buna omonywomi ogosoka korwa mwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na riagoka buna omogosoria omokong’u okominyoka chimbero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo rigosoka korwa ensemo eyemo ya igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende riekumba riagenda gochia ensemo ende;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gento kende tikeri gekobisekana korwa ase riberera riaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amachiiko y’Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amachiiko ’Omonene namaikeranu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agokora omoyo oba omoyia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oborori bw’Omonene nobw’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akong’ainiyia oyotamanyeti amange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amachiiko ’Omonene namaronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akogokia enkoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ring’an’Omonene achiikire nerironge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo rikorenta oborabu ase amaiso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomoiroka Omonene nering’ana richenegete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okwo koragenderere kare na kare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okogamba kw’Omonene nogw’ekeene, na okw’oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio onsi nigo are amaya kobua etaabu, ee, kobua etaabu echenire",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amansu kobua obooke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, kobua richoe ri’obooke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amo nayio nigo ogokuurera omosomba oo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio okoyarenda nigo akoegwa eng’eria enene y’obuya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oranyare komanya amamocho aye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, nchene korwa ase amamocho aane abisekanete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ontange inche, omosomba oo, tinkora ebibe bi’obomwenu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobitiga ebio bingambere!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rirorio nimbe ntari na komocha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe omosibore korwa ase ogosaria okonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Egetare kiane na Omobooria one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "anchera amang’ana aane na ebirengererio bire ase enkoro yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.20",
    "number": "20",
