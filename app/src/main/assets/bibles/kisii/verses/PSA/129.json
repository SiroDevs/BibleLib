    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba ng’a ababisa b’Abaisraeli babugwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 129:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ababisa nigo batochaandete korwa oboke bwaito.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabo Abaisraeli bagoteeba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 129:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ee, barabwo nigo batochaandete korwa oboke bwaito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende tibana‐gotobua.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 129:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakang’ororia emegongo yaito buna emegondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.3",
            "verseOrgIds": [
              "PSA.129.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bakayetambeyia emeng’ororia yaabo.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.3",
            "verseOrgIds": [
              "PSA.129.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 129:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omonyene oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere obutoire chingori chi’abakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 129:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bonsi bageechete Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "taga basookigwe na koiranigwa magega.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 129:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo tiga babe buna obonyansi bore kerama igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.6",
            "verseOrgIds": [
              "PSA.129.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bogosusana botarakina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.6",
            "verseOrgIds": [
              "PSA.129.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 129:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tibori goichora okoboko kw’omosangereria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
              "PSA.129.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose kobogwa omosaima okoboko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
              "PSA.129.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 129:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bagoeta inchera tibakonyaara goteeba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Omonene abasesenie!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose goteeba, “Nkobasesenia tore inwe ase erieta ri’Omonene!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
          }
        }
      ]
    }
  ],
