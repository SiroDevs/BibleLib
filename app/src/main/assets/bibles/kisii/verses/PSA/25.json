  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "PSA 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba ase okonyora oboraai na oborendi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ngocha nde asore nomoyo one bwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.1",
            "verseOrgIds": [
              "PSA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one, naye nsemeretie, tontiga nsookigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "totiga ababisa baane bagokere okobugwa kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monto onde bwensi ogosemeretie totiga asookigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abwo batigire obwegenwa engencho ende etaiyo basookigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, imanyie chinchera chiao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inyorokererie oboeto bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondaae ase ekeene kiao na onyorokererie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera aye Nyasae nogotooreka kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo ngosemeretie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, inyora amaabera ao na obwanchani bwao botari koera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nao biarenge korwa kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, tobaisa koinyora ebibe na ogosaria bi’obosae bwane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ong’inyore ase engencho y’obwanchani bwao bogendererete botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase engencho y’obuya bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omuya na ere nere omonyene oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio nigo akworokereria abanyabibe enchera bagwenerete kobwatia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo akoraa abanto bare abaitongo ase enchera endonge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende aborokereria komanya enchera yaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinchera chionsi chi’ Omonene nigo chire echi’obwanchani, na echi’obwegenwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase abwo barendete okobwatana kwaye na oborori bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, ase engencho y’erieta riao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onyabere ogosaria kwane, ekiagera nokonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omonto omoirogete Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eri’Omonene amworokereria enchera agwenerete gochora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio nagenderere gosesenigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ororeria rwaye ndoire ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omosani bw’abaanto bamoirogete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.14",
            "verseOrgIds": [
              "PSA.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akobamanyia okobwatana kwaye kw’ogotianania.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.14",
            "verseOrgIds": [
              "PSA.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botambe nigo nkoba imorigereretie Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere orarusie amagoro aane ase oboreba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omonene, ing’iranere ondorere amaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo inde inche bweka, naende nchandegete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoichano nigo oichire ase enkoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.17",
            "verseOrgIds": [
              "PSA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ndusie ase obokong’u bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.17",
            "verseOrgIds": [
              "PSA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndigererie orore obororo bwane na ogochandwa kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.18",
            "verseOrgIds": [
              "PSA.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onyabere ebibe biane bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.18",
            "verseOrgIds": [
              "PSA.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora ababisa baane bonsi buna bare abange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.19",
            "verseOrgIds": [
              "PSA.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna bangechete nobotindi obonge.",
          "type": "text",
          "attrs": {
