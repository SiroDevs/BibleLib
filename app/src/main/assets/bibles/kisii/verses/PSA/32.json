  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "PSA 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoorokia ebibe na konyora okwaberwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto oyo bwabeirwe ogosaria kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebibe biaye biatubirwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto oyi’Omonene atabarereti okomocha kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo otari nobong’ainereria ase omoyo oye ime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero konya ntaraorokia ebibe biane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omobere one okoma pa ase okwerera omobaso boira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobaso na obotuko okoboko kwao gokanditoera negesusuro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinguru chiane chikaera buna amaache akoera ekero ki’egurugura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ngakoorokeria ebibe biane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tinakobisete okomocha kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngateeba: “Nimoorokerie Omonene ogosaria kwane,”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio okanyabera ebibe biane bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, kera omonto oyokoirogete tiga agosabe ase engaki y’emechando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero amaache amange agotirimboka gocha bwango, tabaisa komoikera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye naye obwebiso bwane, nondendete korwa ase emechando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe nomogooko na omochengo, ekiagera gwantooririe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninkworokererie na gokoraa ase enchera ogwenerete kogenda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ningosemie, na amaiso aane nakorigererie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoba buna chibarasi ne chibarasi chitari nobong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "echigwenerete chibekerwe chinkini na ebigobanio bi’ogochigambera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nare namaakwa amange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende oyomosemeretie Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo amoetananeretie nobwanchani botari koera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanyene oboronge, mogokere Omonene na komochengera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe mwensi abamore ne chinkoro chindonge, aka eriogi nomogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.33",
    "number": "33",
    "bookId": "PSA"
  },
