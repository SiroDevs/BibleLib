    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 104:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwabekire omotienyi obeire ekemanyererio gie chingaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.19",
            "verseOrgIds": [
              "PSA.104.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na erioba nigo rimanyete boronge ekero rigwenerete kogwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.19",
            "verseOrgIds": [
              "PSA.104.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 104:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo okorenta omosunte bwaba botuko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio ching’iti chionsi chi’orosana chiachaka gotaara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 104:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chindo chinsae nigo chikoronya ekero chigotwara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.21",
            "verseOrgIds": [
              "PSA.104.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chiarigia endagera yabo korwa ase Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.21",
            "verseOrgIds": [
              "PSA.104.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 104:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero erioba rigochia kooroka chiairana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.22",
            "verseOrgIds": [
              "PSA.104.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chiagenda korara ase amakuruma abo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.22",
            "verseOrgIds": [
              "PSA.104.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 104:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanyabaanto nigo bakogenda ase emeremo yabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bayekora goika mogoroba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 104:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, naki ogokora kwao kore okonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Okwo gwonsi nigo okogokora nobong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ense nigo eichire nebitongwa biao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 104:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyancha nero enene naende engare; nigo eichire nebitongwa bire moyo bitari kobareka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebike na ebinene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 104:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimeeri nao chigoeta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Leviatani, eng’iti eria enene y’okwoboyia gwatongete, ekonagoswenenao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 104:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitongwa ebio bionsi naye bisemeretie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.27",
            "verseOrgIds": [
              "PSA.104.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio oe kera ekemo endagera yaye ase engaki egwenerete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.27",
            "verseOrgIds": [
              "PSA.104.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 104:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero kwabieire endagera, nigo bikoyesangereria;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.28",
            "verseOrgIds": [
              "PSA.104.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero kwaramboire okoboko kwao, nigo bigoisaneka n’ebinto bire ebiya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.28",
            "verseOrgIds": [
              "PSA.104.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 104:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero kwabisire obosio bwao, nigo bikoba nobwoba obonene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero okobiura omoika obo, nigo bigokwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "biairana ase amaroba ime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 104:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ogotoma omoika oo, nigo bigotongwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.30",
            "verseOrgIds": [
              "PSA.104.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende gwakora ense yaba enyia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.30",
            "verseOrgIds": [
              "PSA.104.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 104:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga obonene bw’Omonene bogenderere kobao kare na kare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.31",
            "verseOrgIds": [
              "PSA.104.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene tiga agokere emeremo yaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.31",
            "verseOrgIds": [
              "PSA.104.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PSA 104:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo akorigereria ense, nero yatengecha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.32",
            "verseOrgIds": [
              "PSA.104.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agokuna ebitunwa, na birobio biasokia erioki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.32",
            "verseOrgIds": [
              "PSA.104.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 104:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninterere Omonene ase obogima bwane bwonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.33",
            "verseOrgIds": [
              "PSA.104.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe ngotera ase ogotogia Nyasae one ekero inde moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.33",
            "verseOrgIds": [
              "PSA.104.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PSA 104:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Omonene agokigwe nebirengererio ebio biane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.34",
            "verseOrgIds": [
              "PSA.104.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera inche nigo ngogete asare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.34",
            "verseOrgIds": [
              "PSA.104.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PSA 104:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyabibe tiga basirigwe korwa ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.35",
            "verseOrgIds": [
              "PSA.104.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abakori amabe tibaabaisa kobao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.35",
            "verseOrgIds": [
              "PSA.104.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye omoyo one, togia Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.35",
            "verseOrgIds": [
              "PSA.104.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Motogie Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.35",
            "verseOrgIds": [
              "PSA.104.35"
            ]
          }
        }
      ]
    }
