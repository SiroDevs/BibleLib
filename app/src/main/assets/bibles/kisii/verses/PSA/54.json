  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "PSA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora okorendwa korwa ase ababisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(1 Sam 23:19; 26:1)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi ekero omonto oyomo korwa Sifu achierete Saulo komotebia ng’a Daudi nsobo ebisete)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, ntoorie ase engencho y’erieta riao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ong’e oboronge bwane goetera ase okobua kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae, igwa ogosaba kwane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tegerera oigwe amang’ana aane ngokwana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abamwenu bang’umokeire kong’ita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto abatindi nigo baganetie obogima bwane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo tibakoirogeti aye Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimanyete ng’a Nyasae nere omokonyi one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nere orendete obogima bwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nairanerie ababisa baane obobe bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, obasirie, ekiagera igo ore omwegenwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, ninkoruere ekeng’wanso inde nenkoro y’ogwancha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe nkoiraneria ng’a mbuya mono ase erieta riao, ekiagera nerigiya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye gwantooririe ase emechando yonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaiso aane nigo arigereretie ababisa baane inde nomochengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    }
  ],
