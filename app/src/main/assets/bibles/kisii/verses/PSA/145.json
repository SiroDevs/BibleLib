        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotogia obonene na obuya bwa Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 145:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one na omorwoti one, ninkobaake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe ’ngotogia erieta riao goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 145:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera rituko nimbe ’nkogotogia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nintogie erieta riao goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 145:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omonene, nagwenerete atogigwe mono;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obonene bwaye tibokomanyekana buna bore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 145:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeremo yao netogigwe ebiaare ase ebiaare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Mbirarie ogokora kwao kore okonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 145:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbe ’nkorengereria mono igoro y’obonene bwao bw’ogosikwa okonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igoro y’emeremo yao y’ogokumia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 145:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ’mbabe bakoraria ogokora kwao okonene gw’okoirokia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nainche nimbe ’nkoraria obonene bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 145:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbararie chinkuma chi’obuya bwao obonge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babe bagotera namariogi amanene gotogia oboronge bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 145:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are nobwanchani obonge, na amaabera amange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tari omwango ase okoba n’endamwamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo aichire nobwanchani bogendererete botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 145:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omuya ase abanto bonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nigo are namaabera ase ebitongwa biaye bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 145:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ebitongwa biao bionsi nigo bikogoakera ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "text": "na abachenu bao bonsi mbagotogie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 145:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbabe bakoraria obonene bw’oborwoti bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende babe bagokwana igoro y’okobua kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 145:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bamanyie Mwanyabaanto ogokora kwao okonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obonene bw’ogosikwa kw’oborwoti bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 145:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborwoti bwao nobwa kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okogambera kwao nigo kogendererete ase ebiaare bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo are omwegenwa ase amang’ana aye onsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oichire nobuya ase ogokora kwaye gwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 145:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo akobwata bonsi abakogwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akogororokia abwo bakumbirwe gochia inse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 145:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso y’ebitongwa bionsi nigo akorigereretie nogosemeria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.15",
            "verseOrgIds": [
              "PSA.145.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naye nigo okobia chindagera chiabo ase chingaki chigwenerete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.15",
            "verseOrgIds": [
              "PSA.145.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 145:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo okomaanora okoboko kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.16",
            "verseOrgIds": [
              "PSA.145.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwarua ebisio na goisanekia kera egetongwa kere moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.16",
            "verseOrgIds": [
              "PSA.145.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 145:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omonyene oboronge ase chinchera chiaye chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.17",
            "verseOrgIds": [
              "PSA.145.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omuya ase ogokora kwaye gwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.17",
            "verseOrgIds": [
              "PSA.145.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 145:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are ang’e ase abanto abwo bakomorangeria;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.18",
            "verseOrgIds": [
              "PSA.145.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bonsi bakomorangeria ase ekeene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.18",
            "verseOrgIds": [
              "PSA.145.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
