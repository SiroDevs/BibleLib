  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "86",
        "style": "c",
        "sid": "PSA 86"
      },
      "items": [
        {
          "text": "86",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora ogokonywa ekero ki’ogochandwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogosaba gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 86:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, integerera, onyigwe na ong’iranerie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo inde omotaka na omoremerwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 86:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orende omoyo one, ekiagera nigo nkoirogete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Nyasae one, intoorie inche omosomba oo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo ngosemeretie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 86:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, indorera amaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo nkorera asore omobaso boira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 86:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gokia omoyo one inche omosomba oo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera narentire omoyo one asore aye Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 86:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, aye nigo ore omuya na oyo okwabera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okoorokia obwanchani obonge ase abagokorangeria obakonye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 86:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, tegerera oigwe ogosaba kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igwa ekerero ki’ogosorora kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 86:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero inde nemechando nigo ngokorangeria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera aye nigo okonyigwa na kong’iraneria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 86:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, enyasae teri enga buna aye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose emeremo ende teri enga buna eyao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 86:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisaku bionsi gwatongete mbichiche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bitung’ame ase obosio bwao kogosasiima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbitogie erieta riao, aye Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 86:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye naye ore omonene, nigo ogokora amakumia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye naye bweka ore Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 86:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, inyorokererie enchera yao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nganetie kobwatia ekeene kiao; renda enkoro yane, erinde inyiroke erieta riao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 86:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene Nyasae one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nkoiraneria ng’a mbuya mono nenkoro yane yonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nindarie obonene bw’erieta riao goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 86:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki obwanchani bwao bogendererete botambe nigo bore obonene ase ’nde;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye kwabooririe omoyo one korwa aase abakuure.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 86:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae, abanto abaenenu banyimokeire kondwania esegi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekeombe ki’abaanto abatindi nigo bakorigia basirie obogima bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo tibakoirogeti nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 86:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende aye Omonene nigo ore Nyasae bw’amaabera na obuya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tori omwango bw’okoba nendamwamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ore nobwanchani botari koera, na obwegenwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 86:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing’iranerie na ondorere amaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ong’e inche omosomba oo chinguru chiao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "intoorie inche omwana bw’omosomba oo omokungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 86:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyorokie ekemanyererio ki’obuya bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.17",
            "verseOrgIds": [
              "PSA.86.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde abanto bangechete bakerore na gosookigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.17",
            "verseOrgIds": [
              "PSA.86.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
