{
  "id": "PSA.39",
  "number": "39",
  "bookId": "PSA",
  "reference": "Zaburi 39",
  "copyright": "© 2021 KENBS",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "PSA 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba kw’omonto ochandegete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngateeba: “Nindende orogendo rwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timbaisa gokora ebibe ekero ngokwana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimbeke omonwa one ekeokio",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero abakori amabe bare ase obosio bwane.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo narenge nkirete‐kiri, tinare gokwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tinaba na koremigwa konde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obororo bwane bokamenteka mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "enkoro yane ekaba ekoyia omorero ime yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero naare ndengereretie aya, omorero ogoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tinare konyara gwetanga ogokwana kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, imanyie omoerio bw’amatuko aane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekerengo ki’amatuko aane naki keng’ana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde imanye ng’a obogima bwane nobweng’e.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Amatuko kwang’ete nameng’e mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Engaki y’obogima bwane nigo ere buna teri gento ase obosio bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amaene, kera omonto, nonya bwetenenerete bokong’u,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agoeta bwango buna omwaga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaene, Mwanyabaanto nigo agotaara ore buna omogwekano okorora ase okorota;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agwechanda bosa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "asangereria enibo, korende tamanyeti gose ning’o orache koyeria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabono aye Omonene, inki nganyete?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naye bweka nsemeretie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntoorie korwa ase ogosaria kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tontiga nsekererwe noyio ore omoriri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nkirete‐kiri, tindi komumora omonwa one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera aye naye gwakorete ayio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusia egesusuro kiao asende;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naerire ase ogoakwa gw’okoboko kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero okorongeyia omonto ase okomotogonyera ase engencho y’ebibe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ogosiria obonene bwaye, koreng’ana buna ebigwankwa bikoria chianga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amaene, Mwanyabaanto nigo anga buna omwaga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, igwa ogosaba kwane, otegerere okorera kwane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tokira‐kiri ekero nkoiyeria amariga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera inche nomogeni oo inde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoeti buna chisokoro chiane chiarenge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intige, inyore chinguru chinyia ntararua ase ense, na ntabeo naende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.13",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.40",
    "number": "40",
