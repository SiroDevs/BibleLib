  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "PSA 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora ogokonywa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, engereria abanto abwo bakoengererania nainche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rwania abwo bakondwania!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bogoria enguba na eng’aya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "imoka onkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye orute abanto abwo bakombwatia ritimo na esimisi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ontebie ase omoyo one: “Ninche Omotooria oo.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo bakorigia gosiria obogima bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga babugwe na gosookigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo bagokora emeroberio emebe y’okong’ita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bairanigwe babe nobosooku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo tiga babe buna omoiriro okoirurukigwa nomwaga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omomalaika Omonene abe okobaiyeria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omosunte na oboterere bibe ase enchera bagoetera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omomalaika Omonene abe okobabwata abasirie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo bambekeire oboreba bobisi engencho ende etaiyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na bakunyire eirima ng’a basirie obogima bwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosirigwa tiga kobanyore mobosokano;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oboreba obwo bantegeire tiga bobabwate barabwo abanyene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bagwe imeo abanyene na gosirigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoyo one nogoke ase Omonene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gochenga ase engencho y’ogotooreka kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amauga onsi ay’omobere one nateebe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Aye Omonene, ning’o onga buna aye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, nigo ogotooria oyo otari ne chinguru korwa ase oyore ne chinguru komobua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nigo ogotooria oyo otari ne chinguru naende omoremerwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa ase oyo okomochanda.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Birori bi’oborimo nigo bakonyimokera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakomboria ase amang’ana ntamanyeti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo nigo bakong’akana amabe ase amaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nerusirie moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanto abwo barwarete",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo neboyetie eanga y’okweumia na goichana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngechanda ase okweng’ata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngasaba nturegete omotwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabechandera buna nigo barenge abasani baane gose abaminto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nabegete eanga y’okweumia, nturegete omotwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna omonto okweumia ekero ng’ina akuure.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekero narenge ase emechando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo basangererekanete amo bakagoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto batagwenerete, aba ntamanyeti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakaba bagonchecheria batari gotiga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatamoirogeti Omonene nigo banchayete na gonchecheria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakangecha bakaba bakondiananeria amaino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, ngoika ririri orabe koyarigereretie rioka?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Intaborie korwa ase ogosiria barobeirie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tooria obogima bwane korwa ase chindo echio!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ninkoiranerie ng’a mbuya mono agwo ase omosangererekano omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ningotogie ase omoganda omonene bw’abaanto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totiga ababisa baane bagoke igoro yane engencho ende etaiyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "totiga abwo bangechete bosa bagosimanera amaiso bankore bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo tibari gokwana amang’ana akorenta omorembe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakona-korigia amang’ana yobong’ainereria",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igoro y’abanto abwo bare abatoereru ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bagwasamia emenwa yabo bateeba:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.21",
            "verseOrgIds": [
              "PSA.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ahaa! Ahaa! Ntwayarora namaiso aito.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.21",
            "verseOrgIds": [
              "PSA.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, kwarorire amang’ana ayio, tokirakiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, tobaisa kobeera aare korwa asende!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene one, ore Nyasae one, tabobora, oimokerere igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde orwanerere oboronge bwane na amang’ana aane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Nyasae one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nacha ekiina kiane koreng’ana noboronge bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobaisa gotiga ababisa baane bagoke igoro yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobatiga bateebe: “Bono twamonyorire buna twaganetie.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tobatiga bateebe: “Bono twamobuire.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo bakogokera emechando yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga basookigwe na batantanigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bagwetogia igoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga baboigwe obosooku na ogochaywa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo banchete ng’a ng’egwe oboronge bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga baake eriogi ri’omogooko na omochengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagenderere goteeba: “Omonene noyo bw’obonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, nigo agokirie namaya omosomba oye akonyora!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio oromeme rwane ndogenderere koraria oboronge bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.28",
            "verseOrgIds": [
              "PSA.35.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogotogigwa kwao, omobaso boira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.28",
            "verseOrgIds": [
              "PSA.35.28"
            ]
          }
        }
      ]
    }
