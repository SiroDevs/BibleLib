        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora okorendwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one, igwa ekerero kiane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tegerera oigwe ogosaba kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero enkoro yane yarusirie moyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ngokorangeria korwa ase chinsinyo chi’ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye ondaae gochia egetare keria kere egetambe mono kombua.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye naye obotamero bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eburi enkong’u egonkengera korwa ase ababisa baane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing’a ribaga ingenderere komenya botambe ase eema yao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninganetie inyore oborendi obuya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inse y’ekiriri gie chimbaaba chiao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae kwaigure chiira chiane narire ase ogotiana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto bairogete erieta riao kwabaeire omwando obo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omentere omorwoti amatuko agenderere koba moyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emiaka yaye ebe ey’ebiaare ebinge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga agenderere botambe koba omorwoti ase obosio bwao aye Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obwanchani bwao bogendererete botambe, na obwegenwa bwao, bimorende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo nimbe ngotera ase ogotogia erieta riao botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende rituko ase rituko imbe ngoikerania chiira chiane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    }
  ],
