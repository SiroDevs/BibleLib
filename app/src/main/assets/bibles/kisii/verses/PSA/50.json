  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "PSA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosasiima gw’ekeene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gw’Asafu)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae omonguru, Nyasae Omonene, nigo agokwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agokwana na korangeria ense yonsi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa moocha goika bosongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa Sayoni, omochie omoikeranu bw’oboseera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae omorekire korwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae oito ngocha are, tagokirakiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omorero okoria nigo otang’aine bosio bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omwaga omotindi nigo omoetanaine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo akorangeria igoro na ense chibe birori,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero akonachera abanto baye ekiina, ogoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sangereria abanto baane abegenwa bache asende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakorete okobwatana kw’ogotianania nainche ase okorua ebing’wanso.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igoro nigo chikoraria oboronge bwa Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae omonyene nere omonachi ebiina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abanto baane, tegerera moigwe, inche nkwane!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe Abaisraeli, inche nimbe nkorua oborori bore mamincha yaino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche Nyasae inde Nyasae oino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinkobatogonyera ase engencho y’ebing’wanso biaino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebing’wanso biaino bi’ogosambwa nigo bire ase obosio bwane botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingwanchera chieri chikorwa ase ameeri aino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose chigoree chikorwa ase amaicho aino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera ching’iti chionsi chi’orosana nechiane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chiombe chilifu chire ase ebigoro nechiane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimanyete chinyoni chionsi chire ase ebitunwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne ching’iti chinde chionsi chikonagoetanana ase ense nechiane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Onye narenge nenchara, tinare kogotebia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ense, na ebinto bionsi bireo nebiane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Inche ne chinyama chie chieri nkoria?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose namanyinga e chimbori nkonywa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omoruere Nyasae ekeng’wanso gi’okoiraneria ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ikerania ase Oyore Igoro Mono chiira kwamorierete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndangerie ase engaki y’emechando;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche ninoboseemia, naye nontogie.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Nyasae nigo agotebia omokori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Naye mboronge ki obwate okonagwatora amachiiko aane?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose kona‐gokwana‐kwana okobwatana kwane kw’ogotianania?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo ogechete amorokererio ay’okorongeyia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gwatugutire amang’ana aane gochia magega.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero okorora omoibi, nigo ogwancherana nere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.18",
            "verseOrgIds": [
              "PSA.50.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nigo okobwatana nabatomani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.18",
            "verseOrgIds": [
              "PSA.50.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omonwa oo nigo ore omwango gokwana amang’ana ’obobe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.19",
            "verseOrgIds": [
              "PSA.50.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oromeme rwao nigo romanyete koroisia amang’ana ’obong’ainereria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.19",
            "verseOrgIds": [
              "PSA.50.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo ogoikaransa na konakogamba abanto bamino bobe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.20",
            "verseOrgIds": [
              "PSA.50.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okona‐kong’acha oyomino morwete enda eyemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.20",
            "verseOrgIds": [
              "PSA.50.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabeire gokona‐gokora ayio, nainche nkirete‐kiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okagete ng’a inche nigo inde buna aye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende bono nkogotogonyera nde na kobeka ayio ase obosio bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.21",
            "verseOrgIds": [
              "PSA.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe aba mwanyebire inche Nyasae, rengereria amang’ana aya mono;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.22",
            "verseOrgIds": [
              "PSA.50.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onye taibo, nimbaake mbatandorane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.22",
            "verseOrgIds": [
              "PSA.50.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na monto onde tari orabatoorie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.22",
            "verseOrgIds": [
              "PSA.50.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onde bwensi okong’iraneria ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.23",
            "verseOrgIds": [
              "PSA.50.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okwo nakwo ekeng’wanso ki’ogonsika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.23",
            "verseOrgIds": [
              "PSA.50.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onde bwensi okobwatia chinchera chi’oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.23",
            "verseOrgIds": [
              "PSA.50.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio nimorentere ogotooreka kwane inche Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.23",
            "verseOrgIds": [
              "PSA.50.23"
            ]
          }
        }
      ]
    }
