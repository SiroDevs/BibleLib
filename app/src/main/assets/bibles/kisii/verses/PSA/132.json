    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotogia Obomenyo Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 132:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, oinyore Daudi, ase engencho y’obokong’u bwonsi bwamonyoorete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 132:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oinyore buna ariete eira na gotiana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "asore aye Omonene ore Chinguru chia Yakobo, agateeba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 132:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tingosoa nyomba mwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tinkoriina borere korara;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 132:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tingwancha korara chitoro, gose gosundoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 132:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika inyore aase,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo arabe obomenyo bw’Oyore Chinguru chia Yakobo.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 132:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama! Agwo Efarata tokaigwa amang’ana igoro y’Esanduki y’Okobwatana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tokayenyora aaria ase orosana rwa Yearimu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 132:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inchuo togende ase obomenyo bw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tosasiime agwo ase egeteni kiaye kia amagoro!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 132:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, imoka ochiche aase ao ogotimokera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye amo n’Esanduki eria ekworokia okobua kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 132:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga abakuani bao beboyie oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto bao abachenu babe bagoaka amariogi y’omogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 132:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho ya Daudi, omosomba oo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobaisa kwanga korigereria omoakwa amaguta oo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 132:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, tokonyaara gotiga eira eyio",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwarierete Daudi ase ogotiana, ogateeba:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Oyomo bw’oroiboro rwao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimobeeke aikaranse ase ekerogo kiao ki’obogaambi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 132:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bao kobarabwate okobwatana kwane kw’ogotianania,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oborori bwane ’ndaborokererie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rirorio abana baabo boigo ’mbabe bagoikaransa ase ekerogo kiao ki’obogaambi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kogenderera botambe.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 132:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene ochorire Sayoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo aganetie obe obomenyo bwaye, oteebire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 132:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aase aa nao obotimokero bwane bwa botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aa nao ’ndabe ’nkomenya, ekiagera naanchire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 132:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninsesenie omochie oyo obe n’ebinto bionsi biganeirie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abaremeire endagera nimbaigotie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 132:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimboyie abakuani b’omochie oyo nogotooreka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abachenu baye ’mbabe bagoaka amariogi y’omogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 132:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroro agwo nimererie Daudi orogunchara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.17",
            "verseOrgIds": [
              "PSA.132.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nimwokerie omoakwa amaguta one etaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.17",
            "verseOrgIds": [
              "PSA.132.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 132:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninsookie ababisa baye kegima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.18",
            "verseOrgIds": [
              "PSA.132.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende egutwa y’omotwe oye omonyene negenderere komekameka.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.18",
            "verseOrgIds": [
              "PSA.132.18"
            ]
          }
        }
      ]
    }
  ],
