  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PSA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora oboronge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene one, Nyasae one, naye ngotamera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "intoorie korwa ase abachandi baane, ’nkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye taibo, nigo barantaborane bare buna chindo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "’mbankurure gochia aase omonto onde otache gontooria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene one, Nyasae one, onye nakorire amang’ana aya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onye nakorire amabe namaboko aane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye naakanire omosani one",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amabe, gose nasakoire ebinto bi’omobisa one ase engencho ende etaiyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "rirorio tiga omobisa one ambwatie na kombwata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio antiringere inse egere asirie obogima bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio ansarerie amasikani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, imoka kore nendamwamu yao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "imokerera igoro orwanie ekeririanda ki’ababisa baane!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inchuo onkonye! Aye gwachikiire ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’ebisaku bionsi tiga basangererekane bagoetanane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obagambere korwa ase ekerogo kiao ki’obonene aaria igoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, naye okogamba na konachera abanto bonsi ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, onachere inche ekiina koreng’ana noboronge bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna ntari na komocha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga ebibe bi’abakori amabe biere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende omonto omooronge omotenenie bokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Nyasae omonyene oboronge nigo okorenga chinkoro na emioyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nere enguba yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo agotooria abare ne chinkoro chindonge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo are omogambi omooronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kera rituko nigo akoba nekeririanda ase abakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto karaange gweitia, Nyasae natierie omoro oye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "natinge obota bwaye abobeke ang’e.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oroisirie ebirwanero biaye ebiogoita omonto buna oyio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akore emegwe yaye esambe buna omorero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonyabibe nigo aichire nobobe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.14",
            "verseOrgIds": [
              "PSA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo are morito, oborito bw’ogosaria na gakoibora oibara oborimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.14",
            "verseOrgIds": [
              "PSA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio nigo agokunya eirima entambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.15",
            "verseOrgIds": [
              "PSA.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ogwa ime y’eirima eyio ere omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.15",
            "verseOrgIds": [
              "PSA.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emechando yaye nigo ekomoiranera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.16",
            "verseOrgIds": [
              "PSA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogokora kwaye okobe kwamogwera ere omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.16",
            "verseOrgIds": [
              "PSA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’akere Omonene ng’a mbuya mono ase engencho y’oboronge bwaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.17",
            "verseOrgIds": [
              "PSA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimotererie Omonene ogoteera kw’ogotogia erieta riaye, oyore Igoro Mono kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.17",
            "verseOrgIds": [
              "PSA.7.17"
            ]
          }
        }
      ]
    }
  ],
