  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "73",
        "style": "c",
        "sid": "PSA 73"
      },
      "items": [
        {
          "text": "73",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "text": "(73—89)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Oboronge bwa Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gw’Asafu)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 73:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, Nyasae nigo are omuya mono ase Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ase abwo bare ne chinkoro chichenegete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 73:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagoro aane konya abeire ang’e kogochwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "konya nabeire ang’e gotererigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 73:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera nigo nabeete ne ribero ase abanto abaenenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero naroche ng’a abwo ababe nigo basesenirie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 73:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo tibari konyorwa nobokong’u bonde ase obogima bwabo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emebere yabo nigo ere emiya, naende emenoru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 73:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibabwati emechando buna abanto bande babwate;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibari konyora amaakwa buna abande.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 73:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, obwerori nigo boetanaine amagoti abo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obotindi nabwo beboyetie buna eanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 73:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso abo nigo akogirigenta nobonoru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obotantanu bw’ebirengererio bie chinkoro chiabo nobonge mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 73:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bagochecheria abande na gokwana ase okobakorera bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bakweimokereria igoro na kobatianera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 73:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emenwa yabo nigo egokwana amang’ana amabe are mamincha ya igoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chimeme chiabo chiasokia ayakogenda ase ense engima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 73:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio abanto babo nigo bakoonchoka baababwatia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakwong’otera amaache abo are amange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 73:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bateeba, “Naki Nyasae arakore amanye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Ere Oyore Igoro Mono nabwate obong’aini?”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 73:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Naboigo abakori amabe bare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "botambe nigo bare buya na bagendererete komenta obotenenku bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 73:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, mbosa nabeire ndendete enkoro yane ebe echenegete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbosa nabeire ngoisaba amaboko aane ng’a timba nokomocha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 73:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobaso boira nabeire nkonyora amaakwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kera emambia nabeire nkonyora egesusuro gi’okondongeyia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 73:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nakwanete amang’ana buna ayio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo narenge gocha koba oyotari omwegenwa ase ebiaare bi’abaanto bao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 73:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ekero nabeete nkorengereria komanya engencho y’amang’ana ayio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amang’ana ayio akaba amakong’u ase ’nde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 73:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika ekero nasoete ime ase obomenyo obochenu bwa Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.17",
            "verseOrgIds": [
              "PSA.73.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio nario namanyete omoerio bw’abanyabibe buna ore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.17",
            "verseOrgIds": [
              "PSA.73.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 73:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, aye Omonene nigo okobabeeka aase are aaterere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.18",
            "verseOrgIds": [
              "PSA.73.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo okobaturunkania kwabasiria kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.18",
            "verseOrgIds": [
              "PSA.73.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 73:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bagosirigwa rioka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.19",
            "verseOrgIds": [
              "PSA.73.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoerio obo nomoondoko okobasiria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.19",
            "verseOrgIds": [
              "PSA.73.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 73:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo banga buna chindoto omonto akweba mambia gakoboka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.20",
            "verseOrgIds": [
              "PSA.73.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, naboigo bare asore buna omogwekano okororwa ase okorota,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.20",
            "verseOrgIds": [
              "PSA.73.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero okoimoka nigo okweba ebieni biabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.20",
            "verseOrgIds": [
              "PSA.73.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 73:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero narenge nobororo ase omoyo ime,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.21",
            "verseOrgIds": [
              "PSA.73.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enkoro yane ekaba buna eyabetirwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.21",
            "verseOrgIds": [
              "PSA.73.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 73:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nabeete omoriri mono, tinamanya gento;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.22",
            "verseOrgIds": [
              "PSA.73.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkaba buna eng’iti y’orosana ase obosio bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.22",
            "verseOrgIds": [
              "PSA.73.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 73:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya naboigo, inche nigo ngendererete kobeera asore botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.23",
            "verseOrgIds": [
              "PSA.73.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo obwatete okoboko kwane gw’okorio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.23",
            "verseOrgIds": [
              "PSA.73.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 73:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo okondaa na gonsemia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.24",
            "verseOrgIds": [
              "PSA.73.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na magega y’ayio noche kong’ira onsoyie ase obonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.24",
            "verseOrgIds": [
              "PSA.73.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 73:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Ning’o naende imbwate aaria igoro, otatiga aye bweka?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.25",
            "verseOrgIds": [
              "PSA.73.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero nkobwate, gento tikeri aiga ase ense nganetie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.25",
            "verseOrgIds": [
              "PSA.73.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 73:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobere one na enkoro yane nabo biranyare koborwa chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.26",
            "verseOrgIds": [
              "PSA.73.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende aye Nyasae, naye ore egetare gi’enkoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.26",
            "verseOrgIds": [
              "PSA.73.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende naye egetare kiane goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.26",
            "verseOrgIds": [
              "PSA.73.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 73:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, abanto abwo bagweatanana korwa asore nabasire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.27",
            "verseOrgIds": [
              "PSA.73.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo orasirie abwo batari abegenwa asore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.27",
            "verseOrgIds": [
              "PSA.73.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 73:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ase ’nde inche, nigo ere buya mono kobeera ang’e na Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.28",
            "verseOrgIds": [
              "PSA.73.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene obeire obotamero bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.28",
            "verseOrgIds": [
              "PSA.73.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninyare koraria emeremo yaye yonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.28",
            "verseOrgIds": [
              "PSA.73.28"
            ]
          }
        }
      ]
    }
