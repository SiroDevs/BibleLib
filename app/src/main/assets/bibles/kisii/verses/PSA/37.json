  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "PSA 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omoerio bw’abaanto abakori amabe na oyo bw’abaanto abaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togechigwa ase engencho y’abakori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.1",
            "verseOrgIds": [
              "PSA.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "toba ne ribero ase abakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.1",
            "verseOrgIds": [
              "PSA.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo mbasirigwe bwango, basire buna obonyansi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.2",
            "verseOrgIds": [
              "PSA.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "basusane buna ebimeri ebibese.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.2",
            "verseOrgIds": [
              "PSA.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosemerie Omonene okore ayare amaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.3",
            "verseOrgIds": [
              "PSA.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio nario oramenye ase ense, obe korendire buya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.3",
            "verseOrgIds": [
              "PSA.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goka ase Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.4",
            "verseOrgIds": [
              "PSA.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nakoe okogania gw’enkoro yao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.4",
            "verseOrgIds": [
              "PSA.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erue ase Omonene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.5",
            "verseOrgIds": [
              "PSA.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mosemerie ere bweka, nere naoboseemia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.5",
            "verseOrgIds": [
              "PSA.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene naorokie oboronge bwao buna akoorokia oborabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.6",
            "verseOrgIds": [
              "PSA.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekeene kiao buna amasase a mobaso gati.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.6",
            "verseOrgIds": [
              "PSA.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obe n’obotoereru ase obosio bw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.7",
            "verseOrgIds": [
              "PSA.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoganye noboremereria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.7",
            "verseOrgIds": [
              "PSA.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Togechigwa nomonto okogenderera buya ase enchera yaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.7",
            "verseOrgIds": [
              "PSA.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omonto oyio okoroberia ogosaria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.7",
            "verseOrgIds": [
              "PSA.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwetange korwa ase endamwamu, tiga ekeririanda kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.8",
            "verseOrgIds": [
              "PSA.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Togechigwa; okogechigwa nigo koragere okore ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.8",
            "verseOrgIds": [
              "PSA.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyabibe mbasirigwe kegima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.9",
            "verseOrgIds": [
              "PSA.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abamoganyete Omonene mbaire ense ebe omwando obo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.9",
            "verseOrgIds": [
              "PSA.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netigarete engaki ensinini, na omokori amabe asirigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.10",
            "verseOrgIds": [
              "PSA.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nobe gokorigereria mono aase aye, takonyorekana oreo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.10",
            "verseOrgIds": [
              "PSA.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaitongo mbaire ense ebe omwando obo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.11",
            "verseOrgIds": [
              "PSA.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na barabwo mbagoke na goisaneka ase obonge bw’omorembe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.11",
            "verseOrgIds": [
              "PSA.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo agokora omooroberio bw’ogoita oyore omooronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.12",
            "verseOrgIds": [
              "PSA.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na komoriananeria amaino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.12",
            "verseOrgIds": [
              "PSA.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nasekerere omokori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.13",
            "verseOrgIds": [
              "PSA.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera aroche ng’a rituko ri’ogosirigwa kwaye ndichiche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.13",
            "verseOrgIds": [
              "PSA.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori amabe nigo bagosomora emeyio yabo na batinga amata abo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.14",
            "verseOrgIds": [
              "PSA.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde baite abanto abataka na abaremeire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.14",
            "verseOrgIds": [
              "PSA.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baite na abakobwatia chinchera chi’oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.14",
            "verseOrgIds": [
              "PSA.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeyio yabo nebete chinkoro chiabo abanyene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.15",
            "verseOrgIds": [
              "PSA.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amata abo nabunwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.15",
            "verseOrgIds": [
              "PSA.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebinto ebike omonto omonyaboronge abwate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.16",
            "verseOrgIds": [
              "PSA.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bire ebiya kobua ebinge biria abakori amabe abange babwate.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.16",
            "verseOrgIds": [
              "PSA.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori amabe mbaurwe chinguru echi babwate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.17",
            "verseOrgIds": [
              "PSA.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende Omonene nagenderere koa abanyaboronge chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.17",
            "verseOrgIds": [
              "PSA.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo amanyete amatuko ya abamoirogete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.18",
            "verseOrgIds": [
              "PSA.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omwando obo nogenderere kobao kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.18",
            "verseOrgIds": [
              "PSA.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo tibari gosookigwa ase chingaki chi’amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.19",
            "verseOrgIds": [
              "PSA.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase chingaki chi’enchara nigo bakoigota.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.19",
            "verseOrgIds": [
              "PSA.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abakori amabe mbasirigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.20",
            "verseOrgIds": [
              "PSA.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ababisa ba Omonene nigo bare buna obuya bw’ebisicha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.20",
            "verseOrgIds": [
              "PSA.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo barasire, ee, mbasire buna erioki rigosira kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.20",
            "verseOrgIds": [
              "PSA.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo akoira egento singo tagokeirania,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.21",
            "verseOrgIds": [
              "PSA.37.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende omonto omooronge nigo are namaabera na korua ebiegwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.21",
            "verseOrgIds": [
              "PSA.37.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abw’Omonene asesenirie mbaire ense ebe eyabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.22",
            "verseOrgIds": [
              "PSA.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abwo aragereirie mbasirigwe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.22",
            "verseOrgIds": [
              "PSA.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo akobeka orogendo rw’omonto omooronge chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.23",
            "verseOrgIds": [
              "PSA.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kogokigwa nabarabwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.23",
            "verseOrgIds": [
              "PSA.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio naisa kogochwa, takogwa inse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.24",
            "verseOrgIds": [
              "PSA.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene namobwatete okoboko kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.24",
            "verseOrgIds": [
              "PSA.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo narenge omwana, bono nagotire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.25",
            "verseOrgIds": [
              "PSA.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende tinana-korora omonto omooronge ogotigwa bosa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.25",
            "verseOrgIds": [
              "PSA.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose abana baye bakoborwa endagera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.25",
            "verseOrgIds": [
              "PSA.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio nigo akogenderera kona-korua ebiegwa na korua singo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.26",
            "verseOrgIds": [
              "PSA.37.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abana baye nigo barasesenigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.26",
            "verseOrgIds": [
              "PSA.37.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga gokora amabe, kora ayare amaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.27",
            "verseOrgIds": [
              "PSA.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igo nario orachie kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.27",
            "verseOrgIds": [
              "PSA.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo anchete oboronge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.28",
            "verseOrgIds": [
              "PSA.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tagotiga abachenu baye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.28",
            "verseOrgIds": [
              "PSA.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo mbarendwe goika kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.28",
            "verseOrgIds": [
              "PSA.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ororeria rw’abakori amabe ndosirigwe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.28",
            "verseOrgIds": [
              "PSA.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyene oboronge mbaire ense ebe eyabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.29",
            "verseOrgIds": [
              "PSA.37.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio bagenderere komenyao botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.29",
            "verseOrgIds": [
              "PSA.37.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonwa bw’omonto omooronge nigo agokwana amang’ana yobong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.30",
            "verseOrgIds": [
              "PSA.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oromeme rwaye nigo rogosokia ay’ekeene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.30",
            "verseOrgIds": [
              "PSA.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amachiiko a Nyasae oye nigo abeerete ase enkoro y’omonto oyio;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.31",
            "verseOrgIds": [
              "PSA.37.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase agoeta tari gotererigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.31",
            "verseOrgIds": [
              "PSA.37.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PSA 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo agotengera omonto omooronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.32",
            "verseOrgIds": [
              "PSA.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio origia chinchera chi’okomoita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.32",
            "verseOrgIds": [
              "PSA.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene tagotiga omonto omooronge ase okobua kw’omokori",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.33",
            "verseOrgIds": [
              "PSA.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amabe, gose takomotiga abugwe ekero asoeirwe ase ekegambero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.33",
            "verseOrgIds": [
              "PSA.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PSA 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gany’Omonene na obwatie enchera yaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.34",
            "verseOrgIds": [
              "PSA.37.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere nakoimokererie igoro akoe ense ebe eyao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.34",
            "verseOrgIds": [
              "PSA.37.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio norigererie orore buna abanyabibe bagosirigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.34",
            "verseOrgIds": [
              "PSA.37.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PSA 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narorire omokori amabe otindire ase obomwenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.35",
            "verseOrgIds": [
              "PSA.37.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akaba okoranda buna emecharake egokina ase amaroba amatobu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.35",
            "verseOrgIds": [
              "PSA.37.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "PSA 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega y’amatuko amake ngaetera aase agwo, korende tarengeo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.36",
            "verseOrgIds": [
              "PSA.37.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkamorigia, korende tinamonyora aande.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.36",
            "verseOrgIds": [
              "PSA.37.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "PSA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rigereria omonto omoikeranu, ee, origererie omonto ore nenkoro endonge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.37.37",
