    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora ogokonywa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Zab 40:13-17)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogosaba gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 70:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, koranche ontoorie!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, oche bwango onkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 70:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo barigetie gosiria obogima bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga basookigwe na gotantanigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abwo baganetie ng’a obobe bonyore inche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bairanigwe magega na gochaywa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 70:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bagonchaya na goteeba: “Kiamonyorire!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga bakirigwe-kiri ase obosooku bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 70:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bonsi bagokorigia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bakogokere na kogochengera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo banchete ogotooreka kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bagenderere goteeba: “Nyasae atogigwe!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 70:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo inde omotaka na omoremerwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Nyasae, inchwo bwango onkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye naye Omokonyi one, na Omotooria one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, totebana!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    }
  ],
