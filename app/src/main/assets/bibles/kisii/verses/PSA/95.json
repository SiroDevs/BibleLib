  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "95",
        "style": "c",
        "sid": "PSA 95"
      },
      "items": [
        {
          "text": "95",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abanto bonsi, togia Omonene!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 95:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchuo, tomoterere Omonene Nyasae nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inchwo, tomochengere oyore egetare ki’ogotooreka gwaito!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 95:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchuo, togende ase obosio bwaye ase okomoakera ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tomochengere namatera ay’ogotogia!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 95:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki Omonene nere Nyasae ore omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere Omorwoti omonene obuete chinyasae chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 95:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo abwatete amakura ’ense ase okoboko kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo nebitunwa ebitambe bire ebiaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 95:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyancha neyaye, ekiagera nere oyetongete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okoboko kwaye nakwo kwabombete ense enyomo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 95:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchuo, twekumbe ase obosio bw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "totung’ame asare, ekiagera nere ototongete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 95:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nere Nyasae oito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na intwe nigo tore abanto b’oborisia bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo tore ching’ondi chire ase oborendi bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki yare koba buya onye rituko ria reero mwategerera eriogi riaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 95:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timokong’ia chinkoro chiaino, buna abakoro bakorete aaria Meriba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna bakorete ase rituko riria aaria Masa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        },
        {
          "text": "agwo ase erooro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 95:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaria chisokoro chiaino nigo chianteemete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya chiaroche emeremo yane nigo chiandengete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 95:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engaki y’emiaka emerongo ene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nagechetigwe nekiaare keria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngateba, “Abanto aba nabasareku ase chinkoro chiabo ime,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibaraareti chinchera chiane.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 95:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio ngatiana ase endamwamu yane",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a tibagosoa ase ogotimoka kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    }
  ],
