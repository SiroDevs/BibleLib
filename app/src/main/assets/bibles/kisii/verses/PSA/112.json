  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "112",
        "style": "c",
        "sid": "PSA 112"
      },
      "items": [
        {
          "text": "112",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omogooko bw’omonto omoirogete Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 112:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togia Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nasesenirie omonto oyio omoirogete Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogokirie mono koigwera amachiiko aye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 112:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oroiboro rwaye ’ndobe n’okobua ase ense;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiaare ki’abare ne chinkoro chindonge ’ngesesenigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 112:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obotenenku na obonda ’mbibe ase enyomba yaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oboronge bwaye ’mbogenderere kobao botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 112:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana omobaso okobara ase omosunte, Omonene nabo ogochera abanyaboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ore nobuya, n’amaabera, na oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 112:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto ore n’amaabera na okorua ebinto singo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo ogokora amang’ana aye onsi ase oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 112:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonyaboronge takonyegerigwa nonya ng’ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabe okoinyorwa kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.6",
            "verseOrgIds": [
              "PSA.112.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 112:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere takwoboa kagotebigwa amang’ana amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "enkoro yaye nigo ere endemu esemeretie Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.7",
            "verseOrgIds": [
              "PSA.112.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 112:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkoro yaye teri koirianyeka gose kwoboa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo akoremereria goika abachaandi baye babugwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 112:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo akoa abataka ebiegwa ore n’omoyo omorabu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oboronge bwaye ’mbogenderere kobao kare na kare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "orogunchara rwaye ’ndokiine ase ogosikwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.9",
            "verseOrgIds": [
              "PSA.112.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 112:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero omonto omonyabibe akorora ayio, nigo agoichana ogeechigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oriania amaino aye, orea osira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Okogania kw’omonyabibe nigo kogosira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.10",
            "verseOrgIds": [
              "PSA.112.10"
            ]
          }
        }
      ]
    }
  ],
