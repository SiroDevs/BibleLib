  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "77",
        "style": "c",
        "sid": "PSA 77"
      },
      "items": [
        {
          "text": "77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoremigwa ase chingaki chi’obokong’u",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gw’Asafu)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 77:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkorera nde ase Nyasae neriogi rinene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nkorera mono asare ng’a anyigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 77:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase chingaki chi’emechando nigo nkorigia Omonene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase obotuko nigo nkorambora okoboko kwane ase ogosaba ntari korosa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoyo one nigo okwanga koremigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 77:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nkoinyora Nyasae, nigo nkorera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero nkomorengereria, nigo ngokwa omoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 77:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nigo ogotanga amaiso aane takonyora chitoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo nchandegete mono, tinkonyara gokwana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 77:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nkoba nkorengereria igoro y’amatuko a kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkoinyora emiaka ya kare buna yarenge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 77:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase obotuko obogima nigo nkoinyora amatera aane:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nkoba nkorengereria ase enkoro yane ime, neriga‐rigia na kweboria:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 77:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Omonene natotigire kegima?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tagotororera amaabera rinde?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 77:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Obwanchani bwaye bwa botambe mbwaerire kegima?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Chiira chiaye nchiaikire omoerio?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 77:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo ebire koba omonyamaabera?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Nigo abeire nendamwamu, goika osiekire amabeebe?”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 77:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ngateeba, “Obo nobororo bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eye nengaki okoboko gw’okorio kw’Oyore Igoro Mono gwantomeire.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 77:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’inyore ogokora kwao aye Omonene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ning’inyore amakumia ao a kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 77:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbe nkorengereria igoro y’emeremo yao yonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na imbe nkona‐koiranerera ogokora kwao gwe chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 77:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, chinchera chiao nigo chire chinchenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nenyasae ereri ere enene buna Nyasae oito?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 77:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo ore Nyasae ogokora amakumia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwaorokirie okobua kwao ase egati ya Mwanyabaanto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 77:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo gwatooretie abanto bao nokoboko kwao koramboire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto abwo nigo barenge ab’ororeria rwa Yakobo na orwa Yusufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 77:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, ekero amaache akorooche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ekero akorooche, nigo akwoboete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chindiba chikanyegerigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 77:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amare agaitera amaache;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.17",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinkoba chigaaka korwa igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.17",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinsara chiao chikamesa ase chinsemo chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.17",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 77:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okogukura gw’enkoba nigo kwarenge ime ase ekerambauti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.18",
            "verseOrgIds": [
              "PSA.77.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense egatengecha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.18",
            "verseOrgIds": [
              "PSA.77.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
