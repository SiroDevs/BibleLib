  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "PSA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omorwoti omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ense na ebinto bire aroro nebia Omonene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oboiko bwonsi nobwaye, amo nabaanto bamenyeteo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo abegete oboroso bwaye igoro ase chinyancha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akabokong’ia igoro ase chindooche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oragwenere gotiira ase egetunwa kia Omonene?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oragwenere gotenena aase aye aachenu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomonto oria obwate amaboko atari na komocha, na enkoro echenegete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "noria otari gosasiima chinyasae chi’oborimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose gotiana ase obong’ainereria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio nonyore ogosesenigwa korwa ase Omonene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nanyore oboronge korwa ase Nyasae ore ogotooreka kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo ekegori ki’abakomorigia kere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakorigia barore obosio bwa Nyasae o Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe ebiita, imokereria emekorogoto yaino igoro!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe ebiita bia kare, igoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde Omorwoti bw’obonene asoe ime!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Omorwoti oyio bw’obonene nere ng’o?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere Omonene ore ne chinguru na okobua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere Omonene, omobui ase chiseegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe ebiita, imokereria emetwe yaino igoro!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.9",
            "verseOrgIds": [
              "PSA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe ebiita bia kare, igoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.9",
            "verseOrgIds": [
              "PSA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde Omorwoti bw’obonene asoe ime!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.9",
            "verseOrgIds": [
              "PSA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Omorwoti oyio bw’obonene nere ng’o?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.10",
            "verseOrgIds": [
              "PSA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere Omonene bw’Emeganda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.10",
            "verseOrgIds": [
              "PSA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere n’Omorwoti bw’Obonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.10",
            "verseOrgIds": [
              "PSA.24.10"
            ]
          }
        }
      ]
    }
  ],
