      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okomotogia Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
