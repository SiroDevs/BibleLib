{
  "id": "PSA.41",
  "number": "41",
  "bookId": "PSA",
  "reference": "Zaburi 41",
  "copyright": "© 2021 KENBS",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "PSA 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba kw’omonto omorwaire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto oyo ogwechandera abataka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero aranyorwe nemechando, Omonene namokonye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene amorende na komokorera agenderere koba moyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde arokwe oyosesenirie ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene tagotiga ababisa bamokorere buna banchete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene namorende ekero are borere arwarete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namogusuerie oborwaire bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo nateebete: “Omonene, indorera amaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ingwenie omoyo one, ekiagera nakorire ebibe asore.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa baane nigo bagokwana amang’ana amabe igoro yane, bateba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Omonto oyo indi arakwe na erieta riaye riebwe kegima?”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onde bwensi ogocha kondora nigo agokwana amang’ana yoborimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "enkoro yaye nigo egosangereria amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio ogenda isiko oraria amang’ana ayio amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bonsi bangechete nigo bakomonyererana igoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakorire omooroberio bw’ogonkora bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bagoteeba: “Noborwaire boramoite bwamonyorire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "takoboka naende korwa ase araire”.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya nomosani one negenete, tware koragera komo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ong’akire chintacho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, ndorera amaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngwenie, erinde ing’akane ababisa baane obobe bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa baane tibagochenga igoro yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio nimanye ng’a aye nogokirie nainche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye gwankonyire, ekiagera tindi na komocha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwambekire gotenena ase obosio bwao kogenderera botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene Nyasae bw’Abaisraeli, atogigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna yarenge korwa kare nabo erabe goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amina. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.42",
    "number": "42",
