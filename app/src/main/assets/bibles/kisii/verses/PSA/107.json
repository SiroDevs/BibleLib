            "sid": "PSA 107:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moakere Omonene ng’a mbuya mono, ekiagera ere nomuya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.1",
            "verseOrgIds": [
              "PSA.107.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "no’bwanchani bwaye nigo bogendererete goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.1",
            "verseOrgIds": [
              "PSA.107.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 107:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abw’Omonene abooretie tiga bakwane igo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.2",
            "verseOrgIds": [
              "PSA.107.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo aboretie korwa ase okoboko kw’omochaandi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.2",
            "verseOrgIds": [
              "PSA.107.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
