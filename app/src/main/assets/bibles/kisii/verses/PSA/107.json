          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo nigo babete bakona goetanana ase erooro enyomo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.4",
            "verseOrgIds": [
              "PSA.107.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibanyorete mochie onde ase baare komenya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.4",
            "verseOrgIds": [
              "PSA.107.4"
            ]
          }
        }
      ]
    },
    {
