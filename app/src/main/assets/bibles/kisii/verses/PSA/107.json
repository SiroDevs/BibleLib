          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obasangereirie obarentire korwa ase chinse ao ao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.3",
            "verseOrgIds": [
              "PSA.107.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa moocha na bosongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.3",
            "verseOrgIds": [
              "PSA.107.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa sugusu na Irianyi.",
