  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "92",
        "style": "c",
        "sid": "PSA 92"
      },
      "items": [
        {
          "text": "92",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera kw’ogotogia Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gw’Esabato)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 92:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ere buya gokoakera aye Omonene Nyasae ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na goteera ase ogotogia erieta riao, aye Nyasae Ore Igoro Mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 92:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera emambia nigo ere buya koraria obwanchani bwao bogendererete botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kera obotuko koraria obwegenwa bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 92:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ase okobugia obokano bore ne chinga ikomi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amakano ande are namariogi amaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 92:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ogokora kwao nigo kongogetie;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninchenge ase engencho y’emeremo y’amaboko ao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 92:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, emeremo yao nigo ere emenene mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebirengererio biao nigo bire ebia ime mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 92:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omoriri takonyara kobimanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oyo otari nobong’aini takonyara komanya amang’ana buna ayio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 92:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori amabe nabaisa koreereta buna obonyansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abakori ebibe bonsi babe bagosicha buya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende omoerio obo nogosirigwa goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 92:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nigo ore omonene mono kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.8",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 92:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Naama! Ababisa bao mbasirigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abakori ebibe bonsi mbasiarerwe gochia aande onsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 92:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwakinirie orogunchara rwane rwabeire buna orw’eng’era,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwang’umoreire amaguta amayia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 92:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narorire namaiso aane ababisa baane bakobugwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naigure namato aane igoro y’abakori amabe abanyimokerete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 92:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonyene oboronge naseboke buna omokendo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nakine buna omocharake o Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 92:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo basimekire ase enyomba y’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baragenderere koreereta ase chigoora chia Nyasae oito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 92:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bakogenderera goseboka nonya bagotire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baragenderere kobesea.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 92:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio nigo akworokia ng’a Omonene nigo are omonyene oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nere egetare kiane, na obokorekanu tibori ime yaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    }
  ],
