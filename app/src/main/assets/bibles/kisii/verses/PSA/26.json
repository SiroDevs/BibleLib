  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "PSA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba kw’omonto omuya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ing’a oboronge bwane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nabeire ntari na komocha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo ngosemeretie aye Omonene ntari ne chitang’u‐tang’u.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, inteeme na ondenge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "orenge enkoro yane na ebirengererio biane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ndigereretie obwanchani bwao bogendererete botambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gotaara ase obwegenwa bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindi gosanga nabanyaborimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tindi kogosoria nabang’ainereria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo ngechete gosanga nabaanto bagokora amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na tingwancha goikaransa amo nabaanto abakayayu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ngoisaba amaboko aane ase okoorokia ng’a tindi na komocha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio naetanana egesasiimero kiao, aye Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "imba ngoteera neriogi rinene gokoiraneria ng’a mbuya mono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koraria ogokora kwao kw’ogokumia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, inche nigo nyanchete obomenyo bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aase obonene bwao bore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosiria omoyo one ekero ogosiria abanyabibe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose obogima bwane ekero ogosiria abaiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo bagokora emeroberio y’obonyaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaboko abo a borio nigo aichire namaaki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo inde norogendo rotari na komocha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "indorere amaabera na omboorie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagoro aane nigo agotenena aase ateremu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nintogie Omonene ase egati y’omosangererekano omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    }
  ],
