      },
      "items": [
        {
          "text": "138",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba Kw’ogoaka Ng’a Mbuya Mono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 138:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nigo ’nkogoakera ng’a mbuya mono n’enkoro yane yonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ningoterere na kogotogia ase obosio bwe chinyasae.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 138:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ’nkogosasiima ndigereretie gochia ase Hekalu yao Enchenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naaka ng’a mbuya mono ase erieta riao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase engencho y’obwanchani bwao bogendererete botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase obwegenwa bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye gwakorire eira yao koba enene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goetania onsi aya erieta riao riatoteebetie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 138:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko riria nakorangeretie, nigo kwanyigwete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okaremia omoyo one, okambeeka chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 138:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, abarwoti bonsi b’ense ’mbagotogie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero baraigwe amang’ana akorwa ase omonwa oo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 138:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’mbabe bagotera igoro y’ogokora kwao, aye Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera obonene bwao nigo bore obonene mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 138:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nony’Omonene ore igoro aare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo arooche abanto abaitongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abare abaenenu nigo akobamanya kobare aare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 138:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba ngoeta ase egati y’emechando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo ondendete ngenderere koba moyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo okorambora okoboko kwao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igoro y’ababisa baane bare n’endamwamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "n’okoboko kwao gw’okorio gwantooria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 138:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nonyare goikerania aria kwandierete eira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera obwanchani bwao nigo bogendererete goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tobaisa kweba emeremo y’amaboko ao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    }
  ],
