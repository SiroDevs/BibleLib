{
  "id": "PSA.96",
  "number": "96",
  "bookId": "PSA",
  "reference": "Zaburi 96",
  "copyright": "© 2021 KENBS",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "96",
        "style": "c",
        "sid": "PSA 96"
      },
      "items": [
        {
          "text": "96",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae ore omorwoti omonene na omogambi ebiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 96:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moterere Omonene ogoteera okoyia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye ense yonsi, moterere Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 96:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moterere Omonene, motogie erieta riaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mobe mokoraria ogotooreka kwaye rituko ase rituko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 96:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raria obonene bwaye ase egati y’ebisaku,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogokora kwaye kw’ogokumia ase abanto bonsi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 96:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omonene mono, goika atogigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika airokwe goetania chinyasae chinde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 96:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinyasae chionsi chi’abaanto b’ebisaku nemegwekano y’ogosasimwa rioka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende Omonene nere otongete igoro chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 96:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosikwa na obonene nigo bire ase obosio bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinguru na oboseera nigo bire ase obomenyo bwaye obochenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 96:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abe chiamate chi’abaanto, togia Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Motogie ase obonene bwaye na okobua kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 96:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobake Omonene ase obonene bw’erieta riaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "moche ase chigoora chiaye, morentane ebiegwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 96:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosasime Omonene mweboetie obochenu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abanto b’ense yonsi, mobe mokoiguswa ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 96:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teebia abanto bonsi b’ebisaku, “Omonene nere okogamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ense nigo eteneine bokong’u, tekonyegerigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nanachere abanto ekiina atari gwanchereria.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 96:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga igoro chibe nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga enyancha echenge ase okoeera, amo na bionsi ebire ime yaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 96:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emegondo echenge amo n’ebinto bionsi bire ime yabo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erio emete yonsi ye rinani netere nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 96:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ase obosio bw’Omonene, ekiagera ngocha are,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ngocha are konachera ense ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo aranachere ense ekiina ase oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na anachere abanto ekiina ase obwegenwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    }
  ],
