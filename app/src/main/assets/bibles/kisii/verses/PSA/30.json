{
  "id": "PSA.30",
  "number": "30",
  "bookId": "PSA",
  "reference": "Zaburi 30",
  "copyright": "© 2021 KENBS",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PSA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okoiraneria ng’a mbuya mono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi ekero aatananete Hekalu ekaba enchenu)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ningotogie, ekiagera kwanyimokirie korwa inse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tigwatigete ababisa baane betogie igoro yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye, Omonene Nyasae one, nigo narerete asore ng’a onkonye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na bono kwangwenirie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, gwatooririe omoyo one korwa aase abakuure",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwang’iraneirie obogima tingenda ase oboina ime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abachenu baye, tera amatera ay’okobaka Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "iraneria ng’a mbuya mono ase erieta riaye richenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo akoba nendamwamu ase engaki ensinini yoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende obuya bwaye nigo bokoba ase obogima bw’omonto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekerero nabo keranyare kobao ase omogoroba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende mambia omogooko na omochengo nigo bigocha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero amang’ana onsi arenge amaya asende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngateeba ng’a tinkobugwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ase engencho y’obuya bwao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogakora egetunwa kiane kegatenena bokong’u,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ekero kwabisete obosio bwao nkaba nobwoba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nkarera asore, aye Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngakoboria ase oboitongo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbitoki ki aye oranyore onye ngokwa na gosoa ase oboina ime?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Orotu rw’amaroba ndonyare kogotogia?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ndonyare koraria obwegenwa bwao?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, inyigwe, ondorere amaabera!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, inkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwaonchoire omoichano one okaba omochengo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwandusirie eanga y’emechando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwambekeire ey’omogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, omoyo one nogenderere kogotogia, togokira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, Nyasae one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninkoiraneria ng’a mbuya mono kogenderera kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    }
  ],
