  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "69",
        "style": "c",
        "sid": "PSA 69"
      },
      "items": [
        {
          "text": "69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonyene oboronge okorera anyore ogotooreka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 69:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae, intoorie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera amaache aichoire, aikire ase omoyo one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 69:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ngendererete korimera endiba y’etintira ime,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aase tari ase ngotacha n’amagoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Narimeire ase amaache ase endiba entambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na emerindo yantubire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 69:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narosire ekiagera nkona-korera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoyo one bwomire kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amaiso aane abeire orotutu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nganyete Nyasae one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 69:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bangechete bosa ’ngencho ende etaiyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bare abange kobua etukia ere ase omotwe one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ababisa baane nigo bagokwana oborimo igoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baganetie gosiria obogima bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bare ne chinguru chinyinge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo n’akanete ebi ntaibete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 69:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, nomanyete oboriri bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naki amamocho aane tabisekaneti korwa asore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 69:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene bw’Emeganda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "totiga abanto abwo bagosemeretie, bare ime yane, barore obosooku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Nyasae bw’Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "totiga abanto abwo bagokorigia, bare ime yane, bachaywe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 69:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo nachayirwe ase engencho yao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obosooku bwatubire obosio bwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 69:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nabeire omogeni ase abanto baminto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoeti ase abaminto twaiboretwe korwa ase enda eyemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 69:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Risemi ri’enyomba yao riandire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emerumi y’abwo bakoramete nigo yangwerete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 69:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nabete nkorera ase omoyo one na kweng’ata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngachaywa na gokwanwa bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 69:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero neboyetie chigunia ase okweumia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakaba bakondabaara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 69:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ’ngokwanwa bobe nabwo bagoikaransa ang’e negeita kogamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abakonywa na gotinda bakoroisia amatera ay’ogonchecheria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 69:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, naye ngosaba ase engaki yancheire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Nyasae, inyigwere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo ore nobwanchani botari koera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nigo ore omwegenwa ase ogotooria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 69:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntoorie, tindimera ase etintira ime!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ntoorie korwa ase ababisa baane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa ase amaache ’endiba entambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 69:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki totiga emerindo entube,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose chindiba chimere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose engoro emumekerie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 69:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, ing’iranerie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.16",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera obwanchani bwao bogendererete botambe nigo bore obuya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.16",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ing’iranere, ekiagera amaabera ao namange mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.16",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 69:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobisa obosio bwao korwa asende inche omosomba oo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.17",
            "verseOrgIds": [
              "PSA.69.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inyigwe bwango, ekiagera inche nigo inde ase emechando emenene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.17",
            "verseOrgIds": [
              "PSA.69.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 69:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchuo ang’e asende, omboorie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.18",
            "verseOrgIds": [
              "PSA.69.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onsibore korwa ase ababisa baane!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.18",
            "verseOrgIds": [
              "PSA.69.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 69:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nomanyete amabe nakoreirwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna nasookigwe na gochaywa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo omanyete ababisa baane bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 69:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabe ayio nakoreirwe asionoire enkoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono nerusirie moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo nasemeretie ng’a ndorerwe amabeebe, korende tinayaroreretwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nasemeretie inyore abaremia, korende tinabanyora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 69:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero narenge nenchara, abanto bakang’a amaache endorwe ribaga ri’endagera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.21",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero narenge nerang’o, bakang’a chinkama nkanywa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.21",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 69:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga endagera ere ase amasio abo, ebe egesugunia ase bare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.22",
            "verseOrgIds": [
              "PSA.69.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oboreba ase abwo bekagete ng’a mbuya bare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.22",
            "verseOrgIds": [
              "PSA.69.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 69:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oukorie amaiso abo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.23",
            "verseOrgIds": [
              "PSA.69.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otengechie chibachwa chiabo kogenderera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.23",
            "verseOrgIds": [
              "PSA.69.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 69:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obaumorere ekeririanda kiao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.24",
            "verseOrgIds": [
              "PSA.69.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na endamwamu yao yoke igoro yabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.24",
            "verseOrgIds": [
              "PSA.69.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 69:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga omochie obo otigare bosa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.25",
            "verseOrgIds": [
              "PSA.69.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "monto onde tamenya ase chiema chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.25",
            "verseOrgIds": [
              "PSA.69.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 69:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo nigo bachandete omonto oria kwaagete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.26",
            "verseOrgIds": [
              "PSA.69.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na bagokwana igoro y’obororo bw’oyio kwabetete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.26",
            "verseOrgIds": [
              "PSA.69.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 69:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menta obobe igoro ase obobe bwabo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.27",
            "verseOrgIds": [
              "PSA.69.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobatiga basoe ase oboronge bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.27",
            "verseOrgIds": [
              "PSA.69.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 69:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga amarieta abo atinyigwe korwa ase egetabu y’abare moyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.28",
            "verseOrgIds": [
              "PSA.69.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tarikwa amo nay’abanyene oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.28",
            "verseOrgIds": [
              "PSA.69.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 69:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo inde ase emechando n’obororo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.29",
            "verseOrgIds": [
              "PSA.69.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Nyasae, ogotooreka kwao konyimokererie igoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.29",
            "verseOrgIds": [
              "PSA.69.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 69:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintogie erieta ria Nyasae ase okomoterera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.30",
            "verseOrgIds": [
              "PSA.69.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nindarie obonene bwaye ase okoiraneria ng’a mbuya mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.30",
            "verseOrgIds": [
              "PSA.69.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 69:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio naro aragokie Omonene kobua komoruera eng’ombe koba ekeng’wanso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.31",
            "verseOrgIds": [
              "PSA.69.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose komoruera eeri ere ne ching’unchara na ebitaago.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.31",
            "verseOrgIds": [
              "PSA.69.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PSA 69:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bakoreire bobe mbarore ayio, bagoke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.32",
            "verseOrgIds": [
              "PSA.69.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe aba mokorigia Nyasae, tiga chinkoro chiaino chikorwe chinyia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.32",
            "verseOrgIds": [
              "PSA.69.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 69:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo akoigwa abanto baria baremeire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.33",
            "verseOrgIds": [
              "PSA.69.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere tari gochaaya abanto baye abwo bare ase obosibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.33",
            "verseOrgIds": [
              "PSA.69.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
