            "sid": "PSA 124:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Naki yare goocha koba onye Omonene atabeete ase ensemo yaito?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga Abaisraeli bairanerie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 124:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Omonene atabeete ase ensemo yaito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero abanto batoumokerete gotorwania,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 124:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanga nigo batomerete gatore moyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.3",
            "verseOrgIds": [
              "PSA.124.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera babete n’endamwamu enene ase tore;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.3",
            "verseOrgIds": [
              "PSA.124.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 124:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende emerindo nigo yarenge goocha gotokorobanania,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.4",
            "verseOrgIds": [
              "PSA.124.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eooro nigo yarenge goocha goeta igoro yaito;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.4",
            "verseOrgIds": [
              "PSA.124.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 124:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ee, amaache aichoreranete",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.5",
            "verseOrgIds": [
              "PSA.124.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo arenge goocha gotomera kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.5",
            "verseOrgIds": [
              "PSA.124.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 124:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene atogigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.6",
            "verseOrgIds": [
              "PSA.124.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera tatoruete totaboranwe namaino y’ abanto abwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.6",
            "verseOrgIds": [
              "PSA.124.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 124:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emioyo yaito yatoorekire",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna enyoni egotooreka korwa ase egesuguni ki’omotegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Egesuguni kiabutokire, naintwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "twaminchoirie na gotama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 124:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogokonywa gwaito nigo gokorwa ase erieta ri’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.8",
            "verseOrgIds": [
              "PSA.124.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio otongete igoro na ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.8",
            "verseOrgIds": [
              "PSA.124.8"
            ]
          }
        }
