      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obonene bwa Nyasae na engencho ya Mwanyabaanto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, aye Omonene oito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erieta riao naki riakuma iga ense yonsi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obonene bwao nigo bogotogigwa nonya ngoika igoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase emenwa y’abana n’eyabakogonka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo kweagacheire eburi bosio bw’ababisa bao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde okoiyeria ababisa bao inse na abakorusia egesiomba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nkorigereria gochia igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korora emeremo gwakorete namaboko ao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omotienyi ne ching’enang’eni, ebi kwabegete kera ekemo ase aaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omonto ’nki aisaine aye ogendererete komorengereria?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Mwanyabaanto ’nki aisaine aye okomorenda?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamokorire koba inse kegima asore aye omonyene, Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende kwamoboirie obonene na amasikani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamobekire kogambera ebinto bionsi gwatongete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwabekire ebitongwa bionsi inse y’amagoro aye:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ching’ondi chionsi ne chiombe, amo ne ching’iti chi’orosana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne chinyoni chikoiruruka amo ne chinswe chi’enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kende gionsi kegoetanana ase chindiba chie chinyancha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, aye Omonene oito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naki erieta riao riakuma ense yonsi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    }
  ],
