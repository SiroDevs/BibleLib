  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PSA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora obobui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Omonene aigwe ogosaba kwao ase engaki y’emechando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erieta ria Nyasae o Yakobo rikorende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nagotomere ogokonywa korwa ase obomenyo bwaye obochenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na akoe chinguru korwa ase Sayoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga ainyore okorua kwao gwonsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "anche na kogokera ebing’wanso biao bionsi bi’ogosambwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga akoe okogania gw’enkoro yao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aikeranie emeroberio yao yonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio toake amariogi yomogooko ase engencho y’obobui bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "toimokererie igoro ebendera y’erieta ria Nyasae oito!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga Omonene aikeranie okoboria kwao kw’oboitongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono namanyire ng’a Omonene nae omoakwa amaguta oye obobui,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namoiranerie korwa aase aye aachenu aaria igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namoe obobui goetera ase okoboko kwaye gw’okorio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bande nigo basemeretie chigari chi’esegi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abande chibarasi chi’esegi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende intwe nigo tosemeretie erieta ri’Omonene, Nyasae oito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo baragochwe bagwe inse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende intwe nigo toragororoke totenene boronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, kae omorwoti oo gwachorire obobui;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otoiranerie ekero togokorangeria!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    }
  ],
