        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba Ng’a Nkonywe Korwa Ase Omochaandi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(1 Sam 22:1)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogosaba gwa Daudi ekero arenge ase rikuruma)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 142:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ’nkorera neriogi ase ogokorangeri’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naaka eriogi ase okomosaba amaabera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 142:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ’nkorenta obokong’u bwane ase obosio bwaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na komoteebia emechando yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 142:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ’nkoba buna oyo okogireka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nomanyete ase ’ngoetera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Agwo ase ’ngoeta ababisa bambeekeire amareba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 142:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ’nkorigereria ase ensemo yane y’okorio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tindi korora monto aroro ogonkonya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tindi korora aase ’ndatamere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "monto onde tari okonyechaandera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 142:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nigo ’nkorera asore;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ’ngoteeba: Naye ore obotamero bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na egetare kiane aiga ase ense y’ abanto bare moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 142:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegerera oigwe ekerero kiane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nachaandekire mono!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ntoorie korwa ase abanto abwo bagonchaanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo babwate chinguru kombua.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 142:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osibore omoyo one korwa ase obosibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde imbe ’ngotogia erieta riao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanyene oboronge ’mbang’etanane, ekiagera gwankoreire amaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    }
  ],
