  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "PSA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae nere obotamero bwaito",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera kwa basinto ba Kora)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nobotamero bwaito, ne chinguru chiaito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "botambe nigo are ang’e gotokonya ase engaki y’emechando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio titokwoboa, ense neisa gotengechigwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebitunwa birutwe ase chindiba chi’enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "gose emerindo y’enyancha neba ekoruma na koimokerera igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebitunwa bibe bigotengechigwa ase ogoturubanigwa okwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orooche ndoreo chindooche chiaye chikogokia omochie o Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omochie ore obomenyo obochenu bw’Oyore Igoro Mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo amenyete imeo, tokonyegerigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nayokonye kobogokia mambia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’ebisaku babeire neburuburu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amagambi aiyerigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae ogoaka eriogi riaye, ense nenyititoke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene bw’Emeganda nigo are amo naintwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae o Yakobo nere obotamero bwaito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchuo morore ay’Omonene akorire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "orentire ogosirigwa ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otangire chiseegi ase ense engima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obunire amata, osenyentire amatimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "osambire chigari nomorero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Toerera, momanye ng’a ninche Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche inde omonene ase abanto b’ebisaku, omonene ase ense.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene bw’Emeganda nigo are amo naintwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.11",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae o Yakobo nere obotamero bwaito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.11",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    }
  ],
