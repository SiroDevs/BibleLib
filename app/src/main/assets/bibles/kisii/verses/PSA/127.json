        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosesenigwa Gwonsi Nigo Gokorwa Ase Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Sulemani)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 127:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Omonene takoagaacha enyomba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakoyeagaacha nigo bagokora emeremo ya bosa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onye Omonene takorenda omochie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omonto oyio okoyorenda nigo akorenda bosa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 127:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ere bosa ase more kobooka mambia chuni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gokora emeremo emekong’u ase okonyora endagera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende mwanyorwa gochia korara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende Omonene nigo agwechaandera abanto baye anchete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nekero baraire chitoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 127:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, abana nigo bare omwando okorwa ase Omonene, ekiagera oroiboro rokorwa ase enda nigo rore ekeegwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 127:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana omonto akonyora kare ne’chinguru chi’obosae bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo banga buna chinsara chire koboko kw’omorwani etuoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 127:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto oyo oichoretie esaaro yaye ne chinsara echio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oyio takobugwa ekero arabe okogamberana nababisa baye agwo ase ekegambero gia’etureti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    }
  ],
