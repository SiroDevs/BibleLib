        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba Gw’okonyora Okwaberwa Na Ogotooreka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 130:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nigo nkorera asore, korwa ase chindiba ime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 130:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, igwa eriogi riane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tegerera oigwe eriogi ri’ogosaba kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 130:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, onye ’nkware gokora omobaro bw’ebibe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ning’o ore konyaara gotenena ase obosio bwao?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 130:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende aye nigo ore omwaberi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde onyaare koirokwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 130:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo ’nganyete Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, omoyo one nigo omoganyete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ’nsemeretie ring’ana riaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 130:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoyo one nigo oganyete Omonene, kobua buna abarendi bakoganya ogokiamoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, kobua abarendi baganyete ng’a bokie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 130:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe Abaisraeli, mosemerie Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene nigo are nobwanchani bogendererete botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogotooreka okonge nigo gokorwa asare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 130:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere naboorie Abaisraeli korwa ase ebibe biabo bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    }
  ],
