  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PSA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okoba nogosemeria ase Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, naye ngotamera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobaisa gontiga nsookigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ntoorie goetera ase oboronge bwao!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegerera oigwe amang’ana aane, obe omwango gontooria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Kabe egetare kiane ngotamera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na eburi yane enkong’u, na ontoorie!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye naye egetare kiane na eburi yane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’erieta riao ondaae na kondenda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indusie korwa ase oboreba bobisire bombwate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye naye egekengero kiane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Nyasae omwegenwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naye kwambooririe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ngechete abanto bagosasiima emegwekano ere bosa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende nigo ngosemeretie aye Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningoke na gochenga ase engencho y’obwanchani bwao botari koera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye igo ogwechandera emechando yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kondengereria mono ase ogochandwa kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tombegeti ase amaboko ’omobisa one;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende gwatenenirie amagoro aane aase are aagare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ndorere amaabera, ekiagera nigo mbwate emechando;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaiso aane arimeire ime ase engencho y’obororo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoyo one ogoyire, naboigo nomobere one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase obogima bwane bwonsi nabeire inde nemechando;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase emiaka yane yonsi nabeire inde nomoichano;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinguru chiane chiaerire ase engencho y’ogosaria kwane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amauga yomobere one omire pa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa baane bonsi nigo bagonchecheria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abasani baane boigo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto baamanyete banyoboire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bonsi abakondora ase enchera nigo bagontama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto banyebire buna bakweba omonto okuure;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabeire buna enyongo yatekire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nkoigwa ababisa baane bakomonyererana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okogosa nigo kong’etanaine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo nigo bagosangererekana amo kogamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagokora omooroberio bw’okong’ita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende inche nigo ngosemeretie aye Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.14",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo ngoteeba: “Aye naye Nyasae one.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.14",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obogima bwane nigo bore ase amaboko ao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.15",
            "verseOrgIds": [
              "PSA.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ntoorie korwa ase amaboko ’ababisa baane na ay’abachandi baane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.15",
            "verseOrgIds": [
              "PSA.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing’onchorere obosio bwao, inche omosomba oo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.16",
            "verseOrgIds": [
              "PSA.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ontoorie ase engencho y’obwanchani bwao bogendererete botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.16",
            "verseOrgIds": [
              "PSA.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, tontiga nsookigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.17",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo ngokorangeria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.17",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga abakori amabe basookigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.17",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagende aase abakuure babe amamama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.17",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiria emenwa yabwo bagokwana amang’ana ’oborimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.18",
            "verseOrgIds": [
              "PSA.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bagokwana amang’ana amabe igoro y’oyore omooronge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.18",
            "verseOrgIds": [
              "PSA.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gokwana amang’ana yoboenenu na ay’ogochaaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.18",
            "verseOrgIds": [
              "PSA.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki obuya bwao bore obonge na obw’ogokumigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.19",
            "verseOrgIds": [
              "PSA.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obwo kwagacheire abanto abakoirogete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.19",
            "verseOrgIds": [
              "PSA.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase amasio a Mwanyabaanto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.19",
            "verseOrgIds": [
              "PSA.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okoboorokia ase abakogotamera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.19",
            "verseOrgIds": [
              "PSA.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo okobabisa agwo asore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.20",
            "verseOrgIds": [
              "PSA.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase okobarenda korwa ase emeroberio emebe y’abanto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.20",
            "verseOrgIds": [
              "PSA.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okobarenda ase ekiriri kiao korwa ase abanto abang’achi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.20",
            "verseOrgIds": [
              "PSA.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene atogigwe!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.21",
            "verseOrgIds": [
              "PSA.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo anyorogetie obwanchani bwaye bw’ogokumia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.21",
            "verseOrgIds": [
              "PSA.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akandenda ase omochie omokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.21",
            "verseOrgIds": [
              "PSA.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero narenge nobwoba nigo narengereretie, ngateeba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.22",
            "verseOrgIds": [
              "PSA.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Bono naserigwe gochia aare korwa ase obosio bwao!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.22",
            "verseOrgIds": [
              "PSA.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende nigo kwaigwete okoboria kwane kw’oboitongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.22",
            "verseOrgIds": [
              "PSA.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero narerete asore ng’a onkonye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.22",
            "verseOrgIds": [
              "PSA.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanche Omonene, inwe abachenu baye mwensi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.23",
            "verseOrgIds": [
              "PSA.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo akobarenda buya abanto bare abegenwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.23",
            "verseOrgIds": [
              "PSA.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende nigo akorua egesusuro ase oyore omomwenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.23",
            "verseOrgIds": [
              "PSA.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe mwensi aba momosemeretie Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.24",
            "verseOrgIds": [
              "PSA.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kabe ne chinguru, mobe abaremu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.24",
            "verseOrgIds": [
              "PSA.31.24"
            ]
          }
        }
      ]
