    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye naye okoraa ebisaku bire ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.4"
            ]
