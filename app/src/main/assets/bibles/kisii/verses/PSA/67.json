          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae atororere amaabera, atosesenie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "atoraberie obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
