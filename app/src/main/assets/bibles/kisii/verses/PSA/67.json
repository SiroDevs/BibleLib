          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ense yamire okwama kwaye okonge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.6"
