          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, tiga abanto bagotogie;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, abanto bonsi tiga bagotogie!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
