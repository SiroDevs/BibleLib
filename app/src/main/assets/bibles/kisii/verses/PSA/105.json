          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo akang’anyia abanto baye korwa ase ense eria bakaba bagochenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.43",
            "verseOrgIds": [
              "PSA.105.43"
            ]
