    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo akabaigotia nendagera korwa igoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.40",
            "verseOrgIds": [
              "PSA.105.40"
            ]
          }
        }
