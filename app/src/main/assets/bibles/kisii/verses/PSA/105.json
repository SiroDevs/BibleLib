            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero baboretie eki bakoria, ere agatoma chinkware,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.40",
            "verseOrgIds": [
              "PSA.105.40"
            ]
          }
        }
