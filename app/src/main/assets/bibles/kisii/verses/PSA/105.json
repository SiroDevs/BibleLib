  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "105",
        "style": "c",
        "sid": "PSA 105"
      },
      "items": [
        {
          "text": "105",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae na abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(1 Amg 16:8-22)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 105:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moiranerie Omonene ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.1",
            "verseOrgIds": [
              "PSA.105.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rangeria erieta riaye ase ogokonywa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.1",
            "verseOrgIds": [
              "PSA.105.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "teebia abanto b’ebisaku ogokora kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.1",
            "verseOrgIds": [
              "PSA.105.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 105:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Terera Omonene, moterere amatera ay’okomotogia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.2",
            "verseOrgIds": [
              "PSA.105.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "raria ogokora kwaye kw’ogokumia!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.2",
            "verseOrgIds": [
              "PSA.105.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 105:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etogerie erieta riaye richenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.3",
            "verseOrgIds": [
              "PSA.105.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto bonsi abakorigia Omonene basasoke ase chinkoro chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.3",
            "verseOrgIds": [
              "PSA.105.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 105:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rigia Omonene amo ne chinguru chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.4",
            "verseOrgIds": [
              "PSA.105.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "morigie obosio bwaye botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.4",
            "verseOrgIds": [
              "PSA.105.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 105:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyora emeremo yo’gokumia eria akorire, ebikone biaye na ebiina biaye bi’ekeene arure",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.5",
            "verseOrgIds": [
              "PSA.105.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 105:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto b’ororeria rwa Aburaamu, omosomba O’ Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.6",
            "verseOrgIds": [
              "PSA.105.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, inwe abanto ba Yakobo, abachore b’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.6",
            "verseOrgIds": [
              "PSA.105.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 105:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nere Omonene, Nyasae oito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.7",
            "verseOrgIds": [
              "PSA.105.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebiina biaye nigo bire ase ense yonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.7",
            "verseOrgIds": [
              "PSA.105.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 105:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botambe nigo akoinyora okobwatana kwaye kw’ogotianania,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.8",
            "verseOrgIds": [
              "PSA.105.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo goika ebiare elifu eyemo nigo akoinyora ring’ana achigete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.8",
            "verseOrgIds": [
              "PSA.105.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 105:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na okobwatana koria gw’ogotianania akorete na Aburaamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.9",
            "verseOrgIds": [
              "PSA.105.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na eira yaye y’ogotianania amorierete Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.9",
            "verseOrgIds": [
              "PSA.105.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 105:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okobwatana okwo akagokong’ia gokaba ogochika ase Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.10",
            "verseOrgIds": [
              "PSA.105.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ase Israeli okobwatana gwa kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.10",
            "verseOrgIds": [
              "PSA.105.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 105:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamoteebia, “Ninkoe ense ya Kaanani ebe egetari oraire kebe omwando oo.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.11",
            "verseOrgIds": [
              "PSA.105.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 105:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engaki eria nigo barenge abanto abake ase omobaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.12",
            "verseOrgIds": [
              "PSA.105.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakabarwa ng’a tibaisaini gento;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.12",
            "verseOrgIds": [
              "PSA.105.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo barenge abaeti ase ense eyio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.12",
            "verseOrgIds": [
              "PSA.105.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 105:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba bagoetanana korwa ase egesaku ekemo gochia ase ekende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.13",
            "verseOrgIds": [
              "PSA.105.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa ase oborwoti obomo gochia ase obonde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.13",
            "verseOrgIds": [
              "PSA.105.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 105:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae tatigete abanto bande baabachande;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.14",
            "verseOrgIds": [
              "PSA.105.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agatogonyera abarwoti ase engencho yabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.14",
            "verseOrgIds": [
              "PSA.105.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 105:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "agateeba, “Timobaisa gokuna abaakwa amaguta baane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.15",
            "verseOrgIds": [
              "PSA.105.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timokorera ababani baane bobe.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.15",
            "verseOrgIds": [
              "PSA.105.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 105:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Omonene arentete enchara ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.16",
            "verseOrgIds": [
              "PSA.105.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na asiretie chindagera chiabo chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.16",
            "verseOrgIds": [
              "PSA.105.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 105:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "konya otomire omonto agwo ritang’ani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.17",
            "verseOrgIds": [
              "PSA.105.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere Yusufu konya oonigwe obeire omosomba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.17",
            "verseOrgIds": [
              "PSA.105.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 105:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo asibetwe chingatare chigasionora amagoro aye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.18",
            "verseOrgIds": [
              "PSA.105.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende akabeekerwa eteyo y’ekioma ase rigoti riaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.18",
            "verseOrgIds": [
              "PSA.105.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 105:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika ayabaanete agaikerana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.19",
            "verseOrgIds": [
              "PSA.105.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio ring’ana ri’Omonene rikaenekia ng’a Yusufu nomooronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.19",
            "verseOrgIds": [
              "PSA.105.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
