          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene akainyora eira eria enchenu ariete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.42",
            "verseOrgIds": [
              "PSA.105.42"
            ]
          }
        }
