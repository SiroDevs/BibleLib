    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akaminyoka ase erooro buna orooche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.41",
            "verseOrgIds": [
              "PSA.105.41"
            ]
          }
        }
      ]
    },
