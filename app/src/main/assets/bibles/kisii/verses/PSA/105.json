    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto abwo baye achorete bakaba bagoteera nomogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.43",
            "verseOrgIds": [
              "PSA.105.43"
            ]
          }
