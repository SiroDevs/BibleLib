    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo akainyora Aburaamu, omosomba oye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.42",
            "verseOrgIds": [
              "PSA.105.42"
            ]
          }
