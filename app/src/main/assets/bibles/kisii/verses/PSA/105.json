      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akabaa n’ebinto abanto abwo konya bechandeire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.44",
            "verseOrgIds": [
              "PSA.105.44"
            ]
