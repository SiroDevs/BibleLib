          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabochora egetare, na amaache agasoka korwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.105.41",
            "verseOrgIds": [
              "PSA.105.41"
            ]
          }
        }
