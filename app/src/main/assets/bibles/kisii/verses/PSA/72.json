  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "72",
        "style": "c",
        "sid": "PSA 72"
      },
      "items": [
        {
          "text": "72",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosabera omorwoti bw’abaanto ba Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Sulemani)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 72:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae, kae omorwoti okobua gw’okogamba buna aye okogamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omwana bw’omorwoti agambe ase oboronge buna aye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 72:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio amanye konachera abanto bao ebiina bi’oboronge",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gokora ekeene ase abataka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 72:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitunwa na ebigoro mbirentere abanto omorembe goetera ase oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 72:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga omorwoti abe okorwanerera abataka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na atoorie abana b’abaremeire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende asenyente abanto bagokorera abande bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 72:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto mbakoiroke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "koreng’ana buna erioba na omotienyi bigendererete kobao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebiaare ase ebiaare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 72:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere tiga aike korwa igoro buna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "embura egotwa ase obonyansi oborere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna omonyirira ogotwa igoro ase riroba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 72:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga omonyaboronge asesenigwe ase amatuko aye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omorembe ogenderere kobao goika ekero omotienyi otabeo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 72:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga omorwoti abe okogamba korwa ase enyancha eyemo goika eyende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa ase orooche rw’Eufarati goika ase ensinyo y’ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 72:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bamenyete ase erooro mbatugame ase obosio bwaye bamosike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "n’ababisa baye bamene orotu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 72:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwoti ba Tarisisi na ab’ebisinka ’mbabe bakomorentera ebiegwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo nabarwoti ba Sheba na Seba mbamorentere ebango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 72:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwoti bonsi ’mbatugame ase obosio bwaye bamosike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto b’ebisaku bionsi mbamokorere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 72:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agotooria oyoremeire gakorangeria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo nomotaka na oyotabwati onde okomokonya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 72:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo are omwororo ase omoremerwa na ase omotaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nigo agotooria emioyo y’abaremeire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 72:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akobooria emioyo yabo korwa ase abachandi babo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa ase obotindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amanyinga abo nigo are nengencho enene asare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 72:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga omorwoti agenderere koba moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Chitaabu chi’ense ya Seba chirentwe asare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga abanto babe bakomosabera botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo tiga abe okona-gosesenigwa kera rituko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 72:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga endagera yame enyinge ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nase ebitunwa igoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Chindagera echio tiga china-konyegerigwa buna emete ya Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto b’emechie tiga babuche babe buna obonyansi bw’ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.16",
            "verseOrgIds": [
              "PSA.72.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 72:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erieta riaye tiga rigenderere kobao botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.17",
            "verseOrgIds": [
              "PSA.72.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
