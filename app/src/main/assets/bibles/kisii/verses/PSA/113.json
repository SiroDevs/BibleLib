    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obuya bw’Omonene bogotogigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 113:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motogie Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abasomba b’Omonene, motogie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ritogie erieta riaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 113:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erieta ri’Omonene ritogigwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa bono goika kare na kare!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 113:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erieta ri’Omonene ribe rigotogigwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa ekero risase rikooroka goika ekero rikorimera!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 113:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omonene igoro ase ebisaku bionsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obonene bwaye nigo boetanaine igoro chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 113:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o onga buna Omonene, Nyasae oito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oria omenyete aaria igoro mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 113:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na origereretie goocha inse aa arore igoro na ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 113:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akoimokia omotaka korwa ase obotaka obwere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koimokia omoremerwa korwa ase ribu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 113:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "obabeeka baikaransa amo n’abwo bare n’okobua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baria bakogambera abanto baye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 113:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akoa omokungu omogomba chinguru chi’okoibora,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oba n’omogooko ase obomenyo bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene atogigwe!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    }
