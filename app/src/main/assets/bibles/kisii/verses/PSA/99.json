      "items": [
        {
          "text": "99",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae ore Omorwoti Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 99:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nere okogamba!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio, abanto b’ebisaku nigo bakoiguswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo amenyete nobonene bwaye igoro y’ebitongwa bibwate chimbaba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense nigo egotengechigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 99:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo are omonene ase Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oimokererigwe igoro kobua abanto b’ebisaku bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 99:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bonsi tiga batogie erieta riaye rinene na eri’okoirokia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere nigo are omochenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 99:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omorwoti ore nokobua, nigo bwanchete ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye gwakorire oboronge botenene bokong’u,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okonacha ebiina bi’ekeene na oboronge",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase abanto b’ororeria rwa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 99:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moimokererie Omonene, Nyasae oito, igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mosasime agwo ase egeteni kiaye ki’amagoro!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere nigo are omochenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 99:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Aroni nigo barenge abamo b’abakuani b’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo Samweli nigo arenge oyomo bw’abaanto barenge korangeria erieta riaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto abwo nigo barangeretie Omonene ng’a abakoonye, nere akabaigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 99:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akwanete nabarabwo, ore ime ase riire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto abwo nigo babwatete oborori bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amachiiko abaete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 99:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Nyasae oito, nigo kwaigwete abanto baria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo kwarenge Nyasae, kwarenge kobaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya naboigo nigo kwarenge kobaa egesusuro ase engencho y’ogokora kwabo okobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 99:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moimokererie Omonene, Nyasae oito, igoro!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inchuo mosasimere ase egetunwa kiaye egechenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene, Nyasae oito, nigo are omochenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    }
  ],
