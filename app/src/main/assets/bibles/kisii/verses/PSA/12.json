  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PSA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora obokonyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, gaki ayerera totoorie!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abakoirogete aye Nyasae baerire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abegenwa tibari konyorekana ase Mwanyabaanto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bonsi nigo bagoteebania amang’ana ’oborimo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bare okong’o nyamenwa ebere na gokwana amang’ana ay’okweansia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, koranche kiria emenwa y’abwo egokwana amang’ana ’okweansia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chimeme chi’abwo bagwetogia ase amang’ana y’oboenenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bagoteeba: “Ase amang’ana ’emenwa yaito ntore ne chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aya togokwana nigo agotokonya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o ore Omonene gotobua?”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Bono ninchiche, ekiagera abataka baregirwe na abaremerwa nkorera bare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nindwe oborendi obuya kegima ase abwo basemeretie kobonyora.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana ’Omonene nigo are ay’obwegenwa naende n’amaachenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agwekaine efeta yasambirwe ase riera ri’omorero na koumorwa inse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "yachenirwe ara gatano na kabere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, otorende!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Otorende botambe korwa ase obobe bw’ekegori eke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori amabe nigo bagoetanana chinsemo chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obonyaka bonde bwonsi botogigwa ase egati ya Mwanyabaanto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    }
  ],
