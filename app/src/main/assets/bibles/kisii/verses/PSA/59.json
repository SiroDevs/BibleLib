  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "PSA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora oborendi bwa Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi ekero Saulo atomete abanto bamoite)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one, ntoorie korwa ase ababisa baane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "indende korwa ase abanto aba banyimokeire gonkora bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.1",
            "verseOrgIds": [
              "PSA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkonye korwa ase abakori amabe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ntoorie korwa ase abaiteri amanyinga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, abanto aba bebisete na komboera bang’ite,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto abatindi basangererekanire amo bankore bobe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, ayio tari ase engencho y’ogosaria gose ebibe nakorire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tindakora bobe bonde bokogera baminyoke gocha gonkora bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene imoka, orore amang’ana ayio, onkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Nyasae bw’Emeganda, naye Nyasae bw’Abaisraeli!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Imoka, orue egesusuro ase abanto b’ebisaku bionsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobaisa gotigaria nonya noyomo ore moyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase abwo bagokora amabe ase obong’ainereria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omogoroba nigo bakoirana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baetanana omochie, bakoga buna chisese.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oise kobarigereria, orore buna bakona‐gokwana‐kwana!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ebikoba biabo nigo bire buna emioro emioge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bateba: “Ning’o oranyare gotoigwa?”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende aye Omonene nigo okobasekerera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo ogochecheria abanto bonsi batakomanyeti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae ore chinguru chiane, nimbe nkoganyete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera naye ore obotamero obokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae one nigo agonchichera nobwanchani bwaye botari koera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae one nankore nchenge igoro y’ababisa baane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, enguba yaito, tobaisa kobaita!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto baane nigo barabaise kweba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obaomboganie ase chinguru chiao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio omanye kobasiria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibe nigo bire ase emenwa yabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amang’ana bagokwana namabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase igo, tiga oboenenu bwabo bobabwate buna oboreba bokobwata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo nigo bakoragereria na gokwana amang’ana ’oborimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, obasirie nendamwamu yao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "basirie kegima, onde tanyorekana ore moyo nonya noyomo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio abanto b’ense yonsi mbamanye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a Nyasae nere okogambera abanto ba Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 59:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omogoroba nigo bakoirana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.14",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baetanana omochie, bakoga buna chisese.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.14",
            "verseOrgIds": [
              "PSA.59.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 59:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bakoong’anya korigia endagera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.15",
            "verseOrgIds": [
              "PSA.59.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batayenyoreti nigo bakogeesa bokia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.15",
            "verseOrgIds": [
              "PSA.59.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 59:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende inche nintere igoro y’okobua kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.16",
            "verseOrgIds": [
              "PSA.59.16"
            ]
          }
