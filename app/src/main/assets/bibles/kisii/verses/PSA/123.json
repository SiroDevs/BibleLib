          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyimokererie amaiso aane goocha agwo asore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igoro ase obomenyo bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 123:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama! Buna koreng’ana abasomba basemeretie omonene obo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abasomba abaiseke basemeretie omoteneneri obo omokungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo naintwe tosemeretie Omonene Nyasae oito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika abe otororeire amaabera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 123:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, otororere amaabera, koranche otororere amaabera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera twabeire togochecherigwa mono goetania.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 123:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twaichoirwe n’echaayo y’abwo beisanekerete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogochecherigwa kw’abamwenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
