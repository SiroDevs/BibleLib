  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "PSA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora okwaberwa kw’ebibe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogosaba gwa Daudi magega y’ogocherwa na Omobani Natani Magega Daudi gatomanire na Batiseba)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, ’ndorere amaabera koreng’ana nobwanchani bwao botari koera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’obonge bw’amaabera ao otinyie ogosaria kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.1",
            "verseOrgIds": [
              "PSA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsibie korwa obobe bwane kegima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onchene korwa ase ebibe biane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.2",
            "verseOrgIds": [
              "PSA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche namanyire ogosaria kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebibe biane nigo bire bosio bwane botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.3",
            "verseOrgIds": [
              "PSA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagokoreire ebibe aye omonyene bweka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nakorire amabe bosio bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye omanyekane ng’a mboronge ore ekero ogokwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na mboronge ore na nigo okonacha ekiina buya kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.4",
            "verseOrgIds": [
              "PSA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, inche nigo naiboretwe inde ne chingencho chi’ebibe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo narenge omonyabibe korwa ekero natongetwe ase enda yabaaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.5",
            "verseOrgIds": [
              "PSA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, aye nigo oganetie ekeene ase enkoro ime;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio inyorokererie obong’aini bwao ase enkoro yane ime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.6",
            "verseOrgIds": [
              "PSA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsibie ne chinsagia chia hisopo, na inche nincheneke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onsibie erio imbe omorabu se goetania amagena ’embura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.7",
            "verseOrgIds": [
              "PSA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ong’ichorie n’omogooko na omochengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amauga aane aya gwasenyentete n’agoke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.8",
            "verseOrgIds": [
              "PSA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togaacha etobo y’ebibe biane bosio bwao, torora ebibe biane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ontinyie obobe bwane bwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.9",
            "verseOrgIds": [
              "PSA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, ontongere enkoro endabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okore omoika ore ime yane obe omoyia na oyokong’ie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.10",
            "verseOrgIds": [
              "PSA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyatanana korwa ase obosio bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya n’Omoika Omochenu toyorusia asende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.11",
            "verseOrgIds": [
              "PSA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ong’iranerie omogooko okorwa ase ogotooreka kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okong’ie omoika one obe omoigweri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.12",
            "verseOrgIds": [
              "PSA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio inyorokererie abasaria chinchera chiao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanyene ebibe mbairane asore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.13",
            "verseOrgIds": [
              "PSA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, Nyasae bw’ogotooreka kwane, ontoorie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ting’itera amanyinga ’abaanto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oromeme rwane rotere n’oboronge bwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.14",
            "verseOrgIds": [
              "PSA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ong’igore ebikoba biane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omonwa one norarie ogotogigwa kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.15",
            "verseOrgIds": [
              "PSA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 51:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togokiri nekeng’wanso, ninsa gokerua;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye toganeti ekeng’wanso ki’ogosambwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 51:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebing’wanso biancheire na Nyasae omoyo omokanyeku na bw’okweitia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "enkoro yasionokire na gwekeyia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Nyasae, tokoyechaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 51:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene okorere Sayoni amaya ase amaabera ao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.18",
            "verseOrgIds": [
              "PSA.51.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
