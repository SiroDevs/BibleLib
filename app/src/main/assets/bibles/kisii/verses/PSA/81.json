  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "81",
        "style": "c",
        "sid": "PSA 81"
      },
      "items": [
        {
          "text": "81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera kwe Rituko Rinene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gw’Asafu)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 81:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moterere Nyasae neriogi rinene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nere chinguru chiaito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aka eriogi ri’omogooko ase Nyasae o Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 81:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera ogoteera kw’ogotogia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mobugie chinchigiri amo namakano ’ebirigisa, na amakano ande.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 81:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobugie egetureeri ase rituko ri’Omotienyi Omoyia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero oorokire omogima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ogosika rituko riaito ri’omoyega richikiire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 81:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio nigo ore omooroberio ochikiire ase Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aya Nyasae o Yakobo achiikire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 81:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Omonene aetete ense ya Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agachiika omooroberio oyio ase abanto ba Yusufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nkaigwa enkwana y’omonwa ntamanyete egoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 81:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ninche narusetie chigurube korwa ase amareko aino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ngasibora amaboko aino korwa ase ebitonga bi’okobogoria chigurube.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 81:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero mwarenge nemechando nigo mwandangeretie, na inche nkabatooria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nabairaneretie korwa ime y’enkoba ase nebisete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkabateema agwo ase amaache a Meriba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 81:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto baane, igwa ekero nkob akuurera!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe Abaisraeli, onye ndiria mware konyigwera!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 81:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoba nenyasae ende eng’ao ase egati yaino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timotung’amera na gosasiima enyasae engeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 81:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ninche Omonene, Nyasae oino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche nabarusetie korwa ase ense ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio, asamia emenwa yaino ebe yasie, na inche imbaragerie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 81:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende abanto baane tibaigwete eriogi riane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abaisraeli abwo nigo bangete kegima konyigwera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 81:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio nkabatiga babwatie obomwenu bwe chinkoro chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde bakore buna koreng’ana konya barobeirie abanyene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 81:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ndiria abanto abwo baane bantegererete!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onye Abaisraeli mbabwatetie chinchera chiane!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 81:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rirorio nanga nabuete ababisa babo bwango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okoboko kwane nkoba kware mamincha yabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 81:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bangechete inche Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baare gocha gotung’ama ase ’nde bare nobwoba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amatuko abo nagenderere kobao kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 81:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende inwe nigo narenge gocha kobaa engano enoru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.16",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobaisanekia nobooke korwa ase egetare.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.16",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        }
      ]
    }
  ],
