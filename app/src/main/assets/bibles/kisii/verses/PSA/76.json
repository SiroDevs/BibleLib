  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "76",
        "style": "c",
        "sid": "PSA 76"
      },
      "items": [
        {
          "text": "76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae ore omobui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gw’Asafu)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 76:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo amanyekanete ase Abayuda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erieta riaye rire rinene mono ase Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 76:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obomenyo bwaye Obochenu nigo bore agwo Salemu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo amenyete agwo Sayoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 76:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroro agwo nabunete chinsara chi’amata chikomesa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo naende akabutorana chinguba, na emioro na ebirwanero binde bi’esegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 76:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo okomeka‐meka oichire",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nobonene kogocha korwa ase ebitunwa biababisa kwabuire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 76:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abare ne chinkoro chimwenu baurirwe ebinto konya basakoire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono bararire chitoro chindito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abarwani esegi bonsi basinyirwe korwana namaboko abo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 76:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae o Yakobo, ekero gwatogonyerete abanto bariinete chibarasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "barabwo nigo bagwete inse, bakaba buna nigo bakwete, amo ne chibarasi chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 76:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bweka nigo ore oyo bw’okoondokia mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oranyare gotenena ase obosio bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero kwabeire nendamwamu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 76:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa agwo igoro, nigo kwamanyetie ense ebiina biao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense ekoboa egakira‐kiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 76:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero aye Nyasae gwatenenete konacha ekiina",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobatooria abwo bonsi bagokorerwa bobe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 76:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, endamwamu ya Mwanyabaanto nenyare kogera aye otogigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eyeratigare noyieboyie buna orokini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 76:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe karie chiira ase Omonene, Nyasae oino, na mochiikeranie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto bonsi bamoetanaine, tiga bamorentere ebiegwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere oria ogwenerete koirokwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 76:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agokeyia abare abaenenu ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abarwoti bonsi b’ense nigo bamwoboete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    }
  ],
