          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobaisa korua omoyo one, inche riruma riao, ase omoganda oria omobe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
