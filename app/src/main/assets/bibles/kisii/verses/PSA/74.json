      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ense nigo eichire nobobe ase kera ensemo y’omosunte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
