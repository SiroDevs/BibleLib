    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibweba nonya ng’ake abanto bao abwo baregire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
