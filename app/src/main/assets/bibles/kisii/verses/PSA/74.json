              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae, imoka bwerwanerere aye omonyene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
