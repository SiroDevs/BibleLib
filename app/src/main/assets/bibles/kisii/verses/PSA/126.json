    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okobusura Namariga na Kogesa Nomochengo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 126:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Omonene atoiraneretie intwe Abasayoni ebisio bieito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo twabeete buna abakoroota!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 126:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio emenwa yaito egaichorwa namaseko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chimeme chiaito chigatera as’omogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erio abanto b’ebisaku bagateebania,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Omonene okoreire abanto abwo amang’ana amanene.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 126:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, Omonene otokoreire amang’ana amanene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase igo ntore n’omogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 126:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, toiranerie ebisio biaito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna okoirania chindooche ase Ense ya Irianyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 126:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bakobusura bare namariga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbagese bare nomochengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 126:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bagosoka bakoiyeria amariga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babogoretie chimbusuro gochia kobusura",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbairane bare n’omochengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babogoretie emesaima yabo bagesire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    }
