  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "88",
        "style": "c",
        "sid": "PSA 88"
      },
      "items": [
        {
          "text": "88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ekerero gi’okonyora ogokonywa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera kwa basinto ba Kora; okworokereria kwa Hamani Omoezara)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 88:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Nyasae bw’ogotooreka kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omobaso na obotuko nigo nkorera asore ng’a onkonye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 88:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosaba kwane tiga goike ase obosio bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tegerera oigwe okorera kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 88:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoyo one nigo oichire nemechando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obogima bwane bwaikire ang’e kogenda aase abakuure.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 88:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nabareranigwe amo nabwo bakogenda ase embeera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinguru chiang’ereire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 88:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natigirwe inde buna oyomo bw’abakuure",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna abwo baitetwe, bono bare ase chimbeera ime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabeire buna abwo aye otainyoreti nonya ng’ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwabaatananire korwa ase okoboko kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 88:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwambekire inse kegima ase embeera ime;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo aase are omosunte na aatambe gochia inse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 88:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egesusuro kiao nigo kere ekerito igoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwambagoreire emerindo yao yonsi yantubire kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 88:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabekire aare abagisangio baane twamanyaine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gwankorire nabeire okogechia ase bare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nasiekereirwe, tinkonyara gosoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 88:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso aane amwamire ase okweumia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Omonene, kera rituko nigo ngokorangeria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ndamborete amaboko aane gocha asore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 88:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Abakuure nkobakorera ore amakumia?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Abwo nkoimoka bare na kogotogia?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 88:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Obwanchani bwao ngokwanwa bore ime ase chimbeera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose obwegenwa bwao agwo aase aasareku?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 88:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Amang’ana ao ay’ogokumia namanyire agwo ase omosunte ime?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose oboronge bwao mbomanyire agwo ase ense y’okwebwa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 88:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nigo nkorera asore, onkonye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nemambia ogosaba kwane nigo kogoika asore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 88:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, nase ki gwatugutire omoyo one?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki kwabisire obosio bwao korwa ase ’nde?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 88:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa obwana bwane nabeire inde nemechando, nabeire ang’e nogokwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ndemereretie okogosa kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tindi nogokonywa konde nonya nogoke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 88:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endamwamu yao entindi yantubire kegima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.16",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaakwa ao ansiririe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.16",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 88:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ang’etanaine buna amaache omobaso boira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.17",
            "verseOrgIds": [
              "PSA.88.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwatanire amo, na amigire inche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.17",
            "verseOrgIds": [
              "PSA.88.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 88:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye gwatananire omwanchwa one na omosani one bambeereire",
