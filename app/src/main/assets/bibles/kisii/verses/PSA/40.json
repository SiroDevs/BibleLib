  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "PSA 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera gw’okomotogia Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaba imoganyete Omonene ase okoremereria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ere akanyeonchorera akaigwa ekerero kiane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere akandusia korwa ase engoro y’obosareku,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa ase etintira na esike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agatenenia amagoro aane ase egetare igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agankong’ia ase ngoeta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanyorokereria oteera ogoteera okoyia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogoteera gw’okomotogia Nyasae oito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abange nabayarore na koiroka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igo mbamosemerie Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto oria omosemeretie Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otari kweonchora gochia ase abanto abaenenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ase abwo bagosira ase okoonchokera chinyasae chi’oborimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Nyasae one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogokora kwao na ebirengererio biao ase tore nebi’ogokumia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onde tari orareng’anigwe naye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninganetie koraria ayio na koyakwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende namange mono, takobareka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebing’wanso na ebiruegwa tobiganeti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende amato aane kwayatinoire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ebing’wanso bi’ogosambwa, na ebi’ebibe tobiganeti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ngateeba: “Rigereria, nachire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase egetabu nigo eriikire aya ngwenerete gokora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one, ninganetie nkore ogwancha kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amachiiko ao nigo are ase enkoro yane ime.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omosangererekano omonene narandirie amang’ana amaya ay’oboronge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Omonene, nomanyete ng’a tingotanga ebikoba biane tibiyakwana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyegachereti inche bweka oboronge bwao ase enkoro yane ime;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende nararirie obwegenwa bwao, na ogotooreka kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Timbiseti obuya bwao, na obwegenwa bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa ase omosangererekano omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, tondina amaabera ao!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obuya na obwegenwa bwao bindende botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba gw’okonyora ooboseemiaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Zab 70)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabe amange atari kobareka nigo ang’etanaine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ebibe biane biambuire, goika tinkonyara korora;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "biabeire ebinge kobua etukia y’omotwe one, goika nerusirie moyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, koranche ontoorie!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, oche bwango onkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bonsi barigetie kong’ita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.14",
            "verseOrgIds": [
              "PSA.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga basookigwe na batantanigwe bonsi amo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.14",
            "verseOrgIds": [
              "PSA.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abwo baganetie obobe bonyore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.14",
            "verseOrgIds": [
              "PSA.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bairanigwe magega barore obosooku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.14",
            "verseOrgIds": [
              "PSA.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bagonsiereria bagoteeba: “Kiamonyorire!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.15",
            "verseOrgIds": [
              "PSA.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga bakirigwe‐kiri ase obosooku bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.15",
            "verseOrgIds": [
              "PSA.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abwo bonsi bagokorigia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.16",
            "verseOrgIds": [
              "PSA.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bakogokere na kogochengera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.16",
            "verseOrgIds": [
              "PSA.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo banchete ogotooreka kwao bateebe botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.16",
            "verseOrgIds": [
              "PSA.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Omonene nigo are omonene!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.16",
            "verseOrgIds": [
              "PSA.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo inde omotaka na omoremerwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.17",
            "verseOrgIds": [
              "PSA.40.17"
            ]
          }
        }
