    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Nyasae one, totebana!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.17",
