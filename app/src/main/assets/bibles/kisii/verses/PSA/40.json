    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende Omonene nigo akonyechandera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.17",
            "verseOrgIds": [
              "PSA.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naye ore ogokonywa kwane, na ogotooreka kwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.17",
            "verseOrgIds": [
              "PSA.40.17"
            ]
          }
        }
