    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tinkonyinyera abwo bagosaria asore?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.21",
            "verseOrgIds": [
              "PSA.139.21"
            ]
          }
        }
