            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, naki yare goocha koba buya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onye ’ngwaita abakori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onye abagoitera amanyinga ’mbarua ase ’nde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
