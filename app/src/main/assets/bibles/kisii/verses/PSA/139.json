      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ’mbaabarete ng’a nababisa baane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
