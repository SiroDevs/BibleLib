    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nteeme omanye ebirengererio biane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.23",
            "verseOrgIds": [
              "PSA.139.23"
            ]
          }
        }
