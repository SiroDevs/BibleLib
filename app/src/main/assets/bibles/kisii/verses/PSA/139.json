              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Origererie timbwatia enchera y’obosiru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.24",
            "verseOrgIds": [
              "PSA.139.24"
