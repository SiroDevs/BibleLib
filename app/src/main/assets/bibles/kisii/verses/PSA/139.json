          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, ndiga‐rigie omanye enkoro yane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.23",
            "verseOrgIds": [
              "PSA.139.23"
            ]
