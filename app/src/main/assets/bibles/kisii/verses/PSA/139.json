          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bagokwana bobe igoro yao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bare abaenenu bagokora ebibe asore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        }
