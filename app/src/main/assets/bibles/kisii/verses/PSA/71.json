          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobaso boira oromeme rwane ndobe rokona-gokwana igoro y’oboronge bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.24",
            "verseOrgIds": [
              "PSA.71.24"
            ]
          }
        }
