          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omente obonene bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.21",
            "verseOrgIds": [
              "PSA.71.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ondemie naende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.21",
            "verseOrgIds": [
              "PSA.71.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
