          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one, nimbe nkobugia obokano ase okogotogia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera aye nigo ore omwegenwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimbe nkogoterera ase okobugia obokano bw’ebirigisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Omochenu bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
