  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "71",
        "style": "c",
        "sid": "PSA 71"
      },
      "items": [
        {
          "text": "71",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosaba kw’omonto omogotu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 71:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, naye natameire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tontiga nsookigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 71:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkonye na onsibore goetera ase oboronge bwao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ntegerere, ontoorie!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 71:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kabe egetare kiane ki’obotamero ase nkogenda botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye gwanchire gontooria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki aye negetare kiane, na egekengero kiane egekong’u.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 71:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae one, ntoorie korwa ase okoboko kw’omokori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "indusie korwa ase okobua kw’oyo otari omooronge, na oyore omotindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 71:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, naye ogosemeria kwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabeire nkwegenete korwa obwana bwane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 71:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabeire gontenenerete korwa ekero ntaraiborwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naye kwandusetie korwa ase enda ya baba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naye ndabe nkona-gotogia botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 71:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nabeire buna egento ki’ogoichanerwa ase abanto abange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende aye naye obotamero bwane obokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 71:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonwa one noichorigwe nogotogigwa kwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omobaso boira ninkobake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 71:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobaisa gonchwara ekero ndabe nagotire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tontiga ekero chinguru chirabe chiang’ereire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 71:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa baane nigo bakongamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "basangererekanire gokora omooroberio bw’ogonsiria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 71:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bateeba: “Nyasae omotigire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inchwo tomotunye, erinde tomobwate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onde tari oranyare komotooria.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 71:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, tombeera aare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae one, inchwo bwango onkonye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 71:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababisa abwo bakorigia obogima bwane, tiga basookigwe na gosirigwa kegima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakorigia gonkora bobe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bachaywe na gochecherigwa mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 71:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende inche nimbe nogosemeria botambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na nimbe nkona-kogotogia mono goetania.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 71:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbe nkoraria ogokora kwao kw’oboronge nomonwa one.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omobaso boira nimbe nkonagwatora ogotooreka kwao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okwo kore okonene ntanyare gokorenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 71:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene Nyasae, nimbe nkoraria ogokora kwao okonene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe nkona-gotogia oboronge bwao,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ningotogie aye bweka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 71:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, kwabeire gokonyorokereria korwa obwana bwane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.17",
            "verseOrgIds": [
              "PSA.71.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika reero iga ningenderere konakoraria ogokora kwao kw’ogokumia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.17",
            "verseOrgIds": [
              "PSA.71.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 71:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, tobaisa gonchwara ekero ndabe nagotire, namerire chimbuche chiarabire se,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.18",
            "verseOrgIds": [
              "PSA.71.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika imbe narareirie abanto b’ebiaare bigochi-gocha chinguru chiao, na okobua kwao.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.18",
            "verseOrgIds": [
              "PSA.71.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 71:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, oboronge bwao boigete aaria igoro mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye nigo gwakorete amang’ana amanene mono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, Nyasae, ning’o ore buna aye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 71:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero gwatotigete, nigo twaroche emechando emenge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.20",
            "verseOrgIds": [
              "PSA.71.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende nonyare gotokora abayia naende;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.20",
            "verseOrgIds": [
              "PSA.71.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "torusie, ototiirie korwa ase chiirima chire ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.20",
            "verseOrgIds": [
              "PSA.71.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
