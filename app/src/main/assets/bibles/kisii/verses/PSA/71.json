          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’ake eriogi rinene ri’omogooko nomonwa one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero ndabe ngotera amatera akogotogia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nintere nomoyo one boigo, ekiagera aye gwantooririe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
