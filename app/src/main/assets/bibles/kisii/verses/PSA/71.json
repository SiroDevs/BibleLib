    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde abwo barigetie gonkora bobe basookigwe na gochaywa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.24",
            "verseOrgIds": [
              "PSA.71.24"
            ]
