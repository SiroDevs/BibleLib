          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe amarwoti are ase ense, tera motogie Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.32",
            "verseOrgIds": [
              "PSA.68.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tera amatera ay’okomotogia Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.32",
            "verseOrgIds": [
              "PSA.68.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 68:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moteerere ere oria oriinete igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.33",
            "verseOrgIds": [
              "PSA.68.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igoro eria yarengeo korwa chingaki chia kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.33",
            "verseOrgIds": [
              "PSA.68.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rora, nigo agoaka eriogi riaye rire ne chinguru riaigugwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.33",
            "verseOrgIds": [
              "PSA.68.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PSA 68:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe raria okobua kwa Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.34",
            "verseOrgIds": [
              "PSA.68.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio obonene bwaye bore igoro y’Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.34",
            "verseOrgIds": [
              "PSA.68.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okobua kwaye nigo kore igoro onsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.34",
            "verseOrgIds": [
              "PSA.68.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PSA 68:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo are oyo bw’okogosa korwa ase obomenyo bwaye obochenu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.35",
            "verseOrgIds": [
              "PSA.68.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere Nyasae bw’Abaisraeli;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.35",
            "verseOrgIds": [
              "PSA.68.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akoa abanto baye okobua ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.35",
            "verseOrgIds": [
              "PSA.68.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene atogigwe!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.35",
            "verseOrgIds": [
              "PSA.68.35"
            ]
          }
        }
