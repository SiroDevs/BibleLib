  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "68",
        "style": "c",
        "sid": "PSA 68"
      },
      "items": [
        {
          "text": "68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera kw’egesaku ase engencho y’obobui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "(Ogoteera gwa Daudi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 68:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Nyasae aimokerere igoro, na ababisa baye basiarerwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto abwo bamogechete, tiga batame barue asare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 68:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga baserigwe gochia aare, buna erioki rikoirwa aa n’aaria;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga abakori amabe basirigwe kegima, barue ase obosio bwa Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "basirigwe buna obochoe bokonyititoka ase omorero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 68:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abanyene oboronge tiga babe nomogooko omonene kegima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga babe nomochengo ase obosio bwa Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babe bagoteera bare nomogooko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 68:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moteerere Nyasae, tera amatera agotogia erieta riaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Moroiserie enchera ere agoetera ase chirooro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erieta riaye n’Omonene, kabe nomochengo ase obosio bwaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 68:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae oria omenyete aase aye aachenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere ise bwe chintakana, na omorendi bw’ababoraka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 68:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo akoa abatigirwe bosa chinka ase bakomenya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo agosibora abanto basibire baseseneka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abasaria nigo bakomenya ase ense enyomo kegima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 68:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, ekero gwatang’anete abanto bao",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogotaara ase erooro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 68:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ense nigo yatengechete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "embura egatwa korwa igoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aye Nyasae nao kwarenge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nonya negetunwa gia Sinai nigo giatengechete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero aye Nyasae kwarengeo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye ore Nyasae bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 68:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, nigo kwarentete embura enyinge mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igo omwando oo oria konya orosire okayoiraneria chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 68:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoganda oo okanyora obomenyo aase agwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Nyasae, ase engencho y’obuya bwao, kwaeire abanto abataka aya baremeire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 68:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae akarua ogochika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoganda omonene bw’abakungu bakararia amang’ana ayio:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 68:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abarwoti b’abarwani esegi batamire, ee, batamire!”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abakungu batigarete ase chinka ngwatanana bare ebisakorwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 68:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya bagendererete kobeera ase ameri e ching’ondi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bare buna amaruma are ne chimbaaba chiatubire nefeta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amarionya abo atubire netaabu ekomeka‐meka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 68:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Omonene, Omobui asiarerete abarwoti b’aase agwo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amagena ’embura agatwa ase egetunwa gia Salimoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 68:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye egetunwa kia Basani, nigo ore egetunwa kia Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.15",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye egetunwa kia Basani, nigo obwate ebichuria ebinge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.15",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 68:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye egetunwa ki’ebichuria ebinge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nase ki okorigereria ne ribero",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase egetunwa ekio Nyasae achorire koba obomenyo bwaye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, Omonene ochorire komenya aroro kogenderera botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 68:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigari chia Nyasae nigo chire chilifu chinyinge mono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.17",
            "verseOrgIds": [
              "PSA.68.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo are ase egati yabo buna nase Sinai, Aase aye aachenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.17",
            "verseOrgIds": [
              "PSA.68.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 68:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ogatiira gochia igoro ogoosa abasibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okanyora ebiegwa ase egati ya Mwanyabaanto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nonya nase egati y’abasaria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a aye Omonene Nyasae onyare komenya aroro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 68:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene atogigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.19",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rituko ase rituko nigo agotobogoreria chigurube chiaito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.19",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae nere ogotooreka gwaito.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.19",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 68:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae oito nigo are Nyasae ogotooria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.20",
            "verseOrgIds": [
              "PSA.68.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae oito, Omonene nigo agototooria korwa ase amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.20",
            "verseOrgIds": [
              "PSA.68.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 68:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nasenyente emetwe y’ababisa baye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nasenyente ebiore bire netukia bi’abwo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakogenderera ne chinchera chiabo chi’ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 68:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Nyasae agateeba:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ning’iranie abanto abwo korwa Basani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbarente korwa ase chindiba chi’enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 68:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde motache amanyinga abo namagoro aino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.23",
            "verseOrgIds": [
              "PSA.68.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chisese chiaino chinyore ebitari biabo biababisa baino.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.23",
            "verseOrgIds": [
              "PSA.68.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 68:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, omoganda oo ogotaara ororekanire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, aye Nyasae one, na omorwoti one,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoganda oria oo ogosoa ase obomenyo bwao obochenu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 68:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abateri nigo batang’aine bosio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "magega yabo abakobugia amakano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase egati yabo abaiseke bakobugia chinchigiri:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 68:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abamore ab’ororeria rw’Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.26",
            "verseOrgIds": [
              "PSA.68.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "motogie Nyasae ase egati y’omosangererekano Omonene.”",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.26",
            "verseOrgIds": [
              "PSA.68.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 68:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ba Benjamini, abare abasinini mono ase egati yabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nao bare baabatang’aine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanene b’Abayuda nao bare",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amo nomoganda obo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanene b’Abasabuloni na ab’Abanafutali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 68:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae, oorokia okobua kwao;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.28",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee Nyasae, ayio gwatokoreire, genderera koyabeka chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.28",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 68:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwoti nigo bagokorentera ebiegwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.29",
            "verseOrgIds": [
              "PSA.68.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ime ase Hekalu yao ere agwo Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.29",
            "verseOrgIds": [
              "PSA.68.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 68:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togonyera eng’iti eria y’orosana emenyete ase ebitonto ime,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaicho e chieri amo ne chimori chiabo, nabwo abanto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Togonyera abanto goika bekeyie na gokoruera chifeta chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Osiarere abanto banchete esegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 68:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bare ne chinguru mbarue Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.31",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto b’Ethiopia baayerere koramborera Nyasae amaboko abo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.31",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
