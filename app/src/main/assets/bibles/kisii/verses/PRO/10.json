      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Emebayeno ya Sulemani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eye nemebayeno ya Sulemani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Omwana omomura omong’aini nigo akogokia ise, korende oyore omoriri nigo akorentera ng’ina omoichano.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinibo chi’ogokora okobe tichiri gokonya kende, korende oboronge nigo bogotooria korwa ase amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene tari gotiga omonyene oboronge abe nenchara; korende nigo akwanga okogania kw’abakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogokora emeremo n’amaboko amoro nigo akoba omotaka, korende amaboko are nomokia nigo akorenta obotenenku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana omomura ogosangereria chindagera engaki ye rigesa nigo are omong’aini, korende oyo okorara engaki eyio nigo akorenta obosooku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosesenigwa nigo gokobera ase omotwe bw’omonyene oboronge, korende obochege nigo boichire ase emenwa y’abakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoinyorwa kw’omonyene oboronge nigo gokorenta ogosesenigwa, korende erieta ri’omokori amabe nigo riragunde.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore omong’aini ase enkoro yaye nigo anchete amachiiko, korende oyogokwana amang’ana atagwenereti nigo arasirigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okobwatia chiinchera chi’oboronge nigo araarendwe buya, korende oyo okobwatia chiinchera chimbe nigo aramanyekane.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogosumera amaiso ase okogenka nigo akorenta emechando, na oyogokwana amang’ana atagwenereti nigo arasirigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonwa bw’omonyene oboronge nigo onga buna ensoko y’obogima, korende obochege nigo boichire ase emenwa y’abakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obogechani nigo bokorenta eriomana, korende obwanchani nigo bogotuba ebibe bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obong’aini nigo bokonyorekana ase omonwa bw’omonto omomanyi, korende oyo otari n’okomanya nigo agwenerete aakwe enyimbo ase omogongo oye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abang’aini nigo bakogaacha chiseemi, korende omonwa bw’omonto omoriri nigo okorenta ogosirigwa ang’e.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obotenenku bw’omonto omonda nigo bore ase are buna omochie ogiteire chindwaki, korende obotaka nabwo ogosirigwa kw’abataka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.15",
            "verseOrgIds": [
              "PRO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okonyora kw’omonyene oboronge nigo gokomoraa gochia ase obogima, korende ebitoki bi’omokori amabe nigo bikomoraa gochia ase ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okoigwera okorongeigwa nigo akorobera ase enchera y’obogima, korende oyo okwanga korongeigwa nigo agosoa ase obosiru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.17",
            "verseOrgIds": [
              "PRO.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto obisete okogecha ime yaye nigo agokwana oborimo korwa ase omonwa oye, na oyo ogotaaria obogenki nigo are omoriri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.18",
            "verseOrgIds": [
              "PRO.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogokwana amang’ana amaange tari komocha korenta ogosaria, korende oyo orendete omonwa oye nigo are omong’aini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.19",
            "verseOrgIds": [
              "PRO.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oromeme rw’omonyene oboronge nigo ronga buna efeta echenire korende ebirengererio bi’omokori amabe tibiri na igori rinde.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.20",
            "verseOrgIds": [
              "PRO.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikoba bi’omonyene oboronge nigo bikorenta amaya ase abanto abange, korende oboriri nigo bogoita.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.21",
            "verseOrgIds": [
              "PRO.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosesenigwa kw’Omonene nakwo gokorenta obotenenku, na ere tari kobeeka obororo ase ogosesenigwa okwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.22",
            "verseOrgIds": [
              "PRO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omoriri nigo agokora ebibe buna egosori, korende omonto ore nokomanya nigo agokora ayare ay’obong’aini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.23",
            "verseOrgIds": [
              "PRO.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aria omokori amabe airogete naro akomochera, korende omonyene oboronge ’naikeranerigwe amagania aye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.24",
            "verseOrgIds": [
              "PRO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero omwaga ekembugu‐mbugu ogoeta, omokori amabe nigo agosirigwa, korende omonyene oboronge nigo agotenena bokong’u kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.25",
            "verseOrgIds": [
              "PRO.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna obokang’iti bokoba ase amaino na erioki rikoba ase amaiso, naboigo omonto omworo akoba ase abwo bakomotoma abakorere emeremo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.26",
            "verseOrgIds": [
              "PRO.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomoiroka Omonene nigo gokomenta obomenyo ase obogima, korende emiaka y’omokori amabe nigo ekweng’eigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.27",
            "verseOrgIds": [
              "PRO.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosemeria kw’abanyene oboronge nigo kogoikeranigwa ase omogooko, korende okw’abakori amabe nokwabosa.",
