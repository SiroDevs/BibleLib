              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogosumera ebioge bi’amaiso aye nigo akoroberia amabe, na oyo ogotakuna omonwa oye nigo agoikerania amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.30",
