  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "PRO 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkoro y’omorwoti nigo enga buna orooche rore ase okoboko kw’Omonene; n’Omonene nigo akomoraa gochia aande onsi buna aganetie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera enchera y’omonto nigo ekororekana ng’a neya boronge ase are, korende Omonene nigo akorenga chinkoro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogokora oboronge na ekeene, ayio naro Omonene agwancha kobua ebing’wanso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso are noboenenu, na enkoro y’obomwenu, ebio nigo bire etaya y’abakori amabe, bikobaraa bakora ebibe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeroberio y’omonto omong’aini nigo ekomorentera ebitoki ebinge, korende omonto okoayerera nigo akogeenderera koremerwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinibo chikonyorwa ase oromeme rw’obong’ainereria, nigo chikoera buna omooki, nigo chire n’obosongo buna emetego ya amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obourereria bw’abakori amabe ’mbobasirie barueo, ekiagera bangire gokora ayare ay’oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchera y’omomochi nigo ere enkorekanu, korende ogokora kw’oyore n’enkoro endonge nigo kore okoronge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuya komenya ase ekenunchi kia irongo, kobua komenya amo ase enyomba n’omokuungu omonyariomana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoyo bw’omokori amabe nigo okogania gokora ebibe, na omonto oyio tari kororera omonto onde amaabera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero omonto omonyacheche akonyora egesusuro, oria otamanyeti amaange nigo akoba omong’aini; na ekero omonto omong’aini akworokererigwa nigo akonyora chiseemi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae omonyene oboronge nigo akorigereria enyomba y’omokori amabe; ere nigo akoiyeria abakori amabe inse basire.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oria ogosieka amato aye ng’a taigwa ekerero ki’omotaka, nere ekero ararere takoiguugwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeegwa gekoruegwa bobisi nigo kegokendia endamwamu, ne riaaki ribisire ase eanga ime nigo rigokendia ekeririanda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ekeene giakorirwe, ayio nigo akoba omogooko bw’abanyene oboronge, korende ase abakori amabe nomoichano.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogotiga enchera y’obomanyi, oyio nabeere ase omosangererekano bw’abaanto bakwete.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.16",
            "verseOrgIds": [
              "PRO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto bwanchete emegoko goika abe omotaka; na oyobwanchete kwegokia nedivai na amaguta takoba omonda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.17",
            "verseOrgIds": [
              "PRO.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo agosoa ase emechando y’omonyene oboronge, oba embooria yaye, na oyo otari omwegenwa oba embooria y’oyore n’enkoro endonge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuya komenya ase ense y’erooro, kobua komenya n’omokuungu omonyariomana, naende omonyandamwamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.19",
            "verseOrgIds": [
              "PRO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omong’aini nigo akorenda chinibo chi’engeencho enene amo namaguta ase enka yaye, korende omoriri nigo agochiria bobe chiaera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.20",
            "verseOrgIds": [
              "PRO.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okorigia oboronge na obwororo, oyio ’nanyore obogima, na amasikani, na oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.21",
            "verseOrgIds": [
              "PRO.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omong’aini nigo akoumokera omochie ore nabarwani esegi chituoni oyobua, erio otagora chindwaki chiria abanto abwo basemeretie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto orendete omonwa oye, na oromeme rw’aye, oyio nigo etangerete emechando.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.23",
            "verseOrgIds": [
              "PRO.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore omoenenu na omwerori, na ogokora kwaye kore okw’obomwenu, nigo akorokwa “Omochecheria”.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.24",
            "verseOrgIds": [
              "PRO.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okogania kw’omonto omworo nigo gokomoita okwa, ekiagera nigo akwanga gokora emeremo namaboko aye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.25",
            "verseOrgIds": [
              "PRO.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omong’iti nigo akweganeria kera egento botambe, korende omonyene oboronge nigo akorua na tari kong’itia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.26",
            "verseOrgIds": [
              "PRO.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeng’wanso ki’omokori amabe nigo kere okogechia, Inee, tari bobe mono goetania ekero agokerua nebirengererio ebibe?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirori bw’oborimo nasire, korende omotegereri omuya nageenderere gokwana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.28",
            "verseOrgIds": [
              "PRO.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo agokong’ia obosio bwaye, korende oyore nenkoro endonge nigo akorenda orogendo rw’aye.",
          "type": "text",
