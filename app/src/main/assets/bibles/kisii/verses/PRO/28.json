{
  "id": "PRO.28",
  "number": "28",
  "bookId": "PRO",
  "reference": "Egetabu ki’Emebeyano 28",
  "copyright": "© 2021 KENBS",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "PRO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori amabe nigo bagotama nonya onde tari kobabwatia, korende abanyaboronge nigo bare abaremu buna chindo chinsae.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.1",
            "verseOrgIds": [
              "PRO.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ense yasaririe nigo ekoba n’abagaambi abange, korende eye ebwate abanto bare nobong’aini na okomanya, obogambi nigo bokogeenderera gotenena bokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.2",
            "verseOrgIds": [
              "PRO.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omotaka ore n’okobua ogokorera abataka bande bobe ase okobaurereria, nigo anga buna embura enyinge egosaria chindagera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.3",
            "verseOrgIds": [
              "PRO.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto batigire amachiiko nigo bagotogia abakori amabe, korende abarendete amachiiko nigo bakoamererania nabwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.4",
            "verseOrgIds": [
              "PRO.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakori amabe tibamanyeti ayare amaronge, korende abwo bakomorigia Omonene nigo bayamanyete onsi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.5",
            "verseOrgIds": [
              "PRO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omotaka okobwatia oboronge nigo are omuya kobua omonda ore omokorekanu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.6",
            "verseOrgIds": [
              "PRO.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana orendete amachiiko nigo are omong’aini, korende oyore omogisangio bwa baria bobe nigo akorenta obosooku ase ise.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okomenta chinibo chiaye ase enchera etari ey’ekeene ase okogania ebitoki, oyio nigo agochisangereria chibe echi’omonto okororera abataka amaabera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okoonchora ogoto kwaye taigwera amachiiko, nonya n’ogosaba kwaye nigo kore okogechia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.9",
            "verseOrgIds": [
              "PRO.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogosiria abare ne chinkoro chindonge, na kobaraa ase enchera ende, oyio nagwe ase eirima eria aremire ere omonyene, korende abwo batari na komocha ’mbanyore omwando omuya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omonda nigo akwerengereria ng’a nomong’aini are, korende omonto omotaka ore n’okomanya nigo aramotuke amomanye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.11",
            "verseOrgIds": [
              "PRO.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanyene oboronge babuire, okoiririata okonge nigo gokobao, korende ekero abakori amabe bakobua, abanto nigo bakwebisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okobisa ebibe biaye tagosesenigwa, korende oyo okobiorokia na kobitiga narorerwe amaabera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto omoirogete Omonene botambe, korende oyo okong’etie enkoro yaye nanyore emechando eramosirie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omogambi omokaayayu okogambera abanto abataka nigo anga buna endo ekoruma, gose edubu yagechiigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.15",
            "verseOrgIds": [
              "PRO.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omogambi otari n’obong’aini nigo are omochaandi omotindi, korende oria ogechete okonyora ebitooki bitari bi’oboronge, nigo akogeenderera kogamba ase amatuko amaange.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.16",
            "verseOrgIds": [
              "PRO.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye omonto oritoereirwe n’okomocha kw’ogoitera amanyinga y’omonto onde, tiga abe okona‐gotama goika akwe, na onde tagokoonya omonto oyio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.17",
            "verseOrgIds": [
              "PRO.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto otari na komocha ase chiinchera chiaye natoorigwe; korende oyore omokorekanu ase chiinchera chiaye nasire ase eyemo y’echio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.18",
            "verseOrgIds": [
              "PRO.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogokora emeremo ase omogondo oye ’nanyore endagera enyinge, korende oyokobwatia emeroberio etagwenereti nigo arabe omotaka omoraboku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.19",
            "verseOrgIds": [
              "PRO.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore n’enkoro endonge ’nanyore ogosesenigwa okonge, korende oyo okoayerera ase okoba omonda takomocha konyora egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.20",
            "verseOrgIds": [
              "PRO.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho y’agasamunye k’omogati omonto nigo agwesaria ase ogwanchereria. Korende, tari buya gokora ogwanchereria nonya ’ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.21",
            "verseOrgIds": [
              "PRO.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omwegimeria nigo akoayerera koba omonda, gose tari korengereria ng’a obotaka ’mbomonyooore.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.22",
            "verseOrgIds": [
              "PRO.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogotogonyera oyo oiranire magega ase okomoorongeyia ’nanyoore ogwancherwa kobua oria okomong’aina namang’ana amansu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.23",
            "verseOrgIds": [
              "PRO.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okoura ise gose ng’ina enibo yabo, erio oteeba, “Ebi tibiri ebibe,” oyio nigo are omogisangio bw’oyogosiria.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.24",
            "verseOrgIds": [
              "PRO.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore n’endamwamu nigo agoseegeta eriomana, korende oyosemeretie Omonene ’natenenkigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.25",
            "verseOrgIds": [
              "PRO.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyobwesemeretie ere omonyene, oyio nomoriri, korende oyo okobwatia obong’aini natoorigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.26",
            "verseOrgIds": [
              "PRO.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogokoonya abataka takoremerwa, korende oyo ogotuba amaiso aye ng’a tarora abataka ’nanyore okoragererigwa okonge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.27",
            "verseOrgIds": [
              "PRO.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abakori amabe bakogamba, abanto nigo bakwebisa, korende ekero basiriigwe, abanyaboronge nigo bakomentekana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.28",
            "verseOrgIds": [
              "PRO.28.28"
            ]
          }
        }
      ]
    }
  ],
