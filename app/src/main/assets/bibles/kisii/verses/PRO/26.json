  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "PRO 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana obokendu bogocha ase engaki y’egurugura, gose embura egotwa ase engaki ye rigesa, naboigo ere bobe omonto omoriri konyora amasikani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna enchiro ekona‐koong’anya, na buna egesingororo gekoiruruka, naboigo na okoragereria gotari nengeencho gotaikere oria oragererigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeranya nigo kere ase ogoaka ebarasi, na ekeokio ase okoraa etigere, naboigo n’enyimbo ere ase ogoaka omogongo bw’omonto omoriri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobaisa koiraneria omonto omoriri buna oboriri bwaye bore, nigo orabaise koba omoriri buna are.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moiranerie omonto omoriri buna oboriri bwaye bore, tabaisa gwekaga ng’a nomong’aini are.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogotoma amang’ana ase okoboko kw’omonto omoriri, oyio nigo akobutora amaboko aye omonyene bwerentera emechando.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoreng’anio ogokwanwa n’omonwa bw’omoriri nigo onga buna omonto egesegora, okogoro kwaye gotari gokora emeremo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okoa omoriri amasikani, nigo anga buna oyokoruta omobuko ore n’ebinto bi’erigori rinene ase etui y’amagena.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoreng’anio okorwa ase omonwa bw’omonto omoriri nigo onga buna rigwa rikobeta okoboko kw’omonto otindire amarwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omanyete emeremo nigo agwekorera emeremo emiya, korende oyore omoriri nigo akoriika onde bwensi ogoeta, na emeremo yasareka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omoriri okoiranerera gokora oboriri bwaye nigo anga esese ekoiranera amaroki aye enyene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oise korora omonto ogwekora omong’aini, ogosemeria ’nkore ase omonto omoriri kobua ase oyio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omworo nigo agoteeba, “Endo nere isiko, ee, endo nere ase chiinchera chi’omochie.”",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omworo nigo akonakweoncha‐onchora buna egesieri gekona‐koonchorwa ase chimbata gesibeire.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omworo nigo akobeeka okoboko kwaye ase esani y’endagera, orosa gokobogoria gocha ase omonwa oye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omworo nigo akwerora ng’a n’omong’aini are abuete abanto batano na babere barakwane amang’ana are n’engeencho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto orenge goeta na gwesoyia ase eriomana ritarenge eriaye nigo anga buna oyo okobwata amato y’esese.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.17",
            "verseOrgIds": [
              "PRO.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okong’aina omonto onde, na magega yaye omoteebia, “Negosori yoka nare kogokorera,” oyio nigo anga buna ebarimo ekoruta ebigenga bi’omorero, ne chinsara, chia amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase chinko chitari, omorero nigo okorima, naboigo nase omogenki atari, eriomana nigo rigosira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.20",
            "verseOrgIds": [
              "PRO.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonyariomana ogoseegeta amariomana nigo anga buna amakara akogeenderera koyia, gose chinko chikogera omorero ogeenderera gwoka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana omonto omoitania nigo are buna endagera enyansu egotirimboka gochia ase enda inse.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.22",
            "verseOrgIds": [
              "PRO.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto obwate amang’ana amansu ase ebikoba biaye, korende ore nobobe ase enkoro yaye, nigo anga buna egekorero ki’amaroba giatekire keoomire nefeta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omogechi nigo akobisa ase ebikoba biaye, obong’ainereria bore ase enkoro yaye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero agokwana amang’ana are amansu, tobaisa komwegena, ekiagera nabwate ay’okogechia atano na abere, ase enkoro yaye ime.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naisa gotuba okogecha kwaye nobong’ainereria, obokayayu bwaye goika bomanyekane n’omosangererekano bwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.26",
            "verseOrgIds": [
              "PRO.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okorema eirima, nere omonyene oragwe imeo; na omonto ogoturunkania rigena, nere omonyene rirairanere rimogwere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
              "PRO.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore noromeme rogokwana oborimo, nigo akogecha abanto abwo amang’ana aye achaandire bobe, na omonwa ogokwana amang’ana ay’okweansia nigo okorenta ogosirigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.28",
            "verseOrgIds": [
              "PRO.26.28"
            ]
          }
        }
      ]
    }
  ],
