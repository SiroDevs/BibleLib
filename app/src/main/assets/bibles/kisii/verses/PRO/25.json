  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "PRO 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Emebayeno ende ya Sulemani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eye nero emebayeno ya Sulemani, eyio abanto ba Hezekia omorwoti bw’Abayuda, basangereretie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.1",
            "verseOrgIds": [
              "PRO.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bore obonene bwa Nyasae kobisa amang’ana; korende na obonene bw’abarwoti gokora obotuki ase amang’ana ayio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana igoro ere aare mono etatukwe emanywe, na ayare ase ense inse boigo, ne chinkoro chi’abarwoti tichigotukwa chimanywe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusia amabiria korwa ase efeta, na omoturi ’nanyore efeta akoroiseria egekorero ekiya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusia abakori amabe korwa ase obosio bw’omorwoti, erio ekerogo kiaye ki’obonene nigo kerageenderere gokong’igwa n’oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobaisa gwetang’anania ase obosio bw’omorwoti, gose tobaisa kwebeeka aase abanene bare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo er’abe buya mono ekero orateebigwe, “Inchuo gocha aa”, kobua goseerigwa gochia goikaransa magega korwa ase ribaga ri’abaanto abasike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toba omwango kogeenda ase ekegambero. Inee! Inki orakore ase omoerio, ekero omonto oyio gwasoerete arakobue n’obe n’obosooku?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye aye omonyene kobwate amang’ana n’omonto onde, kwana nere, korende tobaisa koorokia obobisi bw’omonto omoao.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oise koboorokia, na omonto onde aise koigwa ayio, nigo aragosookie, na erieta ria’o risareke kogeenderera botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ring’ana rigokwanwa ase enchera egwenerete nigo ringa buna amatunda amororo amaya mono abekire ase egekabu keroisirie korwa ase efeta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omong’aini ogokuurera oyokoigwera nigo are buna ebonyi ne chisonoi biroseirie chitaabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omotomwa ore omwegenwa nigo are ase abwo bakomotoma buna amaache amakendu ase engaki ye rigesa, ekiagera nigo akogera emioyo yabo yaba emeyia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogwetogia ng’a nare nomoyo omorabu, ko tari korua ebiegwa, nigo anga amare na omwaga bitari korenta embura.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboremereria nigo bokwororobia omogambi, na oromeme rw’obwororo nigo rokobuna riuga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.15",
            "verseOrgIds": [
              "PRO.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kwanyorire obooke, karie ekerengo kegoisaine; oise kogeetania nigo oraboroke.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.16",
            "verseOrgIds": [
              "PRO.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagoro ao tanara kona‐kogeenda ase enyomba y’omosani oo, nigo arabaise korosa naye, erinde akogeche.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.17",
            "verseOrgIds": [
              "PRO.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okoba kirori bw’oborimo ase omonto onde nigo anga buna enungu y’eseegi, gose omoro, gose ensara enyonge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.18",
            "verseOrgIds": [
              "PRO.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogosemeria omonto otari omwegenwa ase engaki y’emechando, nigo enga buna erino ribunegete gose okogoro goteng’eretie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.19",
            "verseOrgIds": [
              "PRO.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogoteera amatera y’omogooko ase omonto obwate enkoro ere nobororo nigo anga buna okorusia eanga ase engaki y’obokendu gose kobeeka egento ekeroro ase riote.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.20",
            "verseOrgIds": [
              "PRO.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye omobisa oo ore nenchara, moe endagera arie; onye ore nerang’o, moe amaache anywe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.21",
            "verseOrgIds": [
              "PRO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo nobeke omorero bw’amakara ase omotwe oye, n’Omonene nakoe eng’eria yao.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.22",
            "verseOrgIds": [
              "PRO.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwaga okogusa korwa sugusu nigo okorenta embura, naboigo nomonto omogenki akorenta okobeeana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.23",
            "verseOrgIds": [
              "PRO.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuya komenya ase ekenunchi kia irongo igoro, kobua komenya ase enyomba amo n’omokungu omonyariomana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.24",
            "verseOrgIds": [
              "PRO.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana amaya akorentwa korwa ase ense y’aare nigo anga buna amaache amakendu ase omonto ore n’erang’o.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.25",
            "verseOrgIds": [
              "PRO.25.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonyene oboronge okorua ribaga ase omokori amabe nigo anga buna orooche rore netintira na buna ensoko yasarekire.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.26",
            "verseOrgIds": [
              "PRO.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari buya koria obooke obonge, na abwo bakwerigeria obonene, obonene bwabo nigo borabe bosa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.27",
            "verseOrgIds": [
              "PRO.25.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto otamanyeti kwegambera omonyene nigo anga buna omochie chindwaki chiaye chiatagoirwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.28",
            "verseOrgIds": [
              "PRO.25.28"
            ]
          }
        }
      ]
    }
  ],
