            "sid": "PRO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero atongete igoro chionsi nao narenge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nekero abeekerete amaache chimbebe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abeegete igoro ekabao,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero abeegete chinsoko chigosokia amaache korwa ase chindiba ne chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ekero abeekerete chinyancha chimbebe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaache tabaisa goetania ogochika kwaye;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero abeegete amaroso y’ense nao narenge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo narenge amo nere buna oyomanyete emeremo eyio buya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Kera rituko nigo arenge kogokigwa nainche,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na inche ’nkaba inde nomogooko ase obosio bwaye botambe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nagokerete ense yaye emenyire nabaanto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na nkaba nsasokerete Mwanyabaanto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na bono, inwe abana bane, ’ntegerere moigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbare n’omogooko abwo barendete chiinchera chiane,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwera amorokererio!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ancha obong’aini, timobwanga!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasesenirie omonto oyio okonyigwera;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio okorenda ase ebiita biane kera rituko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oganyete ase ebisieri biane.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto onyorire inche, oyio onyorire obogima;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nancherwe n’Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "PRO 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende oyio otari nainche nigo akwenachera ekiina ere omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.36",
            "verseOrgIds": [
              "PRO.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bonsi abangechete nigo banchete amakweri.”",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.36",
            "verseOrgIds": [
              "PRO.8.36"
            ]
          }
        }
      ]
