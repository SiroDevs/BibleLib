          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo naiboretwe oboroso bw’ebitunwa botarabekwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebigoro bitarabao,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero ataratonga ense ne riroba riaye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya norotu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        }
      ]
    },
    {
