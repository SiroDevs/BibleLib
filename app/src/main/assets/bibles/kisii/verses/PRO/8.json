          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ’nkoa abwo banyanchete obotenenku na goichoria chikungo chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo arenge nainche korwa omochakano bwe chiinchera chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo kare konya ataratonga kende gionsi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
