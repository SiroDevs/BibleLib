          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao narenge korwa agwo kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nense konya etarabao.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo naiboretwe chindiba chitarabao,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya ne chinsoko chi’amaache.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
