  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "PRO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egepimo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        },
        {
          "text": "ki’oborito ki’oborianania nigo kere okogechia ase Omonene, korende egi’ekeene nigo gekomogokia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero oboenenu bwachire, nobosooku nario bogocha, korende obong’aini nigo bokonyorekana ase abanto abaitongo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwegenwa bw’abanyene oboronge nigo bokobaraa, korende obokorekanu bw’abatari abegenwa nigo bokobasiria.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinibo tichiri gokonya kende ase rituko ri’endamwamu, korende oboronge nigo boratoorie korwa ase amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.4",
            "verseOrgIds": [
              "PRO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboronge bw’omonto omoikeranu nigo borarongeyie chiinchera chiaye, korende omokori amabe, obobe bwaye ’mbomoiyerie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.5",
            "verseOrgIds": [
              "PRO.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboronge bw’abaanto bare ne chinkoro chindonge mbobatoorie, korende abasaria nigo barabwatwe n’okogania kwabo okobe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero omokori amabe agokwa, ogosemeria kwaye nigo kogokwa amo nere, ee, aya abwo batamoirogeti Nyasae basemeretie nigo agosira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonyene oboronge nigo akorusigwa ase emechando, erio omokori amabe osoa ase emechando ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.8",
            "verseOrgIds": [
              "PRO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo otamoirogeti Nyasae nigo agosiria abanto bande n’amang’ana agokwana korwa ase omonwa oye, korende goetera ase obong’aini abanyene oboronge ’mbatoorigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.9",
            "verseOrgIds": [
              "PRO.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanyene oboronge bageendererete koba buya, abanto b’omochie nigo bakogoka, na ekero abakori amabe bagosira nigo bagoaka amariogi y’omochengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.10",
            "verseOrgIds": [
              "PRO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goetera ase ogosesenia kw’abanyene oboronge omochie nigo okoimokererigwa igoro, korende goetera ase chinkwana chi’abakori amabe nigo okoiyerigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.11",
            "verseOrgIds": [
              "PRO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogochaaya omonto onde, oyio nigo aborire obong’aini, korende omonto omong’aini nigo agokira‐kiri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okona‐goeta‐etia obogenki nigo akoorokia obobisi, korende oyobwate omoika bw’obwegenwa tari koorokia obobisi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.13",
            "verseOrgIds": [
              "PRO.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ogoseemia okuya gotari, egesaku nigo gekogwa, korende ase abasemia abange abaya bare, oborendi obuya ’mboreo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.14",
            "verseOrgIds": [
              "PRO.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okwerua koba intenenera ase omonto omoao nigo agwesoyia ase emechando, korende oyo okwanga koba intenenera nigo erendete buya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
            "verseOrgIds": [
              "PRO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokungu omwesiki nigo akogeenderera gosikwa botambe. Abanto abatindi nabwo bakobogoria chinibo ase chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
              "PRO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore n’amaabera nigo akwerentera amaya, korende omonto omotindi nigo agwechaanda ere omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.17",
            "verseOrgIds": [
              "PRO.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo akwenyorera eng’eria y’oborianania, korende oyo ogosimeka oboronge nigo akwenyorera eng’eria y’ekeene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.18",
            "verseOrgIds": [
              "PRO.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore omwegenwa, ase oboronge bwaye nabe moyo, korende oyo okorigia obobe na kobobwatia nakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.19",
            "verseOrgIds": [
              "PRO.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abakorekanu ase chinkoro chiabo nigo bare okogechia ase Omonene, korende abare n’orogendo ororonge nigo bakomogokia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.20",
            "verseOrgIds": [
              "PRO.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, Omonto omobe goika anyore egesusuro, korende oroiboro rw’abanyene oboronge ’ndotoorigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.21",
            "verseOrgIds": [
              "PRO.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokungu omonyakieni otari nechiseemi nigo anga buna ebonyi y’etaabu ere ase chimioro chi’embeche.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.22",
            "verseOrgIds": [
              "PRO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okogania kw’abanyene oboronge nigo gokorenta amaya, korende okw’abakori amabe nigo gokobarentera egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.23",
            "verseOrgIds": [
              "PRO.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere omonto okorua ebinto ebinge, nigo akomenteranigwa ebinge goetania, na nere oria omogooko otari korua, nigo akogeenderera kona‐koremerwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.24",
            "verseOrgIds": [
              "PRO.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okorua n’omoyo bw’ogwancha natenenkigwe; nere oyokorua amaache agokendia erang’o, nere boigo ’naegwe amaache agokendia erang’o yaye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.25",
            "verseOrgIds": [
              "PRO.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oria okwegimeria endagera ase obong’iti, nigo akoragererigwa nabaanto, korende ogosesenigwa nigo kore igoro ase omotwe bw’oria okoyeoonia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.26",
            "verseOrgIds": [
              "PRO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogokora omokia korigia ayare amaya, oyio nigo akonyora ayare amaya, korende oyokorigia ay’obobe, obobe nigo bokomonyoora.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.27",
            "verseOrgIds": [
              "PRO.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto osemeretie chinibo chiaye nigo aragwe, korende abanyene oboronge ’mbareerete buna amato amarere y’emete.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.28",
            "verseOrgIds": [
              "PRO.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
