              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Risemi nigo rigokora omosacha oba nekeririanda, na takoba n’amaabera ekero akorusia egesiomba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.34",
