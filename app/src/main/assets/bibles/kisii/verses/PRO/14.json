              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboronge nigo bogokinia egesaku, korende ebibe nobosooku ase abanto bande bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.34",
            "verseOrgIds": [
              "PRO.14.34"
            ]
          }
        }
      ]
