            "number": "33",
            "style": "v",
            "sid": "PRO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obong’aini nigo bomenyete ase enkoro y’omonto ore n’okomanya, korende ase enkoro y’omoriri tibomanyekaneti nonya ’ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.33",
            "verseOrgIds": [
              "PRO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
