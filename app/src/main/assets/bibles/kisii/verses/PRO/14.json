  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "PRO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokungu omong’aini nigo akoagaacha mwaye, korende oyore omoriri nigo agotagora mwaye na maboko aye omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omoirogete Omonene nigo akobwatia enchera y’oboronge, korende oyo omochaayete nigo are omokorekanu ase chiinchera chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya omoriri agokwana nigo are enyimbo y’oboenenu, korende aya abang’aini bagokwana nigo akobarenda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase chiombe chi’okorema chitari, ebiage nigo bikoba bosa, korende ase okong’usa gwe chintang’ana, endagera enyinge nigo ekonyorekana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirori ore omwegenwa tari gokwana oborimo, korende oy’otari omwegenwa nigo akoroka oborimo bwoka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ore omochecheria narigia obong’aini takobonyora, korende chiseemi nigo chikonyorekana bwango ase omonto ore omong’aini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karue ase omonto omoriri, ekiagera tokonyora obong’aini ase aria agokwana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obong’aini bw’omonto ore n’okomanya nigo bokomokonya omanya buna chiinchera chiaye chire, korende obosooku bw’abaanto abariri nigo bokobang’aina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abariri nigo bagokora echeche n’ebibe, korende abanyene oboronge nigo bagwancherana barabwo ase barabwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkoro enyene nigo emanyete obororo bwaye, na omonto omoao takonyaara gosanga ase omogooko bw’enkoro eyio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyomba y’omokori amabe ’nesirigwe, korende ekegutu ki’omonyene oboronge ’nkegeenderere gosesenigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchera nere ekororekana ase omonto ng’a nendonge, korende omoerio bw’enchera eyio namakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya omonto ogoseka, enkoro yaye nabo eranyaare koba nomoichano, na omoerio bw’omogooko oyio nobororo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogure korwa ase okwegena kwaye, nabo araisaneke nechiinchera chiaye omonyene, na omonto omuya nigo agoisanekigwa n’omoyo oye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto otamanyeti amaange nigo akwegena kera ring’ana, korende omong’aini nigo agoitona aase agochia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omong’aini nigo akwoboa na kwerenda korwa ase amabe, korende omoriri nigo akoba omoremu ase ogokora amabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.16",
            "verseOrgIds": [
              "PRO.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto okogechigwa bwango nigo agokora ay’oboriri, na omonto okoroberia ay’obobe nigo akogechwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.17",
            "verseOrgIds": [
              "PRO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatamanyeti amaange, oboriri nigo bokoba omwando obo, korende abare nokomanya nigo bakoegwa chiseemi chiaba eguutwa yabo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.18",
            "verseOrgIds": [
              "PRO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ababe goika bekumbe ase amasio y’abanto abaya, na abakori amabe bekumbe ase ebiita bi’abanyene oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.19",
            "verseOrgIds": [
              "PRO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto omotaka nigo agechire nonya nase abanto bamwabo, korende omonda nigo abwate abasani abange.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.20",
            "verseOrgIds": [
              "PRO.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogochaaya omonto onde nigo agokora ebibe, korende oyokororera abachaandegete amaabera ’nasesenigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.21",
            "verseOrgIds": [
              "PRO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Abwo bakoroberia ayare amabe tibari gosira? Na abwo bakoroberia amaya, Inee, tibari konyora amaabera na ekeene?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.22",
            "verseOrgIds": [
              "PRO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeremo ende yonsi egokorwa nigo ekorenta ebitoki, korende amang’ana amasa agokwanwa nigo gokorenta obotaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.23",
            "verseOrgIds": [
              "PRO.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eguutwa y’abanto abang’aini n’obonda bwabo, korende oboriri bwoka nabwo okonyora kwa abanto abariri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.24",
            "verseOrgIds": [
              "PRO.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirori ogokwana ekeene nigo agotooria obogima, korende oy’ogokwana oborimo nigo akorwa abande.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.25",
            "verseOrgIds": [
              "PRO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo okomoiroka Omonene nigo are n’ogosemeria gw’okorendwa bokong’u, na abana baye ’mbanyore aase bagotamera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.26",
            "verseOrgIds": [
              "PRO.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomoiroka Omonene nakwo ensoko y’obogima eragere omonto eatanane korwa ase emetego y’amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.27",
            "verseOrgIds": [
              "PRO.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obonge bw’abaanto nabwo bore esiko y’omorwoti, korende ase abanto bare abake omogambi obo nigo agosirigwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.28",
            "verseOrgIds": [
              "PRO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto otari kogechigwa bwango nigo abwate okomanya okonene, korende oyo okoberoroka bwango nigo agokinia oboriri bwaye.",
          "type": "text",
          "attrs": {
