          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkoro y’omogooko nigo ere obogima bw’omobere, korende ogosanera nigo kore oboguundo bw’amauga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.30",
            "verseOrgIds": [
              "PRO.14.30"
            ]
          }
        }
      ]
    },
    {
