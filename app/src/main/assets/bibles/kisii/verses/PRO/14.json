      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo agotugutwa riarua ase engencho y’ogokora kwaye okobe, korende omonyene oboronge nigo agokwa ore n’ogosemeria.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.32",
            "verseOrgIds": [
              "PRO.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
