          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ogokorera omotaka bobe nigo agochaaya Omotongi bw’omotaka oyio, korende oyore omwororo ase oria oremeire nigo asigete Omotongi oye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.31",
            "verseOrgIds": [
              "PRO.14.31"
            ]
          }
        }
      ]
