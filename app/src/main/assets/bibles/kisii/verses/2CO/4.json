          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obotenenku ime ase ebibekerero bi’amaroba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, ekiagera tore nobosomba obo koreng’ana namaabera a Nyasae aya twanyorire, titokwa emioyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.1",
            "verseOrgIds": [
              "2CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twangire amang’ana y’obosooku ayabisegete, gose titori gotaara ase obong’ainereria, gose gokorera ring’ana ria Nyasae noborimo. Korende ase okoorokia ayare ay’ekeene tweorokirie ase abanto bonsi ase okomanya gwe chinkoro chiabo ime, ng’a ntore nekeene ase obosio bwa Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
              "2CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende onye enchiri yaito yabisekanete, nigo yabisekanete ase abwo bagosira.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
            "verseOrgIds": [
              "2CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio enyasae y’ense eye yaukoirie ebirengererio bi’abwo bategeneti, erinde omobaso bw’enchiri y’obonene bwa Kristo, oyore ekieni kia Nyasae, tobaikera.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.4",
            "verseOrgIds": [
              "2CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki titori kwerandia intwe abanyene, korende Kristo Yeso buna Omonene, na intwe abanyene buna abasomba baino ase engencho ya Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.5",
            "verseOrgIds": [
              "2CO.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki Nyasae oyoteebete, “Omobaso nobare korwa ase omosunte”, nere obarire ase chinkoro chiaito ime, atoe omobaso bwe chisemi chi’obonene bwa Nyasae ase obosio bwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.6",
            "verseOrgIds": [
              "2CO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ntore nobotenenku obo ime ase ebibekerero bi’amaroba, erinde aorokigwe ng’a okobua okonene gwe chinguru nigo gokorwa ase Nyasae, gose tikori korwa ase tore intwe abanyene.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.7",
            "verseOrgIds": [
              "2CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase chinsemo chionsi nigo tokomigwa, korende titori komigeka; iga togoichanigwa, korende titogokwa emioyo,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "iga togochandwa, korende titori gotigwa; iga togoakwa inse, korende titori gosirigwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botambe nigo tokobogoria ase emebere yaito ogokwa kwa Yeso, erinde obogima bwa Yeso naborobwo boorokigwe ase emebere yaito.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki intwe ekero tore moyo, amatuko onsi nigo tokoruegwa tokwe ase engencho ya Yeso, erinde obogima bwa Yeso boorokigwe ase emebere yaito eyekonyorwa namakweri.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaki amakweri nigo agokora emeremo ime yaito, korende obogima ime yaino.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo naintwe, ekiagera tore n’Omoika oria oria bw’okwegena buna eriikire, “Negenete, na ase engencho eyio ngakwana”, igo twegenire, na ase engencho eyio nigo togokwana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twamanyire ng’a ere oyobogetie Omonene Yeso natobokie naintwe amo na Yeso, na atorente amo nainwe ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki amang’ana onsi nigo agokorwa ase engencho yaino, erinde obuya obwo bomentwe ase abwo abange, ogoaka ng’a mbuya mono komentwe, na Nyasae abakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Komenya ase okwegena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, titogokwa emioyo; korende nonya omonto oito o isiko ogosarigwa, omonto oito o ime akorwe omoyia rituko ase rituko.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.16",
            "verseOrgIds": [
              "2CO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki emechando yaito eyere y’ekero egeke gioka nemegusu, egotoroiseria obonene bwa kare na kare obore obonge mono kobua.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.17",
            "verseOrgIds": [
              "2CO.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Titorigereria ebinto ebikororekana, korende ebitakororekana; naki ebikororekana nebi’ekero egeke gioka, korende ebitakororekana nebia kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.18",
            "verseOrgIds": [
              "2CO.4.18"
            ]
          }
        }
      ]
    }
  ],
