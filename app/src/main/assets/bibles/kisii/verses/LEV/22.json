              "type": "text"
            }
          ]
        },
        {
          "text": "“Ase ayio mobwate amachiiko aane na koyakora. Inche ninche Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timobaisa korentera erieta riane obosooku, korende nincheneke ase Abaisraeli. Inche ninche Omonene, ninche nkobachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninche nabarusetie korwa ase ense ya Misiri, erinde imbe Nyasae oino. Inche ninche Omonene.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
