  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JOS 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Emechie y’Abalawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abateneneri be chiamate chi’Abalawi bagaacha ase Eleazari, Omokuani, na Yoshua, mosinto o Nuni, na ase abateneneri be chiamate chi’ebisaku bionsi bi’Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagakwana nabarabwo agwo Silo, bakabateebia, “Omonene nigo achigete goetera ase Musa ng’a toegwe emechie ase tokomenya, amo namarisio, ase chitugo chiaito chirarisie.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo Abaisraeli bakaa Abalawi emechie gete amo namarisio arengeo korwa ase emiando yabo, koreng’ana buna Omonene achigete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obomera bokagwera chiamate chi’Abakohati buna iga: Abalawi abarenge b’ororeria rwa Aroni, Omokuani, bakanyora emechie ikomi na etato korwa ase egesaku kia Yuda, na egia Simioni, na ekia Benjamini, buna obomera bwabagwerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Abakohati abatigarete bakanyora emechie ikomi korwa ase chiamate chi’egesaku ki’Efraimu na ekia Dani, na ekeng’ese kia Manase, buna obomera bwabagwerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagerisoni bakanyora emechie ikomi na etato korwa ase chiamate chi’egesaku gia Isakaru, na egi’Aseri, na ekia Nafutali, na ekeng’ese ki’egesaku kia Manase agwo Basani, buna obomera bwabagwerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamerari bakanyora emechie ikomi na ebere ase chiamate chiabo korwa ase chiamate chi’egesaku kia Rubeni, na ekia Gadi, na egia Sabuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Abaisraeli baete Abalawi emechie eyio amo namarisio arengeo, ase ogoaka obomera, buna Omonene konya achiikire goetera ase Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase egesaku kia Yuda, na egia Simioni bakarua emechie eyio egwatorwa aiga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.9",
            "verseOrgIds": [
              "JOS.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obomera bw’eritang’ani bokagwera abanto b’ororeria rwa Aroni, eamate eyemo y’Abakohati, abarenge Abalawi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.10",
            "verseOrgIds": [
              "JOS.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bakaegwa Kiriati‐Ariba (noro Heburoni), ase ense y’ebitunwa ya Yuda, amo namarisio aetanaineo. (Ariba nigo arenge sokoro y’Anaki.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.11",
            "verseOrgIds": [
              "JOS.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende emegondo amo nebichie bi’omochie oyio konya baeire Kalebu, mosinto o Yefune, bikaba omwando oye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eye nero emechie abanto b’ororeria rwa Aroni Omokuani baetwe: Heburoni, omochie oyio abaiti ba mosiabano baare gotamera, na Libuna,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.13",
            "verseOrgIds": [
              "JOS.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yatiri, na Esitemoa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.14",
            "verseOrgIds": [
              "JOS.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Holoni, na Debiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.15",
            "verseOrgIds": [
              "JOS.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Aini, na Yuta, na Beti‐Semesi, emechie kianda, amo namarisio arengeo, korwa ase ebisaku ebio bibere.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.16",
            "verseOrgIds": [
              "JOS.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase egesaku kia Benjamini bakaegwa Gibeoni, na Geba,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.17",
            "verseOrgIds": [
              "JOS.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Anatoti, na Alamoni, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.18",
            "verseOrgIds": [
              "JOS.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emechie yonsi abanto b’ororeria rwa Abakuani baetwe nigo yarenge ikomi na etato; bakayeegwa, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto be chiamate chinde chi’Abakohati, abarenge Abalawi, bakaegwa emechie korwa ase egesaku gi’Efraimu, buna obomera bwabagwerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.20",
            "verseOrgIds": [
              "JOS.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaegwa Sekemu, omochie oyomo abaiti ba mosiabano baare gotamera, ase ense y’ebitunwa y’Efraimu, na Geseri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kibusaimu, na Beti‐Horoni, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.22",
            "verseOrgIds": [
              "JOS.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na korwa ase egesaku gia Dani bakaegwa Eliteke, na Gibetoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.23",
            "verseOrgIds": [
              "JOS.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ayaloni, na Gati‐Rimoni, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.24",
            "verseOrgIds": [
              "JOS.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na korwa ase ekeng’ese ki’egesaku kia Manase bakaegwa Taanaki na Gati‐Rimoni, emechie ebere, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
            "verseOrgIds": [
              "JOS.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto be chiamate echio chi’Abakohati nigo baetwe emechie eyio ikomi, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagerisoni, chiamate chinde chi’Abalawi, bakaegwa korwa ase ekeng’ese ki’egesaku kia Manase Golani o Basani, omochie abaiti ba mosiabano baare gotamera, na Besitera, emechie ebere, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na korwa ase egesaku gia Isakaru bakaegwa Kisioni, na Daberati,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yarimuti na Eni‐Ganimu, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase egesaku gi’Aseri bakaegwa Misali, na Abidoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Helikati, na Rehobo, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.31",
            "verseOrgIds": [
              "JOS.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na korwa ase egesaku kia Nafutali bakaegwa Kedesi o Galili, omochie abaiti ba mosiabano baare gotamera, na Hamoti‐Dori, na Karitani, emechie etato, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.32",
            "verseOrgIds": [
              "JOS.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abanto be chiamate chionsi chi’Abagerisoni baetwe emechie ikomi na etato, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.33",
            "verseOrgIds": [
              "JOS.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase egesaku gia Sabuloni, Abalawi abatigarete, chiamate chia Merari, bakaegwa emechie ya Yokinamu, na Karita,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.34",
            "verseOrgIds": [
              "JOS.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Dimuna, na Nahalali, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
              "JOS.21.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na korwa ase egesaku kia Rubeni bakaegwa Beseri, na Yahasi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kedemoti, na Mefaati, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase egesaku kia Gadi bakaegwa Ramoti o Gileadi, omochie abaiti ba mosiabano baare gotamera, na Mahanaimu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hesiboni, na Yaeseri, emechie ene, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abanto b’eamate ya Merari, abatigarete ase chiamate chi’Abalawi, baetwe emechie ikomi na ebere, buna obomera bwabagwerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emechie yonsi y’Abalawi eyarenge ase egati y’omwando bw’Abaisraeli nigo yarenge emerongo ene, na etano na etato, amo namarisio arengeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omochie bw’eyio nigo orenge namarisio aetanaineo, Nabo arenge ase emechie eyio yonsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abaisraeli bakoira ense eria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ig’Omonene akaa Abaisraeli ense eyio yonsi arierete chisokoro chiabo eira ng’a nabayee; barabwo kobayeeirwe bakamenya aroro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene akabaa obotoereru ase chinsemo chionsi, buna arierete chisokoro chiabo eira ase ogotiana. Onde tarenge ase ababisa babo obabuete, ekiagera Omonene abegete ababisa babo bonsi ase amaboko abo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nab’Omonene aikeranetie chiira chionsi chingiya echi abarierete Abaisraeli. Ende teri etaikeranetigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
    }
