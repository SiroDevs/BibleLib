              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyio nero emiando Musa aatananete agwo ase ebirubo ebiomo bia Moabu, moocha ya Yorodani, kororia Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        },
