      },
      "items": [
        {
          "text": "“Abanto bonsi bairanerie, bateebe: Amina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
