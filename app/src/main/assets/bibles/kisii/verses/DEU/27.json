          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aragererigwe omonto okorina omomenyi, gose entakaana, gose omotakaanwa, oboronge bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
