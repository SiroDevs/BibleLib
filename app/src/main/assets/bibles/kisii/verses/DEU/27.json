      "items": [
        {
          "text": "“Abanto bonsi bairanerie, bateebe: Amina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
