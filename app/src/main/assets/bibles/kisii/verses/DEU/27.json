          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aragererigwe omonto oraraare na moga ise, ekiagera ayio nokorentera ise obosooku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
