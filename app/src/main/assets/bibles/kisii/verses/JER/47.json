  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "JER 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obobani Omonene igoro y’Abafilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ring’ana ri’Omonene rigacha ase Yeremia igoro y’Abafilisti ekero Farao atarabua Gasa, rikamoteebia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
            "verseOrgIds": [
              "JER.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nar’Omonene agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naama! Amache naimokerere igoro korwa sugusu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naichore aminyoke buna emegoko emenene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naichore na gotuba ense na bionsi ebire aroro;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namere emechie na bonsi abamenyeteo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erio abanto mbarere,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abamenyi bonsi b’ense eyio mbarere na kweng’ereria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero baraigwe amariogi ’ebititiro bi’ebitaago bie chibarasi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okwoga kw’amagoro e chigari.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abaise tibakorigia magega barore ase abana babo bare;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera amaboko abo nigo araborwe chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rituko ngocha rire ekero Abafirisiti bonsi barasirigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abatigarete gokonya Turo na Sidoni basirigwe boigo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nasirie Abafirisiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abare abatigari ase egesinka gia Kafitori.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gasa yatigaire bosa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Asikeloni osirire kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abatigari ase rikura riria,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngoika ririri moragenderere gwekeba?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omoyio o birende Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngoika ririri orabe kogendererete otari gotoerera?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Irana ime ase ekegocho kiao, okire na gotimoka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki omoyio orakore okire‐kiri na gotimoka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero Omonene ayochikiire gokora emeremo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oyochikiire orwanie Asikeloni ne chinse chire ang’e nenyancha.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    }
  ],
