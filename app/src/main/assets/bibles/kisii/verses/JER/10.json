{
  "id": "JER.10",
  "number": "10",
  "bookId": "JER",
  "reference": "Yeremia 10",
  "copyright": "© 2021 KENBS",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JER 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosasiima emegwekano na ogosasiima gw’ekeene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe Abaisraeli, igwa amang’an’Omonene agoteeba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
              "JER.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Timobaisa kweorokereria chingencho chi’abaanto b’ebisaku,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ebimanyererio bikorwa igoro tibibaisa kobaondokia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebio nigo bikoondokia abanto b’ebisaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinyasae abanto b’ebisaku bagosasiima nigo chire echi’oborimo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omote ore rinani ime nigo okogechwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omooroisia omong’aini oyobaacha negesire na oroisia emegwekano.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bakoyeooma ne chifeta ne chitaabu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bayeakerania bokong’u nenyundo na emesumari,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde tenyegerigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emegwekano eyio yabo nigo enga buna ebinto bikogosa chinyoni",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chire ase emegondo y’amasosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Emegwekano eyio tekonyara gokwana;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ekobogorigwa, ekiagera teri gotaara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Timobaisa koyeiroka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera tegokora bobe bonde bwensi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tekonyara gokora gento kende ekiya.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, onde tari okogwekaine;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye naye Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na erieta riao nigo rire nokobua okonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omorwoti bw’ebisaku, ning’o otagwenereti gokoiroka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye nogwenerete oirokwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onde tari okogwekaine",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase abang’aini bonsi b’ebisaku,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ase amarwoti abo onsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bonsi tibamanyeti gento, nabariri bare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki ogosemigwa korwa ase emegwekano eyio nemete bosa",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyio nefeta eturire ekorwa Tarisisi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na etaabu ekorwa Ufasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo ere emeremo y’omooroisia omong’aini na omoturi bw’etaabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Chianga emegwekano eyio ekobekerwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo chire chimbariri ne chimonyinga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chiroisirie nabaanto abang’aini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Omonene nere Nyasae bw’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae ore moyo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omorwoti o kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ense nigo egotengechigwa ase endamwamu yaye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebisaku tibikonyara koremereria ekeririanda kiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobateebie ng’a chinyasae chiria chitatongete igoro na ense nachisire, tichiba inse y’erioba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
            "verseOrgIds": [
              "JER.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera gw’okomotogia Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nere otongete ense ase okobua kwaye;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agatonga ebinto bionsi bi’ense ase obong’aini bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na akarambora igoro ase okomanya kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase eriogi riaye amaache are igoro chionsi akoeera neriogi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akorenta ritaturi korwa ase chinsinyo chi’ense.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nere okorenta chinkoba chire nembura,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omwaga ogusa korwa ase ebigancha biaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
            "verseOrgIds": [
              "JER.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omonto nigo are omoriri ase obong’aini bwaye, na kera omoturi nigo agosookigwa nemegwekano",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "y’ogosasimwa aroisirie, ekiagera emegwekano yaye ney’obong’ainereria, tebwati omoika ime yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.14",
            "verseOrgIds": [
              "JER.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyio mbosa kegima, emeremo eyio nesekererwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.15",
            "verseOrgIds": [
              "JER.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero eraegwe egesusuro, nesirigwe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.15",
            "verseOrgIds": [
              "JER.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oria ore egetari kia Yakobo tagwekaini emegwekano eyio.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere nere otongete ebinto bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abaisraeli nigo bare egesaku kere omwando oye;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene bw’Emeganda nario erieta riaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.16",
            "verseOrgIds": [
              "JER.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okong’anyigwa kogocha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abwo mwaetananirwe nababisa, sangereria ebinto biaino morue aase agwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.17",
            "verseOrgIds": [
              "JER.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba: “Ase engaki eye ninserie ne chinguru abwo bonsi bamenyete ase ense eye, nimbarentere ogoichana goika baigwe obororo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
              "JER.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obobe nobwaito, ekiagera twasunyuntirwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amaote aito tari kogwenigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Intwe nigo twarengereretie: Ekeene, eye nemechando,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende goika toremererie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
              "JER.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiema chiaito chiasarekire;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Chingori chi’ogochisibera chiabutoirwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abana baito basirire, tibari aande.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonto tari ogotenenia chiema naende.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onde tari oratosungere ebitambaa bie chiema chiaito.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abarisia babeire abariri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibari korigia oboraai korwa ase Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio, tibari kogenderera konyora amaya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "riicho riabo rionsi riasiareirwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.21",
            "verseOrgIds": [
              "JER.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegerera moigwe! Ebirage bigocha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rirorooche ri’omoganda omonene riaigurwe rigocha korwa sugusu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gocha gosaria emechie y’Abayuda ebe amaturi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase chisese chi’orosana chiramenye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.22",
            "verseOrgIds": [
              "JER.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, nimanyete ng’a enchera y’omonto tekoraagwa nere omonyene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.23",
            "verseOrgIds": [
              "JER.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose omogendi takonyara koraa orogendo rwaye ere omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.23",
            "verseOrgIds": [
              "JER.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ondongeyie ase okong’a egesusuro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.24",
            "verseOrgIds": [
              "JER.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ase ekerengo kegwenerete gioka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.24",
            "verseOrgIds": [
              "JER.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tonkora bo ekero ore nendamwamu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.24",
            "verseOrgIds": [
              "JER.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo orabaise gonsiria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.24",
            "verseOrgIds": [
              "JER.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itera endamwamu yao ase ebisaku bitakomanyeti",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.25",
            "verseOrgIds": [
              "JER.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase abanto batari korangeria erieta riao bakonywe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.25",
            "verseOrgIds": [
              "JER.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo basiririe abanto ba Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.25",
            "verseOrgIds": [
              "JER.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, baabamerire kegima na kobasiria,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.25",
            "verseOrgIds": [
              "JER.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "basaririe obomenyo bwabo bwabeire bosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.25",
            "verseOrgIds": [
              "JER.10.25"
            ]
          }
        }
      ]
    }
  ],
