{
  "id": "JER.30",
  "number": "30",
  "bookId": "JER",
  "reference": "Yeremia 30",
  "copyright": "© 2021 KENBS",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JER 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Eira y’Omonene ase abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ring’ana ri’Omonene rigacha ase Yeremia, rikamoteebia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nar’Omonene, Nyasae bw’Abaisraeli, agoteeba: Amang’ana onsi nagotebetie, yarike ase egetabu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera amatuko ngocha are ekero ndairanerie abanto baane Abaisraeli na Abayuda amaya abo; mbarente ase ense eyio naete chisokoro chiabo, na barabwo nabayeire ebe eyabo.” Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana aya nar’Omonene akwanete igoro y’Abaisraeli na Abayuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya naro inche Omonene ngoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Twaigure eriogi ri’okorera kw’omoondoko,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okorera kw’obwoba na tikori okw’omorembe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boria momanye; Inee, omosacha nabe morito aibore omwana?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki rende narorire kera omosacha abwatete enda namaboko aye",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna omokungu okobina aibore?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki kera omonto aonchokire obosio bwaye?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obee! Naki rituko riria rire rinene!",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rinde tiriri ringa buna rirorio.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Eyio nengaki y’emechando y’abanto ba Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende nonya naboigo mbatoorigwe korwa ase emechando eyio.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene bw’Emeganda nigo agoteeba iga: “Nebe ekero rituko riria riraike, nimbune amakorogoto, ninyerusie ase amagoti abo. Nimbasansore chingataare basibeire, na barabwo tibakoba abasomba b’abaanto b’egesaku ekeao nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende mbamokorere Omonene, Nyasae obo, bamokorere na Daudi, omorwoti obo, oyio ndabatenenerie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abanto ba Yakobo, timoiroka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe Abaisraeli, timoondoka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera naama, nimbatoorie korwa ase ense y’obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto ba Yakobo mbairane banyore omorembe na obotoereru;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "monto onde tari oraboboyie”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende Omonene oteebire:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Inche nigo inde amo nainwe mbatoorie,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninsirie kegima ebisaku bionsi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebio ase nabasiarerete gochia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende inwe tinkobasiria kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimbae egesusuro gi’okobarongeyia ase oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tinkobatiga nonya ng’ake timbaa egesusuro.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ogochandeka kwaino tigokogwenigwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaote aino abeire amabe mono.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monto onde tari orabarwanerere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
            "verseOrgIds": [
              "JER.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Eriogo ri’amaote aino tiriri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
            "verseOrgIds": [
              "JER.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okogwenigwa tikori ase more.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
            "verseOrgIds": [
              "JER.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanchi baino bonsi baabatigire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibari kobechandera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera inche nabaakire inwe ogoakwa kw’obobisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabaeire egesusuro ntari namaabera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera okomocha kwaino nokonene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebibe biaino biamentekanire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki mokorera ase engencho y’emechando yaino?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obororo bwaino tibokogwenigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ogosaria kwaino nokonene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebibe biaino biamentekanire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ayio naro agerire nabakoreire igo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo bonsi abarabasirie inwe nabarabwo mbasirigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ababisa baino bonsi, kera oyomo obo nairwe obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo baraboose, nabarabwo mbooswe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo barabasakore, nabarabwo mbasakorwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oteebire iga: Inche nimbasebokie naende,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.17",
            "verseOrgIds": [
              "JER.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ningwenie amaote aino,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.17",
            "verseOrgIds": [
              "JER.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera abanto nigo baabaarogete inwe abamotugutire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.17",
            "verseOrgIds": [
              "JER.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na bateba ng’a Sayoni nomochie otigetwe, monto onde atayochandekereti.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.17",
            "verseOrgIds": [
              "JER.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Naama! Ning’iranie abanto ba Yakobo ase chiema chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe namaabera ase obomenyo bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omochie o Yerusalemu noagachwe naende ase orenge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na enyomba y’omorwoti neagachwe ase yarenge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo nabatere amatera ay’ogoaka ng’a mbuya mono,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.19",
            "verseOrgIds": [
              "JER.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbaake amariogi ’omochengo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.19",
            "verseOrgIds": [
              "JER.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimbamentekanie babuche, na omobaro obo tokoba omoke.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.19",
            "verseOrgIds": [
              "JER.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ningere basikwe na tibakobarwa ng’a tibaisaini gento.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.19",
            "verseOrgIds": [
              "JER.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana babo mbabe abange buna kare,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.20",
            "verseOrgIds": [
              "JER.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoganda obo nonyore chinguru ase obosio bwane,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.20",
            "verseOrgIds": [
              "JER.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakobachanda, nimbae egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.20",
            "verseOrgIds": [
              "JER.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene obo nigo arabe omonto obo abanyene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omogambi obo nigo ararue ase egati yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nimosukie gocha ang’e ase ’nde, nere nang’ike ang’e,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera monto ki orabe noboremu kong’ika ang’e bweka ntamong’useti.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
            "verseOrgIds": [
              "JER.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe namobe abanto baane,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.22",
            "verseOrgIds": [
              "JER.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na inche nimbe Nyasae oino.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.22",
            "verseOrgIds": [
              "JER.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora omwaga Omonene! Endamwamu yaye yachire buna omwaga bw’ekerambauti, noguse igoro ase emetwe y’abanyabibe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.23",
            "verseOrgIds": [
              "JER.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endamwamu entindi y’Omonene tekonyara koirana ebatige goika abe oikeranirie ekiina kiaye na gokora buna okogania kwaye kore. Amang’ana ayio nigo morache koyamanya buya ase amatuko agochi‐gocha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.24",
            "verseOrgIds": [
              "JER.30.24"
            ]
          }
        }
      ]
    }
  ],
