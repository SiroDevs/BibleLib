  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JER 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Riruube Yeremia atomete gochia ase Abayahudi abarenge Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia omobani agatoma riruube korwa Yerusalemu gochia ase abagaaka b’abaanto barenge ase obosomba na ase abakuani, na ababani, na abanto bonsi aba Nebukadinesaro oosete korwa Yerusalemu, akabaira Babiloni ase obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nigo riarigetwe magega y’omorwoti Yekonia, na ng’ina, na abasomba b’enyomba y’oborwoti abagombaetigwe, na abanene b’oborwoti bw’Abayuda na aba Yerusalemu, na abaroisia b’ebinto, na abaturi b’ebioma, kobarure Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riruube erio rikaegwa Elasa, mosinto o Safani, na Gemaria, mosinto o Hilikia, abwo Zedekia, omorwoti bw’Abayuda, atomete Babiloni ase Nebukadinesaro omorwoti. Aya naro amang’ana ariikire ase riruube erio.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nar’Omonene bw’Emeganda, Nyasae bw’Abaisraeli, atebiire ase abanto bonsi narusetie Yerusalemu nkaira Babiloni ase obosomba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moagache chinyomba agwo, momenyeo. Rema emegondo, mosimeke endagera, morie okwama okwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monyuome abakungu baabaiborere abana, abamura na abaiseke. Nyuomeria abamura baino abakungu, na abaiseke baino mobasokie, erinde baibore abana, abamura na abaiseke. Momentekane mobuche agwo, gose omobaro oino tobaisa gokea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Morigerie omochie oyio ase nabatomire gochia amaya; sabera omochie oyio ase Omonene, ekiagera obuya bwaye nabwo bore obwaino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene bw’Emeganda, Nyasae bw’Abaisraeli, agoteeba: Timobaisa kong’ainwa nababani baino, na abaringoria baino, abwo bare ase egati yaino, gose timobaisa korengereria igoro ye chindoto chiaino mokorota.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bakobaabaanera oborimo ase erieta riane, ekiagera inche timbatometi. Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nar’Omonene atebiire: Ekero emiaka emerongo etano na ebere echiikire mokobeera agwo Babiloni eraere, erio nimbachere, ning’ikeranie eira yane ase more, mbairanie aase aiga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki inche nimanyete emeroberio mbwate ase more, emeroberio y’obuya na omorembe, gose tari ey’amabe, na emeroberio y’okobaa ogosemeria ase amatuko aino agochi‐gocha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio namondangerie mochiche ase ’nde mosabe, nainche nimbaigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namondigie monyoore, komorandigie ne chinkoro chiaino chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche Omonene natebiire iga: Namondigie monyoore, nainche nimbairanerie amaya aino. Nimbasangererie korwa ase ebisaku bionsi ne chinsemo chionsi ase nabaseretie gochia, mbarente gocha aase nabarusetie nkabaira ase obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya naro narikire, ekiagera inwe mwateebire ng’a Omonene obaeire ababani agwo ase ense ya Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene atebiire igoro y’omorwoti oikaransete ase ekerogo ki’obonene gia Daudi, na igoro y’abanto bonsi bamenyete ase omochie oyo, abamino baria batairetwe ase obosomba amo nainwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ee, aya nar’Omonene bw’Emeganda agoteeba: Rora, abwo nkobatomera nde esegi, na enchara, na oborwaire bogoita. Nimbakore babe buna amako are amabe mono atanyare koriegwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbatunyanerie esegi na enchara, na oborwaire bogoita. Nimbakore babe okoirokia ase amarwoti onsi are ase ense na abanto b’ebisaku bionsi ase ndabe nabaseririe gochia. Abanto nigo barabe bakoragereria ase erieta riaino, naende babe bagoichana na gokumia, baabachaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio nigo arakoreke, ekiagera bangete koigwera amang’ana aane goetera ase abasomba baane ababani, abwo nabeete ngotoma ase bare naende. Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto bonsi narusetie Yerusalemu nkabaira Babiloni ase obosomba, tegerera moigwe ring’ana ri’Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nar’Omonene bw’Emeganda, Nyasae bw’Abaisraeli, agoteeba igoro y’Ahabu, mosinto o Kolaya, na igoro ya Zedekia, mosinto o Maaseya, abwo bakobaabaanera oborimo ase erieta riane: Naama! Nimbabeeke ase okoboko kwa Nebukadinesaro, omorwoti o Babiloni, ere nabaitere agwo ase amasio aino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho yabo abanto barusetigwe ase ense y’Abayuda, bakairwa Babiloni ase obosomba, ekero barabe bakoragereria na gokwana amang’ana ’okoragererigwa okwo: Tiga Omonene agokore obe buna Zedekia na Ahabu, abwo omorwoti o Babiloni agekerete ase omorero.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bakorire obonyaka ase egati y’Abaisraeli, ekiagera batomanire nabakungu b’abagisangio babo, naende bakwanire amang’ana ’oborimo ase erieta riane, ayio inche ntabachigete. Ninche omonyene imanyete ayio, naende ninche inde kirori. Nab’Omonene atebiire.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Riruube Semaya ariigete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana aya naro orateebie Semaya, omonto o Nehelamu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya nar’Omonene bw’Emeganda, Nyasae bw’Abaisraeli, agoteeba: Aye gwatomire riruube ase erieta riao gochia ase abanto bonsi bare Yerusalemu, na ase Sefania, mosinto o Maaseya Omokuani, na ase abakuani bonsi. Ase riruube erio kwarikire iga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene okobekire aye Sefania obe Omokuani ribaga ria Yehoyada. Bono aye obe omoteneneri ase enyomba y’Omonene obe igoro ya kera omonto okobaboka kobana ng’a omobwate na komosoyia ase rikorogoto na komobekera engataare y’ekioma ase rigoti riaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono naki rende otaratogonyera Yeremia oyio okorwa Anatoti ogendererete kobaabaanera inwe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia otomire amang’ana gocha aiga Babiloni, ogoteeba: Namobeere ase obosomba ase engaki entambe; ase ayio agacha chinyomba momenye, moreme emegondo na mosimeke chindagera, morie okwama kwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sefania Omokuani agasoma riruube erio ekero Yeremia omobani ategererete.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ring’ana ri’Omonene rigacha ase Yeremia, rikamoteebia:",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
