{
  "id": "JER.12",
  "number": "12",
  "bookId": "JER",
  "reference": "Yeremia 12",
  "copyright": "© 2021 KENBS",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JER 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeremia okobori’Omonene na okoiranigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ekero nkoamererania naye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okonyorekana kore omonyene oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nonya nabo, ngokwana inde naye igoro y’amang’ana ’oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki chinchera chi’abakori amabe chikoba nogosesenigwa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki abanto abang’ainereria bagendererete koba buya?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwabasimekire, nabarabwo bairire emeri inse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bagokina, naende baama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo nigo bakomanyete ase emenwa yabo rioka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende chinkoro chiabo nigo chire aare naye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende aye Omonene nomanyete inche,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ondoche, na nigo ogoteema ebirengererio biane gose mbire asore.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barusieo abwo ababe buna ching’ondi chigochia konyenywa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obabeeke ensemo baganye rituko bagochia konyenywa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoika ririri ense erabe ekorera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obonyansi bw’ebitii bobe bogendererete kwoma?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ching’iti ne chinyoni chiasirigwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’obobe bw’abaanto bamenyeteo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bagoteeba: “Omonene takorora amatuko aito ay’omoerio.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Onye gokorosa ase okoamererania nabaanto bakominyoka namagoro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naki rende oranyare gochia koamererania ne chibarasi chikominyoka?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na onye gokogwa ekero omenyete ase ense ere nomorembe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naki orakore ase amanani amanoru a Yorodani?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya nabamino, abanto b’eamate ya iso,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babeire abang’ainereria asore,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagokuura korwa magega yao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabaisa gokwana amang’ana amaya asore,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tobaisa kobegena.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene ore nomoichano ase engencho y’abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche natigire abanto baane,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "natigire abanto bare omwando one.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabekire abanchwa baane ase amaboko ’ababisa babo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bare omwando one babeire buna endo ere ase rinani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Baakire amariogi abo mamincha yane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase engencho eyio nabagechire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Abanto bare omwando one nigo babeire buna enyoni ere enkanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekorigia endagera eetananire ne chinde chire ase orotwari?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Genda osangererie ching’iti chi’orosana chionsi chiche koria!",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarisia abange basaririe omogondo one bw’emesabibu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batiringeire inse omogondo one.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bakorire omogondo one oyorenge kongokia",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogwekanire buna erooro ere bosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayotigire ore bosa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekiagera otigirwe ore bosa, nkorera ore ase ’nde.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ense yonsi yabeire erooro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende omonto tari okorengereria amang’ana ayio.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaria batiirire gochia ase ebigoro bi’erooro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoro bw’Omonene nigo ogoita na gosaria",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa ensinyo eyemo y’ense goika ensinyo ende.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onde tari omenyete nomorembe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babusuire engano, korende mbagese amagwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Babeire bakwerosia ase emeremo, korende tibanyoreti ebitoki.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Mwanyorire obosooku ase ogotanyora rigesa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene abeire nendamwamu enene ase more.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Eira y’Omonene ase abagisangio b’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba igoro y’abagisangio baane ababe, abwo bagosaria omwando oria naeire Abaisraeli: “Nimbarusie barue ase ense yabo, naende nindusie Abayuda barue ase egati yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na magega y’ayio, ekero nabarusirie ase ense eyio, nimbarorere amaabera naende, mbairanie naende kera omonto ase omwando oye, na ase ense yaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ekero ekio abanto abwo bakweorokereria chinchera chi’abaanto baane, na gotiana ase erieta riane, bagoteeba: Ekeene, buna Omonene are moyo, buna abwo kare borokereretie abanto baane gotiana ase erieta ri’enyasae Baali, erio nario ndabasesenie na kobairaneria amaya abo, ase egati y’abanto baane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende onye egesaku kende gionsi kegochia kwanga konyigwera, rirorio ninkerusieo ngesirie kegima. Ninche Omonene nakwanire.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
  ],
