          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Babiloni okobwatwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene akwanete goetera ase Yeremia omobani igoro y’omochie o Babiloni na ense engima y’Abakalidayo:",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwana ase egati y’ebisaku, mobiraarerie!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Imokereria igoro ebendera na morarie!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Timobaisa kobisa amang’ana aya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende motebe: Babiloni obwatirwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "enyasae Beli yasookigwe, na Merodaki yatirwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Emegwekano egosasimwa ereo yasookigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinyasae chi’aroro chiatirwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Egesaku kiarure sugusu gocha korwania Babiloni. Nagesarie ense eyio ebe buna erooro, na monto onde takomenya aroro; abanto nabatame ne ching’iti boigo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.3",
            "verseOrgIds": [
              "JER.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abaisraeli bakoirana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga: “Ase amatuko ayio, na ase engaki eyio, Abaisraeli amo n’Abayuda nabache amo babe bakorera na kondigia inche, Nyasae obo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.4",
            "verseOrgIds": [
              "JER.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo mbaborie bamanye enchera ekogenda Sayoni, babe bakoonchora amasio abo gochia aroro, batebania: Inchuo tobwatane n’Omonene, tokore okobwatana kw’ogotianania nere, okwo koragenderere botambe gotanyare kwebwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abanto baane babeire buna ching’ondi chinsiru. Abarisia babo baabasiririe, ekiagera babeire bakona‐kobaong’anyia ase ebitunwa. Nigo bakona‐koong’anya buna ching’ondi, bakobaetanania korwa ase ebitunwa goika ase ebigoro; ase igo abanto baane bebire obweri bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.6",
            "verseOrgIds": [
              "JER.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bande bonsi baabanyorete nigo baabakorete bobe. Ababisa babo babeire bagoteeba: Intwe titori nokomocha ase ogokora iga, ekiagera barabwo bakorire ebibe ase Omonene obo, oyore obomenyo bwabo bw’ekeene, Omonene oyio orenge ogosemeria gwe chisokoro chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.7",
            "verseOrgIds": [
              "JER.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tama korwa Babiloni, morue ase ense y’Abakalidayo, mobe buna chigoree chigotang’ana bosio bwe riicho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.8",
            "verseOrgIds": [
              "JER.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Inche ngoseegeta nde omoganda bw’ebisaku ebinene, korwa ase ense ya sugusu, na barabwo bebeke ang’e korwania Babiloni bayobue korwa ensemo eria ya sugusu. Chinsara chiabo nigo chinga buna omorwani omong’aini ore neganga otari koirana bosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.9",
            "verseOrgIds": [
              "JER.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ense y’Abakalidayo nesakorwe, nabwo bonsi bakoyesakora nabaisaneke nebisakorwa ebio.” Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.10",
            "verseOrgIds": [
              "JER.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okogwa kwa Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe aba mwasakorete omwando one, nonya mwagogete na gochenga, naende more nokogania buna ritororo riarisirie obonyansi, na mogokwana buna chibarasi chituoni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.11",
            "verseOrgIds": [
              "JER.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyoko nabe nobosooku obonene, ee, omochie oyo okoiborete noichanigwe. Rora, ase egati ye chinse chi’ense oyio obe omoke mono kobua, nobe erooro enyomo ere bosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.12",
            "verseOrgIds": [
              "JER.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho y’endamwamu y’Omonene Babiloni nosirigwe kegima, gose tokomenywa rinde. Kera omonto orabe ogoeta Babiloni nakumie na goichana mono ase engencho y’amaakwa aye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.13",
            "verseOrgIds": [
              "JER.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe mwensi momanyete gokumba amata, ebeke ang’e morwanie Babiloni ase chinsemo chiaye chionsi. Yorute chinsara, timotiga nonya neyemo, ekiagera okorire ebibe ase Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.14",
            "verseOrgIds": [
              "JER.50.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imoka, aka eriogi ri’esegi ase chinsemo chiaye chionsi. Babiloni bwerure omonyene; chiburi chiaye chiagure, chindwaki chiatagoirwe na koiyerigwa inse. Ekio negesiomba Omonene akorusia. Ase ayio, rusia egesiomba ase omochie oyio. Buna koreng’ana Babiloni okorete moyokore boigo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.15",
            "verseOrgIds": [
              "JER.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siria kegima korwa Babiloni omobusuri na oyokoimokia omoyio bwe rigesa, ekero engaki eyio yaikire. Ase engencho y’obwoba bw’omochandi, kera omomenyi nairane ase abanto baye, kera oyomo natame gochia ase ense yaye omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.16",
            "verseOrgIds": [
              "JER.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoirana kw’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaisraeli nigo banga buna ching’ondi chigoserigwa ne chindo na goserebanigwa gochia aaria na aaria. Ritang’ani omorwoti bw’Abaasuri akababua na kobasiria, na bono omoerio Nebukadinesaro, omorwoti o Babiloni, otakunire amauga abo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.17",
            "verseOrgIds": [
              "JER.50.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, aya nar’Omonene bw’Emeganda, Nyasae bw’Abaisraeli, agoteeba: Naama! Nindetere omorwoti o Babiloni, amo nense yaye, egesusuro, buna nakorete ase omorwoti bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.18",
            "verseOrgIds": [
              "JER.50.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’iranie Abaisraeli gocha ase obomenyo bwabo naende. Nabarabwo nabarie chindagera chiabo agwo ase egetunwa gia Karimeli, na ase orogongo rwa Basani, na okogania kwabo nagoisanekigwe agwo ase ebigoro bi’Efraimu, na ase Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.19",
            "verseOrgIds": [
              "JER.50.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga: Ase amatuko ayio, na ase engaki eyio, ogosaria nakorigigwe ase Abaisraeli, ko tigokonyorekana, na ebibe ase Abayuda, ko tibikonyorekana, ekiagera inche Omonene ninyabere abanto abwo ndatigarie koba abatigari.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.20",
            "verseOrgIds": [
              "JER.50.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae okogambia Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oteebire, Genda morwanie ense ya Merataimu na abanto ba Pekodi. Mobabwatie korwa magega, mobaite na kobasiria kegima, mokore onsi aya nabachiikire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.21",
            "verseOrgIds": [
              "JER.50.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriogi ri’esegi riachire ase ense amo nogosirigwa okonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.22",
            "verseOrgIds": [
              "JER.50.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki enturago eria yaagete ense engima yaakirwe na gwateka! Naki Babiloni osirigwe, na abanto baichanigwe ase okoyorora igo!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.23",
            "verseOrgIds": [
              "JER.50.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 50:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Babiloni, nagotegire noboreba, kwabwatirwe, nonya tikwamanyete ayio; kwanyorirwe na kobwatwa, ekiagera nkwamorwanetie Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.24",
            "verseOrgIds": [
              "JER.50.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 50:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oigoire ase agachete ebirwanero biaye, na ase endamwamu yaye obisokirie, ekiagera Omonene, Nyasae bw’Emeganda, nabwate emeremo agokora ase ense y’Abakalidayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.25",
            "verseOrgIds": [
              "JER.50.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 50:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchuo morwanie ense eyio korwa ase chinsemo chionsi, moigore ebiage biaye; mobeke ebinto bire imeo amo, bibe buna ebinge chi’endagera. Mosirie ense eyio kegima; timobaisa gotigaria nonya negento ekemo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.26",
            "verseOrgIds": [
              "JER.50.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 50:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moite abarwani babo b’esegi banga buna chieri, mobaite bonsi pi. Obobe nobwabo, ekiagera rituko ri’ogosirigwa kwabo riachire, eyio nengaki yabo y’okonyora egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.27",
            "verseOrgIds": [
              "JER.50.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 50:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwa eriogi ri’abaanto bagotama korwa ase ense ya Babiloni, bakoraria ase Sayoni igoro y’Omonene, Nyasae oito, buna akoruseria Hekalu yaye egesiomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.28",
            "verseOrgIds": [
              "JER.50.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 50:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangeria abanto bamanyete korwanera amata bachiche korwania Babiloni. Moyoboere ase chinsemo chionsi, timotiga nonya nomonto oyomo atame atooreke. Yoakane koreng’ana nogokora kwaye. Buna koreng’ana oro okorete tiga okorerwe boigo, ekiagera omochie oyio oenenire ase Omonene, oyore Omochenu bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko erio abamura b’omochie oyio, nabaitwe, bakwere agwo ase chinchera, na abarwani baye bonsi b’esegi nabasirigwe kegima. Nabo inche Omonene natebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 50:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende inche Omonene, Nyasae bw’Emeganda, natebiire: Aye Babiloni ore omoenenu, igwa, inche nabeire mamincha yao; rituko riao riaikire, engaki eye ngokoa egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.31",
            "verseOrgIds": [
              "JER.50.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 50:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio ore omoenenu nagochwe na kogwa, gose monto onde takomogororokia. Nintongie omorero ase emechie y’ense eyio noro nosambe chinsemo chiaye chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.32",
            "verseOrgIds": [
              "JER.50.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 50:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene bw’Emeganda agoteeba: Abaisraeli amo n’Abayuda nigo bachandire. Abanto abwo baabairete ase obosomba nigo baababwatete bokong’u, bangire kobaa ribaga bagende sobo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.33",
            "verseOrgIds": [
              "JER.50.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 50:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende omobooria obo nigo are ne chinguru. Omonene bw’Emeganda nario erieta riaye. Ekeene, ere nabarwanerere, erinde arente obotoereru na omotimoko ase ense, korende narente omorero ase abanto bamenyete Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.34",
            "verseOrgIds": [
              "JER.50.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 50:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoro obe igoro ase Abakalidayo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igoro ase abanto bamenyete Babiloni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igoro ase abanene b’oborwoti obwo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igoro ase abanto abang’aini b’ense eyio!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 50:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoro obe igoro ase abaringoria,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.36",
            "verseOrgIds": [
              "JER.50.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde babe abariri!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.36",
            "verseOrgIds": [
              "JER.50.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoro obe igoro ase abarwani baye bare chituoni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.36",
            "verseOrgIds": [
              "JER.50.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde basirigwe!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.36",
            "verseOrgIds": [
              "JER.50.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 50:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoro obe igoro ase chibarasi ne chigari chia Babiloni!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.37",
            "verseOrgIds": [
              "JER.50.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoro obe igoro ase abasikari b’ense eng’ao, abare ase egati yabo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.37",
            "verseOrgIds": [
              "JER.50.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde obakore babe buna abakungu!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.37",
            "verseOrgIds": [
              "JER.50.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoro obe igoro ase chinibo chiabo erinde chisakorwe!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.37",
            "verseOrgIds": [
              "JER.50.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 50:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egurugura nebe igoro ase chindooche chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.38",
            "verseOrgIds": [
              "JER.50.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde chikame amaache!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.38",
            "verseOrgIds": [
              "JER.50.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ense eyio nigo eichire nemegwekano y’ogosasimwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.38",
            "verseOrgIds": [
              "JER.50.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto mbabe buna chibarimo ase ogosasiima emegwekano eyio!",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.38",
            "verseOrgIds": [
              "JER.50.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 50:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio ching’iti chi’orosana, amo ne chinyang’au, ne chisagero nachimenye ase ense eyio. Abanto tibagocha komenyao nonya ng’ake, korwa ekiaare goika ekiaare kogenderera botambe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.39",
            "verseOrgIds": [
              "JER.50.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 50:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna yabeete ekero keria Nyasae asiretie emechie ya Sodomu na Gomora, amo nemechie yarenge ang’e neyio, naboigo monto onde takomenya Babiloni, gose Mwanyabaanto onde takomenya aroro. Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.40",
            "verseOrgIds": [
              "JER.50.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 50:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Abanto ngocha bare korwa sugusu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.41",
            "verseOrgIds": [
              "JER.50.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "egesaku ekenene mono amo nabarwoti abange",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.41",
            "verseOrgIds": [
              "JER.50.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baseegetirwe korwa chinsinyo chi’ense.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.41",
            "verseOrgIds": [
              "JER.50.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 50:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo nigo babwate amata na amatimo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.42",
            "verseOrgIds": [
              "JER.50.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bare abatindi, abatari namaabera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.42",
            "verseOrgIds": [
              "JER.50.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amariogi abo nigo akoeera buna okoeera kw’enyancha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.42",
            "verseOrgIds": [
              "JER.50.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bariinete chibarasi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.42",
            "verseOrgIds": [
              "JER.50.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "berobeirie buna omonto bwebekire ang’e ase esegi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.42",
            "verseOrgIds": [
              "JER.50.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde baabarwanie inwe, abanto ba Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.42",
            "verseOrgIds": [
              "JER.50.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 50:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omorwoti o Babiloni oigure amang’ana igoro yabo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.43",
            "verseOrgIds": [
              "JER.50.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaboko aye aborirwe chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.43",
            "verseOrgIds": [
              "JER.50.43"
            ]
          }
        }
      ]
    },
