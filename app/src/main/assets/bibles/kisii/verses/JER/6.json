          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoguba ogouta omorero nigo ogouterera mono, korende ribiria tiriri gwatananwa. Ogochenwa okwo nigo kore okwa bosa, ekiagera obobe tibori korusigwao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.29",
            "verseOrgIds": [
              "JER.6.29"
            ]
          }
        },
        {
          "name": "verse",
