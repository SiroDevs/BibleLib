          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bararokwe chifeta chiangirwe ekiagera inche Omonene nabangire.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.30",
            "verseOrgIds": [
