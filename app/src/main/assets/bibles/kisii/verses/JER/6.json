              "type": "text"
            }
          ]
        },
        {
          "text": "Bonsi nigo bare abasaria na abanyabigoti bikong’u; nigo bagotaaria obogenki; nigo bare buna etai na ekioma, bonsi nigo bagokora ay’ogosaria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.28",
            "verseOrgIds": [
              "JER.6.28"
            ]
          }
        },
        {
          "name": "verse",
