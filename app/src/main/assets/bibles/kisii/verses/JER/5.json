  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JER 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ebibe bi’abaanto ba Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minyoka gochia aaria na aaria ase chinchera chia Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "morigererie na komanya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Moriga‐rigie ase chichiiro morore",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose monyore omonto oyomo",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogokora oboronge na korigia ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde inche Omonene inyare kwabera omochie oyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya bagokwana, “Ekeene, buna Omonene are moyo,”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.2",
            "verseOrgIds": [
              "JER.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagotiana ase obong’ainereria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.2",
            "verseOrgIds": [
              "JER.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, Inee, amaiso ao tari korigereria ay’ekeene?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.3",
            "verseOrgIds": [
              "JER.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye okobaaka, korende tibaigwete obororo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.3",
            "verseOrgIds": [
              "JER.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye okobaa egesusuro, korende bangire korongea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.3",
            "verseOrgIds": [
              "JER.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bakaba bakong’etie amasio abo pa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.3",
            "verseOrgIds": [
              "JER.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakaanga gweitia bairane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.3",
            "verseOrgIds": [
              "JER.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nkarengereria, “Abanto aba nabataka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.4",
            "verseOrgIds": [
              "JER.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo tibari nobong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.4",
            "verseOrgIds": [
              "JER.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera tibamanyeti enchera y’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.4",
            "verseOrgIds": [
              "JER.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ogochika kwa Nyasae obo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.4",
            "verseOrgIds": [
              "JER.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningende ase abanto abanene, nkwane nabarabwo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.5",
            "verseOrgIds": [
              "JER.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera barabwo mbamanyete enchera y’Omonene",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.5",
            "verseOrgIds": [
              "JER.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogochika kwa Nyasae obo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.5",
            "verseOrgIds": [
              "JER.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende nabarabwo bonsi boigo konya babunire rikorogoto",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.5",
            "verseOrgIds": [
              "JER.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobutora ebisibo basiberetwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.5",
            "verseOrgIds": [
              "JER.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho eyio endo nerue rinani ebaite;",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "esese y’orosana nerue erooro ebasirie;",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "engo nebaboere ase emechie yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Kera omonto ogosoka korwa aroro natandoranwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ogosaria kwabo nokonge,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okogwa kwabo kw’ogontiga nokonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naki ndakore mbaabere?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.7",
            "verseOrgIds": [
              "JER.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abana baino bantigire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.7",
            "verseOrgIds": [
              "JER.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagotiana ase chinyasae ching’ao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.7",
            "verseOrgIds": [
              "JER.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero nabaete ebinto biisaine nigo babete bagotomana,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.7",
            "verseOrgIds": [
              "JER.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakagenda ase chinyomba chi’abakungu abanyaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.7",
            "verseOrgIds": [
              "JER.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo barenge buna chibarasi chiaragerigwe buya chire nokogania,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.8",
            "verseOrgIds": [
              "JER.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kera omonto akaba okogania omokungu bw’omogisangio oye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.8",
            "verseOrgIds": [
              "JER.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende Omonene akaboria: Inee! Tinkobaa egesusuro ase amang’ana aya?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.9",
            "verseOrgIds": [
              "JER.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tinkweruseria egesiomba ase egesaku buna eke?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.9",
            "verseOrgIds": [
              "JER.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Genda moriine ase chindwaki chi’omochie oyio moyosarie,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.10",
            "verseOrgIds": [
              "JER.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende timoyokoora kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.10",
            "verseOrgIds": [
              "JER.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Moarorie chinsagia chi’emesabibu yaye chirueo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.10",
            "verseOrgIds": [
              "JER.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera echio tichiri echi’Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.10",
            "verseOrgIds": [
              "JER.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’enyomba ya Israeli na eya Yuda",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.11",
            "verseOrgIds": [
              "JER.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibari abegenwa ase ’nde nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.11",
            "verseOrgIds": [
              "JER.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche Omonene nakwanire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.11",
            "verseOrgIds": [
              "JER.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene okwanga Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bakwanire oborimo igoro ase Omonene, batebiire, “Omonene tagokora gento kende. Intwe titokorenterwa amabe; titogocherwa korwanigwa nemioro, gose enchara tegocha ase tore.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.12",
            "verseOrgIds": [
              "JER.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabani nigo barabe buna embeo ekogusa, tibabwati ring’ana ria Nyasae. Ase ayio barabwo mbakorerwe amang’ana ayio.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.13",
            "verseOrgIds": [
              "JER.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, aya nar’Omonene, Nyasae bw’Emeganda, agoteeba: “Ekiagera bakwanire ring’ana eri: Naama, inche ninkore amang’ana aane are ime ase omonwa oo abe buna omorero; abanto aba nababe buna chinko, na omorero oria nobasambe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.14",
            "verseOrgIds": [
              "JER.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga: “Inwe abanto b’enyomba ya Israeli, nkorenta nde egesaku kerue ense y’aare, kere nechinguru, naende kiarengeo korwa chingaki chia kare, ekio motamanyeti omonwa obo, gose timokomanya ogokwana kw’omonwa obo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.15",
            "verseOrgIds": [
              "JER.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigochi chie chinsara chiabo nigo chinga buna chimbeera chiasie, bonsi nigo bare abanto chituoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.16",
            "verseOrgIds": [
              "JER.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo mbarie okwama gwe chindagera chiaino, na abana baino, abamura na abaiseke, ne ching’ondi ne chiombe chiaino, na amasabibu na emeko yaino. Emechie yaino egiteire chindwaki, eyio mosemeretie, barabwo nabayetagore nemioro.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.17",
            "verseOrgIds": [
              "JER.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende Omonene oteebire, “Nonya nase amatuko ayio tinkobasiria inwe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto baino kobarakoborie: Nase ki Omonene, Nyasae oito, atokoreire amang’ana aya onsi? Aye oiranerie ng’a inche natebiire: Koreng’ana buna mwaonchokire mwantigire, naende mwasasimire chinyasae ching’ao aiga ase ense yaino, naboigo mogochia koba abasomba b’abaanto abaao ase ense etari eyaino.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.19",
            "verseOrgIds": [
              "JER.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae ogokuurera abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga: “Teebia abanto b’ororeria rwa Yakobo amang’ana aya, oyararie ase Abayuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.20",
            "verseOrgIds": [
              "JER.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto abariri motari nobong’aini, igwa amang’ana aya, mobwate amaiso, ko timori korora, mobwate amato, ko timori koigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.21",
            "verseOrgIds": [
              "JER.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Inwe timokonyiroka inche Omonene? Timokoiguswa ase obosio bwane? Nigo nabegete omokenye okaba orobebe rw’enyancha, egetango kia botambe enyancha etanyare gotamboka. Nonya nemerindo ekorotwoma, tekonyara korotagora. Nonya ekoimokerera igoro, tekonyara goeta orobebe roria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.22",
            "verseOrgIds": [
              "JER.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abanto aba nigo bare ne chinkoro chinkong’u chi’ogotaigwera, baonchokire bantigire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.23",
            "verseOrgIds": [
              "JER.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo tibari gokwana ase chinkoro chiabo: Tiga tomoiroke Omonene, Nyasae oito, oyogotoa embura ase engaki yaye egwenerete; embura y’omochakano na ey’okwamia endagera, naende nere ogotorendera chichuma chibekire ase rigesa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.24",
            "verseOrgIds": [
              "JER.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bono amamocho aino abatangire timonyora ebinto ebio, na ebibe biaino biatangire ebinto ebiya mwarenge gocha koegwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.25",
            "verseOrgIds": [
              "JER.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abakori amabe nigo bakonyorekana ase egati y’abanto baane; abwo nigo bagotega buna abategi be chinyoni, nigo bakobeeka amareba",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.26",
            "verseOrgIds": [
              "JER.5.26"
            ]
          }
        },
        {
          "text": "babwate abanto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.26",
            "verseOrgIds": [
              "JER.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana egesera geichire ne chinyoni, naboigo ne chinyomba chiabo chiaichoire n’ebinto bisakoire; ase engencho eyio babeire ne chinguru, na abanda mono.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.27",
            "verseOrgIds": [
              "JER.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banorire na koneta. Tibari gotiga gokora amabe. Tibari kogambera chintakana ebiina bi’oboronge bagere bakire, gose tibari gokorera abataka oboronge.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.28",
            "verseOrgIds": [
              "JER.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende Omonene okwanire iga: “Inee! Tinkobaa egesusuro ase engencho y’ogokora okwo? Tinkweruseria egesiomba igoro ase egesaku kegokora amang’ana buna ayio?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.29",
            "verseOrgIds": [
              "JER.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogokora gw’okogechia na ogw’okoirokia gwakorekanire ase ense eye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.30",
            "verseOrgIds": [
              "JER.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabani nigo bakobana oborimo, na abakuani nigo bagwancherana namang’ana abo. Abanto baane nigo banchete amang’ana ayio, korende ninki morakore ekero omoerio orache?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.31",
            "verseOrgIds": [
              "JER.5.31"
            ]
          }
        }
      ]
    }
  ],
