{
  "id": "JER.46",
  "number": "46",
  "bookId": "JER",
  "reference": "Yeremia 46",
  "copyright": "© 2021 KENBS",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "JER 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abamisiri bakobugwa agwo Karikemisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ring’ana ri’Omonene rigacha ase Yeremia omobani igoro y’ebisaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ring’ana eri rigakwanwa igoro ya Misiri, na igoro y’abarwani b’esegi ba Farao Neko, omorwoti o Misiri, abarenge ang’e norooche rw’Eufarati agwo Karikemisi, abwo Nebukadinesaro, omorwoti o Babiloni, abuete ase omwaka o kane bw’okogamba kwa Yehoyakimu mosinto o Yosia, omorwoti bw’Abayuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beka chinguba ne ching’aya ang’e,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.3",
            "verseOrgIds": [
              "JER.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mogende bosio ase esegi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.3",
            "verseOrgIds": [
              "JER.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abariini chibarasi beka chibarasi ang’e mochiriine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.4",
            "verseOrgIds": [
              "JER.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Beka ebigogwa biaino bi’ebioma, mwebeke ang’e,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.4",
            "verseOrgIds": [
              "JER.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tieria amatimo aino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.4",
            "verseOrgIds": [
              "JER.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Beka chigoti chiaino chi’ebioma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.4",
            "verseOrgIds": [
              "JER.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninki kiagera aya ndoche akorekire?",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Baondokire na koirana magega;",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abarwani babo chituoni babuirwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batamire ase okoayerera batari korigereria magega;",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obwoba nigo bore ase chinsemo chionsi. Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.5",
            "verseOrgIds": [
              "JER.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baria bamanyete kominyoka chimbero tibakonyara gotama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.6",
            "verseOrgIds": [
              "JER.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nabarwani bare chituoni tibagotooreka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.6",
            "verseOrgIds": [
              "JER.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Agwo sugusu, ang’e norooche rw’Eufarati, bagochirwe na kogwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.6",
            "verseOrgIds": [
              "JER.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oyo onga buna orooche rwa Naeli rwaichoire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.7",
            "verseOrgIds": [
              "JER.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo onga buna chindooche chiaichoire amaache?",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.7",
            "verseOrgIds": [
              "JER.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri nigo ekoimokerera igoro buna orooche rwa Naeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.8",
            "verseOrgIds": [
              "JER.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo ekoimokerera igoro buna chindooche chiaichoire amaache.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.8",
            "verseOrgIds": [
              "JER.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Misiri eria egateba, Ninyimokerere igoro ntube ense,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.8",
            "verseOrgIds": [
              "JER.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninsarie na gosiria emechie na abanto bamenyeteo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.8",
            "verseOrgIds": [
              "JER.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiika chibarasi chigende bosio,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.9",
            "verseOrgIds": [
              "JER.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chigari chigende ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.9",
            "verseOrgIds": [
              "JER.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga chituoni chi’esegi chigende bosio:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.9",
            "verseOrgIds": [
              "JER.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abaetiopia na Abaputi, nabwo ababogoria be chinguba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.9",
            "verseOrgIds": [
              "JER.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Abaludi nabwo abarwaneri amata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.9",
            "verseOrgIds": [
              "JER.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rituko riria neri’Omonene, Nyasae bw’Emeganda;",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rituko ri’okorusia egesiomba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eruserie egesiomba, ase ababisa baye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoro nobarie oigote kegima;",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonywe amanyinga abo oichore.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene, Nyasae bw’Emeganda, nabe nekeng’wanso",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ense ya sugusu, ang’e norooche rw’Eufarati.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto ba Misiri more buna abaiseke abekungi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiira gochia ase Gileadi monyore amaguta akogwenia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Namoisa konyora amariogo amange abosa ase more,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okogwenigwa tikori ase more.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’ebisaku baigure amang’ana igoro y’obosooku bwaino,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebirero biaino biaichoire ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera omorwani etuoni ogochirwe na kogwa igoro ase etuoni ende.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bonsi bagwereranire amo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nebukadinesaro ogocha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ring’ana eri nario Omonene atebeetie Yeremia igoro y’ogocha kwa Nebukadinesaro, omorwoti o Babiloni, ase okobua ense ya Misiri:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwana aya ase Misiri, moyararie ase Migidoli,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.14",
            "verseOrgIds": [
              "JER.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, yararie ase Memifisi na Tapenesi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.14",
            "verseOrgIds": [
              "JER.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tenena, bwebeke ang’e,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.14",
            "verseOrgIds": [
              "JER.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera omoro nosirie ase chinsemo chiao chionsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.14",
            "verseOrgIds": [
              "JER.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki abanto baino bare ne chinguru batamire?",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.15",
            "verseOrgIds": [
              "JER.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tibatenenete, ekiagera Omonene abaseretie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.15",
            "verseOrgIds": [
              "JER.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatiga emeganda yaino ekagochwa na kogwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.16",
            "verseOrgIds": [
              "JER.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio bagakwana na goteebania Omonto ase omonto:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.16",
            "verseOrgIds": [
              "JER.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Imoka, toirane ase abanto baito,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.16",
            "verseOrgIds": [
              "JER.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ense yaito twaiboreretwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.16",
            "verseOrgIds": [
              "JER.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "totame korwa ase omoro bw’abagotochanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.16",
            "verseOrgIds": [
              "JER.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nigo bakorera igoro ya Farao, omorwoti o Misiri, na komooroka",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.17",
            "verseOrgIds": [
              "JER.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omosiru oyosiririe chingaki chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.17",
            "verseOrgIds": [
              "JER.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti, oyore Omonene bw’Emeganda, nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekeene, buna inde moyo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyomo onga buna Tabori ase egati y’ebitunwa binde",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onga buna Karimeli, egetunwa kere ang’e nenyancha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngocha are.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.18",
            "verseOrgIds": [
              "JER.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto ba Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
              "JER.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "beka chigurube chiaino ang’e,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
              "JER.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mong’anye mogende ase obosomba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
              "JER.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Memifisi nosirigwe otigare bosa, otamenyiri na monto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
              "JER.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri nigo onga buna ritororo rigiya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.20",
            "verseOrgIds": [
              "JER.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ekiaramba kiarure sugusu na kiayorasire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.20",
            "verseOrgIds": [
              "JER.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani esegi barangeretigwe gokonya nigo banga buna chimori chinoru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Beonchoire batamire bonsi amo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tibakonyara gotenena korwana esegi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki rituko ri’emechando yabo riabaikeire;",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eye nengaki bakoegwa egesusuro kiabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri nigo egochura neriogi ringa buna eri’eng’iti egwekurura.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
            "verseOrgIds": [
              "JER.46.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ababisa ba Misiri nigo bagocha bare ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
            "verseOrgIds": [
              "JER.46.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bagocha bare nebisire buna abagochia kogecha chinko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
            "verseOrgIds": [
              "JER.46.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba ng’a mbageche rinani ri’ense eria",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.23",
            "verseOrgIds": [
              "JER.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya rire rinoru mono ritaetwe nonde,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.23",
            "verseOrgIds": [
              "JER.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera abwo nigo bare abange mono kobua chingige,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.23",
            "verseOrgIds": [
              "JER.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibakonyara kobareka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.23",
            "verseOrgIds": [
              "JER.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto ba Misiri nabanyore obosooku,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
              "JER.46.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nababekwe ase amaboko ’abaanto bakorwa sugusu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
              "JER.46.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene bw’Emeganda, Nyasae bw’Abaisraeli, nigo agoteeba iga, “Rora, nkorenta nde egesusuro igoro ase Amoni, enyasae ya Tebesi, na ase Farao na Misiri, na ase chinyasae chi’ense eyio, na ase abarwoti b’aroro, na ase Farao omonyene, na ase abanto bonsi baria bamosemeretie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbabeeke ase amaboko abwo bakorigia gosiria obogima bwabo, na ase okoboko kwa Nebukadinesaro, omorwoti o Babiloni, na ase abasomba baye. Korende magega y’ayio abanto nabamenye ase ense ya Misiri, buna engaki ya kare. Nab’Omonene atebiire.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene natoorie abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende inwe abanto ba Yakobo, abasomba baane, timoiroka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.27",
            "verseOrgIds": [
              "JER.46.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe Abaisraeli, timokwa emioyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.27",
            "verseOrgIds": [
              "JER.46.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naama! Nimbatoorie korwa ase ense y’aare.",
          "type": "text",
          "attrs": {
