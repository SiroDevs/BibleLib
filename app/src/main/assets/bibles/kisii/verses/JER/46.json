          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.28",
            "verseOrgIds": [
              "JER.46.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abanto ba Yakobo, abasomba baane,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.28",
            "verseOrgIds": [
              "JER.46.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timoiroka, ekiagera inche nigo inde amo nainwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.28",
            "verseOrgIds": [
              "JER.46.28"
            ]
          }
