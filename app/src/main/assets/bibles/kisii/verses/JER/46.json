    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebio ase nabasiarerete gochia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.28",
            "verseOrgIds": [
              "JER.46.28"
            ]
          }
        }
