    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na monto onde tari oraboboyie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.27",
            "verseOrgIds": [
              "JER.46.27"
            ]
