    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninsirie kegima ebisaku bionsi",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.28",
            "verseOrgIds": [
              "JER.46.28"
            ]
          }
        }
