      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto ba Yakobo nabairane bamenye ase obotoereru na korendwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.27",
            "verseOrgIds": [
