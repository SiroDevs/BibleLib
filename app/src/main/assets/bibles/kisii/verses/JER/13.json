              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche omonyene nimbasiorie chianga chiaino chiike amasio aino igoro, erinde obogetirianda bwaino bororekane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.26",
            "verseOrgIds": [
              "JER.13.26"
            ]
          }
