        },
        {
          "text": "Omonene nigo agoteeba iga: Eke nakio kerabe egetari kiaino ndabae, ekiagera mwanyebire na mwasemeirie amang’ana ’oborimo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        },
