    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okogwa kwa Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(2 Abar 24:18—25:7)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekia nigo arenge nemiaka emerongo ebere nomo, ekero aetwe oborwoti, akagamba emiaka ikomi nomo agwo Yerusalemu. Ng’ina nigo arenge korokwa Hamutali, mosubati o Yeremia, omonto korwa Libuna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekia oyio agakora ayare amabe ase obosio bw’Omonene, koreng’ana buna aria onsi Yehoyakimu akorete.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, endamwamu y’Omonene ase Yerusalemu na ase Abayuda nigo yagerete akabarusia ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Ase engaki eyio Zedekia akaanga koigwera omorwoti o Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o kianda, rituko ria ikomi ri’omotienyi o ikomi bw’okogamba kwa Nebukadinesaro, omorwoti o Babiloni, amo nabarwani baye bonsi b’esegi bagacha korwania Yerusalemu. Barabwo bakayonaaria na bakaagacha orwaki rw’ogwekengera rokayoetanana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo omochie oria okaba onaaririe goika omwaka o ikomi nomo bw’okogamba gwa Zedekia omorwoti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko ria kianda ri’omotienyi o kane, enchera ekaba enene mono ase omochie oria ime, goika endagera akabora kegima ey’abaanto bakoria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio chindwaki chi’omochie chikabochorwa, na abanto bonsi b’esegi bagatama botuko, bagaetera ase egeita kiarenge gati‐gati ye chindwaki ibere, ang’e nomogondo bw’omorwoti, nonya Abakalidayo banaaretie omochie ase chinsemo chionsi. Bagatama gochia ase Ekerubo Ekiomo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani esegi b’Abakalidayo bakabwatia Zedekia omorwoti, bakamoikeera agwo ase ense omweya ya Yeriko, ekero abarwani baye bonsi b’esegi konya bamotigire na goserebekana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bakabwata omorwoti oria, bakamoira ase omorwoti o Babiloni agwo ase omochie o Ribula, ase ense ya Hamati, na ere akamonachera ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo Ribula omorwoti oria agaita abana abamura ba Zedekia ase amaiso aye, agaita nabanene bonsi b’oborwoti bw’Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende agakonora amaiso a Zedekia, akamosiba nebinyuri, akamoira Babiloni, akamobeka ase echela, akamotiga aroro goika rituko ri’ogokwa kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotagorwa gwe Hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(2 Abar 25:8-17)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko ria ikomi ri’omotienyi o gatano, ase omwaka o ikomi na kianda bw’okogamba kwa Nebukadinesaro, omorwoti o Babiloni, Nebusaradani, oyorenge omoteneneri bw’abarendi na omosomba bw’omorwoti o Babiloni, agacha Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere agasamba enyomba y’Omonene, na enyomba y’Omorwoti, ne chinyomba chionsi chia Yerusalemu; agasamba kera enyomba enene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani esegi bonsi b’Abakalidayo, na baria barenge amo nomoteneneri oria bw’abarendi, bagatagora chindwaki chionsi chiaetanaine Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Nebusaradani, omoteneneri oria bw’abarendi, agoosa akaira ase obosomba abanto bande baria barenge abataka mono, amo nabaanto bande konya batigaire ase omochie; boigo akaira abanto baria konya batameire omorwoti o Babiloni bamokorere, akaira nabaroisia b’ebinto abatigarete.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Nebusaradani oria omoteneneri bw’abarendi agatiga abanto bande barenge abataka mono b’ense eria babeere aroro. Abwo bakaba bakoroiseria emegondo y’emesabibu na gokora emeremo y’okorema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakalidayo bakabuna chisiiro chie chitaai chiria chiarenge ime ase enyomba y’Omonene, na ebibekerero bi’ebituba, na egetuba keria ekenene mono kiaroisirie korwa ase etai ebiarenge ase enyomba y’Omonene. Kobabibunire bikaba ebing’ese, bakaira etai eria yonsi Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo bakaira chindogio, na ebichiko, na ebiinachi, ne chisani, na ebitaabo bi’ogosambera ubani, na ebikorero bionsi bie chitaai biarenge gokorerwa emeremo ase Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaira ne chibakuria chinke, ne chindogio chi’okorenta omorero, ne chisani, ne chinyongo, na ebibekerero bie chitaaya, na ebitaabo bi’ogosambera ubani, na ebikombe bi’okoruerwa kw’ebinyugwa. Omoteneneri oria bw’abarendi akaira ebinto bionsi bie chitaabu chichenire, na ebie chifeta chichenire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborito bwe chitaai chiaroisetie chisiiro chiria ibere, na egetuba keria ekenene mono, na emegwekano ye chieri ikomi na ebere yeroisirie korwa ase chitaai eyio yaimokereretie egetuba keria igoro, amo nebibekerero bionsi biria Sulemani omorwoti aroisetie ase enyomba y’Omonene, nigo bwaetanetie ekerengo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera eyemo ye chisiiro chiria nigo yarenge nobotambe bw’amaboko ikomi na atano na atato, na engori y’obotambe bw’amaboko ikomi na abere ekayeetanana. Nigo yaroisetigwe buna omobirangwa na obonetu bw’etai yaroisetie omobirangwa oria nigo bwarenge obogare bw’ebiara bine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na igoro ase kera esiiro, egesure nkiarengeo kiaroiseirie etai, na obotambe bwaye nigo bwarenge obw’amaboko atano. Egechanga na emegwekano y’amatunda amakomomanga biaroisirie korwa ase chitaai, nigo biaetanaine egesure keria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase chinsemo chiaye narengeo amakomomanga emerongo kianda, na atano na rimo. Amakomomanga onsi arenge igoro ase egesure ekemo ase chinsemo chiaye chionsi nigo arenge rigana erimo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abayuda bakong’anyigwa gochia Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(2 Abar 25:18-21,27-30)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoteneneri oria bw’abarendi akaira Seraya, Omokuani omonene, na Safania, Omokuani o kabere, na abarendi b’egesieri batato.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende akaira korwa ase omochie oria omonto oyomo orenge omochiki bw’abasikari, na abanto batano na babere b’ekegambero ki’omorwoti, abanyoretwe ase omochie ime, na omoriki bw’omochiki oria bw’abasikari, oria orenge gokora omobaro bw’abaanto b’ense eria, amo nabaanto emerongo etano nomo b’ense eria, abanyorekanete ase omochie ime.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradani, omoteneneri bw’abarendi, akababwata, akabaira ase omorwoti o Babiloni agwo Ribula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti o Babiloni akabaita bagakwera agwo Ribula, ase ense ya Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Ase igo Abayuda bakarusigwa ase ense yabo, bakairwa ase obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo noro omobaro bw’abaanto Nebukadinesaro airete ase obosomba: ase omwaka o gatano na kabere akaira Abayahudi chilifu isato, na emerongo ebere, na batato (3,023).",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o ikomi na gatano na gatato. Nebukadinesaro akaira korwa Yerusalemu abanto amagana atano na atato, na emerongo etato na babere (832).",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka bw’emerongo ebere, na gatato, bw’okogamba kwa Nebukadinesaro Nebusaradani, omoteneneri bw’abarendi, akaira Abayahudi amagana atano na abere, na emerongo ene na batano (745); bonsi Abanto abairetwe nigo barenge chilifu inye, na amagana atano na rimo (4,600).",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka bw’emerongo etato netano nebere (37) korwa Yehoyakini omorwoti o Yuda airetwe obosomba ase ense ya Babiloni ase omotienyi o ikomi na kabere (12) chitariki emerongo ebere na isano (25), Omorwoti Ewili Merodaki o Babiloni ase omwaka oria achagete kogamba akarorera Yehoyakini Omorwoti o Yuda amaabera akamorusia echera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewili‐Merodaki agakwana amang’ana ’obwororo nere, naende akamoa amasikani amanene kobua ayio aete abarwoti bande barenge amo nere agwo Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo Yehoyakini akaonchoreria chianga chiaye chi’obosibwa, na kera rituko ase obogima bwaye bwonsi akaba okoragera nomorwoti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti akamoa endagera yaye botambe na kera egento arenge kogania ase kera rituko ase obogima bwaye bwonsi goika ekero ki’ogokwa kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
