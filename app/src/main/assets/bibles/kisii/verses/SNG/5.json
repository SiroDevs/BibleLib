      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nigo anga amaruma asibigwe namabeere,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.12",
            "verseOrgIds": [
              "SNG.5.12"
            ]
