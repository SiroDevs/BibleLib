  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "SNG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogoteera gwa Sulemani okwo kore okuya goetania amatera onsi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.1",
            "verseOrgIds": [
              "SNG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera Kw’eritang’ani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "(Omoriakari)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga anyunyunte nokonyunyunta kw’omonwa oye.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekiagera obwanchani bwao nobuya kobua edivai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaguta ao akweakwa nigo are ne rimisu rigiya;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erieta riao nigo ringa buna amaguta aumoirwe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio abakungu nigo bagwanchete.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing’use nkobwatie, tominyoke kogenda.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omorwoti ondetire ase enyomba yaye.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ntokogokere na kogochengera,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ntotogie obwanchani bwao kobua edivai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekeene, nakio abakungu bagwancherete.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abakungu ba Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche nigo inde omomwamu ti,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "noyo bw’okogokia.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo inga buna chiema chia Kedari,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende buna ebitambaa bi’ogosungwa bia Sulemani.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timobaisa kondigereria, ekiagera inde omomwamu ti;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nomobaso bw’erioba onsambire.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abamura ba baba nigo bambeete,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakambeeka korenda emegondo y’emesabibu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende omogondo one bw’emesabibu tinarendete.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.6",
            "verseOrgIds": [
              "SNG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omwanchi bw’omoyo one,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nteebie ng’ai okorisia riicho riao.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ng’ai okoriira riakenderera mobaso gati?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki ndabe nkona‐gotayaya",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase egati y’amaicho ’abagisangio bao?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "(Omonyuomi)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ore omoseera kobua abakungu bonsi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onye tomanyeti, bwatia amabarato e riicho,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obe gokorisia chimanwa chiao chie chimbori",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ang’e ne chiema chi’abarisia.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omwanchi one,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ngokoreng’ania nebarasi eaberi ekong’usa egari ya Farao.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.9",
            "verseOrgIds": [
              "SNG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinsea chiao nechinseera, chichabeire n’ebinto bi’oboseera,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne rigoti riao nigo richabeire ne chisonoi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intwe ntokoroiserie ebinyuri bie chitaabu bi’ogwechabera,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ebitonire ne chifeta.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.11",
            "verseOrgIds": [
              "SNG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "(Omoriakari)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero omorwoti arenge aase aye agotimokera,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaguta aane akorokwa narada agatioka rimisu rigiya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.12",
            "verseOrgIds": [
              "SNG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwanchi one nigo are ase ’nde buna omobuko o manemane,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.13",
            "verseOrgIds": [
              "SNG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo nkobeeka ase egekuba kiane gati gati yechimbeere chiane.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.13",
            "verseOrgIds": [
              "SNG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "SNG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwanchi one nigo are ase ’nde buna egesago ki’ebisicha bikorokwa hena,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.14",
            "verseOrgIds": [
              "SNG.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bire ase emegondo y’emesabibu y’Eni‐Gedi.",
