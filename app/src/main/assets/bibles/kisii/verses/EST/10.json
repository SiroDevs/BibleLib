        "style": "s"
      },
      "items": [
        {
          "text": "Obonene bw’Ahaswero na Moredekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti Ahaswero akarusia ebango ase abanto b’ense yaye, na ase ebisinka bie chinyancha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono amang’ana onsi igoro y’ogokora kwaye gwonsi, na okobua kwaye, amo namang’ana onsi buna aimokereretie Moredekai igoro, nigo ariikire ase Egetabu ki’ogokora kw’abarwoti b’Abamedia na ab’Abaayemi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moredekai, Omoyahudi oria, nere orenge oyo o kabere ase omorwoti Ahaswero. Nigo arenge omonene ase Abayahudi, osikire nabamwabo bonsi, ekiagera nigo arenge korigia amaya ase abanto baye, na akerua ase okobarentera omorembe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
  ],
