            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obomera obotang’ani bokagwera Yusufu ase eamate y’Asafu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "text": "Obwa kabere bokagwera Gedalia; ere amo nabamwabo na abana baye abamura nigo barenge ikomi na babere (12).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
