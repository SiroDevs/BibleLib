{
  "id": "1CH.1",
  "number": "1",
  "bookId": "1CH",
  "reference": "1 Amang’ana ’Ebiro 1",
  "copyright": "© 2021 KENBS",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CH 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ebiaare korwa Adamu goika Aburaamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Omoch 5:1-32; 10:1-2; 11:10-26)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu akaibora Seti, na Seti akaibora Enosu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.1",
            "verseOrgIds": [
              "1CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enosu akaibora Kenani, na Kenani akaibora Mahalaleli, na Mahalaleli akaibora Yaredi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.2",
            "verseOrgIds": [
              "1CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaredi akaibora Enoku, na Enoku akaibora Metusela, na Metusela akaibora Lameki;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.3",
            "verseOrgIds": [
              "1CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameki akaibora Nuhu, na Nuhu akaibora Shemu, na Hamu, na Yafeti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.4",
            "verseOrgIds": [
              "1CH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Yafeti nabwo aba: Gomeri na Magogu, Madai na Yavani, Tubali na Meseki, na Tirasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.5",
            "verseOrgIds": [
              "1CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Gomeri nabwo aba: Asikenasi na Rifati, na Togarima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.6",
            "verseOrgIds": [
              "1CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abana abamura ba Yavani nabwo aba: Elisha na Tarisisi, na Kitimu, na Rodanimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.7",
            "verseOrgIds": [
              "1CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Hamu nabwo aba: Kusi na Misiri, Putu na Kaanani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.8",
            "verseOrgIds": [
              "1CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abana abamura ba Kusi nabwo aba: Seba na Havila, Sabuta na Raama, na Sabiteka. Na abana abamura ba Raama nabwo Seba na Dedani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.9",
            "verseOrgIds": [
              "1CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusi akaibora Nimurodi. Nimurodi akaba omonto bw’eritang’ani orenge egiata ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri nere oiborete Abaludi na Abanami, Abalehabi na Abanafutu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapaturusi na Abakasiluhi (korwa ase bare nao Abafirisiti barwete), na Abakafitori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Kaanani akaibora Sidoni, omwana oye omotangi, na Heti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.13",
            "verseOrgIds": [
              "1CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayebusi na Abaamori, na Abagirigasi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.14",
            "verseOrgIds": [
              "1CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahivi na Abaariki, na Abasini;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.15",
            "verseOrgIds": [
              "1CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaarivadi na Abasemari, na Abahamati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.16",
            "verseOrgIds": [
              "1CH.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Shemu nabwo aba: Elamu na Asuri, Arifakisadi na Ludi, Aramu na Usi, Huli na Geteri, na Mesheki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.17",
            "verseOrgIds": [
              "1CH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arifakisadi akaibora Sela, na Sela akaibora Eberi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.18",
            "verseOrgIds": [
              "1CH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eberi akaibora abana babere abamura. Oria omotangi nigo arenge korokwa Pelegi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
        },
        {
          "text": "ekiagera ase amatuko aye abanto b’ense baatananegete, na omomura omwabo nigo arenge korokwa Yokitani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokitani akaibora Alimodadi na Selefu, Hasarmaweti na Yera;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.20",
            "verseOrgIds": [
              "1CH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadoramu na Usali, na Dikila;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.21",
            "verseOrgIds": [
              "1CH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebali na Abimaeli, na Seba;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.22",
            "verseOrgIds": [
              "1CH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofiri na Havila, na Yobabu. Abwo bonsi nigo barenge abana abamura ba Yokitani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.23",
            "verseOrgIds": [
              "1CH.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ororeria rwa Aburaamu korwa ase Shemu narwo oro: Shemu akaibora Arifakisadi, na Arifakisadi akaibora Sela,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.24",
            "verseOrgIds": [
              "1CH.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Eberi, na Pelegi, na Reu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.25",
            "verseOrgIds": [
              "1CH.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Serugi, na Nahori, na Tera,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.26",
            "verseOrgIds": [
              "1CH.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Aburamu nere Aburaamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.27",
            "verseOrgIds": [
              "1CH.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ororeria rwa Isumaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Omoch 25:12-16)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Aburaamu nabwo Isaka na Isumaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.28",
            "verseOrgIds": [
              "1CH.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo noro omooroberio bw’ororeria rwabo. Omwana omomura omotangi o Isumaeli nere Nebayoti; na abande nabwo aba: Kedari na Adibeeli, na Mibusamu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.29",
            "verseOrgIds": [
              "1CH.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misima na Duma, Masa na Hadadi, na Tema,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.30",
            "verseOrgIds": [
              "1CH.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeturi na Nafisi, na Kedema. Aba nabwo abana abamura ba Isumaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.31",
            "verseOrgIds": [
              "1CH.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Ketura, omokungu o sere‐sere o Aburaamu, nabwo aba: Simurani na Yokisani, Medani na Midiani, Isibaki na Sua. Abana abamura ba Yokisani nabwo Seba na Dedani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Midiani nabwo aba: Efa na Eferi, Hanoki na Abida, na Elidaa. Aba bonsi nigo barenge ab’ororeria rwa Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ororeria rwa Esau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Omoch 36:1-19)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburaamu akaibora Isaka. Abana abamura ba Isaka nabwo Esau na Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.34",
            "verseOrgIds": [
              "1CH.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura b’Esau nabwo aba: Elifasi na Reueli, Yeusi na Yalamu, na Kora.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.35",
            "verseOrgIds": [
              "1CH.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura b’Elifasi nabwo aba: Temani na Omari, Sefo na Gatamu, Kenasi ase Timuna, na Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.36",
            "verseOrgIds": [
              "1CH.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Reueli nabwo aba: Nahati na Zera, Sama na Miza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.37",
            "verseOrgIds": [
              "1CH.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abanto bamenyete ase ense ya Edomu kare",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Omoch 36:20-30)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Edomu nabwo aba: Lotani na Sobali, Sibeoni na Ana, Dishoni na Eseri, na Disani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
            "verseOrgIds": [
              "1CH.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Lotani nabwo Hori na Homamu; omosubati omwabo Lotani nigo arenge korokwa Timuna.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Sobali nabwo aba: Aliani na Manahati, Ebali na Sefo, na Onamu. Na abana abamura ba Sibeoni nabwo Aya na Ana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
              "1CH.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana omomura bw’Ana nere Dishoni. Abana ba Dishoni nabwo aba: Hamurani na Esibani, Itirani na Kerani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
            "verseOrgIds": [
              "1CH.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura b’Eseri nabwo aba: Bilihani na Sawani, na Akani. Abana abamura ba Disani nabwo Usi na Arani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abarwoti b’Abaedomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Omoch 36:31-43)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nabwo abarwoti bagamberete ense y’Abaedomu, ekero omorwoti onde bwensi konya ataragambera Abaisraeli: Bela, mosinto o Beori, oyio omochie oye orenge korokwa Dinihaba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.43",
            "verseOrgIds": [
              "1CH.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Bela akwete, Yobabu, mosinto o Zera, korwa Bosira, akaba okogamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.44",
            "verseOrgIds": [
              "1CH.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yobabu akwete, Husamu, bw’ense y’Abatemani akaba okogamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.45",
            "verseOrgIds": [
              "1CH.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Husamu akwete, Hadadi, mosinto o Bedadi, oria obuete Abamidiani ase ense ya Moabu, akaba okogamba ase ribaga riaye; na omochie oye noro Awiti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.46",
            "verseOrgIds": [
              "1CH.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Hadadi akwete, Samula, oyo orwete Masereka, akaba okogamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.47",
            "verseOrgIds": [
              "1CH.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Samula akwete, Saulo oyo orwete Rehoboti, orenge ang’e norooche rw’Eufarati, akaba okogamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.48",
            "verseOrgIds": [
              "1CH.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Saulo akwete, Baali Hanani, mosinto bw’Akibori, akaba okogamba ase ribaga riaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.49",
            "verseOrgIds": [
              "1CH.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Baali‐Hanani akwete, Hadadi akaba okogamba ase ribaga riaye. Omochie oye nigo orenge korokwa Pai, na mokaye nigo arenge korokwa Mehetabeli, mosubati o Matiredi o Mesahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.50",
            "verseOrgIds": [
              "1CH.1.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Hadadi agakwa. Abagaambi b’Abaedomu nabwo aba: Timuna na Alifa, na Yeteti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholibama na Ela, na Pinoni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.52",
            "verseOrgIds": [
              "1CH.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenasi na Temani, na Mibusari,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.53",
            "verseOrgIds": [
              "1CH.1.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 1:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magadieli na Iramu. Abwo nabwo barenge abagaambi b’ebisaku bia Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.54",
            "verseOrgIds": [
              "1CH.1.54"
            ]
          }
        }
      ]
    }
  ],
