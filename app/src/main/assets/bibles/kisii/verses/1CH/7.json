    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bonsi nigo barenge abanto b’ororeria rw’Aseri. Nigo barenge abateneneri be chiamate chiabo, abanto bamanyekanete ng’a nabakong’u ase esegi, abatang’ani b’abaraai. Abwo barigetwe korwa ase chinderia chiabo bagende korwana esegi nigo barenge chilifu emerongo ebere na isano nemo (26,000).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.40",
            "verseOrgIds": [
              "1CH.7.40"
            ]
          }
        }
      ]
