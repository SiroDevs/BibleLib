          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Sofa nabwo aba: Sua, na Hareneferi, na Suali, na Beri, na Imura,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Beseri, na Hodi, na Sama, na Silisa, na Itirani, na Beera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
              "1CH.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana abamura ba Yeteri nabwo aba: Yefune, na Pisipa, na Ara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba Ula nabwo aba: Ara, na Hanieli, na Risia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        }
