              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo akamenya engaki y’emiaka ebere ase enyomba amenyete, eye are goakanera, akaba okoroisia abanto bonsi abarenge komochiera,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
