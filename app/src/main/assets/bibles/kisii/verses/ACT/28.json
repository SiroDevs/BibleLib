    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Enchiri ekorandigwa ase Rumi etari gotangwa",
          "type": "text"
        }
      ]
    },
    {
