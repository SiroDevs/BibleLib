              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki amanyekane ase more ng’a ogotooreka oko kwa Nyasae kwairirwe ase abanto b’Ebisaku, nabarabwo nabaigwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
