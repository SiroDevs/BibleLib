          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Ekero akoorire gokwana amang’ana aya, Abayahudi bakagenda, bakaamererania amang’ana amange barabwo ase barabwo.]",
          "type": "text",
          "attrs": {
