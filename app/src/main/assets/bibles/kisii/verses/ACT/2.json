{
  "id": "ACT.2",
  "number": "2",
  "bookId": "ACT",
  "reference": "Ogokora Kw’abatomwa 2",
  "copyright": "© 2021 KENBS",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ACT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ekeegwa ki’Omoika Omochenu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero rituko ria Pentekosti riaigete, aborokigwa ba Yeso bonsi nigo barenge aase aamo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobosokano okogusa kogaacha korwa igoro, okogusa buna ogw’ekerambauti gekogusa ne chinguru, kogaichora enyomba yonsi aase baikaransete.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimeme buna echi’omorero chikabaorokera, chikabaatananekera, naende chikabaikaransera kera oyomo obo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonsi bagaichorwa n’Omoika Omochenu, bagachaaka gokwana ase emenwa emeao, buna Omoika obaete gwatora.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbamenyete Yerusalemu Abayahudi abasigete Nyasae, abanto korwa ase kera egesaku inse y’erioba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero eriogi eri riaigwetwe, omoganda ogasangererekana amo, okaba nogokumia, ekiagera kera oyomo abaigwete bagokwana ase omonwa oye omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagakumia bonsi na goichana, bagateebania: “Inee! Aba bonsi bagokwana, tibari Abagalili?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki yaba iga, intwe toigwete kera egento bagokwana kera oyomo ase omonwa oye aiboretwe noro?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapariti, Abamedi na Abaelamiti, na abwo bamenyete Mesopotamia, Boyahudi na Kapadokia, Ponto na Asia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Furugia na Pamfulia, Misiri ne chinsemo chia Libia ya Kurene, amo nabageni korwa Rumi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayahudi na abanto b’ebisaku binde abaonchogete, Abakirete na Abaarabu, intwe twensi twaigure aba iga bagokwana ase emenwa yaito igoro y’ogokora gwe chinguru kwa Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagakumia bonsi, bagaichana na koborania: “Amang’ana aya, engencho yaye ninki?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abande bagasekereria, bagoteeba: “Nigo batindire nedivai enyia.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokwana gwa Petero ekero gia Pentekosti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Petero agatenena amo na baria ikomi nomo, agaaka eriogi riaye, akabateebia: “Inwe abasacha ba Boyahudi, na inwe mwensi abamomenyete Yerusalemu, tiga ring’ana eri rimanyekane ase more, tegerera amang’ana aane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.14",
            "verseOrgIds": [
              "ACT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taibo buna mokagete; abanto aba tibatindeti, ekiagera bono nechinsa isato chioka chia mobaso,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.15",
            "verseOrgIds": [
              "ACT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende ring’ana eri ndiria riakwanetwe nomobani Yoel:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nebe ase amatuko ’omoerio, Omonene oteebire,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.17",
            "verseOrgIds": [
              "ACT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbaiterere abanto bonsi Omoika one,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.17",
            "verseOrgIds": [
              "ACT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abana baino, abamura na abaiseke, inababane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.17",
            "verseOrgIds": [
              "ACT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abamura baino nabarore amaroro,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.17",
            "verseOrgIds": [
              "ACT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abagaaka baino nabarote chindoto.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.17",
            "verseOrgIds": [
              "ACT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo, ase amatuko ayio nimbaiterere abasomba baane,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.18",
            "verseOrgIds": [
              "ACT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abasacha na abakungu, Omoika one, na barabwo inababane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.18",
            "verseOrgIds": [
              "ACT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’orokie amakumia ase igoro,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.19",
            "verseOrgIds": [
              "ACT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebikone ase ense inse,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.19",
            "verseOrgIds": [
              "ACT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amanyinga na omorero, ne rikundesi ri’erioki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.19",
            "verseOrgIds": [
              "ACT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erioba narionchoke ribe omosunte,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.20",
            "verseOrgIds": [
              "ACT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omotienyi nobe amanyinga,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.20",
            "verseOrgIds": [
              "ACT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero rituko riria ri’Omonene ritaracha,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.20",
            "verseOrgIds": [
              "ACT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rituko erire rinene, na erire maiso marore.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.20",
            "verseOrgIds": [
              "ACT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende nebe ng’a kera oyorarangerie erieta ri’Omonene natoorigwe”.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.21",
            "verseOrgIds": [
              "ACT.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abasacha ba Israeli, igwa amang’ana aya, Yeso o Nazareti, omonto o orogetigwe ase more na Nyasae ase ogokora gwe chinguru, na amakumia, na ebikone ebi Nyasae akorete nere egati yaino, buna inwe abanyene momanyete,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.22",
            "verseOrgIds": [
              "ACT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso oyio nigo aruetwe ase amang’ana aroberetigwe na Nyasae, oyo oyamanyete korwa kare, na inwe mokamobamba na komoita ase amaboko ’abaanto batari namachiiko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Omonene akamobokia ekero ororobirie obororo bw’amakweri, ekiagera tare konyarekana abwatwe naro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki igo Daudi agokwana igoro yaye:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naroche Omonene ase obosio bwane botambe,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo are ensemo y’okoboko kwane gw’okorio,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde tinyoboa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio enkoro yane nigo ere nomosasooko, oromeme rwane narogooke;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.26",
            "verseOrgIds": [
              "ACT.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobua, omobere one noro notimoke ase ogosemeria,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.26",
            "verseOrgIds": [
              "ACT.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera aye togotiga omoyo one agwo aase abakuure,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.27",
            "verseOrgIds": [
              "ACT.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose togotiga Omochenu oo arore ogosareka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.27",
            "verseOrgIds": [
              "ACT.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwanyorokereirie chinchera chi’obogima;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.28",
            "verseOrgIds": [
              "ACT.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nong’ichorie omogooko ase obosio bwao.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.28",
            "verseOrgIds": [
              "ACT.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaminto, ninyare gokwana nainwe maiso marore igoro y’omogaka oito o kare, Daudi, ng’a nigo akwete, naende agatindekwa, na embeera yaye nao ere aiga goika reero.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.29",
            "verseOrgIds": [
              "ACT.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera Daudi arenge omobani, naende amanyete ng’a Nyasae namotianetie ase emuma ng’a ase oroiboro rwaye nabeeke oyomo ase ekerogo kiaye ki’obonene,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.30",
            "verseOrgIds": [
              "ACT.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "agatang’ana korora aya, agakwana igoro y’okoboka kwaye Kristo, ng’a tagotigwa agwo aase abakuure, nonya nomobere oye tokorora ogosareka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.31",
            "verseOrgIds": [
              "ACT.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo Yeso Nyasae akamobokia na ase aya intwe twensi nigo tore kirori.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.32",
            "verseOrgIds": [
              "ACT.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, kaimokererigwe igoro ase ensemo y’okoboko gw’okorio kwa Nyasae, naende kanyorire korwa ase Tata Omoika Omochenu oria arieretwe eira oiteire ayamwarorire na koyaigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.33",
            "verseOrgIds": [
              "ACT.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera Daudi tagendete igoro, korende ere omonyenye nigo agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Omonene agateebia Omonene one,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ikaransa ensemo y’okoboko kwane gw’okorio,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika mbeke ababisa bao babe inse y’amagoro ao”.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.35",
            "verseOrgIds": [
              "ACT.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo, tiga enyomba yonsi ya Israeli emanye ekeene ng’a Nyasae obekire Yeso, oyio mwabambete, obeire Omonene naende Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero bachia koigwa aya, bagasambwa ase chinkoro chiabo, bakabooria Petero na abatomwa bande: “Abaminto, inki torakore?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero akabairaneria: “Onchoka, mobatiswe kera oyomo ase erieta ria Yeso Kristo, monyore okwaberwa kw’ebibe biaino, na inwe inamoegwe ekeegwa ki’Omoika Omochenu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.38",
            "verseOrgIds": [
              "ACT.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki eira eye nigo ere ase more na ase abana baino, na ase abanto bonsi abare aare, na bonsi abarangerigwe n’Omonene nyasae oito.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero akabaorokeria ase amang’ana ande amange na kobakuurera, ogoteeba: “Etoorie korwa ase ekegori eke getari ekeronge.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.40",
            "verseOrgIds": [
              "ACT.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na barabwo abanchete ring’ana riaye bakabatiswa, ne rituko riria bakamentekana abanto koreng’ana chilifu isato.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.41",
            "verseOrgIds": [
              "ACT.2.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo bakagenderera ase okworokereria kw’abatomwa na ase obomo, ase ogosamunyora omogati na ase ogosaba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obogima bw’ekeombe ki’Abakristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omonto agasogwa nomoondoko, na amakumia amange na ebikone bigakorwa nabatomwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
              "ACT.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bonsi abeegenete nigo barenge aase aamo, naende bakaba n’ebinto bionsi ase obomo;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakaoonia chinibo chiabo na ebinto ebibarenge nabio, na kobigabera abanto bonsi koreng’ana buna kera oyomo aremeire.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera rituko bakagenderera gosangererekana amo ase Hekalu ime, bagosamunyora emegati enyomba ase enyomba na koragerera amo ase omogooko na ase chinkoro chi’oboitongo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.46",
            "verseOrgIds": [
              "ACT.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakomotogia Nyasae na kogwenera abanto bonsi. Omonene akabamentera kera rituko ase okorenta baria barenge gotoorigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.47",
            "verseOrgIds": [
              "ACT.2.47"
            ]
          }
        }
      ]
    }
  ],
