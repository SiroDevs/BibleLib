{
  "id": "ACT.14",
  "number": "14",
  "bookId": "ACT",
  "reference": "Ogokora Kw’abatomwa 14",
  "copyright": "© 2021 KENBS",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "ACT 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Paulo na Barnaba ase Ikonio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaria Ikonio Paulo na Barnaba bagasoa esinagogi amo buna engencho yarenge, bagakwana n’oboikeranu goika abanto abange b’Abayahudi na b’Ebisaku bakeegena.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.1",
            "verseOrgIds": [
              "ACT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Abayahudi abategenete bakaburukania emioyo y’abanto b’Ebisaku na gosaria emioyo yabo igoro ase abaminto.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.2",
            "verseOrgIds": [
              "ACT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engaki entambe Paulo na Barnaba bakamenya aroro, bagakwana noboremu igoro ase Omonene, oyorenge koorokia ring’ana ri’obuya bwaye na kobanchera ebikone na amakumia bikoreke ase amaboko abo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.3",
            "verseOrgIds": [
              "ACT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abanto b’omochie oria bagaatananekana. Abande bakabwatana n’Abayahudi na abande nabatomwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.4",
            "verseOrgIds": [
              "ACT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero okong’orerwa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.5",
            "verseOrgIds": [
              "ACT.14.5"
            ]
          }
        },
        {
          "text": "kw’abaanto b’Ebisaku na Abayahudi amo n’abanene babo gwakoretwe igoro y’abatomwa ase okobakorera amabe na kobaaka amagena,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.5",
            "verseOrgIds": [
              "ACT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "barabwo bakanyora amang’ana, bagatama gochia Listra na Deribe, emechie ya Lukania, ne chinsemo chionsi echiarenge ang’e.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.6",
            "verseOrgIds": [
              "ACT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroro bakagenderera korandia enchiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.7",
            "verseOrgIds": [
              "ACT.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ase Listra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo Listra narengeo omonto oyomo ekerema. Ere nigo arenge rigata korwa ase okoiborwa kwaye, tana kogenda nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.8",
            "verseOrgIds": [
              "ACT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio akaigwa Paulo kagokwana. Paulo akamobeta amaiso, akarora ng’a nare nokwegena gw’okogwenigwa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.9",
            "verseOrgIds": [
              "ACT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "agakwana neriogi rinene, agateeba: “Tenena boronge namagoro ao.” Agatenena bwango, agataarataara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.10",
            "verseOrgIds": [
              "ACT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero emeganda yachia korora aya Paulo akora, bagaaka amariogi abo, bagakwana ase Ekelukania: “Chinyasae chiatoikeire ase emegwekano ya Mwanyabaanto!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.11",
            "verseOrgIds": [
              "ACT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaroka Barnaba Zeu, na Paulo Herme, ekiagera nere orenge omonene ase ogokwana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.12",
            "verseOrgIds": [
              "ACT.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokuani o Zeu, oyo Hekalu yaye yarenge isiko y’omochie, akarenta chieri na ebisembe bi’ebisicha goika ase ebiita; ere amo n’abanto bakarigia korua ekeng’wanso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.13",
            "verseOrgIds": [
              "ACT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abatomwa Barnaba na Paulo, ekero bachia koigwa amang’ana ayio bagatandora chianga chiabo, bakaayerera, bagasoa ase omoganda, bagaaka egeturi, bagoteeba,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.14",
            "verseOrgIds": [
              "ACT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abasacha! Nase ki mogokora aya? Intwe nigo tore Mwanyabaanto koreng’ana buna inwe. Twabarandeirie inwe amang’ana amaya, erinde motige chinyasae echi chia bosa, moonchokere Nyasae ore moyo, oyotongete igoro na ense, na enyancha, na ebinto ebire imeo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.15",
            "verseOrgIds": [
              "ACT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ase ebigori biaetire nigo atigete ebisaku bionsi bitaare ase chinchera chiabo abanyene,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.16",
            "verseOrgIds": [
              "ACT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende ere omonyene tetigete atari na kirori. Ere nigo are gokora amaya na kobaa embura korwa igoro, ne chingaki chi’erigesa, agaisanekia chinkoro chiaino nendagera na omogooko.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.17",
            "verseOrgIds": [
              "ACT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ase amang’ana aya bagatanga abanto baria bokong’u, tibaabaruseria ebing’wanso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Abayahudi korwa Antiokia na Ikonio bagaacha, na ekero bagenkire abanto bagaaka Paulo amagena, bakamokurura gochia isiko y’omochie, bagakaga ng’a okuure,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.19",
            "verseOrgIds": [
              "ACT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekero aborokigwa bamoetananire ase chinsemo chionsi, agatenena, agasoa omochie ime, ne rituko ria kabere riaye agasoka, akagenda Deribe amo na Barnaba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.20",
            "verseOrgIds": [
              "ACT.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoirana ase Antiokia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega kobarandirie amang’ana amaya ase omochie oria, na kobakorire abange koba aborokigwa, bakairana goika Listra, na Ikonio, na Antiokia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.21",
            "verseOrgIds": [
              "ACT.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabeeka emioyo yaborokigwa chinguru na kobaremia bagenderere ase okwegena, bakabateebia ng’a: “Netogwenerete gosoa ase oborwoti bwa Nyasae ase enchera y’emechando emenge.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.22",
            "verseOrgIds": [
              "ACT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio kobachorire abagaaka ase kera ekanisa ase ogosaba na okweng’ata, bakababeeka ase amaboko y’Omonene, oyio begenete.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagaeta gati ya Pisidia, bagasoa Pamfulia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.24",
            "verseOrgIds": [
              "ACT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na magega kobarandirie ring’ana ase Perga, bagatirimboka gochia Atalia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.25",
            "verseOrgIds": [
              "ACT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na korwa agwo bakairwa n’emeeri ase enyancha, bagaika Antiokia. Agwo nao babeekeretwe ase obuya bwa Nyasae ase emeremo eria banyarete goikerania.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.26",
            "verseOrgIds": [
              "ACT.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero bachia goika aroro bagasangereria ekanisa amo, bakaorokia amang’ana onsi Nyasae akorete nabarabwo, na buna aigoreire abanto b’Ebisaku egesieri gi’okwegena.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.27",
            "verseOrgIds": [
              "ACT.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba agwo amatuko atai make amo naborokigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.28",
            "verseOrgIds": [
              "ACT.14.28"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ACT.15",
