          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro biria bi’ogotamanya Nyasae nigo aombetie buna tarochi, korende bono nkoranderia are abanto bonsi ba kera aase baonchoke,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera obekire rituko eri agocha konachera abanto b’ense ekiina ase oboronge ase omonto oria aragete. Ase ayio oeire abanto bonsi ogosemeria ase okomobokia korwa ase abakuure.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
