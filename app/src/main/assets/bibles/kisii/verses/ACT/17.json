          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ekero bachia koigwa amang’ana ’okobokigwa kw’abakuure abande bagasekereria, na abande bagateeba: “Inatogotegerere naende ase amang’ana ayio.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
