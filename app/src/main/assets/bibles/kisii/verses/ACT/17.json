          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Paulo akaimoka akabatiga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
