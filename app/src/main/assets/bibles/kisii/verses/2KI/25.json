        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okogwa kwa Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(2 Amg 36:13-21; Yer 52:3b-11)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka o kianda, rituko ria ikomi ri’omotienyi o ikomi bw’okogaamba kwa Nebukadinesaro omorwoti o Babiloni, ere amo nabarwani baye bonsi b’esegi bagacha korwania Yerusalemu; bakayonaaria na bakaagacha orwaki rw’ogwekengera koyoetanana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo omochie oria okaba onaaririe goika omwaka o ikomi nomo bw’okogaamba gwa Zedekia omorwoti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko ria kianda ri’omotienyi o kane enchara ekaba enene mono ase omochie oria goika endagera ekabora kegima ase abanto b’aroro.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio chindwaki chi’omochie chikabochorwa, na abanto bonsi b’esegi bagatama botuko, bagaetera egeita kiarenge gatigati ye chindwaki ibere, ang’e nomogondo bw’omorwoti, nonya Abakalidayo banaaretie omochie chinsemo chionsi. Bakagenda gochia ase Ekerubo Ekiomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani esegi b’Abakalidayo bakabwatia Zedekia omorwoti, bakamoikeera agwo ase ense omweya ya Yeriko ekero abarwani baye bonsi b’esegi konya bamotigire baserebekanire.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio bakabwata omorwoti bakamoira ase omorwoti o Babiloni agwo Ribula, nere akamonachera ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagaita abana ba Zedekia agwo ase amaiso aye, erio bakamokonora amaiso, bakamosiba ne chingatare, bakamoira Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogosarigwa gwe Hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Yer 52:12-33)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko ria gatano na kabere ri’omotienyi o gatano ase omwaka o ikomi na kianda bw’okogaamba kwa Nebukadinesaro, omorwoti o Babiloni, Nebusaradani, oyorenge omoteneneri bw’abarendi na omosomba bw’omorwoti o Babiloni, agacha Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere agasamba enyomba y’Omonene na enyomba y’omorwoti, ne chinyomba chionsi chia Yerusalemu; agasamba kera enyomba enene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani esegi bonsi b’Abakalidayo, baria baarenge amo nomoteneneri oria bw’abarendi, bagatagora chindwaki chiaetanaine Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradani omoteneneri bw’abarendi, agoosa na koira abanto aba konya batigaire ase omochie, na bonsi aba konya berure ase oyogokorera omorwoti o Babiloni, akaira nabatigari bonsi b’omoganda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende omoteneneri oria bw’abarendi agatiga abanto bande baria baarenge abataka mono, b’ense eria babeereo, babe bagokora emeremo ase emegondo y’emesabibu na gokora emeremo y’okorema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakalidayo bakabuna chisiiro chi’etai chiria chiarenge ime ase enyomba y’Omonene, na ebibekerero bi’ebituba, na egetuba keria ekenene keroisirie korwa ase etai, ebiarenge ase enyomba y’Omonene, Kobabibunire, bikaba ebing’ese, bakaira chitaai chiria chionsi Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo bakaira chindogio, na ebichiko, na ebinachi, na ebitaabo bi’ogosambera ubani, na ebikorero bionsi bie chitaai biarenge gokorerwa emeremo ase Hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaira ne chindogio chi’okorenta omorero, amo ne chisani. Omoteneneri oria bw’abarendi akaira ebinto bionsi bie chitaabu na ebie chifeta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitaai chie chisiiro chiria ibere, na echi’egetuba keria ekenene, na echi’ebibekerero biria bi’ebituba, ebinto ebio bionsi Sulemani aroisetie ase enyomba y’Omonene, tibiarenge korengeka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obotambe bw’esiiro eyemo nigo bwarenge obw’amaboko ikomi na atano na atato, na igoro ase esiiro egesure gi’etai nkiarengeo; obotambe gochia igoro bw’egesure keria nigo bwarenge obw’amaboko atato. Egechanga na emegwekano y’amakomomanga biaetanaine egesure keria. Bionsi nigo biaroisirie korwa ase chitaai. Esiiro ya kabere nigo yarenge egwekaine eria entang’ani, yaetananirie nebichanga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abayuda bakong’anyigwa gochia Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Yer 52:24-27)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoteneneri oria bw’abarendi akaira Seraya, Omokuani omonene, na Sefania, Omokuani o kabere, na abarendi b’egesieri batato.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende akaira korwa ase omochie oria omonto oyomo orenge omoteneneri bw’abasikari, na abanto batano b’ekegambero ki’omorwoti abanyoretwe ase omochie ime; na omoriki bw’abasikari, oria orenge gokora omobaro bw’abaanto b’ense eria amo nabaanto emerongo etano nomo b’ense eria abanyorekanete ase omochie ime.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradani, omoteneneri bw’abarendi, akababwata, akabaira ase omorwoti o Babiloni agwo Ribula.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti o Babiloni akabaitera aroro agwo Ribula, ase ense ya Hamati, bagakwerao.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Igo Abayuda bakarusigwa ase ense yabo bakairwa ase obosomba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Gedalia omogambi bw’Abayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Yer 40:7—41:1)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinesaro, omorwoti o Babiloni, akabeeka Gedalia, mosinto bw’Ahikamu o Safani, omogabana bw’abaanto batigarete ase ense y’Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abatang’ani bonsi b’abasikari, amo nabaanto babo, baigwete ng’a omorwoti o Babiloni ochorire Gedalia agambere ense eria, bakagenda asare agwo Misipa. Abagendeteo nabwo aba: Isumaeli, mosinto o Netania, na Yohanani, mosinto o Karea, na Seraya, mosinto o Tanahumeti korwa Netofa, na Yasania, omomura bw’omonto o Maaka, amo nabaanto baye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedalia agatiana ase abateneneri baria amo nabaanto akabateebia: “Timoiroka ase engencho y’abatang’ani b’Abakalidayo; menya ase ense eye, mokorere omorwoti o Babiloni, na amang’ana nabo arabe amaya ase more.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ase omotienyi o gatano na kabere Isumaeli, mosinto o Netania, bw’Elisama bw’enyomba y’omorwoti, agacha amo nabaanto ikomi, agaaka Gedalia, akamoita. Boigo agaita Abayuda na Abakalidayo baria baarenge amo nere agwo Misipa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio abanto bonsi, abake na abanene, amo nabatang’ani b’abasikari bakaimoka, bagatama gochia Misiri, ekiagera bairogete Abakalidayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omorwoti Yehoyakini ogosiborwa korwa ase echela",
          "type": "text"
        }
