    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase omwaka oria Ewili‐Merodaki, omorwoti o Babiloni, achagete kogamba akaba namaabera ase Yehoyakini, omorwoti bw’Abayuda, akamosibora korwa ase echela. Ayio nigo akoregete ase rituko ri’emerongo ebere na gatano, omotienyi o ikomi na kabere, ase omwaka bw’emerongo etato, na gatano na kabere magega Yehoyakini omorwoti bw’Abayuda goosirwe,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewili‐Merodaki agakwana amang’ana ’obwororo nere, naende akamoa amasikani amanene kobua ayio aete abarwoti bande baarenge amo nere agwo Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo Yehoyakini akaonchoreria chianga chiaye chi’obosibwa, na kera rituko ase obogima bwaye bwonsi akaba okoragera nomorwoti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omorwoti akamoa endagera yaye, na kera egento kiaganeirie ase kera rituko ase obogima bwaye bwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
          }
        }
      ]
