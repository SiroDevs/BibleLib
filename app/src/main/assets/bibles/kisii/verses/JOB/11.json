{
  "id": "JOB.11",
  "number": "11",
  "bookId": "JOB",
  "reference": "Ayubu 11",
  "copyright": "© 2021 KENBS",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JOB 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Sofari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Sofari Omonaama agakwana, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.1",
            "verseOrgIds": [
              "JOB.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Amang’ana aya amange natigwe tairanerigwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na omonto obwate amang’ana amange buna iga nabarerwe oboronge?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Amang’ana ao atari nengencho nagere abanto bakire‐kiri?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na ekero ogokwana amang’ana ay’ogochecheria, monto onde takogosookia?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo ogoteeba ng’a amang’ana ogokwana nay’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ng’a nigo ochenegete ase amaiso a Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende onye ndiria Nyasae are gokwana",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na akoorokie buna ore,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde akomaanorere orore obobisi bw’obong’aini!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere nigo abwate obomanyi botari korengeka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio manya ng’a nigo akoeire egesusuro egeke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tari buna okomocha kwao kogwenerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nonyare komanya ebinto bia Nyasae bibisekanete?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nonyare komanya oboikeranu bw’Omonguru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye bore obonene gochia igoro, inki oranyare gokora?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onye bore obotambe inse gochia aase abakuure, inki oranyare komanya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obotambe bwaye nigo boetanetie obw’ense,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obogare bwaye mboetanetie obw’enyancha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaete asibe abanto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose kobagambia, ning’o oramotange?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo amanyete abanto batagwenereti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero akorora amabe agokorwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee, takorengereria igoro y’ayio?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye omoriri okonyara koba omong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rirorio emori y’etigere y’orosana nenyare koiborwa ebe omonto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oise kwebeeka ang’e ase enkoro yao gokora amaronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na orambore amaboko ao gochia ase Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye kogotuguta ebibe bire ase amaboko ao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na togotiga obobe bomenye ase eema yao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaene, rirorio norigererie otari na komocha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende norendwe buya tokoba nobwoba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo orebe emechando yao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna amaache aetire, takoinyorwa naende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na obogima bwao nigo borarabe se kobua erioba ria mobaso gati;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omosunte oye nigo oraonchoke obe buna ekero bogokia mambia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nomenye kore noboremu, ekiagera ogosemeria nkoreo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
              "JOB.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "norendwe na gotimoka ase obotoereru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
              "JOB.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero okorara, monto onde tagokwoboyia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.19",
            "verseOrgIds": [
              "JOB.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
