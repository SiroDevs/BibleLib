        "sid": "JOB 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubu akagenderera gokwana emerabaaro yaye akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.1",
            "verseOrgIds": [
              "JOB.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, buna Nyasae are moyo, oyo ong’urire ebiantungetie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna Omonguru aeire omoyo one obororo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende omoika bw’obomoyo ogendererete koba ime yane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoika o Nyasae ore ase chimioro chiane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omonwa one togokwana aya atari a boronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose oromeme rwane ay’obong’ainereria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abe aare korwa ase ’nde kobabara ng’a nabanyaboronge more;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika ogokwa kwane ningenderere goteeba ng’a tindi nokomocha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbwaterere bokong’u oboronge bwane, tinkobotiga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "enkoro yane tekongambia ase amatuko ande inde moyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga omobisa one abarwe buna omokori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oyore mamincha yane buna oyotari omonyaboronge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosemeria ki omonto otamoirogeti Nyasae abwate, ekero arakwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero Nyasae aramoure obogima bwaye?.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee, ekero emechando eramochere Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namoigwe gose?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio nagokigwe ase Omobui?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nabe okorangeria Nyasae ase chingaki chionsi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimborokererie igoro y’okobua kwa Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amang’ana onsi igoro y’Omonguru tinkoyabisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, inwe mwensi mweroreire ayio;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono, nase ki rende mogokwana amang’ana abosa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekio nakio egetari Nyasae akoa omokori amabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omwando Omobui akoa abwo bagochanda abanto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana b’omokori amabe nabaisa komentekana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bareo ase ogocha goitwa n’omoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto b’ororeria rwaye tibakonyora endagera eisaine.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatigari baye nigo oborwaire borabaite,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abakungu baratigwe bare ababoraka, tibakonyara kobareera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio naisa gosangereria chifeta chinyinge buna orotu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende atumbe chianga chibe chinyinge mono;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nonya ochitumbire igo, nomonto omooronge orachibeeke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abatari na komocha baatanane chifeta chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyomba omonto oyio araagache nigo erabe buna ey’oronyambobe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna ekegutu omorendi akoagacha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio nigo akogenda korara ore omonda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende takoba bo rinde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero akoramokia amaiso kabokire anyore obotenenku bwaye bwasirire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
