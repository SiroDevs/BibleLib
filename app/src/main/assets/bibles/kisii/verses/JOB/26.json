  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "JOB 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Ayubu akairaneria, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.1",
            "verseOrgIds": [
              "JOB.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naki ere buya aye gwakonyire omonto otari nokobua!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, aye gwatooririe omonto omoreu otari ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki ere buya gwasemirie omonto otari nobong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gwakwanire amang’ana aichire ne chisemi chingiya!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase chinguru chia ng’o gwakwanire amang’ana buna aya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na ngoetera ase omoika o ng’o kwayakwanire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Emeika y’abanto bakwete nigo ekoiguswa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo namaache na ebimenyete imeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aase abakuure nigo aasie ase obosio bwa Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, aase agwo ogosiria tabwati kemumeko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo aramborete ensemo ya sugusu aase arenge bosa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo asungete ense aase bosa etabwateti aande.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo aochoganetie amaache amo, akayaboerania amare amanetu ime;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amare ayio tari gotandoka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo atubete ekerogo kiaye ki’obonene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akagetuba namare aye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ong’ororirie ekeringerera kere orobebe rw’amaache",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ogwatanana oborabu korwa ase omosunte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisiiro chia igoro nigo chigotengecha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chiakumia ase ogotogonyera kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere ase okobua kwaye nigo agoturubania enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase chisemi chiaye akanachana Rahabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        },
        {
          "text": "eng’iti enene y’enyancha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo akoeyana, na omoika oye omechiera igoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo aitete nokoboko kwaye engiti eria yare gotama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Echi nechinsinyo chie chinchera chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aya tokoigugwa nokomonyerera ogosinini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende ning’o oranyare komanya okobua kwaye konga buna enkoba egoaka.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOB.27",
    "number": "27",
