      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "yebisa na gokenderera ime ase ebitonto bire ase etente.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.21",
            "verseOrgIds": [
