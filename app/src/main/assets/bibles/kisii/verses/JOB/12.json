  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JOB 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Ayubu akairaneria, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.1",
            "verseOrgIds": [
              "JOB.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, inwe ninwe abanto bori,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero morakwe, obong’aini nigo borasire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende nainche nabo inde nokomanya buna inwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timombueti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o otamanyeti amang’ana buna ayio?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasani baane nigo bagonchecheria, inche oyo narenge korangeria Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ere akaba okong’iraneria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche omonyaboronge ntari na komocha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono nigo ngochecherigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto otari na mechando ende, nigo agochaaya emechando,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo are ang’e gotindachera inse abwo batererigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinka chi’abauri nigo chigendererete koba nomorembe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abwo bagechete Nyasae nigo barendire buya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enyasae yabo nigo ere ase amaboko abo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono boria ching’iti, nchikworokererie;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boria chinyoni chia igoro chigoteebie amang’ana;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gose kwana ne riroba, ndikworokererie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinswe chia nyancha, nchikoraarerie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o otamanyeti amang’ana aya onsi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a okoboko kw’Omonene nakwo gwakorire aya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obogima bwa kera egetongwa kere moyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoika o Mwanyabaanto, nigo bire ase okoboko kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Amang’ana ogoto gokoigwa, tikori koyateema",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna oromeme rokomena rwaigwa endagera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obong’aini nigo bore ase abanto abanene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okomenya emiaka emenge nakwo okomanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Nyasae nigo are nobong’aini na okobua,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nare nogosemia na obomanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere aise gotagora, onde tari oraagache naende;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aise gosiekera omonto, onde tari oramoigorere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aise gotanga amaache, ense igo erome pa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero akoyarenta nigo akoonchorana ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinguru na obong’aini nigo bikorwa asare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo bakong’aineka na abakong’ainereria nigo bare ase okoboko kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo akoombogania abare abasemia obatiga getirianda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.17",
            "verseOrgIds": [
              "JOB.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agokora abagaambi ebiina baba abariri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.17",
            "verseOrgIds": [
              "JOB.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo agosibora chinkini chi’abarwoti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.18",
            "verseOrgIds": [
              "JOB.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio obaboyia ebibarachi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.18",
            "verseOrgIds": [
              "JOB.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo akoombogania abakuani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.19",
            "verseOrgIds": [
              "JOB.12.19"
