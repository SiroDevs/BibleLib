{
  "id": "JOB.7",
  "number": "7",
  "bookId": "JOB",
  "reference": "Ayubu 7",
  "copyright": "© 2021 KENBS",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOB 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekero omonto are ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo abwate obogima buna obw’oyokorwana esegi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amatuko y’obogima bwaye nigo anga buna ay’omorikwa emeremo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana omosomba akogania anyore aase agokenderera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna koreng’ana omonto orikire emeremo akogania aegwe eng’eria yaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "naboigo nainche ngendererete koba nobobe omotienyi ase omotienyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obotuko ase obotuko nigo inde ase emechando.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nararire nigo nkobooria: Indi bogocha gokia mboke?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obotuko bwatambeire mono.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Agwo naba nkona‐kweonchaonchora bokia goika mambia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakonde ne riko biatubire omobere one;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omobere one nigo okona‐gosaboka amasabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio otandoka, na obogundo bwaruao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatuko ’obogima bwane nigo agoeta bwango kobua egekorero gi’okoroisia egetambaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akoera ntabwati gosemeria konde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Manya ng’a obogima bwane nigo bore buna embeo bosa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaiso aane takorora amaya naende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto ondoche bono takondora naende nonya ng’ake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono aye nondoche, korende bwango nimbe tindio.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana riire rigokubakubana riasira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo noyokogenda aase abakuure atakoirana korwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio takoirana gocha mwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aase aye taakomonyoora naende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, tinkonyara gokira tinkwana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbe ngokwana emechando y’omoyo one",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kwemurungania nobororo ase omoyo one.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nase ki obegete oborendi igoro yane?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche nenyancha inde, gose neng’iti enene mono ya nyancha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nkorengereria ng’a oborere bwane mbonyare kondemia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebirengererio biane mbinyare gonkeaneria obororo bwane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "erio aye nigo okongosa ase ogontomera chindoto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kong’a obwoba goetera ase amaroro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo nachorire ng’a ng’entwe inkwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera amakweri namaya kobua obororo bore ase omobere one.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagechire obogima bwane; tinganeti kogenderera koba moyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Takondosia namange; amatuko aane nigo are buna embeo bosa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Omonto ninki aisaine,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika okomokora koba oyo bw’engencho enene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende oba komorengereretie mono?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo okomorigereria kera emambia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nigo okomorenga kera engaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nengaki eng’ana naki ogochia koba gokona‐kondigereria?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.19",
            "verseOrgIds": [
              "JOB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naki otagontiga, erinde inyore obosibore imere amate?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.19",
            "verseOrgIds": [
              "JOB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omorigereria bw’abaanto, onye ngokora ebibe, ninki nagokoreire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.20",
            "verseOrgIds": [
              "JOB.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki gwankorire nabeire ekerenga kiao?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.20",
            "verseOrgIds": [
              "JOB.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki nabeire buna egurube endito asore?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.20",
            "verseOrgIds": [
              "JOB.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki otakonyabera ogosaria kwane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.21",
            "verseOrgIds": [
              "JOB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde otige ebibe biane kegima?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.21",
            "verseOrgIds": [
              "JOB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bono inche nkogenda inde korara ime ye riroba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.21",
            "verseOrgIds": [
              "JOB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nigo orabe gokondigia, korende tokonyora aande.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.21",
            "verseOrgIds": [
              "JOB.7.21"
            ]
          }
        }
      ]
    }
