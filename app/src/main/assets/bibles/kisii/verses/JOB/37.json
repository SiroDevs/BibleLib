  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "JOB 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ayio nigo akogera enkoro yane yaiguswa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "yatuma gocha ase omoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegerera oigwe okogukura kw’eriogi riaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okoruma gokorwa ase omonwa oye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo agotoma okoruma okwo korwa igoro gocha ase ense yonsi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okomesa kwaye gwe chinkoba nigo kogochera chinsinyo chi’ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio eriogi riaye rikoruma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo akogukura neriogi ri’obonene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tari gotanga okomesa ekero eriogi riaye ri’okogukura riaigurwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo akogukura neriogi riaye ase enchera y’ogokumia mono,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agokora amang’ana amanene, ayio totanyare komanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agoteebia amagena ’embura: Kagwe igoro ase ense;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na otoma omonyirira na embura enene ere ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo agotanga emeremo y’amaboko a kera omonto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde abanto bonsi banyare komanya emeremo yaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ching’iti chi’orosana chiagenda kwebisa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chiagenderera kobeera ase amakuruma abo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekembugu‐mbugu nigo kegosoka korwa ase chiero chiaye agwo Irianyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omwaga ore nobokendu orua sugusu oseria amare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo akorua omoika bw’obokeng’entu obwatania amaache,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaache oyarenta abwatana oma pa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo agoichoria amare amarito namaache,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amare nigo agosiarera chinkoba chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amare nigo agoetanana gochia aaria na aaria, akoraagwa nere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goikerania aya onsi ere achiikire akore ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo agokora ayio aba bo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase okorua ebisusuro bi’okorongeyia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ase engencho y’obwanchani bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Ayubu, igwa aya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "karategerera, orengererie igoro y’emeremo y’ogokumia ya Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nomanyete buna Nyasae agokora ochika ayio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende buna agokora okomesa kwamoreka goetera ase amare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nomanyete buna areng’anetie amare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eyio ere emeremo y’ogokumia y’oria ore nobong’aini oboikeranu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nomanyete egekogera chianga chiao chigosamba ne riberera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero ense egotoererigwa nomwaga okogusa korwa Irianyi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nonyare korambora igoro buna ere ayeramborete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.18",
            "verseOrgIds": [
              "JOB.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igoro eria ere enkong’u buna ekerore gi’ekioma?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.18",
            "verseOrgIds": [
              "JOB.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tworokererie aya togochia gokwana asare;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "titokonyara konyora amang’ana togochia gokwana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera tore ase omosunte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nyasae nigo agochia goteebigwa ng’a inche ninganetie gokwana?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onde nare oganetie ere amosirie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abanto tibakonyara korigereria amasase ’erioba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kabarire igoro ekero amare abisirwe nomwaga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborabu bokomeka‐meka nigo bokorwa sugusu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, Nyasae nigo eboetie nobonene bw’ogosikwa gw’okoondokia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio Omobui, intwe titokonyara komoorora buna are;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo abwate okobua okonene, naende nigo are omonyene ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo are omonyene oboronge mono, takorega onde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio Mwanyabaanto nigo bamoirogete;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.24",
            "verseOrgIds": [
              "JOB.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere tari gosika oyokwerengereria ng’a nomong’aini are.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.24",
            "verseOrgIds": [
              "JOB.37.24"
            ]
          }
        }
      ]
    }
