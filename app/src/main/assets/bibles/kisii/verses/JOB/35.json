  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "JOB 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu akagenderera gokwana, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.1",
            "verseOrgIds": [
              "JOB.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Ayubu, nigo okorengereria ng’a ayio nekeene?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose nigo ogoteeba ng’a nomonyaboronge ore ase obosio bwa Nyasae?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende nigo okoboria ng’a mbuya ki oboronge bokogokorera",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kobua ogokora ebibe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ngokoiraneria nde aye amo nabasani bao abamore komo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rigereria gochia igoro, orore;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rora amare buna are igoro mono kogoetania.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye noisa gokora ebibe, ninki ayio arakore ase Nyasae?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na ogosaria nagoisa komentekana mono, ninki okwo koramokorere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kore omonyene oboronge, ngento ki okoa Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ninki akonyora korwa ase okoboko kwao?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabe ao ogokora nigo akorenta emechando ase omonto onde onga buna aye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oboronge bwao nabo boragere omonto onde anyore ayare amaya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera ogokorerwa bobe kwabuchire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto nigo bakorera mono ng’a bakonywe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakorangeria bakonywe korwa ase amaboko ay’abare nokobua.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende monto onde tari okobooria:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ng’ai Nyasae, oria ontongete, are,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio okogera amatera ay’ogotogia aterwa botuko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agotworokereria kobua ching’iti chi’ense,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na otokora twaba nobong’aini kobua chinyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bakorera, korende Nyasae tari koiraneria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’ogokora okobe kw’oboenenu kwa’ banyabibe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, Nyasae tari koigwa okorera gotari ogw’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ere Omonguru takogwechandera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nonya kogoteeba ng’a tori komoorora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere tagokoigwa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiina kiao nigo kere ase obosio bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono nigo omoganyete nogosemeria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende bono nigo okorengereria ng’a Nyasae tari korua egesusuro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’endamwamu yaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ng’a ere tari gwechandera ogosaria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio naro akogera aye Ayubu ogokwana amang’ana atari nengencho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okomenta gokwana amang’ana atari ay’obong’aini.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    }
  ],
  "next": {
