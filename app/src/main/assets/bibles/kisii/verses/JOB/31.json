{
  "id": "JOB.31",
  "number": "31",
  "bookId": "JOB",
  "reference": "Ayubu 31",
  "copyright": "© 2021 KENBS",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "JOB 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nakorire okobwatana kw’ogotianania namaiso aane",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a tinkorigereria omoiseke omwekungi ase okomogania.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki rende egetari kiane gekorwa ase Nyasae o igoro kerabe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na omwando one okorwa ase Omobui ore igoro, naki orabe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Emechando teri konyora abatari abanyaboronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogosirigwa gwachera abagokora ebibe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nyasae tarochi chinchera chiane chionsi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobara amatambokero aane onsi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nabeire ngotaara ase chinchera chi’obong’ainereria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose amagoro aane naminyokeire ay’oborimo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga ndengwe ase ekerengo ekeronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Nyasae amanye oboikeranu bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nagobeire korwa ase enchera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enkoro yane yabeire ekobwatia okogania kw’amaiso aane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onye komocha konde kwabwatereire amaboko aane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "rirorio inche nsimeke endagera, na omonto omoao ayeire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kende gionsi kiane keramere gesimorwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye omoyo one obeire okoebererigwa na gwancha omokungu omoao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igo nabeire nkoboera omonto onde ase egesieri kiaye imosirie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "rirorio tiga omokungu one abe ogoseera omonto omoao obosie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende abasacha bande babe bakoba nere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwo nigo kware koba ogosaria okobe mono goetania,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kware koegwa egesusuro nabagaambi ebiina bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boigo nigo kware koba omorero ogosamba gochia aase ay’ogosiria",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koria ebinto biane bionsi kobikoora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inse kwanga koroisia amang’ana omosomba one, omosacha gose omokungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero baremurunganie igoro yane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninki ndakore ekero Nyasae aranyimokere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninki ndamoiranerie ekero arabe okorua egesusuro ki’ebibe biane?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Oyio ontongete ase enda ya baba, tari ere otongete oyio boigo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tari ere oyomo otobombete ase enda ime?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche tinarinete omotaka egento aganetie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tinatigete omoboraka kwerusia moyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinarenge koria endagera yane inche bweka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo naete nentakana nero, ekayeria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio inche nabeete ise korwa obosae bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa okoiborwa kwaye nkaba nkomorera na komoraa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Monto onde nare ochandegete ase okoborwa chianga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose omotaka otabwati ekiebisio, ntakonyete?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bansesenetie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nabaete chingobo chi’amarionya e ching’ondi chikorwa ase amaicho aane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nakorerete entakana bobe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera namanyete ng’a ekegambero agwo ase egeita ngenkonye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "rirorio tiga amareko aane ongoke agwe inse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinengo chi’amaboko aane chisomoke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nare gocha kwoboigwa nemechando korwa ase Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na tinare konyara gotenena bosio bw’obonene bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinasemeretie etaabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya netaabu echenire;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinagokerete gose gochengera obotenenku bwane obonge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ebinto nenyorerete namaboko aane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinarigereretie erioba ekero riabarete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose omotienyi ekero omesete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika enkoro yane ekaebererigwa bobisi ase okobisasiima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tinanyunyuntete okoboko kwane ase okobisika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nakorete ayio nigo nare koegwa egesusuro nabagaambi ebiina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ayio nokomokana Nyasae ore igoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nagokerete ogosirigwa kw’omobisa one?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose netogetie ekero amabe amocherete?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaya, tinatigete omonwa one okore ebibe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase okomoragereria na komoganeria amakweri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bonsi bamenyete aa bwone babeire birori ng’a",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.31",
            "verseOrgIds": [
              "JOB.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kera omonto obeire oisanegete nendagera nkomoa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.31",
            "verseOrgIds": [
              "JOB.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo narenge koigorera abaeti ebisieri biane basoa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose motaari onde tabeete okorara isiko botuko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinatubete ogosaria kwane buna engencho ya Mwanyabaanto ere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ebibe biane ase egekuba kiane ime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinairogete omoganda omonene bw’abaanto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose kwoboa abaamate abwo barenge gonchaya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde imbe nkirete na kobeera nyomba ime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naki yare koba buya onye nanyora omonto okonyigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche nakoorire amang’ana aane!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oria Omonguru nang’iranerie!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninganetie ndore amang’ana omobisa one andikerete ase okonyomania.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOB 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, nigo nare koyabogoria igoro ase amareko aane;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.36",
            "verseOrgIds": [
              "JOB.31.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nanga nigo nayesiberania abe buna egutwa ase ’nde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.36",
            "verseOrgIds": [
              "JOB.31.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOB 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanga namoteebia igoro y’orogendo rwane rwonsi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.37",
            "verseOrgIds": [
              "JOB.31.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nare komochiera inde buna omogambi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.37",
            "verseOrgIds": [
              "JOB.31.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOB 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Oboremo bwane bwanakondeera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.38",
            "verseOrgIds": [
              "JOB.31.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose emeng’ororia ye chintinde yana‐korererana?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.38",
            "verseOrgIds": [
              "JOB.31.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOB 31:39"
          },
          "items": [
