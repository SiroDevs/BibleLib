{
  "id": "JOB.39",
  "number": "39",
  "bookId": "JOB",
  "reference": "Ayubu 39",
  "copyright": "© 2021 KENBS",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "JOB 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nomanyete chingaki ekero chimbori chi’orosana chikobiara?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose ekero chinsune chikobiara?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonyare komanya omobaro bw’emetienyi chigokoora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nomanyete chingaki chikobiara?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo chigwekumba chiabiara chimanwa chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero chiabiarire, obororo bw’okobina bwasira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimanwa chiabo nigo chikoba ne chinguru chiakinera ase orosana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo chikogenda kegima, tichiri koirana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ning’o otigire etigere y’orosana esiboire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose ning’o bwororobirie ebisibo bi’etigere ere enyango?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nayeeire ekerubo ekiomo kebe enka yaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense ere nomonyo, emenyeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ero nigo egochaaya eriogi rire ase omochie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "teri koigwa okwoga kw’omotemi onde bwensi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ekona‐kogenda aaria na aaria ase ebitunwa ekorisia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "yaba ekorigia kera ekemeri ekebese.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Eng’era nayanche egokorere emeremo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nenyare korara ase obweri bwao botuko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nonyare koyesiba ne chingori eete ase emeng’ororia ye chintinde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose ebutorane chintinde ase rikura riao?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Noyesemerie ekiagera ere ne chinguru chinyinge?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nonyare gotiga emeremo yao, ng’a ero ekoyekorere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nigo oyiegenete ng’a neirane",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekorentere endagera ase ekeoreri kiao?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Esagero nigo egosamunsa chimbaaba chiaye chioga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende, Inee, chimbaaba echio nchibwate obwanchani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esagero eaberi nigo egotiga amagena aye ase amaroba ime",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "anyora riberera korwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ero nigo ekoyeba, tekomanya ng’a naatwe namagoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ng’a gose eng’iti y’orosana neyatache.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ere entindi mono ase ebichuchu biaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "yabikorera biaba buna mbitari ebiaye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "teri gwechandera oroiboro rwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekiagera Nyasae nigo ayerinete obong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tayeete okomanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ekoimokerera igoro, egwesamunsa eminyoke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo egosekerera ebarasi na oyo oyerinete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Naye okoa ebarasi chinguru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naye oboetie ebigoti biaye namanya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye oyeete chinguru egocharokera buna engige?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.20",
            "verseOrgIds": [
              "JOB.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Eriogi egochuria nigo rire ri’okoirokia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.20",
            "verseOrgIds": [
              "JOB.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo egokura‐kura riroba ase ense omweya, yagokera chinguru chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.21",
            "verseOrgIds": [
              "JOB.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erio yaminyoka koumerana nabare nebirwanero bi’esegi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.21",
            "verseOrgIds": [
              "JOB.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ero nigo egosekerera obwoba, teri koondokigwa na kende;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.22",
            "verseOrgIds": [
              "JOB.39.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose teri koonchoka etame korwa ase emioro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.22",
            "verseOrgIds": [
              "JOB.39.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinsara nigo chikorutwa chiaba chikwoga goeta igoro yaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.23",
            "verseOrgIds": [
              "JOB.39.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amatimo akomesa, ne chisimisi boigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.23",
            "verseOrgIds": [
              "JOB.39.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo egotitiria riroba ere nobotindi na ekeririanda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.24",
            "verseOrgIds": [
              "JOB.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose teri gotegerera ekire, ekero egetureri gekobugigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.24",
            "verseOrgIds": [
              "JOB.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero egetureeri gekobugigwa, nigo ekwana eriogi riaye ri’okoega‐ega.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo ekoigwa omonyonko bw’esegi korwa aare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna abachiki b’esegi bagochika, na okwoga gw’esegi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nobong’aini bwao bokogera ekebaki kiairuruka igoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.26",
            "verseOrgIds": [
              "JOB.39.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende kiarambora chimbaaba chiaye koiruruka gochia Irianyi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.26",
            "verseOrgIds": [
              "JOB.39.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Naye ogochika ekeongo kiairuruka gochia igoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.27",
            "verseOrgIds": [
              "JOB.39.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kiaagacha egeswa kiaye aase a igoro mono?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.27",
            "verseOrgIds": [
              "JOB.39.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeongo nigo gekomenya ase egetare;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.28",
            "verseOrgIds": [
              "JOB.39.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase omwenya bw’egetare, aase gekonyora oborendi obuya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.28",
            "verseOrgIds": [
              "JOB.39.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa aaria igoro nigo kegotengera ebi kegotwara,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.29",
            "verseOrgIds": [
              "JOB.39.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaiso aye nigo akobirora korwa aare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.29",
            "verseOrgIds": [
              "JOB.39.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 39:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amage aye nigo akonywa amanyinga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.30",
            "verseOrgIds": [
              "JOB.39.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aase emebere ekwete ere, nao ekeongo kere.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.30",
            "verseOrgIds": [
              "JOB.39.30"
            ]
          }
        }
      ]
    }
  ],
