  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JOB 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Bilidadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilidadi Omosua akairaneria, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.1",
            "verseOrgIds": [
              "JOB.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Ngoika ririri ogochia korigia amang’ana agokwanwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Yarengererie, magega yaye naintwe tokwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki tokobarwa koba buna ching’iti?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki tokobarwa koba abanto batamanyeti gento kende?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Aye nigo ogwetandora ase engencho y’endamwamu yao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ense nigo egochia gotigwa bosa ase engencho yao?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose egetare ngetigerigwe korwa aase aye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amaene, omobaso bw’omokori amabe norime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose amasase aye takobara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborabu bore ase obomenyo bwaye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo borabe omosunte,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na etaya yaye ere asare nerimigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatambokero aye are ne chinguru nakeeigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na emeroberio yaye emoiyerie inse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagoro aye nabwatwe nomotego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abe ogotaara ase egati ye chiirima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omotego nomobwate ase egetingiro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoeto nomobwate omong’userere bokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engori y’ogotegerwa nebiswe ase riroba ase agotacha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omotego otegwe ase enchera agoeta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabe okogoswa na kwoboigwa korwa ase chinsemo chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkomoseria atame namagoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchara nemorie goika chinguru chiaye chiere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na emechando nemobeere ang’e komoiyeria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborwaire mbokoore risankwa ri’omobere oye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oborwaire obotang’ani bw’amakweri mbogundie ebiimo biaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nataboranwe ne chinguru korwa ase obomenyo konya asemeretie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio airwe ase omorwoti bw’okwoboyia okonge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enka yaye nebe bosa abanto abaao mbabe bakomenya aroro;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amagena omorero nasiarerwe ase enka yaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeri yaye ’nyome inse ye riroba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinsagia chiaye nachisusane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio takoinyorwa ase ense nonya ng’ake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose nonya nerieta riaye tirikogenderera koinyorwa agwo ase enchera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere narusigwe korwa ase oborabu arutwe gochia ase omosunte;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende aserigwe korwa ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takoba nomwana gose abanto b’ororeria rwaye ase egati y’abanto bamwabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.19",
            "verseOrgIds": [
              "JOB.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose monto onde oye tagotigara ore moyo agwo ase amenyete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.19",
            "verseOrgIds": [
              "JOB.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
