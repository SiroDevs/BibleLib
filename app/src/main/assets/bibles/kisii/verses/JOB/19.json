        "number": "19",
        "style": "c",
        "sid": "JOB 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Ayubu akairaneria, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.1",
            "verseOrgIds": [
              "JOB.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Ngoika ririri morabe mokogechia omoyo one",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na mogonsenyenta namang’ana aino?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwabeire mogonchecheria ara ikomi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Timori korora obosooku gonkorera bobe iga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, nonya ekeene nakorire okomocha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okomocha okwo nokwane inche omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe onye mogwetogia ng’a nabaya more kombua",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kong’enekeria igo kobwatekana nogochaywa kwane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "rirorio momanye ng’a Nyasae orentire amabe aya ase ’nde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ontegire noboreba bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, nigo nkorera mono ngoteeba: Nakoreirwe bobe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende tindi koiranerigwa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nkorangeria neriogi rinene ng’a nkonywe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ekeene, oboronge tibori gokorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae oagachire orwaki aase ngoeta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obeekire omosunte ase ebinchera ngoeta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ong’urire obonene bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Orusirie egutwa korwa ase omotwe one.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase chinsemo chionsi ong’iyeirie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono inche nasirigwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "osimoire ogosemeria kwane buna omote ogosimorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obeire nekeririanda ekenene ase ’nde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ombarire ng’a nomobisa oye inde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiombe bi’abarwani baye b’esegi nigo bigocha bire amo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "biabekire eburi ase ngoetera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "biatoorire biang’etananire ase chinsemo chionsi chi’Obomenyo bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyasae ogerire abaminto bantigire, bambeereire aare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto twamanyaine bantigire, babeire buna tibamanyeti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto baminto bantigire, na abasani twanchaine mono banyebire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abageni bamenyete mwane banyebire;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abasomba baane abaiseke bambarire buna omoeti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabeire omomenyi ase amaiso abo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nkorangeria omosomba one, ere tari kong’itabera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "otatiga ekero namosoroire, nario rioka agocha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoika okorwa ase omonwa one nigo ogotiokera omokungu one bobe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo inde okogechia ase abamura baminto torwete enda eyemo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya n’abana abake banchayire;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero ngotenena nigo bagonkwana bobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasani abagisangio banyinyerire na kogechigwa nainche;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabwo nanchete bang’onchokeire na gonkora bobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amauga ’omobere one atongononire ase risankwa ne chinyama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "natigeirwe egesabo getubete amaino gioka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abasani baane, ndorera amabeebe, ndorera amabeebe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.21",
            "verseOrgIds": [
              "JOB.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera okoboko kwa Nyasae kwang’akire!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.21",
            "verseOrgIds": [
              "JOB.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki nainwe mogonchanda buna Nyasae anchandire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Timoisanegeti ase ogonchanda omobere one?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naki yare koba buya onye amang’ana aane narikwa bono!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Yare koba buya arikwe ase egetabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ee, arikwe nekaramu eroisirie korwa ase risasi, ekioma egekong’u,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amang’erwe ase egetare abeo kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende nimanyete ng’a Omobooria one moyo are,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omoerio nigo aratenene igoro ye riroba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma risankwa ri’omobere one korirabe riasarekire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio nindore Nyasae ’nde ase omobere one.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwerorere inche omonyene;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaiso aane namorigererie, ayane, tari ay’omonto omoao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Nimoganetie mono ase enkoro yane ime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moise goteeba: Nase nchera ki tokomochanda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo mokorengereria ng’a ninche nagerire amabe onsi anyorire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe iroka ogoitwa n’omoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera oyore nekeririanda nigo akoegwa egesusuro ki’ogoitwa nemioro;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio monyare komanya ng’a okogambigwa nkoreo.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
    }
