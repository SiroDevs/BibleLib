          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya naboigo Nyasae ase okobua kwaye nigo akoa omokori amabe chinguru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero erusirie moyo, nigo agotenena naende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
