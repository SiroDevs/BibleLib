    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende aorokie ng’a amang’ana nakwanire nigo are bosa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
