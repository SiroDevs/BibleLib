          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye amang’ana ayio tari bo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ning’o oranyare kong’enekia ng’a nomorimo inde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
