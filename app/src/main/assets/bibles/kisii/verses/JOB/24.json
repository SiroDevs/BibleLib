          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Nyasae akomorenda buya na komokonya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na nigo akoba origereretie mono chinchera chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engaki enke nabo abakori amabe bagokinigwa, erio bwango basirigwa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakogwa inse, bakwa buna abande,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "babutorwa buna ebigara bikobutorwa ekero bikogeswa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
