  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "JOB 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki Omonguru atabegeti chingaki chi’ekina?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naende nase ki baria bamwanchete batararora rituko riria riaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bagotigeria chimbebe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baira amaicho e chitugo nechinguru, bachia koyarisia aba ayabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barobwo nigo bakoira chitigere chie chintakana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baira chiombe chi’ababoraka koba intenenera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bagotwoma abaremeire korwa inchera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagera abataka bonsi b’ense eyio bachia kwebisa amo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, abataka abwo babeire buna chitigere chi’orosana chire ase erooro;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagokora emeremo emekong’u ase okonyora ebi bakoria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ekerubo ekiomo nao bakorigeria abana babo endagera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bakogesera omonto onde chindagera chi’echitugo chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende basangereria amasabibu agotigwa ase omogondo bw’omokori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bakorara gesobono ase obotuko bwonsi, batabwati eki bakwebisia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tibabwati eki bakobeeka ekero ki’embeo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emebere yabo nigo enyiete nembura egotwa ase ebitunwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio bamigererania ase chingako chi’ebitare koigama aroro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abande nigo bagotaboria chintakana korwa ase chimbeere chi’abang’ina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na baira abana ebing’werere b’abataka babe intenenera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abataka baria bakona‐koong’anya bare getirianda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakobogoria emesaima bare nenchara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bakomita amaguta ’amazeituni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo edivai korende nonya naboigo nigo bare nerang’o.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bachandegete ase omochie nigo bakweumia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto baakire chingoma nigo bakorera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya naboigo Nyasae tari gotegerera ogosaba kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bande bangire oborabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya ne chinchera chi’oborabu tibachimanyeti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tibari kobwatia chinchera chi’oborabu obwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoiti nigo akoboka mambia chuni ng’a",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aite abataka na abachandegete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase obotuko emeremo yaye neyoboibi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriso ri’omotomani nigo rikoganya kobwairire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere oteeba: Onde tari ondoche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio otuba obosio bwaye bwekona.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omosunte gosoire, abaibi nigo bakobochora chinyomba basoa ime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo mobaso nigo bagwesiekerera bebisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibamanyeti oborabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omosunte ekerima nigo onga buna emambia ase bare;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "barabwo nigo bare abasani b’okwoboyia kw’omosunte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe nigo mogoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omokori amabe nigo akoirwa bwango ne chiooro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na egetari kiaye ase ense eye nigo keragereirie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere takonyara koirana ase emegondo yaye y’emesabibu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna koreng’ana egurugura ne riberera bigokoora amaache ’amagena ’embura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo nabaanto bakorire ebibe barairwe gochia aase abakuure.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinda chi’abaiborete nchibange pi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amakonde nabarie baere, tibakoinyorwa nonya ng’ake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "igo oyogokora amabe nabunwe buna omote.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omokori amabe nigo akoibera omokungu omogomba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tari gokorera omoboraka amaya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
