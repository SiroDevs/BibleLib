            "sid": "JOB 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto nigo agosira oruao buna egento ekegundo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna eanga yarirwe nebigwankwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
