          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera gwanchikeire amang’ana ’obororo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.26",
            "verseOrgIds": [
              "JOB.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende kwang’akanire amabe ’obosae bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.26",
            "verseOrgIds": [
              "JOB.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
