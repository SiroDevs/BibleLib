  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Amang’ana aya onsi nayarorire neriso riane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nayaigure nogoto kwane, nayamanyire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya momanyete, nainche ninyamanyete;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe timombueti kende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende nigo nganetie nkwane n’Omonguru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbeke amang’ana aane ase Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde ng’amereranie nere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende inwe nabatongi oborimo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe mwensi nabarwaria bare bosa, motari kogwenia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ndiria mware gokira‐kiri!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Okwo nanga nigo kwaba obong’aini bwaino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono tegerera moigwe amang’ana ngwekwanera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende tegerera moigwe ogosorora gokorwa ase omonwa one.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Inwe nigo mokorwanerera Nyasae ase ogokwana oborimo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naende mokomorwanerera ase obong’ainereria?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Inwe nigo more nogwanchereria asare?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo moganetie korwanerera Nyasae ase ekegambero?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Amang’ana nabe amaya ase more Omonene karabarenge abamanye buna more?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose mokagete ng’a nigo moramong’aine buna abanto bakong’ainana?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene ere nabatogonyere Onye mogokora ogwanchereria bobisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Obonene bwaye tibokobaboyia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okogosa kwaye kobaondokie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emereng’anio y’obong’aini bwaino nigo ere bosa buna ribu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chiburi chiaino nigo chigiteire esike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe kira‐kiri, montige nkwane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kende gionsi kegochia konyora, tiga kenyore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki ndabeeke enyama y’omobere one ase amaino aane?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ting’egerereti obogima bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene naisa kong’ita, ningenderere komosemeria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nabo goika ndete amang’ana aane ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayio nabe ogotooreka kwane",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a omonto otamoirogeti Nyasae tagocha ase obosio bwaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegerera onyigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga ogotebereria kwane gosoe ase amato aino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, naroisirie amang’ana aane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namanyire ng’a nimbarerwe oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oreo ogochia koamererania nainche?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onye oreo, rirorio inche nigo ndakire‐kiri inkwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono nigo ngokoboria onkorere ebinto bibere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nario ntebise korwa ase obosio bwao:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusia okoboko kwao korwa ase ’nde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okogosa kwao tikogenderera konyoboyia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio aye ondangerie, na inche ng’itabe, gose ing’a ribaga nkwane, naye ong’iranerie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamocho aane, na ebibe biane, mbirenga bire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Imanyie ogosaria kwane, na ebibe biane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki okobisa obosio bwao na",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kombara ng’a nomobisa oo inde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
