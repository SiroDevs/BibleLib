            "sid": "JOB 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye gwasoirie amagoro aane ase rikorogoto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo origereretie orogendo rwane rwonsi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye kwabeekire orobebe ase chimbaratero chiane chigotacha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
