          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nigo orasegenyie",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        },
        {
          "text": "rito eriomo rikona‐koirwa nembeo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose aye nigo ogochia gotunya omoiriro korwa magega?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
