{
  "id": "JOB.28",
  "number": "28",
  "bookId": "JOB",
  "reference": "Ayubu 28",
  "copyright": "© 2021 KENBS",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JOB 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotogia obong’aini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekeene, ribwago ase chifeta chigokunywa korwa ndire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aase abanto bagosiberia chitaabu nare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebioma nigo bigokunywa korwa riroba inse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chitaai nigo chikonyorwa ase amagena ’ebitare anyititorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bagotongia chitaaya ime aaria, basiria omosunte;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio baba bakoriga‐rigia amagena ase ebinunchi bire ase omosunte ekerima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bagokunya chingoro chintambe gochia inse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo nigo bakoba bebirwe nabaanto bagotaara igoro ye riroba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagotirimbokigwa basung’unaine bairwa aare korwa ase abanto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase riroba igoro nao endagera ekwama",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ime y’ense inse aroro aonchoranwa aba buna omorero ogosamba oonchorana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroro agwo nao are amagena e rigori rinene akorokwa safiro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amo namagena e chitaabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchera ekogenda aase agwo enyoni ende yonsi egotwara orotwari teyemanyeti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ekebaki tikiana koyerora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’iti y’orosana eng’enenu tiyana koyetacha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose endo tiyana goetera aroro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwanyabaanto nigo agokunya egetare ekiomo pa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio osensema ebitunwa korwa inse obionchorana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akorema emetaro ime ase ebitare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaiso aye arora kera egento kie rigori rinene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akogita chindooche, otanga amaache tagoeta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio egento kebisekanete ime, okerenta aase aarabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ng’ai obong’aini boranyorekane?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na ng’ai okomanya komenyete?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwanyabaanto tamanyeti rigori ri’obong’aini;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "borobwo tibori konyorekana ase ense emenyire nabare moyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chindiba nigo chigokana chiateeba: Tibori ase ’nde aa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enyancha nigo egoteeba: Tibori aiga ase ’nde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibokogorwa chitaabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose chifeta tichikorengwa koba rigori riaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibokoreng’anigwa ne chitaabu chikorwa Ofiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose namagena e rigori rinene akorokwa oiniki na safiro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitaabu na ebirore ebiya tibikoreng’anigwa naborobwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tibokoonchorerigwa n’ebinto bi’ogwechabera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "biroisirie korwa ase chitaabu chichenire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakorongote na ebirore bichenire tibigwatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigori ri’obong’aini nigo rire rinene kobua eri’amagena erigori rinene akomeka‐meka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topasio, rigena rie rigori rinene rikorwa Ethiopia, tirikoboreng’anigwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tibokoreng’anigwa netaabu echenire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bono rende, obong’aini ng’ai bokorwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Na ng’ai okomanya komenyete?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bobisire korwa ase amaiso ’ebitongwa bionsi bire moyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nigo botubire chinyoni tichiborora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aase ay’obosareku na amakweri nigo bigoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Intwe twaigure chinkuma chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyasae bweka namanyete enchera y’obong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namanyete aase aye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo arigereretie goika chinsinyo chionsi chi’ense,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aroche kera egento kere inse y’erioba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Nyasae arengete chinguru chi’omwaga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na akarenga obonge bw’amaache,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero abegete ogochika ase embura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na akaroisia enchera y’okomesa gw’enkoba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nario aroche obong’aini naende akaboraria;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akaboikerania na koboenekia ase abanto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Erio Nyasae agateebia Mwanyabaanto:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naama! Okomoiroka Omonene, okwo nakwo obong’aini;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogweatanana korwa ase ebibe, okwo nakwo okomanya.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
          }
        }
