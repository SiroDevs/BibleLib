          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki ring’ana riria inyoboete rianchicheire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.25",
            "verseOrgIds": [
              "JOB.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na riria rikoondokia rianyorire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.25",
            "verseOrgIds": [
              "JOB.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
