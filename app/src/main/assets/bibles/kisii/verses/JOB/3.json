          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche timbwati omorembe gose botoereru bonde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.26",
            "verseOrgIds": [
              "JOB.3.26"
            ]
          }
        }
