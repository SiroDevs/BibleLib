          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki omobaso oorokire ase omonto chinchera chiaye chibisire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.23",
            "verseOrgIds": [
              "JOB.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio Nyasae agiteire chinsemo chionsi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.23",
            "verseOrgIds": [
              "JOB.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
