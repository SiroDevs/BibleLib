      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timbwati ogotimoka, korende emechando nigo egendererete konagocha.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.26",
            "verseOrgIds": [
              "JOB.3.26"
            ]
          }
