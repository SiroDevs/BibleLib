          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obororo bw’emechando yane bwabeire buna endagera nkoria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.24",
            "verseOrgIds": [
              "JOB.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebirero biane nigo bigoiteka buna amaache.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.24",
            "verseOrgIds": [
              "JOB.3.24"
            ]
          }
        }
      ]
    },
    {
