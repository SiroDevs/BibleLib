          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rigoti riaye nigo ribwate chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
