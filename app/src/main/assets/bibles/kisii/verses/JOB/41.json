      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekio giatongetwe getari kwoboa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.33"
            ]
          }
