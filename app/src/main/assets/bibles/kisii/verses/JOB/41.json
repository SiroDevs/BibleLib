      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero ekorindoka gocha nigo bagotang’ang’a.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
