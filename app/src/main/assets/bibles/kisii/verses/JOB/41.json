    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo yesibete bokong’u ase omobere oye, tekonyarwa kobwatokanigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
