          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoika bw’omonwa oye nigo ogosoka buna ekebemberi ki’omorero,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
