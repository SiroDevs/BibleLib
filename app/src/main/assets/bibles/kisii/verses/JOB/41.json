    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna enyongo ekobera egosokia omwoki bw’amaache.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
