          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bonsi nigo bakobeekwa ase riroba bareng’anetie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagunda, na amakonde abatuba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        }
      ]
    },
    {
