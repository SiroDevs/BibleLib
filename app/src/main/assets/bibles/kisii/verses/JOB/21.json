          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero arabeekwe ase oboina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.32",
            "verseOrgIds": [
              "JOB.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oboina boria nigo boraarendwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.32",
            "verseOrgIds": [
              "JOB.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaroba erigoko nabe amansu asare;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto bonsi mbamotunyane korwa magega,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omobaro bw’abamotang’anerete tori kobareka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nase ki rende mokondemia namang’ana abosa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.34",
            "verseOrgIds": [
              "JOB.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ayatigaire ase amairanerio aino nigo are oborimo bwoka.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.34",
            "verseOrgIds": [
              "JOB.21.34"
            ]
          }
        }
