      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rora, nimanyete ebirengererio biaino,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.27",
            "verseOrgIds": [
              "JOB.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na emeroberio yaino y’ogonkora bobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.27",
            "verseOrgIds": [
              "JOB.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe nigo mokoboria: Ng’ai enyomba y’omochandi oria ere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naende: Ng’ai obomenyo bw’abakori amabe bore?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Inwe timori koboria abaeti chinchera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.29",
            "verseOrgIds": [
              "JOB.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende mwanchera oborori bwabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.29",
            "verseOrgIds": [
              "JOB.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng’a omokori amabe nigo akorendwa ekero emechando yachire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.30",
            "verseOrgIds": [
              "JOB.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende atoorigwe ase rituko ri’endamwamu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.30",
            "verseOrgIds": [
              "JOB.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oranyare koorokeria omokori amabe chinchera chiaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.31",
            "verseOrgIds": [
              "JOB.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oramoakane amabe ayio akorire?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.31",
            "verseOrgIds": [
              "JOB.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
