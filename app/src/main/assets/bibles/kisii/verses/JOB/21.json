      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono Ayubu akairaneria, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.1",
            "verseOrgIds": [
              "JOB.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tegerera mono moigwe amang’ana aane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ayio naro arabe okoremia kwaino ase ’nde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remereria, erinde nkwane;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ngokoora gokwana, mogenderere gonchecheria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Inche Mwanyabaanto nkwemurunganeria?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki rende ndaremererie tinyemurungania?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indigererie na moichanigwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio motube emenwa yaino namaboko, mokire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero nkoinyora amang’ana aya, obwoba nigo bogonsoa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omobere one oiguswa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nase ki abakori amabe bakogenderera koba moyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kwegotera bare ne chinguru na okobua?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana babo nigo bakoba nokogenderera okuya amo nabarabwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ororeria rwabo boigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinka chiabo nigo chire buya, bwoba tiboiyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose Nyasae tari kobaa egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiombe chiabo nigo chikonyora amarieme buya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende chiabiara chitari korekera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana babo nigo bagotomwa isiko banga buna amaicho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakoba bagotenga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bagotera bakobugia chinchigiri na amakano,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende bagokera amariogi ’ebiroria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bakogenderera kwegokia nobotenenku bwabo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakwa bagenda aase abakuure bare nomorembe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barobwo nigo bagoteebia Nyasae: totige intwe!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Titoganeti komanya chinchera chiao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oria Omobui ninki are goika tomokorere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Mbitoki ki toranyore ase okomosaba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, ogosesenigwa kwabo tikori ase amaboko abo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogosemia kw’abakori amabe nigo kore aare nainche.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Ng’ara karenga chitaaya chi’abakori amabe chikorimigwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ng’ara karenga emechando ekobacheera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Ara karenga Nyasae akobaa emechando ase engencho y’endamwamu yaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gose barabwo nkoirurukigwa bare buna chimboba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna omoiriro okoirurukigwa nomwaga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe nigo mogoteeba ng’a Nyasae nigo akogachera abana ebibe bi’abaise.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga Omonene aakane abanto abanyene ebibe biabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio nario baranyare kobimanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga barore ogosirigwa kwabo namaiso abo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende banyoosigwe endamwamu y’Omonguru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero emetienyi yabo yaerire na bakuure,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee, mbabe bagwechandera chinka chiabo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onde nare oranyare kworokereria Nyasae obong’aini,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere oria okogambia abwo bare igoro mono?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omonto oyomo nigo agokwa ore nobotenenku obonge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.23",
            "verseOrgIds": [
              "JOB.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ore n’obotoereru bwonsi na orendire buya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.23",
            "verseOrgIds": [
              "JOB.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebirandi biaye biichire namabeere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.24",
            "verseOrgIds": [
              "JOB.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amauga ’omobere oye aichire nemeseto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.24",
            "verseOrgIds": [
              "JOB.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto onde igo agokwa ore nobororo bw’omoyo oye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.25",
            "verseOrgIds": [
              "JOB.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "atana konyora amaya nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.25",
            "verseOrgIds": [
              "JOB.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
