          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero ntaragenda aase ntanyare koirana korwao rinde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.21",
            "verseOrgIds": [
              "JOB.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ense eria y’omosunte ekerima na ey’ekiriri ki’amakweri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.21",
            "verseOrgIds": [
              "JOB.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
