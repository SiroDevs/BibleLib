          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Amatuko y’obogima bwane tari amake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Intige, imbe n’obotoereru ase engaki eye enke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.20",
            "verseOrgIds": [
              "JOB.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
