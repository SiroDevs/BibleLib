      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ey’ekiriri ki’amakweri na obotantanu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.22",
            "verseOrgIds": [
              "JOB.10.22"
            ]
