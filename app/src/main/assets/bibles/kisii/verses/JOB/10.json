          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ense emwamu ti buna omosunte ekerima;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.22",
            "verseOrgIds": [
              "JOB.10.22"
