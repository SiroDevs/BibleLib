  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "JOB 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Elihu akagenderera gokwana, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.1",
            "verseOrgIds": [
              "JOB.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abanto abang’aini, igwa amang’ana aane!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abamanyi chisemi, ntegerera!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana amato akoigwa, nigo akoyateema,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna oromeme rokomena endagera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tochore ayare amaronge;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "intwe amo toteeme komanya ayare amaronge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubu nigo agoteeba: Inche nomonyene oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende Nyasae ong’urire oboronge bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya inde omonyene oboronge, nabarirwe ng’a nomonyaborimo inde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaote aane takonyara kogwena,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya gosaria konde tikori ime ase ’nde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Monto ki onga buna Ayubu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio okonywa ogochaywa, ogokomera buna amaache?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere oyio ogosanga nabanyabibe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gotaara nabakori amabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende ere oteebire ng’a",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kobwatana na Nyasae, ayio tari komokonya gento kende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ase ayio, inwe abanto abamore nokomanya, inyigwa!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae tabaisa gokagerwa ng’a nakore amabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Ere Omonguru nakore ebibe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agoakana omonto koreng’ana buna emeremo yaye ere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabo akoa omonto eng’eria buna orogendo rwaye rore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeene, Nyasae tagokora ayare amabe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ere Omonguru tari gosaria ayare ay’ekeene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oete Nyasae okobua gw’okogambera ense?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o obeegete ense yonsi koba eyaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere aise koirania omoika oye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, airanie gochia asare omoika bw’obogima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanyabaanto bonsi pi goika bakwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bairane ase amaroba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Onye more nokomanya, igwa aya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tegerera moigwe aya ngoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Omonto ogechete ekeene nanyare kogamba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nonachere ekiina omonyene oboronge oyore nokobua?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonyare goteebia omorwoti: Aye nigo ore omonto bosa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose noteebie abanene basikire: Inwe nabakori amabe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae tari gwanchereria abagaambi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tari kobara abanda ng’a mbare nengencho enene kobua abataka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera abwo bonsi nigo bare emeremo y’amaboko aye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto nigo bagokwa ara rimo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakonyegerigwa botuko gati, basira kegima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baria bare nokobua nigo bagosirigwa ko tari namaboko a Mwanyabaanto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo arigereretie chinchera chi’omonto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere nigo aroche amatambokero aye onsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aase aamwamu tari, gose omosunte ekerima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase omokori amabe aranyare kwebisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae taganeti engaki entambe korigereria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika abeeke omonto ase ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agosenyenta abare nokobua atari kona‐kouna‐unia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio abeeke abande aase abo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera ere namanyete emeremo yabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akobaonchorana botuko baitwa kegima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo akobaita maiso marore,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho y’ebibe biabo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ekiagera baonchokire na gotiga komobwatia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tibari korengereria igoro ye chinchera chiaye nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bagerire ekerero ki’abataka giaikire asare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere oigure ekerero ki’abagokorerwa bobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nyasae karakire‐kiri ning’o oramonachere ekiina?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Karabise obosio bwaye, ning’o oranyare komorigereria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gokerabe egesaku gete gose omonto gete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekero ararusie okogamba korwa ase abatamoirogeti",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abatange tibaaba emeribo ase abanto?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Monto onde nare oteebirie Nyasae:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche naremereirie egesusuro gi’okondongeyia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya tinkorereti monto onde bobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono inyorokererie aya ntamanyeti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onye nakorire ebibe, tingwancha kobikora naende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo okagete ng’a Nyasae nigo aragoakane buna oranche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera gwakanire ande onsi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye goika ochore, gose tari inche;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio, kwana aya omanyete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abanto abare nokomanya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kera omonto omong’aini orabe okonyigwa, nigo baranteebie:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubu nigo agokwana atari na semi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.35",
            "verseOrgIds": [
              "JOB.34.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amang’ana aye tari ay’obong’aini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.35",
            "verseOrgIds": [
              "JOB.34.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOB 34:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo yagwenerete Ayubu ateemwe goika omoerio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.36",
            "verseOrgIds": [
              "JOB.34.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo akoiraneria buna abakori amabe bakoiraneria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.36",
            "verseOrgIds": [
              "JOB.34.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOB 34:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo akomenta ogosaria ase ebibe biaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.37",
            "verseOrgIds": [
              "JOB.34.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nigo agotoakera chinkobi ase ogotochaya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.37",
            "verseOrgIds": [
              "JOB.34.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gokwana amang’ana amange are mamincha ya Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.37",
            "verseOrgIds": [
              "JOB.34.37"
            ]
          }
        }
      ]
    }
  ],
