      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoyo oye ogecha endagera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya endagera ere engiya mono.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinyama chi’omobere oye nigo chikoera, tichikororekana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amauga aye atongonona.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere omonyene nigo agosuka gochia ang’e noboina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obogima bwaye gochia ase abagosiria obogima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Onye omomalaika nkoba arenge asare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyomo bwa baria chilifu bagokora okobwatania asare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde amworokie ayare ay’oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "erio amororere amaabera, ateebe:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tooria omonto oyo tabaisa gotirimboka gochia ase oboina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera inche namonyoreire embooria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobere oye oiranigwe obe buna oyo bw’obosae bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende aonchorwe abe buna ekero arenge ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero arabe ogosaba Nyasae, nere namororere amaabera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omonto oyio nachiche ase obosio bwaye ore nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Nyasae nairanie oboronge bw’omonto oyio.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto oyio natere ase amasio ’abaanto, ateebe:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo nakorete ebibe, nkaonchorana aya arenge amaronge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tinanyorete egesusuro buna nagwenerete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere obooririe omoyo one togenda ase oboina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono obogima bwane mborore oborabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, Nyasae nigo agokora amang’ana ayio onsi ase omonto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ara kabere, gose ara gatato,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.29",
            "verseOrgIds": [
              "JOB.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde amoiranie korwa ase oboina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a oyio anyare komorekerwa noborabu bw’obogima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.30",
            "verseOrgIds": [
              "JOB.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye Ayubu, ntegerera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okire‐kiri, inche nkwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.31",
            "verseOrgIds": [
              "JOB.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kobwate ing’ana rinde okong’iraneria, kwana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo nganetie gokoa oboronge bwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye tobwati kende, kira‐kiri ontegerere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.33",
            "verseOrgIds": [
              "JOB.33.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na inche ninkworokererie obong’aini.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.33",
            "verseOrgIds": [
              "JOB.33.33"
            ]
          }
        }
      ]
    }
