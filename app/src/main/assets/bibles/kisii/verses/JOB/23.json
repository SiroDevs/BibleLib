      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubu akairaneria, akabora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.1",
            "verseOrgIds": [
              "JOB.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya ngoika reero okwemurungania kwane nigo kore okororo se;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogoakwa kwane nigo kore okorito kobua okweng’ereria kwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ndiria nare komanya aase ndamonyore,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rirorio nigo nare kogenda goika ase obomenyo bwaye bore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo narenge komoteebia amang’ana aane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ing’ichorie omonwa one namang’ana nkoamererania nere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo nigo nare komanya eki akong’iraneria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na komanya ayarenge gonteebia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nyasae nkoamererania arenge nainche ase okobua kwaye kore okonene?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Yaya, nigo arenge gontegerera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwo omonto omonyaboronge nigo are konyara koamererania nere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rirorio nigo nare gotigwa kegima noyokongambia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, nabeire nkogenda gochia bosio, korende ere taiyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nabeire nkoirana gochia magega, korende tindi komoorora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nkomorigeria ensemo y’okobee, korende ere nigo akwebisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naonchoka gochia ase ensemo y’okorio, korende tindi komoorora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ere namanyete chinchera chiane ngoetera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero arakoore gonteema, nimbioke buna etaabu ekobioka korwa riko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche natachire bokong’u ase amabarato aye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabeire ndendete chinchera chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tindi koonchoka nchitige.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinana gotiga kobwata amachiiko akwanete;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbwatetie amang’ana ere akwanete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tari aya naroberetie inche omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ere tari koonchoka, ning’o oranyare komoonchorana?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Egento aganirie gokora, nigo akogekora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya achiikire igoro yane, goika ayaikeranie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amange buna ayio nigo agachire ase ebirengererio biaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio nabeire nobwoba koba ase obosio bwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero nkoyarengereria nigo nkomwoboa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae ogoyirie omoyo one,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, Omobui ongosire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ere tantigete ase omosunte nsire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya noria ekerima otubete obosio bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    }
  ],
