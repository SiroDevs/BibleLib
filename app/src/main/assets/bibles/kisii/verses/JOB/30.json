  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JOB 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende bono abanto bare abake ase ’nde, nigo bagonsekerera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo abaise babo batagwenereti kende,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "anga ntababegete nonya nase egati ye chisese chikorenda amaicho aane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo chinguru chiabo chiaerire ase obogotu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngokonywa ki ndanyore korwa ase amaboko abo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho y’okoremerwa na enchara babeire ebigonkobe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bakona‐kogokona namaino abo riroba eriomo pa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio riasaregete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bakona‐gosangereria ebimeri bie chinsana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na baremora emeri y’emete enga buna ebisanka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bagoserigwa korwa ase egati y’abanto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baakerwa amariogi korwa magega na kwogererwa buna abaibi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase igo bagenda komenya ase amakuruma are ase amagoko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase chingoro inse y’ense, na ase ebitare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ime ase ebitutu nigo bakwogererana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inse y’amase akorura nao bagosangererekana amo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nabana b’abaanto abariri na ab’abakayayu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baseretigwe nemecharichi barue ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bono inche nabeire engero egoterwa ase bare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nabeire ase bare ring’ana rikorabaarwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bangechete, bantamire;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibetangeti gontwera amate obosio bwane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae ong’urire chinguru, naende onkorire koba omoitongo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto abwo babeire abaremu ase ogonkorera bobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeombe ki’abanto abasaria nigo bagontubokera korwa ensemo yane ya borio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio baminyokia gonseria;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagokora emeroberio emenge y’ogonsiria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basaririe enchera yane ngoetera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo batabwate ogosemia konde abanyene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagokonya abande ase ogonsiria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bagoeta aase omogwa omogare banchichera ne chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio bang’umokera goetera ase omogwa oyio baabagoire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwoba obonene bwanchicheire;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogosikwa kwane gwasirigwe buna omwaga ogosiria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obotenenku bwane bwasirire pi buna amare agosira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bono omoyo one oberire ime yane;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amatuko ’emechando ambwatereire bokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amauga omobere one nigo akonyatia botuko bokia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obororo bokondia tibori gokenda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborwaire bwane bwabeire ne chinguru bwaonchoire risankwa ri’omobere one,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bono nigo ring’usererete buna rigoti ri’eanga yane.",
          "type": "text",
          "attrs": {
