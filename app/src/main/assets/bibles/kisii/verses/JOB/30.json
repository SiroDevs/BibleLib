      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na nigo rikona‐kobutoka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
