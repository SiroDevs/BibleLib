      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amauga aane nigo akoyia buna omorero.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
