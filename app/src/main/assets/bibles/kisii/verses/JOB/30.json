          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Omonto karagwe takorambora okoboko kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase emechando yaye arere akonywe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
