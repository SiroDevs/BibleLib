            "sid": "JOB 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo onyimokereretie igoro kwambekire ase omwaga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kondiinia igoro yaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye nigo okona‐konduchania gochia aaria na aaria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naba bosa ase omwaga omotindi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
