      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero nabeete nsemeretie konyora oborabu, omosunte ogaacha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
