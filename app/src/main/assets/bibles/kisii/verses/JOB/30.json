          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, namanyire ng’a nong’ire aase abakuure,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.23",
            "verseOrgIds": [
              "JOB.30.23"
