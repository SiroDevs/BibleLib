          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae ontugutire ase etintira ime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabeire buna orotu ne ribu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
