          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Tinarerete ase engencho y’abwo barenge ase emechando?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omoyo one tochandekerete abataka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
