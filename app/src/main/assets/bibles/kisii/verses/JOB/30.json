      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omogisangio bwe chisagero.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
