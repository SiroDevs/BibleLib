            "sid": "JOB 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwabeire omotindi ase ’nde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo okondwania nokoboko kwao kore ne chinguru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
