    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase enyomba eria echikeire abare moyo bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.23",
            "verseOrgIds": [
              "JOB.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
