          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkoro yane nigo ere nemechando mono, teri n’obotoereru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
