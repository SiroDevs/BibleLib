          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naama! Twabeire togokora obotuki ase amang’ana ayio;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.27",
            "verseOrgIds": [
              "JOB.5.27"
            ]
          }
