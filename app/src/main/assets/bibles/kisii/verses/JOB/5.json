          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nogende ase embeera kore nobogotu obuya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.26",
            "verseOrgIds": [
              "JOB.5.26"
            ]
          }
