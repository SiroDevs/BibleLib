    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ororeria rwao ndobuche robe oronge buna obonyansi bore ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.25",
            "verseOrgIds": [
              "JOB.5.25"
            ]
          }
        }
      ]
    },
    {
