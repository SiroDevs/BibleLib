    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase ayio bono igwa amang’ana ayio,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.27",
            "verseOrgIds": [
              "JOB.5.27"
            ]
