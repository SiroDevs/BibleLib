          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ogosiria na enchara birache, aye nobe gokobisekerera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.22",
            "verseOrgIds": [
              "JOB.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tokwoboa ching’iti chintindi chire ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.22",
            "verseOrgIds": [
              "JOB.5.22"
            ]
          }
        }
      ]
    },
    {
