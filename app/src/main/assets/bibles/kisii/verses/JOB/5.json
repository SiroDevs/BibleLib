          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Norore buna abana bao babeire abange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.25",
            "verseOrgIds": [
              "JOB.5.25"
            ]
          }
        }
