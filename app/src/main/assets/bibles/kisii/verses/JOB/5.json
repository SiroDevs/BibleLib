          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanto bakogokwana bobe nobiswe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.21",
            "verseOrgIds": [
              "JOB.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero amabe agoita arache, toyoboa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.21",
            "verseOrgIds": [
              "JOB.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
