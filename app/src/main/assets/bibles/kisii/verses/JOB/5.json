          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nonyare korora ng’a obomenyo bwao mborendire buya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.24",
            "verseOrgIds": [
              "JOB.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero orabe gokorata ase ameri e chitugo chiao,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.24",
            "verseOrgIds": [
              "JOB.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonyore ng’a ende tesireti korwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.24",
            "verseOrgIds": [
              "JOB.5.24"
            ]
          }
        }
      ]
    },
    {
