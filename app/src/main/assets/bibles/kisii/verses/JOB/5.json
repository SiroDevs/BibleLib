      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naro nay’ekeene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.27",
            "verseOrgIds": [
              "JOB.5.27"
            ]
          }
        }
