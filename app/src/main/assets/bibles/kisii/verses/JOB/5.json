          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero ki’enchara nagotoorie korwa ase amakweri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.20",
            "verseOrgIds": [
              "JOB.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero gi’esegi korwa ase abwo bagoita nemioro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.20",
            "verseOrgIds": [
              "JOB.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
