      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna emesaima y’endagera ekorentwa ekero engaki yabo yaikire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.26",
            "verseOrgIds": [
              "JOB.5.26"
            ]
          }
        }
