          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya namagena are mogondo, nobwatane naro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.23",
            "verseOrgIds": [
              "JOB.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne ching’iti chi’orosana nobe nomorembe nachirochio.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.23",
            "verseOrgIds": [
              "JOB.5.23"
            ]
          }
        }
      ]
    },
    {
