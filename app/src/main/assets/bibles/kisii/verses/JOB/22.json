          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere nigo agotooria omonto ore nokomocha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.30",
            "verseOrgIds": [
              "JOB.22.30"
            ]
          }
