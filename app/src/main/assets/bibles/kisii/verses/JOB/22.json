          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ekero orabe gokomosaba, nakoigwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.27",
            "verseOrgIds": [
              "JOB.22.27"
            ]
          }
        }
      ]
    },
