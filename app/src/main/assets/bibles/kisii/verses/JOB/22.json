      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae nigo agokeyia abaenenu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende abare abaitongo obatooria.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
