      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omonto buna oyio nigo aratoorigwe goetera ase amaboko ao achenegete.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.30",
            "verseOrgIds": [
              "JOB.22.30"
            ]
          }
        }
