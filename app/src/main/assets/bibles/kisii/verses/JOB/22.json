          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otugute chitaabu chiao ime ase amaroba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.24",
            "verseOrgIds": [
              "JOB.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chitaabu chikorwa Ofiri ochibeke ase egati y’amagena ’ebirooche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.24",
            "verseOrgIds": [
              "JOB.22.24"
            ]
          }
        }
      ]
    },
    {
