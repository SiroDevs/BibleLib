      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na efeta yao ere nengencho enene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.25",
            "verseOrgIds": [
              "JOB.22.25"
            ]
          }
        }
      ]
    },
