      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naye nonyare goakana chiira chiao chi’ogotiana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.27",
            "verseOrgIds": [
              "JOB.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
