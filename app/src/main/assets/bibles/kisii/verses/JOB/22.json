          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obwatane na Nyasae, nario orabe nomorembe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.21",
            "verseOrgIds": [
              "JOB.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korakore igo, nonyore amaya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.21",
            "verseOrgIds": [
              "JOB.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ancha amorokererio akorwa ase omonwa oye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.22",
            "verseOrgIds": [
              "JOB.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gacha amang’ana aye ime ase enkoro yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.22",
            "verseOrgIds": [
              "JOB.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korairanere Omobui, noiranerigwe amaya ao;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende oserie obobe korwa ase obomenyo bwao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
