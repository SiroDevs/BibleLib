        "style": "c",
        "sid": "JOB 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "text": "(22:1—27:23)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Elifasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Elifasi Omotemani akairaneria, akabora:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.1",
            "verseOrgIds": [
              "JOB.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nenyarekane ng’a omonto abe nengencho ase Nyasae?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekeene, omonto oria ore nobong’aini nigo akwegwenera ere bweka omonyene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Omogoko onde nore ase Omonguru ng’a nomonyaboronge ore?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose inki aranyore onye aye kogokora chinchera chiao chibe ching’ikeranu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Nigo okagete ng’a nekiagera omoirogete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nakio gekogera agokoa egesusuro na gokorenta ase ekiina?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Amabe gwakorire tari amanene?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekeene, ebibe biao tibiri nomoerio.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwairire bosa ebinto abamino baruete bibe ntenenera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende kwabachaboire chianga, kwabatigire gesobono.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo konya orosire tomoeti amaache anywe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oyo orenge nenchara okamorina endagera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto obwate okobua nigo akoira ense yaba eyaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oyio oeirwe ogosikwa nere okoyemenya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwabeire kogoseria ababoraka bare namaboko amasa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobuna amaboko e chintakana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio emeeto yagoetananire,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obwoba bwa mobosokano nkogochanda bore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oborabu bwao bwabekirwe omosunte, goika tori korora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaache amange agotubire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nyasae tari aaria igoro mono?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigereria ching’enang’eni chia igoro buna chire aare mono!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho eyio aye nigo ogoteeba: Inki Nyasae amanyete?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nanyare konacha ekiina goetera ase omosunte ekerima?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amare amarito nigo amotubete, takonyara korora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nigo agotaara ase obokumbe bwa igoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inee! Nenchera enkoro ogochia kobwatia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eria abakori amabe babwatetie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo nigo bataboretigwe engaki yabo konya etaraika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oboroso bwabo bokairwa buna omogooko okoira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo nigo bateebeetie Nyasae:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Karue ase tore!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naende bakaboora: Inee! Ngento ki Omobui oyio aratokorere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonya naboigo Nyasae konya oichoirie chinyomba chiabo n’ebinto ebiya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ogosemia kw’abakori amabe tiga kobe aare nainche.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abanyaboronge bakorora ayio, nigo bakogoka;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.19",
            "verseOrgIds": [
              "JOB.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, abwo batari na komocha nigo bagosekerera abakori amabe na kobachecheria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.19",
            "verseOrgIds": [
              "JOB.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bateba: Amaene, ababisa baito basirigwe kegima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.20",
            "verseOrgIds": [
              "JOB.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebinto biabo biatigarete biasambirwe nomorero.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.20",
            "verseOrgIds": [
              "JOB.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
