          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ekero orabe gokoroberia gokora gento kende gionsi, ekio nkebe bo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.28",
            "verseOrgIds": [
              "JOB.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oborabu mbomoreke chinchera chiao.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.28",
            "verseOrgIds": [
              "JOB.22.28"
            ]
          }
        }
      ]
    },
    {
