          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rirorio nobe gokwegokia ase Omobui oria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.26",
            "verseOrgIds": [
              "JOB.22.26"
            ]
          }
        }
