      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onyare korigereria Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.26",
            "verseOrgIds": [
              "JOB.22.26"
            ]
          }
        }
      ]
    },
    {
