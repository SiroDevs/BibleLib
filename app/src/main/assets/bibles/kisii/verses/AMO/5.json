              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe mobogorie Sikuti, omogwekano oyio mogosasiima buna omorwoti oino, na Kiyuni, enyasae yaino ye ching’enang’eni mweroiseretie.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
