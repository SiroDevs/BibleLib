  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2TH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Motosabere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoerio, baminto, tosabere erinde ring’ana ri’Omonene rirande na gotogigwa buna riakorire ase egati yaino,",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
            "verseOrgIds": [
              "2TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng’a totoorigwe korwa ase abanto batari abaronge, na abare ababe, ekiagera tai bonsi bare nokwegena.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.2",
            "verseOrgIds": [
              "2TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Omonene nomwegenwa, nere orababeeke chinguru na kobarenda korwa ase oria omobe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase Omonene ntore nogosemeria igoro yaino, ng’a ngokora more ayatwabachiigete, naende mogenderere koyakora.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene atang’ane chinkoro chiaino, erinde momanye obwanchani bwa Nyasae, na oboremereria bwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogokuurera kw’ogokora emeremo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono baminto, twabachikiire ase erieta ri’Omonene Yeso Kristo, mweatanane korwa ase oyomino oyore omworo, oyotabwateti chingencho echio mweorokereretie korwa ase tore.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.6",
            "verseOrgIds": [
              "2TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki inwe abanyene momanyete buna ebagwenerete motwege; titwabeete aboro ekero twarenge amo nainwe,",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.7",
            "verseOrgIds": [
              "2TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gose titwariete endagera ya monto onde bwensi bosa, totaakaneti, korende nase obokong’u amo nogwechanda togakora emeremo obotuko na omobaso, erinde titoraarereria monto onde oino.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.8",
            "verseOrgIds": [
              "2TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari ng’a eyio tiyatotungetie, korende igo twekorete abanyene koba ekiorokererio ekiya ase more, erinde motwege.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.9",
            "verseOrgIds": [
              "2TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera nonya nekero keria twarenge amo nainwe ntwabachiigete ring’ana eri, ng’a onye omonto tarigeti gokora emeremo, taegwa endagera.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.10",
            "verseOrgIds": [
              "2TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki twaigure ng’a mbare abanto ase more bare aboro, batari gokora emeremo, korende nigo bakona‐gotuka amang’ana y’abaanto bande.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.11",
            "verseOrgIds": [
              "2TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abanto banga buna abwo twabachikiire na kobasorora ase Omonene Yeso Kristo, ng’a bakore emeremo ase obotoereru, na koria endagera yabo abanyene.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende baminto, timorosa gokora amaya.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye monto onde bwensi okwanga koigwera ring’ana eri tokwanete ase riruube eri, erusananie korwa ase omonto oyio, na timosanga nere; tiga arore obosooku.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.14",
            "verseOrgIds": [
              "2TH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timomobara buna omobisa, korende momokuurere buna oyomino.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amang’ana omoerio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono Omonene bw’omorembe omonyene abae omorembe ase chingaki chionsi, na ase chinchera chionsi. Omonene abe amo nainwe mwensi.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko nogokwania kwane inche Paulo ase okoboko kwane omonyene. Eke nakio ekemanyerio ase kera riruube riane; naboigo nkoriika.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuya bw’Omonene oito Yeso Kristo bobe amo nainwe mwensi.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.18",
            "verseOrgIds": [
              "2TH.3.18"
            ]
          }
        }
      ]
    }
  ],
