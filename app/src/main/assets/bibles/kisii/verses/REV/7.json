          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abaisraeli chilifu rigana erimo na emerongo ene na inye (144,000) babekirwe ekemanyererio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magega ase aya nkarora abamalaika baane bateneine ase chinsemo inye chi’ense, bagotanga chimbeo inye chi’ense, erinde embeo tegusa igoro ase ense, nonya niigoro ase enyancha gose ase omote onde bwonsi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende nkarora omomalaika onde ogotiira korwa aase erioba rigosoka korwa ore nekemanyererio kia Nyasae ore moyo; akabaakera egeturi ase eriogi rinene abamalaika baria baane baetwe ribaga gosaria ense na enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogoteeba, “Timosaria ense, gose enyancha, nonya nemete, goika twabekire abasomba ba Nyasae ekemanyererio ase amasio abo igoro.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio nkaigwa omobaro obo abwo babekirwe ekemanyererio. Nigo barenge abanto chilifu rigana erimo na emerongo ene na inye (144,000) korwa ase kera egesaku kia basinto ba Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’egesaku kia Yuda nigo barenge chilifu ikomi na ibere",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ababekirwe ekemanyererio,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ab’egesaku kia Rubeni chilifu ikomi na ibere,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ab’egesaku kia Gadi chilifu ikomi na ibere,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
