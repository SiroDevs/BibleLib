            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ab’egesaku gi’Aseri chilifu ikomi na ibere,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ab’egesaku kia Nafutali chilifu ikomi na ibere.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ab’egesaku kia Manase chilifu ikomi na ibere,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
