  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "OBA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "OBA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oko nokorora kw’Obadia.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aya naro Omonene agoteeba igoro y’egesaku kia Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene nae Abaedomu egesusuro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, twaigure amang’ana korwa ase Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omotomwa otomirwe gochia ase abanto b’ebisaku, ogoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Imoka, togende korwania Abaedomu esegi!”",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "OBA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene Nyasae nigo agoteebia egesaku kia Edomu “Rora, ningokore obe omoke ase egati y’abanto b’ebisaku,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obe kogochaywa mono na bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "OBA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboenenu bw’enkoro yao bwakong’ainire,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye omenyete ime y’emienya y’ebitare;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo ase omenyete aimokererete igoro.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo ogokwana ase enkoro yao ime, gweteeba:",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o orang’iyerie gochia inse?”",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "OBA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Noisa koagacha egeswa kiao aaria igoro buna ekeongo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nokebeke ase egati‐gati ye ching’enang’eni,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche ninkoiyerie korwa aroro.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "OBA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abaibi gose abasakori baise kogochera botuko,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nosirigwe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekeene, nigo baraibe binde bionsi baganetie.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Abasangereria b’amasabibu baare kogochera,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibarenge kogotigera nonya naria agotigara?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende asore aye ababisa bao bagosiririe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "OBA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto b’ororeria rwa Esau chinibo chiaino chiasakoirwe;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obonda bwaino bwaibirwe bwonsi!",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "OBA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto baria bonsi kwabwatanete nabarabwo bagoseririe gochia ase orobebe,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto baria gwakorete omorembe nabarabwo bakong’ainire na gokobua.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abasani bao mokoria komo bagotegeire oboreba, bagoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ng’ai obong’aini bwao bore?”",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "OBA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase rituko erio ninsirie abanto abang’aini ba Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ninsirie okomanya gwonsi korwa ase Egetunwa gia Esau.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "OBA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe Abatemani, abarwani baino b’esegi bare chituoni mbaondoke,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kera oyomo ore ase Egetunwa gia Esau naitwe asirigwe kegima.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ayakogera Abaedomu baegwe egesusuro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "OBA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiagera mwaureretie na goita abanto bamino b’ororeria rwa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namosookigwe na gosirigwa goika kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "OBA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe nigo mwatenenete ensemo ase rituko riria,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero abanto b’ense engeni bairete chinibo chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagasoa ebiita bia Yerusalemu, bakayoakera obomera.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naboigo nainwe mwarenge buna barabwo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "OBA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anga timware kogoka ase rituko riria amabe acherete abanto bamino.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose timware gochenga ase rituko ri’ogosirigwa kw’Abayuda,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timware gokwana noboenenu ase rituko ri’emechando yabo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "OBA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe anga timwasoete ase egeita ki’abaanto baane",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase rituko ri’amaakwa abo;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose anga timwagokerete emechando yabo ase rituko ri’amaakwa abo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose anga timwaramborete amaboko aino koira chinibo chiabo",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase rituko ri’amaakwa abo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "OBA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe anga timwatenenete ase amatabekania e chinchera",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.14",
            "verseOrgIds": [
              "OBA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goita abanto ba Edomu kobagotama,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.14",
            "verseOrgIds": [
              "OBA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose anga timwabegete abatooregete babo bache gosirigwa",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.14",
            "verseOrgIds": [
              "OBA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase rituko riria ri’emechando yabo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.14",
            "verseOrgIds": [
              "OBA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae nanachere abanto b’ebisaku ekiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "OBA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rituko ri’Omonene ng’ang’e rire gochera abanto b’ebisaku bionsi.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.15",
            "verseOrgIds": [
              "OBA.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Buna mwabeire mogokora, naboigo nainwe morakorerwe.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.15",
            "verseOrgIds": [
              "OBA.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ogokora kwaino nkobairanere inwe abanyene.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.15",
            "verseOrgIds": [
              "OBA.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "OBA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna babeire bakonywera egekombe ki’endamwamu yane igoro ase egetunwa kiane egechenu,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.16",
            "verseOrgIds": [
              "OBA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo nabaanto b’ebisaku bionsi baragenderere konywa botambe,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.16",
            "verseOrgIds": [
              "OBA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, mbanywe bakoore pi basire kegima.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.16",
            "verseOrgIds": [
              "OBA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obobui bw’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "OBA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende ase egetunwa gia Sayoni mbabe aroro abaratooreke",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.17",
            "verseOrgIds": [
              "OBA.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na aase agwo nabe aachenu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.17",
            "verseOrgIds": [
              "OBA.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto b’enyomba ya Yakobo nabairanerigwe ense yabo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.17",
            "verseOrgIds": [
              "OBA.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "OBA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’enyomba ya Yakobo mbabe omorero,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.18",
            "verseOrgIds": [
              "OBA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ab’enyomba ya Yusufu mbabe buna ekebemberi ki’omorero,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.18",
            "verseOrgIds": [
              "OBA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbasirie ab’enyomba ya Esau buna omorero ogosamba amasakwe amomo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.18",
            "verseOrgIds": [
              "OBA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nonya n’oyomo obo tagotoreeka.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.18",
            "verseOrgIds": [
              "OBA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche Omonene nakwanire ayio.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.18",
            "verseOrgIds": [
              "OBA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "OBA 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’ense ya Negebu mbaire Egetunwa gia Esau,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.19",
            "verseOrgIds": [
              "OBA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ab’ense omweya mbaire ense y’Abafilisti.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.19",
            "verseOrgIds": [
              "OBA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abaisraeli mbaire ense y’Abaefraimu na ey’Abasamaria chibe echiabo;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.19",
            "verseOrgIds": [
              "OBA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto ba Benjamini mbaire Gileadi ebe eyabo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.19",
            "verseOrgIds": [
              "OBA.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "OBA 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarwani esegi b’Abaisraeli abwo bairetwe ase obosomba",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.20",
            "verseOrgIds": [
              "OBA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbairane bamenye ase ense babue omochie o Foiniki goika Sarefata.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.20",
            "verseOrgIds": [
              "OBA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto ba Yerusalemu bairetwe ase obosomba, abwo bamenyete Sefaradi,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.20",
            "verseOrgIds": [
              "OBA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbaire emechie ya sugusu ya Yuda ebe eyabo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.20",
            "verseOrgIds": [
              "OBA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "OBA 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio abatooria mbariine ase Egetunwa gia Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.21",
            "verseOrgIds": [
              "OBA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bagambere Egetunwa gia Esau.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.21",
            "verseOrgIds": [
              "OBA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene omonyene nere orabe omorwoti.”",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.21",
            "verseOrgIds": [
              "OBA.1.21"
            ]
          }
        }
      ]
    }
