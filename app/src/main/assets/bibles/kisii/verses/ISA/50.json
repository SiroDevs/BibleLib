{
  "id": "ISA.50",
  "number": "50",
  "bookId": "ISA",
  "reference": "Isaya 50",
  "copyright": "© 2021 KENBS",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "ISA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene akoboria:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ng’ai riruube ri’ogotigana rire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "riria naete nyoko ng’a totigane?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose monto ki nabwate esira yaye nkabaoonia inwe asare?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Taibo! Ebibe nabio biagerete mokaoonigwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogosaria kwaino nakwo kwagerete nyoko agaserigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nase ki ntanyorete nonya nomonto oyomo ekero nachete?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase ki nonya nomonto oyomo atanyitaberete ekero narangeretie?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Okoboko kwane nigo kweng’eire gotanyare kobooria?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose inche nigo naborirwe chinguru chi’ogotooria?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naama! Ekero ngotogonyera enyancha, amaache nigo agosira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ngokora chindooche chiaba erooro;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinswe chireo nigo chikoborwa amaache, chiakwa chiagunda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nkoboyia igoro nomosunte,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio nayetuba neanga y’okweumia.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene ong’eire oromeme buna orw’abeorokereretie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio nario ndamanye gokwana ring’ana rikorenta oboremu ase oyo orosire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Emambia ase emambia nigo agontura, otabobora amato aane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agontabobora inyigwe buna oyo okworokererigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, Omonene otinoire amato aane;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nainche tinyangeti koigwera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose tinaonchogete gochia magega.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo naonchorete omogongo one gochia ase abwo bayoagete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekenyinyiro kiane ase abwo basunyorete chinderu chiane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tinabisete obosio bwane korwa ase abwo banchaaye na gontwera amate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nankonye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio tinkobugwa nogochaywa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase ayio nakorire obosio bwane bwabeire obokong’u buna rigena,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimanyete ng’a tingosookigwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere oyokong’a oboronge bwane nigo are ang’e nainche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onye nabo, ning’o oranyare koamererania nainche?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga ache totenene amo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oyo ogonsoera, ng’ai are?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga ache ang’e nainche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Omonene nankonye; monto ki oranyare konachera ekiina ng’a nomomochi inde?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rora, abwo bonsi nabagote buna eanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbariegwe buna eanga ekoriegwa nebigwankwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o ore ase more omoirogete Omonene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koigwera eriogi ri’omosomba oye?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oyio ogotaara ase omosunte otari korora omobaso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga egene erieta ri’Omonene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amosemerie Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Inwe mwensi aba mogouta omorero,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.11",
            "verseOrgIds": [
              "ISA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gwesiberania ebieri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.11",
            "verseOrgIds": [
              "ISA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "genda mosambwe nomorero oino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.11",
            "verseOrgIds": [
              "ISA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase ebieri biaino mwatongirie!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.11",
            "verseOrgIds": [
              "ISA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aya naro moranyore korwa ase okoboko kwane,",
          "type": "text",
