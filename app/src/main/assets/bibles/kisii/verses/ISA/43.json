{
  "id": "ISA.43",
  "number": "43",
  "bookId": "ISA",
  "reference": "Isaya 43",
  "copyright": "© 2021 KENBS",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "43",
        "style": "c",
        "sid": "ISA 43"
      },
      "items": [
        {
          "text": "43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae okoria eira gotooria abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto b’ororeeria rwa Yakobo, inwe Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aya nar’Omonene oria obatongete na kobabomba agoteeba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Timoiroka, ekiagera inche nababooririe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabarangeirie ase amarieta aino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe nabaane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero morabe mogoeta ase amaache ime, nimbe amo nainwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "namoba mogoeta ase chindooche, tichikobamera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Namoete ase omorero, timogosambwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose omorero ekebemberi tokobasiria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ninche Omonene, Nyasae oino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche Omochenu bw’Abaisraeli, ninche Omotooria oino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo naruete Abamisiri bakaba embooria ase engencho yaino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkarua Abaetiopia na Abaseba ribaga riaino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe nigo more ab’engencho enene ase amaiso aane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mwabeire mosikire, nainche nigo mbanchete;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase ayio nindue abanto b’ebisaku basirigwe ribaga riaino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde obogima bwaino botoorigwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, timoiroka, inche nigo inde amo nainwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Nindete abanto b’ororeeria rwaino korwa moocha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na korwa bosongo nimbasangererie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintebie chinse chia sugusu: Tiga abanto baane barue agwo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinse chia Irianyi: Timobatanga!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Renta abamura baane korwa aare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abaiseke baane korwa ase chinsinyo chi’ense.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omonto okorokwa ase erieta riane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio inche natongete anyore obonene bwane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kera oyomo oyio inche nabombete na komotonga, tiga ache.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abaisraeli nigo bare birori ba Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Renta abanto bonsi bare emeuko nonya babwate amaiso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abare emetino nonya babwate amato.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga abanto b’ebisaku bionsi bache amo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, tiga abanto bonsi basangererekane bache.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o ore ase egati yabo oranyare koraria amang’ana aya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oranyare gotworokia amang’ana ayabeete kare?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga barente birori biabo, erinde baorokie oboronge bwabo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ekero baraigwe bateebe: “Nekeene mogoteeba.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Inwe nigo more birori baane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abasomba baane nachorire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde monyare komanya inche na konyegena,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende momanye ng’a inche ninche Ere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Enyasae ende teri yantang’anerete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ende teri erabombwe magega yane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ninche Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche bweka inde Omotooria, naende onde tari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo narentete ogotooreka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkabarareria ayio, nainwe mokayaigwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na enyasae engeni tiyarenge ase egati yaino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe nigo more birori baane ng’a inche ninche Nyasae.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naboigo Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, inche ninche Nyasae;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ngendererete koba oyio oyio.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonto tari oranyare gotooria omonto onde korwa ase okoboko kwane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ngokora emeremo, na onde tari oranyare koyetanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotoorigwa korwa Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene, Omobooria oino oyore Omochenu bw’Abaisraeli, agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ase engencho yaino nintome abasikari gochia Babiloni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baserie abanto b’aroro, erinde batame;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, Abakalidayo abwo baserigwe gochia ase chimeeri chiabo echio bagokerete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ninche Omonene, Omochenu oino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche omotongi oino inwe Abaisraeli, ninche inde omorwoti oino.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oroisetie enchera ase enyancha ime,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, oboeto ase amaache amange are ne chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akarenta aroro chigari chi’esegi ne chibarasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abasikari amo ne chituoni chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio akabaiyeria inse, tibatenena naende;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo basiretigwe bakarima buna orotambe rw’etaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aya nar’Omonene oyio agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.17",
            "verseOrgIds": [
              "ISA.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timobaisa koinyora amang’ana a kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.18",
            "verseOrgIds": [
              "ISA.43.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose korengereria igoro y’ebinto biaetire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.18",
            "verseOrgIds": [
              "ISA.43.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Ninkore ring’ana riyia;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ring’ana erio riachakire kooroka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Timorirochi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nindoisie enchera ase erooro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nintubokie chindooche ase ense enyomo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.19",
            "verseOrgIds": [
              "ISA.43.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde ching’iti chi’orosana amo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nebibwe ne chisagero chinywe chintogie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero ekio nintubokie amaache ase erooro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chindooche ase ense enyomo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’ee abanto baane, abwo nachorire, amaache banywe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.20",
            "verseOrgIds": [
              "ISA.43.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "abanto abwo netongeire, erinde bararie ogotogigwa kwane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.21",
            "verseOrgIds": [
              "ISA.43.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ebibe bi’Abaisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto b’ororeeria rwa Yakobo, timwandangeretie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.22",
            "verseOrgIds": [
              "ISA.43.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, inwe Abaisraeli, timwanyechanderete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.22",
            "verseOrgIds": [
              "ISA.43.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe timwandeterete ching’ondi chiaino chibe ekeng’wanso ki’ogosaambwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timwansigete ase okonduera ebing’wanso biaino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche timbaroseti ase okonduera okoruegwa kw’endagera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timbachandeti ase ogonsambera ubani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timwangorerete ebinto bigotioka buya ne chitaabu chiaino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Timwang’isanegetie nebitinya bi’ebing’wanso biaino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Taibo! Korende nigo mwandosirie nebibe biaino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mwanchandire nogosaria kwaino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche ninche bweka ngotinyia ogosaria kwao,",
          "type": "text",
