  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "ISA 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omosomba bw’Omonene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rora, omosomba one oyio inche nabekire chinguru ime yaye; omochore one omoyo one ogokirie nere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Namobekeire Omoika one,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere oraarente oboronge ase abanto b’ebisaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere takorera, gose tagoaka eriogi rinene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose takoritiga riigugwe ase chinchera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egetonto giatachetwe tagokebuna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose orotambe rw’etaya rokoimoka erioki takororimia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ase obwegenwa bwaye narente oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere takorosa gose gokwa omoyo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika abe orentire oboronge ase ense na kobokong’ia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebisinka, ne chinse chire ang’e nenyancha nchibe chiganyete amachiiko aye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasae, oyotongete igoro chionsi na gochirambora,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo bwarete ense na bionsi ebikorwao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo oete abanto bareo obogima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na kobaa omoika abwo bagotaara aroro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche ninche Omonene, nakorangeirie ase oboronge;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nakobwatire okoboko kwao nkorendete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Goetera asore ninkore okobwatana kw’ogotianania nabaanto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obe omobaso bw’abaanto b’ebisaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oramokie amaiso ’emeuko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "osibore abasibwa korwa ase echela,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abwo bamenyete ase omosunte korwa ase obosibwa bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche ninche Omonene, erio nario erieta riane;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tindi koa omonto onde obonene bwane;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tinkoa emegwekano egosasimwa ogotogigwa kwane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, amang’ana nateebete agwo kare aikeranire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na bono nigo nkobaraareria amang’ana amayia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkobayamanyia atarakorekana.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogoteera kw’ogotogia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moterere Omonene ogoteera okoyia;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "motogie korwa ase chinsinyo chi’ense!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abaeti ase enyancha amo n’ebinto bionsi bire imeo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe abamomenyete ase ebisinka na ase chinse chire ang’e nenyancha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "motogie Omonene!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga erooro na emechie ereo biake amariogi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abamenyete ase emechie ya Kedari boigo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto bamenyete ase omochie o Sela mbatere nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baake eriogi korwa ase ebichuria bi’ebitunwa igoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo bonsi batogie Omonene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koraria obonene bwaye ase ebisinka na ase chinse chire ang’e nenyancha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene naoroke buna etuoni y’esegi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna omorwani esegi abokie omokia oye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agoaka eriogi ri’esegi na kwoga mono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo akweorokia ng’a nare nokobua igore y’ababisa baye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae okoria eira ng’a nakonye abanto baye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nabeire nkirete‐kiri ase engaki entambe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabeire ngendererete gwetanga na gokira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende bono ning’ake eriogi buna eri’omokuungu okobina aibore;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ning’use omoika na goita egekoe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninsarie kegima ebitunwa na ebigoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninyomie ebimeri biabo bionsi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ning’onchore chindooche chibe ense enyomo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninkamie amatibo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nindaae abanto bare emeuko ase enchera batana komanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbatang’ane ase oboeto batana komanya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’onchore omosunte ore bosio bwabo obe oborabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aase atareng’aini naaranigwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ayio naro ndabakorere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tingotiga goikerania amang’ana aane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abanto basemeretie emegwekano egosasimwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbairanigwe magega, basookigwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera nigo bagoteebia emegwekano eyio ebombire;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe ninwe chinyasae chiaito.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abaisraeli bagosinywa kweorokereria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abamore emetino, tegerera moigwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nainwe abamore emeuko, rigereria monyare korora!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o ore omouko otatiga omosomba one?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o ore omotino buna omonto one natomire?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o ore omouko buna omwegenwa one,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose buna omosomba one inche Omonene?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omosomba one nigo akorora ebinto ebinge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende tari kobirengereria ng’a nebi’engencho enene;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo atinogete amato aye, korende tari koigwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho y’oboronge bwaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene nigo agogete koa amachiiko aye okobua na ogosikwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abanto aba baibirwe na gosakorwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bonsi bategirwe na kogwa ase chiirima;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo babisire ase chinyomba chi’obosibwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bairirwe, onde tari orabatoorie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boosirwe, onde tari ogoteeba: “Tiga bairanigwe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o ase more oranyare gotegerera amang’ana aya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio ayarengererie na koyaigwera ase chingaki chigochi‐gocha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oruete abanto b’ororeeria rwa Yakobo ase amaboko ’abasakori?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oruete Abaisraeli ase amaboko ’abauri?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Tari Omonene oria twakorete ebibe asare?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tokaanga kobwatia chinchera chiaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende tokaanga koigwera amachiiko aye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio Omonene akaumora ekeririanda kiaye ase abanto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.25",
            "verseOrgIds": [
              "ISA.42.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "akabaumorera endamwamu yaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.25",
            "verseOrgIds": [
              "ISA.42.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekobera, na esegi entindi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.25",
            "verseOrgIds": [
              "ISA.42.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto bakaba bagosambwa nomorero ase chinsemo chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.25",
            "verseOrgIds": [
              "ISA.42.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
