          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abe chinsinyo chi’ense,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.22",
            "verseOrgIds": [
              "ISA.45.22"
            ]
