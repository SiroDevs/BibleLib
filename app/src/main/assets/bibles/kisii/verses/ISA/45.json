  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "ISA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene ochorire Koresi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene ochorire Koresi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omobwatire okoboko kwaye gw’okorio,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amobuere ebisaku na aure abarwoti okobua kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Amoigorere ebisieri, na ebiita tibisiekwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Bono aya nar’Omonene akomoteebia:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche nintang’ane bosio bwao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninyaranie ebitunwa na ebigoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbuna‐bune ebiita bie chitaai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbutorane emekorogoto y’ebioma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninkoe chinibo chibisire ase omosunte,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na obotenenku bore aase abobisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde onyare komanya ng’a inche ninche Omonene, Nyasae bw’Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngokorangeria ase erieta riao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ngokorangeria ase erieta riao",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase engencho ya Yakobo, omosomba one,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ase engencho ya Israeli, omochore one.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nakoeire erieta ri’amasikani, nonya aye tomanyeti inche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche ninche Omonene, onde tari;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae onde tari otatiga inche bweka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo nakoboyirie chinguru nonya aye tomanyeti inche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ngokora ayio, erinde abanto bamenyete moocha na bosongo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "banyare komanya ng’a onde tari otatiga inche bweka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche ninche Omonene, na onde tari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninche Omotongi bw’oborabu na omosunte,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo nkorenta omorembe, narenta na amabe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche ninche Omonene, ngokora ayio onsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe igoro chionsi, tonyia amatoima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oboronge tiga borwe igoro, botwe buna amare agotwa embura;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ense tiga emaanoke, eichorwe nogotooreka na oboronge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche Omonene natongire ayio.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene bw’obotongi na obw’amang’ana agokoreka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obobe nobw’oyio okoamererania n’Omotongi oye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio ore ekegonkorio ase egati y’ebinde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Esike neborie omooroisia iga:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninki eke okoroisia?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose ekeroisirie ngetebie omooroisia iga:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye tobwati amaboko?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obobe nobw’oyio okoboria ise:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
            "verseOrgIds": [
              "ISA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inki aye okoibora?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
            "verseOrgIds": [
              "ISA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose koboria ng’ina:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
            "verseOrgIds": [
              "ISA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inki eke obogoretie inda yao ogochia koibora?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
            "verseOrgIds": [
              "ISA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene, oyore Omochenu bw’Abaisraeli na Omotongi obo, agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Mborie inche igoro y’amang’ana agochia koba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ntige inyechandere abana baane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera abwo nemeremo y’amaboko aane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninche natongete ense,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ngatonga na abanto, nkababeeka aroro;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaboko aane naro aramborete igoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio ngachiika erioba, na omotienyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne ching’enang’eni, kera ekemo kebeere aase aye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche Omonene naimokirie Koresi ase oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nindongeyie chinchera chiaye chionsi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere naagache omochie one,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nasibore abanto baane boosetwe barue ase obosomba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tagoakanwa kende, gose koegwa ng’eria ende.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene bw’Emeganda nere oteebire ayio.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Abamisiri ne chinibo chiabo bechanderete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Abaetiopia na oboonchoreria bwabo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto ba Seba bare abatambe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bonsi mbache asore, babe abao amo ne chinibo chiabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Barabwo mbagotunyane basibire chingataare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "batung’ame asore, bagosabe, bateebe:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekeene, Nyasae nigo are ime yao, onde tari,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nyasae onde tari otatiga ere bweka.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Nyasae bw’Abaisraeli, aye Omotooria,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.15",
            "verseOrgIds": [
              "ISA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekeene, aye naye Nyasae ore bobisi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.15",
            "verseOrgIds": [
              "ISA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bonsi bakoroisia emegwekano egosasimwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbasookigwe na gotantanigwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, bonsi pi mbasookigwe na goichana mono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisraeli mbatoorigwe n’Omonene ase ogotoorigwa gwa kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.17",
            "verseOrgIds": [
              "ISA.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe Abaisraeli timogosookigwa, gose gotantanigwa kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.17",
            "verseOrgIds": [
              "ISA.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oyio otongete igoro chionsi, nere Nyasae,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nere otongete ense akayebeeka oboroso obokong’u.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tayetongete ng’a ebe bosa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ayetongete emenywe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aya nar’Omonene agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Inche ninche Omonene, nyasae ende teiyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche Omonene tinakwanete aase abobisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose ase ense y’omosunte;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tinatebeetie abanto b’ororeeria rwa Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a bandigie bosa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche Omonene nigo ngokwana ayare ay’ekeene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koraria ayare ay’oboronge.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene bw’ense na emegwekano y’ogosasimwa ya Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abamore abatigari korwa ase ebisaku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
              "ISA.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "sangererekana amo mosuke gocha ang’e!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
              "ISA.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto abwo bakobogoria emegwekano egosasimwa eroisirie korwa ase emete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
              "ISA.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bagendererete gosaba chinyasae chitanyare kobatooria,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
              "ISA.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibari nokomanya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
              "ISA.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raria na morente amang’ana aino!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga bagambere amang’ana abo amo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oyakwanete agwo kare?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o oyaraaretie kare?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Tari inche Omonene nayakwanete?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche nigo inde Nyasae omonyene oboronge na Omotooria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
