      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ring’ana riarure ase omonwa one ase oboronge, tirikoonchoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.23",
            "verseOrgIds": [
              "ISA.45.23"
            ]
