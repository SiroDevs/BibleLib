      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oboronge ne chinguru nigo bire ase Omonene bweka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.24",
            "verseOrgIds": [
              "ISA.45.24"
