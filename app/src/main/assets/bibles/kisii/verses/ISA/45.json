      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Kera riru naribekwe inse ase obosio bwane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.23",
            "verseOrgIds": [
              "ISA.45.23"
