          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netianirie inche omonyene;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.23",
            "verseOrgIds": [
              "ISA.45.23"
            ]
