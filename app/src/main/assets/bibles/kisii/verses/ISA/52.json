{
  "id": "ISA.52",
  "number": "52",
  "bookId": "ISA",
  "reference": "Isaya 52",
  "copyright": "© 2021 KENBS",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "ISA 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae natoorie Sayoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Sayoni, imoka, bwebeke chinguru, imoka!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, aye Yerusalemu, omochie omochenu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "eboyie chianga chiao chinseera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korwa bono abanto batarogeti na abatachenegeti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibagosoa ime yao nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Yerusalemu, esamunse korwa ase orotu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tenena na oikaranse aase ao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abanto ba Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "esibore amakorogoto mwasiberetwe ase amagoti aino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba: Inwe nigo mwaoonetigwe timwaakaneretwe kende, na nigo moraboorigwe motari goakanerwa chitaabu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, aya nar’Omonene agoteeba: Abanto baane nigo bagendete Misiri agwo kare, bakaba abamenyi aroro, na Abaasuri bakabachanda engencho ende etarengeo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, Omonene nigo agoteeba iga: Bono ninki imbwate aiga ekero abanto baane bairirwe obosomba engencho ende etaiyo? Ee, Omonene nigo agoteeba iga: Abagaambi abwo bakobachanda nigo bakobaakera amariogi, na erieta riane nigo richayire omobaso boira kogenderera botambe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, abanto baane mbamanye erieta riane; ee, ase ayio, ase rituko riria mbamanye ng’a ninche Omonene ngokwana, inche nao inde aa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naki amagoro abo are amaseera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakorenta amang’ana amaya, bagoeta igoro ase ebitunwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakoraria omorembe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na barenta obotomwa obore namang’ana amaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo bakoraria ogotooreka, bateebia Sayoni:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Nyasae oo nere okogaamba.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwa, abarendi baino ngoaka bare eriogi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bonsi amo nigo bagotera nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "barorire namaiso abo buna Omonene akoirana gocha Sayoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe amatombe a Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tera amo namariogi amanene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene oremirie abanto baye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "obooririe Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene oorokirie okoboko kwaye ogochenu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase amaiso ebisaku bionsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinsinyo chionsi chi’ense nchirore ogotooreka kwa Nyasae oito.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe aba mokobogoria ebikorero bi’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "imoka, morue aase aa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timobaisa gokuna egento getachenegeti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "soka korwa ase egati y’omochie",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo, mwechene inwe abanyene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero morasoke korwao, timokoayerera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timogotama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene natang’ane bosio bwaino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ere Nyasae bw’Abaisraeli nababwatie korwa magega abe obarendete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omosomba bw’Omonene ochandegete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Omosomba one naseseneke ase ogokora kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.13",
            "verseOrgIds": [
              "ISA.52.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nakinigwe na koimokererigwa igoro, nabe omonene mono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.13",
            "verseOrgIds": [
              "ISA.52.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abange nigo baichanete ase engencho yaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.14",
            "verseOrgIds": [
              "ISA.52.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera ekieni kiaye nigo giasaretigwe bobe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.14",
            "verseOrgIds": [
              "ISA.52.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goetania eki’onde bwensi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.14",
            "verseOrgIds": [
              "ISA.52.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omobere oye tororekanete buna oyo o Mwanyabaanto.",
