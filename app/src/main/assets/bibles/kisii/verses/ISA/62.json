  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "62",
        "style": "c",
        "sid": "ISA 62"
      },
      "items": [
        {
          "text": "62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho ya Sayoni tinkonyara gokira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase engencho ya Yerusalemu tingotimoka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "goika oboronge bwaye bororekane buna okobara kwe risase,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogotooreka kwaye kororekane kore buna ekemore kegwoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto b’ebisaku mbarore oboronge bwao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abarwoti bonsi barore obonene bwao;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio aye orokwe erieta riyia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rirarue ase omonwa bw’Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nobe egutwa enseera y’obonene ere ase okoboko kw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na esombe y’omogaambi ere ase okoboko kwa Nyasae oo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokogenderera korokwa “Oyotigetwe”,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense yao tekogenderera korokwa “Eyetigire bosa”,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende norokwe “Oyo inche Omonene nagokigwe nere”,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense yao nerokwe “Eye enyuomire”,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene nigo agokirie naye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense yao nenyuomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna omomura akonyuoma omoiseke omwekuungi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo na abamura bao barakonyuome;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna omonywomi akogokera omoriakari oye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naboigo Nyasae oo arakogokere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Yerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabekire abarendi igoro ase chindwaki chiao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo tibagokira nonya ng’ake, omobaso na obotuko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe aba mokomorangeri’Omonene mokonywe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timobaisa gokira gose gotimoka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na timotiga Omonene atimoke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "goika abe oiraneirie Yerusalemu amaya aye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na koyokora obe ogotogigwa ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene orire eira na gotiana oramborete okoboko kwaye gw’okorio,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase okoboko kwaye gw’okobua, ogoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Tinkorua endagera yao ng’ee ababisa bao bayerie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abanto b’ebisaku ebiaao tibakonywa edivai yao gwakoreire emeremo emekong’u.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taibo, korende abwo barayegese nabwo barayerie, erio batogie Omonene;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na abwo baratore amasabibu nabwo baranywe edivai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agwo ase chigoora chi’Aase aane Aachenu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eta, eta, mosoere ase ebiita,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "moroiserie abanto enchera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ticha enchera eyio eimokerere igoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "rusia amagena korwa aroro;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tenenia ekemanyererio abanto bakerore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Omonene oraririe amang’ana ase ense yonsi, ogoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Teebia abanto ba Sayoni ng’a ogotooreka kwaino kwabereire ang’e;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene ngocha are obwate eng’eria yaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okonyora kwaye nigo gotang’aine bosio bwaye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabwo mbarokwe “Abanto abachenu”,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.12",
            "verseOrgIds": [
              "ISA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na “Ababoorigwe n’Omonene,”",
          "type": "text",
