          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene, ekero baarenge nemechando nigo bakorigetie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero kwabaete egesusuro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo bagosabeete mono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo twabeete asore buna omokungu ore morito,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okobina aibore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero engaki yaye yaikire, nigo akoromwa nobororo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intwe twabeire tore barito,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "twabeire tokobina na kweganchorana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ekero twaiborete tokaibora embeo bosa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Titorenteti ogotooreka konde ase ense,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose abanto tibaiboretwe ase ense.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto baino bakwete mbabe moyo naende;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emebere y’abakwete neboke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abwo moraire ase amaroba ime,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boka, motere nomogooko!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Riime riao nigo rire eri’oborabu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "riroba ndibairanie abakwete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ekiina na ogokorwa oboyia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto baane, inchwo mosoe ase chiero chiaino mwesiekere aroro; mwebise aroro ase engaki enke, goika endamwamu eyio ebe yaetire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.20",
            "verseOrgIds": [
              "ISA.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, Omonene ngosoka are korwa aase aye, ae abanto bamenyete ase ense egesusuro ase engencho y’ebibe biabo. Okomocha kw’ogoiterwa kw’amanyinga ase ense nkobe maiso marore, na ense tekogenderera kobisa abanto abwo baitetwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
          }
        }
      ]
    }
