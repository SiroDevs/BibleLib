  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "ISA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amang’ana akoremia abanto ba Sayoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe aba mokorigia oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, inwe aba mokondigia inche Omonene, tegerera monyigwe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigereria egetare ase mwabaachetwe korwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ee, rigereria Aburaamu, sokoro yaino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na engoro ase mwakunyetwe korwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Sara oyo obaiborete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ekero Aburaamu arenge bweka, nigo namorangeretie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkamosesenia, nkamomentekania.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene naremie Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naremie abatigarete bare ase amaturi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Naroisie aase aye abeete erooro, abe buna omogondo o Edeni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense enyomo yaye ebe buna omogondo Omonene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omogoko na omochengo mbibe bikoigweka ime yaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo okoiraneria ng’a mbuya mono, na amatera ay’ogotogia, mbibeo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto baane, inyigwere;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe abanto b’egesaku kiane, tegerera monyigwe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nindue ogochika kwane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oboronge bwane mbobe omobaso ase abanto bonsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboronge bwane nigo bore ang’e,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogotooreka kwane ngocha kore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaboko aane nagambie abanto bonsi ekiina kia boronge;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abanto bamenyete ase ebisinka na ase chinse chire ang’e nenyancha nigo bang’anyete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "basemerie okoboko kwane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imokia amaiso aino morigererie igoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende morigererie ense inse aa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Igoro chionsi nchisire buna erioki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense negote buna eanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abanto bamenyeteo nigo barakwe buna ebichuni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende ogotooreka kwane nkogenderere kobao kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oboronge bwane tibokoera nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abamomanyete oboronge, ntegerera moigwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe aba amachiiko aane are ime ase chinkoro chiaino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timoiroka abwo bakobachaya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose timoondoka ekero bakobachecheria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigwankwa mbirie abanto abwo buna bikoria chianga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amakonde nabarie buna akoria amarionya e ching’ondi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende oboronge bwane nigo boragenderere kobao kare na kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ogotooreka kwane ase ebiaare bionsi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye okoboko kw’Omonene, imoka, bwebeke chinguru, imoka!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Imoka buna kwaimogete ase amatuko a kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, imoka buna kwaimogete ase ebiaare bia kare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Tari aye kwanachanete Rahabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okabeta enchoka eria?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Tari aye gwakametie amaache ’enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.10",
            "verseOrgIds": [
              "ISA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "amaache e chindiba chintambe chi’enyancha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.10",
            "verseOrgIds": [
              "ISA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio okaroisia enchera aroro, erinde ababooretigwe bakaambokerao?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.10",
            "verseOrgIds": [
              "ISA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 51:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatooretigwe n’Omonene mbairane, bache Sayoni bagotera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "omogooko o kare na kare nobe igoro ase emetwe yabo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbabe nomogooko na omochengo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Obororo na omoichano mbiere kegima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 51:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche ninche nkobaremia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.12",
            "verseOrgIds": [
              "ISA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye naye ng’o okoiroka Mwanyabaanto abwo bagokwa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.12",
            "verseOrgIds": [
              "ISA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Mwanyabaanto abwo bagosira buna obonyansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.12",
            "verseOrgIds": [
              "ISA.51.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 51:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye kwebire Omonene, Omotongi oo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.13",
            "verseOrgIds": [
              "ISA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio bwarete igoro, na akabeeka oboroso bw’ense.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.13",
            "verseOrgIds": [
              "ISA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omobaso boira aye nigo ogendererete kwoboa ekeririanda ki’omochandi oo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.13",
            "verseOrgIds": [
              "ISA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna nigo are ang’e kogoseria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.13",
            "verseOrgIds": [
              "ISA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Korende ng’ai ekeririanda ki’omochandi kere?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.13",
            "verseOrgIds": [
              "ISA.51.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 51:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oria bwosetwe na agasibwa nasiborwe bwango;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.14",
            "verseOrgIds": [
              "ISA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere tagokwa na koirwa ase embeera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.14",
            "verseOrgIds": [
              "ISA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na takoborwa endagera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.14",
            "verseOrgIds": [
              "ISA.51.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 51:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inche ninche Omonene, Nyasae oo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.15",
            "verseOrgIds": [
              "ISA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo ngoturubania enyancha, emerindo yaye yaba ekoeera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.15",
            "verseOrgIds": [
              "ISA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene bw’Emeganda, nario erieta riane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.15",
            "verseOrgIds": [
              "ISA.51.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 51:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabekire amang’ana aane ase omonwa oo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.16",
            "verseOrgIds": [
              "ISA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende nakobisire ase ekiriri gi’okoboko kwane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.16",
            "verseOrgIds": [
              "ISA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nindambore igoro mbeeke oboroso bw’ense,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.16",
            "verseOrgIds": [
              "ISA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninteebie abanto ba Sayoni:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.16",
            "verseOrgIds": [
              "ISA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe nabaanto baane.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.16",
            "verseOrgIds": [
              "ISA.51.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omoerio bw’emechando ya Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 51:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe abanto ba Yerusalemu, boka, imoka motenene!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.17",
            "verseOrgIds": [
              "ISA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe mwanyure korwa ase okoboko kw’Omonene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.17",
            "verseOrgIds": [
              "ISA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "egekombe ki’endamwamu yaye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.17",
            "verseOrgIds": [
              "ISA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe mwanyure korwa ase egekombe ekio,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.17",
            "verseOrgIds": [
              "ISA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mwanyuereranirie eturubo mwatindire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.17",
            "verseOrgIds": [
              "ISA.51.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 51:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase abamura bonsi aiborete onde tari okomoraa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.18",
            "verseOrgIds": [
              "ISA.51.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase abwo arerete, onde tari okomobwata okoboko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.18",
            "verseOrgIds": [
              "ISA.51.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 51:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang’ana aya abere akonyorire:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ogosirigwa na ogotigwa bosa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ogoitwa nenchara na emioro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o orakororere amabeebe?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Gose ning’o orakoremie?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.19",
            "verseOrgIds": [
              "ISA.51.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 51:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamura bao bagoyire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.20",
            "verseOrgIds": [
              "ISA.51.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo baraire ase amatabeekania e chinchera chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.20",
            "verseOrgIds": [
              "ISA.51.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna chingabi chiabwatirwe nemeeto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.20",
            "verseOrgIds": [
              "ISA.51.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Omonene oo obeire nendamwamu ase bare, obaeire egesusuro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.20",
            "verseOrgIds": [
              "ISA.51.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 51:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio, aye ochandegete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.21",
            "verseOrgIds": [
              "ISA.51.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye gwatindire, ko tari ase ogotinda kw’edivai, igwa amang’ana aya:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.21",
            "verseOrgIds": [
              "ISA.51.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 51:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene agoteeba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio ore Omonene, Nyasae oo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "okorwanerera abanto baye:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Naama, narusirie korwa ase amaboko ao egekombe ekio okonywera na gotinda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "egekombe ki’endamwamu yane togokenywera naende.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 51:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egekombe ekio ninkebeke ase amaboko ay’abakogochanda,",
          "type": "text",
