{
  "id": "ISA.44",
  "number": "44",
  "bookId": "ISA",
  "reference": "Isaya 44",
  "copyright": "© 2021 KENBS",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "ISA 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene nere bweka ore Nyasae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye Yakobo, omosomba one,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.1",
            "verseOrgIds": [
              "ISA.44.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Israeli nagochorire, bono igwa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.1",
            "verseOrgIds": [
              "ISA.44.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, oria ogotongete ase enda ya nyoko, naende okogokonya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Aye Yakobo, omosomba one,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye Yerusalemu, omochore one, toiroka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ning’umore amaache ase abare nerang’o,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nintubokie chindooche ase ense enyomo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’umore Omoika one igoro ase abanto b’ororeeria rwao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninsesenie abana bao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwo mbakine buna obonyansi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.4",
            "verseOrgIds": [
              "ISA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "bakine buna emesobeti ere ase chindooche mbarabare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.4",
            "verseOrgIds": [
              "ISA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyomo nateebe ng’a noyo bw’Omonene are,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oyonde eroke erieta ria Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na oyonde arike ase okoboko kwaye ng’a ere noyo bw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio eroke Omoisraeli, erieta ri’ogosikwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene, omorwoti bw’Abaisraeli na Omobooria obo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.6",
            "verseOrgIds": [
              "ISA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyore Omonene b’Emeganda, agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.6",
            "verseOrgIds": [
              "ISA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ninche oyo bw’eritang’ani, na oyo bw’omoerio;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.6",
            "verseOrgIds": [
              "ISA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onde tari, otatiga inche bweka inde Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.6",
            "verseOrgIds": [
              "ISA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o oranyare kobana buna inche,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.7",
            "verseOrgIds": [
              "ISA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "buna nabaanete korwa ekero keria nabegete abanto abwo ba kare?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.7",
            "verseOrgIds": [
              "ISA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Tiga ararie amang’ana ayio na koyanyorokia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.7",
            "verseOrgIds": [
              "ISA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Oyio tiga ateebie abanto amang’ana are bosio agochia gokoreka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.7",
            "verseOrgIds": [
              "ISA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoiroka, gose kwoboa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Tinabateebeetie amang’ana ayio korwa kare na kobayamanyia?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe nigo more birori baane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inee! Nyasae onde nareo, otatiga inche?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Getare kende tikeri. Nimanyete ng’a kende tikeri.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Emegwekano y’ogosasimwa egochaywa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto abwo bonsi bakoroisia emegwekano y’ogosasimwa nigo bare bosa, na emegwekano eyio teri kobarentera buya bonde. Abwo bakoyebera birori tibakorora, gose tibakomanya gento kende; ase igo mbasookigwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o okwebaachera enyasae na kwebombera ogosasimwa bitari gokonya nonyang’ake?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Abatunyani bonsi b’emegwekano eyio mbasookigwe, na abakoyeroisia nigo bare Mwanyabaanto. Abwo bonsi tiga basangererekane amo, bache bosio; bonsi amo nigo baraondoke, basooke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoturi ebioma nigo akobogoria enturago yaye otura ekioma. Nigo agokebeeka igoro ase omorero bw’amakara, ogesamba, erio okebomba ase ogokebaraga nokoboko kwaye kore ne chinguru. Ekero agendererete koroisia omogwekano oyio, nigo akoba nenchara na erang’o ogoya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omosenia chibao nigo akorambora ekerengo, bwata omong’ororia nekaramu ase ebao. Erio oyesenia neranda, oyeng’ororia ekeringerera, naende oyebaacha yaba omogwekano bw’omonto omonyakieni, oyobeeka nyomba ime.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonto nigo akogenda ase rinani ogecha emecharake, gose bwechorera Emealuni, oyetiga egokina agwo ase rinani, gose bwesimekera omobunduki, embura yaba ekoyokinia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omote oria gokinire nigo okoba chinko chi’omonto oria; ere nigo akonyonacha ekeng’ese outera omorero agwota na korugera endagera, na ekeng’ese kende okebacha kiaba enyasae agosasiima, nigo gekoba omogwekano ere oba okoyosasiima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ekeng’ese kende omonto oria nigo agoutera omorero, osambera chinyama, ochiria na koigota, na ekero autire omorero oria nigo agoteeba, “Ee, bono nabeire ne riberera; omorero oyo nomuya!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeng’ese egetigari ki’omote oria nigo agokebaacha ogekora enyasae, omogwekano agosasiima; nigo agotungama bosio bwaye oyosasiima oteeba, “Ntoorie, ekiagera naye enyasae yane!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto bagokora ayio nabariri, tibamanyeti kende. Amaiso abo aukoire, tibakonyara korora, na ebirengererio biabo biasarigwe, tibakonyara komanya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.18",
            "verseOrgIds": [
              "ISA.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monto onde tari ase abwo okorengereria mono, gose ore nobong’aini na okomanya erinde ateebe: “Ekeng’ese ki’omote oyio nageutera omorero, nkayorugera endagera, boigo nkayosambera chinyama nkaria. Inee! Korwa ase ekio egetigari ningekore egento gi’okogechia? Ningekore enyasae ngosasiima, eroisirie korwa ase omote?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.19",
            "verseOrgIds": [
              "ISA.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyio nigo asemeretie ayare buna ribu; enkoro yaye yang’ainekire, yamosiririe, takonyara gwetooria na goteeba, “Egento eke mbwate koboko kwane gw’okorio neki’oborimo.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene nere Omotongi na Omotooria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe abanto ba Yakobo, inwe Abaisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inyora amang’ana aya, ekiagera inwe nabasomba baane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe Abaisraeli, tinkobeeba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natinyirie ogosaria kwaino buna ngotinyia riire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.22",
            "verseOrgIds": [
              "ISA.44.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ebibe biaino buna ngotinyia ritaturi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.22",
            "verseOrgIds": [
              "ISA.44.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ing’iranere, ekiagera nababooririe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.22",
            "verseOrgIds": [
              "ISA.44.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwe igoro chionsi, tera nomogooko, ekiagera Omonene oikeranirie ayio;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naye ense yonsi, aka eriogi ri’omochengo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe ebitunwa, na amanani, na kera omote ore aroro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tera nechinguru chinyinge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekiagera Omonene obooririe abanto ba Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "neorokie ase egati y’Abaisraeli ore nobonene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nar’Omonene, Omobooria oo, oyogotongete ase enda ya nyoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "agoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Ninche Omonene natongete ebinto bionsi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche bweka naramborete igoro chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkaara ense gochia chinsinyo chionsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na onde tarengeo onkonyete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo ngosaria ebimanyererio bi’ababani b’oborimo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gokora abaringoria baba chiosi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nigo nkoirania magega obong’aini bw’abang’aini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na gokora okomanya kwabo kwaba oboriri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.25",
            "verseOrgIds": [
              "ISA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inche nigo ngokora ring’ana ri’omosomba one riaba ne chinguru",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na goikerania emeroberio y’abatomwa baane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche ngoteeba igoro ya Yerusalemu ng’a nomenywe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na igoro y’emechie y’Abayuda ng’a neagachwe naende;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche ndatenenie amaagacho ayio agwete inse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.26",
            "verseOrgIds": [
              "ISA.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninche ngoteeba igoro ye chindiba chie chinyancha ng’a chiome pa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.27",
            "verseOrgIds": [
              "ISA.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche ndakamie chindooche chiaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.27",
            "verseOrgIds": [
              "ISA.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ngoteeba igoro ya Koresi ng’a namobekire abe omorisia bw’abaanto baane;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.28",
            "verseOrgIds": [
              "ISA.44.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere naikeranie ogwancha kwane gwonsi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.28",
            "verseOrgIds": [
              "ISA.44.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ateebe igoro ya Yerusalemu ng’a oagachwe naende,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.28",
            "verseOrgIds": [
              "ISA.44.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende ateebe igoro ye Hekalu ng’a oboroso bwaye bobekwe naende.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.28",
            "verseOrgIds": [
              "ISA.44.28"
            ]
          }
        }
      ]
    }
  ],
