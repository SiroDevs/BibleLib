{
  "id": "ISA.41",
  "number": "41",
  "bookId": "ISA",
  "reference": "Isaya 41",
  "copyright": "© 2021 KENBS",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "ISA 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nyasae okoenekeria Abaisraeli ng’a nigo are amo nabarabwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe ebisinka ne chinse chire ang’e nenyancha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.1",
            "verseOrgIds": [
              "ISA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mokire‐kiri, montegerere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.1",
            "verseOrgIds": [
              "ISA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga abanto b’ebisaku banyore chinguru chinyia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.1",
            "verseOrgIds": [
              "ISA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga basuke gocha ang’e, bakwane;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.1",
            "verseOrgIds": [
              "ISA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "toche amo, toike ang’e ase ekiina.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.1",
            "verseOrgIds": [
              "ISA.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ning’o orangeretie n’oboronge oyomo korwa moocha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oria oumeranete nobobui aande onsi ase agendete?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ere nigo akobeeka abanto b’ebisaku inse y’okobua kwaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde atachere abarwoti inse y’amagoro aye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyio nigo agoita abanto b’ebisaku n’omoro, obakora baba buna orotu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ase obota bwaye nigo akobasiarera buna obonyansi obwomo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.2",
            "verseOrgIds": [
              "ISA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo akobabwatia, oeta na orendire buya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.3",
            "verseOrgIds": [
              "ISA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ase chinchera atana goeta rinde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.3",
            "verseOrgIds": [
              "ISA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o okorete na goikerania aya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.4",
            "verseOrgIds": [
              "ISA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ning’o orangeretie ebiaare bi’abaanto korwa omochakano?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.4",
            "verseOrgIds": [
              "ISA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche Omonene, ninche oyo bw’omochakano;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.4",
            "verseOrgIds": [
              "ISA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche oyo bw’omoerio, ninche Ere.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.4",
            "verseOrgIds": [
              "ISA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisinka ne chinse chire ang’e nenyancha chiarorire ayio chiamwoboire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.5",
            "verseOrgIds": [
              "ISA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chinsinyo chi’ense nigo chigotengechigwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.5",
            "verseOrgIds": [
              "ISA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "chiasukire gocha ang’e.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.5",
            "verseOrgIds": [
              "ISA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera omonto nigo agokonya omogisangio oye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.6",
            "verseOrgIds": [
              "ISA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyomo oteebiaoyonde, “Kabe omoremu!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.6",
            "verseOrgIds": [
              "ISA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omosenia bwe chibao nigo akobeeka omoturi bw’etaabu omokia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.7",
            "verseOrgIds": [
              "ISA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na omoturi ebioma obeeka omoturagi chinguru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.7",
            "verseOrgIds": [
              "ISA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oteeba, “Oborembo bw’okobwatania nobuya.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.7",
            "verseOrgIds": [
              "ISA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Erio babwatania omogwekano nemesumari tonyegera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.7",
            "verseOrgIds": [
              "ISA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Korende inwe Abaisraeli, abasomba baane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.8",
            "verseOrgIds": [
              "ISA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe nabaanto ba Yakobo nachorete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.8",
            "verseOrgIds": [
              "ISA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inwe nigo more ab’ororeeria rwa Aburaamu, omosani one.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.8",
            "verseOrgIds": [
              "ISA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo nabarusetie korwa ase chinsinyo chi’ense,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.9",
            "verseOrgIds": [
              "ISA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkabarangeria korwa ase chinsinyo chi’aare mono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.9",
            "verseOrgIds": [
              "ISA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nkabateebia: Inwe nabasomba baane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.9",
            "verseOrgIds": [
              "ISA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nabachorire, timbaangeti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.9",
            "verseOrgIds": [
              "ISA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase ayio timoiroka, inche nigo inde amo nainwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.10",
            "verseOrgIds": [
              "ISA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "timoichana, inche ninche Nyasae oino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.10",
            "verseOrgIds": [
              "ISA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbabeeke chinguru, mbakonye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.10",
            "verseOrgIds": [
              "ISA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbasiire nokoboko gw’okorio kw’oboronge bwane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.10",
            "verseOrgIds": [
              "ISA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rora, abwo bonsi baabagechete mbasookigwe na gotantanigwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.11",
            "verseOrgIds": [
              "ISA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo bakobaengereria mbabe bosa basirigwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.11",
            "verseOrgIds": [
              "ISA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo morabarigie abwo bakobasoera, ko timokobanyora;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.12",
            "verseOrgIds": [
              "ISA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "abwo baarenge kobarwania nigo barabe bosa kegima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.12",
            "verseOrgIds": [
              "ISA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninche Omonene, Nyasae oino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.13",
            "verseOrgIds": [
              "ISA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nimbabwate amaboko aino a borio.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.13",
            "verseOrgIds": [
              "ISA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche nkobateebia inwe: Timoiroka, nimbakonye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.13",
            "verseOrgIds": [
              "ISA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inwe ororeeria rwa Yakobo ronga buna rikonde, inwe ekeombe egeke ki’Abaisraeli, timoiroka!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.14",
            "verseOrgIds": [
              "ISA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inche Omonene nimbakonye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.14",
            "verseOrgIds": [
              "ISA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche Omochenu bw’Abaisraeli inde Omobooria oino.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.14",
            "verseOrgIds": [
              "ISA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nab’Omonene atebiire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.14",
            "verseOrgIds": [
              "ISA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rora, nimbakore inwe mobe egekorero gi’okoora, kere ekiya na kere namaara amoge; inwe moore ebitunwa, mobisamunyore, imokore ebigoro bibe buna omoiriro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.15",
            "verseOrgIds": [
              "ISA.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobisiare, na omwaga obirurukie gochia aare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.16",
            "verseOrgIds": [
              "ISA.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio ekembugu‐mbugu kebisiarere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.16",
            "verseOrgIds": [
              "ISA.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Inwe abanyene mogoke ase Omonene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.16",
            "verseOrgIds": [
              "ISA.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na komwetogeria oyore Omochenu bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.16",
            "verseOrgIds": [
              "ISA.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekero abataka na abaremeire barabe bakorigia amaache na tibayanyora,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.17",
            "verseOrgIds": [
              "ISA.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero chimeme chiabo chirabe chiabwatanire namang’ang’ura;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.17",
            "verseOrgIds": [
              "ISA.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche Omonene nimbaigwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.17",
            "verseOrgIds": [
              "ISA.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inche Nyasae bw’Abaisraeli tinkobatiga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.17",
            "verseOrgIds": [
              "ISA.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindete chindooche korwa ase ebigoro ebiomo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.18",
            "verseOrgIds": [
              "ISA.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ne chinsoko nchituboke ase amagoko ime;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.18",
            "verseOrgIds": [
              "ISA.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ning’onchore erooro ebe ritibo ri’amaache,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.18",
            "verseOrgIds": [
              "ISA.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na ense enyomo ebe ne chinsoko chire namaache.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.18",
            "verseOrgIds": [
              "ISA.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimerie emecharake ase erooro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.19",
            "verseOrgIds": [
              "ISA.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "boigo nimerie aroro emekonge, na emeadasi, na emezeituni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.19",
            "verseOrgIds": [
              "ISA.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ee, nimerie emetarakwa na emete",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.19",
            "verseOrgIds": [
              "ISA.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ende egwekaine emeuru, na emebeno amo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde abanto mbarore na komanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende mbaarengererie bamanye bonsi amo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ng’a nokoboko kw’Omonene gwakorire ayio,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, ere oyore Omochenu bw’Abaisraeli nere otongete ebio bionsi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omonene okoamererania ne chinyasae chi’oborimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonene, Omorwoti bw’abaanto ba Yakobo, nigo agoteeba iga:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.21",
            "verseOrgIds": [
              "ISA.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Renta amang’ana aino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.21",
            "verseOrgIds": [
              "ISA.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "renta oborori bwaino botoenekerie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.21",
            "verseOrgIds": [
              "ISA.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga baborente bototeebie aya agochia koba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tiga bototeebie amang’ana a kare buna arenge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde tonyare koyarengereria",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na komanya buna aikeranetigwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "naende botoorokerie buna amang’ana agochia koba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toteebie aya agochi‐gocha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde tomanye ng’a inwe ne chinyasae;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kora amang’ana amaya, gose amabe erinde tokorora ayio tokumie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Inwe nigo more bosa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
            "verseOrgIds": [
              "ISA.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kegima, na emeremo yaino nero mbosa kegima;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
            "verseOrgIds": [
              "ISA.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "oyo obachorire inwe na kobasasiima nigo are okogechia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
            "verseOrgIds": [
              "ISA.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inarangeretie omonto korwa sugusu, ere ochire;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.25",
            "verseOrgIds": [
              "ISA.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, nigo namorusirie korwa moocha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.25",
            "verseOrgIds": [
              "ISA.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ere narangerie erieta riane akonywe, natiringere abagaambi inse buna esike egotiringwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.25",
            "verseOrgIds": [
              "ISA.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na buna omokori chinyongo agotiringa esike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.25",
            "verseOrgIds": [
              "ISA.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning’o obaanete amang’ana ayio agwo kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.26",
            "verseOrgIds": [
              "ISA.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erinde tonyare komanya ng’a amang’ana oyio ateebete n’ayoboronge?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.26",
            "verseOrgIds": [
              "ISA.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Onde tari nonya noyomo oyaorogetie na koyararia;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.26",
            "verseOrgIds": [
              "ISA.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "onde tari oigwete komokoyakwana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.26",
            "verseOrgIds": [
              "ISA.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninche Omonene nigo narenge omotang’ani goteebia Sayoni:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.27",
            "verseOrgIds": [
              "ISA.41.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigereria, morore abwo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.27",
            "verseOrgIds": [
              "ISA.41.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ninche narenterete Yerusalemu abwo bararetie amang’ana amaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.27",
            "verseOrgIds": [
              "ISA.41.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekero narigereretie tinaroche monto onde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.28",
            "verseOrgIds": [
              "ISA.41.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nonya nase egati yabo mosemia onde tarengeo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.28",
            "verseOrgIds": [
              "ISA.41.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ekero naboretie, onde tarengeo ongiraneretie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.28",
            "verseOrgIds": [
              "ISA.41.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naama! Chinyasae echio chionsi mbosa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.29",
            "verseOrgIds": [
              "ISA.41.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Emeremo eyio y’abanto nigo ere bosa kegima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.29",
            "verseOrgIds": [
              "ISA.41.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ee, emegwekano eyio abanto babombete nigo enga embeo bosa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.29",
            "verseOrgIds": [
              "ISA.41.29"
            ]
          }
        }
      ]
    }
