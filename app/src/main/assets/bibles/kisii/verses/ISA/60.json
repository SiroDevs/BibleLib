        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "monto onde tarenge goeta ime yao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.15",
            "verseOrgIds": [
              "ISA.60.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende bono ningokore obe nobonene goika kare na kare,",
