    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "emetarakwa na emeuru, na emebunduki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nerentwe gochabera aase Obomenyo bwane Obochenu bore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na inche ninkore aase amagoro aane agotenena abe nobonene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.13",
            "verseOrgIds": [
              "ISA.60.13"
            ]
          }
        }
      ]
    },
    {
