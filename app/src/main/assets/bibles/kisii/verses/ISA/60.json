      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbakoroke Omochie bw’Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.14",
            "verseOrgIds": [
              "ISA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Sayoni bw’Oyore Omochenu bw’Abaisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.14",
            "verseOrgIds": [
              "ISA.60.14"
            ]
          }
