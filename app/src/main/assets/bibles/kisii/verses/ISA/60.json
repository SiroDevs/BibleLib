          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nigo kwarenge omochie otigetwe na kogechwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.15",
            "verseOrgIds": [
              "ISA.60.15"
            ]
