          "attrs": {
            "verseId": "ISA.60.19",
            "verseOrgIds": [
              "ISA.60.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na Nyasae oo nabe obonene bwao bokomeka‐meka.",
