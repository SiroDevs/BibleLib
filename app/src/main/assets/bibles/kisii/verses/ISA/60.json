      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nogonke korwa ase ebikuba bi’abarwoti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.16",
            "verseOrgIds": [
              "ISA.60.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "aye nomanye ng’a inche Omonene, ninche Omotooria oo,",
