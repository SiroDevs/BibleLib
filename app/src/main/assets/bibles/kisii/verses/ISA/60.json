      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "ninche Omobooria oo, Omobui o Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.16",
            "verseOrgIds": [
              "ISA.60.16"
            ]
          }
        }
      ]
