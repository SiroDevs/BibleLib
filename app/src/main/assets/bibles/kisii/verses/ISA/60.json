    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "mbache asore bagotung’amere na koumama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.14",
            "verseOrgIds": [
              "ISA.60.14"
            ]
          }
