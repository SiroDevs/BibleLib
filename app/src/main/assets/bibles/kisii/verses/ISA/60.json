    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Abwo bonsi bagochayete mbatung’ame ase amagoro ao;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.14",
            "verseOrgIds": [
              "ISA.60.14"
            ]
          }
        }
      ]
    },
