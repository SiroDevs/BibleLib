      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose omotienyi togokoa oborabu ase obotuko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.19",
            "verseOrgIds": [
              "ISA.60.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "korende Omonene nere orabe omobaso oo o kare na kare;",
