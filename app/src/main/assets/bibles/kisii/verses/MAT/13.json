{
  "id": "MAT.13",
  "number": "13",
  "bookId": "MAT",
  "reference": "Matayo 13",
  "copyright": "© 2021 KENBS",
  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MAT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omerenganio bw’omobusuri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 4:1-9; Luk 8:4-8)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase rituko riria riria Yeso akarua nyomba agaikaransa ase enyancha mbarabare.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.1",
            "verseOrgIds": [
              "MAT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeganda emenene ekamosangererekanera, goika ere akariina obwato ime, agaikaransa aroro, na omoganda bwonsi ogatenena ase engegu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.2",
            "verseOrgIds": [
              "MAT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia amang’ana amange ase emebayeeno, okobora, “Omobusuri akamanora kogenda kobusura.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.3",
            "verseOrgIds": [
              "MAT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero are kobusura, chimbusuro chinde chikagwa ase enchera ensemo, chinyoni chigaacha, chigachiria,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.4",
            "verseOrgIds": [
              "MAT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na echinde chikagwa ase egetare, aase amaroba arenge amake; chikamera bwango, ekiagera amaroba arenge amake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.5",
            "verseOrgIds": [
              "MAT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobaso ogachia kobara, chigasusana, na ekiagera chitarenge nemeri, chikooma.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.6",
            "verseOrgIds": [
              "MAT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na echinde chikagwa ase amagwa ime, na amagwa aria agakiina, agachimiga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.7",
            "verseOrgIds": [
              "MAT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na echinde chikagwa ase amaroba amaya, chikaama echinde rigana, na echinde emerongo etano nomo, na echinde emerongo etato.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.8",
            "verseOrgIds": [
              "MAT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyore namato akoigwera, tiga aigwe!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ekerenga ki’ogokwana ase emebayeeno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 4:10-12; Luk 8:9-10)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aborokigwa baye bagaacha, bakamoboria, “Nase ki kware gokwana nabarabwo ase emebayeeno?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.10",
            "verseOrgIds": [
              "MAT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabairaneria, Inwe mwaeirwe komanya obobisi bw’oborwoti bwa igoro, korende barabwo tibaeiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.11",
            "verseOrgIds": [
              "MAT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki oyore na gento naegwe, nere namenteranigwe; korende oyotabwati gento naurwe nonya nkeria abwate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.12",
            "verseOrgIds": [
              "MAT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eke nakio gekogera ngokwana nabarabwo ase emebayeeno, ekiagera okorigereria ’nabarigererie, korende tibakorora, na ogotegerera nabategerere, korende tibakoigwa, nonya nokomanya, tibakomanya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase barabwo obobani bwa Isaya bwaikeranire, obogoteeba:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Okoigwa namoigwe, korende timokomanya nonya ng’ake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na okorigereria namorigererie, korende timokorora nonya ng’ake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki chinkoro chi’ abanto aba chiabeire chinyoro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amato abo nigo are amarito ase okoigwa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na amaiso abo bayamiamirie,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "tibacha korora namaiso abo",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose koigwa namato abo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "gose bamanye ne chinkoro chiabo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "baonchoke, na inche mbagwenie",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende amaiso aino nasesenirie, ekiagera nkorora are, na amato aino, ekiagera nkoigwa are.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.16",
            "verseOrgIds": [
              "MAT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekeene nabateebirie: Abaabani abange na abanyene oboronge mbaganetie korora aya morooche inwe, tibayarora, na koigwa aya mokoigwa inwe, tibayaigwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ogotebereria kw’omobayeeno bw’omobusuri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 4:13-20; Luk 8:11-15)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gaki, igwa omobayeeno bw’omobusuri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.18",
            "verseOrgIds": [
              "MAT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero omonto akoigwa ring’ana ri’oborwoti, na ere takorimanya, nigo agocha oria omobe, otaboria riria riasimekirwe ase enkoro yaye, oyo nere obusuirwe ase enchera ensemo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.19",
            "verseOrgIds": [
              "MAT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyo obusuirwe ase egetare nere oria okoigwa ring’ana, erio kegima oribwata nomogooko,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.20",
            "verseOrgIds": [
              "MAT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende tari nemeri ime yaye, ogenderera ekero egeke; na ekero emechando egochi‐gocha, gose okorosigwa ase engencho ye ring’ana, erio bwango ogwa korwa ase okwegena kwaye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.21",
            "verseOrgIds": [
              "MAT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyo obusuirwe ase amagwa, oyo nere okoigwa ring’ana; okorengereria gw’ense na obong’ainereria bw’eniibo biaba nkomiga bire ring’ana, riaba tirikwama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.22",
            "verseOrgIds": [
              "MAT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyo obusuirwe ase amaroba amaya, nere oria okoigwa ring’ana, orimanya; nere ekeene bwama okwama. Oyomo bwama rigana, na oyonde emerongo etano nomo, na oyonde emerongo etato.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobayeeno bw’amabanchore",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia omobayeeno onde, agateeba, “Oborwoti bwa igoro nigo bogwekaine nomonto obusurete embusuro engiya ase omogondo oye;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.24",
            "verseOrgIds": [
              "MAT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende ekero abanto bararire, omobisa oye agacha akabusura amabanchore ime ase engano, akagenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.25",
            "verseOrgIds": [
              "MAT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egachia komera ekama chinyeke, erio amabanchore naro akarorekana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.26",
            "verseOrgIds": [
              "MAT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio abasomba b’omonyene enyomba bagaacha, bakamobooria: Omonene, tikwabusurete embusuro engiya ase omogondo oo? Inaki rende ororekanire namabanchore?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.27",
            "verseOrgIds": [
              "MAT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia: Nomobisa okorete ayio. Abasomba bakamobooria: Inee! Norigetie tochie toyasimore?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabakania: Yaya; moise koyasimora amabanchore namoiye engano amo naro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.29",
            "verseOrgIds": [
              "MAT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitige bikiine bionsi bibere goika rigesa, na ekero kie rigesa ninteebie abakogesa: Ritang’ani sangereria amabanchore, moyaboe emesaima monyare koyasamba; korende engano moyesangererie gochia kiage kiane.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobayeeno bw’entetere y’Omosirapi na oyo bw’ememera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 4:30-34; Luk 13:18-21)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia omobayeeno onde, agateeba, “Oborwoti bwa igoro nigo bogwekaine nentetere y’omosirapi omonto abogoretie, akayesimeka ase omogondo oye;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.31",
            "verseOrgIds": [
              "MAT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ero nenke mono kobua chimbusuro chionsi, korende koyakiinire yaba enene kobua ebimeri bionsi, eba omote, goika chinyoni chia igoro chichia koroisia ebiswa ase chinsagia chiaye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia omobayeeno onde, “Oborwoti bwa igoro nigo bogwekaine nememera omokungu abogoretie, akayebeka ase ebirengo bitato bi’obosie, goika bionsi bikabota.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya onsi Yeso nigo ayakwanete ase emeganda eria ase emereng’anio; na tabateebeetie ring’ana otatiga ase emebayeeno,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.34",
            "verseOrgIds": [
              "MAT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "erinde rinyare goikeranigwa eriatebetwe nomobani,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "“Nimaanore omonwa one ase emebayeeno,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "inyatore ayabisegete korwa ogotongwa gw’ense.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobayeeno bw’amabanchore ogotebererigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yeso agatiga emeganda, akagenda nyomba. Aborokigwa baye bakamochiera, bakobora, “Totebererie omobayeeno bw’amabanchore a mogondo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.36",
            "verseOrgIds": [
              "MAT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akairaneria, “Oyogosimeka embusuro engiya n’Omwana-o-Mwanyabaanto;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.37",
            "verseOrgIds": [
              "MAT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "omogondo nense; embusuro eyio engiya nabana b’oborwoti; na amabanchore nabwo abana boria omobe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.38",
            "verseOrgIds": [
              "MAT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omobisa oria oyasimegete nere Saitani; rigesa nomoerio bw’ense, na abaraache kogesa nabamalaika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.39",
            "verseOrgIds": [
              "MAT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buna amabanchore agosangererigwa asambwa nomorero, naboigo nomoerio bw’ense orache koba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.40",
            "verseOrgIds": [
              "MAT.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana-o-Mwanyabaanto natome abamalaika baye, na barabwo nabasangererie na kobarusia korwa ase oborwoti bwaye abakogera abande bagochwe, na abagokora ebibe bonsi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.41",
            "verseOrgIds": [
              "MAT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nababatugute ase eriiko ri’omorero. Aroro agwo abanto inababe nekerero na okoriania amaino.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.42",
            "verseOrgIds": [
              "MAT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio abanyene oboronge nabagirigente buna erioba",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        },
        {
          "text": "ase oborwoti bwa Ise obo. Oyore namato akoigwera, tiga aigwe",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Emereng’anio y’eniibo, eruru, na ekeonga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oborwoti bwa igoro nigo bogwekaine neniibo yabisire ase omogondo, eye omonto anyorete, akayebisa; erio ase omogooko oye akagenda, akaoonia ebi abwate bionsi, akagora omogondo oria.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.44",
            "verseOrgIds": [
              "MAT.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naende oborwoti bwa igoro mbogwekanirie nomonto omoonchoreria, okorigia chiruru chingiya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.45",
            "verseOrgIds": [
              "MAT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere agachia korora eruru eyemo ye rigori rinene, akaimoka akagenda, akaoonia ebi abwate bionsi, akayegora.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
            "verseOrgIds": [
              "MAT.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naende oborwoti bwa igoro nigo bonga buna ekeonga ekiarutetwe ase enyancha ime, kegasangereria chinswe chia kera egesaku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.47",
            "verseOrgIds": [
              "MAT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero giaichoire, abanto bagakeng’usa gocha engegu; bagaikaransa, bagasangereria chiria chingiya ase amakuru",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.48",
            "verseOrgIds": [
              "MAT.13.48"
            ]
          }
        },
        {
          "text": ", na chiria chimbe bagachituguta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.48",
            "verseOrgIds": [
              "MAT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo eraache koba ase omoerio bw’ense. Abamalaika nabaoroke bache gwatanana baria ababe korwa ase abanyene oboronge,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.49",
            "verseOrgIds": [
              "MAT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "babatugute ase eriiko ri’omorero. Aroro agwo abanto inababe nekerero na okoriania amaino",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akababoria, “Mwamanyire aya onsi?” Bakamoiraneria, “Ee.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Ase engencho eyio kera Omwarimu bw’amariiko oyokorirwe koba omworokigwa bw’oborwoti bwa igoro, obeire omogwekano bw’omonyene enyomba, oyokorua ase emonga yaye ebinto ebiyia na ebikoro.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okwangwa Nazareti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 6:1-6; Luk 4:16-30)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso akoorire emebayeeno eyio, akarua aroro, akagenda aase aande.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.53",
            "verseOrgIds": [
              "MAT.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agachia goika ense yaye omonyene",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.54",
            "verseOrgIds": [
              "MAT.13.54"
            ]
          }
        },
        {
          "text": ", akaborokereria ase esinagogi yabo, goika bagakumia, bagateebania, “Oyo ng’ai anyorire obong’aini obo na ogokora oko gwe chinguru?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.54",
            "verseOrgIds": [
              "MAT.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo tari omwana bw’omobaachi? Ngi’na tari oria okorokwa Mariamu? Na bamura bamwabo tibari Yakobo, na Yusufu na Simioni, na Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.55",
            "verseOrgIds": [
              "MAT.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na basubati bamwabo bonsi tibari aa seito? Gaki oyo ng’ai ayanyorire aya onsi?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.56",
            "verseOrgIds": [
              "MAT.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "MAT 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakagechigwa asare. Korende Yeso akabateebia, “Omobani takoborwa ogosikwa otatiga ase abanto baye na ime ase ense yaye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere takorete amakumia amange agwo, ekiagera batarenge nokwegena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.58",
            "verseOrgIds": [
              "MAT.13.58"
            ]
          }
        }
      ]
