{
  "id": "MAT.20",
  "number": "20",
  "bookId": "MAT",
  "reference": "Matayo 20",
  "copyright": "© 2021 KENBS",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Abaremi ase omogondo bw’emesabibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inaki oborwoti bwa igoro nigo bogwekaine",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "text": "n’omonto omonyene enyomba oyosoogete mambia chuni kogenda koriika abaremi ase omogondo oye bw’emesabibu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agancherana nabaremi kobaakana edinari eyemo ase rituko, erio akabaira ase omogondo oye bw’emesabibu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.2",
            "verseOrgIds": [
              "MAT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agasoka chinsa isato, akarora abande bateneine echiiro, batari nemeremo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabateebia nabarabwo: Genda nainwe ase omogondo one bw’emesabibu na inche nimbae ekebagwenerete. Bakagenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agasoka naende chinsa isano nemo, ne chinsa kianda, agakora boigo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goika chinsa ikomi nemo agasoka, akarora abande bateneine, akababoria nabarabwo: Ninki mwatenenera aa bwaira, motari nameremo?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.6",
            "verseOrgIds": [
              "MAT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoiraneria: Ekiagera monto onde tatoriigeti. Akabateebia: Genda nainwe boigo ase omogondo one bw’emesabibu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.7",
            "verseOrgIds": [
              "MAT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero riagorobire, omonyene omogondo agateebia omoteneneri oye: Rangeria abaremi, obae eng’eria yabo, ochaakere korwa abamagega goika ab’eritang’ani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.8",
            "verseOrgIds": [
              "MAT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero baria barigetwe chinsa ikomi nemo baachete, bakanyora kera oyomo edinari eyemo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ekero ab’eritang’ani bacha, bagakaga ng’a barabwo nabaegwe kobua abande, bakanyora nabarabwo kera oyomo edinari eyemo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio kabaeirwe, bakaba nkwemurungania bare ase omonyene enyomba,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakaboora: Abwo ba magega nigo bakora emeremo y’ensa eyemo yoka, na aye kwabatoreng’aneria naintwe abatwaremereretie emechando ne riberera ri’omobaso bwonsi?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.12",
            "verseOrgIds": [
              "MAT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere akairaneria oyomo obo: Omosani, tingokorereti bobe. Titwancheranete naye ase edinari eyemo?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwata ekere ekiao, ogende; nindigetie koa oyo o magega koreng’ana naye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Tindi neribaga gokora buna ndigetie omonyene n’ebinto biane? Gose naki okorigereria neriso riibe, ekiagera inche inde omuya?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.15",
            "verseOrgIds": [
              "MAT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboigo abamagega inababe ab’eritang’ani, na ab’eritang’ani inababe abamagega.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogokwana eriagatato igoro y’ogokwa kwaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 10:32-34; Luk 18:31-34)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo, ekero Yeso arenge gotiira gochia Yerusalemu, akabaira aborokigwa baye ikomi na babere ensemo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobare inchera, akabateebia, “Rora, ngotiira tore gochia Yerusalemu, na Omwana-o-Mwanyabaanto naruugwe ase amaboko y’abakuani abanene na aborokia b’amariiko, na barabwo ’nabamonachere ekiina ki’ogokwa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naende nabamorue ase amaboko y’ abanto b’Ebisaku; nakorerwe echeche, naende naakwe emecharichi na kobambwa; na ase rituko ria gatato nabokigwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoboria koegwa ogosika gw’ense eye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 10:35-40)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio ng’ina abana ba Zebedi akamochiera Yeso amo nabana baye, akamotung’amera na komosaba ring’ana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamobooria, “Inki origetie?” Akamoiraneria, “Chiika ng’a abana bane babere baikaranse, oyomo ensemo y’okoboko kwao gw’okorio, n’oyonde ensemo y’okoboko kwao gw’okobee ase oborwoti bwao.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akairaneria, “Inwe timomanyeti eri mogosaba. Inee! Namonyare konywera egekombe ’ndache konywera inche?” Bakamoteebia, “Natonyare.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Egekombe ’nkonywera inche, namokenywere, korende ribaga ri’ogoikaransa ensemo y’okoboko kwane gw’okorio ney’okobee, tindi nokobua gw’okobaa, otatiga abwo bagacheire na Tata one nabwo barariegwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Obonene bw’ekeene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 10:41-45)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero baria ikomi bachia koigwa aya, bakababea abamura baria babere.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yeso akabarangeria bache asare, akabora, “Mwamanyire ng’a abagaambi b’Ebisaku bakogaambera abanto, na abanene babo nigo bare n’okobua igoro ase bare.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ase more inwe, ayio takoba bo. Korende, oyorarigie koba omonene ase more, goika abe omokoreri oino;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na oyorarigie koba omotang’ani ase more, goika abe omosomba oino,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "buna Omwana-o-Mwanyabaanto atachete gokorerwa, korende gokorera, na korua obogima bwaye, erinde bobe embooria y’abange.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia abanto babere emeuko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 10:46-52; Luk 18:35-43)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero baare korua Yeriko, omoganda omonene okamotunyana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, abanto babere emeuko baikaransete ase enchera ensemo, na ekero bachia koigwa Yeso ogoeta, bagaaka eriogi, bakaboora, “Omonene omwana o Daudi! Tororere amaabera.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoganda oria okabatogonyera ng’a banyare gokira, korende bakamenta kwoga mono, bakaboora, “Omonene, tororere amaabera, aye Omwana o Daudi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso agatenena, akabarangeria, akababoria, “Ninki morigetie mbakorere?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoiraneria, “Omonene, otoramokie amaiso aito.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso agasogwa namaabera, agakuna amaiso abo. Erio kegima bakarora, bakamotunyana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
