{
  "id": "MAT.21",
  "number": "21",
  "bookId": "MAT",
  "reference": "Matayo 21",
  "copyright": "© 2021 KENBS",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "MAT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogochengerwa kagosoa Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 11:1-11; Luk 19:28-40; Yoh 12:12-19)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero bachia goika ang’e na Yerusalemu, bagaika Betifage, ase egetunwa ki’Emezeituni. Erio Yeso agatoma aborokigwa baye babere,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabateebia, “Genda ase ekenyoro keria kere bosio bwaino, erio kegima namorore etigere esibire, na emori yaye amo nero; mochisibore mochindetere.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na omonto karabateebie ring’ana, momoteebie: Omonene nachiganetie; erio kegima nachitome.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya onsi agakoreka, erinde anyare goikeranigwa ayatebetwe nomobani, ogoteeba,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebia abanto ba Sayoni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigereria, Omorwoti oino nkobaachera are,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nomokanyeku, oriinire etigere,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "nase emori y’etigere, akamori g’etigere.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aborokigwa bakagenda, bagakora buna Yeso abachiigete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.6",
            "verseOrgIds": [
              "MAT.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamorentera etigere amo nemori yaye, bakaara chianga chiabo igoro ya chirochio, na Yeso akayeriina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.7",
            "verseOrgIds": [
              "MAT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abange b’emeganda bakaara chianga chiabo inchera; abande bakanacha chinsagia chi’emete bagachiaara nchera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.8",
            "verseOrgIds": [
              "MAT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeganda eria yatang’aine, na eyare komotunyana, bagaaka eriogi, bagateeba, “Hosana ase Omwana o Daudi! Nasesenirie oyio ogocha ase erieta ri’Omonene! Hosana, aye ore igoro mono!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero achia gosoa Yerusalemu, omochie omogima ogasega‐sega, abanto bakabooria, “Ning’o oyio?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.10",
            "verseOrgIds": [
              "MAT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeganda ekairaneria, “Oyio nere Yeso, omobani o Nazareti ya Galili.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogochena Hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 11:15-19; Luk 19:45-48; Yoh 2:13-22)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erio Yeso agasoa ase Hekalu ya Nyasae, akabasokia isiko bonsi abarenge koonia na kogora ime ase Hekalu, akaonchorana chimesa chi’abaare koonchoreria chitaabu, na ebirogo bi’abaare koonia amaruma.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabateebia, “Neriikire: Enyomba y’ane nerokwe enyomba y’ogosaba, na inwe mwayekorire koba ribwago ri’abauri.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeuko na amagata bakamochiera aria ase Hekalu, na ere akabagwenia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abakuani abanene na aborokia b’amariiko bakabea, ekero bachia korora ebirage bi’ogokumia akorete, na abana bagoaka eriogi ase Hekalu ime, bakobora, “Hosana ase Omwana o Daudi!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamobooria, “Kwaigure abana buna bakobora?” Yeso akabateebia, Ee; timwana gosoma:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Nase emenwa y’abana na ey’abakogonka",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "kwerenteire ogotogia ogoikeranu?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabatiga, agasoka korwa ase omochie, akagenda Bethania, akarara aroro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omoko omogomba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 11:12-14,20-26)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambia gakoirana omochie, akaigwa enchara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarora omoko oyomo ase enchera ensemo, akayochiera, tarora gento asoro otatiga amato oka. Akayoteebia, “Korwa bono tokwama amatunda nonya ndinde.” Erio kegima omoko oyio okoma.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero aborokigwa bachia korora ogokora oko, bagakumia, bakabooria, “Inaki bono omoko oyo bwoma bwango iga?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabairaneria, “Nekeene nabateebirie; Komorabe nokwegena motabeti na tangutangu chinde, tari erio ri’omoko rioka morakore, korende ’namoteebie egetunwa eke: Tegoka, otugutwe enyancha ime, na rikoreke.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kende gionsi moraborie ase ogosaba, komoregeene namokenyore.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Riborio igoro y’okobua kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 11:27-33; Luk 20:1-8)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero achia gosoa Hekalu ime na kworokereria, agachierwa nabakuani abanene na etureti",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.23",
            "verseOrgIds": [
              "MAT.21.23"
            ]
          }
        },
        {
          "text": "y’abanto, bakamobooria, “Nase okobua ki ogokora amang’ana aya? Ning’o okoete okobua oko?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.23",
            "verseOrgIds": [
              "MAT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabairaneria, “Nainche boigo nimbaboorie ring’ana erimo, komorang’iranerie, nainche boigo nimbateebie nase okobua ki ngokora aya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.24",
            "verseOrgIds": [
              "MAT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Ebatiso ya Yohana, ng’ai yarwete? Igoro yarwete, gose nase Mwanyabaanto?” Bagateebania barabwo ase barabwo, bakaboora, “Toise goteeba: Niigoro yarwete, igo aratoborie: Inaki rende motamwegenete?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende toise goteeba: Nase Mwanyabaanto yarwete, nkoiroka tore omoganda, ekiagera abanto bonsi banchete ng’a Yohana nomobani orenge.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.26",
            "verseOrgIds": [
              "MAT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoiraneria, “Titomanyeti.” Ere akabateebia, “Nonya ninche tinkobateebia inwe nase kobua ki ngokora aya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobayeeno bw’abana babere abamura",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inaki morooche? Omonto gete narenge nabana babere abamura. Akamochiera oria bw’eritang’ani, akamoteebia: Omwana one, genda reero okore emeremo ase omogondo bw’emesabibu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.28",
            "verseOrgIds": [
              "MAT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamoiraneria: Tindigeti kogenda, korende magega yaye akaonchoka, akagenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.29",
            "verseOrgIds": [
              "MAT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamochiera oy’okabere, akamoteebia boigo. Nere akamoiraneria: Nkogenda inde, omonene; ko tagenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.30",
            "verseOrgIds": [
              "MAT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Norori ase baria babere okorete ogwancha gwa ise?” Bakaboora, “Noria bw’eritang’ani.” Yeso akabateebia, “Nekeene nabateebirie ng’a abarusia ebango na abakungu abatayayi nkobatang’anera bare gosoa ase oborwoti bwa Nyasae.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki Yohana nigo achete ase more ase enchera y’oboronge, timwamwegena; korende abarusia ebango na abakungu abatayayi bakamwegena; na inwe nonya nekero mwaroche ayio, timwaonchoka na komwegena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Omobayeeno bw’omogondo bw’emesabibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 12:1-12; Luk 20:9-19)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tegerera omobayeeno onde. Narenge omonto omonyene omochie; ere akarema omogondo, agasimeka emesabibu imeo, akayoetananeria orobago, agakuunya ime aroro egeteera akomitera amasabibu, akaagaacha orwaki, akaywatananera abaremi, akagenda orogendo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero engaki y’amatunda yachia goika ang’e, agatoma abasomba baye ase abaremi, banyore amatunda aye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.34",
            "verseOrgIds": [
              "MAT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaremi bakabwata abasomba baye, oyomo bakamoaka, oyonde bakamoita, na oyonde bakamoaka amagena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.35",
            "verseOrgIds": [
              "MAT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naende agatoma abasomba bande, abange kobua baria b’eritang’ani; bakabakorera boigo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.36",
            "verseOrgIds": [
              "MAT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omoerio oye agatoma omwana oye ase bare, ogoteeba: Inabasike omwana one.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.37",
            "verseOrgIds": [
              "MAT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende abaremi baria, ekero bachia korora omwana oria, bagateebania barabwo ase barabwo: Oyo nere omonyamwando; gaki tomoite, omwando oye toyoire.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.38",
            "verseOrgIds": [
              "MAT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamobwata, bakamotuguta isiko korwa ase omogondo bw’emesabibu, bakamoita.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inee! Karache omonyene omogondo, naki arakore abaremi baria?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamoteebia, “Igo araite abamwamu baria ogoita okobe, na aatananere abaremi bande omogondo oria bw’emesabibu, abarache komoa amatunda ekero amire.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabateebia, Timwana gosoma ase amariiko:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Rigena riria abaagachi bangete",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "riabeire rigena rinene ri’ekoona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "Ring’ana eri nigo riarure ase Omonene,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na rirorio nogokumia ase amaiso aito?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ase engencho eye nabateebirie, ng’a oborwoti bwa Nyasae naborusigwe ase more, boegwe egesaku egekwama amatunda aye. [",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyoragwe igoro ase rigena eri nabunekane, na ere oyo rigena riria riragwere inarimosenyente.]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero abakuani abanene na Abafarisai bachia koigwa emebayeeno yaye, bakamanya ng’a nabwo agoteeba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekero bachia korigia komobwata, bakairoka emeganda, ekiagera abanto konya banchire ng’a ere nomobani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
    }
  ],
