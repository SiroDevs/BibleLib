{
  "id": "MAT.8",
  "number": "8",
  "bookId": "MAT",
  "reference": "Matayo 8",
  "copyright": "© 2021 KENBS",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MAT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia omonto orenge noborwaire bwa ukoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 1:40-45; Luk 5:12-16)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso achia gotirimboka korwa ase egetunwa igoro, emeganda emenge ekamotunyana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.1",
            "verseOrgIds": [
              "MAT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, omonto orenge noborwaire bwa ukoma akamochiera, akamotung’amera, akamoteebia, “Omonene, oise gwancha nabo ogonsibia.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.2",
            "verseOrgIds": [
              "MAT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akarambora okoboko kwaye, akamokuna, akamoteebia, “Nanchire; sibeka.” Erio agwo oborwaire bwaye bwa ukoma bogasibigwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.3",
            "verseOrgIds": [
              "MAT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoteebia, “Rigereria, toteebia monto onde ing’ana; korende genda, bweorokie ase Omokuani, orue ekeng’wanso egiachigetwe na Musa, erinde kebe kirori ase abanto.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia Omosomba bw’omotang’ani bw’abarwani rigana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Luk 7:1-10)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso achia gosoa Kapernaumu, omotang’ani bw’abarwani rigana akamochiera, akamosorora,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "agateeba, “Omonene, omosomba one nyomba araire, oborwaire bomogataetie, akoromwa mono.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.6",
            "verseOrgIds": [
              "MAT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoteebia, “Ninchiche komogwenia.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.7",
            "verseOrgIds": [
              "MAT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oria omotang’ani bw’abarwani rigana akamoiraneria, “Omonene, inche tinyisaini aye orasoe inse y’ekerama kiane; korende kwana ring’ana rioka, na omosomba one nagwene.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.8",
            "verseOrgIds": [
              "MAT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inaki inche nomonto inde inse ase okobua, naende ninde nabarwani inse ase ’nde. Kondateebie oyo: Genda, ogenda; na oyonde: Inchuo, ocha; na omosomba one: Kora iga, okora.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.9",
            "verseOrgIds": [
              "MAT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso amoigwa agakumia, agateebia abamotunyanete, “Nekeene nabateebirie: Nonya nase Abaisraeli tindanyora okwegena okore buna oko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.10",
            "verseOrgIds": [
              "MAT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabatebirie ng’a abange nabache korwa moocha na bosongo, ’nabaikaranse ase emesa na koria amo na Aburaamu, na Isaka, na Yakobo, ase oborwoti bwa igoro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.11",
            "verseOrgIds": [
              "MAT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "korende abana b’oborwoti ’nabatugutwe isiko ase omosunte; na aroro abanto mbabe nekerero na okoriania amaino",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.12",
            "verseOrgIds": [
              "MAT.8.12"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.12",
            "verseOrgIds": [
              "MAT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso agateebia omotang’ani oria bw’abarwani rigana, “Genda bwoo, nabe ase ore koreng’ana nokwegena kwao.” Omosomba oria akagwenigwa ase ekero keria.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia Abanto abange",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 1:29-34; Luk 4:38-41)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso asoete nyomba mwa Petero, akarora ng’ina biara Petero oraire, orwarete esosera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamokuna okoboko kwaye. Esosera ekamotiga, na ere akaimoka akamokorera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.15",
            "verseOrgIds": [
              "MAT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riachia koba mogoroba, bakamoirera abanto abange ababwatire nebirecha, na ere akarusia ebirecha ase ring’ana, na bonsi abarenge abarwaire akabagwenia;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "rinyare goikerana eriatebetwe nomobani Isaya, ogoteeba, “Ere akaimokia oboreu bwaito, na akabogoria amarwaire aito.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Amateemwa ase abwo barigetie koba aborokigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Luk 9:57-62)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bono ekero Yeso achia korora emeganda emenge yamoetananire, agachiika ng’a baimoke korwa aroro bagende ng’umbu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.18",
            "verseOrgIds": [
              "MAT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omworokia oyomo bw’amariiko akamochiera, akamoteebia, “Omworokia, ningotunyane aande onsi ase okogenda.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
              "MAT.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akamoteebia, “Ebibwe mbire namakuruma, ne chinyoni chia igoro nchire nebiswa, korende Omwana‐o‐Mwanyabaanto tari nase akobeeka omotwe oye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na oyonde ase aborokigwa baye akamoteebia, “Omonene, ritang’ani ing’a ribaga ngende gotindeka tata”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
              "MAT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende Yeso akamoteebia, “Ntunyana, tiga abakuure batindeke abakuure babo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso ogotoereria omwaga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 4:35-41; Luk 8:22-25)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero Yeso achia koriina obwato, aborokigwa baye bakamotunyana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.23",
            "verseOrgIds": [
              "MAT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rora, omwaga omonene okaimoka ase enyancha, goika obwato bogatubwa nemerindo; korende ere konya oraarire.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.24",
            "verseOrgIds": [
              "MAT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamochiera, bakamotura, bakamoteebia, “Omonene, totoorie, ngosira tore!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.25",
            "verseOrgIds": [
              "MAT.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabateebia, “Inaki mokwoboa, inwe abamore nokwegena ogoke?” Erio akaimoka, agatogonyera omwaga na enyancha; gokaba ogotoerera okonene.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanto baria bagakumia, bagateeba, “Monto ki oyo, nonya nomwaga na enyancha bikomoigwera?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yeso okogwenia Abageraseni abwo Ebirecha biabwatete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Mar 5:1-20; Luk 8:26-39)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekero achia goika ng’umbu y’ense y’Abageraseni, abanto babere ababwatire nebirecha bakaumerana nere, na barabwo nigo baare korwa ase chimbeera, nigo barenge abatindi mono, goika monto onde tarenge konyara goeta enchera eria.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rora, barabwo bagaaka eriogi bakaboora, “Inki obwate naintwe, Omwana o Nyasae? Inee! Ngwachire aiga gotoita ekero engaki etaraika?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ang’e nagwo ndiarengeo riicho rie chimbeche chinyinge, riare korisia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.30",
            "verseOrgIds": [
              "MAT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebirecha biria bikamosorora, bikabora, “Onye kogotorusia aa, rirorio toe ribaga tosoe ase riicho rie chimbeche.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso akabiteebia, “Genda!” Bigasooka, bigasoa ase chimbeche. Na rora, riicho rionsi rigatirimboka, rigasoa enyancha ime, rigasirera aroro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abarisia b’echimbeche chiria bagatama, bakagenda omochie bakararia amang’ana onsi ayakoregete ase baria babwatire nebirecha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.33",
            "verseOrgIds": [
              "MAT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rora, abanto bonsi b’omochie oria bakagenda koumerana na Yeso; bagachia komoorora, bakamosorora arue orogongo rwabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.34",
            "verseOrgIds": [
              "MAT.8.34"
            ]
          }
        }
      ]
    }
