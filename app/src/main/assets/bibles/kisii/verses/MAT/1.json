{
  "id": "MAT.1",
  "number": "1",
  "bookId": "MAT",
  "reference": "Matayo 1",
  "copyright": "© 2021 KENBS",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Chisokoro ne chisokoororia chia Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Luk 3:23-38)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo noro omoroberio bw’echisokoro chia Yeso Kristo korwa ase ororeria rwa Daudi, oyio orenge korwa ase ororeria rwa Aburaamu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korwa ase Aburaamu goika omorwoti Daudi akaibora Isaka, na Isaka akaibora Yakobo, na Yakobo akaibora Yuda na abamwabo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yuda akaibora Peresu na Zera ase Tamari, na Peresu akaibora Hezironi, na Hezironi akaibora Aramu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Aramu akaibora Aminadabu, na Aminadabu akaibora Nashoni, na Nashoni akaibora Salimoni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Salimoni akaibora Boazi ase Rahabu, na Boazi akaibora Obedi ase Rutu, na Obedi akaibora Yese,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yese akaibora omorwoti Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "text": "Na Daudi akaibora Sulemani ase oyio orenge omokungu o Uria,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Sulemani akaibora Rehoboamu, na Rehoboamu akaibora Abiya, na Abiya akaibora Asa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Asa akaibora Yehosafati, na Yehosafati akaibora Yoramu, na Yoramu akaibora Usia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Usia akaibora Yotamu na Yotamu akaibora Ahasi, na Ahasi akaibora Hezekia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hezekia akaibora Manase, na Manase akaibora Amoni, na Amoni akaibora Yosia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yosia akaibora Yekonia na abamwabo ase chingaki chiria Abaisraeli basakoretwe na kong’anyigwa gochia Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na magega ko Abaisraeli basakoirwe na kong’anyigwa gochia Babiloni Yekonia akaibora Salatieli, na Salatieli akaibora Serubabeli,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Serubabeli akaibora Abihudi, na Abihudi akaibora Eliakimu, na Eliakimu akaibora Azoro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Azoro akaibora Zadoki, na Zadoki akaibora Akimu, na Akimu akaibora Eliudi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Eliudi akaibora Eleazari, na Eleazari akaibora Matani, na Matani akaibora Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yakobo akaibora Yusufu, omosacha o Mariamu oyo oiborete Yeso, oyio okorokwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ebigori bionsi korwa Aburaamu goika Daudi nigo biarenge ebigori ikomi na bine: na korwa Daudi goika ogosakorwa na okong’anyigwa kwa Abaisraeli gochia Babiloni, n’ebigori ikomi na bine: na korwa ogosakorwa na okong’anyigwa kwa Abaisraeli gochia Babiloni goika Kristo, nebigori ikomi na bine.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Okoiborwa kwa Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Luk 2:1-7)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoiborwa kwa Yeso Kristo nigo kwarenge iga: Ekero Mariamu ng’ina konya ariereirwe boko na Yusufu, na konya bataramenyana buna omosacha n’omokuungu, Mariamu akarorekana ore morito ase chinguru chi’Omoika Omochenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nigo arenge omonto omooronge, na tarigetie komoa obosooku, maiso marore, ase igo akaroberia amotige bobisi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende ekero arenge orengereretie aya, rora, omomalaika bw’Omonene akamochiera ase chindoto akamoteebia. “Aye Yusufu, korwa ase ororeria rwa Daudi, toiroka koira Mariamu abe mokao, ekiagera nigo abeire morito ase okobua kw’Omoika Omochenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere naibore omwana omoisia, nomoroke erieta riaye Yeso, ekiagera nere oratoorie abanto baye korwa ase ebibe biabo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya onsi nigo abeire, erinde riikerane ring’ana riria riakwanetwe n’Omonene goetera ase omonwa bw’omobani:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rigereria, omoiseke omwekungi nabe morito,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "erio aibore omwana omoisia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "na erieta riaye narokwe Imanueli”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "text": "(engencho yaye: Nyasae nare naintwe).",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yusufu agachia kobooka korwa ase chitoro, akanywoma Mariam buna omomalaika bw’Omonene konya amoteebirie akore.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.24",
            "verseOrgIds": [
              "MAT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korende konya tibaramanyana kemobere nyuma ataraibora omwana oye omoisia. Naende Yusufu akamoroka erieta riaye Yeso.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.25",
            "verseOrgIds": [
              "MAT.1.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "MAT.2",
    "number": "2",
    "bookId": "MAT"
  },
