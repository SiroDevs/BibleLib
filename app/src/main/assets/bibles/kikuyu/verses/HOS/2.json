              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ha ũhoro wa ariũ a thoguo, meere atĩrĩ, ‘Inyuĩ mũrĩ andũ akwa’, na ha ũhoro wa aarĩ a thoguo, ũmeere atĩrĩ, ‘Inyuĩ mũrĩ endwa akwa’.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeli Kũherithio na Gũcookererio",
          "type": "text"
        }
      ]
    },
