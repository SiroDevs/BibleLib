{
  "id": "2CO.4",
  "number": "4",
  "bookId": "2CO",
  "reference": "2 Akorinitho 4",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
