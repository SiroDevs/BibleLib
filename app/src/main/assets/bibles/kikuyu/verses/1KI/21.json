{
  "id": "1KI.21",
  "number": "21",
  "bookId": "1KI",
  "reference": "1 Athamaki 21",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
