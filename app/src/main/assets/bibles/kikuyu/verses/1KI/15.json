          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa gatatũ wa Asa, mũthamaki wa Juda-rĩ, nĩguo Baasha mũrũ wa Ahija aatuĩkire mũthamaki wa Isiraeli guothe arĩ kũu Tiriza, na agĩthamaka mĩaka mĩrongo ĩĩrĩ na ĩna.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
