        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aathamakĩire Isiraeli mĩaka mĩrongo ĩna, mĩaka mũgwanja yayo agĩthamaka arĩ Hebironi, nayo mĩaka mĩrongo ĩtatũ na ĩtatũ agĩthamaka arĩ Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakuire arĩ mũkũrũ mũno, arĩkĩtie gũkenera gũtũũra gwake matukũ maingĩ, na arĩ mũtongu, na agatĩĩo. Mũriũ Solomoni nĩwe wathamakire ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho ha maũndũ marĩa makoniĩ wathani wa Mũthamaki Daudi kuuma kĩambĩrĩria nginya mũthia, nĩmandĩkĩtwo thĩinĩ wa maandĩko ma Samũeli ũrĩa warĩ muoni-maũndũ, na maandĩko-inĩ ma Nathani ũrĩa mũnabii na maandĩko-inĩ ma Gadi ũrĩa muoni-maũndũ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe na maũndũ mothe marĩa maakoniĩ ũthamaki wake na ũhoti ũrĩa aarĩ naguo, na ũrĩa maũndũ marĩa maamũthiũrũrũkĩirie maatariĩ na ma Isiraeli na mothamaki ma mabũrũri marĩa mangĩ mothe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.30",
            "verseOrgIds": [
              "1CH.29.30"
            ]
          }
        }
