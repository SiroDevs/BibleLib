              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Esheku, mũrũ wa nyina, maarĩ: Ulamu irigithathi rĩake, na Jeushu wa keerĩ, na Elifeleti wa gatatũ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
