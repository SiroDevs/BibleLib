{
  "id": "1CH.27",
  "number": "27",
  "bookId": "1CH",
  "reference": "1 Maũndũ Ma Matukũ Ma Tene 27",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "1CH 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikundi cia Mbũtũ cia Ita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũyũ nĩguo mũtaratara wa andũ a Isiraeli arĩa maarĩ atongoria a nyũmba, na anene a ikundi cia o ngiri ngiri na ikundi cia o igana igana, na anene ao, arĩa maatungatagĩra mũthamaki maũndũ-inĩ mothe makoniĩ ikundi cia mbũtũ cia ita iria ciakoragwo wĩra-inĩ mweri o mweri, mwaka wothe. O gĩkundi kĩarĩ kĩa andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũrũgamĩrĩri wa gĩkundi kĩa mbere kĩa mweri wa mbere aarĩ Jashobeamu mũrũ wa Zabidieli. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake aarĩ wa rũciaro rwa Perezu, na nĩwe warĩ mũnene wa anene othe a mbũtũ cia ita mweri wa mbere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũrũgamĩrĩri wa gĩkundi kĩa mweri wa keerĩ aarĩ Dodai ũrĩa Mũahohi; mũtongoria wa gĩkundi gĩake aarĩ Mikilothu. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa mbũtũ cia ita wa gatatũ, wa mweri wa ĩtatũ aarĩ Benaia mũrũ wa Jehoiada ũrĩa mũthĩnjĩri-Ngai. Nĩwe warĩ mũnene, na gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaia ũcio nĩwe warĩ njamba mũno gatagatĩ-inĩ ka arĩa Mĩrongo Ĩtatũ na nĩwe warĩ mũnene wao. Gĩkundi gĩake kĩarũgamagĩrĩrwo nĩ mũriũ Amizabadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
            "verseOrgIds": [
              "1CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa kana, wa mweri wa ĩna, aarĩ Asaheli mũrũ wa nyina na Joabu; mũriũ Zebadia nĩwe wacookire ithenya rĩake. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa gatano mweri wa ĩtano, aarĩ Shamuhuthu ũrĩa Mũizirahi. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa gatandatũ wa mweri wa ĩtandatũ, aarĩ Ira mũrũ wa Ikeshu ũrĩa Mũtekoa. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa mũgwanja wa mweri wa mũgwanja, aarĩ Helezu ũrĩa Mũpeloni, wa rũciaro rwa Efiraimu. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
            "verseOrgIds": [
              "1CH.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa kanana, wa mweri wa ĩnana, aarĩ Sibekai ũrĩa Mũhushathi wa rũciaro rwa Azerahi. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa kenda wa mweri wa kenda aarĩ Abiezeri ũrĩa Mũanathothu wa rũciaro rwa Abenjamini. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa ikũmi, wa mweri wa ikũmi, aarĩ Maharai ũrĩa Mũnetofathi wa rũciaro rwa Azerahi. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa ikũmi na ũmwe, wa mweri wa ikũmi na ũmwe, aarĩ Benaia ũrĩa Mũpirathoni wa rũciaro rwa Aefiraimu. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene wa ikũmi na eerĩ, mweri wa ikũmi na ĩĩrĩ, aarĩ Helidai ũrĩa Mũnetofathi, wa kuuma nyũmba ya Othinieli. Gĩkundi gĩake kĩarĩ na andũ 24,000.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anene a Mĩhĩrĩga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene arĩa maathaga mĩhĩrĩga ya Isiraeli maarĩ aya:\nmũnene wa mũhĩrĩga wa Rubeni aarĩ Eliezeri mũrũ wa Zikiri; mũnene wa mũhĩrĩga wa Simeoni aarĩ Shefatia mũrũ wa Maaka;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene wa mũhĩrĩga wa Lawi aarĩ Hashabia mũrũ wa Kemueli; mũnene wa mũhĩrĩga wa Harũni aarĩ Zadoku;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene wa mũhĩrĩga wa Juda aarĩ Elihu mũrũ wa ithe na Daudi; mũnene wa mũhĩrĩga wa Isakaru aarĩ Omuri mũrũ wa Mikaeli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene wa mũhĩrĩga wa Zebuluni aarĩ Ishimaia mũrũ wa Obadia; mũnene wa mũhĩrĩga wa Nafitali aarĩ Jeremothu mũrũ wa Azirieli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene wa mũhĩrĩga wa Aefiraimu aarĩ Hoshea mũrũ wa Azazia; mũnene wa nuthu ĩmwe ya mũhĩrĩga wa Manase aarĩ Joeli mũrũ wa Pedaia;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene wa nuthu ĩrĩa ingĩ ya mũhĩrĩga wa Manase kũu Gileadi aarĩ Ido mũrũ wa Zekaria; mũnene wa mũhĩrĩga wa Benjamini aarĩ Jaasieli mũrũ wa Abineri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũnene wa mũhĩrĩga wa Dani aarĩ Azareli mũrũ wa Jerohamu; Acio nĩo maarĩ anene arĩa maathaga mĩhĩrĩga ya Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ndaatarire andũ a mĩaka mĩrongo ĩĩrĩ na arĩa mataakinyĩtie, tondũ Jehova nĩeranĩire atĩ nĩakaingĩhia Isiraeli matuĩke o ta njata cia matu-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu mũrũ wa Zeruia nĩambĩrĩirie gũtara andũ, no ndaarĩkirie. Mangʼũrĩ nĩmakinyĩire Isiraeli nĩ ũndũ wa itarana rĩu. Naguo mũigana wa itarana rĩu ndwandĩkirwo ibuku-inĩ rĩa maũndũ ma Mũthamaki Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arori a Maũndũ ma Mũthamaki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azimavethu mũrũ wa Adieli nĩwe warũgamagĩrĩra nyũmba iria ciaigagwo indo cia ũthamaki. Jonathani mũrũ wa Uzia nĩwe warũgamagĩrĩra nyũmba cia kũigwo indo kũu ngʼongo-inĩ, na matũũra-inĩ, na tũtũũra-inĩ, o na mĩthiringo ĩrĩa mĩraihu na igũrũ ya arangĩri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eziri mũrũ wa Kelubu nĩwe warũgamagĩrĩra andũ arĩa maarutaga wĩra wa kũrĩma mĩgũnda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei ũrĩa Mũramathi nĩwe warũgamagĩrĩra mĩgũnda ya mĩthabibũ. Zabadi ũrĩa Mũshifimi nĩwe warũgamagĩrĩra maciaro ma mĩthabibũ matanekĩrwo mĩtũngi-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baali-Hanani ũrĩa Mũgederi nĩwe warũgamagĩrĩra mĩtĩ ya mĩtamaiyũ na ya mĩborothandi magũrũ-inĩ ma irĩma cia mwena wa irathĩro. Joashu nĩwe warũgamagĩrĩra kũrĩa kwaigagwo maguta ma mĩtamaiyũ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shitirai ũrĩa Mũsharoni nĩwe warũgamagĩrĩra ndũũru cia ngʼombe iria ciarĩithagio Sharoni. Shafati mũrũ wa Adilai nĩwe warũgamagĩrĩra ndũũru cia ngʼombe iria ciarĩ cianda-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obili ũrĩa Mũishumaeli nĩwe warũgamagĩrĩra ngamĩĩra. Jehedeia ũrĩa Mũmeronothu nĩwe warũgamagĩrĩra ndigiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jazizi ũrĩa Mũhagari nĩwe warũgamagĩrĩra ndũũru cia mbũri. Acio othe nĩo maarĩ anene arĩa marũgamagĩrĩra indo ciothe cia Mũthamaki Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani mamawe wa Daudi aarĩ mũheani kĩrĩra, mũndũ mũmenyi maũndũ na mwandĩki-marũa. Nake Jehieli mũrũ wa Hakimoni nĩwe wamenyagĩrĩra ariũ a mũthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahithofeli nĩwe waheaga mũthamaki kĩrĩra. Nake Hushai ũrĩa Mũariki aarĩ mũrata wa mũthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada mũrũ wa Benaia na Abiatharu nĩo maacookire ithenya rĩa Ahithofeli. Joabu nĩwe warĩ mũnene wa mbũtũ cia ita cia mũthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    }
