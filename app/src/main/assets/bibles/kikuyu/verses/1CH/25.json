          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ikũmi na ũmwe wagũĩrĩire Azareli, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
            "verseOrgIds": [
              "1CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
