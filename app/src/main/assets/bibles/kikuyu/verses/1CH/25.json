          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ikũmi na ĩtatũ wagũĩrĩire Shubaeli, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.20",
            "verseOrgIds": [
              "1CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
