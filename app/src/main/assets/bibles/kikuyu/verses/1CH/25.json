          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa ikũmi na ĩna wagũĩrĩire Matithia, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
            "verseOrgIds": [
              "1CH.25.21"
            ]
          }
        },
        {
