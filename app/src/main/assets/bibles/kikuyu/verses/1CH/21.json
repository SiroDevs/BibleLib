              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hema ya Jehova ĩrĩa nyamũre ĩrĩa Musa aathondekeire werũ-inĩ, na kĩgongona kĩa maruta ma njino, hĩndĩ ĩyo ciarĩ harĩa hatũũgĩru o kũu Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
