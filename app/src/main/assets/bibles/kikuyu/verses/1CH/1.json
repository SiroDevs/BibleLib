{
  "id": "1CH.1",
  "number": "1",
  "bookId": "1CH",
  "reference": "1 Maũndũ Ma Matukũ Ma Tene 1",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CH 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maandĩko ma Maũndũ ma Tene kuuma Adamu nginya Iburahĩmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nginya Ariũ a Nuhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiaro cia Adamu ciarĩ Sethi, na Enoshu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.1",
            "verseOrgIds": [
              "1CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kenani, na Mahalaleli, na Jaredi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.2",
            "verseOrgIds": [
              "1CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Enoku, na Methusela, na Lameku, na Nuhu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.3",
            "verseOrgIds": [
              "1CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Nuhu maarĩ: Shemu, na Hamu, na Jafethu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.4",
            "verseOrgIds": [
              "1CH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ariũ a Jafethu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Jafethu maarĩ: Gomeri, na Magogu, na Madai, na Javani, na Tubali, na Mesheki, na Tirasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.5",
            "verseOrgIds": [
              "1CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Gomeri maarĩ: Ashikenazu, na Difatha, na Togarima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.6",
            "verseOrgIds": [
              "1CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Javani maarĩ: Elisha, na Tarishishi, na Kitimu, na Rodanimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.7",
            "verseOrgIds": [
              "1CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ariũ a Hamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Hamu maarĩ: Kushi, na Miziraimu, na Putu, na Kaanani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.8",
            "verseOrgIds": [
              "1CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Kushi maarĩ: Seba, na Havila, na Sabita, na Raama, na Sabiteka. Ariũ a Raama maarĩ: Sheba, na Dedani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.9",
            "verseOrgIds": [
              "1CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushi nĩwe warĩ ithe wa Nimurodi ũrĩa wakũrire agĩtuĩka njamba ya ita ĩrĩ hinya thĩinĩ wa thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miziraimu nĩwe warĩ ithe wa andũ a Ludimu, na Anamini, na Lehabimu, na Nafituhimu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Pathirusimu, na Kasuluhimu (nĩwe warĩ kĩhumo kĩa Afilisti), o na Kafitorimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaanani nĩwe warĩ ithe wa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.13",
            "verseOrgIds": [
              "1CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidoni, mũriũ wake wa irigithathi, na Ahiti, na Ajebusi, na Aamori, na Agirigashi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.14",
            "verseOrgIds": [
              "1CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ahivi, na Aariki, na Asini,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.15",
            "verseOrgIds": [
              "1CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Aarivadi, na Azemari, na Ahamathi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.16",
            "verseOrgIds": [
              "1CH.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ariũ a Shemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Shemu maarĩ: Elamu, na Ashuri, na Arafakasadi, na Ludu, na Aramu. Ariũ a Aramu maarĩ: Uzu, na Hulu, na Getheru, na Mesheki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.17",
            "verseOrgIds": [
              "1CH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arafakasadi nĩwe warĩ ithe wa Shela, nake Shela aarĩ ithe wa Eberi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.18",
            "verseOrgIds": [
              "1CH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eberi aarĩ na ariũ eerĩ: Ũmwe eetagwo Pelegu, tondũ hĩndĩ yake nĩrĩo thĩ yagayũkanirio; na mũrũ wa nyina eetagwo Jokitani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokitani nĩwe warĩ ithe wa Alimodadi, na Shelefu, na Hazarimavethu, na Jera,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.20",
            "verseOrgIds": [
              "1CH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hadoramu, na Uzali, na Dikila,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.21",
            "verseOrgIds": [
              "1CH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ebali, na Abimaeli, na Sheba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.22",
            "verseOrgIds": [
              "1CH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ofiri, na Havila, na Jobabu. Acio othe maarĩ ariũ a Jokitani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.23",
            "verseOrgIds": [
              "1CH.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu, na Arafakasadi, na Shela,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.24",
            "verseOrgIds": [
              "1CH.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Eberi, na Pelegu, na Reu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.25",
            "verseOrgIds": [
              "1CH.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Serugu, na Nahoru, na Tera,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.26",
            "verseOrgIds": [
              "1CH.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Aburamu (na nĩwe Iburahĩmu).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.27",
            "verseOrgIds": [
              "1CH.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyũmba ya Iburahĩmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Iburahĩmu maarĩ: Isaaka na Ishumaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.28",
            "verseOrgIds": [
              "1CH.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njiaro cia Hagari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio njiaro ciao: Nebaiothu nĩwe warĩ irigithathi rĩa Ishumaeli, nao ariũ ake arĩa angĩ maarĩ Kedari, na Adibeeli, na Mibisamu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.29",
            "verseOrgIds": [
              "1CH.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mishima, na Duma, na Masa, na Hadadi, na Tema,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.30",
            "verseOrgIds": [
              "1CH.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Jeturu, na Nafishu, na Kedema. Acio nĩo maarĩ ariũ a Ishumaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.31",
            "verseOrgIds": [
              "1CH.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njiaro cia Ketura",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Ketura, ũrĩa warĩ thuriya ya Iburahĩmu, maarĩ: Zimirani, na Jokishani, na Medani, na Midiani, na Ishibaku, na Shua. Ariũ a Jokishani maarĩ: Sheba na Dedani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Midiani maarĩ: Efa, na Eferi, na Hanoku, na Abida, na Elidaa. Acio othe maarĩ a rũciaro rwa Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njiaro cia Sara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahĩmu nĩwe warĩ ithe wa Isaaka. Ariũ a Isaaka maarĩ: Esaũ na Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.34",
            "verseOrgIds": [
              "1CH.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ariũ a Esaũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Esaũ maarĩ: Elifazu, na Reueli, na Jeushu, na Jalamu, na Kora.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.35",
            "verseOrgIds": [
              "1CH.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Elifazu maarĩ: Temani, na Omari, na Zefi, na Gatamu, na Kenazu; na Amaleki, ũrĩa waciarirwo nĩ Timina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.36",
            "verseOrgIds": [
              "1CH.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Reueli maarĩ: Nahathu, na Zera, na Shama, na Miza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.37",
            "verseOrgIds": [
              "1CH.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andũ a Seiru kũu Edomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Seiru maarĩ: Lotani, na Shobali, na Zibeoni, na Ana, na Dishoni, na Ezeri, na Dishani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
            "verseOrgIds": [
              "1CH.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Lotani maarĩ: Hori na Homamu. Nake Timina aarĩ mwarĩ wa nyina na Lotani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Shobali maarĩ: Alivani, na Manahathu, na Ebali, na Shefo, na Onamu. Ariũ a Zibeoni maarĩ: Aia na Ana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
              "1CH.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũriũ wa Ana aarĩ: Dishoni. Ariũ a Dishoni maarĩ: Hemudani, na Eshibani, na Ithirani, na Kerani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
            "verseOrgIds": [
              "1CH.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Ezeri maarĩ: Bilihani, na Zaavani, na Akani. Ariũ a Dishani maarĩ: Uzu, na Arani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Athamaki a Edomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao aya nĩo maarĩ athamaki arĩa maathamakaga Edomu mbere ya Isiraeli gũthamakĩrwo nĩ mũthamaki o na ũmwe: Nĩ Bela mũrũ wa Beori, narĩo itũũra rĩake inene rĩetagwo Dinihaba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.43",
            "verseOrgIds": [
              "1CH.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Bela aakuire, Jobabu mũrũ wa Zera wa kuuma Bozira agĩtuĩka mũthamaki ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.44",
            "verseOrgIds": [
              "1CH.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Jobabu aakuire, Hushamu wa kuuma bũrũri wa Atemani agĩtuĩka mũthamaki ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.45",
            "verseOrgIds": [
              "1CH.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Hushamu aakuire, Hadadi mũrũ wa Bedadi ũrĩa wahootire Midiani kũu bũrũri wa Moabi, agĩtuĩka mũthamaki ithenya rĩake. Itũũra rĩake inene rĩetagwo Avithu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.46",
            "verseOrgIds": [
              "1CH.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Hadadi aakuire, Samala wa kuuma Masereka agĩtuĩka mũthamaki ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.47",
            "verseOrgIds": [
              "1CH.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Samala aakuire, Shauli wa kuuma Rehobothu kũu gũkuhĩ na Rũũĩ rwa Farati, agĩtuĩka mũthamaki ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.48",
            "verseOrgIds": [
              "1CH.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Shauli aakuire, Baali-Hanani mũrũ wa Akibori agĩtuĩka mũthamaki ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.49",
            "verseOrgIds": [
              "1CH.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Baali-Hanani aakuire, Hadadi agĩtuĩka mũthamaki ithenya rĩake. Itũũra rĩake inene rĩetagwo Pau, na mũtumia wake eetagwo Mehetabeli mwarĩ wa Matiredi, ũrĩa warĩ mwarĩ wa Me-Zahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.50",
            "verseOrgIds": [
              "1CH.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi o nake agĩkua.\nAnene a Edomu maarĩ:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timina, na Aliva, na Jethethu, na Oholibama, na Ela, na Pinoni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.52",
            "verseOrgIds": [
              "1CH.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kenazu, na Temani, na Mibizaru,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.53",
            "verseOrgIds": [
              "1CH.1.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 1:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Magidieli, na Iramu. Acio nĩo maarĩ anene a Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.54",
            "verseOrgIds": [
              "1CH.1.54"
            ]
          }
        }
      ]
    }
  ],
