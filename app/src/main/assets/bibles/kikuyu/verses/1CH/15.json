{
  "id": "1CH.15",
  "number": "15",
  "bookId": "1CH",
  "reference": "1 Maũndũ Ma Matukũ Ma Tene 15",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ithandũkũ rĩa Kĩrĩkanĩro Kũrehwo Jerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aarĩkia gwaka nyũmba ciake mwene kũu Itũũra Inene rĩa Daudi, nĩahaarĩirie handũ ha kũiga ithandũkũ rĩa Ngai, na akĩrĩambĩra hema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Daudi akiuga atĩrĩ, “Gũtirĩ mũndũ ũngĩ wagĩrĩirwo nĩ gũkuua ithandũkũ rĩa Ngai tiga o Alawii, tondũ nĩo Jehova aathuurire makuuage ithandũkũ rĩu rĩa Jehova na mamũtungatagĩre nginya tene.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nĩacookanĩrĩirie andũ othe a Isiraeli hamwe kũu Jerusalemu nĩguo marehe ithandũkũ rĩa Jehova handũ harĩa aarĩthondekeire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩacookanĩrĩirie njiaro cia Harũni na Alawii ta ũũ:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.4",
            "verseOrgIds": [
              "1CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kũrĩ njiaro cia Kohathu, Urieli nĩwe warĩ mũtongoria, na andũ a nyũmba yao 120;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ njiaro cia Merari, Asaia nĩwe warĩ mũtongoria, na andũ a nyũmba yao 220;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ njiaro cia Gerishoni, Joeli nĩwe warĩ mũtongoria, na andũ a nyũmba yao 130;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ njiaro cia Elizafani, Shemaia nĩwe warĩ mũtongoria, na andũ a nyũmba yao 200;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ njiaro cia Hebironi, Elieli nĩwe warĩ mũtongoria, na andũ a nyũmba yao 80;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ njiaro cia Uzieli, Aminadabu nĩwe warĩ mũtongoria, na andũ a nyũmba yao 112.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Daudi agĩĩta Zadoku na Abiatharu arĩa athĩnjĩri-Ngai, na Urieli, na Asaia, na Joeli, na Shemaia, na Elieli, na Aminadabu arĩa Alawii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩmeera atĩrĩ, “Nĩ inyuĩ anene a nyũmba cia Alawii; inyuĩ ene na Alawii arĩa angĩ no nginya mwĩtherie na mwambatie ithandũkũ rĩa Jehova Ngai wa Isiraeli nginya handũ harĩa ndĩrĩthondekeire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ inyuĩ, Alawii, mũtiarĩambatirie ihinda rĩa mbere, nĩkĩo Jehova Ngai witũ aatũũkĩrĩire na marakara. Tũtiigana gũtuĩria ũhoro wa ũrĩa tũngĩekire kũrĩ we, kũringana na ũrĩa gwatuĩtwo.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, athĩnjĩri-Ngai na Alawii magĩĩtheria nĩgeetha maambatie ithandũkũ rĩa Jehova, Ngai wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
              "1CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Alawii magĩkuua ithandũkũ rĩa Ngai na mĩtĩ mĩraaya mamĩigĩrĩire ciande, o ta ũrĩa Musa aathanĩte kũringana na kiugo kĩa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akĩĩra atongoria a Alawii mathuure ariũ a ithe wao matuĩke aini, nao maine nyĩmbo cia gĩkeno makĩhũũraga inanda cia kĩnũbi, na cia mũgeeto, na thaani iria ihũũrithanagio ikagamba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Alawii magĩthuura Hemani mũrũ wa Joeli; kuuma harĩ ariũ a ithe, na magĩthuura Asafu mũrũ wa Berekia; na kuuma harĩ ariũ a ithe Amerari magĩthuura Ethani mũrũ wa Kushaia;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ningĩ hamwe nao magĩthuura ariũ a ithe matuĩke anini ao wathani-inĩ. nao nĩ: Zekaria, na Jaazieli, na Shemiramothu, na Jehieli, na Uni, na Eliabu, na Benaia, na Maaseia, na Matithia, na Elifelehu, na Mikineia, na Obedi-Edomu, na Jeieli, arĩa arangĩri ihingo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hemani, na Asafu na Ethani maarĩ aini na maahũũrithanagia thaani cia gĩcango;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria, na Azieli, na Shemiramothu, na Jehieli, na Uni, na Eliabu, na Maaseia, na Benaia maarĩ a kũhũũra inanda cia kĩnũbi, kũringana na Alamothu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Matithia, na Elifelehu, na Mikineia, na Obedi-Edomu, na Jeieli, na Azazia maarĩ a kũhũũra inanda cia mũgeeto, matongoretie kũringana na Sheminithu (ũguo nĩ ta kuuga mũgambo ũkũruruma).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenania ũrĩa mũtongoria wa Alawii nĩwe warũgamĩrĩire ũini; ũcio nĩguo warĩ wĩra wake tondũ aarĩ na ũũgĩ wa guo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berekia na Elikana nĩo maarĩ a kũrangĩra mĩrango nĩ ũndũ wa ithandũkũ rĩu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athĩnjĩri-Ngai, nĩo Shebania, na Joshafatu, na Nethaneli, na Amasai, na Zekaria, na Benaia, na Eliezeri maarĩ a kũhuha tũrumbeta mbere ya ithandũkũ rĩa Ngai. Obedi-Edomu na Jehia o nao maarĩ arangĩri a mĩrango nĩ ũndũ wa ithandũkũ rĩu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Daudi na athuuri a Isiraeli, na anene a ikundi cia ngiri, magĩthiĩ kwambatia ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova kuuma nyũmba ya Obedi-Edomu makenete.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ Ngai nĩateithĩtie Alawii arĩa maakuuaga ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova-rĩ, ndegwa mũgwanja na ndũrũme mũgwanja nĩciarutirwo igongona.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Daudi eehumbĩte nguo ya igũrũ ndaaya ya gatani ĩrĩa njega, na noguo Alawii othe arĩa makuuĩte ithandũkũ rĩu mehumbĩte, o na aini na Kenania ũrĩa warĩ mũtongoria wa ũini. O na ningĩ Daudi nĩehumbĩte ebodi ya gatani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio andũ othe a Isiraeli makĩambatia ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova makĩanagĩrĩra, makĩhuhaga macoro na tũrumbeta, na makĩhũũrithanagia thaani iria ihũũrithanagio na ikagamba, na makĩhũũraga inanda cia kĩnũbi na cia mũgeeto.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova rĩatoonyaga Itũũra Inene rĩa Daudi-rĩ, Mikali mwarĩ wa Saũlũ nĩacũthĩrĩirie arĩ ndirica-inĩ. Na rĩrĩa onire Mũthamaki Daudi akĩina akĩrũgarũgaga, akĩmũnyarara ngoro-inĩ yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
    }
  ],
