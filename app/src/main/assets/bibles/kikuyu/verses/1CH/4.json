{
  "id": "1CH.4",
  "number": "4",
  "bookId": "1CH",
  "reference": "1 Maũndũ Ma Matukũ Ma Tene 4",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1CH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mĩhĩrĩga Ĩngĩ ya Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiaro cia Juda ciarĩ: Perezu, na Hezironi, na Karimi, na Huru, na Shobali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reaia mũrũ wa Shobali nĩwe warĩ ithe wa Jahathu, nake Jahathu nĩwe warĩ ithe wa Ahumai na Lahadi. Icio nĩcio ciarĩ mbarĩ cia Azorathi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.2",
            "verseOrgIds": [
              "1CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Etamu maarĩ: Jezireeli, na Ishima, na Idibasha. Mwarĩ wa nyina wao eetagwo Hazeleliponi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.3",
            "verseOrgIds": [
              "1CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Penueli nĩwe warĩ ithe wa Gedori, nake Ezeri nĩwe warĩ ithe wa Husha. Ici nĩcio ciarĩ njiaro cia Huru ũrĩa irigithathi rĩa Efiratha, na ithe wa Bethilehemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuri ithe wa Tekoa aarĩ na atumia eerĩ, nĩo Hela na Naara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.5",
            "verseOrgIds": [
              "1CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naara akĩmũciarĩra Ahuzamu, na Heferi, na Temeni, na Haahashatari. Icio nĩcio ciarĩ njiaro cia Naara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.6",
            "verseOrgIds": [
              "1CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Hela maarĩ: Zerethi, na Zoharu, na Ethinani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kozu, ũrĩa warĩ ithe wa Anubu, na Hazobeba, na wa mĩhĩrĩga ya Ahariheli mũrũ wa Harumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabezu aarĩ mũtĩĩku mũno gũkĩra ariũ a nyina. Nyina nĩwe wamũtuire Jabezu, tondũ oigire atĩrĩ, “Ndaamũciarire na ruo.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jabezu agĩkaĩra Ngai wa Isiraeli, akiuga atĩrĩ, “Naarĩ korwo wandathima na ũnjaramĩrie mĩhaka ya bũrũri wakwa! Reke guoko gwaku gũkorwo hamwe na niĩ, na ũngitĩre harĩ ũũru nĩguo ndikanakorwo na ruo.” Nake Ngai akĩigua ihooya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelubu, mũrũ wa nyina na Shuha, nĩwe warĩ ithe wa Mehiru, ũrĩa warĩ ithe wa Eshitoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitoni nĩwe warĩ ithe wa Bethi-Rafa, na Pasea, na Tehina ũrĩa warĩ ithe wa Iri-Nahashu. Acio nĩo maarĩ andũ a Reka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Kenazu maarĩ: Othinieli na Seraia. Ariũ a Othinieli maarĩ: Hathathu, na Meonothai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meonothai nĩwe warĩ ithe wa Ofara. Seraia nĩwe warĩ ithe wa Joabu ũrĩa ithe wa andũ a Ge-Harashimu. Gwetagwo ũguo nĩ ũndũ andũ akuo maarĩ mabundi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Kalebu, mũrũ wa Jefune, maarĩ: Iru, na Ela, na Naamu. Mũriũ wa Ela eetagwo: Kenazu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Jehaleleli maarĩ: Zifu, na Zifa, na Tiria, na Asareli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Ezara maarĩ: Jetheru, na Meredi, na Eferi, na Jaloni. Mũtumia ũmwe wa Meredi nĩwe waciarire Miriamu, na Shamai, na Ishiba ũrĩa warĩ ithe wa Eshitemoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mũtumia wake wa kuuma Judea agĩciara Jeredi ũrĩa ithe wa Gedori, na Heberi ithe wa Soko, na Jekuthieli ithe wa Zanoa.) Acio nĩo maarĩ ciana cia Bithia mwarĩ wa Firaũni ũrĩa wahikĩtio nĩ Meredi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a mũtumia wa Hodia (mwarĩ wa nyina na Nahamu) maarĩ: Ithe wa Keila ũrĩa Mũgarimi, na Eshitemoa ũrĩa Mũmaakathi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Shimoni maarĩ: Amunoni, na Rina, na Beni-Hanani, na Tiloni. Njiaro cia Ishi nĩ: Zohethu na Beni-Zohethu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao ariũ a Shela mũrũ wa Juda maarĩ: Eri ithe wa Leka, na Laada ithe wa Maresha, na mbarĩ cia arĩa maathondekaga gatani ĩrĩa njegakũu Bethi-Ashibea,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Jokimu, na andũ a Kozeba, na Joashu na Sarafi arĩa maathanaga bũrũri wa Moabi, na Jashubi-Lehemu. (Ũhoro ũyũ ũrutĩtwo maandĩko-inĩ ma tene mũno.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nĩo moombaga indo cia rĩũmba, nao maatũũraga Netaimu na Gedera; maikaraga kũu, marutagĩre mũthamaki wĩra.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njiaro cia Simeoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiaro cia Simeoni nĩ: Nemueli, na Jamini, na Jaribu, na Zera, na Shauli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu aarĩ mũriũ wa Shauli, nake Mibisamu aarĩ mũriũ wa Shalumu, nake Mishima aarĩ mũriũ wa Mibisamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.25",
            "verseOrgIds": [
              "1CH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiaro cia Mishima ciarĩ: Mũriũ Hamueli, na Zakuri mũriũ wa Hamueli, na Shimei mũriũ wa Zakuri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei aarĩ na ariũ ikũmi na atandatũ na airĩtu atandatũ, no ariũ a nyina matiarĩ na ciana nyingĩ; nĩ ũndũ ũcio mbarĩ yao ndĩongererekire ta ya andũ a Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao maatũũraga Birishiba, na Molada, na Hazari-Shuali,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.28",
            "verseOrgIds": [
              "1CH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Biliha, na Ezemu, na Toladi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.29",
            "verseOrgIds": [
              "1CH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bethueli, na Horoma, na Zikilagi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.30",
            "verseOrgIds": [
              "1CH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bethi-Marikabothu, na Hazari-Susimu, na Bethi-Biri, na Shaaraimu. Macio nĩmo maarĩ matũũra mao nginya rĩrĩa Daudi aathamakaga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.31",
            "verseOrgIds": [
              "1CH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matũũra matano marĩa maamarigiicĩirie maarĩ: Etamu, na Aini, na Rimoni, na Tokenina Ashani,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.32",
            "verseOrgIds": [
              "1CH.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na tũtũũra tũnini tũrĩa twarigiicĩirie matũũra macio o nginya Baalathu. Macio nĩmo maarĩ ũtũũro wao. Nao nĩmaigaga maandĩko ma njiarwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshobabu, na Jamuleki, na Josha mũrũ wa Amazia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Joeli; na Jehu mũrũ wa Joshibia, mũrũ wa Seraia, mũrũ wa Asieli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na Elioenai, na Jaakoba, na Jeshohaia, na Asaia, na Adieli, na Jesimieli, na Benaia;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ziza mũrũ wa Shifi, mũrũ wa Aloni, mũrũ wa Jedaia, mũrũ wa Shimuri, mũrũ wa Shemaia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ acio marĩĩtwa mao magwetetwo hau igũrũ nĩo maarĩ atongoria a mbarĩ ciao. Nyũmba ciao nĩciongererekire mũno,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao magĩthiĩ mĩhaka-inĩ ya Gedori mwena wa irathĩro wa gĩtuamba kĩu gũcaria ũrĩithio wa mahiũ mao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmoonire kũndũ kũnoru kũrĩ ũrĩithio mwega, bũrũri warĩ mwariĩ, ũrĩ na thayũ na ũkahoorera. Na rĩrĩ, andũ a Hamuamwe nĩo maatũũraga kuo mbere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ arĩa marĩĩtwa mao maandĩkĩtwo mookĩte kuo matukũ-inĩ ma Hezekia mũthamaki wa Juda. Nao magĩtharĩkĩra andũ a Hamu ciikaro-inĩ cia andũ acio o na cia Ameunimu arĩa maatũũraga kuo, na makĩmaniina biũ o ta ũrĩa gũtariĩ nginya ũmũthĩ. Nao magĩtũũra ciikaro-inĩ cia andũ acio tondũ kwarĩ na ũrĩithio mwega wa mahiũ mao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ magana matano a nyũmba ya Simeoni, matongoretio nĩ Pelatia, na Nearia, na Refaia na Uzieli, ariũ a Ishi, magĩtharĩkĩra bũrũri ũrĩa ũrĩ irĩma wa Seiru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makĩũraga Aamaleki arĩa meetharĩte magatigara, nao matũire kuo nginya ũmũthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
