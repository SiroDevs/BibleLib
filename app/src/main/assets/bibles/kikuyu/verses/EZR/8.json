{
  "id": "EZR.8",
  "number": "8",
  "bookId": "EZR",
  "reference": "Ezara 8",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EZR 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Marĩĩtwa ma Atongoria a Nyũmba aria Macookire na Ezara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nĩo atongoria a nyũmba o hamwe na arĩa meyandĩkithĩtie, na nĩo mambatanirie na niĩ kuuma Babuloni hĩndĩ ya wathani wa Mũthamaki Aritashashita:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma njiaro cia Finehasi, aarĩ Gerishomu; na njiaro cia Ithamaru, aarĩ Danieli; na kuuma njiaro cia Daudi, aarĩ Hatushu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa njiaro cia Shekania;\nna kuuma njiaro cia Paroshu, aarĩ Zekaria, hamwe na andũ 150 arĩa meyandĩkithĩtie;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Pahathu-Moabi, aarĩ Eliehoenai mũrũ wa Zerahia, hamwe na andũ angĩ 200;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Zatu, aarĩ Shekania mũrũ wa Jahazieli, hamwe na andũ angĩ 300;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.5",
            "verseOrgIds": [
              "EZR.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Adini, aarĩ Ebedi mũrũ wa Jonathani, hamwe na andũ angĩ 50;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Elamu, aarĩ Jeshaia mũrũ wa Athalia, hamwe na andũ angĩ 70;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.7",
            "verseOrgIds": [
              "EZR.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Shefatia, aarĩ Zebadia mũrũ wa Mikaeli, hamwe na andũ angĩ 80;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Joabu, aarĩ Obadia mũrũ wa Jehieli, hamwe na andũ angĩ 218;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Bani, aarĩ Shelomithi mũrũ wa Josifia, hamwe na andũ angĩ 160;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Bebai, aarĩ Zekaria mũrũ wa Bebai, hamwe na andũ angĩ 28;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Azigadi, aarĩ Johanani mũrũ wa Hakatani, hamwe na andũ angĩ 110;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Adonikamu, na nĩo a mũthia, marĩĩtwa mao maarĩ Elifeleti, na Jeueli, na Shemaia, hamwe na andũ angĩ 60;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma njiaro cia Bigivai, maarĩ Uthai na Zakuri, hamwe na andũ angĩ 70.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũcooka Jerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩndamacookanĩrĩirie hamwe rũũĩ-inĩ rũrĩa rũthereraga rũrorete Ahava, na tũgĩikara hau mĩthenya ĩtatũ. Na rĩrĩ, rĩrĩa ndarorire gatagatĩ-inĩ ka andũ acio na athĩnjĩri-Ngai, ndionire Alawii ho.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngĩtũmanĩra Eliezeri, na Arieli, na Shemaia, na Elinathani, na Jaribu, na Elinathani, na Nathani, na Zekaria, na Meshulamu arĩa maarĩ atongoria, na Joiaribu na Elinathani, andũ arĩa maarĩ arutani,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngĩmatũma kũrĩ Ido mũtongoria wa Kasifia. Ngĩmeera ũrĩa megũthiĩ kwĩra Ido na andũ a nyũmba yake, acio ndungata cia hekarũ kũu Kasifia, nĩguo matũrehere aruti a wĩra wa nyũmba ya Ngai witũ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tondũ guoko kwa ũtugi kwa Ngai witũ kwarĩ hamwe na ithuĩ-rĩ, magĩtũrehere Sherebia, mũndũ mũhoti wa kuuma njiaro cia Mahili mũrũ wa Lawi, ũrĩa warĩ mũrũ wa Isiraeli, na ariũ a Sherebia na ariũ a ithe, othe maarĩ andũ 18;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makĩrehe Hashabia hamwe na Jeshaia wa kuuma njiaro cia Merari, na ariũ a ithe na ciana ciao, othe andũ 20.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ makĩrehe andũ ndungata 220 cia hekarũ, gĩkundi gĩathondeketwo nĩ Daudi na anene ake nĩguo gĩteithagĩrĩrie Alawii. Othe makĩandĩkwo na marĩĩtwa mao.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũrĩ o hau rũũĩ-inĩ rwa Ahava, ngĩanĩrĩra twĩhinge kũrĩa irio, nĩguo tũhote kwĩnyiihia mbere ya Ngai witũ tũmũhooe atũgitĩre rũgendo-inĩ, ithuĩ na ciana ciitũ, hamwe na indo ciitũ ciothe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩndaiguire thoni kũũria mũthamaki atũhe thigari cia magũrũ o na iria ithiiaga ihaicĩte mbarathi cia gũtũgitĩra harĩ thũ njĩra-inĩ, tondũ nĩtwerĩte mũthamaki atĩrĩ, “Guoko kwa ũtugi kwa Ngai witũ kũrĩ igũrũ rĩa mũndũ o wothe ũrĩa ũmwĩhokaga, no marakara make manene marĩ igũrũ rĩa arĩa othe mamũtiganagĩria.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio tũkĩĩhinga kũrĩa irio na tũgĩthaitha Ngai witũ nĩ ũndũ wa ũhoro ũcio, nake agĩcookia ihooya riitũ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ ngĩamũra athĩnjĩri-Ngai ikũmi na eerĩ arĩa maarĩ atongoria, hamwe na Sherebia, na Hashabia, na ariũ a ithe wao ikũmi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngĩmathimĩra maruta ma betha na thahabu, na indo iria ciaheanĩtwo nĩ mũthamaki, na ataari ake, na anene ake, na andũ othe a Isiraeli arĩa maarĩ kuo, nĩ ũndũ wa nyũmba ya Ngai witũ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩmathimĩra taranda 650cia betha, na indo cia betha cia ũritũ wa taranda igana rĩmwe, na taranda igana rĩmwe cia thahabu,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbakũri 20 cia thahabu cia thogora wa mbaũni 1,000,na indo igĩrĩ cia gĩcango gĩtherie mũno kĩa goro o ta thahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩmeera atĩrĩ, “Inyuĩ o ũndũ ũmwe na indo ici nĩ mwamũrĩirwo Jehova. Betha na thahabu ici nĩ maruta ma kwĩyendera marutĩirwo Jehova Ngai wa maithe manyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũcimenyerere wega o nginya rĩrĩa mũgaacithimĩra tũnyũmba-inĩ tũrĩa tũrĩ thĩinĩ wa nyũmba ya Jehova kũu Jerusalemu mbere ya athĩnjĩri-Ngai arĩa atongoria, na Alawii, na atongoria a nyũmba cia Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao athĩnjĩri-Ngai na Alawii makĩamũkĩra betha na thahabu, na indo icio nyamũre iria ciathimĩtwo nĩguo itwarwo nyũmba ya Ngai witũ kũu Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya wa ikũmi na ĩĩrĩ mweri wa mbere tũkiuma rũũĩ-inĩ rwa Ahava twerekeire Jerusalemu. Guoko kwa Ngai witũ kwarĩ hamwe na ithuĩ, nake agĩtũgitĩra kuuma kũrĩ thũ na njangiri njĩra-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio tũgĩkinya Jerusalemu, na tũkĩhurũka kuo mĩthenya ĩtatũ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya wa kana, tũrĩ thĩinĩ wa nyũmba ya Ngai witũ, tũgĩthima betha na thahabu na indo iria nyamũre ikĩneanwo moko-inĩ ma Meremothu mũrũ wa Uria, ũrĩa mũthĩnjĩri-Ngai. Eleazaru mũrũ wa Finehasi aarĩ hamwe nake, o ũndũ ũmwe na Jozabadu mũrũ wa Jeshua, na Noadia mũrũ wa Binui, arĩa Alawii.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indo ciothe nĩciatarirwo kũringana na mũigana na ũritũ wacio, naguo ũritũ wacio ũrĩ wothe ũkĩandĩkwo o hĩndĩ ĩyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo arĩa maacookete kuuma kũrĩa maatahĩirwo makĩrutĩra Ngai wa Isiraeli maruta ma njino: makĩruta ndegwa ikũmi na igĩrĩ nĩ ũndũ wa andũ a Isiraeli othe, na ndũrũme mĩrongo kenda na ithathatũ, na tũtũrũme mĩrongo mũgwanja na mũgwanja, na makĩruta thenge ikũmi na igĩrĩ irĩ iruta rĩa kũhoroheria mehia. Ici ciothe ciarutĩirwo Jehova irĩ iruta rĩa njino.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩcooka magĩtwara mawatho ma mũthamaki kũrĩ anene arĩa maathuurĩtwo nĩ mũthamaki, na kũrĩ mabarũthima Mũrĩmo-wa-Farati, nao magĩteithia andũ na magĩteithĩrĩria maũndũ ma nyũmba ya Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
      ]
    }
