            }
          ]
        },
        {
          "text": "na Bakabuku, na Hakufa, na Harihuru,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.51",
            "verseOrgIds": [
              "EZR.2.51"
            ]
          }
        },
        {
