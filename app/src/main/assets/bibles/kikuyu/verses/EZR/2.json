          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Rezini, na Nekoda, na Gazamu,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.48",
            "verseOrgIds": [
              "EZR.2.48"
            ]
          }
        },
        {
