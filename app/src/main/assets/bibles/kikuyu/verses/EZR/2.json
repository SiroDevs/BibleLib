          "type": "text",
          "attrs": {
            "verseId": "EZR.2.39",
            "verseOrgIds": [
              "EZR.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZR 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Alawii:\narĩa maarĩ a njiaro cia Jeshua na Kadimieli (iria cioimĩte harĩ ciana cia Hodavia) maarĩ 74.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.40",
            "verseOrgIds": [
              "EZR.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZR 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao aini a nyĩmbo:\narĩa maarĩ a njiaro cia Asafumaarĩ 128.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.41",
            "verseOrgIds": [
              "EZR.2.41"
            ]
          }
        },
        {
          "name": "verse",
