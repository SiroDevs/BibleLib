          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Lebana, na Hagaba, na Akubu,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.45",
            "verseOrgIds": [
              "EZR.2.45"
            ]
          }
        },
