          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZR 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Keroso, na Siaha, na Padoni,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.44",
            "verseOrgIds": [
              "EZR.2.44"
            ]
          }
        },
