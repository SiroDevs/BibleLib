          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZR 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao aikaria a ihingo cia hekarũ,\narĩa maarĩ a njiaro cia Shalumu, na cia Ateri, na cia Talimoni, na cia Akubu, na cia Hatita, na cia Shobai, othe maarĩ 139.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.42",
            "verseOrgIds": [
              "EZR.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZR 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ndungata cia hekarũ:\narĩa maarĩ a njiaro cia Ziha, na Hasufa, na Tabaothu,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.43",
            "verseOrgIds": [
              "EZR.2.43"
            ]
          }
        },
