          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "EZR 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Baziluthu, na Mehida, na Harasha,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.52",
            "verseOrgIds": [
              "EZR.2.52"
            ]
          }
        },
        {
          "name": "verse",
