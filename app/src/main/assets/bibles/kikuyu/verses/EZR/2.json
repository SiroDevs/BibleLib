          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Uza, na Pasea, na Besai,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.49",
            "verseOrgIds": [
              "EZR.2.49"
            ]
          }
        },
        {
          "name": "verse",
