    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũriũ nĩ Mũnene Gũkĩra Araika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukũ-inĩ ma tene Ngai nĩarĩirie maithe maitũ na tũnua twa anabii maita maingĩ, na njĩra mwanya mwanya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "no matukũ-inĩ maya ma kũrigĩrĩria-rĩ, ithuĩ nĩatwarĩirie na njĩra ya Mũriũ, ũrĩa aatuire mũgai wa indo ciothe, o we ũrĩa thĩ yothe yombirwo na ũndũ wake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũrũwe-rĩ, nĩwe wonanagia ũkengi wa riiri wake, na nĩwe mũhianĩre mũkinyanĩru kũna wa ũrĩa Ngai atariĩ, ningĩ nĩwe ũnyiitĩrĩire indo ciothe na kiugo gĩake kĩrĩ hinya. Nake aarĩkia gũtheria andũ mehia-rĩ, nĩaikarire thĩ guoko-inĩ kwa ũrĩo kwa Ũnene kũu igũrũ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio agĩtuĩka mũnene gũkĩra araika, o ta ũrĩa rĩĩtwa rĩrĩa aagaĩirwo rĩrĩ inene gũkĩra rĩao.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ-rĩ, nĩ mũraika ũrĩkũ Ngai arĩ eera atĩrĩ,O na kana akĩmwĩra atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩaria ũhoro wa araika oigire atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ha ũhoro ũkoniĩ Mũriũ ekuuga atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ akoiga atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        },
