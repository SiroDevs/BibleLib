              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ-rĩ, nĩ mũraika ũrĩkũ Ngai arĩ eera atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
