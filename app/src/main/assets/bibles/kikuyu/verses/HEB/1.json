          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Githĩ araika othe ti maroho ma gũtungata, matũmĩtwo matungatagĩre arĩa makaagaya ũhonokio?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.14",
