  "bookId": "HEB",
  "reference": "Ahibirania 4",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "HEB 4"
      },
      "items": [
