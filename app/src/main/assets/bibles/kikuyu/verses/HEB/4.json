          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thabatũ ya Kũhurũka ya Andũ a Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, kuona atĩ kĩĩranĩro gĩa gũtoonya ũhurũko-inĩ wake kĩrĩ o ho-rĩ, nĩtwĩmenyererei gũtikagĩe o na ũmwe wanyu ũtagagĩkinyĩra.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo o na ithuĩ nĩtũhunjĩirio Ũhoro-ũyũ-Mwega o tao; no ũhoro ũrĩa maaiguire ndũigana kũmaguna, tondũ arĩa maũiguire matiawamũkĩrire na wĩtĩkio.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, ithuĩ arĩa twĩtĩkĩtie nĩ ithuĩ tũtoonyaga kĩhurũko-inĩ kĩu, o ta ũrĩa Ngai oigire atĩrĩ,O na gũtuĩka wĩra wake nĩwathirĩte kuuma o rĩrĩa thĩ yombirwo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nĩ harĩ handũ hana aarĩtie ũhoro wa mũthenya wa mũgwanja, akoiga atĩrĩ: “Nake Ngai akĩhurũka mũthenya wa mũgwanja, agĩtigana na wĩra wake wothe.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.4",
            "verseOrgIds": [
              "HEB.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ningĩ hau mbere nĩoigĩte atĩrĩ, “Matirĩ hĩndĩ magaatoonya ũhurũko-inĩ wakwa.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.5",
            "verseOrgIds": [
              "HEB.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtũkuona atĩ nĩ kũrĩ amwe matigaire gũtoonya kĩhurũko-inĩ kĩu kĩeranĩirwo, nĩgũkorwo arĩa maahunjĩirio Ũhoro-ũrĩa-Mwega mbere matiatoonyire tondũ nĩmagire gwathĩka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.6",
            "verseOrgIds": [
              "HEB.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, o rĩngĩ Ngai akĩamũra mũthenya mũna, akĩwĩĩta Ũmũthĩ, thuutha wa matukũ maingĩ gũthira rĩrĩa aaririe na kanua ka Daudi, ta ũrĩa oigĩte hau mbere atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ korwo Joshua nĩamaheete ũhurũko-rĩ, Ngai ndangĩacookire kwaria ũhoro wa mũthenya ũngĩ thuutha ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ ũcio nĩgũtigaire Thabatũ ya kũhurũka ya andũ a Ngai;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgũkorwo mũndũ o wothe ũrĩa ũtoonyaga kĩhurũko-inĩ kĩa Ngai o nake nĩahurũkaga agatigana na wĩra wake, o ta ũrĩa Ngai aahurũkire agĩtigana na wĩra wake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, nĩtwĩrutanĩrie na kĩyo gũtoonya ũhurũko-inĩ ũcio, nĩgeetha gũtikanagĩe mũndũ o na ũrĩkũ ũkaagũa nĩ ũndũ wa kũrũmĩrĩra kĩonereria kĩa ũremi wao.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo ũhoro wa Ngai ũrĩ muoyo na ũrĩ hinya. Nĩ mũũgĩ gũkĩra rũhiũ rwa njora rũnooretwo mĩena yeerĩ, ũgatheeca ũkagayũkania muoyo na roho, o na ũkagayania marũngo na maguta marĩa makoragwo mahĩndĩ-inĩ, na ningĩ ũgatuĩra meciiria na matua ma ngoro.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gũtirĩ kĩndũ o na kĩmwe kĩa iria ciombirwo kĩhithĩtwo kuuma maitho-inĩ ma Ngai. Indo ciothe nĩhumbũrie na ikaguũrio mbere ya maitho ma ũrĩa tũkaahe ũhoro witũ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesũ Mũthĩnjĩri-Ngai Ũrĩa Mũnene Mũno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, kuona atĩ tũrĩ na mũthĩnjĩri-Ngai mũnene mũno ũrĩa ũhungurĩte agakinya o igũrũ, na nĩwe Jesũ mũrũ wa Ngai-rĩ, nĩtũrũmiei na hinya wĩtĩkio ũrĩa tuumbũraga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo tũtirĩ na mũthĩnjĩri-Ngai mũnene ũtangĩhota gũtũiguĩra tha ũhũthũ-inĩ witũ, no nĩ tũrĩ na ũmwe wanagerio ikĩro-inĩ ciothe o ta ithuĩ, no ndaigana kwĩhia.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakĩrĩ ũguo-rĩ, nĩtũkuhĩrĩriei gĩtĩ kĩa Ũnene kĩrĩa kĩa Wega wake tũrĩ na ũũmĩrĩru, nĩgeetha tũkaiguĩrwo tha, na tuone Wega wake wa gũtũteithagia hĩndĩ ĩrĩa tũbatarĩte.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
  ],
